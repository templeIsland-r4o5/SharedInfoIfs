   aircraft_id_ IN NUMBER) RETURN VARCHAR2
IS
BEGIN
	RETURN Aircraft_API.Get_Reg_Code(aircraft_id_);
END Get_Aircraft_Reg_Code___;

FUNCTION Get_Cms_Request_Data___ (
   task_part_id_ IN NUMBER,
   parent_objkey_ IN VARCHAR2) RETURN Cms_Data_Structure_Rec
IS
   cms_data_structure_rec_        Cms_Data_Structure_Rec;
   task_part_rec_                 av_exe_task_part_tab%ROWTYPE;
   remove_part_rec_               ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT%ROWTYPE;
   inventory_class_code_          av_part_number_tab.inventory_class_code%TYPE;
   part_number_id_                av_exe_task_part_tab.installed_part_no_id%TYPE;
   removal_reason_code_           av_exe_task_part_tab.removal_reason_code%TYPE;
   removal_serial_no_             av_exe_task_part_tab.removed_serial_no%TYPE;
   removal_part_number_           av_part_number_tab.part_number%TYPE;
   removal_part_manufacturer_     av_part_number_tab.manufacturer%TYPE;  
   config_slot_code_              av_config_slot_position_tab.config_slot_code%TYPE;
   assembly_config_slot_code_     av_config_slot_position_tab.config_slot_code%TYPE;
   part_group_alt_id_             av_part_group_tab.alt_id%TYPE;
   config_slot_position_id_       NUMBER;
   assy_config_slot_position_id_  NUMBER;
   is_signed_                     BOOLEAN;
   
   CURSOR get_removal_part(config_slot_position_id_ NUMBER, assy_config_slot_position_id_ NUMBER, parent_objkey_ VARCHAR2) IS
     SELECT * 
     FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT vrt
     WHERE config_slot_position_id = config_slot_position_id_
     AND (assy_config_slot_position_id_ IS NULL OR assembly_config_slot_position_id = assy_config_slot_position_id_)
     AND vrt.parent_objkey = parent_objkey_;
     
   CURSOR get_removed_part_info(removed_part_no_id_ NUMBER) IS
      SELECT part_number, manufacturer
      FROM   av_part_number_tab 
      WHERE  part_number_id = removed_part_no_id_;
      
   CURSOR get_part_group_code(removed_part_no_id_ VARCHAR2) IS
      SELECT part_group_code
      FROM   av_part_group_tab 
      WHERE  alt_id = removed_part_no_id_;
   
   CURSOR get_task_part(task_part_id_ NUMBER) IS
      SELECT *
      FROM   av_exe_task_part_tab 
      WHERE  task_part_id = task_part_id_;
      
   CURSOR get_config_slot_position(config_slot_position_id_ NUMBER) IS
      SELECT config_slot_code, config_slot_position_code, config_slot_position_id
      FROM   av_config_slot_position_tab 
      WHERE  config_slot_position_id = config_slot_position_id_;
      
BEGIN
   OPEN  get_task_part(task_part_id_);
   FETCH get_task_part INTO task_part_rec_;
   CLOSE get_task_part;
   
   OPEN  get_config_slot_position(task_part_rec_.config_slot_position_id);
   FETCH get_config_slot_position INTO config_slot_code_, cms_data_structure_rec_.config_slot_position, config_slot_position_id_;
   CLOSE get_config_slot_position;
   
   OPEN  get_config_slot_position(task_part_rec_.assmbly_config_slot_pos_id);
   FETCH get_config_slot_position INTO assembly_config_slot_code_, cms_data_structure_rec_.assembly_config_slot_position, assy_config_slot_position_id_;
   CLOSE get_config_slot_position;
   
   IF assembly_config_slot_code_ IS NOT NULL THEN
      cms_data_structure_rec_.is_sub_assy := 'true';
      cms_data_structure_rec_.assembly_config_slot_code := assembly_config_slot_code_;
   ELSE 
      cms_data_structure_rec_.is_sub_assy := 'false';
   END IF;

   IF config_slot_code_ IS NOT NULL THEN
      cms_data_structure_rec_.config_slot_code := config_slot_code_;
   END IF;

   part_number_id_ := Av_Exe_Task_Part_API.Get_Installed_Part_No_Id(task_part_id_);
   inventory_class_code_ := Av_Part_Number_API.Get_Inventory_Class_Code(part_number_id_);
   
   IF inventory_class_code_ IS NULL THEN
      part_number_id_ := Av_Exe_Task_Part_API.Get_Removed_Part_No_Id(task_part_id_);
     inventory_class_code_ := Av_Part_Number_API.Get_Inventory_Class_Code(part_number_id_);
   END IF;   

   IF (inventory_class_code_ IN ('ASSY', 'TRK')) THEN 
      OPEN  get_removal_part(config_slot_position_id_, assy_config_slot_position_id_, parent_objkey_);
      FETCH get_removal_part INTO remove_part_rec_;
      CLOSE get_removal_part;
      
      IF remove_part_rec_.objkey IS NOT NULL THEN
         OPEN  get_removed_part_info(remove_part_rec_.removal_part_no_id);
         FETCH get_removed_part_info INTO removal_part_number_, removal_part_manufacturer_;
         CLOSE get_removed_part_info;
         
         IF remove_part_rec_.signed_flag = 1 THEN 
            removal_serial_no_ := remove_part_rec_.removal_serial_no;
            is_signed_ := true;
         ELSE
            is_signed_ := false;
         END IF;
         
         removal_reason_code_ := remove_part_rec_.removal_reason_code;
      END IF; 
   END IF;
   
   part_group_alt_id_ := Av_Part_Group_API.Get_Alt_Id(task_part_rec_.part_group_id);
   cms_data_structure_rec_.aircraft_alt_id := Aircraft_API.Get_Alt_Id(Av_Exe_Task_API.Get_Aircraft_Id(task_part_rec_.task_seq));

   IF inventory_class_code_ IN ('ASSY', 'TRK') THEN
      IF is_signed_ = true THEN
         cms_data_structure_rec_.removal_serial_no := removal_serial_no_;
         cms_data_structure_rec_.removal_part_number := removal_part_number_;
         cms_data_structure_rec_.removal_part_manufacturer := removal_part_manufacturer_;   
         cms_data_structure_rec_.is_removed_part_signed := true;
      ELSE                       
         cms_data_structure_rec_.is_removed_part_signed := false;
      END IF;
   ELSIF inventory_class_code_ IN ('SER', 'BATCH') THEN
      cms_data_structure_rec_.part_change_type := 'INSTALL';
      IF part_group_alt_id_ IS NOT NULL THEN  
         OPEN  get_part_group_code(part_group_alt_id_);
         FETCH get_part_group_code INTO cms_data_structure_rec_.config_slot_code;
         CLOSE get_part_group_code;
      END IF; 
   END IF;   

   cms_data_structure_rec_.inventory_class_code := inventory_class_code_;
   cms_data_structure_rec_.part_group_alt_id := part_group_alt_id_;
            
	IF removal_reason_code_ IS NOT NULL THEN 
      cms_data_structure_rec_.removal_reason_code := removal_reason_code_;
   ELSE 
      -- Since Removal Reason is mandatory to call CMS API,
      -- if user do not select a Removal Reason, the default Removal Reason will be picked from Maintenix
      cms_data_structure_rec_.removal_reason_code := Adcom_util_API.Get_Mx_Parm_Value('DEFAULT_REASON_FOR_REMOVAL');
   END IF;

   IF cms_data_structure_rec_.removal_serial_no IS NOT NULL THEN 
      cms_data_structure_rec_.part_change_type := 'REPLACE';
   ELSE 
      cms_data_structure_rec_.part_change_type := 'INSTALL';
   END IF;
   
   RETURN cms_data_structure_rec_;
END Get_Cms_Request_Data___;


FUNCTION Get_Removed_Part_Record___ (
   inventory_class_code_ IN VARCHAR2,
   config_slot_position_id_ IN NUMBER,
   assy_config_slot_position_id_ IN NUMBER,
   parent_objkey_ IN VARCHAR2) RETURN Removed_Part_Info_Structure_Rec
IS
   removed_part_rec_    Removed_Part_Info_Structure_Rec;
   removal_part_rec_    ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT%ROWTYPE;
   
   CURSOR get_removal_part(config_slot_position_id_ NUMBER, assy_config_slot_position_id_ NUMBER, parent_objkey_ VARCHAR2) IS
     SELECT * 
     FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT vrt
     WHERE config_slot_position_id = config_slot_position_id_
     AND (assy_config_slot_position_id_ IS NULL OR assembly_config_slot_position_id = assy_config_slot_position_id_)
     AND vrt.parent_objkey = parent_objkey_;
     
   CURSOR get_removed_part_info(removed_part_no_id_ NUMBER) IS
      SELECT part_number, alt_id
      FROM   av_part_number_tab 
      WHERE  part_number_id = removed_part_no_id_;

BEGIN
	IF (inventory_class_code_ IN ('ASSY', 'TRK')) THEN 
      OPEN  get_removal_part(config_slot_position_id_, assy_config_slot_position_id_, parent_objkey_);
      FETCH get_removal_part INTO removal_part_rec_;
      CLOSE get_removal_part;

      IF removal_part_rec_.objkey IS NOT NULL THEN
         OPEN  get_removed_part_info(removal_part_rec_.removal_part_no_id);
         FETCH get_removed_part_info INTO removed_part_rec_.removal_part_number, removed_part_rec_.removal_alt_id;
         CLOSE get_removed_part_info;
         
         removed_part_rec_.removal_serial_no := removal_part_rec_.removal_serial_no;
         removed_part_rec_.removal_batch_no := removal_part_rec_.removal_batch_no;
         removed_part_rec_.removal_reason_code := removal_part_rec_.removal_reason_code;
         removed_part_rec_.removal_quantity := removal_part_rec_.removed_quantity;
         removed_part_rec_.removal_user := removal_part_rec_.removed_user;
         removed_part_rec_.removal_user_desc := removal_part_rec_.removed_user_name;
         removed_part_rec_.removal_part_no_id := removal_part_rec_.removal_part_no_id;
         removed_part_rec_.removal_objkey := removal_part_rec_.objkey;
         
         IF removal_part_rec_.removed_user IS NOT NULL THEN 
            removed_part_rec_.is_signed := true;
         ELSE
            removed_part_rec_.is_signed := false;
         END IF;
      END IF;
      
      RETURN removed_part_rec_;
   END IF;
END Get_Removed_Part_Record___;


FUNCTION Get_Part_Id_By_Alt_Id___ (
   alt_id_ IN VARCHAR2) RETURN NUMBER
IS
BEGIN
	RETURN Av_Part_Number_API.Get_Key_By_Alt_Id(alt_id_);
END Get_Part_Id_By_Alt_Id___;


FUNCTION Validate_Hours___ (
   hours_            IN VARCHAR2,
   variable_name_    IN VARCHAR2) RETURN VARCHAR2
IS
   duration_  NUMBER;   
BEGIN  
   duration_ := Adcom_Util_API.Validate_Format_Hours(hours_) ;
   IF duration_ IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALID: Enter :P1 in the HH:MM format.', variable_name_);
   END IF;
   RETURN Adcom_Util_API.Get_Text_Time(duration_);
END Validate_Hours___;

FUNCTION Calculate_Remaining_Hours___ (
   actual_hours_ IN VARCHAR2,
   scheduled_hours_ IN VARCHAR2) RETURN VARCHAR2
IS
   actual_format_hours_ NUMBER := 0;
   scheduled_format_hours_ NUMBER := 0;
   remaining_format_hours_ NUMBER;
   one_min_format_hours_ NUMBER := 0.02;
BEGIN
   IF actual_hours_ IS NOT NULL THEN
      actual_format_hours_ := Format_Hours___(actual_hours_, 'Actual hours');
   END IF;
   IF scheduled_hours_ IS NOT NULL THEN
      scheduled_format_hours_ := Format_Hours___(scheduled_hours_, 'Scheduled hours');
   END IF;
   remaining_format_hours_ := scheduled_format_hours_ - actual_format_hours_;
   IF remaining_format_hours_ <= 0 THEN
      remaining_format_hours_ := one_min_format_hours_;
   END IF;
   RETURN Adcom_Util_API.Get_Text_Time(remaining_format_hours_);
END Calculate_Remaining_Hours___;

FUNCTION Get_Time_Duration___ (
   start_time_ IN DATE,
   end_time_ IN DATE) RETURN VARCHAR2
IS
BEGIN
	RETURN Adcom_Util_API.Get_Time_Difference(start_time_, end_time_);
END Get_Time_Duration___;


FUNCTION Validate_Start_End_Dates___ (
   start_time_      IN DATE,
   end_time_        IN DATE,
   site_            IN VARCHAR2,
   start_date_text_ IN VARCHAR2,
   end_date_text_   IN VARCHAR2) RETURN VARCHAR2
IS
BEGIN
   IF (start_time_ > end_time_)THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALIDDATES: :P1 should be less than the :P2.', start_date_text_,end_date_text_);
   END IF;
   
	RETURN Adcom_Util_API.Get_Time_Difference(start_time_, end_time_);
END Validate_Start_End_Dates___;

FUNCTION Is_Actual_Hours_Mandatory___ RETURN VARCHAR2
IS
BEGIN
	RETURN Av_Flm_Parameter_API.Get_Parameter_Value('RPT_ACTUAL_HRS_MANDT');
END Is_Actual_Hours_Mandatory___;


PROCEDURE Update_Clock_Out___ (
   parent_objkey_ IN VARCHAR2,
   start_time_    IN DATE,
   end_time_      IN DATE,
   actual_hours_  IN VARCHAR2,
   site_          IN VARCHAR2)
IS
   clock_in_key_    Clock_In_Virtual_Key;
   old_rec_         Clock_In_Virtual_Rec;
   new_rec_         Clock_In_Virtual_Rec;
   objkey_          VARCHAR2(1000);
   duration_        NUMBER;
   
   CURSOR get_objkey IS
      SELECT objkey
      FROM ${PROJECTION}_CLOCK_IN_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_;
BEGIN
	
   OPEN get_objkey;
   FETCH get_objkey INTO objkey_;
   CLOSE get_objkey;
   duration_ := Format_Hours___(actual_hours_, 'Actual Duration');
   IF duration_ <= 0 THEN
      duration_ := NULL;
   END IF;

	clock_in_key_.Objkey := objkey_;
   old_rec_             := Get_Record___(clock_in_key_);
   new_rec_             := old_rec_;
   
   new_rec_.start_time   := start_time_;
   new_rec_.stop_time    := end_time_;
   new_rec_.actual_hours := duration_;
   CRUD_Update___(old_rec_, new_rec_); 
END Update_Clock_Out___;

FUNCTION Get_Task_Sign_Off_Permission___ (
   user_id_ IN VARCHAR2) RETURN VARCHAR2
IS
   task_sign_off_permission_   av_e_sig_user_permission_tab.task_sign_off_permission%TYPE;
BEGIN
   
   task_sign_off_permission_  := Av_E_Sig_User_Permission_API.Get_Task_Sign_Off_Permission(user_id_);
   RETURN  task_sign_off_permission_;
END Get_Task_Sign_Off_Permission___;

@IgnoreUnitTest NoOutParams
PROCEDURE Record_Assignment___ (
clock_in_rec_ IN Clock_In_Virtual_Rec) 
IS
   site_     Site_Tab.Contract%TYPE;
BEGIN
   site_ := Work_Task_API.Get_Site(clock_in_rec_.task_seq);
   IF clock_in_rec_.source = 'Finish' THEN
      IF clock_in_rec_.assignment_status = 'ASSIGNED' THEN
         Start_Assignment___(clock_in_rec_.task_seq,clock_in_rec_.execution_instance_seq,clock_in_rec_.start_time, site_);
         Finish_Assignment___(clock_in_rec_.task_seq,clock_in_rec_.execution_instance_seq,clock_in_rec_.actual_hours,clock_in_rec_.stop_time);
      ELSIF clock_in_rec_.assignment_status = 'WORKSTARTED' THEN
         Finish_Assignment___(clock_in_rec_.task_seq,clock_in_rec_.execution_instance_seq,clock_in_rec_.actual_hours,clock_in_rec_.stop_time);
      END IF;
   ELSIF clock_in_rec_.source = 'RecordWork' THEN
      IF clock_in_rec_.assignment_status = 'ASSIGNED' THEN
            Start_Assignment___(clock_in_rec_.task_seq,clock_in_rec_.execution_instance_seq,clock_in_rec_.start_time, site_);
      END IF;
   END IF;
END Record_Assignment___;

@IgnoreUnitTest NoOutParams
PROCEDURE Start_Assignment___ (
   task_seq_               IN NUMBER,
   execution_instance_seq_ IN NUMBER,
   start_time_             IN DATE,
   site_                   IN VARCHAR2)
IS
    clocking_seq_           NUMBER;
     
BEGIN
   Jt_Task_Clocking_API.Clock_In_From_Work_Asgmt(clocking_seq_,task_seq_,execution_instance_seq_,start_time_);
END Start_Assignment___;

@IgnoreUnitTest NoOutParams
PROCEDURE Finish_Assignment___ (
   task_seq_               IN NUMBER,
   execution_instance_seq_ IN NUMBER,
   actual_hours_           IN NUMBER,
   finish_time_            IN DATE)
IS
   info_                   VARCHAR2(2000);
   attr_                   VARCHAR2(2000);
   prev_logged_actual_hours_ NUMBER;
   actual_hours_diff_   NUMBER;  
   task_resource_seq_   NUMBER;
   adjusted_hours_      NUMBER;
   resource_group_seq_  NUMBER;
BEGIN
   prev_logged_actual_hours_ := NVL(Jt_Task_Transaction_api.Get_Tot_Personel_Reported_Hrs(task_seq_, execution_instance_seq_),0);
   actual_hours_diff_ := actual_hours_ - prev_logged_actual_hours_;
   
   IF (actual_hours_diff_ > 0) THEN
      Jt_Task_Clocking_API.Clock_Out_From_Work_Asgmt(task_seq_,execution_instance_seq_,finish_time_,actual_hours_diff_,NULL,'Clock out from MM');
   ELSE
      Jt_Task_Clocking_API.Clock_Out_From_Work_Asgmt(task_seq_,execution_instance_seq_,finish_time_,actual_hours_,NULL,'Clock out from MM');
                     

      task_resource_seq_ := Jt_Execution_Instance_API.Get_Task_Resource_Seq(task_seq_,execution_instance_seq_);
      resource_group_seq_ := Jt_Task_Resource_API.Get_Resource_Group_Seq(task_seq_, task_resource_seq_);
      adjusted_hours_ := - prev_logged_actual_hours_;
      Labour_Assignment_Util_API.Adjust_Tsk_Asgmt_Act_Hrs(task_seq_,task_resource_seq_,execution_instance_seq_,adjusted_hours_,resource_group_seq_);
   END IF;
   Client_SYS.Clear_Attr(attr_);
   Client_SYS.Add_To_Attr('ASSIGNMENT_FINISH', finish_time_, attr_);
   Client_SYS.Add_To_Attr('WORK_FINISH', finish_time_, attr_);
   Client_SYS.Add_To_Attr('TIME_TO_COMPLETION', actual_hours_, attr_);
   Jt_Execution_Instance_API.Complete_Execution_Instance(info_, attr_,task_seq_, execution_instance_seq_);     
END Finish_Assignment___;

FUNCTION Check_Inwork_Wp___ (
   aircraft_id_ IN NUMBER,
   location_    IN VARCHAR2) RETURN BOOLEAN
IS
BEGIN
	RETURN Av_Aircraft_Work_Package_API.Check_In_Work_Work_Packages(aircraft_id_, location_);
END Check_Inwork_Wp___;

FUNCTION Has_Started_Execution_Instances___ (
   task_seq_               IN NUMBER,
   execution_instance_seq_ IN NUMBER) RETURN BOOLEAN
IS
   count_  NUMBER := 0;
   count1_ NUMBER := 0;
   
   CURSOR get_started_assignments IS
      SELECT 1 
      FROM jt_execution_instance_tab
      WHERE task_seq = task_seq_
        AND rowstate = 'WORKSTARTED'
        AND execution_instance_seq != execution_instance_seq_;
   
   CURSOR get_final_sign_off IS
      SELECT 1
      FROM jt_execution_instance_tab
      WHERE task_seq = task_seq_
         AND rowstate = 'WORKSTARTED';
   
BEGIN
   OPEN get_started_assignments;
   FETCH get_started_assignments INTO count_;
   CLOSE get_started_assignments;
   
   OPEN get_final_sign_off;
   FETCH get_final_sign_off INTO count1_;
   CLOSE get_final_sign_off;
   
   IF (count1_ > 0 AND execution_instance_seq_ IS NULL )OR (count_ > 0) THEN      
      RETURN TRUE;
   END IF ;
   RETURN FALSE;
END Has_Started_Execution_Instances___;
   
@IgnoreUnitTest NoOutParams
PROCEDURE Cancel_Assignments___ (
   task_seq_                  IN NUMBER,
   execution_instance_seq_    IN NUMBER)
IS 
   info_                   VARCHAR2(2000);
   attr_                   VARCHAR2(2000);
   
   CURSOR get_assigned_assignments IS
      SELECT execution_instance_seq 
      FROM jt_execution_instance_tab
      WHERE task_seq = task_seq_
       AND rowstate = 'ASSIGNED'
       AND execution_instance_seq != execution_instance_seq_;
   
   CURSOR get_final_sign_off IS
      SELECT execution_instance_seq
      FROM jt_execution_instance_tab
      WHERE task_seq = task_seq_
         AND rowstate = 'ASSIGNED';
BEGIN
   FOR assigned_assignments_ IN get_assigned_assignments LOOP
      IF (assigned_assignments_.execution_instance_seq IS NOT NULL) THEN
         Client_SYS.Clear_Attr(attr_);
         Jt_Execution_Instance_API.Cancel_Execution_Instance(info_,  attr_, task_seq_, assigned_assignments_.execution_instance_seq);
      END IF;
   END LOOP;
   
   FOR assigned_final_assignments_ IN get_final_sign_off LOOP
      IF (assigned_final_assignments_.execution_instance_seq IS NOT NULL) THEN
         Client_SYS.Clear_Attr(attr_);
         Jt_Execution_Instance_API.Cancel_Execution_Instance(info_,  attr_, task_seq_, assigned_final_assignments_.execution_instance_seq);
      END IF;
   END LOOP;
END Cancel_Assignments___;

@IgnoreUnitTest NoOutParams
PROCEDURE Do_Job_Stop_Temporary___ (
   parent_objkey_             IN VARCHAR2,
   actual_hours_              IN VARCHAR2,
   incompletion_cause_        IN VARCHAR2,
   jobstop_note_              IN VARCHAR2,
   remaining_hours_           IN VARCHAR2,
   assign_to_me_new_task_res_ IN BOOLEAN 
   )
IS 
   parent_key_       Record_Work_Virtual_Key;
   parent_rec_       Record_Work_Virtual_Rec;
   parent_new_rec_   Record_Work_Virtual_Rec; 
   zero_minute_ VARCHAR2(5) := '00:00';
   one_minute_ VARCHAR2(5) := '00:01';
BEGIN   
   
   parent_key_.Objkey   := parent_objkey_;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
   parent_new_rec_.actual_hours := actual_hours_;
   parent_new_rec_.is_job_stop_executed := TRUE;
   parent_new_rec_.incompletion_cause := incompletion_cause_;
   parent_new_rec_.jobstop_note := jobstop_note_;
   parent_new_rec_.assign_to_me_new_task_res := assign_to_me_new_task_res_;
   parent_new_rec_.remaining_hours := remaining_hours_;
   IF remaining_hours_ = zero_minute_ THEN
      parent_new_rec_.remaining_hours := one_minute_;
   END IF;
   CRUD_Update___(parent_rec_, parent_new_rec_);

END Do_Job_Stop_Temporary___;

@IgnoreUnitTest NoOutParams
PROCEDURE Do_Job_Stop___ (
   clock_in_rec_        IN Clock_In_Virtual_Rec,
   record_work_vrt_rec_ IN Record_Work_Virtual_Rec
   )
IS 
   remaining_format_hours_ NUMBER;
   
BEGIN   
   remaining_format_hours_ := Format_Hours___(record_work_vrt_rec_.remaining_hours, 'Remaining hours');
   
   Labour_Assignment_Util_API.Do_Job_Stop(
      task_seq_                  =>record_work_vrt_rec_.task_seq,
      task_resource_seq_         =>record_work_vrt_rec_.task_resource_seq,
      execution_instance_seq_    =>record_work_vrt_rec_.execution_instance_seq,
      resource_group_seq_        =>record_work_vrt_rec_.resource_group_seq,
      user_resource_seq_         =>record_work_vrt_rec_.assigned_user_resource_seq,
      assignment_role_           =>record_work_vrt_rec_.remark,
      curr_assignment_status_    =>clock_in_rec_.assignment_status,
      actual_hours_              =>clock_in_rec_.actual_hours,
      remaining_hours_           =>remaining_format_hours_,
      start_time_                =>clock_in_rec_.start_time,
      end_time_                  =>clock_in_rec_.stop_time,
      job_stop_reason_           =>record_work_vrt_rec_.incompletion_cause,
      job_stop_note_             =>record_work_vrt_rec_.jobstop_note,
      assign_to_me_new_task_res_ =>record_work_vrt_rec_.assign_to_me_new_task_res);
   
END Do_Job_Stop___;

@IgnoreUnitTest NoOutParams
PROCEDURE Validate_Sign_Off___ (
   task_seq_        IN NUMBER,
   objkey_          IN VARCHAR2)
IS 
   step_key_                        Step_Virtual_Key;
   step_rec_                        Step_Virtual_Rec;
   step_new_rec_                    Step_Virtual_Rec;
   parent_key_                      Record_Work_Virtual_Key;
   parent_rec_                      Record_Work_Virtual_Rec;
   parent_new_rec_                  Record_Work_Virtual_Rec; 
   task_step_seq_                   NUMBER;
   sign_off_req_seq_                NUMBER;
   parent_objkey_                   VARCHAR2(4000);
   record_work_objkey_              VARCHAR2(4000);
   role_                            VARCHAR2(1000);
   license_id_                      VARCHAR2(1000);
   sign_off_status_                 VARCHAR2(1000);
   resource_id_                     VARCHAR2(4000);
   resource_license_                VARCHAR2(4000);
   sign_off_resource_               VARCHAR2(100);
   grouping_no_                     NUMBER;
   person_resource_                 Pers_License_Profile_Tab.person_id%TYPE;
   fnd_user_                        VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();    
   panel_key_                       Panel_Virtual_Key;
   panel_rec_                       Panel_Virtual_Rec;
   panel_new_rec_                   Panel_Virtual_Rec;
   task_resource_seq_               NUMBER;
   
   CURSOR get_sign_off IS
      SELECT parent_objkey, task_step_seq, sign_off_req_seq, role, license_id, sign_off_status, grouping_no
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE objkey = objkey_;
      
   CURSOR get_step_sign_offs(parent_objkey_ VARCHAR2, grouping_no_ NUMBER) IS
      SELECT  role, sign_off_status, identity
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_
      AND grouping_no = grouping_no_;
         
   CURSOR get_parent_obj_key_for_step(parent_objkey_ VARCHAR2) IS
      SELECT  parent_objkey
      FROM ${PROJECTION}_STEP_VIRTUAL_VRT
      WHERE objkey = parent_objkey_;
      
   CURSOR get_parent_obj_key_for_panel(parent_objkey_ VARCHAR2) IS
      SELECT  parent_objkey
      FROM ${PROJECTION}_PANEL_VIRTUAL_VRT
      WHERE objkey = parent_objkey_;
BEGIN

   OPEN get_sign_off;
   FETCH get_sign_off INTO parent_objkey_, task_step_seq_, sign_off_req_seq_, role_, license_id_, sign_off_status_, grouping_no_;
   CLOSE get_sign_off;

   IF (Jt_Task_Step_API.Get_Object_Connection_Lu_Na_Db(task_seq_, task_step_seq_) = 'AircraftPanel') THEN
      OPEN get_parent_obj_key_for_panel(parent_objkey_);
      FETCH get_parent_obj_key_for_panel INTO record_work_objkey_ ;
      CLOSE get_parent_obj_key_for_panel;
      
      panel_key_.objkey  := parent_objkey_;
      panel_rec_         := Get_Record___(panel_key_);
      panel_new_rec_     := panel_rec_;
      task_resource_seq_ := panel_new_rec_.task_resource_seq;    
   ELSE
      OPEN get_parent_obj_key_for_step(parent_objkey_);
      FETCH get_parent_obj_key_for_step INTO record_work_objkey_ ;
      CLOSE get_parent_obj_key_for_step;
      
      step_key_.objkey   := parent_objkey_;
      step_rec_          := Get_Record___(step_key_);
      step_new_rec_      := step_rec_;
      task_resource_seq_ := step_new_rec_.task_resource_seq;
   END IF;
   
   parent_key_.Objkey   := record_work_objkey_ ;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
   resource_id_         := Resource_API.Get_Resource_Id(Jt_Task_Resource_API.Get_Resource_Group_Seq(task_seq_, task_resource_seq_));
   
   IF task_resource_seq_ IS NOT NULL THEN
      resource_license_    := Labour_Assignment_Util_API.Get_Task_Resource_License_Id(task_seq_,task_resource_seq_);   
      sign_off_resource_   := SUBSTR(license_id_,1,INSTR(license_id_,'-')-1);
   END IF;
   
   IF (role_ = 'Inspector')THEN
      FOR rec_ IN get_step_sign_offs(parent_objkey_, grouping_no_) LOOP
         IF (rec_.role = 'Executor' AND rec_.sign_off_status != 'Signed') THEN
            Error_SYS.Record_General(lu_name_, 'ERRCERTSIGNBEFOREEXEC: Certifier cannot sign before the Executor.');
         END IF;
      END LOOP;
   END IF;
   
   IF (role_ = 'Independent')THEN
      FOR rec_ IN get_step_sign_offs(parent_objkey_, grouping_no_) LOOP
         IF (rec_.role = 'Inspector' AND rec_.sign_off_status != 'Signed') THEN
            Error_SYS.Record_General(lu_name_, 'ERRINSPSIGNBEFORECERT: Inspector cannot sign before the Certifier.');
         END IF;

         IF ((resource_id_ = sign_off_resource_ OR (resource_id_ IS NULL AND sign_off_resource_ IS NULL)) AND ((rec_.role = 'Executor' AND rec_.identity = fnd_user_) OR (rec_.role = 'Inspector' AND rec_.identity = fnd_user_))) THEN
            Error_SYS.Record_General(lu_name_, 'ERRINVALIDUSERTSKCD: You have already signed this step as Executor or Certifier. You cannot sign as Inspector.');
         END IF;
      END LOOP;
   END IF;
   
   IF (license_id_ IS NULL) AND (step_new_rec_.task_resource_seq IS NOT NULL) THEN
      IF ((resource_license_ like '%-EXECUTOR' AND role_ != 'Executor') OR (resource_license_ LIKE '%-INSPECTOR' AND role_ != 'Independent')) THEN
         Error_SYS.Record_General(lu_name_, 'ERRINVALASSIGNROLE: You cannot perform actions for this skill as it is not part of your assigned role.');
      END IF;
   -- Verifies if the user is attempting to sign on to other sign-offs that are not part of the user's designated role in the bulk sign-off flow for ad-hoc tasks.
   ELSIF (license_id_ IS NULL) AND (step_new_rec_.task_resource_seq IS NULL) THEN
      IF ((parent_new_rec_.remark = 'Executor' AND role_ != 'Executor') OR (parent_new_rec_.remark = 'Inspector' AND role_ != 'Independent')) THEN
         Error_SYS.Record_General(lu_name_, 'ERRINVALASSIGNROLE: You cannot perform actions for this skill as it is not part of your assigned role.');
      END IF;
   ELSE      
      person_resource_ := Resource_API.Get_User_Resource_Id();
      IF Pers_License_Profile_API.Check_Exist(person_resource_, license_id_) = 'FALSE' THEN
         Error_SYS.Record_General(lu_name_, 'ERRNOREQQULIFICATION: You do not have the required qualification to perform this action.');
      END IF;
      
      IF ((resource_id_ != sign_off_resource_) OR
         ((resource_license_ LIKE '%-EXECUTOR' AND role_ != 'Executor') OR
          (resource_license_ LIKE '%-CERTIFIER' AND role_ = 'Independent') OR 
          (resource_license_ LIKE '%-INSPECTOR' AND role_ != 'Independent'))) THEN
          Error_SYS.Record_General(lu_name_, 'ERRINVALASSIGNROLE: You cannot perform actions for this skill as it is not part of your assigned role.');
      END IF;
  
   END IF;
   
END Validate_Sign_Off___;

@IgnoreUnitTest NoOutParams
PROCEDURE Update_Step_Sign_Off___ (
   objkey_ IN VARCHAR2,
   sign_off_note_ IN VARCHAR2)
IS
   sign_off_key_                    Task_Step_Sign_Off_Virtual_Key;
   step_key_                        Step_Virtual_Key;
   panel_key_                       Panel_Virtual_Key;
   record_work_key_                 Record_Work_Virtual_Key;
   sign_off_new_rec_                Task_Step_Sign_Off_Virtual_Rec;
   sign_off_old_rec_                Task_Step_Sign_Off_Virtual_Rec;
   step_rec_                        Step_Virtual_Rec;
   panel_rec_                       Panel_Virtual_Rec;
   record_work_rec_                 Record_Work_Virtual_Rec;
    
BEGIN
   
   sign_off_key_.Objkey := objkey_;
   sign_off_old_rec_    := Get_Record___(sign_off_key_);
   sign_off_new_rec_    := sign_off_old_rec_;

   IF(sign_off_new_rec_.step_obj_conn_lu_name_db = 'AircraftPanel')THEN
      panel_key_.Objkey       := sign_off_new_rec_.parent_objkey;
      panel_rec_              := Get_Record___(panel_key_);
      record_work_key_.Objkey := panel_rec_.parent_objkey;
   ELSE
      step_key_.Objkey        := sign_off_new_rec_.parent_objkey;
      step_rec_               := Get_Record___(step_key_);
      record_work_key_.Objkey := step_rec_.parent_objkey;
   END IF;
   
   record_work_rec_      := Get_Record___(record_work_key_);

   sign_off_new_rec_.identity                   := Person_Info_API.Get_Id_For_User(Fnd_Session_API.Get_Fnd_User);
   sign_off_new_rec_.sign_off_note              := sign_off_note_;
   sign_off_new_rec_.sign_off_date              := Time_Util_API.Get_Sysdate_In_Utc;
   sign_off_new_rec_.sign_off_status            := 'Signed';
   sign_off_new_rec_.signed_flag                := TRUE;
   sign_off_new_rec_.is_revoke_sign_off_capable := TRUE;
   
   CRUD_Update___(sign_off_old_rec_, sign_off_new_rec_);
   Update_Revoke_Step_Sign_Off_Capability___( objkey_, 'sign' );
   Update_Task_Step(sign_off_new_rec_.parent_objkey, sign_off_new_rec_.step_obj_conn_lu_name_db); 
   
   IF record_work_rec_.is_edit_task_card_access = TRUE THEN
      CheckAndSetParentButtons___(step_rec_.parent_objkey, FALSE);  
   END IF;
END Update_Step_Sign_Off___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Step_Sign_Off___ (
   objkey_ IN VARCHAR2,
   revoke_sign_off_reason_ IN VARCHAR2)
IS
   sign_off_key_             Task_Step_Sign_Off_Virtual_Key;
   step_key_                 Step_Virtual_Key;
   panel_key_                Panel_Virtual_Key;
   record_work_key_          Record_Work_Virtual_Key;
   sign_off_new_rec_         Task_Step_Sign_Off_Virtual_Rec;
   sign_off_old_rec_         Task_Step_Sign_Off_Virtual_Rec;
   step_rec_                 Step_Virtual_Rec;
   panel_rec_                Panel_Virtual_Rec;
   record_work_rec_          Record_Work_Virtual_Rec;
BEGIN
   sign_off_key_.Objkey := objkey_;
   sign_off_old_rec_    := Get_Record___(sign_off_key_);
   sign_off_new_rec_    := sign_off_old_rec_;
   
   IF(sign_off_new_rec_.step_obj_conn_lu_name_db = 'AircraftPanel')THEN
      panel_key_.Objkey          := sign_off_new_rec_.parent_objkey;
      panel_rec_                 := Get_Record___(panel_key_);
      record_work_key_.Objkey    := panel_rec_.parent_objkey;
   ELSE
      step_key_.Objkey           := sign_off_new_rec_.parent_objkey;
      step_rec_                  := Get_Record___(step_key_);
      record_work_key_.Objkey    := step_rec_.parent_objkey;
   END IF;
   
   record_work_rec_     := Get_Record___(record_work_key_);

   sign_off_new_rec_.identity        := NULL;
   sign_off_new_rec_.sign_off_note   := NULL;
   sign_off_new_rec_.sign_off_date   := NULL;
   sign_off_new_rec_.sign_off_status := 'Pending';
   sign_off_new_rec_.signed_flag     := FALSE;
   sign_off_new_rec_.is_revoke_sign_off_capable := FALSE;
   IF revoke_sign_off_reason_ IS NOT NULL THEN
      sign_off_new_rec_.revoke_sign_off_reason := revoke_sign_off_reason_;
   END IF;
   
   CRUD_Update___(sign_off_old_rec_, sign_off_new_rec_);
   Update_Revoke_Step_Sign_Off_Capability___(objkey_, 'revoke');
   Update_Task_Step(sign_off_new_rec_.parent_objkey, sign_off_new_rec_.step_obj_conn_lu_name_db); 
   
   IF record_work_rec_.is_edit_task_card_access = TRUE THEN
      CheckAndSetParentButtons___(step_rec_.parent_objkey, FALSE);  
   END IF; 
END Revoke_Step_Sign_Off___;

PROCEDURE Update_Task_Step(
   step_objkey_ VARCHAR2,
   step_conn_type_ VARCHAR2)
   
IS
   step_key_                 Step_Virtual_Key;
   step_new_rec_             Step_Virtual_Rec;
   step_old_rec_             Step_Virtual_Rec;
   pending_sign_off_count_   NUMBER;
   signed_sign_off_count_    NUMBER;
   panel_key_                Panel_Virtual_Key;
   panel_new_rec_            Panel_Virtual_Rec;
   panel_old_rec_            Panel_Virtual_Rec;
   
   CURSOR get_pending_sign_off_count IS
      SELECT  count(*)
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE parent_objkey = step_objkey_
      AND sign_off_status = 'Pending';
      
   CURSOR get_signed_sign_off_count IS
      SELECT  count(*)
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE parent_objkey = step_objkey_
      AND sign_off_status = 'Signed';
      
BEGIN
   
   IF (step_conn_type_ = 'AircraftPanel') THEN
      panel_key_.Objkey := step_objkey_;
      panel_old_rec_    := Get_Record___(panel_key_);
      panel_new_rec_    := panel_old_rec_;
   ELSE
      step_key_.Objkey := step_objkey_;
      step_old_rec_    := Get_Record___(step_key_);
      step_new_rec_    := step_old_rec_;
   END IF;
   
   OPEN get_pending_sign_off_count;
   FETCH get_pending_sign_off_count INTO pending_sign_off_count_;
   CLOSE get_pending_sign_off_count;
   
   OPEN get_signed_sign_off_count;
   FETCH get_signed_sign_off_count INTO signed_sign_off_count_;
   CLOSE get_signed_sign_off_count;
   
   IF (pending_sign_off_count_ > 0 ) THEN
      IF signed_sign_off_count_ = 0 THEN 
         IF (step_conn_type_ = 'AircraftPanel') THEN
            panel_new_rec_.step_status := 'NOTDONE';
            CRUD_Update___(panel_old_rec_, panel_new_rec_);
         ELSE
            step_new_rec_.step_status := 'NOTDONE';
            CRUD_Update___(step_old_rec_, step_new_rec_);
         END IF;
      ELSIF signed_sign_off_count_ > 0 THEN           
         IF (step_conn_type_ = 'AircraftPanel') THEN
            panel_new_rec_.step_status := 'PENDING';
            CRUD_Update___(panel_old_rec_, panel_new_rec_);
         ELSE
            step_new_rec_.step_status := 'PENDING';
            CRUD_Update___(step_old_rec_, step_new_rec_);
         END IF;
      END IF;
   END IF;
   
   IF (pending_sign_off_count_ = 0 AND signed_sign_off_count_ > 0) THEN
      IF (step_conn_type_ = 'AircraftPanel') THEN
         panel_new_rec_.step_status := 'DONE';
         CRUD_Update___(panel_old_rec_, panel_new_rec_);
      ELSE
         step_new_rec_.step_status := 'DONE';
         CRUD_Update___(step_old_rec_, step_new_rec_);
      END IF;
   END IF;   
END Update_Task_Step;

FUNCTION Sign_Off_Count_For_Session___(
   objkey_ IN VARCHAR2) RETURN NUMBER
IS
   step_sign_off_count_    NUMBER;
   panel_sign_off_count_   NUMBER;
      
   CURSOR step_sign_off_count IS
      SELECT count(sign_off.objkey)
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off, ${PROJECTION}_STEP_VIRTUAL_VRT task_step 
      WHERE sign_off.parent_objkey = task_step.objkey
      AND task_step.parent_objkey = objkey_
      AND role = 'Executor' 
      AND sign_off_status = 'Signed'
      AND signed_flag = 1; 
      
   CURSOR panel_sign_off_count IS
      SELECT count(sign_off.objkey)
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off, ${PROJECTION}_PANEL_VIRTUAL_VRT panel 
      WHERE sign_off.parent_objkey = panel.objkey
      AND panel.parent_objkey = objkey_
      AND role = 'Executor' 
      AND sign_off_status = 'Signed'
      AND signed_flag = 1;
   
BEGIN
	
   OPEN step_sign_off_count;
   FETCH step_sign_off_count INTO step_sign_off_count_;
   CLOSE step_sign_off_count;
   
   OPEN panel_sign_off_count;
   FETCH panel_sign_off_count INTO panel_sign_off_count_;
   CLOSE panel_sign_off_count;
   
   RETURN (step_sign_off_count_ + panel_sign_off_count_);
   
END Sign_Off_Count_For_Session___;

@IgnoreUnitTest NoOutParams
PROCEDURE Validate_Bulk_Sign_Off___ (
   task_seq_            IN NUMBER,
   license_id_          IN VARCHAR2,
   role_                IN VARCHAR2)
IS
   execution_instance_seq_       NUMBER;
   is_assignment_exist_          NUMBER;
   is_valid_certificate_exists_  VARCHAR2(10) := 'FALSE';
   resource_id_                  VARCHAR2(30);
   remark_                       VARCHAR2(30);
   fnd_user_                     VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();
   
   CURSOR get_execution_instance_seq(task_seq_ NUMBER, remark_ VARCHAR2, fnd_user_ VARCHAR2, resource_id_ VARCHAR2) IS
      SELECT execution_instance_seq
      FROM jt_task_resource_demand_av_uiv
      WHERE task_seq = task_seq_
      AND remark = remark_
      AND assigned_resource_id = fnd_user_
      AND resource_demand = resource_id_
      AND rowstate IN ('ASSIGNED','WORKSTARTED');
      
   CURSOR is_assignment_exists(task_seq_ NUMBER, fnd_user_ VARCHAR2, role_ VARCHAR2) IS
      SELECT 1
      FROM jt_task_resource_demand_av_uiv
      WHERE task_seq = task_seq_
      AND assigned_resource_id = fnd_user_
      AND rowstate IN ('ASSIGNED','WORKSTARTED')
      AND (
          (role_ = 'Executor' AND remark = 'Executor')
          OR (role_ = 'Inspector' AND remark = 'Certifier')
          OR (role_ = 'Independent' AND remark = 'Inspector')
      );
BEGIN
   IF license_id_ IS NOT NULL THEN
      is_valid_certificate_exists_ := Pers_License_Profile_API.Check_Exist(fnd_user_, license_id_);
      
      IF (is_valid_certificate_exists_ = 'TRUE') THEN
         resource_id_   := SUBSTR(license_id_,1,INSTR(license_id_,'-')-1);
         remark_        := INITCAP(SUBSTR(license_id_, INSTR(license_id_, '-') + 1));
         
         OPEN get_execution_instance_seq(task_seq_, remark_, fnd_user_, resource_id_);
         FETCH get_execution_instance_seq INTO execution_instance_seq_;
         CLOSE get_execution_instance_seq;
             
         IF execution_instance_seq_ IS NULL THEN
            Error_SYS.Record_General(lu_name_, 'MISSINGASSIGNMENT: You must have an assignment to sign off.');            
         END IF;
      ELSE
         Error_SYS.Record_General(lu_name_, 'INVALIDCERTIFICATE: You do not have the required skill or qualification.');
      END IF;
   ELSE
      OPEN is_assignment_exists(task_seq_, fnd_user_, role_);
      FETCH is_assignment_exists INTO is_assignment_exist_;
      IF is_assignment_exists%NOTFOUND THEN
         CLOSE is_assignment_exists;
         Error_SYS.Record_General(lu_name_, 'MISSINGASSIGNMENT: You must have an assignment to sign off.');  
      END IF;

      CLOSE is_assignment_exists;        
   END IF;
END Validate_Bulk_Sign_Off___;

@IgnoreUnitTest NoOutParams
PROCEDURE Check_Step_Signed___(
   role_                   IN VARCHAR2,
   task_seq_               IN NUMBER,
   task_step_seq_          IN NUMBER,
   sign_off_req_seq_       IN NUMBER,
   license_id_             IN VARCHAR2,
   obj_conn_lu_name_db_    IN VARCHAR2) 
IS
   resource_id_                        VARCHAR2(30);
   license_type_                       VARCHAR2(30) := NULL;
   fnd_user_                           VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();
   has_incomplete_previous_sign_off_   NUMBER;
   
   CURSOR has_incomplete_previous_sign_off(license_type_ VARCHAR2, sign_off_req_type_ VARCHAR2) IS
      SELECT 1
      FROM jt_task_step_sign_off js
      INNER JOIN jt_task_sign_off_req jr
      ON jr.task_seq = js.task_seq
      AND jr.sign_off_req_seq = js.sign_off_req_seq
      WHERE js.task_seq = task_seq_
      AND js.sign_off_req_seq != sign_off_req_seq_
      AND js.task_step_seq = task_step_seq_
      AND (license_type_ IS NULL OR jr.license_id LIKE license_type_)
      AND jr.sign_off_req_type = sign_off_req_type_
      AND js.identity IS NULL;      
BEGIN
   IF license_id_ IS NOT NULL THEN      
      resource_id_   := SUBSTR(license_id_, 1, INSTR(license_id_, '-'));
      license_type_  := resource_id_||'%';
   END IF;
   
   IF (role_ = 'Inspector')THEN
      OPEN has_incomplete_previous_sign_off(license_type_, 'Executor');
      FETCH has_incomplete_previous_sign_off INTO has_incomplete_previous_sign_off_;
      IF has_incomplete_previous_sign_off%FOUND THEN
         CLOSE has_incomplete_previous_sign_off;
         IF obj_conn_lu_name_db_ = 'AircraftPanel' THEN
            Error_SYS.Record_General(lu_name_, 'INCOMPLETEEXECUTION: One or more panels have not been executed.');
         ELSE
            Error_SYS.Record_General(lu_name_, 'INCOMPLETEEXECUTION: One or more steps have not been executed.');
         END IF;
      END IF;
      CLOSE has_incomplete_previous_sign_off;
   END IF;

   IF (role_ = 'Independent')THEN      
      OPEN has_incomplete_previous_sign_off(license_type_, 'Inspector');
      FETCH has_incomplete_previous_sign_off INTO has_incomplete_previous_sign_off_;
      IF has_incomplete_previous_sign_off%FOUND THEN
         CLOSE has_incomplete_previous_sign_off;
         IF obj_conn_lu_name_db_ = 'AircraftPanel' THEN
            Error_SYS.Record_General(lu_name_, 'UNCERTIFIEDSTEPS: One or more panels have not been certified.');
         ELSE
            Error_SYS.Record_General(lu_name_, 'UNCERTIFIEDSTEPS: One or more steps have not been certified.');
         END IF;
      END IF;
      CLOSE has_incomplete_previous_sign_off;
   END IF;
END Check_Step_Signed___;

@IgnoreUnitTest NoOutParams
PROCEDURE Check_Inspector_Sign_Off___(
   role_                   IN VARCHAR2,
   task_seq_               IN NUMBER,
   task_step_seq_          IN NUMBER,
   sign_off_req_seq_       IN NUMBER,
   license_id_             IN VARCHAR2,
   obj_conn_lu_name_db_    IN VARCHAR2) 
IS
   resource_id_                     VARCHAR2(30) := NULL;
   license_type_                    VARCHAR2(30) := NULL;
   fnd_user_                        VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();
   assignment_role_conflict_exist_  NUMBER;
   
   CURSOR has_assignment_role_conflict(license_type_ VARCHAR2, identity_ VARCHAR2) IS
      SELECT 1
      FROM jt_task_step_sign_off js
      INNER JOIN jt_task_sign_off_req jr
      ON jr.task_seq = js.task_seq
      AND jr.sign_off_req_seq = js.sign_off_req_seq
      WHERE js.task_seq = task_seq_
      AND js.sign_off_req_seq != sign_off_req_seq_
      AND js.task_step_seq = task_step_seq_
      AND (license_type_ IS NULL OR jr.license_id LIKE license_type_)
      AND js.identity = identity_
      AND jr.sign_off_req_type IN ('Executor', 'Inspector');      
BEGIN
   IF license_id_ IS NOT NULL THEN
      resource_id_   := SUBSTR(license_id_, 1, INSTR(license_id_, '-'));
      license_type_  := resource_id_||'%';
   END IF;
   
   IF (role_ = 'Independent') THEN
      OPEN has_assignment_role_conflict(license_type_, fnd_user_);
      FETCH has_assignment_role_conflict INTO assignment_role_conflict_exist_;
      IF has_assignment_role_conflict%FOUND THEN
         CLOSE has_assignment_role_conflict;
         IF obj_conn_lu_name_db_ = 'AircraftPanel' THEN
            Error_SYS.Record_General(lu_name_, 'ERRINVALIDUSER: You have already signed one or more panels as Executor or Certifier. You cannot sign as Inspector.');
         ELSE
            Error_SYS.Record_General(lu_name_, 'ERRINVALIDUSER: You have already signed one or more steps as Executor or Certifier. You cannot sign as Inspector.');
         END IF;
      END IF;
      CLOSE has_assignment_role_conflict;
   END IF;
   
END Check_Inspector_Sign_Off___;


FUNCTION Get_Record_Work_Info___(
   selection_           IN VARCHAR2) RETURN Record_Work_Info_Structure_Rec
IS
   task_seq_                       NUMBER;
   task_step_seq_                  NUMBER;
   sign_off_req_seq_               NUMBER;
   string_tab_                     Utility_SYS.STRING_TABLE;
   token_number_                   NUMBER;
   assignment_status_              jt_execution_instance_tab.rowstate%TYPE;
   scheduled_hours_                VARCHAR2(10);
   license_id_                     Jt_Task_Sign_Off_Req_Tab.license_id%TYPE;
   role_                           Jt_Task_Sign_Off_Req_Tab.sign_off_req_type%TYPE;
   rec_                            Av_Exe_Task_API.Public_Rec;
   record_work_info_structure_rec_ Record_Work_Info_Structure_Rec;
   resource_id_                    VARCHAR2(30);
   remark_                         VARCHAR2(30);
   fnd_user_                       VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();
   assignment_start_               jt_task_resource_demand_av_uiv.assignment_start%TYPE;
   task_resource_seq_              NUMBER;
   execution_instance_seq_         NUMBER;
   assigned_user_resource_seq_     NUMBER;
   resource_group_seq_             NUMBER;
   
   CURSOR get_assignment_details(task_seq_ NUMBER, remark_ VARCHAR2, fnd_user_ VARCHAR2, resource_id_ VARCHAR2) IS
      SELECT rowstate, Adcom_Util_API.Get_Text_Time(planned_hours), assignment_start, task_resource_seq, execution_instance_seq, assigned_resource_seq, resource_group_seq
      FROM jt_task_resource_demand_av_uiv
      WHERE task_seq = task_seq_
      AND remark = remark_
      AND assigned_resource_id = fnd_user_
      AND resource_demand = resource_id_
      AND rowstate IN ('ASSIGNED','WORKSTARTED');
BEGIN
   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_seq_         := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_SEQ'); 
      task_step_seq_    := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_STEP_SEQ');
      sign_off_req_seq_ := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'SIGN_OFF_REQ_SEQ');
   END LOOP;
   
   license_id_       := Jt_Task_Sign_Off_Req_API.Get_License_Id(task_seq_, sign_off_req_seq_);
   rec_              := Av_Exe_Task_API.Get(task_seq_);
   role_             := Jt_Task_Sign_Off_Req_API.Get_Sign_Off_Req_Type(task_seq_, sign_off_req_seq_);
    
   record_work_info_structure_rec_.task_seq                 := task_seq_;
   record_work_info_structure_rec_.fault_id                 := rec_.fault_id;
   record_work_info_structure_rec_.class_code               := rec_.class_code;
   record_work_info_structure_rec_.subclass_code            := rec_.subclass_code;
   record_work_info_structure_rec_.signed_by                := Fnd_Session_API.Get_Fnd_User();
   record_work_info_structure_rec_.aircraft_wp_id           := rec_.aircraft_wp_id;
   record_work_info_structure_rec_.aircraft_id              := rec_.aircraft_id;
   record_work_info_structure_rec_.flight_id                := Av_Exe_Task_API.Get_Flight_Id_By_Task_Id(task_seq_);
   record_work_info_structure_rec_.objstate                 := rec_.rowstate;
   Client_SYS.Add_To_Key_Reference(record_work_info_structure_rec_.key_ref, 'TASK_SEQ', task_seq_);
   record_work_info_structure_rec_.lu_name                  := Jt_Task_Step_Sign_Off_API.lu_name_;
   record_work_info_structure_rec_.source                   := 'RecordWork';
   record_work_info_structure_rec_.selection                := selection_;
   record_work_info_structure_rec_.record_work_start_time   := Time_Util_API.Get_Sysdate_In_Utc;
   record_work_info_structure_rec_.is_edit_task_card_access := FALSE;
   
   IF license_id_ IS NOT NULL THEN
      resource_id_   := SUBSTR(license_id_,1,INSTR(license_id_,'-')-1);
      remark_        := INITCAP(SUBSTR(license_id_, INSTR(license_id_, '-') + 1));
      
      OPEN get_assignment_details(task_seq_, remark_, fnd_user_, resource_id_);
      FETCH get_assignment_details INTO assignment_status_, scheduled_hours_, assignment_start_, task_resource_seq_, execution_instance_seq_, assigned_user_resource_seq_, resource_group_seq_;
      CLOSE get_assignment_details;
     
      record_work_info_structure_rec_.task_resource_seq           := task_resource_seq_;
      record_work_info_structure_rec_.execution_instance_seq      := execution_instance_seq_;
      record_work_info_structure_rec_.assignment_status           := assignment_status_;
      record_work_info_structure_rec_.assignment_start            := assignment_start_;
      record_work_info_structure_rec_.scheduled_hours             := scheduled_hours_;
      record_work_info_structure_rec_.assigned_user_resource_seq  := assigned_user_resource_seq_;
      record_work_info_structure_rec_.resource_group_seq          := resource_group_seq_;
      record_work_info_structure_rec_.remark                      := remark_;
      record_work_info_structure_rec_.certify_work_performed      := TRUE;
   ELSE
      IF (role_ = 'Inspector') THEN
         remark_  := 'Certifier';
      ELSIF (role_ = 'Independent') THEN
         remark_  := 'Inspector';
      ELSE
         remark_  := 'Executor';
      END IF;
      record_work_info_structure_rec_.remark                      := remark_;
   END IF;

   IF (remark_ != 'Certifier') THEN
      record_work_info_structure_rec_.certify_work_performed   := FALSE;  
   END IF;
      
   RETURN record_work_info_structure_rec_;
END Get_Record_Work_Info___;

PROCEDURE Update_Record_Work_Virtual___(
   objkey_                 IN VARCHAR2,
   task_seq_               IN NUMBER,
   task_resouce_seq_       IN NUMBER,
   execution_instance_seq_ IN NUMBER)
IS
   record_work_virtual_key_         Record_Work_Virtual_Key;
   record_work_virtual_rec_         Record_Work_Virtual_Rec;
   new_record_work_virtual_rec_     Record_Work_Virtual_Rec;
   clock_in_virtual_key_            Clock_In_Virtual_Key;
   clock_in_virtual_rec_            Clock_In_Virtual_Rec;
   new_clock_in_virtual_rec_        Clock_In_Virtual_Rec;
   
   CURSOR get_clock_in_objkey(parent_objkey_ IN VARCHAR2) IS
      SELECT  objkey
      FROM ${PROJECTION}_CLOCK_IN_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_;
BEGIN
   record_work_virtual_key_.Objkey  := objkey_;
   record_work_virtual_rec_         := Get_Record___(record_work_virtual_key_);
   new_record_work_virtual_rec_     := record_work_virtual_rec_;
   
   new_record_work_virtual_rec_.task_resource_seq           := task_resouce_seq_;
   new_record_work_virtual_rec_.execution_instance_seq      := execution_instance_seq_;
   new_record_work_virtual_rec_.assignment_start            := Jt_Execution_Instance_API.Get_Assignment_Start(task_seq_, execution_instance_seq_);
   new_record_work_virtual_rec_.assignment_status           := Jt_Execution_Instance_API.Get_Objstate(task_seq_, execution_instance_seq_);
   new_record_work_virtual_rec_.scheduled_hours             := Adcom_Util_API.Get_Text_Time(Jt_Task_Resource_API.Get_Planned_Hours(task_seq_, task_resouce_seq_));
   new_record_work_virtual_rec_.assigned_user_resource_seq  := Jt_Execution_Instance_API.Get_Resource_Seq(task_seq_, execution_instance_seq_);
   new_record_work_virtual_rec_.resource_group_seq          := Jt_Task_Resource_API.Get_Resource_Seq(task_seq_, task_resouce_seq_);
   new_record_work_virtual_rec_.remark                      := Jt_Task_Resource_API.Get_Remark(task_seq_, task_resouce_seq_);

   OPEN get_clock_in_objkey(objkey_);
   FETCH get_clock_in_objkey INTO clock_in_virtual_key_.Objkey;
   CLOSE get_clock_in_objkey;

   clock_in_virtual_rec_                              := Get_Record___(clock_in_virtual_key_);
   new_clock_in_virtual_rec_                          := clock_in_virtual_rec_;
   new_clock_in_virtual_rec_.execution_instance_seq   := execution_instance_seq_;
   new_clock_in_virtual_rec_.assignment_status        := new_record_work_virtual_rec_.assignment_status;
   
   IF new_record_work_virtual_rec_.assignment_status = 'ASSIGNED' THEN
      new_clock_in_virtual_rec_.start_time            := new_record_work_virtual_rec_.record_work_start_time;
   ELSE
      new_clock_in_virtual_rec_.start_time            := new_record_work_virtual_rec_.assignment_start; 
   END IF;

   CRUD_Update___(clock_in_virtual_rec_, new_clock_in_virtual_rec_);
   CRUD_Update___(record_work_virtual_rec_, new_record_work_virtual_rec_);
END Update_Record_Work_Virtual___;

FUNCTION Calculate_Assignmnt_Tot_Actual_Hrs___(
   task_seq_                  IN NUMBER,
   execution_instance_seq_    IN NUMBER,
   end_time_                  IN DATE,
   site_                      IN VARCHAR2) RETURN VARCHAR2 
IS
   reported_actual_hours_  NUMBER;
   pending_actual_hours_   NUMBER; 
   total_actual_hours_     NUMBER;
   latest_clocking_time_   DATE;
   formatted_actual_hours_ VARCHAR2(2000); 
   
   CURSOR get_assignment_clockin_time IS
   SELECT start_time
   FROM jt_task_clocking_tab
   WHERE task_seq = task_seq_
   AND execution_instance_seq = execution_instance_seq_
   AND clocking_type = 'CLOCKED_IN'
   AND stop_time IS NULL;
BEGIN
   reported_actual_hours_ := JT_TASK_TRANSACTION_API.Get_Tot_Personel_Reported_Hrs(task_seq_, execution_instance_seq_);
   
   OPEN get_assignment_clockin_time;
   FETCH get_assignment_clockin_time INTO latest_clocking_time_;
   CLOSE get_assignment_clockin_time;
   
   IF latest_clocking_time_ IS NOT NULL THEN
      pending_actual_hours_ := Adcom_Util_API.Get_Time_Difference_In_Hours(latest_clocking_time_, end_time_);
      IF reported_actual_hours_ IS NOT NULL THEN
         total_actual_hours_ := reported_actual_hours_ + pending_actual_hours_;
      ELSE
         total_actual_hours_ := pending_actual_hours_;
      END IF;

      formatted_actual_hours_ := Adcom_Util_API.Get_Text_Time(total_actual_hours_);
   END IF;
     
   RETURN formatted_actual_hours_;
   
END Calculate_Assignmnt_Tot_Actual_Hrs___;

FUNCTION Check_Exist_Independent___ (
   task_seq_ IN NUMBER)RETURN BOOLEAN
IS 
   count_ NUMBER := 0;
   
   CURSOR get_sign_off_exist IS
      SELECT 1 FROM JT_TASK_SIGN_OFF_REQ_TAB
      WHERE task_seq = task_seq_ 
      AND Sign_Off_Req_Type = 'INDEPENDENT' 
      AND Sign_Off_Connection = 'TASK'; 
  
BEGIN
   OPEN get_sign_off_exist;
   FETCH get_sign_off_exist INTO count_;
   CLOSE get_sign_off_exist;
   
   RETURN count_ > 0;
   
END Check_Exist_Independent___;

FUNCTION Get_Save_Action_Confirm_Msg___ (
   actual_hours_         IN VARCHAR2,
   remaining_hours_      IN VARCHAR2,
   is_job_stop_executed_ IN BOOLEAN) RETURN VARCHAR2
IS
   confirm_msg_  VARCHAR2(100);
BEGIN
   confirm_msg_ := 'Save Actual Hours as '|| actual_hours_;
   IF is_job_stop_executed_ THEN
      confirm_msg_ := confirm_msg_ ||' and Remaining Hours as ' || remaining_hours_;
   END IF;
   confirm_msg_ := confirm_msg_ ||'?';
   RETURN confirm_msg_;
END Get_Save_Action_Confirm_Msg___;

@IgnoreUnitTest NoOutParams
PROCEDURE Is_Skill_Mandatory___ (
   objkey_            IN VARCHAR2,
   task_resource_seq_ IN NUMBER)
IS
   parent_key_                      Record_Work_Virtual_Key;
   parent_rec_                      Record_Work_Virtual_Rec;
   parent_new_rec_                  Record_Work_Virtual_Rec;
BEGIN
   parent_key_.Objkey   := objkey_;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
   IF (parent_new_rec_.selection IS NOT NULL AND task_resource_seq_ IS NULL) THEN
      Error_SYS.Record_General(lu_name_, 'MISSINGSKILL: Skill is required.');
   END IF;   
END Is_Skill_Mandatory___;

@IgnoreUnitTest NoOutParams
PROCEDURE Update_Revoke_Step_Sign_Off_Capability___ (
   objkey_  IN VARCHAR2,
   update_type_ IN VARCHAR2 ) 
IS 
   executor_sign_off_key_               Task_Step_Sign_Off_Virtual_Key;
   executor_old_step_sign_off_rec_      Task_Step_Sign_Off_Virtual_Rec;
   executor_new_step_sign_off_rec_      Task_Step_Sign_Off_Virtual_Rec;
   certifier_sign_off_key_              Task_Step_Sign_Off_Virtual_Key;
   certifier_old_step_sign_off_rec_     Task_Step_Sign_Off_Virtual_Rec;
   certifier_new_step_sign_off_rec_     Task_Step_Sign_Off_Virtual_Rec;
   sign_off_key_                        Task_Step_Sign_Off_Virtual_Key;
   sign_off_new_rec_                    Task_Step_Sign_Off_Virtual_Rec;
   sign_off_old_rec_                    Task_Step_Sign_Off_Virtual_Rec;
   step_parent_key_                     VARCHAR2(50);
   task_seq_                            NUMBER;
   task_step_seq_                       NUMBER;
   grouping_no_                         NUMBER;
   updated_role_                        VARCHAR2(20); 
   
   CURSOR get_sign_off_objkey(task_seq_ NUMBER, task_step_seq_ NUMBER, grouping_no_ NUMBER, role_ VARCHAR2, step_parent_key_ VARCHAR2 ) IS
      SELECT  objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE task_seq = task_seq_ 
      AND task_step_seq = task_step_seq_
      AND grouping_no = grouping_no_
      AND parent_objkey = step_parent_key_
      AND role = role_;  
        
BEGIN
   sign_off_key_.Objkey := objkey_;
   sign_off_old_rec_    := Get_Record___(sign_off_key_);
   sign_off_new_rec_    := sign_off_old_rec_;
   
   step_parent_key_     := sign_off_old_rec_.parent_objkey;                    
   task_seq_            := sign_off_old_rec_.task_seq;             
   task_step_seq_       := sign_off_old_rec_.task_step_seq;               
   grouping_no_         := sign_off_old_rec_.grouping_no;
   updated_role_        := sign_off_old_rec_.role;
  
   OPEN get_sign_off_objkey(task_seq_, task_step_seq_, grouping_no_, 'Executor', step_parent_key_);
   FETCH get_sign_off_objkey INTO executor_sign_off_key_;
   CLOSE get_sign_off_objkey;
   
   executor_old_step_sign_off_rec_    := Get_Record___(executor_sign_off_key_);
   executor_new_step_sign_off_rec_    := executor_old_step_sign_off_rec_;
   
   OPEN get_sign_off_objkey(task_seq_, task_step_seq_, grouping_no_, 'Inspector', step_parent_key_);
   FETCH get_sign_off_objkey INTO certifier_sign_off_key_;
   CLOSE get_sign_off_objkey;
   
   IF update_type_ IN ('sign') THEN 
      sign_off_new_rec_.is_revoke_sign_off_capable := TRUE;
      CRUD_Update___(sign_off_old_rec_, sign_off_new_rec_);

      IF updated_role_ = 'Inspector' THEN
         IF executor_new_step_sign_off_rec_.identity IS NOT NULL THEN
            executor_new_step_sign_off_rec_.is_revoke_sign_off_capable := FALSE;
            CRUD_Update___(executor_old_step_sign_off_rec_, executor_new_step_sign_off_rec_);
         END IF;       
      END IF;

      IF updated_role_ = 'Independent' THEN  
         certifier_old_step_sign_off_rec_   := Get_Record___(certifier_sign_off_key_);
         certifier_new_step_sign_off_rec_   := certifier_old_step_sign_off_rec_;

         IF certifier_new_step_sign_off_rec_.identity IS NOT NULL THEN
            certifier_new_step_sign_off_rec_.is_revoke_sign_off_capable := FALSE;
            CRUD_Update___(certifier_old_step_sign_off_rec_, certifier_new_step_sign_off_rec_);
         END IF; 
         IF executor_new_step_sign_off_rec_.identity IS NOT NULL THEN
            executor_new_step_sign_off_rec_.is_revoke_sign_off_capable := FALSE;
            CRUD_Update___(executor_old_step_sign_off_rec_, executor_new_step_sign_off_rec_);
         END IF;
      END IF; 
   END IF;
   
   IF update_type_ = 'revoke' THEN
      IF updated_role_ = 'Independent' THEN 
         certifier_old_step_sign_off_rec_   := Get_Record___(certifier_sign_off_key_);
         certifier_new_step_sign_off_rec_   := certifier_old_step_sign_off_rec_;

         IF certifier_new_step_sign_off_rec_.identity IS NOT NULL THEN 
            certifier_new_step_sign_off_rec_.is_revoke_sign_off_capable := TRUE;
            certifier_new_step_sign_off_rec_.revoke_enable := TRUE;
            CRUD_Update___(certifier_old_step_sign_off_rec_, certifier_new_step_sign_off_rec_);
         END IF;
         IF executor_new_step_sign_off_rec_.identity IS NOT NULL THEN
            executor_new_step_sign_off_rec_.is_revoke_sign_off_capable := FALSE;
            CRUD_Update___(executor_old_step_sign_off_rec_, executor_new_step_sign_off_rec_);
         END IF;
      END IF;
      
      IF updated_role_ = 'Inspector' THEN 
         IF executor_new_step_sign_off_rec_.identity IS NOT NULL THEN 
            executor_new_step_sign_off_rec_.is_revoke_sign_off_capable := TRUE;
            executor_new_step_sign_off_rec_.revoke_enable := TRUE;
            CRUD_Update___(executor_old_step_sign_off_rec_, executor_new_step_sign_off_rec_);
         END IF;
      END IF;
      
   END IF;
   
END Update_Revoke_Step_Sign_Off_Capability___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Task_Certification___ (
   objkey_ IN VARCHAR2)
IS
   task_cert_key_             Task_Certify_Virtual_Key;
   task_cert_new_rec_         Task_Certify_Virtual_Rec;
   task_cert_old_rec_         Task_Certify_Virtual_Rec;
   task_state_                VARCHAR2(40);
BEGIN
   task_cert_key_.Objkey := objkey_;
   task_cert_old_rec_    := Get_Record___(task_cert_key_);
   task_cert_new_rec_    := task_cert_old_rec_;
   task_state_           := Av_Exe_Task_API.Get_Objstate(task_cert_new_rec_.task_seq);
     
   task_cert_new_rec_.completion_note           := NULL;
   task_cert_new_rec_.actual_end_date           := NULL;
   task_cert_new_rec_.signed_by                 := NULL;
   task_cert_new_rec_.identity_name             := NULL;  
   task_cert_new_rec_.sign_off_status           := 'Pending';
   IF task_cert_old_rec_.Sign_Off_Req_Type = 'Inspector' THEN 
      task_cert_new_rec_.task_certification_enable := FALSE;     
   END IF;
   task_cert_new_rec_.approval_number           := NULL;
   task_cert_new_rec_.signed_flag               := FALSE;  
   task_cert_new_rec_.is_final_sign_off         := FALSE; 
   task_cert_new_rec_.task_objstate             := task_state_;
   task_cert_new_rec_.complete_task_enable      := TRUE;
   
   CRUD_Update___(task_cert_old_rec_, task_cert_new_rec_); 
   CheckAndSetParentButtons___(task_cert_new_rec_.parent_objkey, FALSE); 
END Revoke_Task_Certification___;

