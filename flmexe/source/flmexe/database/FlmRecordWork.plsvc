@IgnoreUnitTest NoOutParams
PROCEDURE Edit_Removed_Part___ (
   objkey_ IN VARCHAR2,
   removal_part_no_id_ IN VARCHAR2,
   removal_serial_no_ IN VARCHAR2,
   removal_reason_code_ IN VARCHAR2,
   removed_quantity_    IN NUMBER,
   removal_batch_no_    IN VARCHAR2,
   removal_edit_reason_ IN VARCHAR2,
   config_slot_pos_id_  IN VARCHAR2)
IS
   old_rec_                   Removed_Part_Line_Virtual_Rec;
   new_rec_                   Removed_Part_Line_Virtual_Rec;
   child_key_                 Removed_Part_Line_Virtual_Key;
   config_slot_pos_code_      VARCHAR2(50);
   assy_config_slot_pos_code_ VARCHAR2(50);
   assy_pos_                  VARCHAR2(50);
BEGIN
	child_key_.objkey := objkey_;   
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;
   
   IF old_rec_.removed_quantity < removed_quantity_ THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVQTY: Please create another part requirement for the additional quantity of removed parts.');
   END IF;
   IF removed_quantity_ IS NULL OR removed_quantity_ < 1 THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVRMVDQTY: Removed quantity should be greater than 0.');
   END IF;
   
   new_rec_.removal_serial_no := removal_serial_no_;
   new_rec_.removed_quantity := removed_quantity_;
   new_rec_.removal_reason_code := removal_reason_code_;
   new_rec_.removal_part_no_id := removal_part_no_id_;
   new_rec_.removal_batch_no := removal_batch_no_;
   new_rec_.removal_edit_reason := removal_edit_reason_;
   new_rec_.config_slot_position_id := config_slot_pos_id_;
   IF removal_edit_reason_ IS NOT NULL THEN
      new_rec_.signed_flag := TRUE;
   END IF;
   
   config_slot_pos_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(config_slot_pos_id_);
   assy_config_slot_pos_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(old_rec_.assembly_config_slot_position_id);

   assy_pos_ := Derive_Assy_Pos(config_slot_pos_code_,assy_config_slot_pos_code_);

   new_rec_.config_slot_position_code := config_slot_pos_code_;
   new_rec_.assy_pos :=  assy_pos_;
   
   IF old_rec_.signed_flag = TRUE AND removal_edit_reason_ IS NULL THEN
      new_rec_.removed_date   := Time_Util_API.Get_Sysdate_In_Utc;
   END IF;
     
  
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Edit_Removed_Part___;

@IgnoreUnitTest NoOutParams
PROCEDURE Edit_Installed_Part___ (
   objkey_                IN VARCHAR2,
   installed_part_no_id_  IN VARCHAR2,
   installed_serial_no_   IN VARCHAR2,
   installed_quantity_    IN VARCHAR2,
   installed_batch_no_    IN VARCHAR2,
   installed_edit_reason_ IN VARCHAR2,
   config_slot_pos_id_    IN VARCHAR2)
IS
   old_rec_                   Installed_Part_Line_Virtual_Rec;
   new_rec_                   Installed_Part_Line_Virtual_Rec;
   child_key_                 Installed_Part_Line_Virtual_Key;
   config_slot_pos_code_      VARCHAR2(50);
   assy_config_slot_pos_code_ VARCHAR2(50);
   assy_pos_                  VARCHAR2(50);
BEGIN
	child_key_.objkey := objkey_;   
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;
   
   IF old_rec_.installed_quantity < installed_quantity_ THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVQTY: Please create another part requirement for the additional quantity of installed parts.');
   END IF;
   IF installed_quantity_ < 1 OR installed_quantity_ IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVINSTQTY: Installed quantity should be greater than 0.');
   END IF;
   
   new_rec_.installed_serial_no := installed_serial_no_;
   new_rec_.installed_quantity := installed_quantity_;
   new_rec_.installed_part_no_id := installed_part_no_id_;
   new_rec_.installed_batch_no    := installed_batch_no_;
   new_rec_.installed_edit_reason := installed_edit_reason_;
   new_rec_.config_slot_position_id := config_slot_pos_id_;
   IF installed_edit_reason_ IS NOT NULL THEN
      new_rec_.signed_flag := TRUE;
   END IF;
   
   config_slot_pos_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(config_slot_pos_id_);
   assy_config_slot_pos_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(old_rec_.assembly_config_slot_position_id);

   assy_pos_ := Derive_Assy_Pos(config_slot_pos_code_,assy_config_slot_pos_code_);

   new_rec_.config_slot_position_code := config_slot_pos_code_;
   new_rec_.assy_pos :=  assy_pos_;
   
   IF old_rec_.signed_flag = TRUE AND installed_edit_reason_ IS NULL THEN
      new_rec_.installed_date   := Time_Util_API.Get_Sysdate_In_Utc;
   END IF;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Edit_Installed_Part___;

FUNCTION Get_Serial_No___ (
   part_no_   IN VARCHAR2,
   serial_no_ IN VARCHAR2,
   task_seq_  IN NUMBER) RETURN Objid_Arr
IS
   collection_    Objid_Arr := Objid_Arr();
   contract_      VARCHAR2(10);
   
   CURSOR get_part_serial_catalogs(part_no_ VARCHAR2, contract_ VARCHAR2) IS
      SELECT psc.objid
      FROM part_serial_catalog psc
      INNER JOIN inventory_part_in_stock ips
      ON psc.part_no = ips.part_no
      AND psc.serial_no = ips.serial_no
      WHERE psc.part_no = part_no_
      AND psc.operational_condition = 'Operational'
      AND ips.contract = contract_
      AND (psc.objstate <> 'Issued' OR psc.serial_no = serial_no_);
BEGIN
   contract_ := Work_Task_API.Get_Site(task_seq_);
   
   OPEN  get_part_serial_catalogs(part_no_, contract_);
   FETCH get_part_serial_catalogs BULK COLLECT INTO collection_;
   CLOSE get_part_serial_catalogs;
   RETURN collection_;
END Get_Serial_No___;


FUNCTION Get_Batch_No___ (
   part_no_  IN VARCHAR2,
   task_seq_ IN NUMBER) RETURN Objid_Arr
IS
   collection_    Objid_Arr := Objid_Arr();
   contract_      VARCHAR2(10);
   
   CURSOR get_lot_batch_master(part_no_ VARCHAR2, contract_ VARCHAR2) IS
      SELECT DISTINCT lbm.objid
      FROM lot_batch_master lbm
      INNER JOIN inventory_part_in_stock ips
      ON lbm.part_no = ips.part_no
      AND lbm.lot_batch_no = ips.lot_batch_no
      WHERE lbm.part_no = part_no_
      AND ips.contract = contract_
      AND ips.availability_control_id = 'RFI'; 
BEGIN
   contract_ := Work_Task_API.Get_Site(task_seq_);
   
   OPEN get_lot_batch_master(part_no_, contract_);
   FETCH get_lot_batch_master BULK COLLECT INTO collection_;
   CLOSE get_lot_batch_master;
   RETURN collection_;
END Get_Batch_No___;

FUNCTION Get_Tool_Part_For_Assigned_Resource___ (
   resource_seq_ IN NUMBER,
   site_         IN VARCHAR2) RETURN Tool_Part_Structure_Rec
IS
      
   rec_              Tool_Part_Structure_Rec;
   checked_out_date_ DATE;
BEGIN
	rec_.tool_part_id          := Resource_API.Get_Resource_Id(Resource_Parent_API.Get_Parent_Seq(resource_seq_));
   rec_.tool_part_description := Resource_API.Get_Description(Resource_Parent_API.Get_Parent_Seq(resource_seq_));
   rec_.site                  := site_;
   
   RETURN rec_;
END Get_Tool_Part_For_Assigned_Resource___;


PROCEDURE Record_Tool_Demand___ (
   objkey_ IN VARCHAR2,
   actual_start_date_ IN DATE,
   actual_end_date_ IN DATE,
   actual_hours_ IN VARCHAR2,
   tool_part_id_  IN VARCHAR2,
   tool_part_description_ IN VARCHAR2,
   resource_seq_ NUMBER,
   serial_no_ VARCHAR2,
   resource_parent_id_ IN VARCHAR2,
   resource_group_seq_ IN NUMBER,
   reason_to_edit_ IN VARCHAR2)
IS
   old_rec_                Tool_Resource_Demand_Virtual_Rec;
   new_rec_                Tool_Resource_Demand_Virtual_Rec;   
   child_key_              Tool_Resource_Demand_Virtual_Key;
   schedule_date_interval_ Av_Exe_Task_API.Task_Schedule_Time_Interval_Rec;
   record_work_rec_        Record_Work_Virtual_Rec;
   record_work_key_        Record_Work_Virtual_Key;
   checked_out_status_     VARCHAR2(100);
   
   CURSOR get_resource_check_out_status IS
      SELECT check_out_status
      FROM resource_tool_equip_tab
      WHERE resource_seq = resource_seq_;
BEGIN
   child_key_.objkey := objkey_;
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;
   
   record_work_key_.Objkey := new_rec_.parent_objkey;
   record_work_rec_ := Get_Record___(record_work_key_);
   
   OPEN get_resource_check_out_status;
   FETCH get_resource_check_out_status INTO checked_out_status_;
   CLOSE get_resource_check_out_status;
   
   IF checked_out_status_ != 'CHECKED_OUT' AND record_work_rec_.is_edit_task_card_access = FALSE THEN
      Error_SYS.Record_General(lu_name_, 'RESNOTCHECKEDOUT: Assigned tool is not checked out.');
   END IF;
   
   new_rec_.checked_out_date := actual_start_date_;
   new_rec_.actual_end_date  := actual_end_date_;
   new_rec_.actual_hours     := actual_hours_;
   
   IF old_rec_.signed_flag = TRUE AND reason_to_edit_ IS NULL THEN 
      new_rec_.resource_parent_id := resource_parent_id_;
      new_rec_.tool_group := resource_parent_id_;
      new_rec_.resource_group_seq := resource_group_seq_;
   END IF;
   
   IF old_rec_.tool_part_id IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.tool_part_id := tool_part_id_;
   END IF;
   IF old_rec_.tool_part_description IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.tool_part_description := tool_part_description_;
   END IF;
   IF old_rec_.resource_seq IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.resource_seq := resource_seq_;
   END IF;
   IF old_rec_.serial_no IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.serial_no := serial_no_;
   END IF;
   schedule_date_interval_ := Av_Exe_Task_API.Get_Task_Schedule_Interval(old_rec_.task_seq);
   IF old_rec_.allocated_start_date IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.allocated_start_date := schedule_date_interval_.schedule_start;
   END IF;
   IF old_rec_.allocated_finish_date IS NULL OR reason_to_edit_ IS NOT NULL OR old_rec_.signed_flag = TRUE THEN
      new_rec_.allocated_finish_date := schedule_date_interval_.schedule_end;
   END IF;
    
   IF old_rec_.signed_flag = FALSE THEN 
      new_rec_.signed_user   := Fnd_Session_API.Get_Fnd_User();
      new_rec_.signed_flag   := TRUE;
      new_rec_.is_edit_tool  := FALSE;
   ELSE 
      new_rec_.is_edit_tool := TRUE;
   END IF;
   
   IF reason_to_edit_ IS NOT NULL THEN
      new_rec_.reason_to_edit := reason_to_edit_;
      new_rec_.signed_flag    := TRUE;
      new_rec_.signed_user    := old_rec_.signed_user;
      new_rec_.is_edit_tool   := FALSE;
   END IF;
   
   IF (old_rec_.signed_flag = TRUE OR old_rec_.signed_flag = FALSE) AND reason_to_edit_ IS NULL THEN
      new_rec_.signed_date   := Time_Util_API.Get_Sysdate_In_Utc;
   END IF;
     
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Record_Tool_Demand___;


