@IgnoreUnitTest TrivialFunction
FUNCTION Can_Maintenance_Task_Start___ (
   selection_ IN VARCHAR2 ) RETURN VARCHAR2
IS
   task_seq_          NUMBER;
   tokenized_tab_     Utility_SYS.STRING_TABLE;
   dummy_number_      NUMBER;
   panel_status_      VARCHAR2(10);

   CURSOR get_open_task_panels (task_seq_ IN NUMBER) IS
      SELECT tp.open_task_seq, tp.open_task_step_seq
        FROM av_exe_task_panel_tab tp
        WHERE tp.task_seq = task_seq_
         AND tp.open_task_seq IS NOT NULL
         AND tp.open_task_step_seq IS NOT NULL;

BEGIN
   Utility_SYS.Tokenize(selection_, ';', tokenized_tab_, dummy_number_);

   IF (tokenized_tab_.COUNT > 0) THEN
      FOR count_ IN tokenized_tab_.FIRST .. tokenized_tab_.LAST LOOP
         task_seq_ := TO_NUMBER(Client_SYS.Get_Key_Reference_Value(tokenized_tab_(count_), 'TASK_SEQ'));

         FOR rec_ IN get_open_task_panels(task_seq_) LOOP
            IF Av_Exe_Task_Panel_Req_Util_API.Is_Panel_Opened(rec_.open_task_seq, rec_.open_task_step_seq) != 'TRUE' THEN
               RETURN 'FALSE';
            END IF;
         END LOOP;

      END LOOP;
   END IF;

   RETURN 'TRUE';
END Can_Maintenance_Task_Start___;

@IgnoreUnitTest TrivialFunction
FUNCTION Can_Mpc_Close_Task_Start___ (
   selection_ IN VARCHAR2 ) RETURN VARCHAR2
IS
   task_seq_                 NUMBER;
   tokenized_tab_            Utility_SYS.STRING_TABLE;
   dummy_number_             NUMBER;
   check_mpc_open_           BOOLEAN;
   check_maintenance_tasks_  BOOLEAN;
BEGIN
   Utility_SYS.Tokenize(selection_, ';', tokenized_tab_, dummy_number_);

   IF (tokenized_tab_.COUNT > 0) THEN
      FOR count_ IN tokenized_tab_.FIRST .. tokenized_tab_.LAST LOOP
         task_seq_ := TO_NUMBER(Client_SYS.Get_Key_Reference_Value(tokenized_tab_(count_), 'TASK_SEQ'));

         check_mpc_open_          := Av_Exe_Task_Panel_API.Is_All_Mpc_Open_Completed(task_seq_);
         check_maintenance_tasks_ := Av_Exe_Task_Panel_API.Is_All_Mt_Completed(task_seq_);

         IF (check_mpc_open_ = FALSE OR check_maintenance_tasks_ = FALSE) THEN
            RETURN 'FALSE';
         END IF;
      END LOOP;
   END IF;

   RETURN 'TRUE';
END Can_Mpc_Close_Task_Start___;

PROCEDURE Create_Inst_Line_Task_Card___ (
   objkey_                 IN VARCHAR2,
   installed_serial_no_    IN VARCHAR2,
   installed_batch_no_     IN VARCHAR2,
   task_part_id_           IN NUMBER)
IS
   installed_part_rec_         Installed_Part_Line_Virtual_Rec;
   child_key_                  Removed_Part_Line_Virtual_Key;
   old_rec_                    Removed_Part_Line_Virtual_Rec;
   parent_key_                 Record_Work_Virtual_Key;
   parent_rec_                 Record_Work_Virtual_Rec;
   parent_new_rec_             Record_Work_Virtual_Rec; 
   task_seq_                   NUMBER;
   part_group_id_              NUMBER;
   removed_part_no_id_         NUMBER; 
   removed_quantity_           NUMBER;
   config_slot_position_id_    NUMBER;
   assmbly_config_slot_pos_id_ NUMBER;
   is_exist_installation_      BOOLEAN;
   
   CURSOR get_rmvd_task_part_info_ IS
      SELECT task_seq, part_group_id, removed_part_no_id, removed_quantity, config_slot_position_id, assmbly_config_slot_pos_id
      FROM   av_exe_task_part
      WHERE  task_part_id = task_part_id_;
      
BEGIN
   child_key_.objkey    := objkey_;   
   old_rec_             := Get_Record___(child_key_);
   
   OPEN  get_rmvd_task_part_info_;
   FETCH get_rmvd_task_part_info_ INTO task_seq_, part_group_id_, removed_part_no_id_, removed_quantity_, config_slot_position_id_, assmbly_config_slot_pos_id_;
   CLOSE get_rmvd_task_part_info_;
            
   is_exist_installation_:=Av_Exe_Task_Part_API.Is_Exist_Inst_Part_for_Rmvd(task_part_id_);
   IF NOT is_exist_installation_ THEN              
      installed_part_rec_.parent_objkey                        := old_rec_.parent_objkey;   
      installed_part_rec_.inst_vrt_parent_objkey               := old_rec_.parent_objkey;
      installed_part_rec_.objkey                               := sys_guid();  
      installed_part_rec_.task_seq                             := task_seq_;
      installed_part_rec_.part_group_id                        := part_group_id_;
      installed_part_rec_.installed_part_no_id                 := removed_part_no_id_;
      installed_part_rec_.installed_quantity                   := removed_quantity_;
      installed_part_rec_.installed_serial_no                  := installed_serial_no_;
      installed_part_rec_.installed_batch_no                   := installed_batch_no_;
      installed_part_rec_.original_installed_batch_no          := installed_batch_no_;
      installed_part_rec_.part_type                            := av_part_number_API.Get_Inventory_Class_Code (removed_part_no_id_);
      installed_part_rec_.config_slot_position_id              := config_slot_position_id_;
      installed_part_rec_.config_slot_position_code            := av_config_slot_position_API.Get_Config_Slot_Position_Code(config_slot_position_id_);
      installed_part_rec_.config_slot_code                     := av_config_slot_position_API.Get_Config_Slot_Code(config_slot_position_id_);
      installed_part_rec_.assembly_config_slot_position_id     := assmbly_config_slot_pos_id_;
      installed_part_rec_.assmbl_conf_slot_pos_code            := av_config_slot_position_API.Get_Config_Slot_Position_Code(assmbly_config_slot_pos_id_);
      installed_part_rec_.signed_flag                          := false;
      installed_part_rec_.removal_reason_code                  := 'ACCESS';
      installed_part_rec_.rmvd_task_part_id                    := task_part_id_;
      IF (installed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND installed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.assmbl_conf_slot_pos_code || ' - ' || installed_part_rec_.config_slot_position_code;
      ELSIF (installed_part_rec_.assmbl_conf_slot_pos_code IS NULL AND installed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.config_slot_position_code;
      ELSIF (installed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND installed_part_rec_.config_slot_position_code IS NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.assmbl_conf_slot_pos_code;
      ELSE
         installed_part_rec_.assy_pos := NULL;
      END IF;  
      installed_part_rec_.part_group := av_part_group_API.Get_Part_Group_Code(part_group_id_) || ' (' || av_part_group_API.Get_Part_Group_Name(part_group_id_) || ' )';
      installed_part_rec_.aircraft_id := Av_Exe_Task_API.Get_Aircraft_Id(task_seq_);
      CRUD_Create___(installed_part_rec_);
      
      parent_key_.Objkey   := old_rec_.parent_objkey;
      parent_rec_          := Get_Record___(parent_key_);
      parent_new_rec_      := parent_rec_;
   
      IF(parent_rec_.installeded_part_enable = FALSE) THEN
         parent_new_rec_.installeded_part_enable := TRUE;  
         CRUD_Update___(parent_rec_, parent_new_rec_);
      END IF; 
   END IF;
END Create_Inst_Line_Task_Card___;

@IgnoreUnitTest TrivialFunction
FUNCTION Derive_Assy_Pos (
    config_slot_pos_code_      IN VARCHAR2,
    assy_config_slot_pos_code_ IN VARCHAR2) RETURN VARCHAR2 
IS
BEGIN
   -- If both values exist, concatenate with ' - ', otherwise pick the non-null one
   IF config_slot_pos_code_ IS NOT NULL AND assy_config_slot_pos_code_ IS NOT NULL THEN
       RETURN assy_config_slot_pos_code_ || ' - ' || config_slot_pos_code_;
   ELSE
       RETURN NVL(assy_config_slot_pos_code_, config_slot_pos_code_);
   END IF;

END Derive_Assy_Pos;

FUNCTION Validate_Tool_Start_End_Date___ (
   task_seq_               IN NUMBER,
   assigned_resource_seq_  IN NUMBER,
   actual_start_           IN DATE,
   actual_end_             IN DATE) RETURN VARCHAR2
IS
   actual_hours_        VARCHAR2(10);
BEGIN
   Av_Exe_Task_Tool_Util_API.Validate_Tool_Actual_Date_Time(task_seq_, assigned_resource_seq_, actual_start_, actual_end_);
   
   actual_hours_  := Get_Time_Duration___(actual_start_, actual_end_);
   
   RETURN actual_hours_;
END Validate_Tool_Start_End_Date___;

PROCEDURE Verify_Actual_Hours___ (
   actual_hours_ IN VARCHAR2)
IS
   duration_            NUMBER;
BEGIN
	duration_      := Adcom_Util_API.Validate_Format_Hours(actual_hours_);
   
   IF duration_ IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDFORMAT: Enter Allocated Hours in the HH:MM format.');
   ELSIF duration_ = 0 THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDALLOCATEDHOURS: Actual Hours cannot be 0.');
   END IF;
END Verify_Actual_Hours___;

@IgnoreUnitTest TrivialFunction
FUNCTION Is_Tool_Checked_Out___ (
   resource_seq_ NUMBER ) RETURN BOOLEAN
IS 
   is_tool_checked_out_    BOOLEAN := FALSE;
   checked_out_status_     VARCHAR2(100);
   CURSOR get_resource_check_out_status IS
      SELECT check_out_status
      FROM resource_tool_equip_tab
      WHERE resource_seq = resource_seq_;
BEGIN   
   OPEN get_resource_check_out_status;
   FETCH get_resource_check_out_status INTO checked_out_status_;
   CLOSE get_resource_check_out_status;
   
   IF checked_out_status_ = 'CHECKED_OUT' THEN
      is_tool_checked_out_ := TRUE; 
   ELSE
      is_tool_checked_out_ := FALSE;
   END IF;
   
   RETURN is_tool_checked_out_;
END Is_Tool_Checked_Out___;

@IgnoreUnitTest PipelinedFunction
FUNCTION Get_Removal_Cms_Request_Data___ (
   objkey_             IN VARCHAR2,
   config_slot_pos_id_ IN NUMBER) RETURN Cms_Data_Structure_Rec
IS
   cms_data_structure_rec_             Cms_Data_Structure_Rec;
   task_part_id_                       NUMBER;
   assembly_config_slot_position_id_   NUMBER;
   assembly_config_slot_code_          VARCHAR2(100);
   removal_part_group_id_              NUMBER;
   removal_part_group_alt_id_          VARCHAR2(100);
   part_type_                          VARCHAR2(100);
   
   CURSOR get_removal_part_virtual(objkey_ VARCHAR2) IS
     SELECT task_part_id, assembly_config_slot_position_id, removal_part_group_id, part_type
     FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT  
     WHERE objkey = objkey_;
      
BEGIN
   OPEN  get_removal_part_virtual(objkey_);
   FETCH get_removal_part_virtual INTO task_part_id_, assembly_config_slot_position_id_, removal_part_group_id_, part_type_;
   CLOSE get_removal_part_virtual;

   cms_data_structure_rec_.config_slot_position := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(config_slot_pos_id_);
  
   IF part_type_ IN ('SER', 'BATCH') THEN
      removal_part_group_alt_id_ := Av_Part_Group_API.Get_Alt_Id(removal_part_group_id_);
      IF removal_part_group_alt_id_ IS NOT NULL THEN  
         cms_data_structure_rec_.config_slot_code := Av_Part_Group_API.Get_Part_Group_Code(removal_part_group_id_);
      END IF; 
   ELSE 
      cms_data_structure_rec_.config_slot_code := Av_Config_Slot_Position_API.Get_Config_Slot_Code(config_slot_pos_id_);
   END IF;  
   
   cms_data_structure_rec_.assembly_config_slot_position := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(assembly_config_slot_position_id_);
   assembly_config_slot_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Code(assembly_config_slot_position_id_);
   
   cms_data_structure_rec_.aircraft_alt_id := Aircraft_API.Get_Alt_Id(Av_Exe_Task_API.Get_Aircraft_Id(Av_Exe_Task_Part_API.Get_Task_Seq(task_part_id_)));
   
   IF assembly_config_slot_code_ IS NOT NULL THEN
      cms_data_structure_rec_.is_sub_assy := 'true';
      cms_data_structure_rec_.assembly_config_slot_code := assembly_config_slot_code_;
   ELSE 
      cms_data_structure_rec_.is_sub_assy := 'false';
   END IF;
   RETURN cms_data_structure_rec_;
END Get_Removal_Cms_Request_Data___;
