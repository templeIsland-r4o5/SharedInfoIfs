   RETURN current_user_desc_;
END Get_Current_User_Desc___;

@IgnoreUnitTest DMLOperation
PROCEDURE Add_Action___ (
   parent_objkey_ IN VARCHAR2,
   action_desc_   IN VARCHAR2,
   task_seq_      IN NUMBER,
   certify_work_performed_ IN BOOLEAN)
IS
   task_action_rec_    Task_Action_Line_Virtual_Rec;
   act_ord_ NUMBER;
   sign_by_ VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
   
   parent_key_          Record_Work_Virtual_Key;
   parent_rec_          Record_Work_Virtual_Rec;
   parent_new_rec_      Record_Work_Virtual_Rec; 
   sign_off_key_        Task_Step_Sign_Off_Virtual_Key;
   sign_off_new_rec_    Task_Step_Sign_Off_Virtual_Rec;
   sign_off_old_rec_    Task_Step_Sign_Off_Virtual_Rec;
        
   CURSOR Get_Max_Action_Ord___ (act_parent_objkey_ IN VARCHAR2) IS
      SELECT MAX(action_ord) FROM ${PROJECTION}_TASK_ACTION_LINE_VIRTUAL_VRT 
      WHERE parent_objkey = act_parent_objkey_;
       
    CURSOR get_step_sign_offs IS
      SELECT sign_off.grouping_no, sign_off.task_seq, sign_off.task_step_seq, task_step.objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off, ${PROJECTION}_STEP_VIRTUAL_VRT task_step 
      WHERE sign_off.parent_objkey = task_step.objkey
      AND task_step.parent_objkey = parent_objkey_
      AND role = 'Executor' 
      AND sign_off_status = 'Signed'
      AND signed_flag = 1; 

   CURSOR get_certifier_sign_offs(grouping_no_ VARCHAR2, task_seq_ NUMBER, task_step_seq_ NUMBER) IS
      SELECT  objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE grouping_no = grouping_no_
      AND role = 'Inspector'
      AND task_seq = task_seq_
      AND task_step_seq = task_step_seq_
      AND sign_off_status != 'Signed';
       
   CURSOR get_panel_sign_offs IS
      SELECT sign_off.grouping_no, sign_off.task_seq, sign_off.task_step_seq, panel.objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off, ${PROJECTION}_PANEL_VIRTUAL_VRT panel
      WHERE sign_off.parent_objkey = panel.objkey
      AND panel.parent_objkey = parent_objkey_
      AND role = 'Executor' 
      AND sign_off_status = 'Signed'
      AND signed_flag = 1;
     
BEGIN   
   OPEN Get_Max_Action_Ord___(parent_objkey_);
   FETCH Get_Max_Action_Ord___ INTO act_ord_;
   IF act_ord_  IS NOT NULL THEN
      act_ord_ := (act_ord_ + 1 );
   ELSE
      act_ord_ := 1;
   END IF;
   CLOSE Get_Max_Action_Ord___;
	task_action_rec_.objkey          := sys_guid();
   task_action_rec_.parent_objkey   := parent_objkey_;
   task_action_rec_.task_seq        := task_seq_;
   task_action_rec_.action_user     := sign_by_;
   task_action_rec_.action_date     := Time_Util_API.Get_Sysdate_In_Utc;
   task_action_rec_.action_desc     := action_desc_;
   task_action_rec_.signed_flag     := TRUE;
   task_action_rec_.action_type    := 'Corrective';
   task_action_rec_.action_ord     := act_ord_;   
   CRUD_Create___(task_action_rec_);
   
   parent_key_.Objkey   := task_action_rec_.parent_objkey;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
      IF(parent_rec_.is_action_recorded = FALSE) THEN
         parent_new_rec_.is_action_recorded := TRUE;  
      CRUD_Update___(parent_rec_, parent_new_rec_);
      END IF; 
   
   IF certify_work_performed_ = TRUE THEN
      FOR sign_off_rec_ IN get_step_sign_offs loop
         FOR certifier_rec_ IN get_certifier_sign_offs(sign_off_rec_.grouping_no, sign_off_rec_.task_seq, sign_off_rec_.task_step_seq) LOOP
            sign_off_key_.Objkey                             := certifier_rec_.objkey;
            sign_off_old_rec_                                := Get_Record___(sign_off_key_);
            sign_off_new_rec_                                := sign_off_old_rec_;
            sign_off_new_rec_.identity                       := Person_Info_API.Get_Id_For_User(Fnd_Session_API.Get_Fnd_User);
            sign_off_new_rec_.sign_off_date                  := Time_Util_API.Get_Sysdate_In_Utc;
            sign_off_new_rec_.sign_off_status                := 'Signed';
            sign_off_new_rec_.signed_flag                    := TRUE;
            sign_off_new_rec_.is_revoke_sign_off_capable     := TRUE;
            CRUD_Update___(sign_off_old_rec_, sign_off_new_rec_);
            Update_Revoke_Step_Sign_Off_Capability___(certifier_rec_.objkey, 'sign');
            Update_Task_Step(sign_off_rec_.objkey, sign_off_new_rec_.step_obj_conn_lu_name_db);
         END LOOP;
      END LOOP;
      
      FOR sign_off_rec_ IN get_panel_sign_offs LOOP
         FOR certifier_rec_ IN get_certifier_sign_offs(sign_off_rec_.grouping_no, sign_off_rec_.task_seq, sign_off_rec_.task_step_seq) LOOP
            sign_off_key_.Objkey                             := certifier_rec_.objkey;
            sign_off_old_rec_                                := Get_Record___(sign_off_key_);
            sign_off_new_rec_                                := sign_off_old_rec_;
            sign_off_new_rec_.identity                       := Person_Info_API.Get_Id_For_User(Fnd_Session_API.Get_Fnd_User);
            sign_off_new_rec_.sign_off_date                  := Time_Util_API.Get_Sysdate_In_Utc;
            sign_off_new_rec_.sign_off_status                := 'Signed';
            sign_off_new_rec_.signed_flag                    := TRUE;
            sign_off_new_rec_.is_revoke_sign_off_capable     := TRUE;
            CRUD_Update___(sign_off_old_rec_, sign_off_new_rec_);
            Update_Revoke_Step_Sign_Off_Capability___(certifier_rec_.objkey, 'sign');
            Update_Task_Step(sign_off_rec_.objkey, sign_off_new_rec_.step_obj_conn_lu_name_db);
         END LOOP;
      END LOOP;
   END IF;
   
   CheckAndSetParentButtons___(task_action_rec_.parent_objkey, FALSE);  
END Add_Action___;

--The function is used to determine if Complete Button should be enabled or not
FUNCTION Check_Complete_Task_Enable___ (
   objkey_ IN VARCHAR2) RETURN BOOLEAN
IS
   key_        Record_Work_Virtual_Key;
   parent_rec_ Record_Work_Virtual_Rec;
BEGIN
   key_.Objkey := objkey_;
   parent_rec_ := Get_Record___(key_);
   
   -- Checking for tools that are not signed
   IF parent_rec_.resource_tool_enable THEN
      FOR child_tool_rec IN Get_Resource_Tools_Array___(key_) LOOP
         IF (child_tool_rec.assigned_user IS NULL) THEN
            RETURN FALSE;
         END IF;
      END LOOP;
   ELSE
      FOR child_tool_rec IN Get_Tools_Array___(key_) LOOP       
         IF (child_tool_rec.assigned_user IS NULL) THEN
            RETURN FALSE;
         END IF;
      END LOOP;
   END IF;
   
   FOR child_inst_part_rec IN Get_Installed_Parts_Array___(key_) LOOP
      IF (child_inst_part_rec.installed_user IS NULL AND child_inst_part_rec.cancelled_by IS NULL) THEN
         RETURN FALSE;
      END IF;
   END LOOP;
   FOR child_rmv_part_rec IN Get_Removed_Parts_Array___(key_) LOOP
      IF (child_rmv_part_rec.removed_user IS NULL AND child_rmv_part_rec.cancelled_by IS NULL) THEN
         RETURN FALSE;
      END IF;
   END LOOP;
   
   FOR child_measurement_rec IN Get_Measurements_Array___(key_) LOOP
      IF (child_measurement_rec.measured_user IS NULL) THEN
         RETURN FALSE;
      END IF;
   END LOOP;
   
   -- Checking for task actions that are not signed  
   IF (Get_Task_Action_Count___(key_) = 0) THEN
      RETURN FALSE;
   END IF;   
   IF (Get_Last_Task_Action_Type___(key_) != 'Corrective') THEN
      RETURN FALSE;
   END IF; 
   
   FOR child_step_rec IN Get_Steps___(key_) LOOP   
      IF (child_step_rec.step_status != 'DONE') THEN
         RETURN FALSE;
      END IF;
   END LOOP;
   
   FOR child_panel_rec IN Get_Panels___(key_) LOOP
      IF (child_panel_rec.step_status != 'DONE') THEN
         RETURN FALSE;
      END IF;
   END LOOP;
   
   RETURN TRUE;
END Check_Complete_Task_Enable___;

PROCEDURE Record_Tool___ (
   objkey_          IN VARCHAR2,
   serial_no_       IN VARCHAR2,
   actual_duration_ IN VARCHAR2)
IS
   old_rec_          Tool_Line_Virtual_Rec;
   new_rec_          Tool_Line_Virtual_Rec;   
   child_key_        Tool_Line_Virtual_Key;  
   dummy_text_       VARCHAR2(10);
   assigned_user_    VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
     
BEGIN
   child_key_.objkey := objkey_;
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_; 
     
   --Validate the time format entered by the user
   dummy_text_                  := Format_Hours___(actual_duration_, 'Actual Duration');   
   new_rec_.actual_duration     := actual_duration_;
   new_rec_.serial_no           := serial_no_;
   new_rec_.assigned_user       := assigned_user_;
   new_rec_.assigned_date_tiime := Time_Util_API.Get_Sysdate_In_Utc;
   new_rec_.is_signed           := TRUE;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Record_Tool___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Tool_Demand___ (
   objkey_ IN VARCHAR2)
IS
   old_rec_          Tool_Resource_Demand_Virtual_Rec;
   new_rec_          Tool_Resource_Demand_Virtual_Rec;   
   child_key_        Tool_Resource_Demand_Virtual_Key;
BEGIN
   child_key_.objkey := objkey_;
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_; 
   
   IF Jt_Execution_Instance_API.Exists(new_rec_.task_seq, new_rec_.execution_instance_seq) THEN
      new_rec_.allocated_start_date := Jt_Execution_Instance_API.Get_Allocated_Start(new_rec_.task_seq, new_rec_.execution_instance_seq);
      new_rec_.allocated_finish_date := Jt_Execution_Instance_API.Get_Allocated_Finish(new_rec_.task_seq, new_rec_.execution_instance_seq);
      new_rec_.serial_no := Resource_Tool_Equip_API.Get_Serial_No(new_rec_.resource_seq);
   ELSE
      new_rec_.allocated_start_date := NULL;
      new_rec_.allocated_finish_date := NULL;
      new_rec_.serial_no := NULL;
   END IF;

   new_rec_.checked_out_date := NULL;
   new_rec_.actual_end_date  := NULL;
   new_rec_.actual_hours     := NULL;
   new_rec_.signed_user      := NULL;
   new_rec_.signed_date      := NULL;
   new_rec_.signed_flag      := FALSE;
  
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Revoke_Tool_Demand___;

@IgnoreUnitTest NoOutParams
PROCEDURE Record_Resource_Tool___ (
   key_             IN Resource_Tool_Line_Virtual_Key,
   resource_id_     IN VARCHAR2,
   resource_seq_    IN NUMBER,
   part_no_         IN VARCHAR2,
   serial_no_       IN VARCHAR2,
   actual_duration_ IN VARCHAR2)
IS
   old_rec_          Resource_Tool_Line_Virtual_Rec;
   new_rec_          Resource_Tool_Line_Virtual_Rec;
   dummy_text_       VARCHAR2(10);
   assigned_user_    VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
   
BEGIN
   IF resource_seq_ IS NULL AND (part_no_ IS NULL OR serial_no_ IS NULL) THEN
      Error_SYS.Record_General(lu_name_, 'REQUIREDVALUES: Tool/Equipment or part no with serial no are required to record tool.');
   END IF;
   
   old_rec_          := Get_Record___(key_);
   new_rec_          := old_rec_;
   
   dummy_text_                      := Format_Hours___(actual_duration_, 'Actual Duration');
   new_rec_.resource_id             := resource_id_;
   new_rec_.resource_seq            := resource_seq_;
   new_rec_.part_no                 := part_no_;
   new_rec_.serial_no               := serial_no_;
   new_rec_.assigned_user           := assigned_user_;
   new_rec_.assigned_date_time      := Time_Util_API.Get_Sysdate_In_Utc;
   new_rec_.is_signed               := TRUE;
   new_rec_.actual_duration         := actual_duration_;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Record_Resource_Tool___;

PROCEDURE Record_Measurement___ (
   objkey_                IN VARCHAR2,
   measurement_type_code_ IN VARCHAR2,
   meas_type_value_code_  IN VARCHAR2,
   measurement_qty_       IN NUMBER,
   measurement_date_time_ IN DATE,
   measurement_text_      IN VARCHAR2,
   measurement_boolean_   IN BOOLEAN,
   measurement_type_      IN VARCHAR2,
   reason_to_edit_        IN VARCHAR2)
IS
   old_rec_               Measurement_Line_Virtual_Rec;
   new_rec_               Measurement_Line_Virtual_Rec;   
   child_key_             Measurement_Line_Virtual_Key;
   measurement_eu_code_      VARCHAR2(8);
   measured_user_            VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
BEGIN
	child_key_.objkey := objkey_;
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;   
   
   new_rec_.meas_type_value_code      := meas_type_value_code_;
   new_rec_.measurement_qty           := measurement_qty_;
   new_rec_.measurement_date_time     := measurement_date_time_;
   new_rec_.measurement_text          := measurement_text_;
   new_rec_.measurement_boolean       := measurement_boolean_;
   IF old_rec_.signed_flag = FALSE THEN 
      new_rec_.measured_user             := measured_user_;
      new_rec_.measured_date             := Time_Util_API.Get_Sysdate_In_Utc;
      new_rec_.signed_flag               := TRUE;
   END IF;
   IF reason_to_edit_ IS NOT NULL THEN 
      new_rec_.reason_to_edit := reason_to_edit_;
      new_rec_.signed_flag    := TRUE;
   END IF;
   IF old_rec_.signed_flag = TRUE AND reason_to_edit_ IS NULL THEN
      new_rec_.measured_date   := Time_Util_API.Get_Sysdate_In_Utc;
   END IF;
     
   measurement_eu_code_   := Av_Measurement_Type_API.Get_Engineering_Unit_Code(measurement_type_code_);
   
   IF measurement_type_ = 'ME' THEN
      new_rec_.measurement_value := CONCAT(CONCAT(measurement_qty_, ' '), measurement_eu_code_);
   ELSIF measurement_type_ = 'CHK' THEN
      IF(measurement_boolean_) THEN
         new_rec_.measurement_value := 'YES';
      ELSE
         new_rec_.measurement_value := 'NO'; 
      END IF;
   ELSIF measurement_type_ = 'CME' THEN
      new_rec_.measurement_value :=  TO_CHAR( measurement_date_time_, 'DD-MON-YY HH24:MM' );
   ELSIF measurement_type_ = 'TEXT' THEN
      new_rec_.measurement_value := measurement_text_;
   ELSIF measurement_type_ = 'CH' THEN
      new_rec_.measurement_value := CONCAT(CONCAT(meas_type_value_code_, ' '), measurement_eu_code_);
   ELSE
      new_rec_.measurement_value := NULL;
   END IF;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Record_Measurement___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Measurement___ (
   objkey_ IN VARCHAR2,
   revoke_sign_off_reason_ IN VARCHAR2)
IS
   old_rec_               Measurement_Line_Virtual_Rec;
   new_rec_               Measurement_Line_Virtual_Rec;   
   child_key_             Measurement_Line_Virtual_Key;
   measurement_quantity_  av_exe_task_measurement_tab.measurement_qty%TYPE;
   measurement_type_      VARCHAR2(80);
   measurement_id_        NUMBER;
   measurement_boolean_   VARCHAR2(10); 
   measurement_date_time_ DATE;
   measurement_text_      VARCHAR2(4000);
   meas_type_value_code_  VARCHAR2(8);
   measurement_eu_code_   VARCHAR2(8);
   
BEGIN
   child_key_.objkey     := objkey_;
   old_rec_              := Get_Record___(child_key_);
   new_rec_              := old_rec_;
   measurement_id_       := old_rec_.measurement_id;
   measurement_quantity_ := Av_Exe_Task_Measurement_API.Get_Measurement_Qty(measurement_id_);
   measurement_type_     := old_rec_.measurement_category;
   measurement_eu_code_  := Av_Measurement_Type_API.Get_Engineering_Unit_Code(old_rec_.measurement_type_code);
   measurement_boolean_  := Av_Exe_Task_Measurement_API.Get_Measurement_Boolean(measurement_id_);
   measurement_date_time_:= Av_Exe_Task_Measurement_API.Get_Measurement_Date_Time(measurement_id_);
   measurement_text_     := Av_Exe_Task_Measurement_API.Get_Measurement_Text(measurement_id_);
   meas_type_value_code_ := Av_Exe_Task_Measurement_API.Get_Meas_Type_Value_Code(measurement_id_);
      
   new_rec_.signed_flag               := FALSE;
   new_rec_.measured_user             := NULL;
   new_rec_.measured_user_name        := NULL;
   new_rec_.measured_date             := NULL;
   new_rec_.measurement_qty           := measurement_quantity_;
   
   IF revoke_sign_off_reason_ IS NOT NULL THEN
      new_rec_.revoke_sign_off_reason := revoke_sign_off_reason_;
   END IF;
   
   IF measurement_type_ = 'ME' THEN
      new_rec_.measurement_value := CONCAT(CONCAT(measurement_quantity_, ' '), measurement_eu_code_);
   ELSIF measurement_type_ = 'CHK' THEN
      IF(measurement_boolean_ = 'True') THEN
         new_rec_.measurement_value := 'YES';
      ELSE
         new_rec_.measurement_value := 'NO'; 
      END IF;
   ELSIF measurement_type_ = 'CME' THEN
      new_rec_.measurement_value :=  TO_CHAR( measurement_date_time_, 'DD-MON-YY HH24:MM' );
   ELSIF measurement_type_ = 'TEXT' THEN
      new_rec_.measurement_value := measurement_text_;
   ELSIF measurement_type_ = 'CH' THEN
      new_rec_.measurement_value := CONCAT(CONCAT(meas_type_value_code_, ' '), measurement_eu_code_);
   ELSE
      new_rec_.measurement_value := NULL;
   END IF;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Revoke_Measurement___;

--The procedure is used to update the visibilty of buttons in the header
PROCEDURE CheckAndSetParentButtons___(
   parent_objkey_ IN VARCHAR2,
   complete_task_ IN BOOLEAN)
IS
   parent_key_       Record_Work_Virtual_Key;
   parent_rec_       Record_Work_Virtual_Rec;
   parent_new_rec_   Record_Work_Virtual_Rec; 
   do_update_        BOOLEAN := FALSE;   
BEGIN
   parent_key_.Objkey   := parent_objkey_;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
   IF(parent_rec_.sign_enable = FALSE) THEN
      parent_new_rec_.sign_enable := TRUE;
      do_update_ := TRUE;
   END IF;   
   IF (parent_new_rec_.complete_task_enable = FALSE AND complete_task_ = FALSE) THEN 
      IF (Check_Complete_Task_Enable___(parent_new_rec_.objkey)) THEN 
         parent_new_rec_.complete_task_enable  := TRUE;
         parent_new_rec_.task_certification_enable := FALSE;
         do_update_ := TRUE;         
      END IF;
   ELSIF (complete_task_ = TRUE) THEN 
      parent_new_rec_.complete_task_enable  := FALSE;
      parent_new_rec_.task_certification_enable := TRUE;
      do_update_ := TRUE; 
   END IF;
    
   IF (do_update_) THEN
      CRUD_Update___(parent_rec_, parent_new_rec_);         
   END IF;
END CheckAndSetParentButtons___;

FUNCTION Format_Hours___ (
   hours_per_person_ IN VARCHAR2,
   time_var_name_    IN VARCHAR2) RETURN NUMBER
IS
   duration_  NUMBER;   
BEGIN
   duration_ := Adcom_Util_API.Validate_Format_Hours(hours_per_person_) ;
   IF duration_ IS NULL  THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALID: Enter :P1 in the HH:MM format.', time_var_name_);
   END IF;
   RETURN duration_;
END Format_Hours___;

PROCEDURE Update_Install_Part___ (
   objkey_              IN VARCHAR2,
   installed_serial_no_ IN VARCHAR2,
   installed_batch_no_  IN VARCHAR2,
   installed_quantity_  IN NUMBER,
   installed_part_no_id_    IN NUMBER)
IS
   old_rec_ Installed_Part_Line_Virtual_Rec;
   new_rec_ Installed_Part_Line_Virtual_Rec;
   child_key_ Installed_Part_Line_Virtual_Key;
   
   installed_user_ VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
   
BEGIN
   child_key_.objkey := objkey_;   
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;	
   
   new_rec_.installed_serial_no := installed_serial_no_;
   new_rec_.installed_batch_no := installed_batch_no_;
   new_rec_.installed_quantity := installed_quantity_;
   new_rec_.installed_user := installed_user_;
   new_rec_.installed_date := Time_Util_API.Get_Sysdate_In_Utc;
   new_rec_.installed_part_no_id := installed_part_no_id_;
   
   IF old_rec_.installed_quantity < new_rec_.installed_quantity THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVQTY: Please create another part requirement for the additional quantity of installed parts.');
   END IF;
   IF new_rec_.installed_quantity < 1 OR new_rec_.installed_quantity IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVINSTQTY: Installed quantity should be greater than 0.');
   END IF;
   new_rec_.signed_flag := true;
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Update_Install_Part___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Installed_Part___ (
   objkey_ IN VARCHAR2,
   revoke_sign_off_reason_ IN VARCHAR2)
IS
   old_rec_               Installed_Part_Line_Virtual_Rec;
   new_rec_               Installed_Part_Line_Virtual_Rec;   
   child_key_             Installed_Part_Line_Virtual_Key;
   serial_no_             VARCHAR2(40);
   batch_no_              VARCHAR2(40);
   part_no_id_            NUMBER;
   quantity_              NUMBER;
   
BEGIN
   child_key_.objkey     := objkey_;
   old_rec_              := Get_Record___(child_key_);
   new_rec_              := old_rec_;
   serial_no_            := Av_Exe_Task_Part_API.Get_Installed_Serial_No(old_rec_.task_part_id);
   batch_no_             := Av_Exe_Task_Part_API.Get_Installed_Batch_No(old_rec_.task_part_id);
   part_no_id_           := Av_Exe_Task_Part_API.Get_Installed_Part_No_Id(old_rec_.task_part_id);
   quantity_             := Av_Exe_Task_Part_API.Get_Installed_Quantity(old_rec_.task_part_id);
   
   new_rec_.installed_serial_no  := serial_no_;
   new_rec_.installed_batch_no   := batch_no_;
   new_rec_.installed_part_no_id := part_no_id_;
   new_rec_.installed_user       := NULL;
   new_rec_.installed_user_name  := NULL;
   new_rec_.installed_date       := NULL;
   new_rec_.installed_quantity   := quantity_;
   new_rec_.signed_flag          := FALSE;
   IF revoke_sign_off_reason_ IS NOT NULL THEN
      new_rec_.revoke_sign_off_reason := revoke_sign_off_reason_;
   END IF;
   
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
   
END Revoke_Installed_Part___;

PROCEDURE Update_Rmv_Part___ (
   objkey_              IN VARCHAR2,
   removed_serial_no_   IN VARCHAR2,
   removed_batch_no_    IN VARCHAR2,
   removed_quantity_    IN NUMBER,
   removal_reason_code_ IN VARCHAR2,
   removed_part_no_id_  IN NUMBER)
IS
   old_rec_ Removed_Part_Line_Virtual_Rec;
   new_rec_ Removed_Part_Line_Virtual_Rec;
   child_key_ Removed_Part_Line_Virtual_Key;
   
   removed_user_ VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
   
BEGIN
	child_key_.objkey := objkey_;   
   old_rec_          := Get_Record___(child_key_);
   new_rec_          := old_rec_;
   
   new_rec_.removal_serial_no := removed_serial_no_;
   new_rec_.removal_batch_no := removed_batch_no_;
   new_rec_.removed_quantity := removed_quantity_;
   new_rec_.removal_reason_code := removal_reason_code_;
   new_rec_.removed_user := removed_user_;
   new_rec_.removed_date := Time_Util_API.Get_Sysdate_In_Utc;
   new_rec_.removal_part_no_id := removed_part_no_id_;
   
   IF old_rec_.removed_quantity < new_rec_.removed_quantity THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVQTY: Please create another part requirement for the additional quantity of removed parts.');
   END IF;
   IF new_rec_.removed_quantity < 1 OR new_rec_.removed_quantity IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVRMVDQTY: Removed quantity should be greater than 0.');
   END IF;
   new_rec_.signed_flag := true;
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
   
   IF new_rec_.removal_reason_code ='ACCESS' THEN
      Create_Inst_Line_Task_Card___(objkey_, new_rec_.removal_serial_no, new_rec_.removal_batch_no, new_rec_.task_part_id);
   END IF;
END Update_Rmv_Part___;

@IgnoreUnitTest NoOutParams
PROCEDURE Revoke_Removed_Part___ (
   objkey_ IN VARCHAR2,
   revoke_sign_off_reason_ IN VARCHAR2)
IS
   old_rec_             Removed_Part_Line_Virtual_Rec;
   new_rec_             Removed_Part_Line_Virtual_Rec;
   child_key_           Removed_Part_Line_Virtual_Key;
   serial_no_           VARCHAR2(40);
   batch_no_            VARCHAR2(40);
   part_no_id_          NUMBER;
   removal_reason_code_ VARCHAR2(8);
   quantity_            NUMBER;
BEGIN
   child_key_.objkey     := objkey_;
   old_rec_              := Get_Record___(child_key_);
   new_rec_              := old_rec_;
   serial_no_            := Av_Exe_Task_Part_API.Get_Removed_Serial_No(old_rec_.task_part_id);
   batch_no_             := Av_Exe_Task_Part_API.Get_Removed_Batch_No(old_rec_.task_part_id);
   part_no_id_           := Av_Exe_Task_Part_API.Get_Removed_Part_No_Id(old_rec_.task_part_id);
   removal_reason_code_  := Av_Exe_Task_Part_API.Get_Removal_Reason_Code(old_rec_.task_part_id);
   quantity_             := Av_Exe_Task_Part_API.Get_Removed_Quantity(old_rec_.task_part_id);
   
   new_rec_.removal_serial_no    := serial_no_; 
   new_rec_.removal_batch_no     := batch_no_; 
   new_rec_.removal_part_no_id   := part_no_id_;   
   new_rec_.removed_user         := NULL;
   new_rec_.removed_user_name    := NULL;
   new_rec_.removed_date         := NULL;
   new_rec_.removal_reason_code  := removal_reason_code_;
   new_rec_.removed_quantity     := quantity_;
   new_rec_.signed_flag          := FALSE;
   IF revoke_sign_off_reason_ IS NOT NULL THEN
      new_rec_.revoke_sign_off_reason := revoke_sign_off_reason_;
   END IF;
   CRUD_Update___(old_rec_, new_rec_);
   CheckAndSetParentButtons___(new_rec_.parent_objkey, FALSE);
END Revoke_Removed_Part___;

FUNCTION Get_Task_Action_Count___ (
   key_ IN Record_Work_Virtual_Key) RETURN NUMBER
IS
   row_count_ NUMBER;
   CURSOR Get_Task_Actions_Count___ (master_ IN Record_Work_Virtual_Key) IS
      SELECT COUNT(*) FROM ${PROJECTION}_TASK_ACTION_LINE_VIRTUAL_VRT 
      WHERE parent_objkey = master_.objkey;
BEGIN
   OPEN Get_Task_Actions_Count___(key_);
   FETCH Get_Task_Actions_Count___ INTO row_count_;
   CLOSE Get_Task_Actions_Count___;
   RETURN row_count_;
END Get_Task_Action_Count___;

FUNCTION Get_Last_Task_Action_Type___ (
   key_ IN Record_Work_Virtual_Key) RETURN VARCHAR2
IS
   task_action_type_ VARCHAR2(20);
   CURSOR Get_Last_Task_Action_Type___ (master_ IN Record_Work_Virtual_Key) IS
      SELECT ACTION_TYPE FROM ${PROJECTION}_TASK_ACTION_LINE_VIRTUAL_VRT 
      WHERE parent_objkey = master_.objkey
      ORDER BY Action_Ord DESC
      FETCH first 1 ROW ONLY;
BEGIN
   OPEN Get_Last_Task_Action_Type___(key_);
   FETCH Get_Last_Task_Action_Type___ INTO task_action_type_;
   CLOSE Get_Last_Task_Action_Type___;
   RETURN task_action_type_;
END Get_Last_Task_Action_Type___;

PROCEDURE Sign___ (
   objkey_                 IN VARCHAR2,
   task_seq_               IN NUMBER,
   bind_signature_id_      IN VARCHAR2,
   record_work_start_time_ IN DATE,
   site_                   IN VARCHAR2)
IS
   parent_key_                   Record_Work_Virtual_Key;
   actual_duration_              NUMBER;
   measurement_boolean_text_     VARCHAR2(8);
   info_                         VARCHAR2(4000);
   objid_                        VARCHAR2(200);
   objversion_                   VARCHAR2(200);
   attr_                         VARCHAR2(32000);
   wp_info_                      VARCHAR2(4000);
   wp_objid_                     VARCHAR2(200);
   wp_objversion_                VARCHAR2(200);
   wp_attr_                      VARCHAR2(32000);
   actual_start_date_            DATE;
   parent_rec_                   Record_Work_Virtual_Rec;
   fault_action_id_var_          VARCHAR2(32000);
   fault_action_id_              NUMBER;
   fault_id_                     NUMBER;
   task_state_                   VARCHAR2(20);
   wp_id_                        NUMBER;
   wp_state_                     av_aircraft_work_package_tab.rowstate%TYPE;
   task_actual_start_date_       DATE;
   e_sig_permission_             VARCHAR2(20);
   clock_in_objkey_              VARCHAR2(100);
   part_number_                  VARCHAR2(40);
   is_repairable_                VARCHAR2(10);
   task_return_line_seq_         NUMBER;
   clock_in_vrt_key_             Clock_In_Virtual_Key;
   clock_in_vrt_rec_             Clock_In_Virtual_Rec;
   return_attr_                  VARCHAR2(32000);
   removed_serial_no_            VARCHAR2(40); 
   removed_batch_no_             VARCHAR2(40);
   removed_part_no_              VARCHAR2(40);
   serial_tracking_code_         VARCHAR2(20);
   lot_tracking_code_            VARCHAR2(20);
   inventory_class_code_         VARCHAR2(10);
   planned_return_qty_           NUMBER;
   removal_reason_code_          VARCHAR2(10);
   inst_removal_reason_code_     VARCHAR2(10);
   has_execution_record_         BOOLEAN;
   clocking_record_count_        NUMBER;
   execution_instance_seq_       NUMBER;
   resource_activity_alloc_seq_  NUMBER;
   resource_activity_seq_        NUMBER;
   clocking_seq_                 NUMBER;
   format_hours_                 NUMBER;
   pre_measured_value_           VARCHAR2(4000);
   curr_measured_value_          VARCHAR2(4000);
   pre_signed_user_              VARCHAR2(40);
   pre_signed_date_              DATE;
   event_log_text_               VARCHAR2(4000);
   current_user_                 VARCHAR2(40);
   pre_action_note_              VARCHAR2(4000);
   step_sign_off_objid_          VARCHAR2(200);
   step_sign_off_objversion_     VARCHAR2(200);
   transaction_objid_            VARCHAR2(200);
   transaction_objversion_       VARCHAR2(200);
   step_sign_off_note_           VARCHAR2(4000) := NULL;
   step_identity_                VARCHAR2(30) := NULL;
   step_sign_off_date_           DATE := NULL;
   pre_sign_off_note_            VARCHAR2(4000);
   pre_task_part_                av_exe_task_part_api.Public_Rec;
   tool_actual_hours_            NUMBER;
   tool_equipment_before_edit_   VARCHAR2(100);
   tool_equipment_after_edit_    VARCHAR2(100);
   serial_no_before_edit_        VARCHAR2(50);
   serial_no_after_edit_         VARCHAR2(50);
   part_no_before_edit_          VARCHAR2(100);
   part_no_after_edit_           VARCHAR2(100);
   actual_hours_before_edit_     VARCHAR2(10);
   actual_hours_after_edit_      VARCHAR2(10);
   sales_part_no_                VARCHAR2(100);
   transaction_rec_              Jt_Task_Transaction_Tab%ROWTYPE;
   task_pub_rec_                 Av_Exe_Task_API.Public_Rec;
   task_cost_line_pub_rec_       Jt_Task_Cost_Line_API.Public_Rec;
   task_cost_line_seq_           jt_task_cost_line_tab.task_cost_line_seq%TYPE;
   measurement_eu_code_          VARCHAR2(8);
   pre_signed_date_text_         VARCHAR2(200);
   rmvd_part_id_                 NUMBER;

   CURSOR get_max_action_ord_ IS
      SELECT MAX(action_ord)
      FROM AV_EXE_TASK_ACTION_TAB
      WHERE task_seq = task_seq_;
   
   CURSOR get_fault_id IS
      SELECT fault_id
      FROM av_exe_task
      WHERE task_seq = task_seq_;
   
   CURSOR get_wp_id IS
      SELECT aircraft_wp_id
      FROM av_exe_task
      WHERE task_seq = task_seq_;
   
   CURSOR get_e_sig_user IS
      SELECT permission 
      FROM av_e_sig_user_permission_tab
      WHERE identity = Fnd_Session_API.Get_Fnd_User();
      
   CURSOR Get_Task_Actions_Array_Order_By_Action_Order___ (master_ IN Record_Work_Virtual_Key) IS
      SELECT * FROM ${PROJECTION}_TASK_ACTION_LINE_VIRTUAL_VRT 
      WHERE parent_objkey = master_.objkey 
      ORDER BY ACTION_ORD ASC;
      
   CURSOR Get_Clock_In (master_ IN Record_Work_Virtual_Key) IS
      SELECT objkey 
      FROM ${PROJECTION}_CLOCK_IN_VIRTUAL_VRT 
      WHERE parent_objkey = master_.objkey;
      
   CURSOR get_task_actual_start IS
      SELECT actual_start
      FROM  av_exe_task
      WHERE task_seq = task_seq_;
      
   CURSOR get_step(parent_objkey_ VARCHAR2) IS
      SELECT  objkey
      FROM ${PROJECTION}_STEP_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_;
      
   CURSOR get_step_sign_offs(parent_objkey_ VARCHAR2) IS
      SELECT  signed_flag, task_step_seq, identity, sign_off_status, sign_off_req_type_db, grouping_no, sign_off_note, sign_off_req_seq, revoke_sign_off_reason, order_no, role
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_
      ORDER BY grouping_no, order_no;

   CURSOR get_active_critical_items IS
      SELECT critical_item_id
      FROM av_critical_item_tab
      WHERE task_seq = task_seq_
      AND rowstate = 'Active';
      
   CURSOR get_av_part_info(part_number_id_  IN NUMBER) IS
      SELECT Part_Number, Is_Repairable, Inventory_Class_Code
      FROM av_part_number_tab
      WHERE part_number_id = part_number_id_;
      
   CURSOR get_panel(parent_objkey_ VARCHAR2) IS
      SELECT  objkey
      FROM ${PROJECTION}_PANEL_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_;
      
   CURSOR get_av_task_part_info(task_part_id_ NUMBER) IS
      SELECT  pn.part_number, tp.removed_serial_no, tp.removed_batch_no
      FROM av_exe_task_part tp
      INNER JOIN av_part_number pn ON tp.removed_part_no_id = pn.part_number_id 
      WHERE tp.task_part_id = task_part_id_;
   
   CURSOR get_tool_resource_demand(parent_objkey_ VARCHAR2) IS 
      SELECT  task_seq, resource_seq, resource_group_seq, execution_instance_seq, task_resource_seq,
              planned_hours, allocated_start_date, allocated_finish_date, actual_hours, checked_out_date,
              actual_end_date, signed_flag, site, is_edit_tool, reason_to_edit
      FROM ${PROJECTION}_TOOL_RESOURCE_DEMAND_VIRTUAL_VRT 
      WHERE parent_objkey = parent_objkey_
      AND signed_flag = 1
      ORDER BY task_seq, task_resource_seq;
           
   CURSOR is_clocking_exists(task_seq_ NUMBER, execution_instance_seq_ NUMBER) IS
      SELECT COUNT(task_seq) 
      FROM jt_task_clocking_tab
      WHERE task_seq = task_seq_
      AND execution_instance_seq = execution_instance_seq_;
      
   CURSOR get_step_sign_off(task_seq_ NUMBER,task_step_seq_ NUMBER,sign_off_req_seq_ NUMBER) IS
      SELECT rowid, to_char(rowversion,'YYYYMMDDHH24MISS')
      FROM  jt_task_step_sign_off_tab
      WHERE task_seq = task_seq_
      AND   task_step_seq = task_step_seq_
      AND   sign_off_req_seq = sign_off_req_seq_; 
      
   CURSOR Get_Resource_Activity_Seq(task_seq_ NUMBER, task_resource_seq_ NUMBER) IS
      SELECT resource_activity_seq 
      FROM jt_task_resource_activity_ext
      WHERE  task_seq = task_seq_
      AND    task_resource_seq = task_resource_seq_;
      
   CURSOR get_transaction(task_seq_ NUMBER, task_resource_seq_ NUMBER, execution_instance_seq_ NUMBER) IS
      SELECT rowid, to_char(rowversion,'YYYYMMDDHH24MISS')
      FROM jt_task_transaction_tab
      WHERE task_seq = task_seq_
      AND task_resource_seq = task_resource_seq_
      AND execution_instance_seq = execution_instance_seq_;
      
   CURSOR get_task_cost_line_seq(task_seq_ NUMBER, transaction_id_ NUMBER) IS
      SELECT task_cost_line_seq 
      FROM jt_task_cost_line 
      WHERE task_seq = task_seq_ 
      AND task_transaction_id = transaction_id_;
BEGIN
   OPEN get_e_sig_user;
   FETCH get_e_sig_user INTO e_sig_permission_;
   CLOSE get_e_sig_user;
   
   IF ((e_sig_permission_ IS NULL OR e_sig_permission_ = 'Yes')AND bind_signature_id_ IS NULL) THEN
      Error_SYS.Record_General(lu_name_, 'ESIGWERROR: Failed to record electronic signature. Review changes and try again.');
   END IF;
   
   current_user_ := Fnd_Session_API.Get_Fnd_User();
   parent_key_.Objkey := objkey_;
   parent_rec_ := Get_Record___(parent_key_);
	
   -- Sign the tools that were recorded by the user
   IF parent_rec_.resource_tool_enable THEN
      FOR child_tool_rec IN Get_Resource_Tools_Array___(parent_key_) LOOP
         IF (child_tool_rec.is_signed = 1) THEN
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('RESOURCE_SEQ', child_tool_rec.resource_seq, attr_);
            Client_SYS.Add_To_Attr('PART_NO', child_tool_rec.part_no, attr_);
            Client_SYS.Add_To_Attr('SERIAL_NO', child_tool_rec.serial_no, attr_);
            Client_SYS.Add_To_Attr('ASSIGNED_USER', child_tool_rec.assigned_user, attr_);
            Client_SYS.Add_To_Attr('ASSIGNED_DATE_TIME', child_tool_rec.assigned_date_time, attr_);
            actual_duration_ := Format_Hours___(child_tool_rec.actual_duration, 'Actual Duration');
            Client_SYS.Add_To_Attr('ACTUAL_DURATION', actual_duration_, attr_);
            Client_SYS.Add_To_Attr('BIND_SIGNATURE_ID', bind_signature_id_, attr_);
            Av_Resource_Tool_Equipment_API.Modify(child_tool_rec.tool_id, attr_);
         END IF;
      END LOOP;
   ELSE
      FOR child_tool_rec IN Get_Tools_Array___(parent_key_) LOOP 
         IF (child_tool_rec.is_signed = 1) THEN
            actual_duration_ := Format_Hours___(child_tool_rec.actual_duration, 'Actual Duration');
            Av_Exe_Task_Tool_API.Modify(child_tool_rec.task_tool_id, actual_duration_, child_tool_rec.serial_no, child_tool_rec.assigned_user, child_tool_rec.assigned_date_tiime, bind_signature_id_);      
         END IF;
      END LOOP;
   END IF;

   -- Sign the measurements that were recorded by the user
    FOR child_measurement_rec IN Get_Measurements_Array___(parent_key_) LOOP 
      IF (child_measurement_rec.signed_flag = 1 OR child_measurement_rec.revoke_sign_off_reason IS NOT NULL OR child_measurement_rec.reason_to_edit IS NOT NULL ) THEN
         pre_signed_user_ := Av_Exe_Task_Measurement_API.Get_Measured_User(child_measurement_rec.measurement_id);
         pre_signed_date_ := Av_Exe_Task_Measurement_API.Get_Measured_Date(child_measurement_rec.measurement_id);
         pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';

         IF (child_measurement_rec.measurement_boolean IS NOT NULL) AND (child_measurement_rec.measurement_category = 'CHK') THEN
            pre_measured_value_ := Av_Exe_Task_Measurement_API.Get_Measurement_Boolean(child_measurement_rec.measurement_id);
            IF child_measurement_rec.measurement_boolean = 1 THEN
               measurement_boolean_text_ := 'True';
            ELSIF child_measurement_rec.measurement_boolean = 0 THEN
               measurement_boolean_text_ := 'False';
            END IF;
            curr_measured_value_ := measurement_boolean_text_;
            Av_Exe_Task_Measurement_API.Modify(child_measurement_rec.measurement_id, NULL, NULL, NULL, NULL, measurement_boolean_text_, child_measurement_rec.measured_user, child_measurement_rec.measured_date, bind_signature_id_);      
         
         ELSIF child_measurement_rec.measurement_category = 'ME' THEN
            pre_measured_value_ := TO_CHAR(Av_Exe_Task_Measurement_API.Get_Measurement_Qty(child_measurement_rec.measurement_id));
            curr_measured_value_ := TO_CHAR(child_measurement_rec.measurement_qty);           
            Av_Exe_Task_Measurement_API.Modify(child_measurement_rec.measurement_id, NULL, child_measurement_rec.measurement_qty, NULL, NULL, NULL, child_measurement_rec.measured_user, child_measurement_rec.measured_date, bind_signature_id_);      
         
         ELSIF child_measurement_rec.measurement_category = 'TEXT' THEN
            pre_measured_value_ := Av_Exe_Task_Measurement_API.Get_Measurement_Text(child_measurement_rec.measurement_id);
            curr_measured_value_ := child_measurement_rec.measurement_text;
            Av_Exe_Task_Measurement_API.Modify(child_measurement_rec.measurement_id, NULL, NULL, NULL, child_measurement_rec.measurement_text, NULL, child_measurement_rec.measured_user, child_measurement_rec.measured_date, bind_signature_id_);      
         
         ELSIF child_measurement_rec.measurement_category = 'CH' THEN
            pre_measured_value_ := Av_Exe_Task_Measurement_API.Get_Meas_Type_Value_Code(child_measurement_rec.measurement_id);
            curr_measured_value_ := child_measurement_rec.meas_type_value_code;
            Av_Exe_Task_Measurement_API.Modify(child_measurement_rec.measurement_id, child_measurement_rec.meas_type_value_code, NULL, NULL, NULL, NULL, child_measurement_rec.measured_user, child_measurement_rec.measured_date, bind_signature_id_);      
         
         ELSIF child_measurement_rec.measurement_category = 'CME' THEN
            pre_measured_value_ := TO_CHAR(Av_Exe_Task_Measurement_API.Get_Measurement_Date_Time(child_measurement_rec.measurement_id));
            curr_measured_value_ := TO_CHAR(child_measurement_rec.measurement_date_time);
            Av_Exe_Task_Measurement_API.Modify(child_measurement_rec.measurement_id, NULL, NULL, child_measurement_rec.measurement_date_time, NULL, NULL, child_measurement_rec.measured_user, child_measurement_rec.measured_date, bind_signature_id_);      
         END IF;
                 
         -- If measurement record is revoked by an authorized user, add an entry in the event log
         IF child_measurement_rec.revoke_sign_off_reason IS NOT NULL THEN
            event_log_text_ := 'Sign-off by '|| pre_signed_user_ || ' for measurement ' || child_measurement_rec.measurement_type_code || ' = ' || child_measurement_rec.measurement_value || ' was revoked by ' || current_user_ || '.Previous sign-off was recorded by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_ ||'.'; 
            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_measurement_rec.task_seq, 
                                                 event_id_ => 'SIGNOFF_REVOKED', 
                                                 log_text_ => event_log_text_,
                                                 note_     => child_measurement_rec.revoke_sign_off_reason,  
                                                 attr_     => attr_);
         END IF;
         
         -- If measurement record is edited by an authorized user, add an entry in the event log
         IF (child_measurement_rec.reason_to_edit IS NOT NULL) THEN                                    
            IF (child_measurement_rec.measurement_category IN('ME', 'CH')) THEN 
               measurement_eu_code_ := Av_Measurement_Type_API.Get_Engineering_Unit_Code(child_measurement_rec.measurement_type_code); 
               event_log_text_ := 'Authorized user '|| current_user_ || ' edited measurement value from ' || pre_measured_value_ || measurement_eu_code_ || ' to ' || child_measurement_rec.measurement_value || ' for type ' || child_measurement_rec.measurement_type_code || '. Previous Value: ' || child_measurement_rec.measurement_type_code || ': ' || pre_measured_value_ || measurement_eu_code_ || '. Original entry by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_; 
            ELSE
              event_log_text_ := 'Authorized user '|| current_user_ || ' edited measurement value from ' || pre_measured_value_ || ' to ' || child_measurement_rec.measurement_value || ' for type ' || child_measurement_rec.measurement_type_code || '. Previous Value: ' || child_measurement_rec.measurement_type_code || ': ' || pre_measured_value_ || '. Original entry by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_; 
            END IF;  
            
            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_measurement_rec.task_seq, 
                                                    event_id_ => 'SIGNOFF_EDITED', 
                                                    log_text_ => event_log_text_,
                                                    note_     => child_measurement_rec.reason_to_edit,  
                                                    attr_     => attr_);         
        
         END IF;
      END IF;
      
   
   END LOOP;

   -- Sign the task actions that were recorded by the user   
   
   OPEN get_fault_id;
   FETCH get_fault_id INTO fault_id_;
   CLOSE get_fault_id;
   
   FOR child_task_action_rec IN Get_Task_Actions_Array_Order_By_Action_Order___(parent_key_) LOOP 
      IF (child_task_action_rec.signed_flag = 1) THEN
      
         IF(fault_id_ IS NOT NULL) THEN
            info_ := NULL;
            objid_ := NULL;
            objversion_ :=NULL;
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('FAULT_ID',     fault_id_,                           attr_);
            Client_SYS.Add_To_Attr('ACTION_USER',  child_task_action_rec.action_user,   attr_);
            Client_SYS.Add_To_Attr('ACTION_DESC',  child_task_action_rec.action_desc,   attr_);
            Client_SYS.Add_To_Attr('ACTION_DATE',  child_task_action_rec.action_date,   attr_);
            Client_SYS.Add_To_Attr('ACTION_ORD',   child_task_action_rec.action_ord,    attr_);
            Client_SYS.Add_To_Attr('IS_CORRECTIVE','True',                              attr_);

            IF (child_task_action_rec.reason_to_edit IS NULL) THEN
               Av_Fault_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');
            END IF;
                       
            fault_action_id_var_ := Client_SYS.Get_Item_Value('FAULT_ACTION_ID', attr_);
            fault_action_id_     := Client_SYS.Attr_Value_To_Number(fault_action_id_var_);
            
            IF (child_task_action_rec.reason_to_edit IS NOT NULL) THEN
                IF fault_action_id_ IS NULL THEN
                  fault_action_id_ := Av_Exe_Task_Action_API.Get_Fault_Action_Id(child_task_action_rec.task_action_id);
                END IF;
                Av_Fault_Action_API.Get_Id_Version_By_Fault_Act_Id(objid_, objversion_, fault_action_id_ );
                Av_Fault_Action_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
            END IF; 
            
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('TASK_SEQ',        child_task_action_rec.task_seq,     attr_);
            Client_SYS.Add_To_Attr('ACTION_USER',     child_task_action_rec.action_user,  attr_);
            Client_SYS.Add_To_Attr('ACTION_DESC',     child_task_action_rec.action_desc,  attr_);
            Client_SYS.Add_To_Attr('ACTION_DATE',     child_task_action_rec.action_date,  attr_);
            Client_SYS.Add_To_Attr('ACTION_ORD',      child_task_action_rec.action_ord,   attr_);
            Client_SYS.Add_To_Attr('ACTION_TYPE',     'Corrective' ,                      attr_);
            Client_SYS.Add_To_Attr('FAULT_ACTION_ID', fault_action_id_ ,                  attr_);
            Client_SYS.Add_To_Attr('BIND_SIGNATURE_ID', bind_signature_id_, attr_);           
            
            IF (child_task_action_rec.reason_to_edit IS NULL) THEN              
               Av_Exe_Task_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');                              
            ELSE
               pre_action_note_ := Av_Exe_Task_Action_API.Get_Action_Desc(child_task_action_rec.task_action_id);
               pre_signed_user_ := Av_Exe_Task_Action_API.Get_Action_User(child_task_action_rec.task_action_id);
               pre_signed_date_ := Av_Exe_Task_Action_API.Get_Action_Date(child_task_action_rec.task_action_id);
               pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
                           
               Av_Exe_Task_Action_API.Get_Id_Version_By_Task_Act_Id(objid_, objversion_, child_task_action_rec.task_action_id );
               Av_Exe_Task_Action_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
               
               event_log_text_ := 'Authorized user '|| current_user_ || ' edited action taken note from "' || pre_action_note_ || '" to "' || child_task_action_rec.action_desc || '". Previous Value: ' || pre_action_note_ || '. Original entry by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_; 
               Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_task_action_rec.task_seq, 
                                                    event_id_ => 'SIGNOFF_EDITED', 
                                                    log_text_ => event_log_text_,
                                                    note_     => child_task_action_rec.reason_to_edit,  
                                                    attr_     => attr_);   
                                                
            END IF; 
            
         ELSE 
            info_ := NULL;
            objid_ := NULL;
            objversion_ :=NULL;
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('TASK_SEQ',    child_task_action_rec.task_seq,      attr_);
            Client_SYS.Add_To_Attr('ACTION_USER', child_task_action_rec.action_user,   attr_);
            Client_SYS.Add_To_Attr('ACTION_DESC', child_task_action_rec.action_desc,   attr_);
            Client_SYS.Add_To_Attr('ACTION_DATE', child_task_action_rec.action_date,   attr_);
            Client_SYS.Add_To_Attr('ACTION_ORD',  child_task_action_rec.action_ord,    attr_);
            Client_SYS.Add_To_Attr('ACTION_TYPE','Corrective' ,                        attr_);
            Client_SYS.Add_To_Attr('BIND_SIGNATURE_ID', bind_signature_id_, attr_);

            
            IF (child_task_action_rec.reason_to_edit IS NULL) THEN 
               Av_Exe_Task_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');
            ELSE 
               pre_action_note_ := Av_Exe_Task_Action_API.Get_Action_Desc(child_task_action_rec.task_action_id);
               pre_signed_user_ := Av_Exe_Task_Action_API.Get_Action_User(child_task_action_rec.task_action_id);
               pre_signed_date_ := Av_Exe_Task_Action_API.Get_Action_Date(child_task_action_rec.task_action_id);
               pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
                           
               Av_Exe_Task_Action_API.Get_Id_Version_By_Task_Act_Id(objid_, objversion_, child_task_action_rec.task_action_id );
               Av_Exe_Task_Action_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
               
               event_log_text_ := 'Authorized user '|| current_user_ || ' edited action taken note from ' || pre_action_note_ || ' to ' || child_task_action_rec.action_desc || '. Previous Value: ' || pre_action_note_ || '. Original entry by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_; 
               Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_task_action_rec.task_seq, 
                                                    event_id_ => 'SIGNOFF_EDITED', 
                                                    log_text_ => event_log_text_,
                                                    note_     => child_task_action_rec.reason_to_edit,  
                                                    attr_     => attr_); 
            END IF; 
            
         END IF;
      END IF;         
   END LOOP;
   
   FOR child_inst_part_rec IN Get_Installed_Parts_Array___(parent_key_) LOOP
      IF (child_inst_part_rec.signed_flag = 1 OR child_inst_part_rec.revoke_sign_off_reason IS NOT NULL OR child_inst_part_rec.installed_edit_reason IS NOT NULL) THEN
         pre_signed_user_ := Av_Exe_Task_Part_API.Get_Installed_User(child_inst_part_rec.task_part_id);
         pre_signed_date_ := Av_Exe_Task_Part_API.Get_Installed_Date(child_inst_part_rec.task_part_id);
         pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
         pre_task_part_ := Av_Exe_Task_Part_API.Get(child_inst_part_rec.task_part_id);
         Av_Exe_Task_Part_API.Modify(task_part_id_         => child_inst_part_rec.task_part_id,
                                     installed_serial_no_  => child_inst_part_rec.installed_serial_no,
                                     installed_batch_no_   => child_inst_part_rec.installed_batch_no,
                                     installed_quantity_   => child_inst_part_rec.installed_quantity,
                                     installed_user_       => child_inst_part_rec.installed_user,
                                     installed_part_no_id_ => child_inst_part_rec.installed_part_no_id,
                                     installed_date_       => child_inst_part_rec.installed_date,
                                     config_slot_pos_id_   => child_inst_part_rec.config_slot_position_id,
                                     bind_signature_id_    => bind_signature_id_);

         IF child_inst_part_rec.revoke_sign_off_reason IS NULL THEN
            inventory_class_code_     := Av_Part_Number_API.Get_Inventory_Class_Code(child_inst_part_rec.installed_part_no_id);
            IF inventory_class_code_  != 'BATCH' THEN
               Av_Exe_Task_Part_Util_API.Set_Operation_Info_On_Sign_Off(child_inst_part_rec.task_part_id,Av_Part_Number_API.Get_Part_Number(child_inst_part_rec.installed_part_no_id),child_inst_part_rec.installed_serial_no,'INSTALL');
            END IF;
         END IF;                            
          -- If part installation is revoked by an authorized user, add an entry in the event log
         IF child_inst_part_rec.revoke_sign_off_reason IS NOT NULL THEN
            event_log_text_ := 'Sign-off by '|| pre_signed_user_ || ' for installed part ' || Av_Part_Number_API.Get_Part_Number(child_inst_part_rec.installed_part_no_id) || ' (S/N: ' || child_inst_part_rec.installed_serial_no || ') at Position ' || child_inst_part_rec.config_slot_position_code || ' was revoked by '|| current_user_ ||'.Previous sign-off was recorded by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_ ||'.'; 
            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_inst_part_rec.task_seq, 
                                                 event_id_ => 'SIGNOFF_REVOKED', 
                                                 log_text_ => event_log_text_,
                                                 note_     => child_inst_part_rec.revoke_sign_off_reason,  
                                                 attr_     => attr_);
         END IF;
          -- If part installation is edited by an authorized user, add an entry in the event log
         IF child_inst_part_rec.installed_edit_reason IS NOT NULL THEN
            event_log_text_ := 'Authorized user '|| current_user_ ||' edited the installed part record. The following changes were made: ';
            
            IF pre_task_part_.installed_part_no_id != child_inst_part_rec.installed_part_no_id THEN 
               event_log_text_ := event_log_text_ || ' Part Number was changed from ' || Av_Part_Number_API.Get_Part_Number(pre_task_part_.installed_part_no_id) || ' to ' || Av_Part_Number_API.Get_Part_Number(child_inst_part_rec.installed_part_no_id) || ' .';
            END IF;
            
            IF pre_task_part_.installed_serial_no != child_inst_part_rec.installed_serial_no THEN 
               event_log_text_ := event_log_text_ || ' Serial Number was changed from ' || pre_task_part_.installed_serial_no || ' to ' || child_inst_part_rec.installed_serial_no|| ' .';
            END IF;
            
            IF pre_task_part_.installed_batch_no != child_inst_part_rec.installed_batch_no THEN 
               event_log_text_ := event_log_text_ || ' Batch Number was changed from ' || pre_task_part_.installed_batch_no || ' to ' || child_inst_part_rec.installed_batch_no|| ' .';
            END IF;
            
            IF pre_task_part_.config_slot_position_id != child_inst_part_rec.config_slot_position_id THEN 
               event_log_text_ := event_log_text_ || ' Position was changed from ' || Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(pre_task_part_.config_slot_position_id) || ' to ' || Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(child_inst_part_rec.config_slot_position_id) || ' .';
            END IF; 
            
            IF pre_task_part_.installed_quantity != child_inst_part_rec.installed_quantity THEN 
               event_log_text_ := event_log_text_ || ' Quantity was changed from ' || pre_task_part_.installed_quantity || ' to ' || child_inst_part_rec.installed_quantity || ' .';
            END IF;    
            event_log_text_ := event_log_text_ || ' This record was originally signed off by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_ || '.'; 

            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_inst_part_rec.task_seq, 
                                                 event_id_ => 'SIGNOFF_EDITED', 
                                                 log_text_ => event_log_text_,
                                                 note_     => child_inst_part_rec.installed_edit_reason,  
                                                 attr_     => attr_);
         END IF;
      END IF;
      
      inst_removal_reason_code_  := child_inst_part_rec.removal_reason_code;
      rmvd_part_id_              :=child_inst_part_rec.rmvd_task_part_id;
      IF inst_removal_reason_code_ = 'ACCESS' AND child_inst_part_rec.task_part_id IS NULL THEN
         IF child_inst_part_rec.signed_flag = 1 THEN
            -- create installation line when sign the install record
            Av_Exe_Task_Part_API.Create_Inst_For_Rmvd_Part(rmvd_part_id_,child_inst_part_rec.installed_serial_no, child_inst_part_rec.installed_batch_no, child_inst_part_rec.installed_user, child_inst_part_rec.installed_date);
         ELSE
            -- create installation for non sign records
            Av_Exe_Task_Part_API.Create_Inst_For_Rmvd_Part(rmvd_part_id_, child_inst_part_rec.installed_serial_no, child_inst_part_rec.installed_batch_no, NULL , NULL);    
         END IF;
      END IF;   
   END LOOP;
   
   FOR child_rmv_part_rec IN Get_Removed_Parts_Array___(parent_key_) LOOP
      IF (child_rmv_part_rec.signed_flag = 1) THEN
         task_return_line_seq_ := child_rmv_part_rec.task_return_line_seq;
         removal_reason_code_  := child_rmv_part_rec.removal_reason_code;
         
         OPEN get_av_part_info(child_rmv_part_rec.removal_part_no_id);
         FETCH get_av_part_info INTO part_number_,is_repairable_,inventory_class_code_;
         CLOSE get_av_part_info;
        
         IF task_return_line_seq_ IS NULL THEN
            IF is_repairable_ = 'TRUE' AND removal_reason_code_ != 'ACCESS' THEN
               Av_Exe_Task_Part_Util_API.Av_Return_Creation(task_seq_, part_number_, child_rmv_part_rec.removal_serial_no, child_rmv_part_rec.removal_batch_no, child_rmv_part_rec.removed_quantity, task_return_line_seq_);
            END IF;
         ELSE
            IF removal_reason_code_ = 'ACCESS' THEN
               Av_Exe_Task_Part_API.Update_Task_Return_Line_Seq(child_rmv_part_rec.task_part_id,NULL);
               Jt_Task_Return_API.Remove_Return_Line(task_return_line_seq_);
               task_return_line_seq_ := NULL;
            ELSE
               OPEN get_av_task_part_info(child_rmv_part_rec.task_part_id);
               FETCH get_av_task_part_info INTO removed_part_no_,removed_serial_no_, removed_batch_no_;
               CLOSE get_av_task_part_info;
            
               Client_SYS.Clear_Attr(return_attr_);
            
               serial_tracking_code_ := UPPER(Part_Catalog_API.Get_Serial_Tracking_Code(part_number_));
               IF (child_rmv_part_rec.removal_serial_no != removed_serial_no_) AND (child_rmv_part_rec.removal_serial_no IS NOT NULL) AND (serial_tracking_code_ = Part_Serial_Tracking_API.DB_SERIAL_TRACKING) THEN
                  Client_SYS.Add_To_Attr('SERIAL_NO', child_rmv_part_rec.removal_serial_no, return_attr_);
               END IF;
            
               lot_tracking_code_ := UPPER(Part_Catalog_API.Get_Lot_Tracking_Code(part_number_)); 
               IF (child_rmv_part_rec.removal_batch_no != removed_batch_no_) AND (child_rmv_part_rec.removal_batch_no IS NOT NULL) AND (lot_tracking_code_ = Part_Lot_Tracking_API.DB_LOT_TRACKING) THEN
                  Client_SYS.Add_To_Attr('LOT_BATCH_NO', child_rmv_part_rec.removal_batch_no, return_attr_);
               END IF;
            
               IF inventory_class_code_ = 'BATCH' THEN
               planned_return_qty_ := Jt_Task_Return_API.Get_Qty_To_Return(task_return_line_seq_);
                  IF planned_return_qty_ != child_rmv_part_rec.removed_quantity THEN
                     Client_SYS.Add_To_Attr('QTY_TO_RETURN', child_rmv_part_rec.removed_quantity, return_attr_);
                  END IF;
               END IF;         
            
               Jt_Task_Return_API.Update_Returns_Line(task_return_line_seq_, return_attr_);
            END IF;
         END IF;
         Av_Exe_Task_Part_API.Modify(task_part_id_         => child_rmv_part_rec.task_part_id,
                                     removed_serial_no_    => child_rmv_part_rec.removal_serial_no,
                                     removed_batch_no_     => child_rmv_part_rec.removal_batch_no,
                                     removed_quantity_     => child_rmv_part_rec.removed_quantity,
                                     removed_user_         => child_rmv_part_rec.removed_user,
                                     removal_reason_code_  => child_rmv_part_rec.removal_reason_code,
                                     removed_part_no_id_   => child_rmv_part_rec.removal_part_no_id,
                                     removed_date_         => child_rmv_part_rec.removed_date,
                                     config_slot_pos_id_   => child_rmv_part_rec.config_slot_position_id,
                                     task_return_line_seq_ => task_return_line_seq_,
                                     bind_signature_id_    => bind_signature_id_);      
         
         inventory_class_code_     := Av_Part_Number_API.Get_Inventory_Class_Code(child_rmv_part_rec.removal_part_no_id);
         IF inventory_class_code_  != 'BATCH' THEN
            Av_Exe_Task_Part_Util_API.Set_Operation_Info_On_Sign_Off(child_rmv_part_rec.task_part_id,
                                                            Av_Part_Number_API.Get_Part_Number(child_rmv_part_rec.removal_part_no_id),
                                                            child_rmv_part_rec.removal_serial_no,
                                                            'REMOVAL');
         END IF;
      END IF;
      IF (child_rmv_part_rec.revoke_sign_off_reason IS NOT NULL OR child_rmv_part_rec.removal_edit_reason IS NOT NULL) THEN
         pre_signed_user_ := Av_Exe_Task_Part_API.Get_Removed_User(child_rmv_part_rec.task_part_id);
         pre_signed_date_ := Av_Exe_Task_Part_API.Get_Removed_Date(child_rmv_part_rec.task_part_id);
         pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
         pre_task_part_ := Av_Exe_Task_Part_API.Get(child_rmv_part_rec.task_part_id);
         Av_Exe_Task_Part_API.Modify(task_part_id_         => child_rmv_part_rec.task_part_id,
                                     removed_serial_no_    => child_rmv_part_rec.removal_serial_no,
                                     removed_batch_no_     => child_rmv_part_rec.removal_batch_no,
                                     removed_quantity_     => child_rmv_part_rec.removed_quantity,
                                     removed_user_         => child_rmv_part_rec.removed_user,
                                     removal_reason_code_  => child_rmv_part_rec.removal_reason_code,
                                     removed_part_no_id_   => child_rmv_part_rec.removal_part_no_id,
                                     removed_date_         => child_rmv_part_rec.removed_date,
                                     config_slot_pos_id_   => child_rmv_part_rec.config_slot_position_id,
                                     task_return_line_seq_ => task_return_line_seq_,
                                     bind_signature_id_    => bind_signature_id_);
         IF child_rmv_part_rec.revoke_sign_off_reason IS NOT NULL THEN                          
         -- If part removal is revoked by an authorized user, add an entry in the event log
            event_log_text_ := 'Sign-off by '|| pre_signed_user_ || ' for removed part ' || Av_Part_Number_API.Get_Part_Number(child_rmv_part_rec.removal_part_no_id) || ' (S/N: ' || child_rmv_part_rec.removal_serial_no || ') at Position ' || child_rmv_part_rec.config_slot_position_code || ' [Removal Reason:'||child_rmv_part_rec.removal_reason_code||'] was revoked by '|| current_user_ ||'.Previous sign-off was recorded by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_ ||'.'; 
            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_rmv_part_rec.task_seq, 
                                                 event_id_ => 'SIGNOFF_REVOKED', 
                                                 log_text_ => event_log_text_,
                                                 note_     => child_rmv_part_rec.revoke_sign_off_reason,  
                                                 attr_     => attr_);

         ELSIF child_rmv_part_rec.removal_edit_reason IS NOT NULL THEN
         -- If part removal is edited by an authorized user, add an entry in the event log
            
            event_log_text_ := 'Authorized user '|| current_user_ ||' edited the removed part record. The following changes were made: ';

            IF pre_task_part_.removed_part_no_id != child_rmv_part_rec.removal_part_no_id THEN 
               event_log_text_ := event_log_text_ || ' Part Number was changed from ' || Av_Part_Number_API.Get_Part_Number(pre_task_part_.removed_part_no_id) || ' to ' || Av_Part_Number_API.Get_Part_Number(child_rmv_part_rec.removal_part_no_id) || ' .';
            END IF;

            IF pre_task_part_.removed_serial_no != child_rmv_part_rec.removal_serial_no THEN 
               event_log_text_ := event_log_text_ || ' Serial Number was changed from ' || pre_task_part_.removed_serial_no || ' to ' || child_rmv_part_rec.removal_serial_no|| ' .';
            END IF;

            IF pre_task_part_.removed_batch_no != child_rmv_part_rec.removal_batch_no THEN 
               event_log_text_ := event_log_text_ || ' Batch Number was changed from ' || pre_task_part_.removed_batch_no || ' to ' || child_rmv_part_rec.removal_batch_no|| ' .';
            END IF;

            IF pre_task_part_.config_slot_position_id != child_rmv_part_rec.config_slot_position_id THEN 
               event_log_text_ := event_log_text_ || ' Position was changed from ' || Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(pre_task_part_.config_slot_position_id) || ' to ' || Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(child_rmv_part_rec.config_slot_position_id) || ' .';
            END IF; 

            IF pre_task_part_.removed_quantity != child_rmv_part_rec.removed_quantity THEN 
               event_log_text_ := event_log_text_ || ' Quantity was changed from ' || pre_task_part_.removed_quantity || ' to ' || child_rmv_part_rec.removed_quantity || ' .';
            END IF;  

            IF pre_task_part_.removal_reason_code != child_rmv_part_rec.removal_reason_code THEN 
               event_log_text_ := event_log_text_ || ' Removal reason was changed from ' || pre_task_part_.removal_reason_code || ' to ' || child_rmv_part_rec.removal_reason_code || ' .';
            END IF; 
            
            event_log_text_ := event_log_text_ || ' This record was originally signed off by ' || pre_task_part_.removed_user || ' on ' || pre_signed_date_text_ || '.'; 

            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => child_rmv_part_rec.task_seq, 
                                                 event_id_ => 'SIGNOFF_EDITED', 
                                                 log_text_ => event_log_text_,
                                                 note_     => child_rmv_part_rec.removal_edit_reason,  
                                                 attr_     => attr_);
         END IF;        
      END IF;
   END LOOP;

   OPEN Get_Clock_In(parent_key_);
   FETCH Get_Clock_In INTO clock_in_objkey_;
   CLOSE Get_Clock_In;

   clock_in_vrt_key_.objkey := clock_in_objkey_;   
   clock_in_vrt_rec_        := Get_Record___(clock_in_vrt_key_);
   
   IF parent_rec_.is_job_stop_executed = TRUE THEN
      Do_Job_Stop___ (clock_in_vrt_rec_,parent_rec_);
   ELSE   
      Record_Assignment___(clock_in_vrt_rec_);
   END IF;

   FOR rec_ IN get_step(objkey_) LOOP
      FOR sign_off_rec_ IN get_step_sign_offs(rec_.objkey) LOOP
         pre_signed_user_ := Jt_Task_Step_Sign_Off_API.Get_Identity(task_seq_, sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_seq);
         pre_signed_date_ := Jt_Task_Step_Sign_Off_API.Get_Sign_Off_Date(task_seq_, sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_seq);
         pre_signed_date_text_ := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
         pre_sign_off_note_ := Jt_Task_Step_Sign_Off_API.Get_Sign_Off_Note(task_seq_, sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_seq);
         IF (sign_off_rec_.signed_flag = 1) THEN
            Jt_Task_Step_Sign_Off_API.Perform_Sign_Off(task_seq_,sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_type_db, sign_off_rec_.grouping_no, sign_off_rec_.sign_off_note);
         END IF;
         IF (sign_off_rec_.revoke_sign_off_reason IS NOT NULL) THEN
            OPEN get_step_sign_off(task_seq_, sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_seq);
            FETCH get_step_sign_off INTO step_sign_off_objid_, step_sign_off_objversion_;
            CLOSE get_step_sign_off;
            
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Set_Item_Value('IDENTITY', step_identity_, attr_);
            Client_SYS.Set_Item_Value('SIGN_OFF_DATE', step_sign_off_date_, attr_);
            Jt_Task_Step_Sign_Off_API.Modify__(info_, step_sign_off_objid_, step_sign_off_objversion_, attr_, 'DO');
            
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Set_Item_Value('SIGN_OFF_NOTE', step_sign_off_note_, attr_);
            Jt_Task_Step_Sign_Off_API.Modify__(info_, step_sign_off_objid_, step_sign_off_objversion_, attr_, 'DO');
            
            -- If step sign-off is revoked by an authorized user, add an entry in the event log
            event_log_text_ := 'Sign-off by '|| pre_signed_user_ || ' as ' || sign_off_rec_.role || ' for Step ' || sign_off_rec_.order_no || ' was revoked by ' || current_user_ || '. Original Note : '|| pre_sign_off_note_ ||'.Previous Value:Signed by ' || pre_signed_user_ || ' at ' || pre_signed_date_text_ ||'.'; 
            Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => task_seq_, 
                                              event_id_ => 'SIGNOFF_REVOKED', 
                                              log_text_ => event_log_text_,
                                              note_     => sign_off_rec_.revoke_sign_off_reason,  
                                              attr_     => attr_);
      END IF;
      END LOOP;
   END LOOP;

   FOR rec_ IN get_panel(objkey_) LOOP
      FOR sign_off_rec_ IN get_step_sign_offs(rec_.objkey) LOOP
         IF (sign_off_rec_.signed_flag = 1) THEN
            Jt_Task_Step_Sign_Off_API.Perform_Sign_Off(task_seq_,sign_off_rec_.task_step_seq, sign_off_rec_.sign_off_req_type_db, sign_off_rec_.grouping_no, sign_off_rec_.sign_off_note);
         END IF;
      END LOOP;
   END LOOP;
   
   FOR rec_ IN get_tool_resource_demand(objkey_) LOOP
      IF rec_.reason_to_edit IS NULL THEN 
    
         has_execution_record_ := Jt_Execution_Instance_API.Exists(rec_.task_seq, rec_.execution_instance_seq);   

         IF (has_execution_record_ ) THEN                   
            execution_instance_seq_ := rec_.execution_instance_seq; 
            resource_activity_seq_ := Jt_Execution_Instance_API.Get_Resource_Activity_Seq(rec_.task_seq, execution_instance_seq_);
            resource_activity_alloc_seq_ := Jt_Execution_Instance_API.Get_Resource_Act_Alloc_Seq(rec_.task_seq, execution_instance_seq_);
         END IF; 

         IF NOT has_execution_record_ OR rec_.is_edit_tool = 1 THEN 
            IF rec_.is_edit_tool = 1 then
               Mm_Task_Resource_Util_API.Modify_Resource_Demand(rec_.task_seq, rec_.task_resource_seq, rec_.planned_hours, rec_.resource_group_seq);
            END IF;
	
            OPEN Get_Resource_Activity_Seq(rec_.task_seq, rec_.task_resource_seq);
            FETCH Get_Resource_Activity_Seq INTO resource_activity_seq_;
            CLOSE Get_Resource_Activity_Seq;  
            
            Jt_Execution_Instance_API.New_Modify_Execution_Instance(
               execution_instance_seq_       => execution_instance_seq_,
               resource_activity_alloc_seq_  => resource_activity_alloc_seq_,
               resource_activity_seq_        => resource_activity_seq_,
               task_resource_seq_            => rec_.task_resource_seq,
               task_seq_                     => rec_.task_seq,
               allocated_start_              => rec_.allocated_start_date,
               allocated_finish_             => rec_.allocated_finish_date, 
               allocated_hours_              => rec_.planned_hours,
               resource_seq_                 => rec_.resource_seq);
         END IF; 
                 
         OPEN is_clocking_exists(rec_.task_seq, execution_instance_seq_);
         FETCH is_clocking_exists INTO clocking_record_count_;
         CLOSE is_clocking_exists;
         
         IF clocking_record_count_ = 0 THEN  
            format_hours_ := Adcom_Util_API.Validate_Format_Hours(rec_.actual_hours);
            Start_Assignment___(
               task_seq_               => rec_.task_seq,
               execution_instance_seq_ => execution_instance_seq_,
               start_time_             => rec_.checked_out_date,
               site_                   => rec_.site);
            Finish_Assignment___(
               task_seq_               => rec_.task_seq,
               execution_instance_seq_ => execution_instance_seq_,
               actual_hours_           => format_hours_,
               finish_time_            => rec_.actual_end_date);
         END IF;   
      ELSE
         tool_equipment_before_edit_ := Av_Exe_Task_Tool_Util_API.Get_Actual_Tool_Equipment(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq));
         part_no_before_edit_        := Resource_API.Get_Resource_Id(Resource_Parent_API.Get_Parent_Seq(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq)));
         serial_no_before_edit_      := Resource_Tool_Equip_API.Get_Serial_No(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq));
         actual_hours_before_edit_   := Adcom_Util_API.Get_Text_Time(Adcom_Util_API.Get_Latest_Transaction_Qty(rec_.task_seq, rec_.execution_instance_seq));
         pre_signed_user_            := Adcom_Util_API.Get_Latest_Transaction_User(rec_.task_seq, rec_.execution_instance_seq);
         pre_signed_date_            := Adcom_Util_API.Get_Latest_Transaction_Date(rec_.task_seq, rec_.execution_instance_seq);
         pre_signed_date_text_       := TO_CHAR(pre_signed_date_, 'YYYY-MM-DD, HH24:MI') || ' UTC';
         
         OPEN get_transaction(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq);
         FETCH get_transaction INTO transaction_objid_,transaction_objversion_;
         CLOSE get_transaction;
                  
         transaction_rec_   := Jt_Task_Transaction_API.Get_Object_By_Id(transaction_objid_);
         
         OPEN  get_task_cost_line_seq(rec_.task_seq, transaction_rec_.transaction_id);
         FETCH get_task_cost_line_seq INTO task_cost_line_seq_;
         CLOSE get_task_cost_line_seq;
      
         tool_actual_hours_      := Adcom_Util_API.Validate_Format_Hours(rec_.actual_hours);
         task_pub_rec_           := Av_Exe_Task_API.Get(rec_.task_seq);
         sales_part_no_          := Maint_Resource_Sales_Part_API.Get_Def_Catalog_No(rec_.resource_group_seq, task_pub_rec_.site);
         task_cost_line_pub_rec_ := Jt_Task_Cost_Line_API.Get(task_cost_line_seq_); 
         Jt_Task_Transaction_API.Modify_Time_Transaction(info_                => info_,
                                                         objid_               => transaction_objid_,
                                                         objversion_          => transaction_objversion_,
                                                         task_seq_            => rec_.task_seq,
                                                         emp_company_         => transaction_rec_.emp_company,
                                                         employee_id_         => transaction_rec_.employee_id,
                                                         resource_group_seq_  => transaction_rec_.resource_group_seq,
                                                         resource_seq_        => rec_.resource_seq,
                                                         hours_               => tool_actual_hours_,
                                                         transaction_date_    => transaction_rec_.transaction_date,
                                                         organization_site_   => transaction_rec_.organization_site,
                                                         organization_id_     => transaction_rec_.organization_id,
                                                         time_type_id_        => transaction_rec_.time_type_id,
                                                         sales_part_          => sales_part_no_,
                                                         trans_comment_       => transaction_rec_.report_comment,
                                                         task_plan_line_seq_  => task_cost_line_pub_rec_.task_plan_line_seq);
         
         tool_equipment_after_edit_ := Av_Exe_Task_Tool_Util_API.Get_Actual_Tool_Equipment(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq));
         part_no_after_edit_        := Resource_API.Get_Resource_Id(Resource_Parent_API.Get_Parent_Seq(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq)));
         serial_no_after_edit_      := Resource_Tool_Equip_API.Get_Serial_No(Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(rec_.task_seq, rec_.task_resource_seq, rec_.execution_instance_seq));
         actual_hours_after_edit_   := Adcom_Util_API.Get_Text_Time(Adcom_Util_API.Get_Latest_Transaction_Qty(rec_.task_seq, rec_.execution_instance_seq));
         
         -- If tool is edited by an authorized user, add an entry in the event log
         event_log_text_ := 'Authorized user ' || current_user_ || ' edited tool:';        
         IF tool_equipment_before_edit_ != tool_equipment_after_edit_ THEN
            event_log_text_ := event_log_text_ || ' Tool/Equipment ID changed from '|| tool_equipment_before_edit_ || ' to ' || tool_equipment_after_edit_;
         END IF;
         IF part_no_before_edit_ != part_no_after_edit_ THEN
            event_log_text_ := event_log_text_ ||  ', Part Number changed from ' || part_no_before_edit_ || ' to ' || part_no_after_edit_ ;
         END IF;
         IF serial_no_before_edit_ != serial_no_after_edit_ THEN
            event_log_text_ := event_log_text_ ||  ', Serial Number changed from ' || serial_no_before_edit_ || ' to ' || serial_no_after_edit_;
         END IF;
         IF actual_hours_before_edit_ != actual_hours_after_edit_ THEN
            event_log_text_ := event_log_text_ ||', Actual Hours changed from ' || actual_hours_before_edit_ || ' to ' || actual_hours_after_edit_;
         END IF;
         event_log_text_ := event_log_text_ ||'.Previous Value: Tool:'|| tool_equipment_before_edit_ || ', PN:' || part_no_before_edit_ || ', S/N:'|| serial_no_before_edit_ || ', Hrs:' || actual_hours_before_edit_ ||
         '.Original entry by ' || pre_signed_user_ || ' on ' || pre_signed_date_text_ || '.';
         
         Av_Exe_Task_API.Task_Event_Log_Entry(task_seq_ => rec_.task_seq, 
                                              event_id_ => 'SIGNOFF_EDITED', 
                                              log_text_ => event_log_text_,
                                              note_     => rec_.reason_to_edit,  
                                              attr_     => attr_);
      END IF;
   END LOOP;
      
   FOR task_certify_rec IN Get_Task_Certify_Array___(parent_key_) LOOP 
      
      OPEN  get_task_actual_start;
         FETCH get_task_actual_start INTO task_actual_start_date_;
         CLOSE get_task_actual_start;
         
      IF(task_certify_rec.task_objstate = 'FINISHED') THEN
         Cancel_Assignments___(task_seq_, clock_in_vrt_rec_.execution_instance_seq);
         task_state_ := Av_Exe_Task_API.Get_Objstate(task_seq_);
         
         --Start the task if it has not been started
         IF(task_state_ = Av_Exe_Task_API.DB_RELEASED) THEN
            Client_SYS.Clear_Attr(attr_);
            Av_Exe_Task_API.Get_Id_Version_By_Task_Id(objid_, objversion_, task_seq_);
            Av_Exe_Task_API.Start_Work__(info_, objid_, objversion_, attr_, 'DO'); 
         END IF;
         
         -- Update the actual start date of the task with record work start time if the task is not previously started
         Client_SYS.Clear_Attr(attr_);         
         IF (task_actual_start_date_ IS NULL) THEN
            Client_SYS.Add_To_Attr('ACTUAL_START', record_work_start_time_, attr_);
         END IF;
                  
         Av_Exe_Task_API.Get_Id_Version_By_Task_Id(objid_, objversion_, task_seq_);
         Av_Exe_Task_API.End_Work__(info_, objid_, objversion_, attr_, 'DO'); 

         Av_Exe_Task_API.Get_Id_Version_By_Task_Id(objid_, objversion_, task_seq_);
         Av_Exe_Task_API.Modify(info_, objid_, objversion_, attr_, 'DO');

         IF (task_certify_rec.Sign_Off_Req_Type ='Independent') THEN            
            Client_SYS.Add_To_Attr('COMPLETION_NOTE',   task_certify_rec.completion_note,    attr_);
            Client_SYS.Add_To_Attr('COMPLETED_BY',      Fnd_Session_API.Get_Fnd_User(),      attr_);
         ELSE            
            Client_SYS.Add_To_Attr('APPROVAL_NUMBER',   task_certify_rec.approval_number,    attr_);
            Client_SYS.Add_To_Attr('COMPLETION_NOTE',   task_certify_rec.completion_note,    attr_);  
         END IF ;
         IF parent_rec_.task_card_option = 'RaiseAndClose' THEN
            Client_SYS.Add_To_Attr('ACTUAL_FINISH',     parent_rec_.close_fault_assign_stop_time, attr_);
         ELSE
            Client_SYS.Add_To_Attr('ACTUAL_FINISH',     task_certify_rec.actual_end_date, attr_);
         END IF;
         Av_Exe_Task_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
        
         IF (task_certify_rec.Sign_Off_Req_Type ='Independent' AND task_certify_rec.signed_by IS NOT NULL  )THEN 
           Jt_Task_Sign_Off_Req_API.Perform_Sign_Off(task_seq_,UPPER(task_certify_rec.sign_off_req_type),task_certify_rec.grouping_no,task_certify_rec.completion_note);
         ELSIF (task_certify_rec.Sign_Off_Req_Type ='Inspector' AND task_certify_rec.signed_by IS NOT NULL ) THEN
            Jt_Task_Sign_Off_Req_API.Perform_Sign_Off(task_seq_,'EXECUTOR',task_certify_rec.grouping_no,task_certify_rec.completion_note);
            Jt_Task_Sign_Off_Req_API.Perform_Sign_Off(task_seq_,UPPER(task_certify_rec.sign_off_req_type),task_certify_rec.grouping_no,task_certify_rec.completion_note);   
         END IF ;
         
         -- Start the wp if its not already started
         wp_id_ := Av_Exe_Task_API.Get_Wp_Id(objid_);
         wp_state_ := Av_Aircraft_Work_Package_API.Get_Objstate(wp_id_);
         
         IF wp_state_ IN ('Active', 'Committed') THEN
            Av_Aircraft_Work_Package_API.Start_WP(wp_id_, 'InWork');
         END IF;

         OPEN  get_wp_id;
         FETCH get_wp_id INTO wp_id_;
         CLOSE get_wp_id; 
         
         actual_start_date_ := Av_Aircraft_Work_Package_API.Get_Actual_Start_Date_Time(wp_id_);

         IF (actual_start_date_ IS NULL) THEN
            Av_Aircraft_work_Package_API.Get_Id_Version_By_Wp_Id(wp_objid_, wp_objversion_, wp_id_);

            Client_SYS.Add_To_Attr('ACTUAL_START_DATE_TIME', task_actual_start_date_,   wp_attr_);
            Av_Aircraft_work_Package_API.Modify__(wp_info_, wp_objid_, wp_objversion_, wp_attr_, 'DO');
         END IF;
         
         IF(fault_id_ IS NOT NULL) THEN
            Av_Fault_API.Change_State(fault_id_, 'Closed');
 
            Av_Fault_API.Get_Id_Version_By_Fault_Id(objid_, objversion_, fault_id_);
            
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('CLOSED_DATE',    Time_Util_API.Get_Sysdate_In_Utc,    attr_);
            Av_Fault_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
         END IF;

         -- Complete active critical items
         FOR active_critical_items_ IN get_active_critical_items LOOP
            IF active_critical_items_.critical_item_id IS NOT NULL THEN
               Av_Critical_Item_API.Complete_Critical_Item(active_critical_items_.critical_item_id);
            END IF;
         END LOOP;
         
         Jt_Task_Transaction_API.Auto_Authorize_Transactions(task_seq_);

         Av_Exe_Task_API.Get_Id_Version_By_Task_Id(objid_, objversion_, task_seq_);
         Av_Exe_Task_API.Finish__(info_, objid_, objversion_, attr_, 'DO');  
      ELSE
         Av_Exe_Task_API.Get_Id_Version_By_Task_Id(objid_, objversion_, task_seq_);
         
         Client_SYS.Clear_Attr(attr_);
              
         IF (task_actual_start_date_ IS NULL) THEN
            task_actual_start_date_ := Time_Util_API.Get_Sysdate_In_Utc;
            Client_SYS.Add_To_Attr('ACTUAL_START', task_actual_start_date_,    attr_);
         END IF;
         
         Av_Exe_Task_API.Modify__(info_, objid_, objversion_, attr_, 'DO');
         
         -- Get the current state of the task
         task_state_ := Av_Exe_Task_API.Get_Objstate(task_seq_);
         
         OPEN  get_wp_id;
         FETCH get_wp_id INTO wp_id_;
         CLOSE get_wp_id; 
         
         --Start the task when signning any of the work if its not already started
         IF(task_state_ != 'WORKSTARTED') THEN
            -- Insert task start log before starting the task
            Av_Task_Start_Log_API.Log(wp_id_, task_seq_, record_work_start_time_);            
   
            Client_SYS.Clear_Attr(attr_);
            Client_SYS.Add_To_Attr('ROWSTATE',    'WORKSTARTED',    attr_);
            Av_Exe_Task_API.Start_Work__(info_, objid_, objversion_, attr_, 'DO');
         END IF;
         
         IF (task_certify_rec.Sign_Off_Req_Type ='Inspector' AND task_certify_rec.signed_by IS NOT NULL AND task_certify_rec.signed_flag=1) THEN           
            Client_SYS.Add_To_Attr('APPROVAL_NUMBER',   task_certify_rec.approval_number,    attr_);
            Client_SYS.Add_To_Attr('COMPLETION_NOTE',   task_certify_rec.completion_note,    attr_);
            Av_Exe_Task_API.Modify__(info_, objid_, objversion_, attr_, 'DO');  
  
            Jt_Task_Sign_Off_Req_API.Perform_Sign_Off(task_seq_,'EXECUTOR',task_certify_rec.grouping_no,task_certify_rec.completion_note);
            Jt_Task_Sign_Off_Req_API.Perform_Sign_Off(task_seq_,UPPER(task_certify_rec.sign_off_req_type),task_certify_rec.grouping_no,task_certify_rec.completion_note);
            
            actual_start_date_ := Av_Aircraft_Work_Package_API.Get_Actual_Start_Date_Time(wp_id_);
            IF (actual_start_date_ IS NULL) THEN
               Av_Aircraft_Work_Package_API.Get_Id_Version_By_Wp_Id(wp_objid_, wp_objversion_, wp_id_);
       
               Client_SYS.Add_To_Attr('ACTUAL_START_DATE_TIME', task_actual_start_date_,   wp_attr_);
               Av_Aircraft_Work_Package_API.Modify__(wp_info_, wp_objid_, wp_objversion_, wp_attr_, 'DO');
            END IF;
         END IF ;
         
         wp_state_ := Av_Aircraft_Work_Package_API.Get_Objstate(wp_id_);
 
         IF wp_state_ IN ('Active', 'Committed') THEN
            Av_Aircraft_Work_Package_API.Start_WP(wp_id_, 'InWork');
         END IF;

      END IF;
   END LOOP;  
END Sign___;

PROCEDURE Complete_Task___ (
   objkey_          IN VARCHAR2,
   approval_number_ IN VARCHAR2,
   completion_note_ IN VARCHAR2,
   task_seq_        IN NUMBER)
IS   
   task_cert_key_       Task_Certify_Virtual_Key; 
   task_cert_old_rec_   Task_Certify_Virtual_Rec;
   task_cert_new_rec_   Task_Certify_Virtual_Rec;
   current_user_        VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User(); 
   count_               NUMBER := 0;
   
   CURSOR get_sign_off_req_count_ IS
      SELECT COUNT(*)
      FROM Jt_Task_Sign_Off_Req_Tab
      WHERE task_seq = task_seq_ 
      AND (Sign_Off_Req_Type = 'INSPECTOR' or Sign_Off_Req_Type = 'INDEPENDENT') 
      AND Sign_Off_Connection = 'TASK'; 
BEGIN
   task_cert_key_.Objkey   := objkey_;
   task_cert_old_rec_      := Get_Record___(task_cert_key_);
   task_cert_new_rec_      := task_cert_old_rec_; 
   
   OPEN get_sign_off_req_count_;
   FETCH get_sign_off_req_count_ INTO count_;
   CLOSE get_sign_off_req_count_;
   
   IF (task_cert_old_rec_.Sign_Off_Req_Type ='Inspector' AND count_ = 2 )THEN 
      task_cert_new_rec_.is_final_sign_off  := FALSE; 
   ELSE
      task_cert_new_rec_.is_final_sign_off := TRUE;
      task_cert_new_rec_.task_objstate     :='FINISHED';
   END IF;
   
   task_cert_new_rec_.approval_number           := approval_number_;
   task_cert_new_rec_.completion_note           := completion_note_;
   task_cert_new_rec_.actual_end_date           := Time_Util_API.Get_Sysdate_In_Utc;
   task_cert_new_rec_.signed_by                 := current_user_;
   task_cert_new_rec_.identity_name             := current_user_;  
   task_cert_new_rec_.sign_off_status           := 'Signed';
   task_cert_new_rec_.task_certification_enable := TRUE;
   task_cert_new_rec_.signed_flag               := TRUE;
   
   CRUD_Update___(task_cert_old_rec_, task_cert_new_rec_); 
   CheckAndSetParentButtons___(task_cert_new_rec_.parent_objkey, TRUE); 
END Complete_Task___;

PROCEDURE Check_Part_Is_Allowed___ (
   task_seq_                IN NUMBER,
   installed_part_no_id_    IN NUMBER,
   part_group_id_           IN NUMBER,
   config_slot_position_id_ IN NUMBER)
IS
   part_status_            VARCHAR2(5);
   is_approved_            VARCHAR2(6);
   aircraft_id_            NUMBER;
   ac_applicability_       VARCHAR2(8);
   part_group_app_range_   VARCHAR2(4000);
   part_app_range_         VARCHAR2(4000);
   is_applicable_          NUMBER;
   rem_intr_chng_order_    NUMBER;
   new_intr_chng_order_    NUMBER;
BEGIN
   
   part_status_ := Av_Part_Number_API.Get_Part_Status(installed_part_no_id_);
   IF(part_status_ != 'Actv') THEN 
      Error_SYS.Record_General(lu_name_, 'ERRPRTSTATUS: Cannot install part with :P1 status.', UPPER(part_status_));
   END IF;
   
   is_approved_ := Av_Part_Group_Part_API.Get_Is_Approved_By_Part_No(installed_part_no_id_,part_group_id_);
	
   IF(is_approved_ = 'FALSE') THEN 
      Error_SYS.Record_General(lu_name_, 'ERRPRTAPPR: Cannot install part which is not approved.');
   END IF;
   
   part_group_app_range_ := Av_Part_Group_API.Get_Applicability_Range(part_group_id_);
   
   aircraft_id_      := Av_Exe_Task_API.Get_Aircraft_Id(task_seq_);
   ac_applicability_ := Aircraft_API.Get_Applicability_Code(aircraft_id_);
   
   is_applicable_ := Adcom_Util_API.Get_Applicability(part_group_app_range_,ac_applicability_);
   
   IF(is_applicable_ =1) THEN 
      part_app_range_ := Av_Part_Group_Part_API.Get_Applicability_By_Part_No(installed_part_no_id_,part_group_id_);
      is_applicable_ := Adcom_Util_API.Get_Applicability(part_app_range_,ac_applicability_);
      IF (is_applicable_ =0) THEN 
         Error_SYS.Record_General(lu_name_, 'ERRPRTAPPL: Cannot install part. Part is not applicable to the aircraft.');
      END IF;
   ELSE 
      Error_SYS.Record_General(lu_name_, 'ERRPRTGRPAPPL: Cannot install part. Part Group is not applicable to the aircraft.');
   END IF;
   
   rem_intr_chng_order_ := Av_Exe_Task_Part_API.Get_Removed_Part_Int_Order(task_seq_, config_slot_position_id_, part_group_id_);
   
   IF(rem_intr_chng_order_ != 0) THEN
      new_intr_chng_order_ := Av_Part_Group_Part_API.Get_Inter_Chg_Ord_By_Part_No(installed_part_no_id_,part_group_id_);
      
      IF(rem_intr_chng_order_ > new_intr_chng_order_ ) THEN 
         Error_SYS.Record_General(lu_name_, 'ERRPRTINTORDER: Cannot install part. Interchangeability order of the installing part should be greater than or equal to the interchangeability order of the removing part.');
      END IF;  
   END IF;
   
END Check_Part_Is_Allowed___;

PROCEDURE Check_Part_Incompatibility___ (
   task_seq_             IN NUMBER,
   installed_part_no_id_ IN NUMBER,
   part_group_id_        IN NUMBER)
IS
   aircraft_id_ NUMBER;
   part_count_  NUMBER;
   
   CURSOR check_incompatibility IS
   SELECT COUNT(aircraft_id)
   FROM av_non_installable_part_tab
   WHERE aircraft_id = aircraft_id_
   AND   part_group_id = part_group_id_
   AND   part_number_id = installed_part_no_id_;
BEGIN
	aircraft_id_ := Av_Exe_Task_API.Get_Aircraft_Id(task_seq_);
   
   OPEN  check_incompatibility;
   FETCH check_incompatibility INTO part_count_;
   CLOSE check_incompatibility;
   
   IF part_count_ > 0 THEN 
      Error_SYS.Record_General(lu_name_, 'ERRINVALID: The part you are attempting to install is incompatible with a task or currently installed item. Please confirm that the part number of the inventory is correct');
   END IF;
END Check_Part_Incompatibility___;


FUNCTION Get_E_Sig_Permission___ (
   user_id_ IN VARCHAR2) RETURN VARCHAR2
IS
   permission_ av_e_sig_user_permission_tab.permission%TYPE;
BEGIN
   permission_ := Av_E_Sig_User_Permission_API.Get_Permission(user_id_);
   RETURN permission_;
END Get_E_Sig_Permission___;

FUNCTION Get_Esig_File_Name___ (
   aircraft_id_ IN NUMBER,
   task_seq_    IN NUMBER,
   fault_id_    IN NUMBER) RETURN VARCHAR2
IS
	file_name_ VARCHAR2(100);
   record_id_ VARCHAR2(100);
   reg_code_  VARCHAR2(10);
   signed_user_ VARCHAR2(40);
   
   CURSOR get_aircraft_reg_code IS
      SELECT reg_code
      FROM aircraft_tab
      WHERE aircraft_id = aircraft_id_;
   
BEGIN
   OPEN  get_aircraft_reg_code;
   FETCH get_aircraft_reg_code INTO reg_code_;
   CLOSE get_aircraft_reg_code;
   
   signed_user_ := Fnd_Session_API.Get_Fnd_User();
   record_id_   := Adcom_Util_API.Record_Id_For_Fault_And_Task(fault_id_, task_seq_);
   
   IF (reg_code_ IS NOT NULL AND record_id_ IS NOT NULL) THEN 
      file_name_ := reg_code_ || '_' || record_id_ || '_' || signed_user_;
      RETURN file_name_;
   END IF;
END Get_Esig_File_Name___;

FUNCTION Show_Missing_Component_Warning___ (
   task_seq_       IN NUMBER,
   aircraft_wp_id_ IN NUMBER) RETURN VARCHAR2
IS 
   rem_config_slot_position_id_  NUMBER;
   rem_assy_conf_slot_pos_id_    NUMBER;
   rem_part_count_in_task_       NUMBER;
   inst_part_count_in_task_      NUMBER;
   rem_part_count_in_wp_         NUMBER;
   inst_part_count_in_wp_        NUMBER;
   rem_config_slot_code_         av_config_slot_position_tab.config_slot_code%TYPE;
   index_                        NUMBER;
   item_exist_                   BOOLEAN;
   war_config_slots_             VARCHAR2(3000):= NULL;
   message_                      VARCHAR2(3000):= NULL;
   
   TYPE conf_slot_code_array  IS TABLE OF VARCHAR2(50) INDEX BY VARCHAR2(50);
   rem_war_conf_slot_code_array_ conf_slot_code_array;
   
   CURSOR get_signed_removed_part IS
      SELECT * 
      FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT rpv 
      INNER JOIN av_part_group_part_tab pgp ON
         pgp.part_no_id = rpv.removal_part_no_id  
         AND 
         pgp.part_group_id = rpv.removal_part_group_id 
      INNER JOIN av_part_group_tab pg ON
         pg.part_group_id = pgp.part_group_id 
      LEFT JOIN av_config_slot_tab cs ON 
         cs.config_slot_code = pg.config_slot_code 
         AND 
         cs.assembly_type_code = pg.assembly_type_code 
      WHERE rpv.task_seq = task_seq_ 
         AND rpv.removed_user IS NOT NULL 
         AND cs.is_mandatory = 'TRUE' 
         AND pg.inventory_class_code IN ('ASSY', 'TRK');
   
   CURSOR get_task_in_wp IS
    SELECT aet.task_seq  
    FROM av_exe_task aet
    WHERE  aet.aircraft_wp_id= aircraft_wp_id_;
   
   CURSOR get_task_part_in_wp(task_seq_in_wp_ IN NUMBER, conf_slot_pos_id_  IN NUMBER, assy_conf_slot_pos_id_ IN NUMBER) IS
    SELECT *
    FROM av_exe_task_part_tab atp
    WHERE atp.task_seq=task_seq_in_wp_ 
          AND atp.config_slot_position_id=conf_slot_pos_id_ 
          AND((atp.assmbly_config_slot_pos_id IS NOT NULL AND atp.assmbly_config_slot_pos_id=assy_conf_slot_pos_id_)
          OR(atp.assmbly_config_slot_pos_id IS NULL AND assy_conf_slot_pos_id_ IS NULL ))
          AND (atp.removed_user IS NOT NULL OR atp.installed_part_no_id IS NOT NULL);
   
   CURSOR get_signed_installed_task_part IS
     SELECT * 
     FROM ${PROJECTION}_INSTALLED_PART_LINE_VIRTUAL_VRT 
     WHERE task_seq=task_seq_ 
         AND installed_part_no_id IS NOT NULL 
         AND part_type IN('TRK','ASSY');   
   
   CURSOR get_signed_removed_task_part IS
     SELECT * 
     FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT 
     WHERE task_seq=task_seq_ 
         AND removed_user IS NOT NULL 
         AND part_type IN('TRK','ASSY');  
   
BEGIN
   rem_part_count_in_task_       := 0;
   inst_part_count_in_task_      := 0;
   rem_part_count_in_wp_         := 0;
   inst_part_count_in_wp_        := 0;
   rem_war_conf_slot_code_array_ := conf_slot_code_array();
   index_                        := 1;
   
   -- fetch all the signed part removals of the task by checking isMandatory=true, inventory code =(trk or assy), removed_user not null and config slot code
   FOR rem_signed_part_rec_ IN get_signed_removed_part LOOP
      
      item_exist_                   :=FALSE;
      rem_config_slot_position_id_  := rem_signed_part_rec_.config_slot_position_id;
      rem_config_slot_code_         := rem_signed_part_rec_.config_slot_code;
      rem_assy_conf_slot_pos_id_    := rem_signed_part_rec_.assembly_config_slot_position_id;
      
      --check removed part count in the part line virtual by comparing same config slot position and same assembly config slot position inside the task.
      FOR rem_signed_part_task_rec_ IN get_signed_removed_task_part LOOP
         IF rem_signed_part_task_rec_.config_slot_position_id=rem_config_slot_position_id_ 
              AND((rem_signed_part_task_rec_.assembly_config_slot_position_id IS NOT NULL AND rem_signed_part_task_rec_.assembly_config_slot_position_id =rem_assy_conf_slot_pos_id_)
               OR(rem_signed_part_task_rec_.assembly_config_slot_position_id IS NULL AND rem_assy_conf_slot_pos_id_ IS NULL ))
              AND rem_signed_part_task_rec_.removed_user IS NOT NULL  THEN
            rem_part_count_in_task_ := rem_part_count_in_task_ +1; 
         END IF;
      END LOOP;
      
      --check installated part count in the part line virtual by comparing same config slot position and same assembly config slot position inside the task.
      FOR ins_signed_part_task_rec_ IN get_signed_installed_task_part LOOP
          IF ins_signed_part_task_rec_.config_slot_position_id=rem_config_slot_position_id_
              AND((ins_signed_part_task_rec_ .assembly_config_slot_position_id IS NOT NULL AND ins_signed_part_task_rec_ .assembly_config_slot_position_id =rem_assy_conf_slot_pos_id_)
               OR(ins_signed_part_task_rec_ .assembly_config_slot_position_id IS NULL AND rem_assy_conf_slot_pos_id_ IS NULL ))
              AND ins_signed_part_task_rec_.installed_part_no_id  IS NOT NULL THEN
            inst_part_count_in_task_ := inst_part_count_in_task_ +1; 
         END IF;
      END LOOP;
      
     --if no matching installations are found inside the task then find them inside the work package
      IF rem_part_count_in_task_ >  inst_part_count_in_task_ THEN
         FOR task_in_wp_rec_ IN get_task_in_wp LOOP
            IF task_in_wp_rec_.task_seq IS NOT NULL THEN
               
               FOR get_task_part_in_wp_rec IN get_task_part_in_wp(task_in_wp_rec_.task_seq,rem_config_slot_position_id_,rem_assy_conf_slot_pos_id_) LOOP
                  IF get_task_part_in_wp_rec.task_seq IS NOT NULL AND get_task_part_in_wp_rec.installed_part_no_id IS NOT NULL AND get_task_part_in_wp_rec.task_seq != task_seq_ THEN
                     inst_part_count_in_wp_ := inst_part_count_in_wp_+1;
                  END IF;
                  
                  IF get_task_part_in_wp_rec.task_seq IS NOT NULL AND get_task_part_in_wp_rec.removed_user IS NOT NULL AND get_task_part_in_wp_rec.task_seq != task_seq_ THEN
                     rem_part_count_in_wp_:= rem_part_count_in_wp_+1;
                  END IF;
               END LOOP;  
            END IF;
         END LOOP;
         
          --if no matching installations are found inside the work package then add config slot value to rem_war_conf_slot_code_array_
         IF ((rem_part_count_in_task_ - inst_part_count_in_task_)> inst_part_count_in_wp_) OR (rem_part_count_in_wp_ = inst_part_count_in_wp_) OR (rem_part_count_in_wp_ > inst_part_count_in_wp_) THEN
           
            IF rem_war_conf_slot_code_array_ .COUNT > 0 THEN
               FOR key IN 1..rem_war_conf_slot_code_array_ .COUNT LOOP
                  IF rem_war_conf_slot_code_array_ (key) =  rem_config_slot_code_ THEN
                     item_exist_ := TRUE;
                     --if conf_slot found in the loop, then exit the code
                     EXIT; 
                  END IF;
               END LOOP;
               
               --if conf_slot not found in the loop, then exist the code
               IF NOT item_exist_ THEN
                  rem_war_conf_slot_code_array_ (index_) :=  rem_config_slot_code_;
                  index_ := index_ + 1;            
               END IF;
            ELSE
               rem_war_conf_slot_code_array_(index_) := rem_config_slot_code_;
               index_ := index_ + 1;  
            END IF;
         END IF; 
      END IF;
   END LOOP;
   
   IF rem_war_conf_slot_code_array_.COUNT > 0 THEN
      FOR i IN 1..rem_war_conf_slot_code_array_.COUNT LOOP
          war_config_slots_ :=  war_config_slots_|| rem_war_conf_slot_code_array_(i);
         --adding comma (,) if not the last element
         IF i < rem_war_conf_slot_code_array_.COUNT THEN
             war_config_slots_ :=  war_config_slots_|| ', ';         
         END IF;
      END LOOP;
   END IF;
   
   IF  war_config_slots_ IS NOT NULL THEN
      message_ := war_config_slots_;
   END IF;
   
   RETURN message_;
END Show_Missing_Component_Warning___;

@IgnoreUnitTest TrivialFunction
