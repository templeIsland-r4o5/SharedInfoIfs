layer Core;

@Override
PROCEDURE CRUD_Create___(
   rec_ IN Record_Work_Virtual_Rec )
IS
   step_rec_               Step_Virtual_Rec;
   task_action_rec_        Task_Action_Line_Virtual_Rec;
   measurement_rec_        Measurement_Line_Virtual_Rec;
   tool_rec_               Tool_Line_Virtual_Rec;
   resource_tool_rec_      Resource_Tool_Line_Virtual_Rec;
   installed_part_rec_     Installed_Part_Line_Virtual_Rec;
   removed_part_rec_       Removed_Part_Line_Virtual_Rec;
   task_certify_rec_       Task_Certify_Virtual_Rec;
   rec_dup_                Record_Work_Virtual_Rec;
   parent_key_             Record_Work_Virtual_Key;
   parent_rec_             Record_Work_Virtual_Rec;
   parent_new_rec_         Record_Work_Virtual_Rec;   
   clock_in_rec_           Clock_In_Virtual_Rec;
   rec_count_              NUMBER;
   use_maintenix_tools_    BOOLEAN;
   completed_date_         DATE;
   completed_by_           VARCHAR2(40);
   completion_note_        VARCHAR2(2000);
   approval_number_        VARCHAR2(64);
   current_user_           VARCHAR2(30);
   old_rec_                Clock_In_Virtual_Rec;
   new_rec_                Clock_In_Virtual_Rec;
   objkey_                 VARCHAR2(1000);
   duration_               NUMBER;
   clock_in_key_           Clock_In_Virtual_Key;
   panel_rec_              Panel_Virtual_Rec;
   task_class_cd_          VARCHAR2(20);
   tool_demand_rec_        Tool_Resource_Demand_Virtual_Rec;
   signed_user_            VARCHAR2(100);
   checked_out_date_       DATE;

   CURSOR get_task_step_list_ IS
      SELECT task_seq, task_step_seq, order_no, objstate, description, instructions 
      FROM Jt_Task_Step
      WHERE task_seq = rec_.task_seq
      AND NVL(object_connection_lu_name, 'NULL') != 'Panel'
      ORDER BY order_no ASC;
   
   CURSOR get_task_action_list_ IS
      SELECT *
      FROM av_exe_task_action
      WHERE task_seq = rec_.task_seq;
   
   CURSOR get_task_measurement_list_ IS
      SELECT task_measurement.*,measurment_type.measurement_category_code
      FROM av_exe_task_measurement task_measurement
      INNER JOIN av_measurement_type measurment_type
      ON task_measurement.measurement_type_code = measurment_type.measurement_type_code
      WHERE task_seq = rec_.task_seq;
   
   CURSOR get_task_tool_list_ IS
      SELECT *
      FROM av_exe_task_tool
      WHERE task_seq = rec_.task_seq;
   
   CURSOR get_resource_tool_equipment_list_ IS
      SELECT *
      FROM av_resource_tool_equipment_ext
      WHERE source_ref = rec_.task_seq
      AND   source_ref_type_db = 'TASK';
   
   CURSOR get_task_inst_part_list_ IS
      SELECT *
      FROM av_exe_task_part
      WHERE task_seq = rec_.task_seq
      AND installed_quantity IS NOT NULL;
   
   CURSOR get_task_rmvd_part_list_ IS
      SELECT *
      FROM av_exe_task_part
      WHERE task_seq = rec_.task_seq
      AND removed_quantity IS NOT NULL;
   
   CURSOR get_task_measurement_count_ IS
      SELECT COUNT(*)
      FROM av_exe_task_measurement
      WHERE task_seq = rec_.task_seq;
   
   CURSOR get_task_tool_count_ IS
      SELECT COUNT(*)
      FROM av_exe_task_tool
      WHERE task_seq = rec_.task_seq;
   
   CURSOR get_resource_tool_equipment_count_ IS
      SELECT COUNT(*)
      FROM av_resource_tool_equipment
      WHERE source_ref = rec_.task_seq
      AND   source_ref_type_db = 'TASK';
   
   CURSOR get_task_inst_part_count_ IS
      SELECT COUNT(*)
      FROM av_exe_task_part
      WHERE task_seq = rec_.task_seq
      AND installed_quantity IS NOT NULL;
   
   CURSOR get_task_rmvd_part_count_ IS
      SELECT COUNT(*)
      FROM av_exe_task_part
      WHERE task_seq = rec_.task_seq
      AND removed_quantity IS NOT NULL;
      
   CURSOR get_tool_demand_count_ IS
      SELECT count(task_seq)
      FROM jt_task_resource_demand_av_uiv
      WHERE task_seq = rec_.task_seq
      AND demand_type = 'Tool/Equipment';
      
   CURSOR get_task_sign_off_ IS
      SELECT *
      FROM jt_task_sign_off_req
      WHERE task_seq = rec_.task_seq 
      AND sign_off_req_type <> 'Executor'
      AND sign_off_connection = 'Task';
      
   CURSOR get_panel_req_list(task_class_cd_ IN VARCHAR2) IS
      SELECT
         stp.task_seq, stp.task_step_seq, stp.objstate, ap.panel_code,
         ap.panel_description, pi.panel_instruction
      FROM jt_task_step stp
      INNER JOIN Aircraft_Panel_Info ap
         ON stp.object_connection_rowkey = ap.objkey
      INNER JOIN panel_instructions pi
         ON pi.ac_panel_seq = ap.ac_panel_seq
      WHERE stp.task_seq = rec_.task_seq
      AND pi.task_class_cd = task_class_cd_
      AND stp.object_connection_lu_name_db = 'AircraftPanel';
      
   CURSOR get_tool_demand_list_ IS      
      SELECT 
         tool_demand.task_seq,
         tool_demand.task_resource_seq,
         tool_demand.resource_group_seq,
         tool_demand.execution_instance_seq,
         tool_demand.assigned_resource_seq,
         tool_demand.serial_no AS serial_no,
         tool_demand.resource_demand AS tool_group,
         tool_demand.assigned_resource_id AS assigned_resource_id,
         tool_eqp.checked_out_date AS checked_out_date,
         tool_demand.allocated_start AS allocated_start,
         tool_demand.allocated_finish AS allocated_finish,
         tool_demand.planned_hours AS planned_hours,
         tool_demand.rowstate AS rowstate
      FROM jt_task_resource_demand_av_uiv tool_demand
      LEFT JOIN (SELECT h.resource_seq, h.checked_out_date
                 FROM tool_equip_check_out_hist_tab h
                 WHERE h.checked_out_date = (SELECT MAX(h2.checked_out_date)
                                             FROM tool_equip_check_out_hist_tab h2
                                             WHERE h2.resource_seq = h.resource_seq)
                ) tool_eqp
      ON tool_eqp.resource_seq = tool_demand.assigned_resource_seq
      WHERE tool_demand.task_seq = rec_.task_seq
      AND tool_demand.demand_type = 'Tool/Equipment';
      
BEGIN 
   rec_dup_ := rec_;
   rec_dup_.current_user := Fnd_Session_API.Get_Fnd_User();
   OPEN get_task_measurement_count_;
   FETCH get_task_measurement_count_ INTO rec_count_;
   IF rec_count_ > 0 THEN
      rec_dup_.measurement_enable := TRUE;
   ELSE 
      rec_dup_.measurement_enable := FALSE;
   END IF;
   CLOSE get_task_measurement_count_;
   
   use_maintenix_tools_ := Adcom_Util_API.Maintenix_Tools_Used() = 'TRUE';

   OPEN get_tool_demand_count_;
   FETCH get_tool_demand_count_ INTO rec_count_;
   IF rec_count_ > 0 THEN
      rec_dup_.resource_tool_enable    := TRUE;
   ELSE
      rec_dup_.resource_tool_enable    := FALSE;
   END IF;
   CLOSE get_tool_demand_count_;
   rec_dup_.tool_enable := FALSE;
   
   OPEN get_task_inst_part_count_;
   FETCH get_task_inst_part_count_ INTO rec_count_;
   IF rec_count_ > 0 THEN
      rec_dup_.installeded_part_enable := TRUE;
   ELSE 
      rec_dup_.installeded_part_enable := FALSE;
   END IF;
   CLOSE get_task_inst_part_count_;
   
   OPEN get_task_rmvd_part_count_;
   FETCH get_task_rmvd_part_count_ INTO rec_count_;
   IF rec_count_ > 0 THEN
      rec_dup_.removed_part_enable  := TRUE;
   ELSE 
      rec_dup_.removed_part_enable  := FALSE;
   END IF;
   CLOSE get_task_rmvd_part_count_;
      
   super(rec_dup_);
   
   --Populating task step lines
   FOR task_step_rec_ IN get_task_step_list_ LOOP
      step_rec_.objkey            := sys_guid();
      step_rec_.parent_objkey     := rec_dup_.objkey;
      step_rec_.task_seq          := task_step_rec_.task_seq;
      step_rec_.task_step_id      := task_step_rec_.task_step_seq;      
      step_rec_.step_ord          := task_step_rec_.order_no;
      step_rec_.objstate          := task_step_rec_.objstate;
      step_rec_.step_status       := task_step_rec_.objstate;
      step_rec_.instructions      := task_step_rec_.instructions;  
      step_rec_.state_change_flag := FALSE;
      step_rec_.task_resource_seq := rec_dup_.task_resource_seq;
      step_rec_.selection         := rec_.selection;
      CRUD_Create___(step_rec_);
   END LOOP;
   
   --Populating panel requirement lines
   IF rec_.class_code = Av_Exe_Task_API.TASK_CLASS_MPC  AND rec_.subclass_code = Av_Exe_Task_API.TASK_SUBCLASS_MPCOPEN THEN
      task_class_cd_ := 'OPENPANEL';
   ELSIF rec_.class_code = Av_Exe_Task_API.TASK_CLASS_MPC  AND rec_.subclass_code = Av_Exe_Task_API.TASK_SUBCLASS_MPCCLOSE THEN
      task_class_cd_ := 'CLOSEPANEL';
   ELSE
      task_class_cd_ := NULL;
   END IF;
      
   FOR panel_req_rec_ IN get_panel_req_list(task_class_cd_) LOOP
      panel_rec_.objkey             := sys_guid();
      panel_rec_.parent_objkey      := rec_dup_.objkey;
      panel_rec_.panel_code         := panel_req_rec_.panel_code;
      panel_rec_.panel_description  := panel_req_rec_.panel_description;
      panel_rec_.panel_instruction  := panel_req_rec_.panel_instruction;
      panel_rec_.task_seq           := panel_req_rec_.task_seq;
      panel_rec_.task_step_id       := panel_req_rec_.task_step_seq;
      panel_rec_.step_status        := panel_req_rec_.objstate;
      panel_rec_.task_resource_seq  := rec_dup_.task_resource_seq;
      panel_rec_.selection          := rec_.selection;
      CRUD_Create___(panel_rec_);
   END LOOP;
   
      
   --Populating task action lines
   FOR task_action_ IN get_task_action_list_ LOOP
      task_action_rec_.objkey          := sys_guid();
      task_action_rec_.parent_objkey   := rec_dup_.objkey;
      task_action_rec_.task_seq        := task_action_.task_seq;
      task_action_rec_.task_action_id  := task_action_.task_action_id;
      task_action_rec_.action_user     := task_action_.action_user;
      task_action_rec_.action_date     := task_action_.action_date;
      task_action_rec_.action_desc     := task_action_.action_desc;
      task_action_rec_.action_type     := task_action_.action_type;
      task_action_rec_.action_ord      := task_action_.action_ord;
      task_action_rec_.signed_flag     := FALSE;
      CRUD_Create___(task_action_rec_);
   END LOOP;  
   
   --Populating task measurements
   FOR task_measurement_ IN get_task_measurement_list_ LOOP
      measurement_rec_.objkey                := sys_guid(); 
      measurement_rec_.parent_objkey         := rec_dup_.objkey;
      measurement_rec_.task_seq              := task_measurement_.task_seq;
      measurement_rec_.measurement_id        := task_measurement_.measurement_id;
      measurement_rec_.measurement_type_code := task_measurement_.measurement_type_code;
      measurement_rec_.measurement_value     := Av_Exe_Task_Measurement_API.Get_Measurement_Value(task_measurement_.measurement_id);
      measurement_rec_.measurement_qty       := task_measurement_.measurement_qty;
      measurement_rec_.measurement_date_time := task_measurement_.measurement_date_time;
      measurement_rec_.measurement_text      := task_measurement_.measurement_text;

      IF task_measurement_.measurement_boolean IS NULL THEN
         measurement_rec_.measurement_boolean   := NULL;
      ELSIF task_measurement_.measurement_boolean = 'True' OR task_measurement_.measurement_boolean = 'TRUE' THEN
         measurement_rec_.measurement_boolean   := TRUE;
      ELSIF task_measurement_.measurement_boolean = 'False' OR task_measurement_.measurement_boolean = 'FALSE' THEN
         measurement_rec_.measurement_boolean   := FALSE; 
      END IF;      
      measurement_rec_.meas_type_value_code  := task_measurement_.meas_type_value_code;
      IF rec_dup_.task_card_option = 'RaiseAndClose' THEN
         measurement_rec_.measured_user         := Fnd_Session_API.Get_Fnd_User();
         measurement_rec_.measured_date         := Time_Util_API.Get_Sysdate_In_Utc;
      ELSE
         measurement_rec_.measured_user         := task_measurement_.measured_user;
         measurement_rec_.measured_date         := task_measurement_.measured_date;
      END IF;
      measurement_rec_.measurement_category  := task_measurement_.measurement_category_code;

      IF rec_dup_.task_card_option = 'RaiseAndClose' THEN
         measurement_rec_.signed_flag := TRUE;    
      ELSIF (task_measurement_.measured_user IS NULL) THEN
         measurement_rec_.signed_flag := FALSE;  
      ELSE
         measurement_rec_.signed_flag := NULL;  
      END IF;

      CRUD_Create___(measurement_rec_);
   END LOOP;
   
   --Populating task tool lines
   IF use_maintenix_tools_ THEN 
      FOR task_tool_ IN get_task_tool_list_ LOOP
         tool_rec_.objkey                    := sys_guid(); 
         tool_rec_.parent_objkey             := rec_dup_.objkey;
         tool_rec_.task_seq                  := task_tool_.task_seq;
         tool_rec_.task_tool_id              := task_tool_.task_tool_id;
         tool_rec_.tool_specification_code   := task_tool_.tool_specification_code;
         tool_rec_.part_no_id                := task_tool_.part_no_id;
         tool_rec_.serial_no                 := task_tool_.serial_no;
         tool_rec_.assigned_user             := task_tool_.assigned_user;
         tool_rec_.assigned_date_tiime       := task_tool_.assigned_date_tiime;
         tool_rec_.actual_duration           := Adcom_Util_API.Get_Text_Time(task_tool_.actual_duration);
         IF (task_tool_.assigned_user IS NULL) THEN
            tool_rec_.is_signed := FALSE;  
         ELSE   
            tool_rec_.is_signed := NULL;   
         END IF;
         CRUD_Create___(tool_rec_);
      END LOOP;
   ELSE   
      FOR task_tool_ IN get_resource_tool_equipment_list_ LOOP
         resource_tool_rec_.objkey                    := sys_guid(); 
         resource_tool_rec_.parent_objkey             := rec_dup_.objkey;
         resource_tool_rec_.task_seq                  := task_tool_.source_ref;
         resource_tool_rec_.tool_id                   := task_tool_.tool_id;
         resource_tool_rec_.resource_id               := task_tool_.resource_id;
         resource_tool_rec_.resource_group_id         := task_tool_.resource_group_id;
         resource_tool_rec_.resource_seq              := task_tool_.resource_seq;
         resource_tool_rec_.resource_group_seq        := task_tool_.resource_group_seq;
         resource_tool_rec_.part_no                   := task_tool_.part_no;
         resource_tool_rec_.serial_no                 := task_tool_.serial_no;
         resource_tool_rec_.assigned_user             := task_tool_.assigned_user;
         IF (task_tool_.assigned_user IS NULL) THEN
            resource_tool_rec_.is_signed := FALSE;  
         ELSE   
            resource_tool_rec_.is_signed := NULL;   
         END IF;
         resource_tool_rec_.assigned_date_time        := task_tool_.assigned_date_time;
         resource_tool_rec_.sched_duration            := Adcom_Util_API.Get_Text_Time(task_tool_.sched_duration);
         resource_tool_rec_.actual_duration           := Adcom_Util_API.Get_Text_Time(task_tool_.actual_duration);
         CRUD_Create___(resource_tool_rec_);
      END LOOP;
   END IF;
   
   --Populating tool resource demand lines
   FOR tool_resource_ IN get_tool_demand_list_ LOOP
      tool_demand_rec_.objkey                    := sys_guid(); 
      tool_demand_rec_.parent_objkey             := rec_dup_.objkey;
      tool_demand_rec_.task_seq                  := tool_resource_.task_seq;
      tool_demand_rec_.task_resource_seq         := tool_resource_.task_resource_seq;
      tool_demand_rec_.resource_group_seq        := tool_resource_.resource_group_seq;
      tool_demand_rec_.execution_instance_seq    := tool_resource_.execution_instance_seq;
      tool_demand_rec_.tool_group                := tool_resource_.tool_group;
      tool_demand_rec_.tool_part_id              := Resource_API.Get_Resource_Id(Resource_Parent_API.Get_Parent_Seq(tool_resource_.assigned_resource_seq));
      tool_demand_rec_.tool_part_description     := Resource_API.Get_Description(Resource_Parent_API.Get_Parent_Seq(tool_resource_.assigned_resource_seq));
      tool_demand_rec_.site                      := Work_Task_API.Get_Site(tool_resource_.task_seq);
      tool_demand_rec_.resource_parent_id        := Resource_API.Get_Resource_Id(tool_resource_.resource_group_seq);
      tool_demand_rec_.resource_id               := tool_resource_.assigned_resource_id;
      tool_demand_rec_.allocated_start_date      := tool_resource_.allocated_start;
      tool_demand_rec_.allocated_finish_date     := tool_resource_.allocated_finish;
      tool_demand_rec_.planned_hours             := tool_resource_.planned_hours; 
      checked_out_date_                          := Av_Exe_Task_Tool_Util_API.Get_Latest_Check_Out_Date(tool_resource_.assigned_resource_seq);
      IF (checked_out_date_ IS NOT NULL AND tool_resource_.rowstate != 'COMPLETED') THEN
        tool_demand_rec_.checked_out_date       := checked_out_date_;   
      ELSE
        tool_demand_rec_.checked_out_date       := tool_resource_.checked_out_date;
      END IF;
      tool_demand_rec_.signed_user               := Adcom_Util_API.Get_Latest_Transaction_User(tool_resource_.task_seq,tool_resource_.execution_instance_seq);
      tool_demand_rec_.signed_date               := Adcom_Util_API.Get_Latest_Transaction_Date(tool_resource_.task_seq,tool_resource_.execution_instance_seq);
      IF rec_dup_.assignment_status = 'ASSIGNED' THEN
         tool_demand_rec_.assignment_start_date  := Get_Timestamp___(rec_dup_.site);
      ELSE
         tool_demand_rec_.assignment_start_date  := rec_dup_.assignment_start;
      END IF;
      tool_demand_rec_.signed_flag               := FALSE;
      IF tool_resource_.rowstate = 'COMPLETED' THEN
         tool_demand_rec_.resource_seq           := Av_Exe_Task_Tool_Util_API.Get_Actual_Resource_Seq(tool_resource_.task_seq, tool_resource_.task_resource_seq,tool_resource_.execution_instance_seq);
         tool_demand_rec_.serial_no              := Resource_Tool_Equip_API.Get_Serial_No(tool_demand_rec_.resource_seq);
         tool_demand_rec_.actual_hours           := Adcom_Util_API.Get_Text_Time(Adcom_Util_API.Get_Latest_Transaction_Qty(tool_resource_.task_seq, tool_resource_.execution_instance_seq));
      ELSE
         tool_demand_rec_.resource_seq           := tool_resource_.assigned_resource_seq;
         tool_demand_rec_.serial_no              := tool_resource_.serial_no;
      END IF;
      IF tool_resource_.assigned_resource_id IS NOT NULL THEN
         tool_demand_rec_.tool_eqp_assigned := 'TRUE';
      ELSE
         tool_demand_rec_.tool_eqp_assigned := 'FALSE';
      END IF;
      
      CRUD_Create___(tool_demand_rec_);
   END LOOP;
   
   --Populating task installed part lines   
   FOR task_installed_part_ IN get_task_inst_part_list_ LOOP
      installed_part_rec_.objkey                      := sys_guid();
      installed_part_rec_.parent_objkey               := rec_dup_.objkey;     
      installed_part_rec_.inst_vrt_parent_objkey      := rec_dup_.objkey;
      installed_part_rec_.task_seq                    := task_installed_part_.task_seq;
      installed_part_rec_.task_part_id                := task_installed_part_.task_part_id;
      installed_part_rec_.part_group_id               := task_installed_part_.part_group_id;
      installed_part_rec_.installed_part_no_id        := task_installed_part_.installed_part_no_id;
      installed_part_rec_.installed_quantity          := task_installed_part_.installed_quantity;
      installed_part_rec_.installed_serial_no         := task_installed_part_.installed_serial_no;
      installed_part_rec_.original_installed_serial_no:= task_installed_part_.installed_serial_no;
      installed_part_rec_.installed_batch_no          := task_installed_part_.installed_batch_no;
      installed_part_rec_.original_installed_batch_no := task_installed_part_.installed_batch_no;
      installed_part_rec_.part_type := av_part_number_API.Get_Inventory_Class_Code (task_installed_part_.installed_part_no_id);
      installed_part_rec_.installed_user              := task_installed_part_.installed_user;
      installed_part_rec_.installed_date              := task_installed_part_.installed_date;
      installed_part_rec_.cancelled_by                := task_installed_part_.cancelled_by;
      installed_part_rec_.config_slot_position_id     := task_installed_part_.config_slot_position_id;
      installed_part_rec_.maint_material_order_no     := task_installed_part_.maint_material_order_no;
      installed_part_rec_.line_item_no                := task_installed_part_.line_item_no;
      installed_part_rec_.scheduling_action           := task_installed_part_.scheduling_action;
      installed_part_rec_.config_slot_position_code   := av_config_slot_position_API.Get_Config_Slot_Position_Code(task_installed_part_.config_slot_position_id);
      installed_part_rec_.config_slot_code            := av_config_slot_position_API.Get_Config_Slot_Code(task_installed_part_.config_slot_position_id);
      installed_part_rec_.assembly_config_slot_position_id     := task_installed_part_.assmbly_config_slot_pos_id;
      installed_part_rec_.assmbl_conf_slot_pos_code   := av_config_slot_position_API.Get_Config_Slot_Position_Code(task_installed_part_.assmbly_config_slot_pos_id);
      installed_part_rec_.signed_flag := false;
      IF (installed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND installed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.assmbl_conf_slot_pos_code || ' - ' || installed_part_rec_.config_slot_position_code;
      ELSIF (installed_part_rec_.assmbl_conf_slot_pos_code IS NULL AND installed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.config_slot_position_code;
      ELSIF (installed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND installed_part_rec_.config_slot_position_code IS NULL) THEN
         installed_part_rec_.assy_pos  := installed_part_rec_.assmbl_conf_slot_pos_code;
      ELSE
         installed_part_rec_.assy_pos := NULL;
      END IF;  
      installed_part_rec_.part_group := av_part_group_API.Get_Part_Group_Code(task_installed_part_.part_group_id) || ' (' || av_part_group_API.Get_Part_Group_Name(task_installed_part_.part_group_id) || ' )';
      installed_part_rec_.aircraft_id := Av_Exe_Task_API.Get_Aircraft_Id(task_installed_part_.task_seq);
      CRUD_Create___(installed_part_rec_);
   END LOOP;
   
   --Populating task removed part lines
   FOR task_removed_part_ IN get_task_rmvd_part_list_ LOOP
      removed_part_rec_.objkey                     := sys_guid();
      removed_part_rec_.parent_objkey              := rec_dup_.objkey;         
      removed_part_rec_.task_seq                   := task_removed_part_.task_seq;
      removed_part_rec_.task_part_id               := task_removed_part_.task_part_id;
      removed_part_rec_.removal_part_group_id      := task_removed_part_.part_group_id;
      removed_part_rec_.removal_part_no_id         := task_removed_part_.removed_part_no_id;
      removed_part_rec_.removed_quantity           := task_removed_part_.removed_quantity;
      removed_part_rec_.removed_user               := task_removed_part_.removed_user;
      removed_part_rec_.removed_date               := task_removed_part_.removed_date;
      removed_part_rec_.removal_serial_no          := task_removed_part_.removed_serial_no;
      removed_part_rec_.removal_batch_no           := task_removed_part_.removed_batch_no;
      removed_part_rec_.removal_reason_code        := task_removed_part_.removal_reason_code;
      removed_part_rec_.task_return_line_seq       := task_removed_part_.task_return_line_seq;
      removed_part_rec_.cancelled_by               := task_removed_part_.cancelled_by;
      removed_part_rec_.part_type                  := Av_Part_Number_API.Get_Inventory_Class_Code (task_removed_part_.removed_part_no_id);
      removed_part_rec_.config_slot_position_id    := task_removed_part_.config_slot_position_id;
      removed_part_rec_.config_slot_position_code  := av_config_slot_position_API.Get_Config_Slot_Position_Code(task_removed_part_.config_slot_position_id);
      removed_part_rec_.config_slot_code           := av_config_slot_position_API.Get_Config_Slot_Code(task_removed_part_.config_slot_position_id);
      removed_part_rec_.assembly_config_slot_position_id     := task_removed_part_.assmbly_config_slot_pos_id;
      removed_part_rec_.assmbl_conf_slot_pos_code   := av_config_slot_position_API.Get_Config_Slot_Position_Code(task_removed_part_.assmbly_config_slot_pos_id);
      removed_part_rec_.signed_flag := false;
      IF (removed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND removed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         removed_part_rec_.assy_pos  := removed_part_rec_.assmbl_conf_slot_pos_code || ' - ' || removed_part_rec_.config_slot_position_code;
      ELSIF (removed_part_rec_.assmbl_conf_slot_pos_code IS NULL AND removed_part_rec_.config_slot_position_code IS NOT NULL) THEN
         removed_part_rec_.assy_pos  := removed_part_rec_.config_slot_position_code;
      ELSIF (removed_part_rec_.assmbl_conf_slot_pos_code IS NOT NULL AND removed_part_rec_.config_slot_position_code IS NULL) THEN
         removed_part_rec_.assy_pos  := removed_part_rec_.assmbl_conf_slot_pos_code;
      ELSE
         removed_part_rec_.assy_pos := NULL;
      END IF;  
      removed_part_rec_.part_group := av_part_group_API.Get_Part_Group_Code(task_removed_part_.part_group_id) || ' (' || av_part_group_API.Get_Part_Group_Name(task_removed_part_.part_group_id) || ' )';
      removed_part_rec_.aircraft_id := Av_Exe_Task_API.Get_Aircraft_Id(task_removed_part_.task_seq);
      CRUD_Create___(removed_part_rec_);
   END LOOP;   
   
   IF rec_dup_.task_card_option = 'RaiseAndClose' THEN
      task_action_rec_.action_desc       := rec_dup_.latest_action;
      task_action_rec_.objkey            := sys_guid();
      task_action_rec_.parent_objkey     := rec_dup_.objkey;
      task_action_rec_.task_seq          := rec_dup_.task_seq;
      task_action_rec_.signed_flag       := TRUE;
      task_action_rec_.action_type       := 'Corrective';
      task_action_rec_.action_user       := Fnd_Session_API.Get_Fnd_User();
      task_action_rec_.action_date       := Time_Util_API.Get_Sysdate_In_Utc;
      task_action_rec_.action_ord        := 1;   
      CRUD_Create___(task_action_rec_); 
   END IF;
   
   completed_date_ := Av_Exe_Task_API.Get_Actual_Finish(rec_.task_seq);
   completed_by_   := Av_Exe_Task_API.Get_Completed_By(rec_.task_seq);
   
   current_user_:=Fnd_Session_API.Get_Fnd_User();
      
   FOR task_certify_ IN get_task_sign_off_ LOOP
      task_certify_rec_.task_seq := rec_.task_seq;
      task_certify_rec_.sign_off_req_seq := task_certify_.sign_off_req_seq;
      task_certify_rec_.sign_off_req_type := task_certify_.sign_off_req_type;
      task_certify_rec_.grouping_no       := task_certify_.grouping_no;
       
      IF(task_certify_.Sign_Off_Req_Type ='Inspector') THEN
         completion_note_ := Av_Exe_Task_API.Get_Completion_Note(rec_.task_seq);
         approval_number_ := Av_Exe_Task_API.Get_Approval_Number(rec_.task_seq);
         completed_by_   := task_certify_.identity;
         IF (current_user_ != completed_by_ AND completed_by_ IS NOT NULL )  THEN
            task_certify_rec_.existing_user := TRUE;
         ELSE
            task_certify_rec_.existing_user := FALSE;
         END IF;
         completed_date_ := task_certify_.sign_off_date;
         
      ELSIF(task_certify_.Sign_Off_Req_Type ='Independent') THEN
         completed_date_ := Jt_Task_Sign_Off_Req_API.Get_Sign_Off_Date(rec_.task_seq, task_certify_.sign_off_req_seq);
         completion_note_:= Jt_Task_Sign_Off_Req_API.Get_Sign_Off_Note(rec_.task_seq, task_certify_.sign_off_req_seq);
         completed_by_   := Jt_Task_Sign_Off_Req_API.Get_Identity(rec_.task_seq, task_certify_.sign_off_req_seq);
         approval_number_:= null;
      END IF;
      
      task_certify_rec_.is_final_sign_off := FALSE;
      task_certify_rec_.objkey            := sys_guid();
      task_certify_rec_.parent_objkey     := rec_dup_.objkey;            
      task_certify_rec_.actual_end_date   := completed_date_;
      task_certify_rec_.signed_by         := completed_by_;
      task_certify_rec_.completion_note   := completion_note_;
      task_certify_rec_.approval_number   := approval_number_;
      task_certify_rec_.signed_flag       := FALSE;
    
      
      IF  task_certify_.identity IS NOT NULL THEN   
         task_certify_rec_.sign_off_status       := 'Signed';
         task_certify_rec_.identity_name         := task_certify_.identity;         
      ELSE  
         task_certify_rec_.sign_off_status := 'Pending';
      END IF;
      CRUD_Create___(task_certify_rec_);
   END LOOP;
   
   --Make the Complete button visible if the conditions are met 
   parent_key_.objkey   := rec_dup_.objkey;
   parent_rec_          := Get_Record___(parent_key_);
   parent_new_rec_      := parent_rec_;
   
   IF rec_dup_.task_card_option = 'RaiseAndClose' THEN
      IF(parent_rec_.is_action_recorded = FALSE) THEN
         parent_new_rec_.is_action_recorded := TRUE;
         CRUD_Update___(parent_rec_, parent_new_rec_);
      END IF;
   END IF;
   
   IF (Check_Complete_Task_Enable___(parent_new_rec_.objkey)) THEN 
      parent_new_rec_.complete_task_enable  := TRUE;
      CRUD_Update___(parent_rec_, parent_new_rec_);          
   END IF;
   
   clock_in_rec_.objkey                    := sys_guid();
   clock_in_rec_.parent_objkey             := rec_dup_.objkey; 
   clock_in_rec_.task_seq                  := rec_.task_seq; 
   clock_in_rec_.execution_instance_seq    := rec_.execution_instance_seq;
   clock_in_rec_.assignment_status         := rec_.assignment_status;
   clock_in_rec_.source                    := rec_.source;
   IF rec_.assignment_status = 'ASSIGNED' THEN
      clock_in_rec_.start_time             := rec_dup_.record_work_start_time;
   ELSE
      clock_in_rec_.start_time             := rec_dup_.assignment_start;
   END IF;
   
   IF rec_dup_.task_card_option = 'RaiseAndClose' THEN
      clock_in_rec_.start_time := rec_dup_.close_fault_assign_start_time;
      clock_in_rec_.stop_time := rec_dup_.close_fault_assign_stop_time;
      duration_ := Format_Hours___(rec_dup_.close_fault_assign_actual_hours, 'Actual Duration');
      IF duration_ <= 0 THEN
         duration_ := NULL;
      END IF;
      clock_in_rec_.actual_hours := duration_;
   END IF;
   CRUD_Create___(clock_in_rec_);
   
END CRUD_Create___;

@Override
PROCEDURE CRUD_Create___(
   rec_ IN step_virtual_rec)
IS  
   step_sign_off_rec_               Task_Step_Sign_Off_Virtual_Rec;
   recs_exists_                     BOOLEAN;
   selected_key_ref_arr_            Utility_SYS.STRING_TABLE;
   token_number_                    NUMBER;
   step_sign_off_objkey_            VARCHAR2(50);
   task_seq_                        NUMBER;
   task_step_seq_                   NUMBER;
   sign_off_req_seq_                NUMBER;
      
   CURSOR get_task_step_sign_off_list_ IS
      SELECT 
        sign_off.*, 
        sign_off_req.license_id, 
        sign_off_req.description,
        sign_off_req.sign_off_req_type,
        sign_off_req.sign_off_req_type_db,
        sign_off_req.grouping_no,
        task_step.object_connection_lu_name_db AS step_obj_conn_lu_name_db
      FROM 
        Jt_Task_Step task_step
      INNER JOIN Jt_Task_Step_Sign_Off sign_off ON 
        task_step.task_seq = sign_off.task_seq AND 
        task_step.task_step_seq = sign_off.task_step_seq
      INNER JOIN Jt_Task_Sign_Off_Req sign_off_req ON 
        sign_off.task_seq = sign_off_req.task_seq AND 
        sign_off.sign_off_req_seq = sign_off_req.sign_off_req_seq
      WHERE 
        task_step.task_seq = rec_.task_seq AND 
        task_step.task_step_seq = rec_.task_step_id
      ORDER BY 
        sign_off_req.sign_off_req_seq;   
        
   CURSOR get_objkey(task_seq_ NUMBER, task_step_seq_ NUMBER, sign_off_req_seq_ NUMBER) IS
      SELECT objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off
      WHERE sign_off.task_seq = task_seq_
      AND sign_off.task_step_seq = task_step_seq_
      AND sign_off.sign_off_req_seq = sign_off_req_seq_
      AND sign_off.parent_objkey = rec_.objkey;
         
BEGIN  
   super(rec_);
   recs_exists_ := FALSE;
   
   FOR step_sign_off_ IN get_task_step_sign_off_list_ LOOP
      step_sign_off_rec_.objkey                    := sys_guid();
      step_sign_off_rec_.parent_objkey             := rec_.objkey;
      step_sign_off_rec_.task_seq                  := step_sign_off_.task_seq;
      step_sign_off_rec_.task_step_seq             := step_sign_off_.task_step_seq;
      step_sign_off_rec_.sign_off_req_seq          := step_sign_off_.sign_off_req_seq;
      step_sign_off_rec_.role                      := step_sign_off_.sign_off_req_type;
      step_sign_off_rec_.license_id                := step_sign_off_.license_id;
      step_sign_off_rec_.description               := step_sign_off_.description;
      step_sign_off_rec_.sign_off_status           := Labour_Assignment_Util_API.Get_Step_Sign_Off_Status(step_sign_off_.task_seq, step_sign_off_.task_step_seq, step_sign_off_.sign_off_req_seq);
      step_sign_off_rec_.identity                  := step_sign_off_.identity;
      step_sign_off_rec_.sign_off_date             := step_sign_off_.sign_off_date;
      step_sign_off_rec_.sign_off_req_type_db      := step_sign_off_.sign_off_req_type_db;
      step_sign_off_rec_.grouping_no               := step_sign_off_.grouping_no;
      step_sign_off_rec_.sign_off_note             := step_sign_off_.sign_off_note;
      step_sign_off_rec_.step_obj_conn_lu_name_db  := step_sign_off_.step_obj_conn_lu_name_db;
      step_sign_off_rec_.signed_flag               := FALSE;     
      step_sign_off_rec_.revoke_enable             := FALSE;     

      IF(step_sign_off_.sign_off_req_type = 'Executor')THEN
         step_sign_off_rec_.command_label := 'Execute';
         step_sign_off_rec_.order_no      := 1;
      END IF;
      IF(step_sign_off_.sign_off_req_type = 'Inspector')THEN
         step_sign_off_rec_.command_label := 'Certify';
         step_sign_off_rec_.order_no      := 2; 
      END IF;
      IF(step_sign_off_.sign_off_req_type = 'Independent')THEN
         step_sign_off_rec_.command_label := 'Inspect';
         step_sign_off_rec_.order_no      := 3;
      END IF;
      
      CRUD_Create___(step_sign_off_rec_);
   END LOOP;
   
   IF (rec_.selection IS NOT NULL) THEN
      Utility_SYS.Tokenize(rec_.selection, ';', selected_key_ref_arr_, token_number_);
      FOR i_ IN selected_key_ref_arr_.FIRST..selected_key_ref_arr_.LAST LOOP
         task_seq_         := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'TASK_SEQ'); 
         task_step_seq_    := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'TASK_STEP_SEQ');
         sign_off_req_seq_ := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'SIGN_OFF_REQ_SEQ');
         IF (rec_.task_step_id = task_step_seq_)THEN
            OPEN get_objkey(task_seq_, task_step_seq_, sign_off_req_seq_);
            FETCH get_objkey INTO step_sign_off_objkey_;
            CLOSE get_objkey;
            Update_Step_Sign_Off___(step_sign_off_objkey_, null);
         END IF;        
      END LOOP;
   END IF;
END CRUD_Create___;

@Override
PROCEDURE CRUD_Create___(
   rec_ IN panel_virtual_rec)
IS
   panel_sign_off_rec_              Task_Step_Sign_Off_Virtual_Rec;
   selected_key_ref_arr_            Utility_SYS.STRING_TABLE;
   token_number_                    NUMBER;
   step_sign_off_objkey_            VARCHAR2(50);
   task_seq_                        Av_Exe_Task.task_seq%TYPE;
   task_step_seq_                   Jt_Task_Step_Sign_Off.task_step_seq%TYPE;
   sign_off_req_seq_                Jt_Task_Sign_Off_Req.sign_off_req_seq%TYPE;
   signed_certifier_rec_count_      NUMBER;
   signed_inspector_rec_count_      NUMBER;
   
   CURSOR get_panel_sign_off_list_ IS
      SELECT
        sign_off.*, sign_off_req.license_id, sign_off_req.description, sign_off_req.sign_off_req_type,
        sign_off_req.sign_off_req_type_db, sign_off_req.grouping_no, task_step.object_connection_lu_name_db AS step_obj_conn_lu_name_db
      FROM 
        Jt_Task_Step task_step
      INNER JOIN Jt_Task_Step_Sign_Off sign_off ON 
        task_step.task_seq = sign_off.task_seq AND 
        task_step.task_step_seq = sign_off.task_step_seq
      INNER JOIN Jt_Task_Sign_Off_Req sign_off_req ON 
        sign_off.task_seq = sign_off_req.task_seq AND 
        sign_off.sign_off_req_seq = sign_off_req.sign_off_req_seq
      WHERE 
        task_step.task_seq = rec_.task_seq AND 
        task_step.task_step_seq = rec_.task_step_id
      ORDER BY 
        sign_off_req.sign_off_req_seq;   
        
   CURSOR get_objkey(task_seq_ NUMBER, task_step_seq_ NUMBER, sign_off_req_seq_ NUMBER) IS
      SELECT objkey
      FROM ${PROJECTION}_TASK_STEP_SIGN_OFF_VIRTUAL_VRT sign_off
      WHERE sign_off.task_seq = task_seq_
      AND sign_off.task_step_seq = task_step_seq_
      AND sign_off.sign_off_req_seq = sign_off_req_seq_
      AND sign_off.parent_objkey = rec_.objkey;
      
   CURSOR get_signed_sign_off_req_count(task_seq_ NUMBER, task_step_seq_ NUMBER, grouping_no_ NUMBER, role_ VARCHAR2) IS 
      SELECT 
        count(*)
      FROM 
        Jt_Task_Step task_step
      INNER JOIN Jt_Task_Step_Sign_Off sign_off ON 
        task_step.task_seq = sign_off.task_seq AND 
        task_step.task_step_seq = sign_off.task_step_seq
      INNER JOIN Jt_Task_Sign_Off_Req sign_off_req ON 
        sign_off.task_seq = sign_off_req.task_seq AND 
        sign_off.sign_off_req_seq = sign_off_req.sign_off_req_seq
      WHERE 
        task_step.task_seq = task_seq_ AND 
        task_step.task_step_seq = task_step_seq_ AND 
        sign_off_req.grouping_no = grouping_no_ AND 
        sign_off_req.sign_off_req_type = role_ AND 
        sign_off.identity IS NOT NULL;  

BEGIN  
   super(rec_);
   
   FOR step_sign_off_ IN get_panel_sign_off_list_ LOOP
      panel_sign_off_rec_.objkey                   := sys_guid();
      panel_sign_off_rec_.parent_objkey            := rec_.objkey;
      panel_sign_off_rec_.task_seq                 := step_sign_off_.task_seq;
      panel_sign_off_rec_.task_step_seq            := step_sign_off_.task_step_seq;
      panel_sign_off_rec_.sign_off_req_seq         := step_sign_off_.sign_off_req_seq;
      panel_sign_off_rec_.role                     := step_sign_off_.sign_off_req_type;
      panel_sign_off_rec_.license_id               := step_sign_off_.license_id;
      panel_sign_off_rec_.description              := step_sign_off_.description;
      panel_sign_off_rec_.sign_off_status          := Labour_Assignment_Util_API.Get_Step_Sign_Off_Status(step_sign_off_.task_seq, step_sign_off_.task_step_seq, step_sign_off_.sign_off_req_seq);
      panel_sign_off_rec_.identity                 := step_sign_off_.identity;
      panel_sign_off_rec_.sign_off_date            := step_sign_off_.sign_off_date;
      panel_sign_off_rec_.sign_off_req_type_db     := step_sign_off_.sign_off_req_type_db;
      panel_sign_off_rec_.grouping_no              := step_sign_off_.grouping_no;
      panel_sign_off_rec_.sign_off_note            := step_sign_off_.sign_off_note;
      panel_sign_off_rec_.step_obj_conn_lu_name_db := step_sign_off_.step_obj_conn_lu_name_db;
      panel_sign_off_rec_.signed_flag              := FALSE;
      
      OPEN get_signed_sign_off_req_count(step_sign_off_.task_seq, step_sign_off_.task_step_seq, step_sign_off_.grouping_no, 'Inspector' );
      FETCH get_signed_sign_off_req_count INTO signed_certifier_rec_count_;
      CLOSE get_signed_sign_off_req_count;
      
      OPEN get_signed_sign_off_req_count(step_sign_off_.task_seq, step_sign_off_.task_step_seq, step_sign_off_.grouping_no, 'Independent' );
      FETCH get_signed_sign_off_req_count INTO signed_inspector_rec_count_;
      CLOSE get_signed_sign_off_req_count;
     
      IF(step_sign_off_.sign_off_req_type = 'Executor')THEN
         panel_sign_off_rec_.command_label := 'Execute';
         panel_sign_off_rec_.order_no      := 1;
         IF ((step_sign_off_.identity IS NOT NULL) AND signed_certifier_rec_count_ = 0) THEN 
            panel_sign_off_rec_.is_revoke_sign_off_capable := TRUE;    
         END IF;
      END IF;
      IF(step_sign_off_.sign_off_req_type = 'Inspector')THEN
         panel_sign_off_rec_.command_label := 'Certify';
         panel_sign_off_rec_.order_no      := 2; 
         IF ((step_sign_off_.identity IS NOT NULL) AND signed_inspector_rec_count_ = 0) THEN 
            panel_sign_off_rec_.is_revoke_sign_off_capable := TRUE;    
         END IF;
      END IF;
      IF(step_sign_off_.sign_off_req_type = 'Independent')THEN
         panel_sign_off_rec_.command_label := 'Inspect';
         panel_sign_off_rec_.order_no      := 3;
         IF (step_sign_off_.identity IS NOT NULL) THEN 
            panel_sign_off_rec_.is_revoke_sign_off_capable := TRUE; 
         END IF;
      END IF;
      
      CRUD_Create___(panel_sign_off_rec_);
   END LOOP;
   
   IF (rec_.selection IS NOT NULL) THEN
      Utility_SYS.Tokenize(rec_.selection, ';', selected_key_ref_arr_, token_number_);
      FOR i_ IN selected_key_ref_arr_.FIRST..selected_key_ref_arr_.LAST LOOP
         task_seq_         := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'TASK_SEQ'); 
         task_step_seq_    := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'TASK_STEP_SEQ');
         sign_off_req_seq_ := Client_SYS.Get_Key_Reference_Value(selected_key_ref_arr_(i_), 'SIGN_OFF_REQ_SEQ');
         IF (rec_.task_step_id = task_step_seq_)THEN
            OPEN get_objkey(task_seq_, task_step_seq_, sign_off_req_seq_);
            FETCH get_objkey INTO step_sign_off_objkey_;
            CLOSE get_objkey;
            Update_Step_Sign_Off___(step_sign_off_objkey_, null);
         END IF;        
      END LOOP;
   END IF;
   
END CRUD_Create___;

--StepCurrStatus
PROCEDURE Record_Work_Clear_Action___
IS
BEGIN
	DELETE FROM ${PROJECTION}_RECORD_WORK_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_STEP_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_MEASUREMENT_LINE_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_INSTALLED_PART_LINE_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_REMOVED_PART_LINE_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_TASK_ACTION_LINE_VIRTUAL_VRT;
   DELETE FROM ${PROJECTION}_TOOL_LINE_VIRTUAL_VRT;
   -- This method is commented in the client but added below segment to preserve the logic.
   DELETE FROM ${PROJECTION}_RESOURCE_TOOL_LINE_VIRTUAL_VRT;
END Record_Work_Clear_Action___;


