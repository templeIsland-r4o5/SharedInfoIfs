@IgnoreUnitTest TrivialFunction
FUNCTION Get_Repairable_Search_Context_Defaults___ RETURN Show_Only_Repairable_Structure_Rec
IS
   page_search_context_struct_      Show_Only_Repairable_Structure_Rec;
BEGIN
	page_search_context_struct_.is_repairable := false;
   RETURN page_search_context_struct_;
END Get_Repairable_Search_Context_Defaults___;

@Override
@IgnoreUnitTest MethodOverride
PROCEDURE CRUD_Create___ (
   etag_   IN OUT VARCHAR2,
   key_    IN OUT Av_Wp_Sign_Off_Req_Key,
   attr_   IN OUT VARCHAR2,
   info_   OUT VARCHAR2,
   action_ IN  VARCHAR2 )
IS
BEGIN
   Client_SYS.Add_To_Attr('IS_MTX_ORIGINATED', 0, attr_);
   super(etag_, key_, attr_, info_, action_);
   
END CRUD_Create___;

@IgnoreUnitTest DMLOperation
