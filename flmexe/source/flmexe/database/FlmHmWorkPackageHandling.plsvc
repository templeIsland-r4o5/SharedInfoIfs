layer Core;

@IgnoreUnitTest DMLOperation
PROCEDURE Start_Hangar_Work_Package___ (
   aircraft_work_package_id_ IN NUMBER)
IS
   attr_            VARCHAR2(32000);
BEGIN
   Client_SYS.Clear_Attr(attr_);
   Client_SYS.Add_To_Attr('WORK_PACKAGE_ID',aircraft_work_package_id_, attr_);
   Av_Task_Start_Log_API.New(attr_);
   
   Av_Aircraft_Work_Package_API.Update_Status(aircraft_work_package_id_, 'InWork'); 
END Start_Hangar_Work_Package___;

@IgnoreUnitTest TrivialFunction
FUNCTION Get_Connect_Contract_Lines_Info___ (
   selection_ IN VARCHAR2) RETURN Contract_Line_Info_Structure_Rec
IS
   task_seq_                         NUMBER;
   rec_                              Av_Exe_Task_API.Public_Rec;
   string_tab_                       Utility_SYS.STRING_TABLE;
   token_number_                     NUMBER;
   contract_line_info_structure_rec_ Contract_Line_Info_Structure_Rec;
BEGIN

   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_seq_ := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_SEQ'); 
   END LOOP;
   
   rec_                                              := Av_Exe_Task_API.Get(task_seq_);   
   contract_line_info_structure_rec_.aircraft_wp_id  := rec_.aircraft_wp_id;
   contract_line_info_structure_rec_.selection       := selection_;

   RETURN contract_line_info_structure_rec_;

END Get_Connect_Contract_Lines_Info___;


@IgnoreUnitTest TrivialFunction
PROCEDURE Update_Selected_Task_Contract___ (
   selection_           IN VARCHAR2,
   hm_contract_line_no_ IN NUMBER,
   hm_contract_id_      IN VARCHAR2)
IS
   task_seq_     NUMBER;
   string_tab_   Utility_SYS.STRING_TABLE;
   token_number_ NUMBER;
BEGIN
         
   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_seq_ := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_SEQ');
      Av_Exe_Task_API.Update_Task_Contract(task_seq_,hm_contract_id_,hm_contract_line_no_);
   END LOOP;

END Update_Selected_Task_Contract___;

PROCEDURE Refresh___
IS
BEGIN
	NULL;
END Refresh___;

@IgnoreUnitTest TrivialFunction
FUNCTION Is_Tasks_Connected_With_Contract___ (
   aircraft_wp_id_ IN NUMBER) RETURN BOOLEAN
IS
   contract_connected_task_count_ NUMBER;
   wp_id_                         NUMBER;
   
   CURSOR get_contract_associated_tasks_in_wp (
   aircraft_wp_id_ NUMBER
   ) IS
       SELECT 
         count(task_seq)
       FROM 
         av_exe_task 
       WHERE 
         aircraft_wp_id = aircraft_wp_id_ AND 
         hm_contract_line_no IS NOT NULL;
BEGIN
   wp_id_ := aircraft_wp_id_;
   
   OPEN get_contract_associated_tasks_in_wp (wp_id_);
   FETCH get_contract_associated_tasks_in_wp INTO contract_connected_task_count_;
   CLOSE get_contract_associated_tasks_in_wp;
   
   IF contract_connected_task_count_ > 0 THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;
END Is_Tasks_Connected_With_Contract___;

