layer Core;

@Override
@IgnoreUnitTest MethodOverride
PROCEDURE CRUD_Create___(
   rec_ IN Complete_Work_Package_Virtual_Rec )
IS
   rec_dup_                   Complete_Work_Package_Virtual_Rec;
   complete_wp_new_rec_       Complete_Work_Package_Virtual_Rec;
   sign_off_req_rec_          Wp_Sign_Off_Req_Virtual_Rec;
   release_to_service_rec_    Release_To_Service_Virtual_Rec;
   unsigned_skill_count_      NUMBER := 0;
   parent_key_ref_            VARCHAR2(100);

   CURSOR get_wp_sign_off_reqs IS
      SELECT wp_sign_off_req_seq, resource_group_seq, signed_date, signed_user
      FROM Av_Wp_Sign_Off_Req_Tab
      WHERE aircraft_wp_id = rec_.aircraft_work_package_id
      ORDER BY wp_sign_off_req_seq;
BEGIN
   rec_dup_ := rec_;
   super(rec_dup_);
   complete_wp_new_rec_ := rec_dup_;
   
   --Populating wp sign off req lines
   FOR wp_so_req_rec_ IN get_wp_sign_off_reqs LOOP
      sign_off_req_rec_.objkey                     := sys_guid();
      sign_off_req_rec_.parent_objkey              := rec_dup_.objkey;
      sign_off_req_rec_.aircraft_work_package_id   := rec_.aircraft_work_package_id;
      sign_off_req_rec_.wp_sign_off_req_seq        := wp_so_req_rec_.wp_sign_off_req_seq;
      sign_off_req_rec_.resource_group_seq         := wp_so_req_rec_.resource_group_seq;      
      sign_off_req_rec_.resource_group             := Resource_API.Get_Resource_Id(wp_so_req_rec_.resource_group_seq);
      sign_off_req_rec_.signed_user                := wp_so_req_rec_.signed_user;
      IF wp_so_req_rec_.signed_user IS NOT NULL THEN
         sign_off_req_rec_.status                  := 'Signed';   
      ELSE
         sign_off_req_rec_.status                  := 'Pending';
         unsigned_skill_count_                     := unsigned_skill_count_ + 1;
      END IF;  
      sign_off_req_rec_.signed_user                := wp_so_req_rec_.signed_user;
      sign_off_req_rec_.signed_date                := wp_so_req_rec_.signed_date;
      
      CRUD_Create___(sign_off_req_rec_);
   END LOOP;
   
   release_to_service_rec_.objkey                  := sys_guid();
   release_to_service_rec_.parent_objkey           := rec_dup_.objkey;
   IF unsigned_skill_count_ = 1 THEN
      complete_wp_new_rec_.is_last_sign_off_skill  := TRUE;
   ELSE   
      complete_wp_new_rec_.is_last_sign_off_skill  := FALSE;
   END IF;
   release_to_service_rec_.release_to_service      := FALSE;
   release_to_service_rec_.release_to_service_txt  := 'No';
   CRUD_Create___(release_to_service_rec_);
   
   complete_wp_new_rec_.release_remark_objkey      := release_to_service_rec_.objkey;
   Client_SYS.Add_To_Key_Reference(parent_key_ref_, 'AIRCRAFT_WORK_PACKAGE_ID', rec_.aircraft_work_package_id);
   complete_wp_new_rec_.parent_key_ref             := parent_key_ref_;
   complete_wp_new_rec_.parent_lu_name             := Av_Aircraft_Work_Package_API.lu_name_; 
   complete_wp_new_rec_.sign_enable                := FALSE;
   Crud_Update___(rec_dup_,complete_wp_new_rec_);
END CRUD_Create___;

@IgnoreUnitTest TrivialFunction
FUNCTION Get_Comp_Wp_Summary_Values___ (
   aircraft_id_   IN NUMBER) RETURN Complete_Work_Package_Structure_Rec
IS
   complete_wp_rec_              Complete_Work_Package_Structure_Rec;
   
BEGIN
   -- Configuration Warning data
   complete_wp_rec_.cms_status   := Av_Exe_Task_Part_Warning_API.Get_Cms_Status(aircraft_id_);
   
   IF complete_wp_rec_.cms_status >= 0 THEN 
      complete_wp_rec_.cms_warning_exist  := TRUE;
   ELSE
      complete_wp_rec_.cms_warning_exist  := FALSE;
   END IF;

	RETURN complete_wp_rec_;
END Get_Comp_Wp_Summary_Values___;

