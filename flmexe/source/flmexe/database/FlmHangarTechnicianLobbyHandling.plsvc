@IgnoreUnitTest TrivialFunction
FUNCTION Get_Handover_Assignment_Count___ (
   work_package_id_ IN NUMBER) RETURN NUMBER
IS
   count_ NUMBER := 0;
BEGIN
	 IF work_package_id_ IS NOT NULL THEN
      count_ := Av_Aircraft_Work_Package_API.Get_Handovers_Count_By_Wp_Id(work_package_id_);
    END IF;
    RETURN count_;
END Get_Handover_Assignment_Count___;

@IgnoreUnitTest PLSQLInSQL
FUNCTION Get_Mpc_Assignment_Count___ (
   work_package_id_ IN NUMBER) RETURN NUMBER
IS
   mpc_assignment_count_ NUMBER := 0;
   
   CURSOR get_mpc_assignment_count IS
   SELECT COUNT(*)
   FROM jt_task_resource_demand_av_uiv t
   WHERE t.work_package_id = work_package_id_
   AND (t.class_code = Av_Exe_Task_API.TASK_CLASS_MPC 
   AND t.subclass_code IN (Av_Exe_Task_API.TASK_SUBCLASS_MPCOPEN, Av_Exe_Task_API.TASK_SUBCLASS_MPCCLOSE))
   AND t.task_status IN ('Active', 'In Work');
BEGIN
   IF work_package_id_ IS NOT NULL THEN
      OPEN get_mpc_assignment_count;
      FETCH get_mpc_assignment_count INTO mpc_assignment_count_;
      CLOSE get_mpc_assignment_count;
   END IF;
   
   RETURN mpc_assignment_count_;
   
END Get_Mpc_Assignment_Count___;
