layer Core;

FUNCTION Get_Default_Value___ RETURN Search_Context_Structure_Rec
IS
   rec_ Search_Context_Structure_Rec;
BEGIN
   rec_.has_turn_assigned_to_me := FALSE;
   RETURN rec_;
END Get_Default_Value___;
