@IgnoreUnitTest DMLOperation
FUNCTION Generate_Part_Tag_Report___ (
   task_return_line_seq_     IN NUMBER,
   selected_part_tag_type_   IN VARCHAR2,
   remark_                   IN VARCHAR2,
   quar_comment_             IN VARCHAR2) RETURN NUMBER
IS
   result_key_ NUMBER;
BEGIN
   result_key_ := Av_Part_Tag_Report_API.Execute_Part_Tag_Report(task_return_line_seq_,selected_part_tag_type_,remark_,quar_comment_);
   RETURN result_key_;
END Generate_Part_Tag_Report___;

@Override
PROCEDURE CRUD_Create___(
   rec_ IN Part_Returns_Virtual_Rec )
IS
   tab_ Planned_Returns_Virtual_Rec;
   task_return_line_seq_ NUMBER;
          
   CURSOR planned_return_line_info IS   
      SELECT part_no, serial_no, site,qty_to_return,qty_returned
        FROM Jt_Task_Return_Av_Uiv 
       WHERE task_return_line_seq = task_return_line_seq_;     
BEGIN  
   super(rec_);
   task_return_line_seq_ := rec_.task_return_line_seq;

   FOR planned_return_rec_ IN planned_return_line_info LOOP
      tab_.task_return_line_seq    := rec_.task_return_line_seq;
      tab_.objkey                  := sys_guid();
      tab_.parent_objkey           := rec_.objkey;
      tab_.site                    := planned_return_rec_.site;
      tab_.remaining_qty_to_return := NVL(planned_return_rec_.qty_to_return,0) - NVL(planned_return_rec_.qty_returned,0);
      tab_.return_quantity         := tab_.remaining_qty_to_return; 
      tab_.part_no                 := planned_return_rec_.part_no;
      tab_.serial_no               := planned_return_rec_.serial_no;
      CRUD_Create___(tab_);
   END LOOP;   
END CRUD_Create___;