END Remove_Return_Line___;

@IgnoreUnitTest NoOutParams
PROCEDURE Validate_Returned_Part___ (
   part_no_ IN VARCHAR2,
   serial_no_ IN VARCHAR2)
IS
   condition_code_check_  BOOLEAN := FALSE;
   info_                  VARCHAR2(2000);
BEGIN
   Jt_Task_Return_API.Validate_Return_Line(info_                 => info_, 
                                           part_no_              => part_no_, 
                                           serial_no_            => serial_no_, 
                                           condition_code_usage_ => NULL, 
                                           condition_code_       => NULL, 
                                           condition_code_check_ => condition_code_check_); 
END Validate_Returned_Part___;

