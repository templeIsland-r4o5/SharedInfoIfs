layer Core;


@IgnoreUnitTest DMLOperation
PROCEDURE Create_Return_Line___ (
   task_part_id_      IN NUMBER,
   task_seq_          IN NUMBER,
   rem_part_no_       IN VARCHAR2,
   qty_return_        IN NUMBER,
   removal_serial_no_ IN VARCHAR2,
   removal_batch_no_  IN VARCHAR2)
IS
   task_return_line_seq_ NUMBER := NULL;
BEGIN
   Av_Exe_Task_Part_Util_API.Av_Return_Creation(task_seq_, rem_part_no_, removal_serial_no_,removal_batch_no_, qty_return_, task_return_line_seq_);           
   Av_Exe_Task_Part_API.Update_Task_Return_Line_Seq(task_part_id_ ,task_return_line_seq_);
END Create_Return_Line___;


