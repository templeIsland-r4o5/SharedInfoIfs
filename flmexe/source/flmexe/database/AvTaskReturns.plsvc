   task_part_id_ IN NUMBER)
IS
BEGIN
	Av_Exe_Task_Part_Util_API.Cancel_Part_Removal(task_part_id_);
END Cancel_Part___;

@IgnoreUnitTest DMLOperation
PROCEDURE Remove_Return_Line___ (
   task_return_line_seq_ IN NUMBER)
IS
BEGIN
