@IgnoreUnitTest MethodOverride
@Override
PROCEDURE CRUD_Create___ (
   rec_ IN Release_Aircraft_Virtual_Rec )
IS 
   new_rec_                   Release_Aircraft_Virtual_Rec;
BEGIN
   new_rec_ := rec_;
   Load_Compliance_Info___(new_rec_);
   super(new_rec_);
END CRUD_Create___;

--UT Blocked due to DXDEV-3640
@IgnoreUnitTest TrivialFunction
FUNCTION Get_Missing_Mandatory_Components___ (
   aircraft_id_ IN NUMBER) RETURN Missing_Mandatory_Details_Arr
IS
   result_      Aircraft_API.Missing_Mandatory_Details_Arr := Aircraft_API.Missing_Mandatory_Details_Arr();
   ui_result_   Missing_Mandatory_Details_Arr := Missing_Mandatory_Details_Arr();   
BEGIN
   result_ := Aircraft_API.Get_Missing_Manda_Components(aircraft_id_);

   FOR i IN 1 .. result_.COUNT LOOP
      ui_result_.extend;
      ui_result_(i).config_slot := result_(i).config_slot;
      ui_result_(i).config_slot_position := result_(i).config_slot_position;
      ui_result_(i).assembly_config_slot := result_(i).assembly_config_slot;      
      ui_result_(i).assembly_config_slot_position := result_(i).assembly_config_slot_position;
      ui_result_(i).assembly := result_(i).assembly;
      ui_result_(i).part_number := result_(i).part_number;
      ui_result_(i).part_name := result_(i).part_name;      
   END LOOP;
   
   RETURN ui_result_;
END Get_Missing_Mandatory_Components___;

FUNCTION Get_Release_Number___ (
   aircraft_id_ IN NUMBER,
   flight_id_   IN NUMBER) RETURN VARCHAR2
IS
   release_number_      VARCHAR2(80);
   flight_turn_status_  VARCHAR2(30);
   
BEGIN
	flight_turn_status_ := Av_flight_API.Get_Turn_Status(flight_id_);
   
   IF flight_turn_status_ != 'Released' THEN 
      release_number_ := null;
   ELSE 
      release_number_ := Aircraft_API.Get_Release_Number(aircraft_id_);
   END IF;
	
   RETURN release_number_;
END Get_Release_Number___;

FUNCTION Get_Release_Remarks___ (
   aircraft_id_ IN NUMBER,
   flight_id_   IN NUMBER) RETURN VARCHAR2
IS
   release_remarks_     VARCHAR2(4000);
   flight_turn_status_  VARCHAR2(30);
BEGIN
   flight_turn_status_ := Av_flight_API.Get_Turn_Status(flight_id_);

   IF flight_turn_status_ != 'Released' THEN 
      release_remarks_ := null;
   ELSE 
      release_remarks_ := Aircraft_API.Get_Release_Remarks(aircraft_id_);
   END IF;
	
   RETURN release_remarks_;
END Get_Release_Remarks___;


FUNCTION Get_Release_Status___ (
   aircraft_wp_id_ IN NUMBER) RETURN VARCHAR2
IS
   aircraft_wp_status_   VARCHAR2(50);
BEGIN
	aircraft_wp_status_ := Av_Aircraft_Work_Package_API.Get_Objstate(aircraft_wp_id_);
   RETURN aircraft_wp_status_;
END Get_Release_Status___;



FUNCTION Get_Open_Faults___ (
   aircraft_id_ IN NUMBER) RETURN Release_Status_Details_Struct_Arr
IS
   CURSOR get_open_fault_recs_ IS
      SELECT      sub_system.sub_system_name,fault.barcode,fault.description,fault.logbook_type_code,fault.found_on_date , fault.logbook_reference
      FROM        av_fault_tab fault
      INNER JOIN  av_aircraft_sub_system sub_system ON
                  sub_system.sub_system_id = fault.sub_system_id
      WHERE       fault.aircraft_id = aircraft_id_ AND fault.rowstate = 'Open';
        
   result_        Release_Status_Details_Struct_Arr := Release_Status_Details_Struct_Arr();
   i_             NUMBER := 1;
BEGIN
   FOR rec_ IN get_open_fault_recs_ LOOP
      result_.extend();
      result_(i_).barcode := rec_.barcode;
      result_(i_).description := rec_.description;
      result_(i_).sub_system_name := rec_.sub_system_name;
      result_(i_).logbook_type_code := rec_.logbook_type_code;
      result_(i_).logbook_reference := rec_.logbook_reference;
      result_(i_).found_on_date := rec_.found_on_date;
      result_(i_).utc_time_zone_code := 'UTC';
      i_ := i_ + 1;
   END LOOP;
   RETURN  result_;
END Get_Open_Faults___;

