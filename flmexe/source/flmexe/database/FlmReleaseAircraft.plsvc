PROCEDURE Complete_Work_Package___ (
   aircraft_wp_id_ IN NUMBER,
   actual_end_date_time_ IN DATE)
IS
   info_          VARCHAR2(4000);
   attr_          VARCHAR2(4000);
   objid_         VARCHAR2(2000);
   objversion_    VARCHAR2(2000);
   wp_duration_   NUMBER;

   CURSOR get_wp IS
      SELECT  ROWID,to_char(rowversion,'YYYYMMDDHH24MISS')
      FROM    Av_Aircraft_Work_Package_tab
      WHERE   aircraft_work_package_id = aircraft_wp_id_;
      
BEGIN
   -- Change the state to complete in the database.
   Av_Aircraft_Work_Package_API.Change_State(aircraft_wp_id_, 'Completed');
   
   -- Modify the work package entity.
   Av_Aircraft_Work_Package_API.Update_Actual_End_Date_Time(aircraft_wp_id_, actual_end_date_time_);
   
   OPEN get_wp;
   FETCH get_wp INTO objid_, objversion_;
   CLOSE get_wp;
   
   wp_duration_ := Adcom_Util_API.Validate_Hours(Av_Aircraft_Work_Package_API.Get_Completed_Wp_Duration(aircraft_wp_id_)); 
   
   Client_SYS.Add_To_Attr('IS_RELEASE_TO_SERVICE', 'True', attr_);
   Client_SYS.Add_To_Attr('SIGNED_USER',Fnd_Session_API.Get_Fnd_User(),attr_);
   Client_SYS.Add_To_Attr('IS_HISTORIC', 'True', attr_);
   Client_SYS.Add_To_Attr('DURATION', wp_duration_, attr_);
   
   IF actual_end_date_time_ IS NOT NULL THEN
      Client_SYS.Add_To_Attr('ACTUAL_END_DATE_TIME', actual_end_date_time_, attr_);
   END IF;
   
   Av_Aircraft_Work_Package_API.Modify__(info_, objid_, objversion_, attr_, 'DO'); 
END Complete_Work_Package___;

PROCEDURE Send_Aircraft_Release_Data___ (
   aircraft_id_ IN NUMBER,
   release_number_ IN VARCHAR2,
   release_remarks_ IN VARCHAR2,
   date_signed_ IN DATE,
   flight_id_ IN NUMBER,
   bind_signature_id_ IN VARCHAR2)
IS
   info_       VARCHAR2(4000);
   attr_       VARCHAR2(4000);
   objid_      VARCHAR2(2000);
   objversion_ VARCHAR2(2000);
   e_sig_permission_ VARCHAR2(20);
   
   CURSOR get_aircraft IS
      SELECT  ROWID,to_char(rowversion,'YYYYMMDDHH24MISS')
      FROM    Aircraft_tab
      WHERE   aircraft_id = aircraft_id_;
 
   CURSOR get_e_sig_user IS
      SELECT permission 
      FROM av_e_sig_user_permission_tab
      WHERE identity = Fnd_Session_API.Get_Fnd_User();
      
BEGIN
   
   OPEN get_e_sig_user;
   FETCH get_e_sig_user INTO e_sig_permission_;
   CLOSE get_e_sig_user;
   
   IF ((e_sig_permission_ IS NULL OR e_sig_permission_ = 'Yes')AND bind_signature_id_ IS NULL) THEN
      Error_SYS.Record_General(lu_name_, 'ESIGERRORRERA: Failed to record electronic signature. Review changes and try again.');
   END IF;
   info_ := NULL;
   objid_ := NULL;
   objversion_ :=NULL;
   
   IF bind_signature_id_ IS NOT NULL THEN
      Client_SYS.Add_To_Attr('AIRCRAFT_ID', aircraft_id_, attr_);
      Client_SYS.Add_To_Attr('FLIGHT_ID', flight_id_, attr_);
      Client_SYS.Add_To_Attr('RELEASE_NUMBER', release_number_, attr_);
      Client_SYS.Add_To_Attr('RELEASE_REMARKS', release_remarks_, attr_);
      Client_SYS.Add_To_Attr('RELEASE_DATE', date_signed_, attr_);
      Client_SYS.Add_To_Attr('SIGNED_USER', Fnd_Session_API.Get_Fnd_User(), attr_);
      Client_SYS.Add_To_Attr('BIND_SIGNATURE_ID', bind_signature_id_, attr_);
      Av_Aircraft_Release_API.New__(info_, objid_, objversion_, attr_, 'DO');  
   END IF;
   
   Client_SYS.Clear_Attr(attr_);
	OPEN get_aircraft;
   FETCH get_aircraft INTO objid_, objversion_;
   CLOSE get_aircraft;
   
   Client_SYS.Add_To_Attr('RELEASE_NUMBER', release_number_, attr_);
   Client_SYS.Add_To_Attr('RELEASE_REMARKS', release_remarks_, attr_);
   Client_SYS.Add_To_Attr('RELEASE_DATE', date_signed_, attr_);
   Aircraft_API.Modify__(info_, objid_, objversion_, attr_, 'DO'); 
END Send_Aircraft_Release_Data___;


FUNCTION Get_Is_Wp_Complete___(
   aircraft_wp_id_ IN NUMBER) RETURN BOOLEAN
IS
   aircraft_wp_status_ VARCHAR2(50);
BEGIN
	aircraft_wp_status_ := Av_Aircraft_Work_Package_API.Get_Objstate(aircraft_wp_id_);
   IF aircraft_wp_status_ = 'Completed' THEN 
      RETURN TRUE;
   ELSE 
      RETURN FALSE;
   END IF;
END Get_Is_Wp_Complete___;

FUNCTION Get_Signed_Date___ (
   aircraft_wp_id_ IN NUMBER) RETURN DATE
IS
BEGIN
 RETURN	Av_Aircraft_Work_Package_API.Get_Actual_End_Date_Time(aircraft_wp_id_);
END Get_Signed_Date___;


FUNCTION Get_Open_Faults_Status___ (
   aircraft_id_ IN NUMBER) RETURN BOOLEAN
IS
   CURSOR get_open_fault_count_ IS
      SELECT      COUNT(fault_id)
      FROM        av_fault_tab fault
      WHERE       fault.aircraft_id = aircraft_id_ AND fault.rowstate = 'Open';
   open_faults_count_   NUMBER;
BEGIN
	OPEN get_open_fault_count_;
   FETCH get_open_fault_count_ INTO open_faults_count_;
   CLOSE get_open_fault_count_;
   
   IF (open_faults_count_>0) THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;   
END Get_Open_Faults_Status___;


FUNCTION Get_Overdue_Faults_Status___ (
   aircraft_id_ IN NUMBER) RETURN BOOLEAN
IS
   CURSOR get_overdue_fault_count_ IS
      SELECT      COUNT(fault.fault_id)
      FROM        av_fault_tab fault
      INNER JOIN  av_fault_deadline_tab fault_deadline ON
                  fault_deadline.fault_id = fault.fault_id
      WHERE       fault.aircraft_id = aircraft_id_ 
                  AND fault.rowstate = 'Deferred' 
                  AND fault_deadline.deadline_date < Time_Util_API.Get_Sysdate_In_Utc;
   overdue_faults_count_   NUMBER;
BEGIN
	OPEN get_overdue_fault_count_;
   FETCH get_overdue_fault_count_ INTO overdue_faults_count_;
   CLOSE get_overdue_fault_count_;
   
   IF (overdue_faults_count_>0) THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;   
END Get_Overdue_Faults_Status___;

FUNCTION Get_Uncompleted_Tasks_Status___ (
   aircraft_wp_id_ IN NUMBER) RETURN BOOLEAN
IS
   CURSOR get_uncompleted_task_count_ IS
      SELECT      COUNT(task.task_seq)
      FROM        av_exe_task task
      INNER JOIN  av_aircraft_work_package_tab aircraft_wp ON
                  aircraft_wp.aircraft_work_package_id = task.aircraft_wp_id
      WHERE       aircraft_wp.aircraft_work_package_id = aircraft_wp_id_ 
                  AND task.objstate != 'FINISHED';
   uncompleted_tasks_count_   NUMBER;
BEGIN
	OPEN get_uncompleted_task_count_;
   FETCH get_uncompleted_task_count_ INTO uncompleted_tasks_count_;
   CLOSE get_uncompleted_task_count_;
   
   IF (uncompleted_tasks_count_>0) THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;   
END Get_Uncompleted_Tasks_Status___;


FUNCTION Get_E_Sig_Permission___ (
   user_id_ IN VARCHAR2) RETURN VARCHAR2
IS
   permission_ av_e_sig_user_permission_tab.permission%TYPE;
BEGIN
   permission_ := Av_E_Sig_User_Permission_API.Get_Permission(user_id_);
   RETURN permission_;
END Get_E_Sig_Permission___;

FUNCTION Get_Pending_Tasks___ (
   aircraft_wp_id_ IN NUMBER) RETURN Release_Status_Details_Struct_Arr
IS
   CURSOR get_open_task_recs_ IS
      SELECT task.task_code , task.description, task.config_position  
      FROM av_exe_task task
      WHERE task.aircraft_wp_id = aircraft_wp_id_ AND task.objstate IN ('RELEASED', 'WORKSTARTED') ;
   
   result_        Release_Status_Details_Struct_Arr := Release_Status_Details_Struct_Arr();
   i_             NUMBER := 1;
BEGIN
   FOR rec_ IN get_open_task_recs_ LOOP
      result_.extend();
      result_(i_).task_name := rec_.description;
      result_(i_).task_code := rec_.task_code;
      result_(i_).config_slot := rec_.config_position;
      i_ := i_ + 1;
   END LOOP;
   RETURN  result_;
END Get_Pending_Tasks___;


FUNCTION Get_Open_Tasks_Status___ (
   aircraft_wp_id_ IN NUMBER) RETURN BOOLEAN
IS
   CURSOR get_open_task_count_ IS
      SELECT      COUNT(task_seq)
      FROM        av_exe_task task
      WHERE       task.aircraft_wp_id = aircraft_wp_id_ AND task.objstate IN ('RELEASED','WORKSTARTED');
   open_tasks_count_   NUMBER;
BEGIN
	OPEN get_open_task_count_;
   FETCH get_open_task_count_ INTO open_tasks_count_;
   CLOSE get_open_task_count_;
   
   IF (open_tasks_count_>0) THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   END IF;   
END Get_Open_Tasks_Status___;



PROCEDURE Update_User___ (
   key_ IN Release_Aircraft_Virtual_Key)
IS
   sign_by_ VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User();
   parent_rec_             Release_Aircraft_Virtual_Rec;
   parent_new_rec_         Release_Aircraft_Virtual_Rec; 
BEGIN

   parent_rec_          := Get_Record___(key_);
   parent_new_rec_      := parent_rec_;

   parent_new_rec_.signed_by  := sign_by_;
   CRUD_Update___(parent_rec_, parent_new_rec_);  
END Update_User___;


FUNCTION Get_Esig_File_Name_For_Release_Acft___ (
   aircraft_id_    IN NUMBER,
   aircraft_wp_id_ IN NUMBER) RETURN VARCHAR2
IS
   file_name_   VARCHAR2(100);
   wo_number_   VARCHAR2(80);
   reg_code_    VARCHAR2(10);
   signed_user_ VARCHAR2(40);
   formatted_wo_number_ VARCHAR2(80);
   
   CURSOR get_reg_code IS
      SELECT reg_code
      FROM aircraft_tab
      WHERE aircraft_id = aircraft_id_;
      
   CURSOR get_wo_number IS
      SELECT wo_number
      FROM av_aircraft_work_package_tab
      WHERE aircraft_work_package_id = aircraft_wp_id_;
BEGIN
	OPEN  get_reg_code;
   FETCH get_reg_code INTO reg_code_;
   CLOSE get_reg_code;
   
   OPEN  get_wo_number;
   FETCH get_wo_number INTO wo_number_;
   CLOSE get_wo_number;
   
   signed_user_ := Fnd_Session_API.Get_Fnd_User();
   formatted_wo_number_ := REPLACE(wo_number_, 'WO - ', 'WO-');
   
   IF (reg_code_ IS NOT NULL AND wo_number_ IS NOT NULL) THEN 
      file_name_ := reg_code_ || '_' || formatted_wo_number_ || '_' || signed_user_;
      RETURN file_name_;
   END IF;
END Get_Esig_File_Name_For_Release_Acft___;

