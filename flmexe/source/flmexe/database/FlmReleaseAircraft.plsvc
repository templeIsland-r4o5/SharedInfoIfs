FUNCTION Get_Neardue_Tasks___ (
   aircraft_id_ IN NUMBER) RETURN Neardue_Task_Details_Arr
IS
   result_      Av_Exe_Task_Deadline_API.Neardue_Task_Details_Arr := Av_Exe_Task_Deadline_API.Neardue_Task_Details_Arr();
   ui_result_   Neardue_Task_Details_Arr := Neardue_Task_Details_Arr();    
BEGIN
	result_ := Av_Exe_Task_Deadline_API.Get_Neardue_Tasks(aircraft_id_);
   
   FOR i IN 1 .. result_.COUNT LOOP
      ui_result_.extend;
      ui_result_(i).barcode := result_(i).barcode;
      ui_result_(i).task_seq := result_(i).task_seq;      
      ui_result_(i).description := result_(i).description;
      ui_result_(i).is_soft_deadline := result_(i).is_soft_deadline;  
      ui_result_(i).usage_remaining := result_(i).usage_remaining;      
   END LOOP;
   
   RETURN ui_result_;

END Get_Neardue_Tasks___;