FUNCTION Get_Neardue_Faults___ (
   aircraft_id_ IN NUMBER) RETURN Neardue_Fault_Details_Arr
IS
   result_      Av_Fault_Deadline_API.Neardue_Fault_Details_Arr := Av_Fault_Deadline_API.Neardue_Fault_Details_Arr();
   ui_result_   Neardue_Fault_Details_Arr := Neardue_Fault_Details_Arr();    
BEGIN
   result_ := Av_Fault_Deadline_API.Get_Neardue_Faults(aircraft_id_);
   
   FOR i IN 1 .. result_.COUNT LOOP
      ui_result_.extend;
      ui_result_(i).barcode := result_(i).barcode;
      ui_result_(i).fault_id := result_(i).fault_id;      
      ui_result_(i).description := result_(i).description;
      ui_result_(i).failed_system := result_(i).failed_system;      
      ui_result_(i).deferral_class_code := result_(i).deferral_class_code;
      ui_result_(i).is_soft_deadline := result_(i).is_soft_deadline;  
      ui_result_(i).usage_remaining := result_(i).usage_remaining;      
   END LOOP;
   
   RETURN ui_result_;
END Get_Neardue_Faults___;

PROCEDURE Load_Compliance_Info___ (
   rec_ IN OUT Release_Aircraft_Virtual_Rec)
IS
   missing_comp_count_        NUMBER;
   missing_mand_parm_value_   VARCHAR2(200);
   neardue_fault_count_       NUMBER;
   overdue_fault_count_       NUMBER;  
   overdue_fault_parm_value_  VARCHAR2(200); 
   overdue_task_count_        NUMBER;  
   overdue_task_parm_value_   VARCHAR2(200); 
   neardue_task_count_        NUMBER;
BEGIN
   rec_.is_flm_standalone := (Adcom_Util_API.Is_FLM_Standalone() = 'TRUE');
   rec_.missing_component_status := 'OK';
   rec_.is_mandatory_components_missing := FALSE;
   rec_.overdue_fault_status := 'OK';
   rec_.has_overdue_faults := FALSE;
   rec_.has_neardue_faults := FALSE; 
   rec_.overdue_task_status := 'OK';
   rec_.has_overdue_tasks := FALSE;  
   rec_.has_release_override_rights := FALSE;
   rec_.has_neardue_tasks := FALSE;     

   IF (NOT rec_.is_flm_standalone) THEN
      -- override permission
      rec_.has_release_override_rights := Adcom_Util_API.Has_Release_Override_Rights;      
      
      -- missing mandatory
      missing_comp_count_ := Aircraft_API.Get_Missing_Manda_Comp_Count(rec_.aircraft_id);
      IF (missing_comp_count_ > 0) THEN
         rec_.is_mandatory_components_missing := TRUE;
         missing_mand_parm_value_ := Adcom_Util_API.Get_Mx_Parm_Value('RELEASE_MISSING_COMPONENT');
         IF (missing_mand_parm_value_ IS NOT NULL) THEN
            rec_.missing_component_status := missing_mand_parm_value_;
         END IF;
      END IF;

      -- overdue
      overdue_fault_count_ := Av_Fault_Deadline_API.Get_Overdue_Fault_Count(rec_.aircraft_id);
      IF (overdue_fault_count_ > 0) THEN
         rec_.has_overdue_faults := TRUE;
         overdue_fault_parm_value_ := Adcom_Util_API.Get_Mx_Parm_Value('RELEASE_OVERDUE_FAULT');
         IF (overdue_fault_parm_value_ IS NOT NULL) THEN
            rec_.overdue_fault_status := overdue_fault_parm_value_;
         END IF;
      END IF;      

      --neardue
      neardue_fault_count_ := Av_Fault_Deadline_API.Get_Neardue_Fault_Count(rec_.aircraft_id);
      IF (neardue_fault_count_ > 0) THEN
         rec_.has_neardue_faults := TRUE;
      END IF; 
      
      -- overdue task
      overdue_task_count_ := Av_Exe_Task_Deadline_API.Get_Overdue_Task_Count(rec_.aircraft_id);
      IF (overdue_task_count_ > 0) THEN
         rec_.has_overdue_tasks := TRUE;
         overdue_task_parm_value_ := Adcom_Util_API.Get_Mx_Parm_Value('RELEASE_OVERDUE_TASK');
         IF (overdue_task_parm_value_ IS NOT NULL) THEN
            rec_.overdue_task_status := overdue_task_parm_value_;
         END IF;
      END IF;      
      
      -- neardue task
      neardue_task_count_ := Av_Exe_Task_Deadline_API.Get_Neardue_Task_Count(rec_.aircraft_id);
      IF (neardue_task_count_ > 0) THEN
         rec_.has_neardue_tasks := TRUE;
      END IF; 
   END IF;    
END Load_Compliance_Info___;

