@IgnoreUnitTest TrivialFunction
FUNCTION Check_Start_End_Dates___ (
   start_time_ IN DATE,
   end_time_ IN DATE) RETURN VARCHAR2
IS
   utc_start_time_     DATE;
   utc_end_time_       DATE;
   current_utc_date_   DATE;
BEGIN
   utc_start_time_ := Time_Util_API.Convert_Server_Time_To_Utc(start_time_);
   utc_end_time_ := Time_Util_API.Convert_Server_Time_To_Utc(end_time_);
   current_utc_date_ := Time_Util_API.Get_Sysdate_In_Utc;
   
   IF (start_time_ IS NOT NULL AND end_time_ IS NOT NULL AND start_time_ > end_time_)THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALIDDATES: Start Date should be less than the End Date.');
   END IF;
   IF (utc_start_time_ > current_utc_date_)THEN
         Error_SYS.Record_General(lu_name_, 'INVALIDSTARTTIME: Start Date should not be a future date');
   END IF;
   IF (utc_end_time_ > current_utc_date_)THEN
         Error_SYS.Record_General(lu_name_, 'INVALIDENDTIME: End Date should not be a future date');
   END IF;
   
	RETURN Adcom_Util_API.Get_Time_Difference(start_time_, end_time_);
END Check_Start_End_Dates___;

