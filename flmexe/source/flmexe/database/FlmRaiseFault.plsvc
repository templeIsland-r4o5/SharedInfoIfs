layer Core;
FUNCTION Raise_Fault___ (
   key_              IN Raise_Fault_Virtual_Key) RETURN NUMBER
IS
   virt_rec_         Raise_Fault_Virtual_Rec;
   leg_no_           VARCHAR2(500);
   info_             VARCHAR2(200);
   objid_            VARCHAR2(200);
   objversion_       VARCHAR2(200);
   attr_             VARCHAR2(32000);
   found_on_dt_      DATE;
   fault_id_         NUMBER;
   aircraft_work_package_id_ NUMBER;
   
BEGIN
   virt_rec_ := Get_Record___(key_); 
   Client_SYS.Add_To_Attr('AIRCRAFT_ID',          virt_rec_.Aircraft_Id,          attr_);
   Client_SYS.Add_To_Attr('SUB_SYSTEM_ID',        virt_rec_.Sub_System_Id,        attr_);
   Client_SYS.Add_To_Attr('FAULT_CODE',           virt_rec_.Fault_Code,           attr_);
   Client_SYS.Add_To_Attr('FAULT_SOURCE_CODE',    virt_rec_.Fault_Source_Code,    attr_);
   Client_SYS.Add_To_Attr('LOGBOOK_TYPE_CODE',    virt_rec_.Logbook_Type_Code,    attr_);
   Client_SYS.Add_To_Attr('FOUND_ON_TYPE',        virt_rec_.Source,               attr_);
   Client_SYS.Add_To_Attr('FOUND_BY_USER',        Fnd_Session_API.Get_Fnd_User(), attr_);
   IF virt_rec_.Source IS NULL OR virt_rec_.Source = 'FLIGHT' THEN   
      Client_SYS.Add_To_Attr('FOUND_ON_TYPE',      'FLIGHT',                      attr_);
      IF virt_rec_.Found_On_Id IS NOT NULL THEN 
         leg_no_ := Av_Flight_API.Get_Leg_No(virt_rec_.Found_On_Id);
         aircraft_work_package_id_:= Av_Flight_API.Get_Work_Package_Id(virt_rec_.Found_On_Id);
      END IF;
      Client_SYS.Add_To_Attr('FOUND_ON_DESC',       leg_no_,                      attr_);
   END IF;
   Client_SYS.Add_To_Attr('DESCRIPTION',          virt_rec_.Description,          attr_);
   Client_SYS.Add_To_Attr('FOUND_ON_ID',          virt_rec_.Found_On_Id,          attr_);
   Client_SYS.Add_To_Attr('PHASE_OF_FLIGHT_CODE', virt_rec_.Phase_Of_Flight_Code, attr_);
   Client_SYS.Add_To_Attr('FAILURE_TYPE_CODE',    virt_rec_.Failure_Type_Code,    attr_);
   Client_SYS.Add_To_Attr('LOGBOOK_REFERENCE',    virt_rec_.Logbook_Reference,    attr_);
   found_on_dt_ := Time_Util_API.Get_Sysdate_In_Utc;
   Client_SYS.Add_To_Attr('FOUND_ON_DATE',        found_on_dt_,                   attr_);
   Av_Fault_API.New__(info_, objid_, objversion_, attr_, 'DO');
   
   fault_id_ := Client_SYS.Get_Item_Value_To_Number('FAULT_ID', attr_, NULL);
  
   IF virt_rec_.Source IS NOT NULL OR (virt_rec_.Source IS NULL AND virt_rec_.Found_On_Id IS NOT NULL) THEN
      RETURN Package_Open_Fault_New___(fault_id_, virt_rec_.Found_On_Id, aircraft_work_package_id_);
   ELSE
      RETURN fault_id_;
   END IF;
END Raise_Fault___;
FUNCTION Package_Open_Fault_New___ (
   fault_id_                 IN NUMBER,
   flight_id_                IN NUMBER,
   aircraft_work_package_id_ IN NUMBER) RETURN NUMBER
IS
   
   departure_time_stamp_    DATE;
   flight_turn_status_      VARCHAR2(100);
   aircraft_id_             NUMBER;
   sub_system_id_           NUMBER;
   task_seq_                NUMBER;
   new_work_package_id_     NUMBER;
   new_work_package_id_var_ VARCHAR2(300);
   sub_system_code_         VARCHAR2(300);
   description_             VARCHAR2(300);
   barcode_                 VARCHAR2(300);
   task_code_               VARCHAR2(200);
   faut_status_             VARCHAR2(200);
   location_code_           VARCHAR2(200);
   new_obj_id_              VARCHAR2(200);
   new_objversion_          VARCHAR2(200);
   arrival_airport_id_      NUMBER;
   shed_arrival_date_time_  DATE;
   info_                    VARCHAR2(200);
   objid_                   VARCHAR2(200);
   objversion_              VARCHAR2(200);
   attr_                    VARCHAR2(32000);
   wp_name_date_            VARCHAR2(200);
   wp_new_name_             VARCHAR2(200);
   task_rec_                Av_Exe_Task_API.Entity_Rec;
  
   CURSOR get_fault_data IS
      SELECT f.aircraft_id, f.sub_system_id, f.description, f.barcode, f.fault_code, f.rowstate
      FROM   av_fault_tab f
      WHERE  f.fault_id = fault_id_;
   
   CURSOR get_flight_data IS
      SELECT a.arrival_airport_id,a.shed_arrival_date_time
      FROM   av_flight_tab a
      WHERE  a.flight_id = flight_id_ AND a.aircraft_id = (SELECT f.aircraft_id
                                                           FROM   av_fault_tab f
                                                           WHERE  f.fault_id = fault_id_);
   
   CURSOR get_task_data IS 
      SELECT   e.task_seq
      FROM     av_exe_task e
      WHERE    e.fault_id = fault_id_
      ORDER BY objversion DESC 
      FETCH first 1 ROW ONLY;
        
BEGIN
   wp_name_date_       := to_char(sysdate,'DD/MM/YYYY');
   wp_new_name_        := CONCAT('Packaged Fault ',wp_name_date_);
   flight_turn_status_ := Av_Flight_API.Get_Turn_Status(flight_id_);
   
   OPEN get_fault_data;
   FETCH get_fault_data INTO aircraft_id_,sub_system_id_,description_,barcode_, task_code_, faut_status_;
   CLOSE get_fault_data;
   
   IF flight_turn_status_ ='Inbound' OR flight_turn_status_ ='Arrived' OR flight_turn_status_ ='InMaintenance' THEN
      
      OPEN get_flight_data;
      FETCH get_flight_data INTO arrival_airport_id_, shed_arrival_date_time_;
      CLOSE get_flight_data;
      
      departure_time_stamp_ := Av_Flight_API.Get_Departure_Timestamp(flight_id_);
      sub_system_code_      := Av_Aircraft_Sub_System_API.Get_Sub_System_Code(sub_system_id_);
      location_code_        := Av_Maintenance_Location_API.Get_Loc_Code_by_Airport_Id(arrival_airport_id_);
      
      IF Av_Aircraft_Work_Package_API.Is_Existing_Wp_Valid(aircraft_work_package_id_) THEN
         --Package Fault when Work Package exists
         IF faut_status_ = 'Open' THEN
            OPEN  get_task_data;
            FETCH get_task_data INTO task_seq_;
            IF get_task_data%FOUND THEN
               Av_Exe_Task_API.Get_Id_Version_By_Task_Id(new_obj_id_, new_objversion_, task_seq_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID', aircraft_work_package_id_, attr_);
               Av_Exe_Task_API.Modify__(info_, new_obj_id_, new_objversion_, attr_, 'DO');
               
                  IF (Mx_Config_API.Is_Maintenix_Connected) THEN
                     IF NOT Mx_Data_Sync_Util_API.Is_Mx_Data_Sync_Receive_Mode() THEN 
                        task_rec_.task_seq       := task_seq_;
                        task_rec_.fault_id       := fault_id_;
                        task_rec_.aircraft_wp_id := aircraft_work_package_id_;
                        task_rec_.barcode        := barcode_;
                        Av_Exe_Task_API.CopyChanges(task_rec_);
                     END IF;
                  END IF;
               
            ELSE   
               Client_SYS.Add_To_Attr('AIRCRAFT_ID',      aircraft_id_,              attr_);
               Client_SYS.Add_To_Attr('FAULT_ID',         fault_id_,                 attr_);
               Client_SYS.Add_To_Attr('CLASS_CODE',       Av_Exe_Task_API.TASK_CLASS_CORR, attr_);
               Client_SYS.Add_To_Attr('DESCRIPTION',      description_,              attr_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID',   aircraft_work_package_id_, attr_);
               Client_SYS.Add_To_Attr('BARCODE',          barcode_,                  attr_);
               Client_SYS.Add_To_Attr('TASK_CODE',        task_code_,                attr_);
               Client_SYS.Add_To_Attr('CONFIG_POSITION',  sub_system_code_,          attr_);
               Av_Exe_Task_API.New__(info_, objid_, objversion_, attr_, 'DO');
               task_seq_ := Client_SYS.Get_Item_Value('TASK_SEQ', attr_);
               Av_Exe_Task_API.Release_Task(task_seq_);
            END IF;
            CLOSE get_task_data;
            
         ELSIF faut_status_ = 'Deferred' THEN
            OPEN get_task_data;
            FETCH get_task_data INTO task_seq_;            
            IF get_task_data%FOUND THEN
               CLOSE get_task_data;
               Av_Exe_Task_API.Get_Id_Version_By_Task_Id(new_obj_id_, new_objversion_, task_seq_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID', aircraft_work_package_id_, attr_);
               Av_Exe_Task_API.Release__(info_, new_obj_id_, new_objversion_, attr_, 'DO');
               Av_Exe_Task_API.Modify__(info_, new_obj_id_, new_objversion_, attr_, 'DO');
               
                  IF (Mx_Config_API.Is_Maintenix_Connected) THEN
                     IF NOT Mx_Data_Sync_Util_API.Is_Mx_Data_Sync_Receive_Mode() THEN 
                        task_rec_.task_seq       := task_seq_;
                        task_rec_.fault_id       := fault_id_;
                        task_rec_.aircraft_wp_id := aircraft_work_package_id_;
                        task_rec_.barcode        := barcode_;
                        Av_Exe_Task_API.CopyChanges(task_rec_);
                     END IF;
                  END IF;
               
            ELSE
               CLOSE get_task_data;
               Client_SYS.Add_To_Attr('AIRCRAFT_ID',      aircraft_id_,              attr_);
               Client_SYS.Add_To_Attr('FAULT_ID',         fault_id_,                 attr_);
               Client_SYS.Add_To_Attr('CLASS_CODE',       Av_Exe_Task_API.TASK_CLASS_CORR, attr_);
               Client_SYS.Add_To_Attr('DESCRIPTION',      description_,              attr_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID',   aircraft_work_package_id_, attr_);
               Client_SYS.Add_To_Attr('BARCODE',          barcode_,                  attr_);
               Client_SYS.Add_To_Attr('TASK_CODE',        task_code_,                attr_);
               Client_SYS.Add_To_Attr('CONFIG_POSITION',  sub_system_code_,          attr_);
               Av_Exe_Task_API.New__(info_, objid_, objversion_, attr_, 'DO');
               task_seq_ := Client_SYS.Get_Item_Value('TASK_SEQ', attr_);
               Av_Exe_Task_API.Release_Task(task_seq_);
            END IF;           
         END IF;         
      ELSE
         --Package Fault when no Work Package exists
         --Create WP         
         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('AIRCRAFT_ID',           aircraft_id_,   attr_);
         Client_SYS.Add_To_Attr('LOCATION_CODE',         location_code_, attr_);        
         Client_SYS.Add_To_Attr('WORK_PACKAGE_NAME',     wp_new_name_,   attr_);
         Client_SYS.Add_To_Attr('IS_HISTORIC',           'False',        attr_);        
         Client_SYS.Add_To_Attr('DURATION',              0,              attr_);
         IF flight_turn_status_ = 'Inbound' OR flight_turn_status_ = 'Arrived' THEN     
            Client_SYS.Add_To_Attr('SCHED_START_DATE_TIME', shed_arrival_date_time_, attr_);  
         ELSE     
            Client_SYS.Add_To_Attr('SCHED_START_DATE_TIME', Time_Util_API.Get_Sysdate_In_Utc,                 attr_);            
         END IF;        
         IF departure_time_stamp_ IS NOT NULL THEN 
            Client_SYS.Add_To_Attr('SCHED_END_DATE_TIME',   shed_arrival_date_time_, attr_);
         END IF;
         IF departure_time_stamp_ IS NULL THEN          
            IF flight_turn_status_ = 'Inbound' OR flight_turn_status_ = 'Arrived' THEN 
               Client_SYS.Add_To_Attr('SCHED_END_DATE_TIME', shed_arrival_date_time_, attr_);
            ELSE  
               Client_SYS.Add_To_Attr('SCHED_END_DATE_TIME', Time_Util_API.Get_Sysdate_In_Utc,                 attr_);              
            END IF;
         END IF;   
         Av_Aircraft_Work_Package_API.New__(info_, objid_, objversion_, attr_, 'DO');  
         --Create Task
         new_work_package_id_var_ := Client_SYS.Get_Item_Value('AIRCRAFT_WORK_PACKAGE_ID', attr_);
         new_work_package_id_     := Client_SYS.Attr_Value_To_Number(new_work_package_id_var_);
         IF faut_status_ = 'Open' THEN
            Client_SYS.Add_To_Attr('AIRCRAFT_ID',      aircraft_id_,              attr_);
            Client_SYS.Add_To_Attr('FAULT_ID',         fault_id_,                 attr_);
            Client_SYS.Add_To_Attr('CLASS_CODE',       Av_Exe_Task_API.TASK_CLASS_CORR, attr_);
            Client_SYS.Add_To_Attr('DESCRIPTION',      description_,              attr_);
            Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID',   new_work_package_id_,      attr_);
            Client_SYS.Add_To_Attr('BARCODE',          barcode_,                  attr_);
            Client_SYS.Add_To_Attr('TASK_CODE',        task_code_,                attr_);
            Client_SYS.Add_To_Attr('CONFIG_POSITION',  sub_system_code_,          attr_);
            Av_Exe_Task_API.New__(info_, objid_, objversion_, attr_, 'DO'); 
            task_seq_ := Client_SYS.Get_Item_Value('TASK_SEQ', attr_);
            Av_Exe_Task_API.Release_Task(task_seq_);
         ELSIF faut_status_ = 'Deferred' THEN
            OPEN  get_task_data;
            FETCH get_task_data INTO task_seq_;
                        
            IF get_task_data%FOUND THEN
               CLOSE get_task_data;
               Av_Exe_Task_API.Get_Id_Version_By_Task_Id(new_obj_id_, new_objversion_, task_seq_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID', new_work_package_id_, attr_);
               Av_Exe_Task_API.Release__(info_, new_obj_id_, new_objversion_, attr_, 'DO');
               Av_Exe_Task_API.Modify__(info_, new_obj_id_, new_objversion_, attr_, 'DO');
              
            ELSE
               CLOSE get_task_data;
               Client_SYS.Add_To_Attr('AIRCRAFT_ID',      aircraft_id_,              attr_);
               Client_SYS.Add_To_Attr('FAULT_ID',         fault_id_,                 attr_);
               Client_SYS.Add_To_Attr('CLASS_CODE',       Av_Exe_Task_API.TASK_CLASS_CORR, attr_);
               Client_SYS.Add_To_Attr('DESCRIPTION',      description_,              attr_);
               Client_SYS.Add_To_Attr('AIRCRAFT_WP_ID',   new_work_package_id_,      attr_);
               Client_SYS.Add_To_Attr('BARCODE',          barcode_,                  attr_);
               Client_SYS.Add_To_Attr('TASK_CODE',        task_code_,                attr_);
               Client_SYS.Add_To_Attr('CONFIG_POSITION',  sub_system_code_,          attr_);
               Av_Exe_Task_API.New__(info_, objid_, objversion_, attr_, 'DO'); 
               task_seq_ := Client_SYS.Get_Item_Value('TASK_SEQ', attr_);
               Av_Exe_Task_API.Release_Task(task_seq_);
            END IF;            
         END IF;
      END IF;      
   ELSE
      Error_SYS.Record_General(lu_name_, 'WRONGTURN: Aircraft Turn Status should be Inbound, Arrived or InMaintenance');      
   END IF;  
   RETURN flight_id_;
END Package_Open_Fault_New___;

FUNCTION Validate_And_Format_Hours___ (
   hours_         IN VARCHAR2,
   time_var_name_ IN VARCHAR2) RETURN NUMBER
IS
   duration_  NUMBER;   
BEGIN
   duration_ := Adcom_Util_API.Validate_Format_Hours(hours_) ;
   IF duration_ IS NULL  THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALID: Enter :P1 in the HH:MM format.', time_var_name_);
   END IF;
   RETURN duration_;
END Validate_And_Format_Hours___;

@IgnoreUnitTest TrivialFunction
FUNCTION Fetch_Maintenance_Request_Info___ (
   aircraft_id_     IN NUMBER,   
   sub_system_id_   IN NUMBER,
   found_on_date_   IN DATE) RETURN Fault_Mtx_Request_Data_Rec
IS
   rec_   Fault_Mtx_Request_Data_Rec;   
BEGIN
   rec_.aircraft_alt_id := Aircraft_API.Get_Alt_Id(aircraft_id_);
   rec_.config_slot_alt_id := Av_Aircraft_Sub_System_API.Get_Alt_Id(sub_system_id_);
   rec_.utc_found_on_date := Time_Util_API.Convert_Server_Time_To_Utc(found_on_date_);
   RETURN rec_;
END Fetch_Maintenance_Request_Info___;

@IgnoreUnitTest NoOutParams
PROCEDURE Validate_Found_On_Date___ (
   found_on_date_ IN DATE,
   aircraft_wp_id_ IN NUMBER)
IS
BEGIN
   Adcom_Util_API.Validate_Found_On_Date(found_on_date_, aircraft_wp_id_);
END Validate_Found_On_Date___;

FUNCTION Fetch_Defaults___ (
   source_           IN VARCHAR2,
   aircraft_wp_id_   IN NUMBER,
   found_on_id_      IN NUMBER,
   aircraft_id_      IN NUMBER)  RETURN Fetch_Default_Struct_Rec
IS
   default_labour_   VARCHAR2(200) := Adcom_Util_API.Get_Mx_Parm_Value('ADHOC_CORRTASK_LABOUR');
   resource_seq_     NUMBER;   
   rec_              Fetch_Default_Struct_Rec;
   CURSOR get_resource_seq(resource_id_ IN VARCHAR2) IS
      SELECT resource_seq
      FROM resource_lov
      WHERE resource_type_db = 'PERSON_GROUP' AND
            used_in_maintenance_db = 'TRUE' AND
            resource_id = resource_id_;
BEGIN
   CASE source_
      WHEN 'TASK' THEN
         rec_.found_source := 'Task';
         rec_.raise_fault_option := 'NonRoutine';
      WHEN 'LOBBY' THEN
         rec_.found_source := 'WorkPackage';
         rec_.raise_fault_option := 'LogbookFault';
      WHEN 'HMLOBBY' THEN
         rec_.found_source := 'WorkPackage';
         rec_.raise_fault_option := 'NonRoutine';
      WHEN 'FLIGHT' THEN
         rec_.found_source := 'WorkPackage';
         rec_.raise_fault_option := 'LogbookFault';
      WHEN 'HMSLOBBY' THEN
         rec_.found_source := 'WorkPackage';
         rec_.raise_fault_option := 'NonRoutine';
      WHEN 'HMCLLOBBY' THEN
         rec_.found_source := 'WorkPackage';
         rec_.raise_fault_option := 'NonRoutine';
      ELSE
         rec_.found_source := NULL;
      END CASE;   
      
   -- Fetch user and timezone information
   rec_.current_user := Fnd_Session_API.Get_Fnd_User();
   rec_.current_user_airport_time_zone := Av_Airport_For_User_API.Get_User_Time_Zone();   
   rec_.sub_system_id := Get_Sub_System_Id_By_Task_Seq___(found_on_id_);
   rec_.sched_hours := Adcom_Util_API.Fetch_Default_Sched_Hours();
   rec_.fault_severity_code := 'UNKNOWN';
   rec_.fault_source_code := Adcom_Util_API.Fetch_Def_Fault_Source_Code();
   rec_.found_on_date := Time_Util_API.Get_Sysdate_In_Utc();
   rec_.raise_fault_action_option := 'RaiseAndLeave';
   rec_.location_code := Av_Aircraft_Work_Package_API.Get_Location_Code(aircraft_wp_id_);
   
   IF(default_labour_ IS NOT NULL) THEN
      OPEN get_resource_seq(default_labour_);
      FETCH get_resource_seq INTO resource_seq_;
      CLOSE get_resource_seq;
      IF(resource_seq_ IS NOT NULL) THEN
         rec_.resource_seq := resource_seq_;
      END IF;
   END IF;
   
   IF (aircraft_id_ IS NULL) THEN
      rec_.aircraft_id := Av_Aircraft_Work_Package_API.Get_Aircraft_Id(aircraft_wp_id_);
   ELSE
      rec_.aircraft_id := aircraft_id_; 
   END IF;
   
   RETURN rec_;
END Fetch_Defaults___;

@IgnoreUnitTest TrivialFunction   
FUNCTION Get_Sub_System_Id_By_Task_Seq___ (
   task_seq_ IN NUMBER) RETURN NUMBER
IS
   assembly_type_code_   VARCHAR2(100);
   config_pos_code_   VARCHAR2(100);
   sub_system_id_   NUMBER;      
BEGIN
	IF (task_seq_ IS NOT NULL) THEN
      assembly_type_code_ := Aircraft_API.Get_Assembly_Type_Code(Av_Exe_Task_API.Get_Aircraft_Id(task_seq_));
      config_pos_code_   := Av_Exe_Task_API.Get_Config_Position(task_seq_);
      sub_system_id_ := Av_Aircraft_Sub_System_API.Get_Sub_Sys_Id_By_Config_Pos(assembly_type_code_, config_pos_code_);
   END IF;

	RETURN sub_system_id_;
END Get_Sub_System_Id_By_Task_Seq___;

FUNCTION Get_Measurement_Type_Code_For_Fault___ (
   parent_objkey_ IN VARCHAR2) RETURN Objid_Arr
IS
   collection_  Objid_Arr := Objid_Arr(); 
   CURSOR get_measurement_types IS
      SELECT objid
      FROM av_measurement_type m
      WHERE m.measurement_type_code NOT IN (SELECT t.measurement_type_code 
                                            FROM ${PROJECTION}_MEASUREMENT_VIRTUAL_VRT t
                                            WHERE t.parent_objkey = parent_objkey_);                                         
BEGIN
   FOR rec_ IN get_measurement_types LOOP 
      collection_.extend;
      collection_(collection_.last) := rec_.objid;
END LOOP;
   
   RETURN collection_;
   
END Get_Measurement_Type_Code_For_Fault___;

@IgnoreUnitTest NoOutParams
PROCEDURE Add_Fault_Measurement___ ( 
   parent_objkey_         IN VARCHAR2,
   measurement_type_code_ IN VARCHAR2,
   meas_type_value_code_  IN VARCHAR2,
   measurement_qty_       IN NUMBER,
   measurement_date_time_ IN DATE,
   measurement_text_      IN VARCHAR2,
   measurement_boolean_   IN BOOLEAN)
IS
   measurement_domain_type_   VARCHAR2(8);
   measurement_type_          VARCHAR2(100);
   new_rec_                   Measurement_Virtual_Rec;   
BEGIN
	new_rec_.objkey          := sys_guid();
   new_rec_.parent_objkey   := parent_objkey_;
   new_rec_.measurement_type_code := measurement_type_code_;   
   
   measurement_domain_type_ := Av_Measurement_Type_API.Get_Measurement_Category_Code(measurement_type_code_);
   IF(measurement_domain_type_ = 'CH') THEN
      new_rec_.meas_type_value_code := meas_type_value_code_;
      new_rec_.value := meas_type_value_code_;
   ELSIF (measurement_domain_type_ = 'ME') THEN
      IF (measurement_qty_ IS NOT NULL) THEN
         new_rec_.measurement_qty := measurement_qty_;
         measurement_type_ := Av_Measurement_Type_API.Get_Engineering_Unit_Code(measurement_type_code_);
         new_rec_.value := CONCAT(CONCAT(measurement_qty_, ' '), measurement_type_);
      END IF;
   ELSIF (measurement_domain_type_ = 'CME') THEN
      new_rec_.measurement_date_time := measurement_date_time_;
      new_rec_.value :=  TO_CHAR( measurement_date_time_, 'DD-MON-YY HH24:MM' );
   ELSIF (measurement_domain_type_ = 'TEXT') THEN
      new_rec_.measurement_text := measurement_text_;
      new_rec_.value := measurement_text_;
   ELSIF (measurement_domain_type_ = 'CHK') THEN
      new_rec_.measurement_boolean       := measurement_boolean_;
      IF(measurement_boolean_) THEN
         new_rec_.value := 'YES';
      ELSE
         new_rec_.value := 'NO'; 
      END IF;
   END IF;
   
   CRUD_Create___(new_rec_);
END Add_Fault_Measurement___;

PROCEDURE Create_Task_Sign_Off_Requirement___ (
   etops_significant_ IN BOOLEAN,
   flight_safety_impact_ IN BOOLEAN,
   task_seq_ IN NUMBER
   )
IS
   sign_off_req_seq_ NUMBER;
BEGIN
   Jt_Task_Sign_Off_Req_API.New_Sign_Off_Req(sign_off_req_seq_, task_seq_, NULL, NULL, NULL, 'EXECUTOR', NULL, 'TASK');
   Jt_Task_Sign_Off_Req_API.New_Sign_Off_Req(sign_off_req_seq_, task_seq_, NULL, NULL, NULL, 'INSPECTOR', NULL, 'TASK');
   IF (etops_significant_ = TRUE OR flight_safety_impact_ = TRUE) THEN
      Jt_Task_Sign_Off_Req_API.New_Sign_Off_Req(sign_off_req_seq_, task_seq_, NULL, NULL, NULL, 'INDEPENDENT', NULL, 'TASK');
   END IF;
END Create_Task_Sign_Off_Requirement___;

