@IgnoreUnitTest TrivialFunction
@DynamicComponentDependency ADCON
FUNCTION Validate_Contract_Rule___ (
   task_seq_ IN NUMBER) RETURN BOOLEAN
IS
   parent_task_pub_rec_      Av_Exe_Task_API.Public_Rec;
   task_pub_rec_             Av_Exe_Task_API.Public_Rec;
   is_heavy_maintenance_     av_aircraft_work_package_tab.is_heavy_maintenance%TYPE;
   nr_lowest_function_no_    VARCHAR2(50);
BEGIN
   $IF Component_Adcon_SYS.INSTALLED $THEN
      task_pub_rec_             := Av_Exe_Task_API.Get(task_seq_);
      parent_task_pub_rec_      := Av_Exe_Task_API.Get(task_pub_rec_.source_ref1);
      is_heavy_maintenance_     := Av_Aircraft_Work_Package_API.Get_Is_Heavy_Maintenance(task_pub_rec_.aircraft_wp_id);

      IF  is_heavy_maintenance_ = 1 AND parent_task_pub_rec_.hm_contract_id IS NOT NULL AND parent_task_pub_rec_.hm_contract_line_no IS NOT NULL AND Av_Exe_Task_API.Is_Non_Routine(task_seq_) = 'TRUE' THEN
         -- Check for HM contract exclusions before setting HM contract details.
         Adcon_Util_API.Get_Lowest_Function_By_Fault(nr_lowest_function_no_, task_pub_rec_.fault_id);
         IF (Adcon_Util_API.Exclude_Non_Routine(task_pub_rec_.fault_id, parent_task_pub_rec_.hm_contract_id, parent_task_pub_rec_.hm_contract_line_no, nr_lowest_function_no_)) THEN
            RETURN FALSE;
         ELSE
            RETURN TRUE;         
         END IF;
      ELSE
         RETURN TRUE;      
      END IF;
   $ELSE
      RETURN TRUE;
   $END
END Validate_Contract_Rule___;
