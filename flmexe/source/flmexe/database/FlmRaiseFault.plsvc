@IgnoreUnitTest TrivialFunction
FUNCTION Convert_Actual_Hours___ (
   actual_hours_ IN VARCHAR2,
   parameter_name_ IN VARCHAR2) RETURN NUMBER
IS
BEGIN
	RETURN Format_Actual_Hours___(actual_hours_, parameter_name_);
END Convert_Actual_Hours___;

FUNCTION Format_Actual_Hours___ (
   hours_per_person_ IN VARCHAR2,
   time_var_name_    IN VARCHAR2) RETURN NUMBER
IS
   convert_to_number_  NUMBER;   
   CURSOR convert_to_number IS
      SELECT TO_NUMBER(ROUND(regexp_substr (hours_per_person_, '[^:]+', 1, 2)/60+regexp_substr (hours_per_person_, '[^:]+', 1, 1),2))
      FROM DUAL;
BEGIN
   IF (REGEXP_LIKE(hours_per_person_,'^(\d{0,2}):[0-5][0-9]$')) THEN
      OPEN convert_to_number;
      FETCH convert_to_number INTO convert_to_number_;
      CLOSE convert_to_number;
   ELSE
      Error_SYS.Record_General(lu_name_, 'ERRINVALID: Please enter valid value(HH:MM) for :P1 field', time_var_name_);
   END IF;
   RETURN convert_to_number_;
END Format_Actual_Hours___;

