@IgnoreUnitTest PLSQLInSQL
PROCEDURE Add_Default_Fault_Measurement___ (
   parent_objkey_     IN VARCHAR2,
   failure_type_code_ IN VARCHAR2)
IS
   measurements_       Av_Measurement_Util_API.measurement_list;   
BEGIN
   DELETE 
   FROM ${PROJECTION}_MEASUREMENT_VIRTUAL_VRT
   WHERE parent_objkey = parent_objkey_; 
   
   measurements_ := Av_Measurement_Util_API.Get_Measurements_For_Failure(failure_type_code_);
   
   FOR i IN 1 .. measurements_.COUNT LOOP
      Add_Fault_Measurement___ (parent_objkey_ ,measurements_(i), NULL, NULL, NULL, NULL, NULL);
   END LOOP;
END Add_Default_Fault_Measurement___;

