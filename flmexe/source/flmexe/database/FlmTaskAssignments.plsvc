@IgnoreUnitTest NoOutParams
PROCEDURE Add_New_Assignment___ (
   task_seq_                      IN NUMBER,
   site_                          IN VARCHAR2,
   skill_demand_res_seq_          IN NUMBER,
   executor_res_seq_              IN NUMBER,
   pre_executor_scheduled_hours_  IN VARCHAR2,
   executor_scheduled_start_      IN DATE,
   executor_scheduled_end_        IN DATE,
   certification_required_        IN BOOLEAN,
   certifier_res_seq_             IN NUMBER,
   pre_certifier_scheduled_hours_ IN VARCHAR2,
   certifier_scheduled_start_     IN DATE,
   certifier_scheduled_end_       IN DATE,
   inspection_required_           IN BOOLEAN,
   inspector_res_seq_             IN NUMBER,
   pre_inspector_scheduled_hours_ IN VARCHAR2,
   inspector_scheduled_start_     IN DATE,
   inspector_scheduled_end_       IN DATE)
IS
   executor_scheduled_hours_           NUMBER;
   certifier_scheduled_hours_          NUMBER;
   inspector_scheduled_hours_          NUMBER;
   cert_task_res_seq_                  NUMBER;
   insp_task_res_seq_                  NUMBER;
   exec_task_res_seq_                  NUMBER;
   exec_execution_instance_seq_        NUMBER; 
   exec_resource_activity_alloc_seq_   NUMBER; 
   exec_resource_activity_seq_         NUMBER; 
   cert_execution_instance_seq_        NUMBER; 
   cert_resource_activity_alloc_seq_   NUMBER; 
   cert_resource_activity_seq_         NUMBER;  
   insp_execution_instance_seq_        NUMBER; 
   insp_resource_activity_alloc_seq_   NUMBER; 
   insp_resource_activity_seq_         NUMBER;
   task_res_group_id_                  VARCHAR2(50);  
BEGIN
   IF skill_demand_res_seq_ IS NOT NULL THEN
      executor_scheduled_hours_ := Validate_Format_Duration_Hours___(task_seq_, pre_executor_scheduled_hours_, 'Executor');     
      
      Jt_Task_Resource_API.New(
         task_resource_seq_   => exec_task_res_seq_,
         task_seq_            => task_seq_,
         demand_type_         => 'PERSON',
         resource_group_seq_  => skill_demand_res_seq_,
         planned_hours_       => executor_scheduled_hours_,
         remark_              => 'Executor');
  
      Labour_Assignment_Util_API.Add_Task_Resource_Certificate (
         task_seq_, 
         exec_task_res_seq_,
         skill_demand_res_seq_,
         'EXECUTOR-CERTIFICATE');
      
      IF executor_res_seq_ IS NOT NULL THEN
         IF Validate_Schedule_Range___(task_seq_, executor_scheduled_start_, executor_scheduled_end_, executor_scheduled_hours_, 'Executor') THEN
            Jt_Execution_Instance_API.New_Modify_Execution_Instance(
               execution_instance_seq_       => exec_execution_instance_seq_,
               resource_activity_alloc_seq_  => exec_resource_activity_alloc_seq_,
               resource_activity_seq_        => exec_resource_activity_seq_,
               task_resource_seq_            => exec_task_res_seq_,
               task_seq_                     => task_seq_,
               allocated_start_              => executor_scheduled_start_,
               allocated_finish_             => executor_scheduled_end_, 
               allocated_hours_              => executor_scheduled_hours_,
               resource_seq_                 => executor_res_seq_);
         END IF;
      END IF;
      
      IF certification_required_ THEN
         certifier_scheduled_hours_ := Validate_Format_Duration_Hours___(task_seq_, pre_certifier_scheduled_hours_, 'Certifier');         

         Jt_Task_Resource_API.New(
            task_resource_seq_   => cert_task_res_seq_,
            task_seq_            => task_seq_,
            demand_type_         => 'PERSON',
            resource_group_seq_  => skill_demand_res_seq_,
            planned_hours_       => certifier_scheduled_hours_,
            remark_              => 'Certifier');

         Labour_Assignment_Util_API.Add_Task_Resource_Certificate (
            task_seq_, 
            cert_task_res_seq_,
            skill_demand_res_seq_,
            'CERTIFIER-CERTIFICATE');
         
         IF certifier_res_seq_ IS NOT NULL THEN
            IF Validate_Schedule_Range___(task_seq_, certifier_scheduled_start_, certifier_scheduled_end_, certifier_scheduled_hours_, 'Certifier') THEN
               Jt_Execution_Instance_API.New_Modify_Execution_Instance(
                  execution_instance_seq_       => cert_execution_instance_seq_,
                  resource_activity_alloc_seq_  => cert_resource_activity_alloc_seq_,
                  resource_activity_seq_        => cert_resource_activity_seq_,
                  task_resource_seq_            => cert_task_res_seq_,
                  task_seq_                     => task_seq_,
                  allocated_start_              => certifier_scheduled_start_,
                  allocated_finish_             => certifier_scheduled_end_, 
                  allocated_hours_              => certifier_scheduled_hours_,
                  resource_seq_                 => certifier_res_seq_);
            END IF; 
         END IF;
         
         IF inspection_required_ THEN 
            inspector_scheduled_hours_ := Validate_Format_Duration_Hours___(task_seq_, pre_inspector_scheduled_hours_, 'Inspector');
      
            Jt_Task_Resource_API.New(
               task_resource_seq_   => insp_task_res_seq_,
               task_seq_            => task_seq_,
               demand_type_         => 'PERSON',
               resource_group_seq_  => skill_demand_res_seq_,
               planned_hours_       => inspector_scheduled_hours_,
               remark_              => 'Inspector');
   
            Labour_Assignment_Util_API.Add_Task_Resource_Certificate (
               task_seq_, 
               insp_task_res_seq_,
               skill_demand_res_seq_,
               'INSPECTOR-CERTIFICATE');
            
            IF inspector_res_seq_ IS NOT NULL THEN
               IF Validate_Schedule_Range___(task_seq_, inspector_scheduled_start_, inspector_scheduled_end_, inspector_scheduled_hours_, 'Inspector') THEN
                  Jt_Execution_Instance_API.New_Modify_Execution_Instance(
                     execution_instance_seq_       => insp_execution_instance_seq_,
                     resource_activity_alloc_seq_  => insp_resource_activity_alloc_seq_,
                     resource_activity_seq_        => insp_resource_activity_seq_,
                     task_resource_seq_            => insp_task_res_seq_,
                     task_seq_                     => task_seq_,
                     allocated_start_              => inspector_scheduled_start_,
                     allocated_finish_             => inspector_scheduled_end_, 
                     allocated_hours_              => inspector_scheduled_hours_,
                     resource_seq_                 => inspector_res_seq_);
               END IF; 
            END IF;
         END IF;
      END IF;
      Av_Exe_Task_Assignment_API.Add_Entry(task_seq_, exec_task_res_seq_, cert_task_res_seq_, insp_task_res_seq_, task_res_group_id_);
   END IF;
END Add_New_Assignment___;


FUNCTION Validate_Schedule_Dates___ (
   task_seq_      IN NUMBER,
   start_date_    IN DATE,
   end_date_      IN DATE,
   field_         IN VARCHAR2)   RETURN Schedule_Hours_Structure_Rec
IS
   duration_               NUMBER;
   max_schedule_hours_     NUMBER := 9999.59;
   schedule_hours_         Schedule_Hours_Structure_Rec;
   schedule_date_interval_ Av_Exe_Task_API.Task_Schedule_Time_Interval_Rec;
BEGIN
   IF start_date_ > end_date_ THEN
      Error_SYS.Record_General(lu_name_, 'ERRINVALIDDATES: :P1 Scheduled Start Date should be less than the Scheduled End Date.',field_);
   END IF;

   schedule_date_interval_ := Av_Exe_Task_API.Get_Task_Schedule_Interval(task_seq_);
   
   IF start_date_ < schedule_date_interval_.schedule_start OR end_date_ > schedule_date_interval_.schedule_end THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDASSIGNMENT: :P1 Assignment is outside the schedule time.',field_);
   END IF;
   duration_           := Adcom_Util_API.Get_Time_Difference_In_Hours(start_date_, end_date_);
   IF duration_ > max_schedule_hours_ THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDSCHEDHOURS2: Exceeded maximum allowed :P1 Schedule Hours.',field_);  
   END IF;
   schedule_hours_.schedule_hours         := duration_;
   schedule_hours_.pre_schedule_hours     := Adcom_Util_API.Get_Text_Time(schedule_hours_.schedule_hours);
   RETURN schedule_hours_;  
END Validate_Schedule_Dates___;


FUNCTION Validate_Format_Duration_Hours___ (
   task_seq_      IN NUMBER,
   duration_hhmm_ IN VARCHAR2,
   field_         IN VARCHAR2)   RETURN NUMBER
IS
   duration_        NUMBER;
   departure_date_  DATE;
   start_date_      DATE;
   end_date_        DATE;
BEGIN
   IF duration_hhmm_ = '00:00' THEN
      RETURN  NULL;
   END IF;
   
   duration_   :=  Adcom_Util_API.Validate_Format_Hours(duration_hhmm_);
   IF duration_ IS NULL  THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDSCHEDHOURS: Enter :P1 Scheduled Hours in the HH:MM format.', field_);
   END IF; 
   
   start_date_       := Av_Exe_Task_API.Get_Arrival_Time(task_seq_);
   departure_date_   := Av_Exe_Task_API.Get_Departure_Time(task_seq_);
   end_date_         := (start_date_ + (1/24*duration_));
   IF departure_date_ < end_date_ THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDASSIGNMENT: :P1 Assignment is outside the schedule time.',field_);
   END IF;
   
   RETURN duration_;
END Validate_Format_Duration_Hours___;


FUNCTION Get_Schedule_Date_And_Interval___ (
   task_seq_         IN NUMBER,
   duration_hhmm_    IN VARCHAR2,
   field_            IN VARCHAR2   )    RETURN Schedule_Interval_Structure_Rec
IS
   duration_               NUMBER;
   schedule_date_interval_ Av_Exe_Task_API.Task_Schedule_Time_Interval_Rec;
   dates_                  Schedule_Interval_Structure_Rec;
BEGIN
   duration_               := NVL(Adcom_Util_API.Validate_Format_Hours(duration_hhmm_),0);
   schedule_date_interval_ := Av_Exe_Task_API.Get_Task_Schedule_Interval(task_seq_);
   dates_.start_date       := schedule_date_interval_.schedule_start;
   dates_.end_date         := (dates_.start_date + (1/24*duration_));
   
   IF schedule_date_interval_.schedule_end < dates_.end_date THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDASSIGNMENT: :P1 Assignment is outside the schedule time.',field_);
   END IF; 
   IF duration_ = 0 THEN
      dates_.pre_schedule_hours := '00:00';
   ELSE
      dates_.pre_schedule_hours := duration_hhmm_;
   END IF;
   RETURN dates_;
END Get_Schedule_Date_And_Interval___;


FUNCTION Get_Schedule_Time_Range___ (
   task_seq_         IN NUMBER,
   duration_hours_   IN NUMBER)    RETURN Schedule_Range_Structure_Rec
IS
   departure_date_   DATE;
   duration_         NUMBER;
   dates_            Schedule_Range_Structure_Rec;
BEGIN
   duration_         :=  NVL(duration_hours_,0);
   dates_.start_date := Av_Exe_Task_API.Get_Arrival_Time(task_seq_);
   departure_date_   := Av_Exe_Task_API.Get_Departure_Time(task_seq_);
   dates_.end_date   := (dates_.start_date + (1/24*duration_));
   IF (departure_date_ < dates_.end_date) THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDASSIGNMENT2: Assignment is outside the schedule time.');
   END IF; 
   RETURN dates_;
END Get_Schedule_Time_Range___;


FUNCTION Validate_Schedule_Range___ (
   task_seq_            IN NUMBER,
   start_date_          IN DATE,
   end_date_            IN DATE,
   schedule_hours_      IN NUMBER,
   field_               IN VARCHAR2)    RETURN BOOLEAN
IS 
   val_schedule_hours_       Schedule_Hours_Structure_Rec;
BEGIN
   val_schedule_hours_         := Validate_Schedule_Dates___(task_seq_,start_date_, end_date_,field_);
   IF val_schedule_hours_.schedule_hours  != schedule_hours_ THEN
      Error_SYS.Record_General(lu_name_, 'EXCEEDINTERVAL: :P1 Scheduled hours exceed the schedule date interval', field_);         
   END IF;
   RETURN TRUE;
END Validate_Schedule_Range___;

FUNCTION Assign_User_To_Competency___ (
   key_           IN Task_Competency_Query_Key,
   assigned_user_ IN VARCHAR2,
   start_stamp_   IN DATE,
   end_stamp_     IN DATE ) RETURN VARCHAR2
IS
   info_                   VARCHAR2(2000);
   attr_                   VARCHAR2(2000);
   dummy_                  NUMBER;
   task_seq_               av_exe_task.task_seq%TYPE;
   task_resource_seq_      jt_task_resource.task_resource_seq%TYPE;
   execution_instance_seq_ jt_execution_instance.execution_instance_seq%TYPE;
   resource_group_seq_     jt_task_resource.resource_group_seq%TYPE;
   start_date_             av_flight_tab.shed_arrival_date_time%TYPE;
   end_date_               av_flight_tab.shed_departure_date_time%TYPE;
   assigned_user_res_seq_  resource_tab.resource_seq%TYPE;
   
   ---- This cursor validates whether the updated assignee belongs to the appropriate resource group.
   CURSOR validate_user_resource_group IS
      SELECT 1
       FROM resource_join_parent
       WHERE resource_parent_seq = resource_group_seq_
       AND resource_seq = assigned_user_res_seq_;
BEGIN
   task_seq_               :=key_.task_seq;
   task_resource_seq_      :=key_.task_resource_seq;
   execution_instance_seq_ :=key_.execution_instance_seq;
   assigned_user_res_seq_  :=Resource_API.Get_Resource_Seq(assigned_user_,'PERSON');
   start_date_     := Av_Exe_Task_API.Get_Arrival_Time(task_seq_);   
   end_date_       := Av_Exe_Task_API.Get_Departure_Time(task_seq_);
   
   IF start_stamp_< start_date_ OR end_stamp_ >end_date_ THEN
      Error_SYS.Record_General(lu_name_, 'INVALIDASSIGNMENT: Assignment is outside the schedule time.');
   END IF;
   
   resource_group_seq_ := Jt_Task_Resource_API.Get_Resource_Group_Seq(task_seq_, task_resource_seq_);
   
   OPEN validate_user_resource_group;
   FETCH validate_user_resource_group INTO dummy_;
   IF validate_user_resource_group%NOTFOUND THEN
      CLOSE validate_user_resource_group;
      Error_SYS.Record_General(lu_name_, 'INVALIDRESGROUPERROR: :P1 does not possess the required skill',assigned_user_);
   ELSE
      CLOSE validate_user_resource_group;
      Client_SYS.Clear_Attr(attr_);
      Client_SYS.Add_To_Attr('RESOURCE_SEQ',assigned_user_res_seq_, attr_); 
      Client_SYS.Add_To_Attr('ALLOCATED_START',start_stamp_, attr_);     
      Client_SYS.Add_To_Attr('ALLOCATED_FINISH',end_stamp_, attr_); 
      Jt_Execution_Instance_API.Modify(info_, attr_, task_seq_, execution_instance_seq_, 'DO');
   END IF;
   
   RETURN Pers_API.Get_Internal_Display_Name(assigned_user_);
   
END Assign_User_To_Competency___;

