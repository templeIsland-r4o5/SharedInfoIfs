@IgnoreUnitTest NoOutParams
PROCEDURE Validate_Sess_User_Resource_Skills___ (
   selection_ IN VARCHAR2)
IS
   fnd_user_                  VARCHAR2(30) := Fnd_Session_API.Get_Fnd_User();
   string_tab_                Utility_SYS.STRING_TABLE;
   token_number_              NUMBER;
   task_seq_                  Jt_Task_Resource_Tab.task_seq%TYPE;
   task_resource_seq_         Jt_Task_Resource_Tab.task_resource_seq%TYPE;
   resource_seq_              Jt_Execution_Instance_Tab.resource_seq%TYPE;
   resource_group_seq_        Jt_Task_Resource_Tab.resource_group_seq%TYPE;
   resource_group_id_         Resource_Tab.resource_id%TYPE;
   resource_id_               Resource_Tab.resource_id%TYPE;
   failed_skill_list_         VARCHAR2(200);
   error_count_               NUMBER := 0;
BEGIN
	resource_seq_ := resource_API.Get_Resource_Seq(fnd_user_, 'PERSON');
   resource_id_   := Resource_API.Get_Resource_Id(resource_seq_);
   IF resource_seq_ IS NULL THEN
      Error_SYS.Appl_General(lu_name_,'USRRESNOTEXIST: :P1 Resource does not exist.', resource_id_);
   END IF;
   
   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_seq_            := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_SEQ');
      task_resource_seq_   := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_RESOURCE_SEQ') ;
      resource_group_seq_  := Jt_Task_Resource_API.Get_Resource_Group_Seq(task_seq_, task_resource_seq_);
      --
      IF (NOT Labour_Assignment_Util_API.Is_Resource_In_Group(resource_seq_, resource_group_seq_)) THEN
         error_count_ := error_count_ + 1;
         resource_group_id_   := Resource_API.Get_Resource_Id(resource_group_seq_);
         IF error_count_ = 1 THEN
            failed_skill_list_ := resource_group_id_;
         ELSE
            failed_skill_list_ := failed_skill_list_ || ', ' || resource_group_id_;
         END IF;
      END IF;
   END LOOP;
   
   IF error_count_ > 0 THEN 
      Error_SYS.Appl_General(lu_name_,'RESSKILLSNOTFOUND: Selected row(s) cannot be assigned because the required :P1 skill(s) have not been assigned to the :P2 resource.', failed_skill_list_, resource_id_);
   END IF;
END Validate_Sess_User_Resource_Skills___;


@IgnoreUnitTest PLSQLInSQL
FUNCTION Validate_Tasks_In_My_Shift___ (
   selection_ IN VARCHAR2) RETURN VARCHAR2
IS
   task_seq_            Work_Task.task_seq%TYPE;   
   gen_task_seq_arr_    Utility_SYS.NUMBER_TABLE;
   string_tab_          Utility_SYS.STRING_TABLE;
   token_number_        NUMBER;
   task_not_in_shift_   VARCHAR2(800);
   gen_task_array_indx_ PLS_INTEGER := 1;
   out_of_shift_found_  NUMBER := 0;
   
   CURSOR get_task_barcodes_not_in_shift(task_seq_arr_ Utility_SYS.NUMBER_TABLE) IS
      SELECT wt.*
      FROM av_exe_task wt WHERE wt.task_seq IN (SELECT COLUMN_VALUE FROM TABLE (task_seq_arr_)) AND wt.task_seq NOT IN (
         SELECT  wt.task_seq
         FROM av_exe_task wt 
         LEFT JOIN resource_capacity rescap ON wt.planned_start BETWEEN rescap.start_time AND rescap.finish_time
         INNER JOIN RESOURCE_tab res ON res.resource_seq = rescap.resource_seq
         WHERE  wt.task_seq IN (SELECT COLUMN_VALUE FROM TABLE (task_seq_arr_))
         AND res.resource_id = (SELECT fnd_session_api.get_fnd_user FROM dual)     
      );
BEGIN
   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_seq_ := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_SEQ');
      gen_task_seq_arr_(gen_task_array_indx_) := task_seq_;
      gen_task_array_indx_ := gen_task_array_indx_ + 1;
   END LOOP;
   
   FOR rec_ IN get_task_barcodes_not_in_shift(gen_task_seq_arr_) LOOP
      IF task_not_in_shift_ IS NULL THEN
         out_of_shift_found_ := 1;
         task_not_in_shift_ := rec_.barcode;
      ELSE
         task_not_in_shift_ := task_not_in_shift_||' , '||rec_.barcode;
      END IF; 
   END LOOP;
   IF out_of_shift_found_ = 1 THEN 
      RETURN task_not_in_shift_;  
   ELSE 
      RETURN '0';
   END IF ;
END Validate_Tasks_In_My_Shift___;

@IgnoreUnitTest NoOutParams
PROCEDURE Proxy_Job_Stop___ (
   task_seq_                  IN NUMBER,
   task_resource_seq_         IN NUMBER,
   execution_instance_seq_    IN NUMBER,
   resource_group_seq_        IN NUMBER,
   assignment_role_           IN VARCHAR2,
   curr_assignment_status_    IN VARCHAR2,
   start_time_                IN DATE,
   scheduled_hours_           IN NUMBER,
   site_                      IN VARCHAR2
   )
IS        
   actual_hours_        NUMBER;
   job_stop_reason_     VARCHAR2(200);
   action_desc_         VARCHAR2(2000);
   one_minute_in_hours_ NUMBER := 0.02;     
   start_date_time_     DATE;
   end_time_            DATE;
BEGIN
   IF curr_assignment_status_ = 'ASSIGNED' THEN
      start_date_time_ := Time_Util_API.Get_Sysdate_In_Utc;
   ELSE
      start_date_time_ := start_time_;
   END IF;
   end_time_        := Time_Util_API.Get_Sysdate_In_Utc;
   actual_hours_    := one_minute_in_hours_;    
   job_stop_reason_ := Av_Flm_Parameter_API.Get_Parameter_Value('PROXY_JOB_STOP_REASON');   
      
   Labour_Assignment_Util_API.Do_Job_Stop(
      task_seq_                  => task_seq_,
      task_resource_seq_         => task_resource_seq_,
      execution_instance_seq_    => execution_instance_seq_,
      resource_group_seq_        => resource_group_seq_,
      assignment_role_           => assignment_role_,
      actual_hours_              => actual_hours_,
      remaining_hours_           => scheduled_hours_,
      start_time_                => start_date_time_,
      end_time_                  => end_time_,
      job_stop_reason_           => job_stop_reason_,
      curr_assignment_status_    => curr_assignment_status_);
      
   action_desc_ := Jt_Incompletion_Cause_API.Get_Description(job_stop_reason_);   
   Save_Proxy_Job_Stop_Action(task_seq_, action_desc_);
END Proxy_Job_Stop___;

@IgnoreUnitTest DMLOperation
PROCEDURE Save_Proxy_Job_Stop_Action (
   task_seq_    IN NUMBER,
   action_desc_ IN VARCHAR2)
IS
   CURSOR get_fault_data (task_seq_ NUMBER) IS
      SELECT fault_id
      FROM av_exe_task
      WHERE task_seq = task_seq_;
   
   CURSOR get_max_action_ord_(fault_id_ NUMBER) IS
      SELECT MAX(action_ord)
      FROM AV_FAULT_ACTION_TAB
      WHERE FAULT_ID = fault_id_;
      
      
   CURSOR get_max_task_action_ord(task_seq_ NUMBER) IS
      SELECT MAX(action_ord)
      FROM AV_EXE_TASK_ACTION_TAB
      WHERE task_seq = task_seq_;
      
   attr_                      VARCHAR2(2000);  
   info_                      VARCHAR2(4000);
   objid_                     VARCHAR2(200);
   objversion_                VARCHAR2(200);
   fault_id_                  NUMBER;
   fault_action_id_var_       NUMBER;
   fault_action_id_           VARCHAR2(200);
   existing_task_action_ord_  NUMBER;
   existing_fault_action_ord_ NUMBER;
   fault_action_ord_          NUMBER        := 1;
   task_action_ord_           NUMBER        := 1;
   action_user_               VARCHAR2(200) := Fnd_Session_API.Get_Fnd_User(); 
   action_date_               DATE          := Time_Util_API.Get_Sysdate_In_Utc;
   
BEGIN
   IF (task_seq_ IS NOT NULL) THEN       
      OPEN  get_max_task_action_ord(task_seq_);
      FETCH get_max_task_action_ord INTO existing_task_action_ord_;
      IF existing_task_action_ord_  IS NOT NULL THEN
         task_action_ord_ := (existing_task_action_ord_ + 1 );
      END IF;
      CLOSE get_max_task_action_ord;
   
      OPEN get_fault_data(task_seq_);
      FETCH get_fault_data INTO fault_id_;
      CLOSE get_fault_data;   

      IF(fault_id_ IS NOT NULL) THEN
         OPEN get_max_action_ord_(fault_id_);
         FETCH get_max_action_ord_ INTO existing_fault_action_ord_;
         IF existing_fault_action_ord_  IS NOT NULL THEN
            fault_action_ord_ := (existing_fault_action_ord_ + 1 );
         END IF;
         CLOSE get_max_action_ord_;

         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('FAULT_ID',     fault_id_,                           attr_);
         Client_SYS.Add_To_Attr('ACTION_USER',  action_user_,   attr_);
         Client_SYS.Add_To_Attr('ACTION_DESC',  action_desc_,   attr_);
         Client_SYS.Add_To_Attr('ACTION_DATE',  action_date_,   attr_);
         Client_SYS.Add_To_Attr('ACTION_ORD',   fault_action_ord_,    attr_);
         Client_SYS.Add_To_Attr('IS_CORRECTIVE','True',                              attr_);
         Av_Fault_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');

         fault_action_id_var_ := Client_SYS.Get_Item_Value('FAULT_ACTION_ID', attr_);
         fault_action_id_     := Client_SYS.Attr_Value_To_Number(fault_action_id_var_);

         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('TASK_SEQ',        task_seq_,     attr_);
         Client_SYS.Add_To_Attr('ACTION_USER',     action_user_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_DESC',     action_desc_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_DATE',     action_date_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_ORD',      task_action_ord_,   attr_);
         Client_SYS.Add_To_Attr('ACTION_TYPE',     'Corrective' ,                      attr_);
         Client_SYS.Add_To_Attr('FAULT_ACTION_ID', fault_action_id_ ,                  attr_);
         Av_Exe_Task_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');

      ELSE            
         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('TASK_SEQ',        task_seq_,     attr_);
         Client_SYS.Add_To_Attr('ACTION_USER',     action_user_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_DESC',     action_desc_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_DATE',     action_date_,  attr_);
         Client_SYS.Add_To_Attr('ACTION_ORD',      task_action_ord_,   attr_);
         Client_SYS.Add_To_Attr('ACTION_TYPE',     'Corrective' ,                      attr_);
         Av_Exe_Task_Action_API.New__(info_, objid_, objversion_, attr_, 'DO');

      END IF;
   END IF;
END Save_Proxy_Job_Stop_Action;

@IgnoreUnitTest MethodOverride
@Override
PROCEDURE CRUD_Create___ (
   rec_ IN Task_Assignments_Virtual_Rec  )
IS
   resource_demand_rec_      Resource_Demands_Virtual_Rec;
   resources_rec_            Resource_Virtual_Rec;
   shift_start_              DATE;
   shift_end_                DATE;
   next_shift_start_         DATE;
   next_shift_end_           DATE;
   demand_assigned_          BOOLEAN := FALSE;
   
   CURSOR get_resource_demands(task_seq_ NUMBER) IS
   SELECT tr.task_seq,tr.task_resource_seq,tr.resource_demand,tr.remark,tr.planned_hours,tr.sched_start,tr.sched_end,tl.license_id,tr.resource_group_seq
   FROM jt_task_resource_demand_av_uiv tr
   LEFT JOIN jt_task_resource_license_tab tl 
   ON tr.task_seq=tl.task_seq AND tr.task_resource_seq=tl.task_resource_seq
   WHERE tr.task_seq=task_seq_ 
   AND NOT EXISTS(SELECT 1 FROM jt_execution_instance_tab jei WHERE jei.task_seq=tr.task_seq AND jei.task_resource_seq=tr.task_resource_seq);
      
   CURSOR get_resources(task_seq_ NUMBER, task_resource_seq_  NUMBER) IS
   SELECT rt.resource_seq,rt.description,COUNT(je.resource_seq) AS total_assignments,COALESCE (ROUND(SUM(je.allocated_hours),0),0) AS total_hours 
   FROM resource_tab rt 
   LEFT JOIN jt_execution_instance_tab je
   ON rt.resource_seq=je.resource_seq AND je.rowstate!= 'COMPLETED'
   INNER JOIN av_exe_task tsk ON
   tsk.task_seq = task_seq_  
   WHERE 
   rt.resource_id IN (SELECT RESOURCE_ID 
                     FROM TABLE(Jt_Task_Resource_License_API.Get_Licence_List(task_seq_=>task_seq_))) 
   AND  EXISTS (SELECT 1 
                FROM user_allowed_site s
                WHERE s.userid=rt.resource_id AND s.contract= tsk.site)
   AND rt.resource_type='PERSON'
   GROUP BY rt.description,rt.resource_seq,rt.resource_id;
     
BEGIN
   super(rec_);
   FOR demand_rec_ IN get_resource_demands(rec_.task_seq) LOOP 
      resource_demand_rec_ := NULL;
      resource_demand_rec_.parent_objkey := rec_.objkey;
      resource_demand_rec_.objkey := sys_guid();
      resource_demand_rec_.task_seq                       := rec_.task_seq;
      resource_demand_rec_.task_resource_seq              := demand_rec_.task_resource_seq;
      resource_demand_rec_.skill_demand                   := demand_rec_.resource_demand;
      resource_demand_rec_.remark                         := demand_rec_.remark;
      resource_demand_rec_.planned_hours                  := Adcom_Util_API.Get_Text_Time(demand_rec_.planned_hours);     
      resource_demand_rec_.sched_start                    := demand_rec_.sched_start;
      resource_demand_rec_.sched_end                      := demand_rec_.sched_end;
      resource_demand_rec_.license_id                     := demand_rec_.license_id; 
      resource_demand_rec_.resource_group_seq             := demand_rec_.resource_group_seq;
      resource_demand_rec_.lb_demand_sched_hours          := demand_rec_.planned_hours;
      CRUD_Create___(resource_demand_rec_);        
      FOR resource_rec_ IN get_resources(task_seq_=>resource_demand_rec_.task_seq,task_resource_seq_=>resource_demand_rec_.task_resource_seq) LOOP 
         shift_start_                             := NULL;
         shift_end_                               := NULL;
         next_shift_start_                        := NULL;
         next_shift_end_                          := NULL;
         resources_rec_                           := NULL;
         resources_rec_.parent_objkey             := resource_demand_rec_.objkey;
         resources_rec_.objkey                    := sys_guid();
         resources_rec_.task_seq                  := resource_demand_rec_.task_seq;
         resources_rec_.task_resource_seq         := resource_demand_rec_.task_resource_seq;
         resources_rec_.resource_seq              := resource_rec_.resource_seq;
         resources_rec_.description               := resource_rec_.description;
         resources_rec_.license_id                := resource_demand_rec_.license_id;
         resources_rec_.total_assignments         := resource_rec_.total_assignments;
         resources_rec_.total_hours               := resource_rec_.total_hours;
         resources_rec_.resource_group_seq        := resource_demand_rec_.resource_group_seq;
         resources_rec_.lb_demand_sched_hours     := resource_demand_rec_.lb_demand_sched_hours;
         Resource_Capacity_API.Get_Period_Start_End(shift_start_, shift_end_, resources_rec_.resource_seq, resource_demand_rec_.sched_start);
         Resource_Capacity_API.Get_Next_Period_Start_End(next_shift_start_, next_shift_end_, resources_rec_.resource_seq, resource_demand_rec_.sched_start);
         resources_rec_.shift_start               := NVL(shift_start_,NVL(next_shift_start_, NULL));
         resources_rec_.shift_end                 := NVL(shift_end_,NVL(next_shift_end_, NULL));
         CRUD_Create___(resources_rec_);
      END LOOP;       
   END LOOP;
END CRUD_Create___;


@IgnoreUnitTest NoOutParams
PROCEDURE Update_Resource_Virtual___ (
   resource_seq_ IN NUMBER,
   lb_demand_sched_hours_ IN NUMBER)
IS
   key_              Resource_Virtual_Key;
   oldrec_           Resource_Virtual_Rec;
   newrec_           Resource_Virtual_Rec;
   
   CURSOR get_resource_rec(resource_seq_ NUMBER) IS 
   SELECT objkey,total_assignments,total_hours 
   FROM ${PROJECTION}_RESOURCE_VIRTUAL_VRT 
   WHERE resource_seq = resource_seq_;
BEGIN
   FOR rec_ IN get_resource_rec (resource_seq_) LOOP 
      key_.objkey                            := rec_.objkey;
      oldrec_                                := Get_Record___(key_);
      newrec_                                := oldrec_;
      newrec_.total_assignments              := rec_.total_assignments+1;
      newrec_.total_hours                    := rec_.total_hours + ROUND(lb_demand_sched_hours_);
      CRUD_UPDATE___(oldrec_,newrec_);
   END LOOP;   
END Update_Resource_Virtual___ ;

@IgnoreUnitTest NoOutParams
PROCEDURE Allocate_Resource_To_Labor_Demand___ (
   task_seq_ IN NUMBER,
   task_resource_seq_ IN NUMBER,
   resource_seq_ IN NUMBER,
   lb_resource_group_seq_ IN NUMBER,
   lb_demand_sched_hours_ IN NUMBER,
   selection_  VARCHAR2)
IS
   key_           Resource_Demands_Virtual_Key;
   rec_           Resource_Demands_Virtual_Rec;
BEGIN
   Labour_Assignment_Util_API.Allocate_Resource_To_Demand(task_seq_, task_resource_seq_,resource_seq_, lb_resource_group_seq_, lb_demand_sched_hours_);
   Update_Resource_Virtual___(resource_seq_, lb_demand_sched_hours_);
   IF selection_ IS NOT NULL THEN 
      key_.objkey := selection_;
      rec_ := Get_Record___(key_);
      --removing the assigned demand from the the resource demands list in the assistant
      CRUD_DELETE___(rec_); 
   END IF;
END Allocate_Resource_To_Labor_Demand___ ;

