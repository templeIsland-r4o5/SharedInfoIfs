@IgnoreUnitTest PLSQLInSQL
FUNCTION Validate_Assignments___ (
   selection_   IN VARCHAR2,
   task_seq_no_ IN NUMBER) RETURN BOOLEAN
IS
   task_seq_                jt_execution_instance.task_seq%TYPE;
   task_resource_seq_       jt_execution_instance.task_resource_seq%TYPE;  
   count_                   NUMBER; 
   gen_task_res_seq_arr_    Utility_SYS.NUMBER_TABLE;
   string_tab_              Utility_SYS.STRING_TABLE;
   token_number_            NUMBER;
   gen_task_res_array_indx_ PLS_INTEGER := 1;
   
   CURSOR get_assigned_assignments(task_seq_ NUMBER, gen_task_res_seq_arr_ Utility_SYS.NUMBER_TABLE) IS
      SELECT 1
      FROM jt_execution_instance_tab jte 
      WHERE jte.task_seq = task_seq_ 
      AND jte.task_resource_seq IN (SELECT COLUMN_VALUE 
                                    FROM TABLE (gen_task_res_seq_arr_));
      
BEGIN       
   task_seq_ := task_seq_no_;
   Utility_SYS.Tokenize(selection_, ';', string_tab_, token_number_);
   task_resource_seq_ := NULL; 
   FOR i_ IN string_tab_.FIRST..string_tab_.LAST LOOP
      task_resource_seq_ := Client_SYS.Get_Key_Reference_Value(string_tab_(i_), 'TASK_RESOURCE_SEQ');
      gen_task_res_seq_arr_(gen_task_res_array_indx_) := task_resource_seq_;
      gen_task_res_array_indx_ := gen_task_res_array_indx_ + 1;
   END LOOP;
   count_ := NULL;     
   OPEN get_assigned_assignments (task_seq_, gen_task_res_seq_arr_);
   FETCH get_assigned_assignments INTO count_;  
   IF (get_assigned_assignments%FOUND) THEN 
      CLOSE get_assigned_assignments;
      RETURN TRUE;
   END IF;
   CLOSE get_assigned_assignments; 
   RETURN FALSE;
END Validate_Assignments___;


@IgnoreUnitTest NoOutParams
FUNCTION Validate_Shift_When_Assign_Task_To_User___ (
   task_seq_     IN NUMBER,
   resource_seq_ IN NUMBER) RETURN NUMBER
IS
   out_of_shift_found_  NUMBER := 0;
   dummy_  NUMBER;
   
   CURSOR get_task_not_in_shift(task_seq_ NUMBER, resource_seq_ NUMBER) IS
      SELECT 1  
      FROM av_exe_task wt
      WHERE wt.task_seq = task_seq_
      AND wt.task_seq NOT IN (
         SELECT wt.task_seq
         FROM av_exe_task wt
         LEFT JOIN resource_capacity rescap 
            ON wt.planned_start BETWEEN rescap.start_time AND rescap.finish_time
         INNER JOIN RESOURCE_tab res 
            ON res.resource_seq = rescap.resource_seq
         WHERE res.resource_seq = resource_seq_
      );
   
BEGIN
   OPEN get_task_not_in_shift(task_seq_, resource_seq_);
   FETCH get_task_not_in_shift INTO dummy_;
   
   IF get_task_not_in_shift%FOUND THEN
      out_of_shift_found_ := 1;   
   END IF;
   
   CLOSE get_task_not_in_shift;
   
   RETURN out_of_shift_found_;
END Validate_Shift_When_Assign_Task_To_User___;

@IgnoreUnitTest NoOutParams
PROCEDURE Pause_Assignment___ (
   task_seq_               IN NUMBER,
   execution_instance_seq_ IN NUMBER)
IS
   CURSOR get_assignment_clockin_time IS
   SELECT start_time
   FROM jt_task_clocking_tab
   WHERE task_seq = task_seq_
   AND execution_instance_seq = execution_instance_seq_
   AND clocking_type = 'CLOCKED_IN'
   AND stop_time IS NULL;
   
   actual_hours_                 NUMBER; 
   end_time_                     DATE;
   start_time_                   DATE;
BEGIN     
   OPEN get_assignment_clockin_time;
   FETCH get_assignment_clockin_time INTO start_time_;
   CLOSE get_assignment_clockin_time;
      
   end_time_ := Time_Util_API.Get_Sysdate_In_Utc;
   actual_hours_ := Adcom_Util_API.Get_Time_Difference_In_Hours(start_time_,end_time_);
                            
   Jt_Task_Clocking_API.Clock_Out_From_Work_Asgmt( task_seq_, execution_instance_seq_, end_time_, actual_hours_, NULL, 'Clock out from MM');
END Pause_Assignment___;

@IgnoreUnitTest NoOutParams
PROCEDURE Continue_Assignment___ (
   task_seq_               IN NUMBER,
   execution_instance_seq_ IN NUMBER ) 
IS
   clocking_seq_                 NUMBER;
   start_time_                   DATE;
BEGIN        
   start_time_ := Time_Util_API.Get_Sysdate_In_Utc;
   Jt_Task_Clocking_API.Clock_In_From_Work_Asgmt(clocking_seq_, task_seq_, execution_instance_seq_, start_time_);
END Continue_Assignment___;

@IgnoreUnitTest NoOutParams
PROCEDURE Modify_Task_Assignment_Schedule_Hour___ (
   task_seq_                  IN NUMBER,
   task_resource_seq_         IN NUMBER,
   labor_scheduled_hours_     IN VARCHAR2,
   sched_start_               IN DATE,
   sched_end_                 IN DATE,
   remark_                    IN VARCHAR2,
   site_                      IN VARCHAR2)
IS
   info_                      VARCHAR2(2000);
   attr_                      VARCHAR2(32000);
   formatted_schedule_hours_  NUMBER;
   objid_                     VARCHAR2(2000);
   objversion_                VARCHAR2(2000);
   execution_instance_seq_    jt_execution_instance_tab.execution_instance_seq%TYPE;
      
   CURSOR get_execution_Instance_rec IS
   SELECT execution_instance_seq
   FROM jt_execution_instance_tab
   WHERE  task_seq = task_seq_
   AND task_resource_seq = task_resource_seq_;
      
BEGIN
      Client_SYS.Clear_Attr(attr_);
      Client_SYS.Add_To_Attr('TASK_SEQ',          task_seq_, attr_);
      Client_SYS.Add_To_Attr('TASK_RESOURCE_SEQ', task_resource_seq_, attr_);     
      formatted_schedule_hours_ := Validate_Format_Duration_Hours___(task_seq_, labor_scheduled_hours_, remark_);
      Client_SYS.Add_To_Attr('PLANNED_HOURS', formatted_schedule_hours_, attr_);
      Jt_Task_Resource_API.Modify(attr_);
 
      OPEN get_execution_Instance_rec;
      FETCH get_execution_Instance_rec INTO execution_instance_seq_;
      CLOSE get_execution_Instance_rec;

   IF(Jt_Execution_Instance_API.Exists(task_seq_, execution_instance_seq_)) THEN 
      Client_SYS.Clear_Attr(attr_);
      Client_SYS.Add_To_Attr('ALLOCATED_START',sched_start_, attr_);     
      Client_SYS.Add_To_Attr('ALLOCATED_FINISH',sched_end_, attr_);
      Jt_Execution_Instance_API.Modify(info_, attr_, task_seq_, execution_instance_seq_, 'DO');
   ELSE
      Labour_Assignment_Util_API.Modify_Planned_Dates(task_seq_, sched_start_, sched_end_);
   END IF;
END Modify_Task_Assignment_Schedule_Hour___;

@IgnoreUnitTest NoOutParams
PROCEDURE Modify_Task_Assignment_Actual_Hour___ (
   task_seq_                  IN NUMBER,
   task_resource_seq_         IN NUMBER,
   actual_hours_              IN VARCHAR2,
   execution_instance_seq_    IN NUMBER,
   resource_group_seq_        IN NUMBER,
   remark_                    IN VARCHAR2)
IS
   formatted_logged_hours_    NUMBER;
   formatted_actual_hours_    NUMBER;
   hour_difference_           NUMBER;
      
BEGIN     
   formatted_logged_hours_ := Jt_Task_Transaction_API.Get_Tot_Personel_Reported_Hrs(task_seq_,execution_instance_seq_);  
   formatted_actual_hours_ := Validate_Format_Duration_Hours___(task_seq_, actual_hours_, remark_);
   hour_difference_        := formatted_actual_hours_ - formatted_logged_hours_;

   Labour_Assignment_Util_API.Adjust_Tsk_Asgmt_Act_Hrs(task_seq_,task_resource_seq_,execution_instance_seq_,hour_difference_,resource_group_seq_);
END Modify_Task_Assignment_Actual_Hour___;

