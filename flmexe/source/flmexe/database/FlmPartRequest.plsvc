layer Core;


FUNCTION Get_Part_Group___ (
   part_ IN NUMBER,
   assembly_type_code_ IN VARCHAR2) RETURN NUMBER
IS
   CURSOR get_part_number IS 
    SELECT  count(av_part_group_part_tab.part_group_id) 
    FROM av_part_group_part_tab
    INNER JOIN av_part_group_tab
    ON av_part_group_part_tab.part_group_id = av_part_group_tab.part_group_id
    WHERE av_part_group_part_tab.part_no_id = part_
    AND(av_part_group_tab.assembly_type_code = assembly_type_code_
    OR  av_part_group_tab.is_common_hardware = 'TRUE');
    
   CURSOR get_part_group_id IS
   SELECT av_part_group_tab.part_group_id 
   FROM av_part_group_part_tab
   INNER JOIN av_part_group_tab
   ON av_part_group_part_tab.part_group_id = av_part_group_tab.part_group_id
   WHERE av_part_group_part_tab.part_no_id = part_
   AND (av_part_group_tab.assembly_type_code = assembly_type_code_
   OR  av_part_group_tab.is_common_hardware = 'TRUE');
    
   count_ NUMBER;
   part_group_id_ NUMBER;
BEGIN
	OPEN get_part_number;
   FETCH get_part_number INTO count_;
   CLOSE get_part_number;
   
   IF count_ = 1 THEN 
   
      OPEN get_part_group_id;
      FETCH get_part_group_id INTO part_group_id_;
      CLOSE get_part_group_id;
   
      RETURN part_group_id_;
   
   ELSE
      RETURN NULL;
   END IF;
END Get_Part_Group___;

-- Remove AD-5002
FUNCTION Get_Aircraft_Type___ (
   part_group_id_ IN NUMBER) RETURN VARCHAR2
IS
   CURSOR get_aircraft_type IS
   SELECT aircraft_type_code
   FROM av_part_group_tab
   WHERE part_group_id = part_group_id_;
   
   aircraft_type_code_ VARCHAR2(10);
BEGIN
	OPEN get_aircraft_type;
   FETCH get_aircraft_type INTO aircraft_type_code_;
   CLOSE get_aircraft_type;
   
   RETURN aircraft_type_code_;
END Get_Aircraft_Type___;

FUNCTION Get_Assembly_Type___ (
   part_group_id_ IN NUMBER) RETURN VARCHAR2
IS
   CURSOR get_assembly_type IS
   SELECT assembly_type_code
   FROM av_part_group_tab
   WHERE part_group_id = part_group_id_;
   
   assembly_type_code_ VARCHAR2(10);
BEGIN
	OPEN get_assembly_type;
   FETCH get_assembly_type INTO assembly_type_code_;
   CLOSE get_assembly_type;
   
   RETURN assembly_type_code_;
END Get_Assembly_Type___;

FUNCTION Get_Config_Slot___ (
   part_group_id_ IN NUMBER) RETURN VARCHAR2
IS
   CURSOR get_config_slot_code IS 
   SELECT config_slot_code
   FROM av_part_group_tab
   WHERE part_group_id = part_group_id_; 
   
   config_slot_code_ VARCHAR2(50);
BEGIN
	OPEN get_config_slot_code;
   FETCH get_config_slot_code INTO config_slot_code_;
   CLOSE get_config_slot_code;
   
   RETURN config_slot_code_;
END Get_Config_Slot___;

FUNCTION Get_Config_Slot_Position___ (
   config_slot_code_ IN VARCHAR2,
   assembly_type_code_ IN VARCHAR2) RETURN NUMBER
IS
   CURSOR get_config_position_count IS 
   SELECT count(config_slot_position_code)
   FROM av_config_slot_position_tab
   WHERE assembly_type_code = assembly_type_code_
   AND config_slot_code = config_slot_code_;
   
   CURSOR get_config_slot_position_id IS
   SELECT config_slot_position_id
   FROM av_config_slot_position_tab
   WHERE assembly_type_code = assembly_type_code_
   AND config_slot_code = config_slot_code_;
   
   count_ NUMBER;
   config_slot_position_id_ NUMBER;
BEGIN
	OPEN get_config_position_count;
   FETCH get_config_position_count INTO count_;
   CLOSE get_config_position_count;
   
   IF count_ = 1 THEN
      OPEN get_config_slot_position_id;
      FETCH get_config_slot_position_id INTO config_slot_position_id_;
      CLOSE get_config_slot_position_id;
      
      RETURN config_slot_position_id_;
   ELSE
      RETURN NULL;
   END IF;
      
END Get_Config_Slot_Position___;

