FUNCTION Get_Task_Alt_Id___ (
   task_seq_ IN NUMBER) RETURN VARCHAR2
IS
BEGIN
	RETURN Av_Exe_Task_API.Get_Av_External_Id(task_seq_);
END Get_Task_Alt_Id___;

@IgnoreUnitTest TrivialFunction
FUNCTION Get_Aircraft_Id___ RETURN Objid_Arr
IS
   result_ Objid_Arr;
   
   CURSOR get_aircraft_ids IS
      SELECT DISTINCT a.rowid
      FROM  aircraft_tab a
      WHERE EXISTS (
          SELECT 1
          FROM av_aircraft_work_package_tab wp
          WHERE a.aircraft_id = wp.aircraft_id
          AND wp.rowstate IN ('InWork', 'Active', 'Committed'));
 
BEGIN
   OPEN get_aircraft_ids;
   FETCH get_aircraft_ids BULK COLLECT INTO result_;
   CLOSE get_aircraft_ids;
   RETURN result_;
END Get_Aircraft_Id___;

@IgnoreUnitTest NoOutParams
PROCEDURE Cancel_Parts___ (
   task_part_id_ IN NUMBER)
IS 
   mtrl_order_no_ NUMBER;
   task_seq_      NUMBER;
   line_item_no_  NUMBER;
   qty_issued_    NUMBER;
   qty_assigned_  NUMBER;
   
   CURSOR Get_mmrl_info_by_tsk_prt_id IS 
     SELECT maint_material_order_no,line_item_no,task_seq 
     FROM av_exe_task_part_tab 
     WHERE task_part_id = task_part_id_;
     
  CURSOR Get_mmrl_qty_info IS 
     SELECT Qty_Assigned,Qty
     FROM Maint_Material_Req_Line_tab 
     WHERE maint_material_order_no = mtrl_order_no_
      AND line_item_no= line_item_no_;
     
BEGIN
   
  OPEN  Get_mmrl_info_by_tsk_prt_id;
  FETCH Get_mmrl_info_by_tsk_prt_id INTO mtrl_order_no_,line_item_no_,task_seq_;
  CLOSE Get_mmrl_info_by_tsk_prt_id;
  
  OPEN  Get_mmrl_qty_info;
  FETCH Get_mmrl_qty_info INTO qty_assigned_,qty_issued_;
  CLOSE Get_mmrl_qty_info;
  
  Av_Exe_Task_Part_API.Update_Cancelled_By(task_part_id_); 
  Av_Exe_Task_Part_API.Update_Task_Part_Ser_Bat_No(task_part_id_, task_seq_, mtrl_order_no_, line_item_no_, qty_issued_, qty_assigned_);
END Cancel_Parts___;

@IgnoreUnitTest DMLOperation
PROCEDURE Select_Interchangeable_Part___ (
   part_number_ IN VARCHAR2,
   manufacturer_code_ IN VARCHAR2,
   conf_slot_code_ IN VARCHAR2,
   conf_slot_pos_code_ IN VARCHAR2,
   part_group_code_ IN VARCHAR2,
   inventory_class_code_ IN VARCHAR2,
   parent_key_ IN VARCHAR2)
IS

   CURSOR get_part_list_key IS
      SELECT objkey, part_name
      FROM Part_List
      WHERE manufacturer = manufacturer_code_ AND 
            part_number = part_number_ AND
            part_group_code = part_group_code_ AND
            inventory_class_code = inventory_class_code_
            FETCH FIRST ROW ONLY;
            
   add_parts_key_                    Add_Parts_Virtual_Key;
   add_parts_new_rec_                Add_Parts_Virtual_Rec;
   add_parts_old_rec_                Add_Parts_Virtual_Rec;
   part_list_key_                    VARCHAR2(100);
   part_name_                        VARCHAR2(1000);
   
BEGIN
   OPEN get_part_list_key;
   FETCH get_part_list_key INTO part_list_key_, part_name_;
   CLOSE get_part_list_key;
   
   IF part_list_key_ IS NOT NULL THEN
      add_parts_key_.Objkey := parent_key_;
      add_parts_old_rec_    := Get_Record___(add_parts_key_);
      add_parts_new_rec_    := add_parts_old_rec_;

      add_parts_new_rec_.part_no_unq_id := part_list_key_;
      CRUD_Update___(add_parts_old_rec_, add_parts_new_rec_);
   ELSE
      Error_SYS.Record_General(lu_name_, 'PRTNOTINMEX: Selected Part is not persisted in the MEX');
   END IF;
END Select_Interchangeable_Part___;

@IgnoreUnitTest PipelinedFunction
FUNCTION Get_Parent_Part_Info___ (
   parent_objkey_ IN VARCHAR2) RETURN Parent_Part_Info_Rec
IS
   parent_part_info_rec_ Parent_Part_Info_Rec;
   task_seq_             NUMBER;
   aircraft_id_          NUMBER;
   task_alt_id_          VARCHAR2(100);
   aircraft_reg_code_    VARCHAR2(100);
   projection_name_      VARCHAR2(100);
   ifs_user_             VARCHAR2(100);
   
   CURSOR Get_Parent_Part_Data IS
      SELECT task_seq, aircraft_id, projection_name  
      FROM ${PROJECTION}_ADD_PARTS_VIRTUAL_VRT 
      WHERE objkey = parent_objkey_;
BEGIN
	OPEN  Get_Parent_Part_Data;
   FETCH Get_Parent_Part_Data INTO task_seq_, aircraft_id_, projection_name_;
   CLOSE Get_Parent_Part_Data;
   
   task_alt_id_       := Get_Task_Alt_Id___(task_seq_);
   aircraft_reg_code_ := Aircraft_API.Get_Reg_Code(aircraft_id_);
   ifs_user_          := Fnd_Session_API.Get_Fnd_User();
   
   parent_part_info_rec_.task_seq          := task_seq_;
   parent_part_info_rec_.task_alt_id       := task_alt_id_;
   parent_part_info_rec_.aircraft_reg_code := aircraft_reg_code_;
   parent_part_info_rec_.projection_name   := projection_name_;
   parent_part_info_rec_.ifs_user          := ifs_user_;
   
   RETURN parent_part_info_rec_;
  
END Get_Parent_Part_Info___;

@IgnoreUnitTest TrivialFunction
FUNCTION Get_Aircraft_Assembly_Info___ (
   aircraft_id_ IN NUMBER) RETURN Aircraft_Assembly_Info_Rec
IS
   aircraft_assembly_info_rec_ Aircraft_Assembly_Info_Rec;
   config_slot_code_           Av_Config_Slot_tab.config_slot_code%TYPE;
   config_slot_position_code_  Av_Config_Slot_Position_tab.config_slot_position_code%TYPE;
   aircraft_type_code_         Av_Config_Slot_tab.aircraft_type_code%TYPE;
   assembly_type_code_         Av_Config_Slot_tab.assembly_type_code%TYPE;
   
   CURSOR Get_Config_Slot IS 
      SELECT config_slot_code
      FROM Av_Config_Slot_tab
      WHERE aircraft_type_code = aircraft_type_code_ AND 
            assembly_type_code = assembly_type_code_ AND 
            class_code = 'ROOT';
   
   CURSOR Get_Assembly_Info IS 
      SELECT Config_slot_position_code
      FROM Av_Config_Slot_Position_tab 
      WHERE config_slot_code = config_slot_code_ AND 
            aircraft_type_code = aircraft_type_code_ AND 
            assembly_type_code = assembly_type_code_
      FETCH FIRST ROW ONLY;
      
BEGIN
   aircraft_type_code_ := Aircraft_API.Get_Aircraft_Type_Code(aircraft_id_);
   assembly_type_code_ := Aircraft_API.Get_Assembly_Type_Code(aircraft_id_);
   
   OPEN Get_Config_Slot;
   FETCH Get_Config_Slot INTO config_slot_code_;
   CLOSE Get_Config_Slot;
   
   OPEN Get_Assembly_Info;
   FETCH Get_Assembly_Info INTO config_slot_position_code_;
   CLOSE Get_Assembly_Info;   
   
   aircraft_assembly_info_rec_.Ac_Config_Slot_Code := config_slot_code_;
   aircraft_assembly_info_rec_.Ac_Config_Slot_Pos_Code := config_slot_position_code_;
   RETURN aircraft_assembly_info_rec_;
END Get_Aircraft_Assembly_Info___;

FUNCTION Get_Aircraft_Info___ (
   aircraft_id_ IN NUMBER) RETURN Parts_Info_Assistant_Structure_Rec
IS
   aircraft_info_rec_ Parts_Info_Assistant_Structure_Rec;
   CURSOR get_aircraft_info IS
      SELECT assembly_type_code, alt_id, applicability_code
      FROM aircraft_tab
      WHERE aircraft_id = aircraft_id_;
BEGIN
   OPEN get_aircraft_info;
   FETCH get_aircraft_info INTO aircraft_info_rec_.assembly_type_code, aircraft_info_rec_.aircraft_alt_id, aircraft_info_rec_.aircraft_app_code;
   CLOSE get_aircraft_info;
   RETURN aircraft_info_rec_;
END Get_Aircraft_Info___;

@IgnoreUnitTest NoOutParams
PROCEDURE Finish___ (
   task_seq_ IN NUMBER,
   maint_material_order_no_ IN NUMBER,
   line_item_no_ IN NUMBER,
   qty_unissued_ IN NUMBER,
   task_part_id_ IN NUMBER,
	info$_ OUT VARCHAR2)
IS
   count_                  NUMBER := 0;  
   wo_no_                  NUMBER;
   quantity_issued_        NUMBER := 0;
   
   
   CURSOR get_inv_transaction_info(task_seq_ IN NUMBER , maint_material_order_no_ IN NUMBER ,line_item_no_ IN NUMBER ) IS     
   SELECT *
   FROM INVENTORY_TRANSACTION_HIST it
   WHERE it.source_ref1 = task_seq_
       AND it.source_ref2 = maint_material_order_no_
       AND it.source_ref3 = line_item_no_
       AND it.transaction_code = 'WTISS'
       AND NOT EXISTS (
                       SELECT 1
                       FROM INVENTORY_TRANSACTION_HIST un
                       WHERE un.original_transaction_id = it.transaction_id
                       );
BEGIN
	
   FOR sel_rec_ IN get_inv_transaction_info(task_seq_,maint_material_order_no_,line_item_no_) LOOP
      quantity_issued_ := NVL(sel_rec_.quantity,0) - NVL(sel_rec_.qty_reversed,0) ;
      
      IF qty_unissued_ > 0  THEN
         count_ := count_ + 1;
         IF qty_unissued_ <= quantity_issued_ THEN
            wo_no_ := Work_Task_Util_API.Get_Wo_No(task_seq_);
            Maint_Material_Req_Line_API.Unissue(task_seq_                => task_seq_,
                                                qty_reversed_            => sel_rec_.qty_reversed,
                                                qty_unissue_             => qty_unissued_,
                                                wo_no_                   => wo_no_,
                                                line_item_no_            => line_item_no_,
                                                quantity_                => sel_rec_.quantity,
                                                transaction_id_          => sel_rec_.transaction_id,
                                                source_                  => sel_rec_.source_ref_type_db,
                                                destination_location_    => sel_rec_.location_no,
                                                catch_qty_               => sel_rec_.catch_quantity);
            
            quantity_issued_ := quantity_issued_ - qty_unissued_;
         ELSE
            Error_SYS.Record_General(lu_name_, 'AVLQTYLESTOUNIS: Available quantity to unissue is :P1.',qty_unissued_);
            info$_ := Client_SYS.Get_All_Info();
         END IF;  
      END IF;  
      
   END LOOP;
   Cancel_Parts___(task_part_id_);
   IF count_ = 0 THEN
      Error_SYS.Record_General(lu_name_, 'QTYUNISHAVVALUE: Quantity to Unissue must have a value');
      info$_ := Client_SYS.Get_All_Info();
   END IF;
END Finish___;

@IgnoreUnitTest TrivialFunction
FUNCTION Get_Assembly_Config_Slot_Info___ (
   assmbl_config_slot_pos_id_ IN NUMBER) RETURN Assembly_Config_Slot_Structure_Rec
IS
   assembly_config_slot_structure_rec_ Assembly_Config_Slot_Structure_Rec;
   config_slot_code_          VARCHAR2(50);
   config_slot_position_code_ VARCHAR2(200);
   
   CURSOR assmbl_config_slot_pos_info IS 
      SELECT config_slot_code, config_slot_position_code
      FROM av_config_slot_position_tab
      WHERE config_slot_position_id = assmbl_config_slot_pos_id_;
BEGIN
   OPEN assmbl_config_slot_pos_info;
   FETCH assmbl_config_slot_pos_info INTO config_slot_code_, config_slot_position_code_;
   CLOSE assmbl_config_slot_pos_info;
   
   assembly_config_slot_structure_rec_.assembly_config_slot_code := config_slot_code_;
   assembly_config_slot_structure_rec_.assembly_config_slot_pos_code := config_slot_position_code_;
   RETURN assembly_config_slot_structure_rec_;
END Get_Assembly_Config_Slot_Info___;
