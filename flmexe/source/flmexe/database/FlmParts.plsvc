   sensitivities_             IN VARCHAR2,
   note_                      IN VARCHAR2)
IS
   fault_part_id_var_         VARCHAR2(32000);
   fault_part_id_             NUMBER;
BEGIN   
   IF (fault_id_ IS NOT NULL) THEN
      Create_Fault_Parts__(
         fault_part_id_             => fault_part_id_var_,
         fault_id_                  => fault_id_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         installed_part_group_id_   => part_group_id_,
         installed_part_number_id_  => part_number_id_,
         installed_quantity_        => required_quantity_,
         installed_serial_no_       => installed_serial_no_
      );
      
      fault_part_id_     := Client_SYS.Attr_Value_To_Number(fault_part_id_var_);        
      
      Create_Task_Parts__(
         fault_part_id_             => fault_part_id_,
         task_seq_                  => task_seq_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         installed_part_group_id_   => part_group_id_,
         installed_part_number_id_  => part_number_id_,
         installed_quantity_        => required_quantity_,
         installed_serial_no_       => installed_serial_no_,
         scheduling_action_         => scheduling_action_,
         maint_material_order_no_   => maint_material_order_no_,
         required_date_             => required_date_,
         part_number_               => part_number_,
         current_user_              => current_user_,
         task_part_id_              => install_task_part_id_,
         parent_key_                => parent_key_,
         sensitivities_             => sensitivities_,
         note_                      => note_
      );
   ELSE
      Create_Task_Parts__(
         task_seq_                  => task_seq_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         installed_part_group_id_   => part_group_id_,
         installed_part_number_id_  => part_number_id_,
         installed_quantity_        => required_quantity_,
         installed_serial_no_       => installed_serial_no_,
         scheduling_action_         => scheduling_action_,
         maint_material_order_no_   => maint_material_order_no_,
         required_date_             => required_date_,
         part_number_               => part_number_,
         current_user_              => current_user_,
         task_part_id_              => install_task_part_id_,
         parent_key_                => parent_key_,
         sensitivities_             => sensitivities_,
         note_                      => note_
      );
   END IF;
END Install_Parts__;

FUNCTION Get_Part_Group_Info___ (
   part_ IN NUMBER,
   assembly_type_code_ IN VARCHAR2, 
   aircraft_id_ IN NUMBER, 
   inventory_class_code_ IN VARCHAR2) RETURN Part_Group_Info_Structure_Rec
IS
   part_group_info_rec_      Part_Group_Info_Structure_Rec;
   aircraft_assembly_        aircraft_tab.assembly_type_code%TYPE;
   part_group_count_         NUMBER;
   part_group_id_            NUMBER;
   assembly_position_count_  NUMBER;
   config_slot_pos_count_    NUMBER;
   
   CURSOR get_part_group_count IS 
      SELECT  count(pgp.part_group_id) 
      FROM av_part_group_part_tab pgp
      INNER JOIN av_part_group_tab pg
      ON pgp.part_group_id = pg.part_group_id
      WHERE pgp.part_no_id = part_
      AND(pg.assembly_type_code = assembly_type_code_
      OR  pg.is_common_hardware = 'TRUE');
    
   CURSOR get_part_group_info IS
      SELECT pg.part_group_id, pg.assembly_type_code, pg.config_slot_code 
      FROM av_part_group_part_tab pgp
      INNER JOIN av_part_group_tab pg
      ON pgp.part_group_id = pg.part_group_id
      WHERE pgp.part_no_id = part_
      AND (pg.assembly_type_code = assembly_type_code_
      OR  pg.is_common_hardware = 'TRUE');
    
   CURSOR get_config_slot_position_id(assembly_type_code_ VARCHAR2, config_slot_code_ VARCHAR2) IS
      SELECT config_slot_position_id
      FROM av_config_slot_position_tab
      WHERE assembly_type_code = assembly_type_code_
      AND config_slot_code = config_slot_code_;
   
   CURSOR get_aircraft_assembly(aircraft_id_ NUMBER) IS
      SELECT assembly_type_code
      FROM aircraft_tab
      WHERE aircraft_id = aircraft_id_;
      
   CURSOR get_config_position_count(assembly_type_code_ VARCHAR2, config_slot_code_ VARCHAR2) IS 
      SELECT count(config_slot_position_code)
      FROM av_config_slot_position_tab
      WHERE assembly_type_code = assembly_type_code_
      AND config_slot_code = config_slot_code_;
   
   CURSOR get_position_count(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT count(config_slot_position_id) 
      FROM av_sub_assy_inventory_tab 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
    
    CURSOR get_assembly_position_id(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT config_slot_position_id 
      FROM av_sub_assy_inventory_tab 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
   
BEGIN
   OPEN  get_part_group_count;
   FETCH get_part_group_count INTO part_group_count_;
   CLOSE get_part_group_count;

   IF part_group_count_ = 1 THEN 
      OPEN  get_part_group_info;
      FETCH get_part_group_info INTO part_group_id_, part_group_info_rec_.assembly_type_code, part_group_info_rec_.config_slot_code;
      CLOSE get_part_group_info;
   
      part_group_info_rec_.part_group_id := part_group_id_;
      part_group_info_rec_.config_slot_status := Av_Config_Slot_API.is_mandatory_config_slot(part_group_id_);
      
      IF part_group_info_rec_.config_slot_code IS NOT NULL THEN
         OPEN  get_config_position_count(assembly_type_code_, part_group_info_rec_.config_slot_code);
         FETCH get_config_position_count INTO config_slot_pos_count_;
         CLOSE get_config_position_count;
         
         IF config_slot_pos_count_ = 1 THEN 
            OPEN  get_config_slot_position_id(assembly_type_code_, part_group_info_rec_.config_slot_code);
            FETCH get_config_slot_position_id INTO part_group_info_rec_.config_slot_position_id;
            CLOSE get_config_slot_position_id;
         END IF;
      END IF;
      
      OPEN  get_aircraft_assembly(aircraft_id_);
      FETCH get_aircraft_assembly INTO aircraft_assembly_;
      CLOSE get_aircraft_assembly;

      IF inventory_class_code_='TRK' AND aircraft_assembly_ != assembly_type_code_ THEN
         part_group_info_rec_.assmbl_visibility := TRUE;
      ELSE
         part_group_info_rec_.assmbl_visibility := FALSE;
      END IF;
   
      OPEN  get_position_count(assembly_type_code_, aircraft_id_);
      FETCH get_position_count INTO assembly_position_count_;
      CLOSE get_position_count;

      IF assembly_position_count_ > 1 THEN
         part_group_info_rec_.assmbl_editable := TRUE;
      ELSE 
         part_group_info_rec_.assmbl_editable := FALSE;
      END IF;
       
      IF assembly_position_count_ = 1 THEN     
         OPEN  get_assembly_position_id(assembly_type_code_, aircraft_id_);
         FETCH get_assembly_position_id INTO part_group_info_rec_.assembly_position_id;
         CLOSE get_assembly_position_id;
      ELSE 
         part_group_info_rec_.assembly_position_id := NULL;
      END IF;
   
      RETURN part_group_info_rec_;
   ELSE
      RETURN NULL;
   END IF;
END Get_Part_Group_Info___;

FUNCTION Get_Assembly_Type___ (
   part_group_id_ IN NUMBER) RETURN VARCHAR2
IS
   CURSOR get_assembly_type IS
   SELECT assembly_type_code
   FROM av_part_group_tab
   WHERE part_group_id = part_group_id_;
   
   assembly_type_code_ VARCHAR2(10);
BEGIN
	OPEN get_assembly_type;
   FETCH get_assembly_type INTO assembly_type_code_;
   CLOSE get_assembly_type;
   
   RETURN assembly_type_code_;
END Get_Assembly_Type___;


FUNCTION Get_Assy_Position___ (
   aircraft_id_ IN NUMBER,
   assembly_type_code_ IN VARCHAR2,
   assmbl_config_slot_pos_id_ IN NUMBER) RETURN NUMBER
IS
   CURSOR get_position IS
   SELECT count(*)
   FROM Av_Sub_Assy_Inventory 
   WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
   
   position_count_ NUMBER;
   position_  NUMBER;
BEGIN
	OPEN  get_position;
   FETCH get_position INTO position_count_;
   CLOSE get_position;
   
   IF position_count_ = 1  THEN
      SELECT config_slot_position_id 
      INTO position_
      FROM Av_Sub_Assy_Inventory 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
 
   ELSIF assmbl_config_slot_pos_id_ IS NOT NULL THEN
      position_ := assmbl_config_slot_pos_id_;
   ELSE 
      position_ := NULL;
   END IF;
   
   RETURN position_;
END Get_Assy_Position___;


@IgnoreUnitTest TrivialFunction
FUNCTION Get_Config_Slot_Status___ (
   part_group_id_ IN NUMBER) RETURN VARCHAR2
IS
BEGIN
	RETURN Av_Config_Slot_API.Is_Mandatory_Config_Slot(part_group_id_);
END Get_Config_Slot_Status___;


FUNCTION Fetch_Add_Part_Defaults___ (
   source_id_               IN  NUMBER,
   inventory_class_code_    IN  VARCHAR2,
   assembly_position_id_    IN  NUMBER,
   config_slot_position_id_ IN  NUMBER,
   is_repairable_           IN  BOOLEAN,
   is_sub_assy_             IN  BOOLEAN,
   source_of_add_part_      IN  VARCHAR2,
   assembly_type_           IN  VARCHAR2,
   aircraft_id_             IN  NUMBER,
   info$_                     OUT VARCHAR2) RETURN Add_Part_Defaults_Structure_Rec
IS
   add_part_requirement_defaults_   Add_Part_Defaults_Structure_Rec;
   
   track_installation_count_  NUMBER;
   track_removal_count_       NUMBER;
   aircraft_assembly_type_    VARCHAR2(100);
   config_slot_code_          VARCHAR2(50);
   config_slot_position_code_ VARCHAR2(200);
   reg_code_                  VARCHAR2(10);
   ifs_user_                  VARCHAR2(100);
      
   CURSOR get_track_installation_for_task IS
   SELECT count(*)
   FROM Av_Exe_Task_Part
   WHERE task_seq = source_id_ AND (assmbly_config_slot_pos_id IS NULL OR assmbly_config_slot_pos_id = assembly_position_id_) AND config_slot_position_id = config_slot_position_id_ AND installed_part_no_id IS NOT NULL;
   
   CURSOR get_track_removal_for_task IS
   SELECT count(*)
   FROM Av_Exe_Task_Part
   WHERE task_seq = source_id_ AND (assmbly_config_slot_pos_id IS NULL OR assmbly_config_slot_pos_id = assembly_position_id_) AND config_slot_position_id = config_slot_position_id_ AND removed_part_no_id IS NOT NULL;   
   
   CURSOR get_track_installation_for_fault IS
   SELECT count(*)
   FROM Av_Fault_Part
   WHERE fault_id = source_id_ AND (assmbly_config_slot_pos_id IS NULL OR assmbly_config_slot_pos_id = assembly_position_id_) AND config_slot_position_id = config_slot_position_id_ AND installed_part_no_id IS NOT NULL;
   
   CURSOR get_track_removal_for_fault IS
   SELECT count(*)
   FROM Av_Fault_Part
   WHERE fault_id = source_id_ AND (assmbly_config_slot_pos_id IS NULL OR assmbly_config_slot_pos_id = assembly_position_id_) AND config_slot_position_id = config_slot_position_id_ AND removed_part_no_id IS NOT NULL;   
   
   CURSOR get_aircraft_Assembly_type IS
   SELECT Assembly_Type_Code 
   FROM Aircraft_tab 
   WHERE Aircraft_Id=aircraft_id_;
   
BEGIN
   add_part_requirement_defaults_.installation_exists  := FALSE;
   add_part_requirement_defaults_.removal_exists       := FALSE;
   add_part_requirement_defaults_.installation_visible := TRUE;
   add_part_requirement_defaults_.removal_visible      := TRUE;
   add_part_requirement_defaults_.Include_Installation := TRUE;
   add_part_requirement_defaults_.Include_Removal      := TRUE;
   
   IF (inventory_class_code_ IN ('SER', 'KIT') OR(inventory_class_code_ = 'BATCH' AND is_repairable_)) THEN    
      add_part_requirement_defaults_.installation_exists := FALSE;
      add_part_requirement_defaults_.removal_exists      := FALSE;
   END IF;
   IF (inventory_class_code_ = 'KIT' OR (inventory_class_code_ = 'BATCH' AND NOT is_repairable_)) THEN
      add_part_requirement_defaults_.installation_exists  := FALSE;
      add_part_requirement_defaults_.Include_Removal      := FALSE;
   END IF;
   IF inventory_class_code_='ASSY' THEN
      OPEN get_aircraft_Assembly_type;
      FETCH get_aircraft_Assembly_type INTO aircraft_assembly_type_;
      CLOSE get_aircraft_Assembly_type;
      IF(aircraft_assembly_type_!=assembly_type_) THEN
         add_part_requirement_defaults_.installation_visible := TRUE;
         add_part_requirement_defaults_.removal_visible      := TRUE;
      END IF;
   END IF;
   IF (inventory_class_code_ IN ('TRK', 'ASSY') AND config_slot_position_id_ IS NOT NULL ) THEN 
      IF (source_of_add_part_ =  'Task') THEN 
         OPEN  get_track_installation_for_task;
         FETCH get_track_installation_for_task INTO track_installation_count_;
         CLOSE get_track_installation_for_task;
         
         OPEN  get_track_removal_for_task;
         FETCH get_track_removal_for_task INTO track_removal_count_;
         CLOSE get_track_removal_for_task;
      ELSE
         OPEN  get_track_installation_for_fault;
         FETCH get_track_installation_for_fault INTO track_installation_count_;
         CLOSE get_track_installation_for_fault;
         
         OPEN  get_track_removal_for_fault;
         FETCH get_track_removal_for_fault INTO track_removal_count_;
         CLOSE get_track_removal_for_fault;
      END IF;
      IF track_installation_count_ > 0 THEN
         add_part_requirement_defaults_.installation_exists  := TRUE;
      END IF;  
      IF track_removal_count_ > 0 THEN
         add_part_requirement_defaults_.removal_exists := TRUE;
      END IF;
   END IF;
   IF(inventory_class_code_ IN ('TRK') AND    is_sub_assy_  AND  (config_slot_position_id_ IS  NULL OR assembly_position_id_ IS NULL )) THEN
      add_part_requirement_defaults_.installation_visible := FALSE;
      add_part_requirement_defaults_.removal_visible      := FALSE;
   ELSE
      IF(inventory_class_code_ IN ('TRK', 'ASSY') AND NOT is_sub_assy_ AND config_slot_position_id_ IS NULL) THEN 
         add_part_requirement_defaults_.installation_visible := FALSE;
         add_part_requirement_defaults_.removal_visible      := FALSE;
      END IF;
   END IF;
   Client_SYS.Clear_Info();
   IF(add_part_requirement_defaults_.installation_exists AND add_part_requirement_defaults_.removal_exists) THEN
      IF(source_of_add_part_ = 'Fault') THEN
         Client_SYS.Add_Info(lu_name_,'EXISTSINSTALLREMOVEFAULT:Installation and removal part requirements already exist in the fault');
      ELSE        
         Client_SYS.Add_Info(lu_name_,'EXISTSINSTALLREMOVETASK:Installation and removal part requirements already exist in the task');
      END IF;
      add_part_requirement_defaults_.Include_Installation := FALSE;
      add_part_requirement_defaults_.Include_Removal      := FALSE;
   END IF;
   IF(add_part_requirement_defaults_.installation_exists AND NOT add_part_requirement_defaults_.removal_exists) THEN
      IF(source_of_add_part_ = 'Fault') THEN
         Client_SYS.Add_Info(lu_name_,'EXISTSINSTALLFAULT:Installation part requirement already exists in the fault');
      ELSE 
         Client_SYS.Add_Info(lu_name_,'EXISTSINSTALLTASK:Installation part requirement already exists in the task');
      END IF;
      add_part_requirement_defaults_.Include_Installation := FALSE;
      add_part_requirement_defaults_.Include_Removal      := TRUE;
   END IF;
   IF((NOT add_part_requirement_defaults_.installation_exists) AND add_part_requirement_defaults_.removal_exists AND(NOT(inventory_class_code_ = 'BATCH' AND NOT is_repairable_)))  THEN
      IF (source_of_add_part_ = 'Fault') THEN
         Client_SYS.Add_Info(lu_name_,'EXISTSREMOVEFAULT:Removal part requirement already exists in the fault');
      ELSE                  
         Client_SYS.Add_Info(lu_name_,'EXISTSREMOVETASK:Removal part requirement already exists in the task');
      END IF;
      add_part_requirement_defaults_.Include_Installation := TRUE;
      add_part_requirement_defaults_.Include_Removal      := FALSE;
   END IF;
   config_slot_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Code(config_slot_position_id_);
   config_slot_position_code_ := Av_Config_Slot_Position_API.Get_Config_Slot_Position_Code(config_slot_position_id_);
   reg_code_ := Aircraft_API.Get_Reg_Code(aircraft_id_);
   ifs_user_ := Fnd_Session_API.Get_Fnd_User();
   add_part_requirement_defaults_.config_slot_code := config_slot_code_;
   add_part_requirement_defaults_.config_slot_position_code := config_slot_position_code_;
   add_part_requirement_defaults_.reg_code := reg_code_;
   add_part_requirement_defaults_.ifs_user := ifs_user_;
   info$_ := Client_SYS.Get_All_Info;
   RETURN add_part_requirement_defaults_;
END Fetch_Add_Part_Defaults___;


FUNCTION Get_Part_Number_Info___ (
   part_number_alt_id_ IN VARCHAR2,
   aircraft_id_ IN NUMBER,
   assembly_type_ IN VARCHAR2) RETURN Av_Part_Info_Structure_Rec
IS
   part_info_rec_    Av_Part_Info_Structure_Rec;
   part_group_id_    av_part_group_tab.part_group_id%TYPE;
   is_repairable_    av_part_number_tab.is_repairable%TYPE;
   sub_assy_count_   NUMBER;
   
   CURSOR get_part_info(part_number_alt_id_ VARCHAR2) IS
      SELECT 
         p.part_number_id, p.inventory_class_code, p.is_repairable, pg.part_group_id, pg.assembly_type_code 
      FROM   
         av_part_number_tab p 
      INNER JOIN av_part_group_part_tab pgp 
      ON pgp.part_no_id = p.part_number_id 
      INNER JOIN av_part_group_tab pg
      ON pg.part_group_id = pgp.part_group_id
      WHERE  p.alt_id = part_number_alt_id_
      AND ((p.inventory_class_code != 'ASSY') OR (p.inventory_class_code = 'ASSY' AND pg.assembly_type_code = assembly_type_))
      AND pgp.rowid IN (SELECT MAX(ipgp.rowid)
                        FROM   av_part_group_part_tab ipgp
                        INNER  JOIN av_part_group_tab ipg  
                        ON     ipgp.part_group_id = ipg.part_group_id
                        GROUP  BY ipgp.part_no_id, ipg.assembly_type_code);
      
   CURSOR get_part_objkey(part_number_id_ NUMBER, part_group_id_ NUMBER) IS
      SELECT objkey 
      FROM part_list
      WHERE part_number_id = part_number_id_
      AND part_group_id = part_group_id_;
      
   CURSOR get_sub_inventory_count(aircraft_id_ NUMBER, assembly_type_ VARCHAR2) IS
      SELECT count(*) 
      FROM   av_sub_assy_inventory_tab
      WHERE  aircraft_id = aircraft_id_
      AND    assembly_type_code = assembly_type_;
      
BEGIN
	OPEN  get_part_info(part_number_alt_id_);
   FETCH get_part_info INTO part_info_rec_.part_number_id, part_info_rec_.inventory_class_code, is_repairable_, part_group_id_, part_info_rec_.part_assembly_type_code;
   CLOSE get_part_info;
   
   IF is_repairable_ = 'TRUE' THEN 
      part_info_rec_.is_repairable := TRUE;
   ELSE 
      part_info_rec_.is_repairable := FALSE;
   END IF;
      
   OPEN  get_part_objkey(part_info_rec_.part_number_id, part_group_id_);
   FETCH get_part_objkey INTO part_info_rec_.vrt_objkey;
   CLOSE get_part_objkey;
      
   OPEN  get_sub_inventory_count(aircraft_id_, assembly_type_);
   FETCH get_sub_inventory_count INTO sub_assy_count_;
   CLOSE get_sub_inventory_count;
   
   IF sub_assy_count_ >= 1 THEN
      part_info_rec_.is_sub_assy := TRUE;
   ELSE
      part_info_rec_.is_sub_assy := FALSE;
   END IF;
   
   RETURN part_info_rec_;
END Get_Part_Number_Info___;

FUNCTION Get_Config_Slot_Info___ (
   config_slot_code_ IN VARCHAR2,
   assembly_type_code_ IN VARCHAR2,
   aircraft_id_ IN NUMBER,
   inventory_class_code_ IN VARCHAR2) RETURN Config_Slot_Info_Structure_Rec
IS
   config_slot_info_rec_    Config_Slot_Info_Structure_Rec;
   conf_slot_pos_count_     NUMBER;
   aircraft_assembly_type_  VARCHAR2(8);
   assembly_position_count_ NUMBER;
   
   CURSOR get_config_position_count(assembly_type_code_ VARCHAR2, config_slot_code_ VARCHAR2) IS 
      SELECT count(config_slot_position_code)
      FROM   av_config_slot_position_tab
      WHERE  assembly_type_code = assembly_type_code_
      AND    config_slot_code = config_slot_code_;
   
   CURSOR get_config_slot_position_id(assembly_type_code_ VARCHAR2, config_slot_code_ VARCHAR2) IS
      SELECT config_slot_position_id
      FROM   av_config_slot_position_tab
      WHERE  assembly_type_code = assembly_type_code_
      AND    config_slot_code = config_slot_code_;
   
   CURSOR get_aircraft_assembly(aircraft_id_ NUMBER) IS
      SELECT assembly_type_code
      FROM   aircraft_tab
      WHERE  aircraft_id = aircraft_id_;  
      
   CURSOR get_position_count(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT count(*)
      FROM av_sub_assy_inventory 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
   
   CURSOR get_assembly_position_id(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT config_slot_position_id 
      FROM   av_sub_assy_inventory 
      WHERE  assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;

BEGIN
   OPEN  get_config_position_count(assembly_type_code_, config_slot_code_);
   FETCH get_config_position_count INTO conf_slot_pos_count_;
   CLOSE get_config_position_count;
   
   IF conf_slot_pos_count_ = 1 THEN
      OPEN  get_config_slot_position_id(assembly_type_code_, config_slot_code_);
      FETCH get_config_slot_position_id INTO config_slot_info_rec_.config_slot_position_id;
      CLOSE get_config_slot_position_id;
   END IF;
   
   OPEN  get_aircraft_assembly(aircraft_id_);
   FETCH get_aircraft_assembly INTO aircraft_assembly_type_;
   CLOSE get_aircraft_assembly;

   IF inventory_class_code_='TRK' AND aircraft_assembly_type_ != assembly_type_code_ THEN
      config_slot_info_rec_.assmbl_visibility := TRUE;
   ELSE
      config_slot_info_rec_.assmbl_visibility := FALSE;
   END IF;
   
   OPEN  get_position_count(assembly_type_code_, aircraft_id_);
   FETCH get_position_count INTO assembly_position_count_;
   CLOSE get_position_count;
   
   IF assembly_position_count_ > 1 THEN
      config_slot_info_rec_.assmbl_editable := TRUE;
   ELSE
      config_slot_info_rec_.assmbl_editable := FALSE;
   END IF;
   
   IF assembly_position_count_ = 1  THEN
      OPEN  get_assembly_position_id(assembly_type_code_, aircraft_id_);
      FETCH get_assembly_position_id INTO config_slot_info_rec_.assmbl_config_slot_pos_id;
      CLOSE get_assembly_position_id;
   END IF;
   
   RETURN config_slot_info_rec_;
END Get_Config_Slot_Info___;


FUNCTION Get_Removal_Part_Info___ (
   removal_part_number_alt_id_ IN VARCHAR2,
   removal_part_group_alt_id_ IN VARCHAR2) RETURN Removal_Part_Info_Struct_Rec
IS
   removal_part_info_struct_rec_ Removal_Part_Info_Struct_Rec;
   part_id_ NUMBER;
   part_group_id_ NUMBER;
   
   CURSOR get_part_group_id(removal_part_group_alt_id_ VARCHAR2) IS
      SELECT part_group_id
      FROM   av_part_group_tab
      WHERE  alt_id = removal_part_group_alt_id_;
      
   CURSOR get_part_id(removal_part_number_alt_id_ VARCHAR2) IS
      SELECT part_number_id
      FROM   av_part_number_tab
      WHERE  alt_id = removal_part_number_alt_id_;
BEGIN
   IF removal_part_number_alt_id_ IS NOT NULL THEN 
      OPEN get_part_id(removal_part_number_alt_id_);
      FETCH get_part_id INTO part_id_;
      CLOSE get_part_id;
   END IF;

   IF removal_part_group_alt_id_ IS NOT NULL THEN 
      OPEN get_part_group_id(removal_part_group_alt_id_);
      FETCH get_part_group_id INTO part_group_id_;
      CLOSE get_part_group_id;
   END IF;
   
   IF part_id_ IS NOT NULL THEN
      removal_part_info_struct_rec_.removal_part_no_id := part_id_;
   END IF;
   
   IF part_group_id_ IS NOT NULL THEN
      removal_part_info_struct_rec_.removal_part_group_id := part_group_id_;
   END IF;  
  RETURN removal_part_info_struct_rec_;
   
END Get_Removal_Part_Info___;


FUNCTION Get_Assembly_Info___ (
   assembly_type_code_   IN VARCHAR2,
   aircraft_id_          IN NUMBER,
   inventory_class_code_ IN VARCHAR2,
   part_group_id_        IN NUMBER) RETURN Part_Group_Info_Structure_Rec
IS
   part_group_info_rec_      Part_Group_Info_Structure_Rec;
   aircraft_assembly_        aircraft_tab.assembly_type_code%TYPE;
   assembly_position_count_  NUMBER;
   
   CURSOR get_aircraft_assembly(aircraft_id_ NUMBER) IS
      SELECT assembly_type_code
      FROM   aircraft_tab
      WHERE  aircraft_id = aircraft_id_; 
      
   CURSOR get_asmbl_position_count(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT count(config_slot_position_id) 
      FROM av_sub_assy_inventory_tab 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
      
   CURSOR get_assembly_position_id(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT config_slot_position_id 
      FROM av_sub_assy_inventory_tab 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
      
   CURSOR get_part_group_alt_id(part_group_id_ IN NUMBER) IS
      SELECT alt_id
      FROM av_part_group_tab 
      WHERE part_group_id = part_group_id_;

BEGIN
	OPEN  get_aircraft_assembly(aircraft_id_);
   FETCH get_aircraft_assembly INTO aircraft_assembly_;
   CLOSE get_aircraft_assembly;
   
   IF inventory_class_code_='TRK' AND aircraft_assembly_ != assembly_type_code_ THEN
      part_group_info_rec_.assmbl_visibility := TRUE;
   ELSE
      part_group_info_rec_.assmbl_visibility := FALSE;
   END IF;
   
   OPEN  get_asmbl_position_count(assembly_type_code_, aircraft_id_);
   FETCH get_asmbl_position_count INTO assembly_position_count_;
   CLOSE get_asmbl_position_count;
   
   IF assembly_position_count_ > 1 THEN
      part_group_info_rec_.assmbl_editable := TRUE;
   ELSE 
      part_group_info_rec_.assmbl_editable := FALSE;
   END IF;
   
   IF assembly_position_count_ = 1 THEN     
      OPEN  get_assembly_position_id(assembly_type_code_, aircraft_id_);
      FETCH get_assembly_position_id INTO part_group_info_rec_.assembly_position_id;
      CLOSE get_assembly_position_id;
   ELSE 
      part_group_info_rec_.assembly_position_id := NULL;
   END IF;
   
   OPEN  get_part_group_alt_id(part_group_id_);
   FETCH get_part_group_alt_id INTO part_group_info_rec_.part_group_alt_id;
   CLOSE get_part_group_alt_id;
   
   RETURN part_group_info_rec_;
END Get_Assembly_Info___;

@IgnoreUnitTest PipelinedFunction
FUNCTION Get_Scheduling_Req_Date___ (
   aircraft_wp_id_ IN NUMBER) RETURN DATE
IS
BEGIN 
   RETURN Av_Exe_Task_Part_Util_API.Get_Scheduling_Req_Date(aircraft_wp_id_);
END Get_Scheduling_Req_Date___;

@IgnoreUnitTest PipelinedFunction
FUNCTION Validate_Required_Date___ (
   aircraft_wp_id_ IN NUMBER,
   required_date_ IN DATE,
   current_date_ IN DATE) RETURN Validate_Message_Info_Structure_Rec
IS
   result_     Av_Exe_Task_Part_Util_API.Validate_Message_Rec := Av_Exe_Task_Part_Util_API.Validate_Message_Rec();
   ui_result_  Validate_Message_Info_Structure_Rec := Validate_Message_Info_Structure_Rec();
BEGIN
   result_ := Av_Exe_Task_Part_Util_API.Validate_Scheduling_Req_Date(aircraft_wp_id_, required_date_, current_date_);
   ui_result_.message_type := result_.message_type;
   ui_result_.message      := result_.message;
   RETURN ui_result_;
END Validate_Required_Date___;

@IgnoreUnitTest TrivialFunction
FUNCTION Is_Modified___ (
   key_ IN Add_Parts_Virtual_Key) RETURN BOOLEAN
IS
   add_part_vrt_rec_ Add_Parts_Virtual_Rec;
BEGIN
   add_part_vrt_rec_ := Get_Record___(key_);

   RETURN (add_part_vrt_rec_.part                 != add_part_vrt_rec_.orgnl_part OR
      add_part_vrt_rec_.part_group_id             != add_part_vrt_rec_.orgnl_part_group_id OR
      add_part_vrt_rec_.required_quantity         != add_part_vrt_rec_.orgnl_required_quantity OR
      add_part_vrt_rec_.required_date             != add_part_vrt_rec_.default_required_date OR
      add_part_vrt_rec_.config_slot_position_id   != add_part_vrt_rec_.orgnl_config_slot_position_id OR
      add_part_vrt_rec_.scheduling_action         != 'REQ' OR
      add_part_vrt_rec_.assmbl_config_slot_pos_id != add_part_vrt_rec_.orgnl_assmbl_config_slot_pos_id OR
      add_part_vrt_rec_.removal_reason_code       != add_part_vrt_rec_.orgnl_removal_reason_code OR
      add_part_vrt_rec_.include_installation      != TRUE OR
      add_part_vrt_rec_.include_removal           != (add_part_vrt_rec_.removed_task_part_id IS NOT NULL)
      );
END Is_Modified___;

@IgnoreUnitTest DMLOperation
PROCEDURE Modify_Part___ (
   key_               IN Add_Parts_Virtual_Key,
   part_number_       IN VARCHAR2,
   removal_serial_no_ IN VARCHAR2,
   sensitivities_     IN VARCHAR2)
IS
   info_                  VARCHAR2(200);
   inst_objid_            VARCHAR2(200);
   inst_objversion_       VARCHAR2(200);
   rem_objid_             VARCHAR2(200);
   rem_objversion_        VARCHAR2(200);
   fault_inst_objid_      VARCHAR2(200);
   fault_inst_objversion_ VARCHAR2(200);
   fault_rem_objid_       VARCHAR2(200);
   fault_rem_objversion_  VARCHAR2(200);
   attr_                  VARCHAR2(32000);
   fault_attr_            VARCHAR2(32000);
   add_part_vrt_rec_      Add_Parts_Virtual_Rec;
   reserved_qty_          NUMBER;
   sched_action_req_      CONSTANT VARCHAR2(10) := 'REQ';
   action_do_             CONSTANT VARCHAR2(10) := 'DO';
   task_seq_              NUMBER;
   task_part_id_          NUMBER;
   out_task_part_id_var_  VARCHAR2(20) := NULL;
   class_code_            VARCHAR2(20);
   quantity_one_          NUMBER := 1;
   current_user_          VARCHAR2(40);
   out_inst_task_part_id_ NUMBER;
   inst_fault_part_id_    NUMBER;
   rmvd_fault_part_id_    NUMBER;
   fault_id_              NUMBER;
   fault_part_id_         NUMBER;
   out_fault_part_id_var_ VARCHAR2(20) := NULL;
   
   -- Flags to track attribute changes
   part_changed_             BOOLEAN;
   part_group_changed_       BOOLEAN;
   qty_changed_              BOOLEAN;
   config_slot_changed_      BOOLEAN;
   assmbl_slot_changed_      BOOLEAN;
   sched_action_not_req_     BOOLEAN;
   required_date_changed_    BOOLEAN;
   removal_reason_changed_   BOOLEAN;
   note_changed_             BOOLEAN;
   
   CURSOR get_part_rec_details(task_part_id_ IN NUMBER) IS
      SELECT rowid, TO_CHAR(rowversion,'YYYYMMDDHH24MISS')
      FROM av_exe_task_part_tab
      WHERE task_part_id = task_part_id_;
   
   CURSOR get_mmrl_info(maint_material_order_no_ IN NUMBER, line_item_no_ IN NUMBER) IS
      SELECT qty_assigned
      FROM Maint_Material_Req_Line_Av_Uiv
      WHERE maint_material_order_no = maint_material_order_no_
        AND line_item_no = line_item_no_;
        
    CURSOR get_fault_part_rec_details(fault_part_id_ IN NUMBER) IS
      SELECT rowid, TO_CHAR(rowversion,'YYYYMMDDHH24MISS')
      FROM av_fault_part_tab
      WHERE fault_part_id = fault_part_id_;
BEGIN
   add_part_vrt_rec_ := Get_Record___(key_);
   
   task_seq_               := add_part_vrt_rec_.task_seq;
   
   part_changed_           := add_part_vrt_rec_.part != add_part_vrt_rec_.orgnl_part;
   part_group_changed_     := add_part_vrt_rec_.part_group_id != add_part_vrt_rec_.orgnl_part_group_id;
   qty_changed_            := add_part_vrt_rec_.required_quantity != add_part_vrt_rec_.orgnl_required_quantity;
   config_slot_changed_    := add_part_vrt_rec_.config_slot_position_id != add_part_vrt_rec_.orgnl_config_slot_position_id;
   assmbl_slot_changed_    := add_part_vrt_rec_.assmbl_config_slot_pos_id != add_part_vrt_rec_.orgnl_assmbl_config_slot_pos_id;
   sched_action_not_req_   := NVL(add_part_vrt_rec_.scheduling_action,'EmptySchedAction') != sched_action_req_;
   required_date_changed_  := add_part_vrt_rec_.required_date != add_part_vrt_rec_.default_required_date;
   removal_reason_changed_ := NVL(add_part_vrt_rec_.removal_reason_code, 'EmptyRemovalReason') != NVL(add_part_vrt_rec_.orgnl_removal_reason_code, 'EmptyRemovalReason');
   note_changed_           := NVL(add_part_vrt_rec_.note, 'EmptyNote') != NVL(add_part_vrt_rec_.orgnl_note, 'EmptyNote');
   
   inst_fault_part_id_ := Av_Exe_Task_Part_API.Get_Fault_Part_Id(add_part_vrt_rec_.installed_task_part_id);
   rmvd_fault_part_id_ := Av_Exe_Task_Part_API.Get_Fault_Part_Id(add_part_vrt_rec_.removed_task_part_id);
   
   IF NOT add_part_vrt_rec_.include_installation THEN
      Av_Exe_Task_Part_API.Remove(add_part_vrt_rec_.installed_task_part_id);     
      -- remove fault part installation line
      IF inst_fault_part_id_ IS NOT NULL THEN
         Av_Fault_Part_API.Remove(inst_fault_part_id_);
      END IF;
   ELSE
      -- Modify install record    
      Client_SYS.Clear_Attr(attr_);
      IF part_changed_ THEN
         Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID', add_part_vrt_rec_.part, attr_);
      END IF;
      IF part_group_changed_ THEN
         Client_SYS.Add_To_Attr('PART_GROUP_ID', add_part_vrt_rec_.part_group_id, attr_); 
      END IF;
      IF config_slot_changed_ THEN
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID', add_part_vrt_rec_.config_slot_position_id, attr_);
      END IF;
      IF assmbl_slot_changed_ THEN
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', add_part_vrt_rec_.assmbl_config_slot_pos_id, attr_);
      END IF;
      IF sched_action_not_req_ THEN
         Client_SYS.Add_To_Attr('SCHEDULING_ACTION', add_part_vrt_rec_.scheduling_action, attr_);
         Client_SYS.Add_To_Attr('MAINT_MATERIAL_ORDER_NO', '', attr_);
         Client_SYS.Add_To_Attr('LINE_ITEM_NO', '', attr_);
         Client_SYS.Add_To_Attr('NOTE', '', attr_);
      END IF;
      IF qty_changed_ THEN
         IF (add_part_vrt_rec_.inventory_class_code = 'SER' AND add_part_vrt_rec_.required_quantity > 1) THEN
            current_user_ := Fnd_Session_API.Get_Fnd_User();
            FOR i IN 1 .. (add_part_vrt_rec_.required_quantity - 1) LOOP
               Install_Parts__(add_part_vrt_rec_.fault_id, add_part_vrt_rec_.task_seq, add_part_vrt_rec_.assmbl_config_slot_pos_id, add_part_vrt_rec_.config_slot_position_id, add_part_vrt_rec_.part_group_id, add_part_vrt_rec_.part , quantity_one_, add_part_vrt_rec_.installed_serial_no, add_part_vrt_rec_.scheduling_action, add_part_vrt_rec_.required_date, part_number_, current_user_, add_part_vrt_rec_.maint_material_order_no, out_inst_task_part_id_, add_part_vrt_rec_.objkey, add_part_vrt_rec_.D_B_Formatted_P_G_Sensitivity,add_part_vrt_rec_.note); 
               IF (add_part_vrt_rec_.include_removal) THEN
                  Remove_Parts__ (add_part_vrt_rec_.fault_id, add_part_vrt_rec_.task_seq, add_part_vrt_rec_.assmbl_config_slot_pos_id, add_part_vrt_rec_.config_slot_position_id, add_part_vrt_rec_.part_group_id, add_part_vrt_rec_.part_group_id, add_part_vrt_rec_.part, add_part_vrt_rec_.part, quantity_one_, add_part_vrt_rec_.removal_reason_code, add_part_vrt_rec_.removal_serial_no, add_part_vrt_rec_.is_removal_reason_filled,out_inst_task_part_id_,add_part_vrt_rec_.D_B_Formatted_P_G_Sensitivity,current_user_); 
               END IF;
            END LOOP;
         ELSE
            Client_SYS.Add_To_Attr('INSTALLED_QUANTITY', add_part_vrt_rec_.required_quantity, attr_);
         END IF; 
      END IF;
      
   IF (attr_ IS NOT NULL) THEN
      --Modify Fault Parts      
      IF inst_fault_part_id_ IS NOT NULL THEN
         fault_attr_ := attr_;
         OPEN  get_fault_part_rec_details(inst_fault_part_id_);
         FETCH get_fault_part_rec_details INTO fault_inst_objid_, fault_inst_objversion_;
         CLOSE get_fault_part_rec_details;
         Av_Fault_Part_API.Modify(inst_fault_part_id_, fault_attr_);
      END IF;
      
      OPEN get_part_rec_details(add_part_vrt_rec_.installed_task_part_id);
      FETCH get_part_rec_details INTO inst_objid_, inst_objversion_;
      CLOSE get_part_rec_details;
      Av_Exe_Task_Part_API.Modify__(info_, inst_objid_, inst_objversion_, attr_, action_do_);
   END IF;
END IF;

-- Modify removal record
IF add_part_vrt_rec_.removed_task_part_id IS NOT NULL THEN
   IF add_part_vrt_rec_.include_removal THEN
      Client_SYS.Clear_Attr(attr_);
      OPEN get_part_rec_details(add_part_vrt_rec_.removed_task_part_id);
      FETCH get_part_rec_details INTO rem_objid_, rem_objversion_;
      CLOSE get_part_rec_details;
      
      IF part_changed_ THEN
         Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID', add_part_vrt_rec_.part, attr_);
      END IF;
      IF part_group_changed_ THEN
         Client_SYS.Add_To_Attr('PART_GROUP_ID', add_part_vrt_rec_.part_group_id, attr_);            
      END IF;
      IF qty_changed_ THEN
         IF (add_part_vrt_rec_.inventory_class_code = 'BATCH' AND add_part_vrt_rec_.required_quantity > 1) THEN
            Client_SYS.Add_To_Attr('REMOVED_QUANTITY', add_part_vrt_rec_.required_quantity, attr_);
         END IF;
      END IF;
      IF config_slot_changed_ THEN
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID', add_part_vrt_rec_.config_slot_position_id, attr_);
      END IF;
      IF assmbl_slot_changed_ THEN
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', add_part_vrt_rec_.assmbl_config_slot_pos_id, attr_);
      END IF;
      IF removal_reason_changed_ THEN
         Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE', add_part_vrt_rec_.removal_reason_code, attr_);
      END IF;
      IF removal_serial_no_ IS NOT NULL THEN
         Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO', removal_serial_no_, attr_);
      END IF;
      IF (attr_ IS NOT NULL) THEN
          --Modify Fault Parts
         IF rmvd_fault_part_id_ IS NOT NULL THEN
            fault_attr_ := attr_;
            Av_Fault_Part_API.Modify(rmvd_fault_part_id_, fault_attr_);
         END IF;
         Av_Exe_Task_Part_API.Modify__(info_, rem_objid_, rem_objversion_, attr_, action_do_);
      END IF;
   ELSE
      Av_Exe_Task_Part_API.Remove(add_part_vrt_rec_.removed_task_part_id);
      -- remove fault part removal line
      IF rmvd_fault_part_id_ IS NOT NULL THEN
         OPEN  get_fault_part_rec_details(rmvd_fault_part_id_);
         FETCH get_fault_part_rec_details INTO  fault_rem_objid_, fault_rem_objversion_;
         CLOSE get_fault_part_rec_details;
         
         Av_Fault_Part_API.Remove(rmvd_fault_part_id_);
      END IF;
   END IF;
ELSIF add_part_vrt_rec_.include_removal THEN
   fault_id_  := AV_EXE_TASK_API.Get_Fault_Id (task_seq_);
   
   Client_SYS.Clear_Attr(attr_); 
   Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID', add_part_vrt_rec_.part, attr_);
   Client_SYS.Add_To_Attr('PART_GROUP_ID', add_part_vrt_rec_.part_group_id, attr_);
   IF (add_part_vrt_rec_.inventory_class_code = 'BATCH' AND add_part_vrt_rec_.required_quantity > 1) THEN
      Client_SYS.Add_To_Attr('REMOVED_QUANTITY', add_part_vrt_rec_.required_quantity, attr_);
   ELSE
      Client_SYS.Add_To_Attr('REMOVED_QUANTITY', quantity_one_, attr_);
   END IF;
   Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID', add_part_vrt_rec_.config_slot_position_id, attr_);
   Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', add_part_vrt_rec_.assmbl_config_slot_pos_id, attr_);
   Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE', add_part_vrt_rec_.removal_reason_code, attr_);
   IF removal_serial_no_ IS NOT NULL THEN
      Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO', removal_serial_no_, attr_);
   END IF;
   IF fault_id_ IS NOT NULL THEN
      Client_SYS.Add_To_Attr('FAULT_ID', fault_id_, attr_);
      fault_attr_ := attr_;
      Av_Fault_Part_API.New__(info_, fault_rem_objid_, fault_rem_objversion_, fault_attr_ ,action_do_);
      out_fault_part_id_var_ := Client_SYS.Get_Item_Value('FAULT_PART_ID', fault_attr_);
      fault_part_id_ := Client_SYS.Attr_Value_To_Number(out_fault_part_id_var_);
      Client_SYS.Add_To_Attr('FAULT_PART_ID', fault_part_id_, attr_);
   END IF; 
   
   Client_SYS.Add_To_Attr('TASK_SEQ', task_seq_, attr_);
   Client_SYS.Add_To_Attr('INSTALL_TASK_PART_ID', add_part_vrt_rec_.installed_task_part_id, attr_);
   Av_Exe_Task_Part_API.New__(info_, rem_objid_, rem_objversion_, attr_,action_do_);
  
   out_task_part_id_var_ := Client_SYS.Get_Item_Value('TASK_PART_ID', attr_);
   task_part_id_ := Client_SYS.Attr_Value_To_Number(out_task_part_id_var_);
   
   IF task_seq_ IS NOT NULL THEN 
      class_code_ := Av_Exe_Task_API.Get_Class_Code(task_seq_);
      IF (class_code_ = Av_Exe_Task_API.TASK_CLASS_CORR AND sensitivities_ IS NOT NULL) THEN 
         Av_Exe_Task_Part_Sens_API.Save_Effective_Sensitivities(task_seq_,task_part_id_,sensitivities_);
      END IF;   
   END IF;
END IF;

-- Modify MMRL
OPEN get_mmrl_info(add_part_vrt_rec_.Maint_Material_Order_No, add_part_vrt_rec_.Line_Item_No);
FETCH get_mmrl_info INTO reserved_qty_;
CLOSE get_mmrl_info;

IF reserved_qty_ > 0 THEN
   IF sched_action_not_req_ OR part_changed_ OR (qty_changed_ AND add_part_vrt_rec_.required_quantity < reserved_qty_) THEN
      Maint_Material_Req_Line_API.Unreserve_Lines(
         add_part_vrt_rec_.Maint_Material_Order_No,
         add_part_vrt_rec_.Line_Item_No
         );
   END IF;
END IF;

Client_SYS.Clear_Attr(attr_);
IF NOT sched_action_not_req_ THEN
   IF part_changed_ THEN
      Client_SYS.Add_To_Attr('PART_NO', part_number_, attr_);
   END IF;
   IF qty_changed_ THEN
      IF (add_part_vrt_rec_.inventory_class_code = 'BATCH' AND add_part_vrt_rec_.required_quantity > 1) THEN
         Client_SYS.Add_To_Attr('PLAN_QTY', add_part_vrt_rec_.required_quantity, attr_);
      END IF;
   END IF;
   IF required_date_changed_ THEN
      Client_SYS.Add_To_Attr('DATE_REQUIRED', add_part_vrt_rec_.required_date, attr_);
   END IF;
   IF note_changed_ THEN
      Client_SYS.Add_To_Attr('NOTE', add_part_vrt_rec_.note, attr_);
   END IF;
   IF (attr_ IS NOT NULL) THEN
      Maint_Material_Req_Line_API.Update_Material_Line(add_part_vrt_rec_.Maint_Material_Order_No, add_part_vrt_rec_.Line_Item_No, attr_);
   END IF;
ELSE
   Maint_Material_Req_Line_API.Delete_Material_Line(add_part_vrt_rec_.Maint_Material_Order_No, add_part_vrt_rec_.Line_Item_No, 'TRUE');
END IF;
END Modify_Part___;

@IgnoreUnitTest PipelinedFunction
FUNCTION Get_Removal_Reasons_For_Part___ (
   is_sos_ IN BOOLEAN ) RETURN Objid_Arr
IS
   is_sos_var_    VARCHAR2(10);
   collection_    Objid_Arr   := Objid_Arr();
   CURSOR get_removal_reasons (sos_var_ VARCHAR2) IS
      SELECT rowid
      FROM   av_removal_reason_tab
      WHERE  (sos_var_ = 'TRUE' OR UPPER(removal_reason_code) <> 'SOS');
BEGIN
   is_sos_var_ := CASE WHEN is_sos_ THEN 'TRUE' ELSE 'FALSE' END;
   
   OPEN get_removal_reasons(is_sos_var_);
   FETCH get_removal_reasons BULK COLLECT INTO collection_;
   CLOSE get_removal_reasons;
   RETURN collection_;
END Get_Removal_Reasons_For_Part___;

@IgnoreUnitTest DMLOperation
PROCEDURE Clear_Interchangeable_Parts___ (
   parent_key_ IN VARCHAR2)
IS
BEGIN
	DELETE FROM ${PROJECTION}_ALTERNATE_PART_VIRTUAL_VRT WHERE parent_objkey = parent_key_;
END Clear_Interchangeable_Parts___;

@IgnoreUnitTest DMLOperation
PROCEDURE Create_Interchange_Parts (
   task_seq_   IN NUMBER,
   order_no_   IN NUMBER,
   line_no_    IN NUMBER,
   parent_key_ IN VARCHAR2)
IS
   standard_part_      VARCHAR2(100);
   contract_           VARCHAR2(50);
   
   CURSOR Get_Interchange_Parts IS
      SELECT * FROM ${PROJECTION}_ALTERNATE_PART_VIRTUAL_VRT 
      WHERE parent_objkey = parent_key_;
   
BEGIN
   contract_ := Work_Task_API.Get_Site(task_seq_);
   FOR Interchange_Part_rec IN Get_Interchange_Parts LOOP 
      IF (Interchange_Part_rec.is_selected_part = 'Yes' OR Interchange_Part_rec.is_selected_part = 'YES') THEN
         standard_part_ := Fnd_Boolean_API.DB_TRUE;
      ELSE
         standard_part_ := Fnd_Boolean_API.DB_FALSE;
      END IF;
      Source_Interchange_Part_API.New(source_ref1_     => task_seq_,
                                      source_ref2_     => order_no_,
                                      source_ref3_     => line_no_,
                                      source_ref4_     => '*',
                                      source_ref_type_ => Order_Type_API.DB_WORK_TASK,
                                      part_no_         => Interchange_Part_rec.part_number,
                                      contract_        => contract_,
                                      standard_part_   => standard_part_,
                                      note_text_       => Interchange_Part_rec.conditions);
   END LOOP;
END Create_Interchange_Parts;

