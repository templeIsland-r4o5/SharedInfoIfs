layer Core;

@IgnoreUnitTest MethodOverride
@Override
PROCEDURE CRUD_Create___(
   rec_ IN Add_Parts_Virtual_Rec )
IS
   rec_dup_                  Add_Parts_Virtual_Rec;
   add_part_requirement_defaults_   Add_Part_Defaults_Structure_Rec;
   assembly_position_count_  NUMBER;
   is_repairable_            VARCHAR2(10);
   is_repairable_bool_       BOOLEAN;
   info_                     VARCHAR2(32000);
   proj_name_                VARCHAR2(200);
   
   CURSOR get_task_part_info IS
      SELECT installed_part_no_id, part_group_id, assmbly_config_slot_pos_id, config_slot_position_id, installed_serial_no, installed_quantity, scheduling_action
      FROM av_exe_task_part
      WHERE task_part_id = rec_.installed_task_part_id;
   
   CURSOR get_part_info(part_number_id_ IN NUMBER,part_group_id_ IN NUMBER) IS
      SELECT objkey, inventory_class_code, part_assembly_type_code, config_slot_code, is_repairable
      FROM Part_List
      WHERE part_number_id = part_number_id_ AND part_group_id = part_group_id_;
   
   CURSOR get_required_date_from_mmrl IS
      SELECT date_required
      FROM Maint_Material_Req_Line_Av_Uiv
      WHERE maint_material_order_no = rec_.Maint_Material_Order_No AND line_item_no = rec_.Line_Item_No;
   
   CURSOR get_position_count(assembly_type_code_ VARCHAR2, aircraft_id_ NUMBER) IS
      SELECT count(config_slot_position_id) 
      FROM av_sub_assy_inventory_tab 
      WHERE assembly_type_code = assembly_type_code_ AND aircraft_id = aircraft_id_;
   
   CURSOR get_remove_task_part_info IS
      SELECT task_part_id, removal_reason_code
      FROM av_exe_task_part
      WHERE install_task_part_id = rec_.installed_task_part_id AND removed_user IS NULL;
      
   CURSOR get_task_info IS
      SELECT task.aircraft_wp_id, task.aircraft_id, ac.alt_id, ac.assembly_type_code
      FROM av_exe_task task
      INNER JOIN aircraft ac
      ON task.aircraft_id = ac.aircraft_id
      WHERE task.task_seq = rec_.task_seq;
      
   CURSOR get_ipc_part_info(part_number_ IN VARCHAR2) IS
      SELECT objkey, part_number_id, part_group_id, inventory_class_code, part_assembly_type_code, config_slot_code, config_slot_pos_id, is_repairable
      FROM Part_List
      WHERE part_number = part_number_
      FETCH FIRST ROW ONLY;
   
BEGIN
   rec_dup_ := rec_;
   SELECT '${PROJECTION}' INTO proj_name_ FROM dual;
   rec_dup_.projection_name := proj_name_;
   
   IF rec_dup_.operation_type = 'EDIT' THEN
      OPEN get_task_part_info;
      FETCH get_task_part_info INTO rec_dup_.part,rec_dup_.part_group_id,rec_dup_.assmbl_config_slot_pos_id,rec_dup_.config_slot_position_id,rec_dup_.installed_serial_no,rec_dup_.required_quantity,rec_dup_.scheduling_action;
      CLOSE get_task_part_info;
      
      OPEN get_part_info(rec_dup_.part, rec_dup_.part_group_id);
      FETCH get_part_info INTO rec_dup_.part_no_unq_id, rec_dup_.inventory_class_code, rec_dup_.assembly_type, rec_dup_.config_slot_code,is_repairable_;
      CLOSE get_part_info;
      
      rec_dup_.part_assembly_type_code := rec_dup_.assembly_type;
      
      OPEN get_required_date_from_mmrl;
      FETCH get_required_date_from_mmrl INTO rec_dup_.required_date;
      CLOSE get_required_date_from_mmrl;
      
      rec_dup_.default_required_date := rec_dup_.required_date;
      
      OPEN  get_position_count(rec_dup_.assembly_type, rec_dup_.aircraft_id);
      FETCH get_position_count INTO assembly_position_count_;
      CLOSE get_position_count;
      
      IF assembly_position_count_ > 1 THEN
         rec_dup_.assmbl_editable := TRUE;
      ELSE 
         rec_dup_.assmbl_editable := FALSE;
      END IF;
      
      IF rec_dup_.inventory_class_code ='TRK' AND rec_dup_.assembly_type_code != rec_dup_.assembly_type THEN
         rec_dup_.assmbl_visibility := TRUE;
      ELSE
         rec_dup_.assmbl_visibility := FALSE;
      END IF;
      
      rec_dup_.include_installation := TRUE;
      
      OPEN get_remove_task_part_info;
      FETCH get_remove_task_part_info INTO rec_dup_.removed_task_part_id,rec_dup_.removal_reason_code;
      CLOSE get_remove_task_part_info;
      
      IF rec_dup_.removed_task_part_id IS NOT NULL THEN
         rec_dup_.include_removal := TRUE;
         IF rec_dup_.removal_reason_code IS NOT NULL THEN
            rec_dup_.is_removal_reason_filled := TRUE;
         END IF;
      ELSE 
         rec_dup_.include_removal := FALSE;
      END IF;
      rec_dup_.installation_exists := FALSE;
      rec_dup_.removal_exists := FALSE;
      rec_dup_.removal_visible := TRUE;
      rec_dup_.is_modified := FALSE;
      
      rec_dup_.orgnl_part := rec_dup_.part;
      rec_dup_.orgnl_part_group_id := rec_dup_.part_group_id;
      rec_dup_.orgnl_required_quantity := rec_dup_.required_quantity;
      rec_dup_.orgnl_config_slot_position_id := rec_dup_.config_slot_position_id;
      rec_dup_.orgnl_assmbl_config_slot_pos_id := rec_dup_.assmbl_config_slot_pos_id; 
      rec_dup_.orgnl_removal_reason_code := rec_dup_.removal_reason_code;
      
   END IF;

   IF rec_dup_.operation_type = 'IPCPartSearch' THEN
      OPEN get_task_info;
      FETCH get_task_info INTO rec_dup_.wp_id, rec_dup_.aircraft_id, rec_dup_.aircraft_alt_id, rec_dup_.assembly_type_code;
      CLOSE get_task_info; 
      rec_dup_.required_quantity := 1;
      OPEN get_ipc_part_info(rec_dup_.ipc_part_number);
      FETCH get_ipc_part_info INTO rec_dup_.part_no_unq_id,rec_dup_.part,rec_dup_.part_group_id, rec_dup_.inventory_class_code, rec_dup_.assembly_type, rec_dup_.config_slot_code,rec_dup_.config_slot_position_id,is_repairable_;
      IF get_ipc_part_info%FOUND THEN
         CLOSE get_ipc_part_info;
         rec_dup_.part_assembly_type_code := rec_dup_.assembly_type;
         
         OPEN  get_position_count(rec_dup_.assembly_type, rec_dup_.aircraft_id);
         FETCH get_position_count INTO assembly_position_count_;
         CLOSE get_position_count;
         
         IF assembly_position_count_ > 1 THEN
            rec_dup_.assmbl_editable := TRUE;
         ELSE 
            rec_dup_.assmbl_editable := FALSE;
         END IF;
         
         IF rec_dup_.inventory_class_code ='TRK' AND rec_dup_.assembly_type_code != rec_dup_.assembly_type THEN
            rec_dup_.assmbl_visibility := TRUE;
         ELSE
            rec_dup_.assmbl_visibility := FALSE;
         END IF;
         
         is_repairable_bool_ := (is_repairable_ ='TRUE');
         add_part_requirement_defaults_ := Fetch_Add_Part_Defaults___(
            source_id_  => rec_dup_.task_seq,
            inventory_class_code_   => rec_dup_.inventory_class_code,
            assembly_position_id_ => NULL,
            config_slot_position_id_   => rec_dup_.config_slot_position_id,
            is_repairable_ => is_repairable_bool_,
            is_sub_assy_ => rec_dup_.assmbl_visibility,
            source_of_add_part_ => 'Task',
            assembly_type_ => rec_dup_.assembly_type,
            aircraft_id_   => rec_dup_.aircraft_id,
            info$_ => info_
            );
         
         rec_dup_.include_installation := add_part_requirement_defaults_.Include_Installation;
         rec_dup_.include_removal      := add_part_requirement_defaults_.Include_Removal;
         rec_dup_.installation_exists  := add_part_requirement_defaults_.installation_exists;
         rec_dup_.removal_exists       := add_part_requirement_defaults_.removal_exists;
         rec_dup_.installation_visible := add_part_requirement_defaults_.installation_visible;
         rec_dup_.removal_visible      := add_part_requirement_defaults_.removal_visible;
         rec_dup_.required_date        := Get_Scheduling_Req_Date___ (rec_dup_.wp_id);
         rec_dup_.default_required_date:= rec_dup_.required_date;
      ELSE
         CLOSE get_ipc_part_info;
      END IF;
      
   END IF;
   super(rec_dup_); 
END CRUD_Create___;

PROCEDURE Add_Fault_Parts___ (
   fault_id_                  IN NUMBER,
   part_number_id_            IN NUMBER,
   required_quantity_         IN NUMBER,
   part_group_id_             IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   is_include_installation_   IN BOOLEAN,
   is_include_removal_        IN BOOLEAN, 
   removal_reason_code_       IN VARCHAR2, 
   installed_serial_no_       IN VARCHAR2,
   removal_serial_no_         IN VARCHAR2, 
   removal_part_number_id_    IN NUMBER,
   removal_part_group_id_     IN NUMBER,
   is_removal_reason_filled_  IN BOOLEAN,
   sensitivities_             IN VARCHAR2 )
IS
   info_                     VARCHAR2(200);
   objid_                    VARCHAR2(200);
   objversion_               VARCHAR2(200);
   attr_                     VARCHAR2(32000);
   task_seq_                 NUMBER;
   aircraft_wp_id_           NUMBER;
   fault_part_id_var_        VARCHAR2(32000);
   fault_part_id_            NUMBER;
   fault_remove_part_id_var_ VARCHAR2(32000);
   fault_remove_part_id_     NUMBER;
   inventory_class_code_     VARCHAR2(50);
   is_repairable_            VARCHAR2(20);
   task_part_id_             NUMBER;
   class_code_               VARCHAR2(20);

   CURSOR get_repairable_bool (part_number_id_ IN NUMBER) IS 
      SELECT av_part_number.inventory_class_code, av_part_number.is_repairable
      FROM av_part_number
      WHERE av_part_number.part_number_id = part_number_id_;
    
   CURSOR get_task_data IS
      SELECT aircraft_wp_id, task_seq
      FROM av_exe_task
      WHERE task_seq = Av_Exe_Task_API.Get_Task_Seq(fault_id_);

BEGIN
   OPEN get_task_data;
   FETCH get_task_data INTO aircraft_wp_id_,task_seq_;
   CLOSE get_task_data;
   
   OPEN get_repairable_bool(part_number_id_);
   FETCH get_repairable_bool INTO inventory_class_code_,is_repairable_;
   CLOSE get_repairable_bool;

   Client_SYS.Clear_Attr(attr_);
   IF (task_seq_ IS NOT NULL) THEN
      class_code_ := Av_Exe_Task_API.Get_Class_Code(task_seq_);
      IF (is_include_removal_)THEN
         Client_SYS.Add_To_Attr('FAULT_ID',                   fault_id_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         IF(removal_part_group_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           removal_part_group_id_,     attr_);
         ELSE
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           part_group_id_,             attr_);
         END IF;
         IF(removal_part_number_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      removal_part_number_id_,    attr_);
         ELSE 
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      part_number_id_,            attr_);
         END IF;
         Client_SYS.Add_To_Attr('REMOVED_QUANTITY',           required_quantity_,         attr_);
         IF is_removal_reason_filled_ THEN
            Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE',     removal_reason_code_,       attr_);
         END IF;
         IF(removal_serial_no_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO',       removal_serial_no_,         attr_);
         END IF;
         Av_Fault_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');
         
         fault_remove_part_id_var_ := Client_SYS.Get_Item_Value('FAULT_PART_ID', attr_);
         fault_remove_part_id_     := Client_SYS.Attr_Value_To_Number(fault_remove_part_id_var_);
         
         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('FAULT_PART_ID',              fault_remove_part_id_,      attr_);
         Client_SYS.Add_To_Attr('TASK_SEQ',                   task_seq_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         IF(removal_part_group_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           removal_part_group_id_,     attr_);
         ELSE
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           part_group_id_,             attr_);
         END IF;
         IF(removal_part_number_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      removal_part_number_id_,    attr_);
         ELSE 
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      part_number_id_,            attr_);
         END IF;
         Client_SYS.Add_To_Attr('REMOVED_QUANTITY',           required_quantity_,         attr_);
         IF is_removal_reason_filled_ THEN
            Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE',     removal_reason_code_,       attr_);
         END IF;
         IF(removal_serial_no_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO',       removal_serial_no_,         attr_);
         END IF;
         Av_Exe_Task_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');  
         task_part_id_ := Client_SYS.Get_Item_Value('TASK_PART_ID', attr_);
         
         IF (class_code_ = Av_Exe_Task_API.TASK_CLASS_CORR AND sensitivities_ IS NOT NULL) THEN 
            Av_Exe_Task_Sens_API.Save_Effective_Sensitivities(task_seq_, sensitivities_);
            Av_Exe_Task_Part_Sens_API.Save_Effective_Sensitivities(task_seq_,task_part_id_,sensitivities_);
         END IF;   
      END IF;  
         
      IF(is_include_installation_) THEN 
         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('FAULT_ID',                   fault_id_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         Client_SYS.Add_To_Attr('PART_GROUP_ID',              part_group_id_,             attr_);
         Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID',       part_number_id_,            attr_);
         Client_SYS.Add_To_Attr('INSTALLED_QUANTITY',         required_quantity_,         attr_);
         Client_SYS.Add_To_Attr('INSTALLED_SERIAL_NO',        installed_serial_no_,       attr_);
         Av_Fault_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');     

         fault_part_id_var_ := Client_SYS.Get_Item_Value('FAULT_PART_ID', attr_);
         fault_part_id_     := Client_SYS.Attr_Value_To_Number(fault_part_id_var_);        

         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('FAULT_PART_ID',              fault_part_id_,             attr_);
         Client_SYS.Add_To_Attr('TASK_SEQ',                   task_seq_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         Client_SYS.Add_To_Attr('PART_GROUP_ID',              part_group_id_,             attr_);
         Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID',       part_number_id_,            attr_);
         Client_SYS.Add_To_Attr('INSTALLED_QUANTITY',         required_quantity_,         attr_);
         Client_SYS.Add_To_Attr('INSTALLED_SERIAL_NO',        installed_serial_no_,       attr_);
         Av_Exe_Task_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');  
         task_part_id_ := Client_SYS.Get_Item_Value('TASK_PART_ID', attr_);
         
         IF (class_code_ = Av_Exe_Task_API.TASK_CLASS_CORR AND sensitivities_ IS NOT NULL) THEN 
            Av_Exe_Task_Sens_API.Save_Effective_Sensitivities(task_seq_, sensitivities_);
            Av_Exe_Task_Part_Sens_API.Save_Effective_Sensitivities(task_seq_,task_part_id_,sensitivities_);
         END IF;   
      END IF; 
   ELSE          
      Client_SYS.Clear_Attr(attr_); 
      IF (is_include_removal_)THEN
         Client_SYS.Add_To_Attr('FAULT_ID',                   fault_id_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         IF(removal_part_group_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           removal_part_group_id_,     attr_);
         ELSE
            Client_SYS.Add_To_Attr('PART_GROUP_ID',           part_group_id_,             attr_);
         END IF;
         IF(removal_part_number_id_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      removal_part_number_id_,    attr_);
         ELSE 
            Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      part_number_id_,            attr_);
         END IF;
         Client_SYS.Add_To_Attr('REMOVED_QUANTITY',           required_quantity_,         attr_);
         IF is_removal_reason_filled_ THEN
            Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE',     removal_reason_code_,       attr_);
         END IF;
         IF(removal_serial_no_ IS NOT NULL) THEN
            Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO',       removal_serial_no_,         attr_);
         END IF;
         Av_Fault_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');
      END IF;
      
      IF(is_include_installation_) THEN   
         Client_SYS.Clear_Attr(attr_);
         Client_SYS.Add_To_Attr('FAULT_ID',                   fault_id_,                  attr_);
         Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
         Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
         Client_SYS.Add_To_Attr('PART_GROUP_ID',              part_group_id_,             attr_);
         Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID',       part_number_id_,            attr_);
         Client_SYS.Add_To_Attr('INSTALLED_QUANTITY',         required_quantity_,         attr_);
         Client_SYS.Add_To_Attr('INSTALLED_SERIAL_NO',        installed_serial_no_,       attr_);
         Av_Fault_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');    
      END IF;
   END IF;
END Add_Fault_Parts___;

PROCEDURE Add_Task_Parts___ (
   task_seq_                  IN NUMBER,
   part_number_id_            IN NUMBER,
   required_quantity_         IN NUMBER,
   part_group_id_             IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   is_include_installation_   IN BOOLEAN,
   is_include_removal_        IN BOOLEAN, 
   removal_reason_code_       IN VARCHAR2, 
   installed_serial_no_       IN VARCHAR2,
   removal_serial_no_         IN VARCHAR2, 
   removal_part_number_id_    IN NUMBER,
   removal_part_group_id_     IN NUMBER,
   is_removal_reason_filled_  IN BOOLEAN,
   scheduling_action_         IN VARCHAR2,
   required_date_             IN DATE,
   part_number_               IN VARCHAR2,
   parent_key_                IN VARCHAR2,
   sensitivities_             IN VARCHAR2,
   note_                      IN VARCHAR2)
IS
   aircraft_wp_id_           NUMBER;
   fault_id_                 NUMBER;
   inventory_class_code_     VARCHAR2(50);
   is_repairable_            VARCHAR2(20);
   final_quantity_           NUMBER;
   current_user_             VARCHAR2(40);
   maint_material_order_no_  NUMBER;
   install_task_part_id_     NUMBER;
    
   CURSOR get_fault_data IS
      SELECT aircraft_wp_id, fault_id
      FROM av_exe_task
      WHERE task_seq = task_seq_;
      
      CURSOR get_repairable_bool (part_number_id_ IN NUMBER) IS 
      SELECT av_part_number.inventory_class_code, av_part_number.is_repairable
      FROM av_part_number
      WHERE av_part_number.part_number_id = part_number_id_;
   
BEGIN
   OPEN get_fault_data;
   FETCH get_fault_data INTO aircraft_wp_id_,fault_id_;
   CLOSE get_fault_data;
   
   OPEN get_repairable_bool(part_number_id_);
   FETCH get_repairable_bool INTO inventory_class_code_,is_repairable_;
   CLOSE get_repairable_bool;
         
   current_user_ := Fnd_Session_API.Get_Fnd_User();
   
   IF(is_include_installation_) THEN 
      IF (scheduling_action_ = 'REQ') THEN
         Av_Exe_Task_Part_Util_API.Av_Material_Req_Creation(maint_material_order_no_,task_seq_);
      END IF;
      IF (inventory_class_code_ = 'SER') THEN
         final_quantity_ := 1;   
         FOR i IN 1 .. required_quantity_ LOOP
            Install_Parts__(fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, part_group_id_, part_number_id_, final_quantity_, installed_serial_no_, scheduling_action_, required_date_, part_number_, current_user_, maint_material_order_no_,install_task_part_id_, parent_key_, sensitivities_,note_); 
            IF (is_include_removal_) THEN
               Remove_Parts__ (fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, removal_part_group_id_, part_group_id_, removal_part_number_id_, part_number_id_, final_quantity_, removal_reason_code_, removal_serial_no_, is_removal_reason_filled_,install_task_part_id_,sensitivities_,current_user_); 
            END IF;
         END LOOP;
      ELSE
         Install_Parts__(fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, part_group_id_, part_number_id_, required_quantity_, installed_serial_no_, scheduling_action_, required_date_, part_number_, current_user_, maint_material_order_no_,install_task_part_id_, parent_key_, sensitivities_,note_);
         IF (is_include_removal_) THEN
               Remove_Parts__ (fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, removal_part_group_id_, part_group_id_, removal_part_number_id_, part_number_id_, required_quantity_, removal_reason_code_, removal_serial_no_, is_removal_reason_filled_,install_task_part_id_,sensitivities_,current_user_); 
         END IF;
      END IF;
   END IF;
   
   IF (is_include_removal_ AND NOT is_include_installation_)THEN
      IF (inventory_class_code_ = 'SER') THEN
         final_quantity_ := 1;   
         FOR i IN 1 .. required_quantity_ LOOP
            Remove_Parts__ (fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, removal_part_group_id_, part_group_id_, removal_part_number_id_, part_number_id_, final_quantity_, removal_reason_code_, removal_serial_no_, is_removal_reason_filled_,install_task_part_id_,sensitivities_,current_user_); 
         END LOOP;
      ELSE
         Remove_Parts__ (fault_id_, task_seq_, assmbl_config_slot_pos_id_, config_slot_position_id_, removal_part_group_id_, part_group_id_, removal_part_number_id_, part_number_id_, required_quantity_, removal_reason_code_, removal_serial_no_, is_removal_reason_filled_, NULL, sensitivities_,current_user_); 
      END IF;  
   END IF;
END Add_Task_Parts___;

@IgnoreUnitTest PLSQLInSQL
PROCEDURE Create_Fault_Parts__ (
   fault_part_id_             OUT VARCHAR2,
   fault_id_                  IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   removal_part_group_id_     IN NUMBER    DEFAULT NULL,
   installed_part_group_id_   IN NUMBER    DEFAULT NULL,
   part_group_id_             IN NUMBER    DEFAULT NULL,
   removal_part_number_id_    IN NUMBER    DEFAULT NULL,
   installed_part_number_id_  IN NUMBER    DEFAULT NULL,
   part_number_id_            IN NUMBER    DEFAULT NULL,
   removed_quantity_          IN NUMBER    DEFAULT NULL,
   installed_quantity_        IN NUMBER    DEFAULT NULL,
   removal_reason_code_       IN VARCHAR2  DEFAULT NULL,
   removal_serial_no_         IN VARCHAR2  DEFAULT NULL,
   is_removal_reason_filled_  IN BOOLEAN   DEFAULT NULL,
   installed_serial_no_       IN VARCHAR2  DEFAULT NULL)
IS
   info_                      VARCHAR2(200);
   objid_                     VARCHAR2(200);
   objversion_                VARCHAR2(200);
   attr_                      VARCHAR2(32000);
BEGIN
   Client_SYS.Clear_Attr(attr_);
   Client_SYS.Add_To_Attr('FAULT_ID',                   fault_id_,                  attr_);
   Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
   Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID',    config_slot_position_id_,   attr_);
   IF(removal_part_group_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('PART_GROUP_ID',           removal_part_group_id_,     attr_);
   ELSIF(installed_part_group_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('PART_GROUP_ID',              installed_part_group_id_,                 attr_);
   ELSE
      Client_SYS.Add_To_Attr('PART_GROUP_ID',           part_group_id_,             attr_);
   END IF;
   IF(removal_part_number_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      removal_part_number_id_,    attr_);
   ELSIF(installed_part_number_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID',       installed_part_number_id_,                attr_);
   ELSE 
      Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID',      part_number_id_,            attr_);
   END IF;
   IF(removed_quantity_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_QUANTITY',           removed_quantity_,         attr_);
   END IF;
   IF(installed_quantity_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_QUANTITY',         installed_quantity_,             attr_);
   END IF;
   IF is_removal_reason_filled_ THEN
      Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE',     removal_reason_code_,       attr_);
   END IF;
   IF(removal_serial_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO',       removal_serial_no_,         attr_);
   END IF;
   IF(installed_serial_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_SERIAL_NO',        installed_serial_no_,           attr_);
   END IF;
   
   Av_Fault_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');
   
   fault_part_id_ := Client_SYS.Get_Item_Value('FAULT_PART_ID', attr_);
END Create_Fault_Parts__;

@IgnoreUnitTest NoOutParams
PROCEDURE Create_Task_Parts__ (
   fault_part_id_             IN NUMBER    DEFAULT NULL,
   task_seq_                  IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   removal_part_group_id_     IN NUMBER    DEFAULT NULL,
   installed_part_group_id_   IN NUMBER    DEFAULT NULL,
   part_group_id_             IN NUMBER    DEFAULT NULL,
   removal_part_number_id_    IN NUMBER    DEFAULT NULL,
   installed_part_number_id_  IN NUMBER    DEFAULT NULL,
   part_number_id_            IN NUMBER    DEFAULT NULL,
   removed_quantity_          IN NUMBER    DEFAULT NULL,
   installed_quantity_        IN NUMBER    DEFAULT NULL,
   removal_reason_code_       IN VARCHAR2  DEFAULT NULL,
   removal_serial_no_         IN VARCHAR2  DEFAULT NULL,
   is_removal_reason_filled_  IN BOOLEAN   DEFAULT NULL,
   installed_serial_no_       IN VARCHAR2  DEFAULT NULL,
   scheduling_action_         IN VARCHAR2  DEFAULT NULL,
   maint_material_order_no_   IN NUMBER    DEFAULT NULL,
   required_date_             IN DATE      DEFAULT NULL,
   part_number_               IN VARCHAR2  DEFAULT NULL,
   current_user_              IN VARCHAR2  DEFAULT NULL,
   install_task_part_id_      IN NUMBER    DEFAULT NULL,
   task_part_id_              OUT NUMBER,
   parent_key_                IN VARCHAR2  DEFAULT NULL,
   sensitivities_             IN VARCHAR2 ,
   note_                      IN VARCHAR2  DEFAULT NULL
   )
IS
   info_                      VARCHAR2(200);
   objid_                     VARCHAR2(200);
   objversion_                VARCHAR2(200);
   attr_                      VARCHAR2(32000);
   order_no_                  NUMBER;
   line_no_                   NUMBER;
   out_task_part_id_var_      VARCHAR2(20) := NULL;
   class_code_                VARCHAR2(20);
BEGIN
   Client_SYS.Clear_Attr(attr_);
   IF(fault_part_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('FAULT_PART_ID', fault_part_id_, attr_);
   END IF;
   Client_SYS.Add_To_Attr('TASK_SEQ', task_seq_, attr_);
   Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', assmbl_config_slot_pos_id_, attr_);
   Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID', config_slot_position_id_, attr_);
   IF(removal_part_group_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('PART_GROUP_ID', removal_part_group_id_, attr_);
   ELSIF(installed_part_group_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('PART_GROUP_ID', installed_part_group_id_, attr_);
   ELSE
      Client_SYS.Add_To_Attr('PART_GROUP_ID', part_group_id_, attr_);
   END IF;
   IF(removal_part_number_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID', removal_part_number_id_, attr_);
   ELSIF(installed_part_number_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID', installed_part_number_id_,                attr_);
   ELSE 
      Client_SYS.Add_To_Attr('REMOVED_PART_NO_ID', part_number_id_, attr_);
   END IF;
   IF(removed_quantity_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_QUANTITY', removed_quantity_, attr_);
   END IF;
   IF(installed_quantity_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_QUANTITY', installed_quantity_, attr_);
   END IF;
   IF is_removal_reason_filled_ THEN
      Client_SYS.Add_To_Attr('REMOVAL_REASON_CODE', removal_reason_code_, attr_);
   END IF;
   IF(removal_serial_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('REMOVED_SERIAL_NO', removal_serial_no_, attr_);
   END IF;
   IF(installed_serial_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALLED_SERIAL_NO', installed_serial_no_, attr_);
   END IF;
   IF(scheduling_action_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('SCHEDULING_ACTION', scheduling_action_, attr_);
   END IF;
   IF(maint_material_order_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('MAINT_MATERIAL_ORDER_NO', maint_material_order_no_, attr_);
   END IF;
   IF (scheduling_action_ = 'REQ') THEN
      order_no_ := maint_material_order_no_;
      Av_Exe_Task_Part_Util_API.Av_Material_Req_Line_Creation(maint_material_order_no_ => order_no_,
                                                              line_no_                 => line_no_,
                                                              task_seq_                => task_seq_,
                                                              part_number_             => part_number_,
                                                              mat_quantity_            => installed_quantity_,
                                                              date_required_           => required_date_,
                                                              note_                    => note_);
      IF (parent_key_ IS NOT null) THEN
         Create_Interchange_Parts(task_seq_, order_no_, line_no_, parent_key_);
      END IF;
   END IF;            
   IF(line_no_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('LINE_ITEM_NO', line_no_, attr_);
   END IF;
   IF(install_task_part_id_ IS NOT NULL) THEN
      Client_SYS.Add_To_Attr('INSTALL_TASK_PART_ID', install_task_part_id_, attr_);
   END IF;
   Av_Exe_Task_Part_API.New__(info_, objid_, objversion_, attr_, 'DO');
   
   out_task_part_id_var_ := Client_SYS.Get_Item_Value('TASK_PART_ID', attr_);
   task_part_id_ := Client_SYS.Attr_Value_To_Number(out_task_part_id_var_);
   class_code_ := Av_Exe_Task_API.Get_Class_Code(task_seq_);
   
   IF(task_seq_ IS NOT NULL AND class_code_ = Av_Exe_Task_API.TASK_CLASS_CORR AND sensitivities_ IS NOT NULL) THEN 
      Av_Exe_Task_Sens_API.Save_Effective_Sensitivities(task_seq_, sensitivities_);
      Av_Exe_Task_Part_Sens_API.Save_Effective_Sensitivities(task_seq_,task_part_id_,sensitivities_);
   END IF;      
END Create_Task_Parts__;

@IgnoreUnitTest NoOutParams
PROCEDURE Remove_Parts__ (
   fault_id_                  IN NUMBER,
   task_seq_                  IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   removal_part_group_id_     IN NUMBER,
   part_group_id_             IN NUMBER,
   removal_part_number_id_    IN NUMBER,
   part_number_id_            IN NUMBER,
   required_quantity_         IN NUMBER,
   removal_reason_code_       IN VARCHAR2,
   removal_serial_no_         IN VARCHAR2,
   is_removal_reason_filled_  IN BOOLEAN,
   install_task_part_id_      IN NUMBER,
   sensitivities_             IN VARCHAR2,
   current_user_              IN VARCHAR2)
IS
   fault_remove_part_id_var_  VARCHAR2(32000);
   fault_remove_part_id_      NUMBER;
   removal_task_part_id_      NUMBER;
BEGIN
   IF (fault_id_ IS NOT NULL) THEN
      Create_Fault_Parts__(
         fault_part_id_             => fault_remove_part_id_var_,
         fault_id_                  => fault_id_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         removal_part_group_id_     => removal_part_group_id_,
         part_group_id_             => part_group_id_,
         removal_part_number_id_    => removal_part_number_id_,
         part_number_id_            => part_number_id_,
         removed_quantity_          => required_quantity_,
         removal_reason_code_       => removal_reason_code_,
         removal_serial_no_         => removal_serial_no_,
         is_removal_reason_filled_  => is_removal_reason_filled_
      );
      fault_remove_part_id_     := Client_SYS.Attr_Value_To_Number(fault_remove_part_id_var_);
      
      Create_Task_Parts__(
         fault_part_id_             => fault_remove_part_id_,
         task_seq_                  => task_seq_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         removal_part_group_id_     => removal_part_group_id_,
         part_group_id_             => part_group_id_,
         removal_part_number_id_    => removal_part_number_id_,
         part_number_id_            => part_number_id_,
         removed_quantity_          => required_quantity_,
         removal_reason_code_       => removal_reason_code_,
         removal_serial_no_         => removal_serial_no_,
         is_removal_reason_filled_  => is_removal_reason_filled_,
         install_task_part_id_      => install_task_part_id_,
         task_part_id_              => removal_task_part_id_,
         sensitivities_             => sensitivities_,
         current_user_              => current_user_
      );

   ELSE
      Create_Task_Parts__(
         task_seq_                  => task_seq_,
         assmbl_config_slot_pos_id_ => assmbl_config_slot_pos_id_,
         config_slot_position_id_   => config_slot_position_id_,
         removal_part_group_id_     => removal_part_group_id_,
         part_group_id_             => part_group_id_,
         removal_part_number_id_    => removal_part_number_id_,
         part_number_id_            => part_number_id_,
         removed_quantity_          => required_quantity_,
         removal_reason_code_       => removal_reason_code_,
         removal_serial_no_         => removal_serial_no_,
         is_removal_reason_filled_  => is_removal_reason_filled_,
         install_task_part_id_      => install_task_part_id_,
         task_part_id_              => removal_task_part_id_,
         sensitivities_             => sensitivities_,
         current_user_              => current_user_
      );
   END IF;
END Remove_Parts__;

@IgnoreUnitTest NoOutParams
PROCEDURE Install_Parts__ (
   fault_id_                  IN NUMBER,
   task_seq_                  IN NUMBER,
   assmbl_config_slot_pos_id_ IN NUMBER,
   config_slot_position_id_   IN NUMBER,
   part_group_id_             IN NUMBER,
   part_number_id_            IN NUMBER,
   required_quantity_         IN NUMBER,
   installed_serial_no_       IN VARCHAR2,
   scheduling_action_         IN VARCHAR2,
   required_date_             IN DATE,
   part_number_               IN VARCHAR2,
