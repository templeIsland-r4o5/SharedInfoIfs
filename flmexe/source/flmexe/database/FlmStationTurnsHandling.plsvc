layer Core;

FUNCTION Check_Task_Work_Assigned___ (
   work_package_id_ IN NUMBER) RETURN NUMBER
IS
BEGIN
   RETURN Av_Flight_API.Has_Skills_Assigned_Previously(work_package_id_);
END Check_Task_Work_Assigned___;
