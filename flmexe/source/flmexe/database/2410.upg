------------------------------ CREATE NEW SEQUENCES -----------------------------------------
---------------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------------
--------------- CREATE/ALTER TABLES/INDEXES AND DATA CORRECTIONS ------------------
---------------------------------------------------------------------------------------------

-- ***** FND_ROLE_TAB Start *****
DECLARE   
   TYPE array_t IS VARRAY(6) OF VARCHAR2(50);
   role_array_ array_t := array_t('MM_SUPERVISOR','MM_TECHNICIAN','MM_ADMINSTRATOR', 'MM_MAINT_OPERATIONS_CONTROLLER', 'MM_LINE_PLANNER', 'MM_FLIGHT_API');
BEGIN
   FOR i_ IN 1..role_array_.count LOOP
      Security_SYS.Set_Role_Delivery_Type(role_array_(i_), 'IFS_MANAGED');
   END LOOP;
END;
/
-- ***** FND_ROLE_TAB End *****

