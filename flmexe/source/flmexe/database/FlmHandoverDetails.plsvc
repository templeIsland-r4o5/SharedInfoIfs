@IgnoreUnitTest DMLOperation
PROCEDURE Add_New_Handover_Note___ (
   work_package_id_ IN NUMBER,
   note_ IN VARCHAR2,
   priority_ IN VARCHAR2,
   created_by_ IN VARCHAR2,
   created_date_ IN DATE)
IS
   info_                     VARCHAR2(200);
   objid_                    VARCHAR2(200);
   objversion_               VARCHAR2(200);
   attr_                     VARCHAR2(32000);
BEGIN
	Client_SYS.Clear_Attr(attr_);
   Client_SYS.Add_To_Attr('AIRCRAFT_WORK_PACKAGE_ID', work_package_id_, attr_);
   Client_SYS.Add_To_Attr('HANDOVER_NOTE', note_, attr_);
   Client_SYS.Add_To_Attr('PRIORITY', priority_, attr_);
   Client_SYS.Add_To_Attr('CREATED_BY', created_by_, attr_);
   Client_SYS.Add_To_Attr('CREATED_DATE', created_date_, attr_);
   
   Av_Handover_Note_API.New__(info_, objid_, objversion_, attr_, 'DO');
END Add_New_Handover_Note___;
