@IgnoreUnitTest TrivialFunction
FUNCTION Get_Shift_Start_End___ (
   work_package_id_ IN NUMBER) RETURN Shift_Start_End_Structure_Rec
IS
   rec_                 Shift_Start_End_Structure_Rec;
   parameter_           av_flm_parameter_tab.parameter_value%TYPE;
   period_              NUMBER;
   work_package_start_  DATE;
   start_time_          DATE;
BEGIN
   parameter_           :=Av_Flm_Parameter_API.Get_Parameter_Value('HANDOVER_REPORT_PERIOD_HOURS');
   period_              :=Adcom_Util_API.Validate_Format_Hours(parameter_);   
   rec_.end_time        :=sysdate;
   start_time_          :=rec_.end_time - NUMTODSINTERVAL(period_, 'HOUR');
   work_package_start_  :=Av_Aircraft_Work_Package_API.Get_Actual_Start_Date_Time(work_package_id_);
   
   IF work_package_start_>= start_time_ THEN
      rec_.start_time:=work_package_start_;
   ELSE
      rec_.start_time:=start_time_;
   END IF;
   
   RETURN rec_;
END Get_Shift_Start_End___;

@IgnoreUnitTest DMLOperation
FUNCTION Execute_Report___ (
   key_ IN Hand_Over_Details_Virtual_Key) RETURN NUMBER
IS
   vrt_rec_                  Hand_Over_Details_Virtual_Rec;
   param_attr_               VARCHAR2(32000);
   report_attr_              VARCHAR2(32000);
   result_key_               NUMBER;
   aircraft_id_              NUMBER;
   work_package_id_          NUMBER;
   aircraft_                 VARCHAR2(100);  
   start_time_utc_           VARCHAR2(100);
   end_time_utc_             VARCHAR2(100);
   start_time_tz_            VARCHAR2(200);
   end_time_tz_              VARCHAR2(200);
   current_user_airport_tz_  VARCHAR2(300);
   current_time_in_tz_       VARCHAR2(200);
   start_time_               DATE;
   end_time_                 DATE;
   
BEGIN 
   Client_SYS.Clear_Attr(param_attr_);
   Client_SYS.Clear_Attr(report_attr_);
   
   vrt_rec_ := Get_Record___(key_);
   
   IF vrt_rec_.source = 'HMSLOBBY' or vrt_rec_.source = 'HMCLOBBY' THEN
      aircraft_id_    := vrt_rec_.aircraft_id;   
      aircraft_       := CONCAT(CONCAT((Aircraft_API.Get_Assembly_Type_Code(aircraft_id_)), ' - '), TO_CHAR(Aircraft_API.Get_Reg_Code(aircraft_id_)));
      work_package_id_:= vrt_rec_.work_package_id;
      
      Client_SYS.Add_To_Attr('REPORT_ID', 'H_M_SHIFT_HANDOVER_REPORT_REP', report_attr_);
      Client_SYS.Add_To_Attr('WORK_PACKAGE_ID', work_package_id_, param_attr_);
      Client_SYS.Add_To_Attr('AIRCRAFT', aircraft_, param_attr_);
      Client_SYS.Add_To_Attr('WORK_PACKAGE', Av_Aircraft_Work_Package_API.Get_Barcode(work_package_id_), param_attr_);
      Client_SYS.Add_To_Attr('WP_NAME', Av_Aircraft_Work_Package_API.Get_Work_Package_Name(work_package_id_), param_attr_);
      Client_SYS.Add_To_Attr('WP_LOCATION', Av_Aircraft_Work_Package_API.Get_Location_Code(work_package_id_), param_attr_);
   ELSE
      Client_SYS.Add_To_Attr('REPORT_ID', 'L_M_SHIFT_HANDOVER_REPORT_REP', report_attr_);
      Client_SYS.Add_To_Attr('CURRENT_USER_AIRPORT_ID', vrt_rec_.current_user_airport_id, param_attr_);
   END IF;
   
   start_time_              := vrt_rec_.start_time;
   end_time_                := vrt_rec_.end_time;      
   start_time_utc_          := TO_CHAR(start_time_, 'YYYY-MM-DD"T"HH24:MI:SS');
   end_time_utc_            := TO_CHAR(end_time_, 'YYYY-MM-DD"T"HH24:MI:SS');
   current_user_airport_tz_ := vrt_rec_.current_user_airport_time_zone;
   start_time_tz_           := TO_CHAR(Time_Util_API.Convert_Utc_To_Timezone(start_time_, current_user_airport_tz_), 'YYYY-MM-DD, HH:MI PM');
   end_time_tz_             := TO_CHAR(Time_Util_API.Convert_Utc_To_Timezone(end_time_, current_user_airport_tz_), 'YYYY-MM-DD, HH:MI PM');   
   current_time_in_tz_      := TO_CHAR(Time_Util_API.Get_Current_Time_In_Timezone(current_user_airport_tz_), 'Mon DD, YYYY HH:MI:SS PM');
         
   Client_SYS.Add_To_Attr('START_DATE_UTC', start_time_utc_, param_attr_); 
   Client_SYS.Add_To_Attr('END_DATE_UTC', end_time_utc_, param_attr_);   
   Client_SYS.Add_To_Attr('START_DATE_TIME', start_time_tz_, param_attr_); 
   Client_SYS.Add_To_Attr('END_DATE_TIME', end_time_tz_, param_attr_);
   Client_SYS.Add_To_Attr('CREATED_TIME', current_time_in_tz_, param_attr_); 
   Client_SYS.Add_To_Attr('CURRENT_USER_AIRPORT_TIME_ZONE', current_user_airport_tz_, param_attr_);  
   Client_SYS.Add_To_Attr('UTC_OFF_SET',Iso_Time_Zone_API.Get_Description(current_user_airport_tz_), param_attr_);
     
   result_key_ := Report_Format_API.Create_New_Report(report_attr_, param_attr_, Fnd_Session_API.Get_Fnd_User);

   RETURN result_key_;
END Execute_Report___;


@IgnoreUnitTest NoOutParams
PROCEDURE Add_In_Range_Tasks (
   objkey_          IN VARCHAR2,
   aircraft_id_     IN NUMBER,
    
   start_time_      IN DATE,
   end_time_        IN DATE)
IS                                
   in_range_task_rec_      Tasks_Within_Range_Virtual_Rec;
   session_user_airport_   VARCHAR2(100);
   latest_js_reason_       VARCHAR2(100);

   CURSOR get_in_range_task_list_(start_ IN DATE, end_ IN DATE, session_user_airport_ IN VARCHAR2) IS
      WITH base_tasks AS (
         SELECT
            t.task_seq, 
            t.fault_id, 
            t.aircraft_id, 
            t.barcode, 
            t.description,
            t.material_avail_user_status, 
            t.crew_code, 
            t.planned_start,
            t.planned_finish, 
            t.actual_start, 
            t.actual_finish,
            t.aircraft_wp_id, 
            t.config_position, 
            t.class_code,
            t.subclass_code,
            t.location, 
            t.crew_name, 
            t.priority_id, 
            t.long_description,
            t.state,
            w.is_heavy_maintenance, 
            w.aircraft_work_package_id,
            arr_f.arrival_airport_id, 
            dep_f.shed_departure_date_time
         FROM av_exe_task t
         JOIN Av_Aircraft_Work_Package w 
            ON t.Aircraft_Wp_Id = w.Aircraft_Work_Package_Id
         JOIN av_flight_tab arr_f 
            ON w.Aircraft_Work_Package_Id = arr_f.Work_Package_Id
         LEFT JOIN av_flight_tab dep_f 
            ON arr_f.dept_flight_id = dep_f.flight_id
         WHERE w.is_heavy_maintenance = 0
         AND arr_f.arrival_airport_id = session_user_airport_
         AND t.state   = 'In Work'
      ),
      --Tasks  raised on the aircraft which has the Scheduled Departure Time within the selected time range
      tasks_within_sched_dep_window AS (
         SELECT task_seq 
            FROM base_tasks
            WHERE shed_departure_date_time BETWEEN start_ AND end_
            )
      SELECT 
         b.* 
      FROM base_tasks b
      WHERE b.task_seq IN (SELECT task_seq FROM tasks_within_sched_dep_window)
      
   UNION ALL
   -- tasks/faults that were started during the defined time range and are still in work.
   SELECT 
      b.* 
      FROM base_tasks b
      WHERE b.actual_start BETWEEN start_ AND end_
      AND b.task_seq NOT IN (
             SELECT task_seq FROM tasks_within_sched_dep_window
   );
   
BEGIN
   
   session_user_airport_:= Av_Airport_For_User_API.Get_Airport_Id (Fnd_Session_API.Get_Fnd_User);
   DELETE FROM ${PROJECTION}_TASKS_WITHIN_RANGE_VIRTUAL_VRT WHERE parent_objkey = objkey_;

   FOR task_ IN get_in_range_task_list_(start_time_, end_time_, session_user_airport_) LOOP
      latest_js_reason_ := Av_Exe_Task_API.Get_Latest_Jobstop_Reason(task_.task_seq);
       IF latest_js_reason_ IS NULL THEN
         in_range_task_rec_.objkey                      := sys_guid();
         in_range_task_rec_.parent_objkey               := objkey_;
         in_range_task_rec_.task_seq                    := task_.task_seq;
         in_range_task_rec_.fault_id                    := task_.fault_id;
         in_range_task_rec_.aircraft_id                 := task_.aircraft_id;
         in_range_task_rec_.barcode                     := task_.barcode;     
         in_range_task_rec_.description                 := task_.description;
         in_range_task_rec_.material_avail_user_status  := task_.material_avail_user_status;
         in_range_task_rec_.crew_code                   := task_.crew_code;
         in_range_task_rec_.planned_start               := task_.planned_start;
         in_range_task_rec_.planned_finish              := task_.planned_finish;
         in_range_task_rec_.actual_start                := task_.actual_start;
         in_range_task_rec_.actual_finish               := task_.actual_finish;
         in_range_task_rec_.aircraft_wp_id              := task_.aircraft_wp_id;
         in_range_task_rec_.config_position             := task_.config_position;
         in_range_task_rec_.class_code                  := task_.class_code;
         in_range_task_rec_.subclass_code               := task_.subclass_code;
         in_range_task_rec_.location                    := task_.location;
         in_range_task_rec_.crew_name                   := task_.crew_name;
         in_range_task_rec_.priority_id                 := task_.priority_id;
         in_range_task_rec_.long_description            := task_.long_description;
         in_range_task_rec_.shed_departure_date_time    := task_.shed_departure_date_time;
         
         CRUD_Create___(in_range_task_rec_);     
       END IF;
   END LOOP;  
END Add_In_Range_Tasks;

