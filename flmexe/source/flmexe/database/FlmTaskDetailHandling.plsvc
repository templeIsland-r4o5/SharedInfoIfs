FUNCTION Get_Find_Inventory_Url___ (
   external_page_path_ IN VARCHAR2,
   search_type_        IN VARCHAR2,
   aircraft_reg_code_  IN VARCHAR2,
   iata_code_          IN VARCHAR2,
   task_name_ref_      IN VARCHAR2) RETURN VARCHAR2
IS
   system_url_ FND_SETTING_TAB.value%TYPE := Fnd_Setting_API.Get_Value('SYSTEM_URL');
   url_        VARCHAR2(1000);
BEGIN
   IF system_url_ IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERROREMPTYSYSTEMURL: You cannot find inventory as the SYSTEM URL has not been defined with the system parameters. Contact your system administrator.');
   END IF;  
   
   url_:= system_url_ || external_page_path_ || '?aSearchType=' || UTL_URL.ESCAPE(search_type_) || chr(38) ||'aircraftTailNumber=' || UTL_URL.ESCAPE(aircraft_reg_code_) || chr(38) ||'supplyLocationCode=' || UTL_URL.ESCAPE(iata_code_) || chr(38) || 'taskReference=' || UTL_URL.ESCAPE(task_name_ref_);
   RETURN url_;
END Get_Find_Inventory_Url___;

FUNCTION Get_Select_Reference_Url___ (
   external_page_path_ IN VARCHAR2,
   a_task_id_          IN VARCHAR2,
   a_type_             IN VARCHAR2,
   a_source_           IN VARCHAR2) RETURN VARCHAR2
IS
   system_url_ FND_SETTING_TAB.value%TYPE := Fnd_Setting_API.Get_Value('SYSTEM_URL');
   url_        VARCHAR2(1000);
BEGIN
   IF system_url_ IS NULL THEN
      Error_SYS.Record_General(lu_name_, 'ERROREMPTYSYSTEMURL: You cannot find inventory as the SYSTEM URL has not been defined with the system parameters. Contact your system administrator.');
   END IF;
   
   url_:= system_url_ || external_page_path_ || '?aTaskId=' || UTL_URL.ESCAPE(a_task_id_) || chr(38) ||'aType=' || UTL_URL.ESCAPE(a_type_) || chr(38) ||'aSource=' || UTL_URL.ESCAPE(a_source_);
   RETURN url_;
END Get_Select_Reference_Url___;

PROCEDURE Request_Deferral___ (
   fault_id_ IN NUMBER)
IS
   attr_        VARCHAR2(32000);
   info_        VARCHAR2(400);
   objid_       VARCHAR2(100);
   objversion_  VARCHAR2(100);
   
   CURSOR get_deferral_request IS
      SELECT rowid, TO_CHAR(rowversion,'YYYYMMDDHH24MISS')    
      FROM   av_deferral_request_tab def_req
      WHERE  def_req.fault_id = fault_id_;
BEGIN
   OPEN get_deferral_request;
   FETCH get_deferral_request INTO objid_, objversion_;
   IF (get_deferral_request%FOUND)THEN
      CLOSE get_deferral_request;
      Client_SYS.Clear_Attr(attr_);
      Client_SYS.Add_To_Attr('DEFERRAL_REQUEST_STATUS', Deferral_Status_API.Decode(Deferral_Status_API.DB_PENDING), attr_);
      Client_SYS.Add_To_Attr('DEFERRAL_REQ_DATE_UTC', Time_Util_API.Get_Sysdate_In_Utc, attr_);
      Client_SYS.Add_To_Attr('REQUESTED_USER', Fnd_Session_API.Get_Fnd_User(), attr_);
      Client_SYS.Add_To_Attr('DEFERRAL_AUTHORIZATION', '', attr_);
      Client_SYS.Add_To_Attr('REJECTION_REASON', '', attr_);
      Client_SYS.Add_To_Attr('REAUTHORIZATION_REASON', '', attr_);
      Av_Deferral_Request_API.Modify__(info_,objid_,objversion_,attr_, 'DO');
   ELSE
      CLOSE get_deferral_request;
      Client_SYS.Clear_Attr(attr_);
      Client_SYS.Add_To_Attr('FAULT_ID', fault_id_ , attr_);
      Client_SYS.Add_To_Attr('DEFERRAL_REQUEST_STATUS', Deferral_Status_API.Decode(Deferral_Status_API.DB_PENDING), attr_);
      Client_SYS.Add_To_Attr('DEFERRAL_REQ_DATE_UTC', Time_Util_API.Get_Sysdate_In_Utc, attr_);
      Client_SYS.Add_To_Attr('REQUESTED_USER', Fnd_Session_API.Get_Fnd_User(), attr_);
      Av_Deferral_Request_API.New__(info_,objid_,objversion_,attr_, 'DO');
      
   END IF;
END Request_Deferral___;

