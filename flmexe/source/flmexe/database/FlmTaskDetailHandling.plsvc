@IgnoreUnitTest MethodOverride
@Override
PROCEDURE CRUD_Update___ (
   etag_   IN OUT VARCHAR2,
   key_    IN OUT av_installed_parts_key,
   attr_   IN OUT VARCHAR2,
   info_   OUT VARCHAR2,
   action_ IN  VARCHAR2 )
IS
   task_part_id_               NUMBER;
   installed_part_no_id_       NUMBER;
   installed_quantity_         NUMBER;
   quantity_                   VARCHAR2(40);
   part_no_                    VARCHAR2(40);
   installed_serial_no_        VARCHAR2(40);
   installed_batch_no_         VARCHAR2(40);
   installed_part_no_          VARCHAR2(40);
   rmvd_attr_                  VARCHAR2(32000);
   issued_quantity_            NUMBER;
   maint_material_order_no_    NUMBER;
   line_item_no_               NUMBER;
   old_assy_conf_slot_pos_id_  NUMBER;
   old_conf_slot_pos_id_       NUMBER;
   new_assy_conf_slot_pos_id_  NUMBER;
   new_conf_slot_pos_id_       NUMBER;
   inst_assemby_slot_pos_id_   NUMBER;
   inst_config_slot_pos_id_    NUMBER;
   inst_part_group_id_         NUMBER;
   inst_task_seq_              NUMBER;
   rmvd_task_part_id_          NUMBER;
   part_objid_                 VARCHAR2(200);
   part_objversion_            VARCHAR2(200);
   inv_class_code_             VARCHAR2(10);
   quantity_match_             VARCHAR2(100);
    
   CURSOR get_batch_number(part_no_ VARCHAR2, serial_no_ VARCHAR2) IS
      SELECT lot_batch_no
      FROM part_serial_catalog
      WHERE part_no = part_no_
      AND serial_no = serial_no_;
      
   CURSOR get_part_number_id is   
      SELECT part_number_id
      FROM av_part_number_tab 
      WHERE part_number = installed_part_no_;
   
   CURSOR get_inst_task_part_info (task_part_id_ IN NUMBER)IS
      SELECT task_seq, config_slot_position_id, assmbly_config_slot_pos_id, part_group_id
      FROM   av_exe_task_part_tab
      WHERE  task_part_id = task_part_id_;
      
   CURSOR get_rmv_task_part_info(rmvd_task_part_id_ IN NUMBER)IS
      SELECT config_slot_position_id, assmbly_config_slot_pos_id, rowid, TO_CHAR(rowversion,'YYYYMMDDHH24MISS')
      FROM   av_exe_task_part_tab
      WHERE  task_part_id = rmvd_task_part_id_;
   
BEGIN
   task_part_id_               := key_.task_part_id;
   installed_part_no_id_       := Av_Exe_Task_Part_API.Get_Installed_Part_No_Id(task_part_id_);
   part_no_                    := Av_Part_Number_API.Get_Part_Number(installed_part_no_id_);
   new_assy_conf_slot_pos_id_  := Client_SYS.Get_Item_Value('ASSMBLY_CONFIG_SLOT_POS_ID', attr_);
   new_conf_slot_pos_id_       := Client_SYS.Get_Item_Value('CONFIG_SLOT_POSITION_ID', attr_);
   maint_material_order_no_    := Av_Exe_Task_Part_API.Get_Maint_Material_Order_No (task_part_id_);
   line_item_no_               := Av_Exe_Task_Part_API.Get_Line_Item_No(task_part_id_);
   inv_class_code_             := Av_Part_Number_API.Get_Inventory_Class_Code(installed_part_no_id_);

   
   IF Client_SYS.Item_Exist('INSTALLED_SERIAL_NO', attr_) THEN
      installed_serial_no_ := Client_SYS.Get_Item_Value('INSTALLED_SERIAL_NO', attr_);
      IF installed_serial_no_ IS NOT NULL THEN
         OPEN get_batch_number(part_no_, installed_serial_no_);
         FETCH get_batch_number INTO installed_batch_no_;
         CLOSE get_batch_number;
      END IF;
      Client_SYS.Add_To_Attr('INSTALLED_BATCH_NO', installed_batch_no_, attr_);
   END IF;
   IF Client_SYS.Item_Exist('QUANTITY', attr_) THEN 
      issued_quantity_ := Maint_Material_Req_Line_API.Get_Qty (maint_material_order_no_ , line_item_no_);
      quantity_  := Client_SYS.Get_Item_Value('QUANTITY', attr_);
      quantity_match_ := REGEXP_SUBSTR(quantity_, '^\d+');
         IF quantity_match_ IS NOT NULL THEN
            installed_quantity_ := TO_NUMBER(quantity_match_);
         ELSE
            installed_quantity_ := Av_Exe_Task_Part_API.Get_Installed_Quantity(task_part_id_);
         END IF;
      
      IF installed_quantity_ < 1 THEN
         Error_SYS.Record_General(lu_name_, 'ERROREMPTYQTY:  Quantity must be greater than zero.');
      ELSIF issued_quantity_ > 0 AND installed_quantity_ > issued_quantity_ THEN
         Error_SYS.Record_General(lu_name_, 'ERROREMPTYQTY: Quantity cannot exceed the issued amount.');
      ELSE
         Client_SYS.Add_To_Attr('INSTALLED_QUANTITY', installed_quantity_, attr_);
      END IF;
   END IF;
   
   IF Client_SYS.Item_Exist('INSTALLED_PART_NO', attr_) THEN    
      installed_part_no_  := Client_SYS.Get_Item_Value('INSTALLED_PART_NO', attr_);
      
      OPEN get_part_number_id;
      FETCH get_part_number_id INTO installed_part_no_id_;
      CLOSE get_part_number_id;
      
     Client_SYS.Clear_Attr(attr_);
     Client_SYS.Add_To_Attr('INSTALLED_PART_NO_ID', installed_part_no_id_, attr_);
   END IF;
 
   OPEN  get_inst_task_part_info(task_part_id_);
   FETCH get_inst_task_part_info  INTO inst_task_seq_,inst_config_slot_pos_id_, inst_assemby_slot_pos_id_, inst_part_group_id_;
   CLOSE get_inst_task_part_info;
   
   rmvd_task_part_id_:= Av_Exe_Task_Part_API.Get_Rmvd_Task_Part_Id(task_part_id_,inst_task_seq_, inst_config_slot_pos_id_, inst_assemby_slot_pos_id_, inst_part_group_id_);
   
   OPEN  get_rmv_task_part_info(rmvd_task_part_id_);
   FETCH get_rmv_task_part_info INTO old_conf_slot_pos_id_,old_assy_conf_slot_pos_id_, part_objid_, part_objversion_;
   CLOSE get_rmv_task_part_info;
 
   Client_SYS.Clear_Attr(rmvd_attr_);
      
   IF old_assy_conf_slot_pos_id_ <> new_assy_conf_slot_pos_id_ THEN
      Client_SYS.Add_To_Attr('ASSMBLY_CONFIG_SLOT_POS_ID', new_assy_conf_slot_pos_id_, rmvd_attr_);
   END IF;
      
   IF old_conf_slot_pos_id_ <> new_conf_slot_pos_id_  THEN
      Client_SYS.Add_To_Attr('CONFIG_SLOT_POSITION_ID', new_conf_slot_pos_id_, rmvd_attr_);
   END IF;
      
   IF rmvd_attr_ IS NOT NULL THEN   
      Av_Exe_Task_Part_API.Modify__(info_, part_objid_, part_objversion_, rmvd_attr_, 'DO');
   END IF;  
   super(etag_, key_,attr_, info_, action_);
END CRUD_Update___;

@IgnoreUnitTest MethodOverride
@Override
PROCEDURE CRUD_Update___ (
   etag_   IN OUT VARCHAR2,
   key_    IN OUT av_removed_parts_key,
   attr_   IN OUT VARCHAR2,
   info_   OUT VARCHAR2,
   action_ IN  VARCHAR2 )
IS
   task_part_id_          NUMBER;
   task_return_line_seq_  NUMBER;
   removed_part_no_id_    NUMBER;
   removed_part_no_       VARCHAR2(40);
   removed_serial_no_     VARCHAR2(40);
   removed_batch_no_      VARCHAR2(40);
   serial_tracking_code_  VARCHAR2(20);
   lot_tracking_code_     VARCHAR2(20);
   return_attr_           VARCHAR2(32000);
BEGIN
   task_part_id_ := key_.task_part_id;
   task_return_line_seq_ := Av_Exe_Task_Part_API.Get_Task_Return_Line_Seq(task_part_id_);
   Client_SYS.Clear_Attr(return_attr_);
   
   IF task_return_line_seq_ IS NOT NULL THEN
      IF Client_SYS.Item_Exist('REMOVED_PART_NO_ID', attr_) THEN     
         removed_part_no_id_  := Client_SYS.Get_Item_Value('REMOVED_PART_NO_ID', attr_);
         removed_part_no_ := Av_Part_Number_API.Get_Part_Number(removed_part_no_id_);
      END IF;
      IF removed_part_no_ IS NULL THEN
         removed_part_no_id_ := Av_Exe_Task_Part_API.Get_Removed_Part_No_Id(task_part_id_);
         removed_part_no_ := Av_Part_Number_API.Get_Part_Number(removed_part_no_id_);
      END IF;
      IF Client_SYS.Item_Exist('REMOVED_SERIAL_NO', attr_) THEN     
         removed_serial_no_  := Client_SYS.Get_Item_Value('REMOVED_SERIAL_NO', attr_);
         serial_tracking_code_ := UPPER(Part_Catalog_API.Get_Serial_Tracking_Code(removed_part_no_));
         IF serial_tracking_code_ = Part_Serial_Tracking_API.DB_SERIAL_TRACKING THEN 
            Client_SYS.Add_To_Attr('SERIAL_NO', removed_serial_no_, return_attr_);
         END IF;
      END IF;
      IF Client_SYS.Item_Exist('REMOVED_BATCH_NO', attr_) THEN     
         removed_batch_no_  := Client_SYS.Get_Item_Value('REMOVED_BATCH_NO', attr_);
         lot_tracking_code_ := UPPER(Part_Catalog_API.Get_Lot_Tracking_Code(removed_part_no_));
         IF lot_tracking_code_ = Part_Lot_Tracking_API.DB_LOT_TRACKING THEN
            Client_SYS.Add_To_Attr('LOT_BATCH_NO', removed_batch_no_, return_attr_);
         END IF;
      END IF;
      
      Jt_Task_Return_API.Update_Returns_Line(task_return_line_seq_, return_attr_);
   END IF;
   super(etag_, key_,attr_, info_, action_);
END CRUD_Update___;

PROCEDURE Update_Removed_Serial_Number___ (
   removed_serial_no_ IN VARCHAR2,
   task_part_id_ IN VARCHAR2)
IS
   rmvd_task_part_id_          NUMBER;
   inst_assemby_slot_pos_id_   NUMBER;
   inst_config_slot_pos_id_    NUMBER;
   inst_part_group_id_         NUMBER;
   inst_task_seq_              NUMBER;
   
    CURSOR get_inst_task_part_info (task_part_id_ IN NUMBER)IS
      SELECT task_seq, config_slot_position_id, assmbly_config_slot_pos_id, part_group_id
      FROM   av_exe_task_part_tab
      WHERE  task_part_id = task_part_id_;
  
BEGIN   
   OPEN  get_inst_task_part_info(task_part_id_);
   FETCH get_inst_task_part_info  INTO inst_task_seq_,inst_config_slot_pos_id_, inst_assemby_slot_pos_id_, inst_part_group_id_;
   CLOSE get_inst_task_part_info;
   
   rmvd_task_part_id_:= Av_Exe_Task_Part_API.Get_Rmvd_Task_Part_Id(task_part_id_,inst_task_seq_, inst_config_slot_pos_id_, inst_assemby_slot_pos_id_, inst_part_group_id_);
   
   Av_Exe_Task_Part_API.Update_Removed_Serial_No(removed_serial_no_,rmvd_task_part_id_);
    
END Update_Removed_Serial_Number___;
