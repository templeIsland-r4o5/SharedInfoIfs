@IgnoreUnitTest PLSQLInSQL
PROCEDURE Delete_Zone___ (
   zone_id_     IN NUMBER,
   task_seq_    IN NUMBER,
   ac_zone_seq_ IN NUMBER)
IS
   CURSOR get_panels_related_to_zone IS 
      SELECT tp.task_seq,tp.ac_panel_seq, tp.panel_req_id
      FROM av_exe_task_panel_tab tp
      JOIN av_aircraft_panel_tab ap
      ON ap.ac_panel_seq = tp.ac_panel_seq
      JOIN av_aircraft_zone_tab az
      ON az.ac_zone_seq = ap.ac_zone_seq
      WHERE tp.task_seq = task_seq_
      AND ap.ac_zone_seq = ac_zone_seq_;
   
BEGIN
   
   FOR rec_ IN get_panels_related_to_zone LOOP 
      Av_Exe_Task_Panel_API.Remove(task_seq_,rec_.ac_panel_seq,rec_.panel_req_id);   
   END LOOP;
   
   Av_Exe_Task_Zone_API.Remove(zone_id_,task_seq_,ac_zone_seq_);
   
END Delete_Zone___;

