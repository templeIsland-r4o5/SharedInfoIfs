PROCEDURE Add_Measurement___ (
   task_seq_                IN NUMBER,
   measurement_domain_type_ IN VARCHAR2,
   measurement_type_code_   IN VARCHAR2,
   meas_type_value_code_    IN VARCHAR2,
   measurement_qty_         IN NUMBER,
   measurement_date_time_   IN DATE,
   measurement_text_        IN VARCHAR2,
   measurement_boolean_     IN BOOLEAN,
   task_site_               IN VARCHAR2)
IS
   info_                    VARCHAR2(200);
   objid_                   VARCHAR2(200);
   objversion_              VARCHAR2(200);
   attr_                    VARCHAR2(32000);
   measurement_boolean_txt_ VARCHAR2(20);
BEGIN
   Client_SYS.Add_To_Attr('TASK_SEQ', task_seq_, attr_);
   Client_SYS.Add_To_Attr('MEASUREMENT_TYPE_CODE', measurement_type_code_, attr_);
   Client_SYS.Add_To_Attr('IS_TASK_DEF_DB', 'FALSE', attr_);
   IF(measurement_domain_type_ = 'CH') THEN
      Client_SYS.Add_To_Attr('MEAS_TYPE_VALUE_CODE', meas_type_value_code_, attr_);
   ELSIF (measurement_domain_type_ = 'ME') THEN
      Client_SYS.Add_To_Attr('MEASUREMENT_QTY', measurement_qty_, attr_);
   ELSIF (measurement_domain_type_ = 'CME') THEN
      Client_SYS.Add_To_Attr('MEASUREMENT_DATE_TIME', measurement_date_time_, attr_);
   ELSIF (measurement_domain_type_ = 'TEXT') THEN
      Client_SYS.Add_To_Attr('MEASUREMENT_TEXT', measurement_text_, attr_);
   ELSIF (measurement_domain_type_ = 'CHK') THEN
      IF measurement_boolean_ = TRUE THEN
         measurement_boolean_txt_ := 'TRUE';
      ELSIF measurement_boolean_ = FALSE THEN
         measurement_boolean_txt_ := 'FALSE';
      END IF;
      Client_SYS.Add_To_Attr('MEASUREMENT_BOOLEAN_DB', measurement_boolean_txt_, attr_);
   END IF;
   
   Av_Exe_Task_Measurement_API.New__(info_, objid_,objversion_,attr_,'DO');
END Add_Measurement___;

