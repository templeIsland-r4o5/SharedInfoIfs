      ASSERT Bool_To_Number__(return_.Include_Removal )= Bool_To_Number__(expected_.Include_Removal )MESSAGE test_case_ || ':'|| 'Expected '||Bool_To_Number__(expected_.Include_Removal)||' but returned '||Bool_To_Number__(return_.Include_Removal);

      IF info$_ IS NULL THEN
         ASSERT output1_ IS NULL MESSAGE test_case_ || ':'||'Expected '||'NULL'||' but  was '||output1_;
      ELSE
         ASSERT Extract_Message_From_Info___(output1_) = info$_ MESSAGE test_case_ || ':'||'Expected '||info$_||' but  was '||Extract_Message_From_Info___(output1_);
      END IF;
   END LOOP;
END UNITTEST;

UNITTEST "Get_Assembly_Info___ should return sub assembly data when assembly_type_code_,aircraft_id_ and inventory_class_code_ are passed" FOR
   FUNCTION Get_Assembly_Info___ (
      assembly_type_code_   IN     VARCHAR2,
      aircraft_id_          IN     NUMBER,
      inventory_class_code_ IN     VARCHAR2) RETURN Part_Group_Info_Structure_Rec;
USING
   test_case_  VARCHAR2(100);

   @MockTable av_sub_assy_inventory_tab
   VALUES
      | assembly_type_code | aircraft_id | config_slot_position_id |
      | 'CFM'              | 11          | 22                      |
      | 'MLG'              | 11          | 30                      |
      | 'MLG'              | 11          | 31                      |
   END VALUES;

   @MockTable aircraft_tab
   VALUES
      |assembly_type_Code |aircraft_id |
      |NULL               |1           |
      |'B737'             |11          |
   END VALUES;

IS
   --Insert your test variables here
   return_   Part_Group_Info_Structure_Rec;
   expected_ Part_Group_Info_Structure_Rec;
   expected_1 Part_Group_Info_Structure_Rec;
   expected_2 Part_Group_Info_Structure_Rec;
   expected_3 Part_Group_Info_Structure_Rec;

BEGIN
   expected_1.assmbl_visibility := FALSE;
   expected_1.assmbl_editable := FALSE;
   expected_1.assembly_position_id := NULL;

   expected_2.assmbl_visibility := TRUE;
   expected_2.assmbl_editable := FALSE;
   expected_2.assembly_position_id := 22;

   expected_3.assmbl_visibility := TRUE;
   expected_3.assmbl_editable := TRUE;
   expected_3.assembly_position_id := NULL;


   FOR
      | expected_ | assembly_type_code_ | aircraft_id_ | inventory_class_code_ |test_case_|
      | expected_1| 'B737'              | 11           | 'TRK'                 |'test 01' |
      | expected_2| 'CFM'               | 11           | 'TRK'                 |'test 02' |
      | expected_3| 'MLG'               | 11           | 'TRK'                 |'test 03' |
   LOOP
      --Insert your test code here
      return_ := Get_Assembly_Info___(assembly_type_code_, aircraft_id_, inventory_class_code_);
      --Insert your assertions here
      ASSERT Bool_To_Number__(return_.assmbl_visibility )= Bool_To_Number__(expected_.assmbl_visibility )MESSAGE test_case_ || ':'|| 'Expected '||Bool_To_Number__(expected_.assmbl_visibility)||' but returned '||Bool_To_Number__(return_.assmbl_visibility);

      ASSERT Bool_To_Number__(return_.assmbl_editable )= Bool_To_Number__(expected_.assmbl_editable )MESSAGE test_case_ || ':'|| 'Expected '||Bool_To_Number__(expected_.assmbl_editable)||' but returned '||Bool_To_Number__(return_.assmbl_editable);

      IF return_.assembly_position_id IS NULL THEN
         ASSERT expected_.assembly_position_id IS NULL MESSAGE 'Expected NULL but returned not NULL';
      ELSE
         ASSERT return_.assembly_position_id = expected_.assembly_position_id MESSAGE test_case_ || ':'|| 'Expected '||expected_.assembly_position_id||' but returned '||return_.assembly_position_id;
      END IF;
   END LOOP;
END UNITTEST;