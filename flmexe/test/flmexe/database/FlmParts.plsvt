layer Core;

FUNCTION Bool_To_Number__(value_ BOOLEAN) RETURN NUMBER
IS
BEGIN
   RETURN CASE WHEN value_ THEN 1 ELSE 0 END;
END Bool_To_Number__;

FUNCTION Extract_Message_From_Info___(input_string_ VARCHAR2) RETURN VARCHAR2
IS
   start_pos_ NUMBER;
   end_pos_ NUMBER;
BEGIN
   -- Find the position of field_separator character
   start_pos_ := INSTR(input_string_, Client_SYS.field_separator_) + LENGTH(Client_SYS.field_separator_);
   -- Find the position of the record_separator character
   end_pos_ := INSTR(input_string_, Client_SYS.record_separator_, start_pos_);
   -- Extract the message
   RETURN SUBSTR(input_string_, start_pos_, end_pos_ - start_pos_);
END Extract_Message_From_Info___;


