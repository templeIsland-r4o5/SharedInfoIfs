    <Select>
        <DataColumn>
            <Column>FlightId</Column>
            <Name>Flight Id</Name>
            <DataType>Number</DataType>
        </DataColumn>
        <DataColumn>
            <Column>LockedBool</Column>
            <Name>Locked Bool</Name>
            <DataType>Boolean</DataType>
        </DataColumn>
        <DataColumn>
            <Column>Condition</Column>
            <Name>Condition</Name>
            <DataType>Text</DataType>
        </DataColumn>
        <DataColumn>
            <Column>DepartureTime</Column>
            <Name>Departure Time</Name>
            <DataType>Date</DataType>
        </DataColumn>
        <DataColumn>
            <Column>ResourceAssignmentStatus</Column>
            <Name>Resource Assignment Status</Name>
            <DataType>Number</DataType>
        </DataColumn>
    </Select>
    <TimeZoneAwareness>
        <Enabled>true</Enabled>
        <Type>SERVER</Type>
    </TimeZoneAwareness>
    <Projection>FlmLineWorkManagementLobbyHandling</Projection>
    <EntitySet>FlmTurnResourceSet</EntitySet>
    <EntityType>FlmTurnResource</EntityType>
    <Filter>(ResourceAssignmentStatus eq 1 or ResourceAssignmentStatus eq 2)  
and (LockedBool eq false or LockedBool eq null) 
and (Condition ne 'SCRAP' and Condition ne 'ARCHIVE')</Filter>
