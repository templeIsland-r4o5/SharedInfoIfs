            <Column>ResourceAssignmentStatus</Column>
            <Name>Resource Assignment Status</Name>
            <DataType>Number</DataType>
        </DataColumn>
    </Select>
    <TimeZoneAwareness>
        <Enabled>true</Enabled>
        <Type>SERVER</Type>
    </TimeZoneAwareness>
    <Projection>FlmLineWorkManagementLobbyHandling</Projection>
    <EntitySet>FlmTurnResourceSet</EntitySet>
    <EntityType>FlmTurnResource</EntityType>
    <Filter>ResourceAssignmentStatus eq 3 
