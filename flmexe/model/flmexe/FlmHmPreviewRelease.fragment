   }
}

list NeardueFaultsList for NeardueFaultQuery {
   label = "Near Due Faults (${parent.NeardueFaultsCount})";

   lov NeardueFaultRef with AvFaultSelector {
      label = "Fault Barcode";
      details = "page/MxOpenFaultDetails/OpenFaultDetails?$filter=Barcode eq $[FaultBarcode]";
      editable = [false];

   }
   field FaultName {
      label = "Name";
      multiline = true;
   }
   field FailedSystem;
   field FaultSeverity;
   field FoundOnDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field FoundOnFlight;
   field FailureType;
   field FaultPriority;
   field DeferralClass;
   field DeferralReference;
   field DueDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field AssignedToWpId {
      label = "Assigned to WP";
   }
   field AssignedToWpName {
      label = "Assigned to WP Name";
      multiline = true;
