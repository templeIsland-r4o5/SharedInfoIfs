fragment FlmHmPreviewRelease;
component FLMEXE;
layer Core;
description "This contains all the resources required for Preview Release assistant";

--------------------------------- FRAGMENTS ---------------------------------
include fragment AircraftPanel;
include fragment PanelLovSelector;
include fragment FlmHmCompleteWorkPackage;

----------------------------- CLIENT FRAGMENTS ------------------------------

-------------------------------- ASSISTANTS ---------------------------------

assistant PreviewReleaseAssistant using PreviewReleaseVirtualSet {
   label = "Preview Release";
   savemode = OnLostFocus;

   input(WpId, AircraftId, AircraftAltId);
   setup InitAssistant {
      variable WpIdVar Number;
      variable AircraftIdVar Number;
      variable AircraftAltIdVar Text;

      execute {
         set AircraftWorkPackageId = WpIdVar;
         set AircraftId = AircraftIdVar;
         set AircraftAltId = AircraftAltIdVar;
      }
   }

   init command {
      variable PrevReleaseSummaryVar Structure(PreviewReleaseInfoStructure);

      execute {
         call GetPrevReleaseSummaryInfo(AircraftWorkPackageId, AircraftId, AircraftAltId) into PrevReleaseSummaryVar;
         set CmsWarningExist = PrevReleaseSummaryVar.CmsWarningExist;
         set CmsStatus = PrevReleaseSummaryVar.CmsStatus;
         set CmsWarningCount = PrevReleaseSummaryVar.CmsWarningCount;
         set AogFaultStatus = PrevReleaseSummaryVar.AogFaultStatus;
         set AogFaultsCount = PrevReleaseSummaryVar.AogFaultsCount;
         set AogFaults = PrevReleaseSummaryVar.AogFaults;
         set OpenFaultStatus = PrevReleaseSummaryVar.OpenFaultStatus;
         set OpenFaultsCount = PrevReleaseSummaryVar.OpenFaultsCount;
         set OpenFaults = PrevReleaseSummaryVar.OpenFaults;
         set OverdueFaultStatus = PrevReleaseSummaryVar.OverdueFaultStatus;
         set OverdueFaultsCount = PrevReleaseSummaryVar.OverdueFaultsCount;
         set OverdueFaults = PrevReleaseSummaryVar.OverdueFaults;
         set NeardueFaultStatus = PrevReleaseSummaryVar.NeardueFaultStatus;
         set NeardueFaultsCount = PrevReleaseSummaryVar.NeardueFaultsCount;
         set NeardueFaults = PrevReleaseSummaryVar.NeardueFaults;
         set IncompleteTasks = PrevReleaseSummaryVar.IncompleteTasks;
         set IncompleteTasksCount = PrevReleaseSummaryVar.IncompleteTasksCount;
         set OverdueTasks = PrevReleaseSummaryVar.OverdueTasks;
         set OverdueTaskStatus = PrevReleaseSummaryVar.OverdueTaskStatus;
         set OverdueTasksCount = PrevReleaseSummaryVar.OverdueTasksCount;
         set NeardueTasks = PrevReleaseSummaryVar.NeardueTasks;
         set NeardueTaskStatus = PrevReleaseSummaryVar.NeardueTaskStatus;
         set NeardueTasksCount = PrevReleaseSummaryVar.NeardueTasksCount;
         set OpenPanels = PrevReleaseSummaryVar.OpenPanels;
         set ShowOpenPanels = PrevReleaseSummaryVar.ShowOpenPanels;
         set OpenPanelCount = PrevReleaseSummaryVar.OpenPanelCount;
         set ProceedToComplete = PrevReleaseSummaryVar.ProceedToComplete;
         set ReleaseNotifyIntvl = PrevReleaseSummaryVar.ReleaseNotifyIntvl;
      }
   }

   singlestep {
      group SummaryGroup;
      list MissingMandaCompList(MissingMandaCompArray);
      list TaskPartList(TaskPartDetailsArray);
      list OpenFaultsList(OpenFaultsArray);
      list OverdueFaultsList(OverdueFaultsArray);
      list NeardueFaultsList(NeardueFaultsArray);
      list IncompleteTasksList(IncompleteTasksArray);
      list OverdueTasksList(OverdueTasksArray);
      list NeardueTasksList(NeardueTasksArray);
      list OpenPanelList(OpenPanelDetailsArray) {
         visible = [ShowOpenPanels];
      }
   }

   command CompleteWpInPrevReleaseCommand;
   command CancelPrevRelease;
}

---------------------------------- GROUPS -----------------------------------

group SummaryGroup for PreviewReleaseVirtual {
   label = "Summary";

   badge MissingMandaComps {
      label = "Mandatory Components Missing";
      editable = [false];
      emphasis Ok = [MissingMandaStatus = "OK"];
      emphasis Warning = [MissingMandaStatus = "WARN"];
      emphasis Failure = [MissingMandaStatus = "ERROR"];
   }
   badge CmsWarningExist {
      label = "Configuration Warnings";
      editable = [false];
      emphasis Failure = [CmsStatus = 1];
      emphasis Ok = [CmsStatus = -1];
      emphasis Warning = [CmsStatus = 0];
   }
   badge AogFaults {
      label = "AOG Faults";
      editable = [false];
      emphasis Ok = [AogFaultStatus = "OK"];
      emphasis Warning = [AogFaultStatus = "WARN"];
      emphasis Failure = [AogFaultStatus = "ERROR"];
   }
   badge OpenFaults {
      editable = [false];
      emphasis Ok = [OpenFaultStatus = "OK"];
      emphasis Warning = [OpenFaultStatus = "WARN"];
      emphasis Failure = [OpenFaultStatus = "ERROR"];
   }
   badge OverdueFaults {
      editable = [false];
      emphasis Ok = [OverdueFaultStatus = "OK"];
      emphasis Warning = [OverdueFaultStatus = "WARN"];
      emphasis Failure = [OverdueFaultStatus = "ERROR"];
   }
   badge NeardueFaults {
      label = "Near Due Faults";
      editable = [false];
      emphasis Ok = [NeardueFaultStatus = "OK"];
      emphasis Warning = [NeardueFaultStatus = "WARN"];
      emphasis Failure = [NeardueFaultStatus = "ERROR"];
   }
   badge IncompleteTasks {
      label = "Incomplete Tasks in This WP";
      editable = [false];
      emphasis Ok = [IncompleteTasks = false];
      emphasis Failure = [IncompleteTasks = true];
   }
   badge OverdueTasks {
      editable = [false];
      emphasis Ok = [OverdueTaskStatus = "OK"];
      emphasis Warning = [OverdueTaskStatus = "WARN"];
      emphasis Failure = [OverdueTaskStatus = "ERROR"];
   }
   badge NeardueTasks {
      label = "Near Due Tasks";
      editable = [false];
      emphasis Ok = [NeardueTaskStatus = "OK"];
      emphasis Warning = [NeardueTaskStatus = "WARN"];
      emphasis Failure = [NeardueTaskStatus = "ERROR"];
   }
   badge OpenPanels {
      label = "Open Panels in This WP";
      editable = [false];
      visible = [ShowOpenPanels];
      emphasis Failure = [OpenPanelCount > 0];
      emphasis Ok = [OpenPanelCount = 0];
   }
}

----------------------------------- LISTS -----------------------------------

list IncompleteTasksList for IncompleteTaskQuery {
   label = "Incomplete Tasks in This Work Package (${parent.IncompleteTasksCount})";

   lov AvExeTaskRef with AvExeTaskSelector {
      label = "Barcode";
      details = "page/FlmTaskDetail/MyWorkPage?$filter=Barcode eq $[AvExeTaskRef.Barcode]";
      editable = [false];
   }
   field Description {
      label = "Name";
      multiline = true;
   }
   field ConfigPosition {
      label = "Config Slot";
   }
   field AircraftRef.AssemblyTypeCode {
      label = "Parent Assembly";
   }
   badge Objstate {
      label = "Task Status";
      emphasis StatePreliminary = [Objstate = "RELEASED"];
      emphasis StateInProgress = [Objstate = "WORKSTARTED"];
   }
   field ClassCode {
      label = "Class";
   }
   field AvAircraftWpRef.Barcode {
      label = "Assigned To WP";
   }
   field AvAircraftWpRef.WorkPackageName {
      label = "Assigned To WP Name";
      multiline = true;
   }
}

list OverdueTasksList for OverdueTaskQuery {
   label = "Overdue Tasks (${parent.OverdueTasksCount})";

   lov OverdueTaskRef with AvExeTaskSelector {
      label = "Barcode";
      details = "page/MxTaskDetails/TaskDetails?$filter=TaskId eq $[TaskBarcode]";
      editable = [false];
   }
   field TaskName {
      label = "Name";
      multiline = true;
   }
   field ConfigSlot;
   field Inventory;
   badge TaskStatus {
      emphasis StatePreliminary = [TaskStatus = "ACTV"];
      emphasis StateInProgress = [TaskStatus = "IN WORK"];
   }
   field ClassCode {
      label = "Class";
   }
   field WorkType {
      label = "Work Type(s)";
   }
   field SchedulePriority;
   field DueDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field AssignedToWpId {
      label = "Assigned To WP";
   }
   field AssignedToWpName {
      label = "Assigned To WP Name";
      multiline = true;
   }
}

list NeardueTasksList for NeardueTaskQuery {
   label = "Near Due Tasks (${parent.NeardueTasksCount})";

   lov NeardueTaskRef with AvExeTaskSelector {
      label = "Barcode";
      details = "page/MxTaskDetails/TaskDetails?$filter=TaskId eq $[TaskBarcode]";
      editable = [false];
   }
   field TaskName {
      label = "Name";
      multiline = true;
   }
   field ConfigSlot;
   field Inventory;
   badge TaskStatus {
      emphasis StatePreliminary = [TaskStatus = "ACTV"];
      emphasis StateInProgress = [TaskStatus = "IN WORK"];
      emphasis Default = [TaskStatus = "FORECAST"];
   }
   field ClassCode {
      label = "Class";
   }
   field DueDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field WorkType {
      label = "Work Type(s)";
   }
   field SchedulePriority;
   field AssignedToWpId {
      label = "Assigned To WP";
   }
   field AssignedToWpName {
      label = "Assigned To WP Name";
      multiline = true;
   }
}

list TaskPartList for ConfigurationWarningQuery {
   label = "Configuration Warnings (${parent.CmsWarningCount})";

   lov AvExeTaskRef with AvExeTaskSelector {
      label = "Task Barcode";
      hidekey = [true];
      details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      description = AvExeTaskRef.Barcode;
   }
   field AvExeTaskRef.Description {
      label = "Name";
      multiline = true;
   }
   badge AvExeTaskRef.Objstate {
      label = "Task Status";
      emphasis StatePreliminary = [AvExeTaskRef.Objstate = "RELEASED"];
      emphasis StateInProgress = [AvExeTaskRef.Objstate = "WORKSTARTED"];
      emphasis StateCompleted = [AvExeTaskRef.Objstate = "FINISHED"];
      emphasis Alert = [AvExeTaskRef.Objstate = "REMOVED"];
   }
   field ConfigSlotCode {
      label = "Config Slot";
   }
   field PartNumber {
      label = "Part No";
   }
   field PartSerialNo {
      label = "Serial No";
   }
   field AvTaskPartWarningRef.Warning {
      label = "Warning Details";
   }
   field AvTaskPartWarningRef.Code {
      label = "Warning Code";
   }
   field AvWorkPackageRef.Barcode {
      label = "Assigned to WP";
   }
   field AvWorkPackageRef.WorkPackageName {
      label = "Assigned to WP Name";
      multiline = true;
   }
}

list OpenPanelList for OpenedPanelQuery {
   label = "Open Panels in This Work Package (${parent.OpenPanelCount})";

   lov AvPanelCodeRef with PanelCodeSelector {
      label = "Panel Code";
      details = "page/MxPanelDetails/PanelDetails?$filter=AdBrPanelId eq $[AvAircraftPanelRef.PanelAltId]";
   }
   field AvAircraftPanelRef.PanelDescription {
      label = "Panel Name";
      multiline = true;
      size = Large;
   }
   lov MpcCloseTaskRef with AvExeTaskSelector {
      label = "MPC Close Task Barcode";
      hidekey = [true];
      details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[CloseTaskSeq]";
      description = MpcCloseTaskRef.Barcode;
   }
   field MpcCloseTaskRef.Description {
      label = "MPC Close Task Name";
      size = Large;
   }
}

list OpenFaultsList for OpenFaultQuery {
   label = "Open Faults (${parent.OpenFaultsCount})";

   lov OpenFaultRef with AvFaultSelector {
      label = "Fault Barcode";
      details = "page/MxOpenFaultDetails/OpenFaultDetails?$filter=Barcode eq $[FaultBarcode]";
      editable = [false];

   }
   field FaultName {
      label = "Name";
      multiline = true;
   }
   field FailedSystem;
   field FaultSeverity;
   field FoundOnDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field FoundOnFlight;
   field FailureType;
   field FaultPriority;
   field DeferralClass;
   field DeferralReference;
   field DueDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field AssignedToWpId {
      label = "Assigned to WP";
   }
   field AssignedToWpName {
      label = "Assigned to WP Name";
      multiline = true;
   }
}

list OverdueFaultsList for OverdueFaultQuery {
   label = "Overdue Faults (${parent.OverdueFaultsCount})";

   lov OverdueFaultRef with AvFaultSelector {
      label = "Fault Barcode";
      details = "page/MxOpenFaultDetails/OpenFaultDetails?$filter=Barcode eq $[FaultBarcode]";
