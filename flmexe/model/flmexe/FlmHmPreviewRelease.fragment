function GetPrevReleaseSummaryInfo Structure(PreviewReleaseInfoStructure) {
   parameter AircraftWorkPackageId Number;
   parameter AircraftId Number;
   parameter AircraftAltId Text;
}

function SetCompleteWorkPackageValues Structure(CompleteWorkPackageInfoStruct) {
   initialcheck none;
   parameter AircraftId Number;
   parameter AircraftWorkPackageId Number;
   parameter AircraftAltId Text;
   parameter ReleaseBlockersInfo Structure(ReleaseBlockersInfoStructure);
}

action ValidateReleaseBlockers Structure(ReleaseBlockersInfoStructure) {
   initialcheck implementation;
   parameter WorkPackageId Number;
   parameter AircraftId Number;
}
