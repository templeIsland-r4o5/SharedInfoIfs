   field FailureType;
   field FaultPriority;
   field DeferralClass;
   field DeferralReference;
   field DueDate {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field AssignedToWpId {
      label = "Assigned to WP";
   }
   field AssignedToWpName {
      label = "Assigned to WP Name";
