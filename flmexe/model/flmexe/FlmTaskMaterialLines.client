client FlmTaskMaterialLines;
component FLMEXE;
layer Core;
projection FlmTaskMaterialLinesHandling;

description "Aviation Maintenance Material Lines Client";

--------------------------------- FRAGMENTS ---------------------------------
include fragment AvTaskMaterial;
include fragment UserAllowedSiteLovSelector;
----------------------------- NAVIGATOR ENTRIES -----------------------------
entry FlmTaskMatReqLinesNavEntry parent MxCoreNavigator.MaterialControllerNav at index 500 {
   label = "Maintenance Material Requisition Lines";
   page FlmAvMaterialRequisitionLines;
}
-------------------------------- MAIN PAGES ---------------------------------
page FlmAvMaterialRequisitionLines using MaintMaterialReqLineSet {
   label = "Maintenance Material Requisition Lines";
   startupmode = search;
   list AvMatReqAllList;
}
