--------------------------------- COMMANDS ----------------------------------
command PrintReport for HandOverDetailsVirtual {
   label = "Print";
   visible = [((Source != "HMSLOBBY" and Source != "HMCLOBBY") or(AircraftId != null and WorkPackageId != null)) and StartTime != null and EndTime != null];
   variable ResultKeyVar {
      type = Number;
   }
   execute {
      call ExecuteReport() into ResultKeyVar;
      if [ResultKeyVar != null] {
         success("Report (Results Key: ${ResultKeyVar}) saved and archived. PDF will be generated after printing.");
         printdialog ResultKeyVar;
      }

   }
}

command  CancelBack {
   label = "Cancel";
   execute {
      navigate back;
   }
}

command EditHandoverNote for AvHandoverNote {
   icon = "edit";
   label = "";
   mode = SingleRecord;
   enabled = [CreatedBy = CurrentUser and CreatedDate >= NoteEditableFromDate and CreatedDate <= CurrentDate];
   variable HandoverNoteInfo Structure(HandoverNoteStructure);

   execute {
      copy this into HandoverNoteInfo;
      dialog EditHandoverNoteDialog(HandoverNoteInfo) into(Priority, HandoverNote);
   }
}

command AddHandoverNote for HandOverDetailsVirtual {
   icon = "new";
   label = "";
   mode = Global;

   enabled = [WorkPackageId != null];
   variable HandoverNoteInfo Structure(HandoverNoteStructure);

   execute {
      copy this into HandoverNoteInfo;
      assistant AddHandoverNoteAssistant(HandoverNoteInfo) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command SaveHandoverNote for HandoverNoteStructure {
   label = "Save";
   enabled = [Priority != null and HandoverNote != null];
   execute {
      call AddNewHandoverNote(WorkPackageId, HandoverNote, Priority, CreatedBy, CreatedDate);
   }
}
--------------------------- PROJECTION FRAGMENTS ----------------------------
entityset HandOverDetailsVirtualSet for HandOverDetailsVirtual;

@Override
entity AvExeTask {
   attribute Barcode Text {
      lovcolumn = [true];
   }
   attribute LatestJobStopDate Timestamp {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Date(task_seq)";
   }
   attribute IsRoutine Boolean {
      fetch = "DECODE(Av_Exe_Task_API.Get_Is_Routine(task_seq), 1, 'TRUE','FALSE')";
   }
   attribute Aircraft Text {
      label = "Aircraft";
      fetch = "CONCAT(CONCAT((Aircraft_API.Get_Assembly_Type_Code(Aircraft_Id)), ' - '), TO_CHAR(Aircraft_API.Get_Reg_Code(Aircraft_Id)))";
      lovcolumn = [true];
   }
   reference TaskRef(Barcode) to AvExeTask(Barcode);
   reference AvDeferralRequestRef(FaultId) to AvDeferralRequest(FaultId);
}

@Override
entity AvFlight {
   crud = Read;
   from = "MY_AIRCRAFT_TURNS";
   where = "flight_turn_status='InMaintenance'";
   timestamptzref = "server";
   attribute Aircraft Text {
      label = "Aircraft";
      fetch = "CONCAT(CONCAT(assembly_type_code, ' - '), TO_CHAR(Aircraft_API.Get_Reg_Code(aircraft_id)))";
   }
   attribute FlightTurnStatus Enumeration(TurnStatusEnum);
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute WorkPackageActualStart Timestamp {
      fetch = "Av_Aircraft_Work_Package_API.Get_Func_Actual_Start (aircraft_id, arrival_airport_id, flight_id)";
   }
   attribute WorkPpackageId Number;
   attribute DeptSchedDepDateTime Timestamp;
   attribute DeptFlightDepartureGate Text;
   attribute DeptLegNo Text;
   attribute OutboundStation Text;
}

@Override
entity AvFault {
   timestamptzref = "server";
   crud = Create, Read, Update, Delete;

   attribute Barcode Text;
   attribute TaskSeq Number;
   attribute Aircraft Text {
      label = "Aircraft";
      fetch = "CONCAT(CONCAT((Aircraft_API.Get_Assembly_Type_Code(Aircraft_Id)), ' - '), TO_CHAR(Aircraft_API.Get_Reg_Code(Aircraft_Id)))";
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute FoundSource Text {
      fetch = "Av_Fault_API.Get_Found_Source(fault_id)";
   }
   attribute Priority Text {
      fetch = "Av_Exe_Task_API.Get_Priority_Id(task_seq)";
   }
   attribute HasFlightSafetyImpact Boolean {
      fetch = "DECODE(flight_safety_impact, 1, 'TRUE','FALSE')";
      editable = [false];
   }
   attribute EvaluatedBy Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(Evaluated_By))";
   }
   attribute Action Text {
      fetch = "Av_Fault_Action_API.Get_Latest_Correct_Fault_Act(fault_id)";
   }
   attribute DeferralAction Text {
      fetch = "Av_Fault_Action_API.Get_Latest_Correct_Fault_Act(fault_id)";
   }
   attribute SchedEndDateTime Timestamp {
      fetch = "Av_Aircraft_Work_Package_API.Get_Sched_End_Date_Time(Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq))";
   }
   attribute ActualStartDateTime Timestamp {
      fetch = "Av_Aircraft_Work_Package_API.Get_Actual_Start_Date_Time(Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq))";
   }
   attribute DueDate Timestamp {
      fetch = "Av_Fault_Deadline_API.Get_Act_Deadline_Date(fault_id)";
   }
   attribute LatestJobStopReason Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Reason(task_seq)";
   }
   attribute LatestJobStopNote Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Note(task_seq)";
   }
   attribute IsCmsWarningsExist Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_API.Is_Cms_Warnings_Exist(task_seq)";
   }
   attribute IsAssignToWP Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_API.Is_Wp_Assigned(fault_id)";
   }
   reference AvAircraftSubSystemRef(SubSystemId) to AvAircraftSubSystem(SubSystemId);
   reference AvDeferralRequestRef(FaultId) to AvDeferralRequest(FaultId);
   reference FaultRef(Barcode) to AvFault(Barcode);
}

@Override
query AircraftLov {
   where = "aircraft_id IN(select aircraft_Id FROM Av_aircraft_work_package WHERE objstate = 'InWork' AND av_maintenance_location_API.Get_Airport_Id(Location_Code) = Av_Airport_For_User_API.Get_Airport_Id(Fnd_Session_API.Get_Fnd_User()) AND is_heavy_maintenance = 1)";
}

@Override
entity AvHandoverNote {
   timestamptzref = "server";
   ludependencies = HandOverDetailsVirtual;
   crud = Create, Read, Update, Delete;

   attribute NoteId Number {
      required = [false];
   }
   attribute AircraftWorkPackageId Number;
   attribute CreatedBy Text;

   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute CurrentUser Text {
      fetch = "Fnd_Session_API.Get_Fnd_User()";
   }
   attribute CurrentDate Timestamp {
      fetch = "Time_Util_API.Get_Sysdate_In_Utc()";
   }
   attribute NoteEditableFromDate Timestamp {
      fetch = "Adcom_Util_API.Handover_Report_Period_Start";
   }
   attribute Priority Enumeration(HandoverNotePriority) {
      default = "'LOW'";
      required = [true];
   }
   reference AircraftWorkPackageRef(AircraftWorkPackageId) to HandOverDetailsVirtual(WorkPackageId);
   reference PersonInfoRef(CreatedBy) to PersonInfo(PersonId);
}

virtual HandOverDetailsVirtual {
   timestamptzref = "server";
   attribute AircraftId Number;
   attribute AircraftCode Text;
   attribute WorkPackage Text;
   attribute StartTime Timestamp;
   attribute EndTime Timestamp;
   attribute CurrentUserAirportTimeZone Text;
   attribute CurrentUserAirportId Number;
   attribute WorkPackageId Number;
   attribute WorkPackageStatus Text;
   attribute Source Text;
   attribute HandoverTaskCount Number;
   attribute BlockedTaskCount Number;
   attribute InMaintAircraftCount Number;
   attribute CompletedTaskCount Number;
   attribute HandoverTaskLabel Text;
   attribute BlockedTaskLabel Text;
   attribute NonRoutineCount Number;
   attribute InRangeTaskCount Number;
   attribute DeferredFaultCount Number;

   reference AvAircraftWorkPackageRef(WorkPackageId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AircraftRef(AircraftId) to AircraftLov(AircraftId);
   array HandoverNotesArray(WorkPackageId) to  AvHandoverNote(AircraftWorkPackageId);
   array HandoverTaskArray() to HandoverTaskVirtual();
   array BlockedTaskArray() to BlockedTaskVirtual();
   array InMaintenanceAircraftsArray() to InMaintenanceAircraftsVirtual();
   array CompletedTaskArray() to CompletedTaskVirtual();
   array NonRoutineArray() to NonRoutineVirtual();
   array TasksWithinRangeArray() to TasksWithinRangeVirtual();
   array DeferredFaultArray() to DeferredFaultsVirtual();

   action ExecuteReport Number {
      initialcheck none;
   }
}

virtual HandoverTaskVirtual using extended AvExeTask {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute AircraftTurnStatus Enumeration(TurnStatusEnum);

}

virtual BlockedTaskVirtual using extended AvExeTask {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute AircraftTurnStatus Enumeration(TurnStatusEnum);

}

virtual CompletedTaskVirtual using extended AvExeTask {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
}

virtual InMaintenanceAircraftsVirtual {
   timestamptzref = "server";
   ludependencies = HandOverDetailsVirtual;
   crud = Read;
   attribute FlightId Number;
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   reference AvFlightRef(FlightId) to AvFlight(FlightId);
}

virtual NonRoutineVirtual using extended AvFault {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

}
virtual TasksWithinRangeVirtual using extended AvExeTask {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute AircraftTurnStatus Enumeration(TurnStatusEnum) {
      fetch = "Av_Flight_API.Get_Turn_Status_for_Task(Task_Seq)";
   }
   attribute ShedDepartureDateTime Timestamp;
   reference AircraftLovRef(AircraftId) to AircraftLov(AircraftId);
   reference AvDeferralRequestRef(FaultId) to AvDeferralRequest(FaultId);

}

virtual DeferredFaultsVirtual using extended AvFault {
   ludependencies = HandOverDetailsVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute AircraftTurnStatus Enumeration(TurnStatusEnum);
}

structure GetShiftDetailsStructure {
   timestamptzref = "server";

   attribute StartTime Timestamp;
   attribute EndTime Timestamp;
   attribute AircraftId Number;
   attribute WorkPackageStatus Text;
   attribute CurrentUserAirportTimeZone Text;
   attribute CurrentUserAirportId Number;
   attribute HandoverTaskLabel Text;
   attribute BlockedTaskLabel Text;
}
structure ShiftStartEndStructure {
   timestamptzref = "server";
   attribute StartTime Timestamp;
   attribute EndTime Timestamp;
}


structure HandoverNoteStructure {
   timestamptzref = "server";

   attribute WorkPackageId Number;
   attribute CurrentUser Text;
   attribute CreatedBy Text;
   attribute CreatedDate Timestamp;
   attribute HandoverNote Text;
   attribute Priority Enumeration(HandoverNotePriority) {
      required = [true];
   }
   attribute CurrentUserAirportTimeZone Text;

   reference PersonInfoRef(CreatedBy) to PersonInfo(PersonId);
}


function GetHandoverShiftDetails Structure(GetShiftDetailsStructure) {
   timestamptzref = "server";
   ludependencies = AvHandoverNote;
   parameter WorkPackageId Number;
   parameter Source Text;
}

function GetInWorkHeavyWpList List < Entity(AvAircraftWorkPackage) > {
   parameter AircraftId Number;
   where = "aircraft_work_package_id IN (SELECT Aircraft_Work_Package_Id FROM Av_Aircraft_Work_Package WHERE aircraft_id = :AircraftId AND (objstate = 'InWork') AND is_heavy_maintenance = 1)";
}

function GetDefaultWorkPackageId Number {
   parameter AircraftId Number;
}

function GetCurrentTime Timestamp {
   timestamptzref = "server";
}
function GetShiftStartEnd Structure(ShiftStartEndStructure) {
   timestamptzref = "server";
   parameter WorkPackageId Number;
}
function GetCurrentUser Text {
}

action ClearLMLists {
   initialcheck none;
   ludependencies = InMaintenanceAircraftsVirtual, BlockedTaskVirtual, HandoverTaskVirtual, DeferredFaultsVirtual, TasksWithinRangeVirtual;
}
action ClearHMLists {
   initialcheck none;
   ludependencies = CompletedTaskVirtual, NonRoutineVirtual;
}
action UpdateWpToNull {
   initialcheck none;
   ludependencies = HandOverDetailsVirtual;
   parameter Objkey Text;
}
action UpdateAirToNull {
   initialcheck none;
   ludependencies = HandOverDetailsVirtual;
   parameter Objkey Text;
}
action AddNewHandoverNote {
   initialcheck none;
   ludependencies = AvHandoverNote;
   parameter WorkPackageId Number;
   parameter Note Text;
   parameter Priority Text;
   parameter CreatedBy Text;
   parameter CreatedDate Timestamp;
}
------------------------------- ENUMERATIONS --------------------------------
enumeration TurnStatusEnum {
   value = "Inbound" {
      identifier = "Inbound";
      label = "Inbound";
   }
   value = "Arrived" {
      identifier = "Arrived";
      label = "Arrived";
   }
   value = "Departed" {
      identifier = "Departed";
      label = "Departed";
   }
   value = "InMaintenance" {
      identifier = "InMaintenance";
      label = "In Maintenance";
   }
   value = "Released" {
      identifier = "Released";
      label = "Released";
   }
   value = "NotApplicable" {
      identifier = "NotApplicable";
      label = "Not Applicable";
   }
}
