fragment FlmHandoverDetails;
component FLMEXE;
layer Core;
description "This contains all the resources required for Handover Details and Reporting assistant";

--------------------------------- FRAGMENTS ---------------------------------
include fragment AircraftLovSelector;

----------------------------- CLIENT FRAGMENTS ------------------------------

@Overtake
selector WorkPackageSelector for AvAircraftWorkPackage {
   label = "";
   orderby = Barcode;
   static Barcode {
      label = "Work Package Barcode";
   }
   static WorkPackageName;
}

@Overtake
selector AvExeTaskSelector for AvExeTask {
   static Barcode;
}

assistant HandOverDetails using HandOverDetailsVirtualSet {
   label = "Handover Details and Reporting";
   savemode = OnLostFocus;
   input this;
   setup SetDefaultValues {
      variable DefSource Text;
      variable DefAircraftCode Text;
      variable DefWorkPackage Text;
      variable DefWorkPackageId Number;
      execute {
         set Source = "${DefSource}";
         set WorkPackage = DefWorkPackage;
         set AircraftRef = DefAircraftCode;
         set WorkPackageId = DefWorkPackageId;
      }
   }
   init command {
      variable FetchedData Structure(GetShiftDetailsStructure);

      execute {
         call GetHandoverShiftDetails(WorkPackageId, Source) into FetchedData;
         set StartTime = FetchedData.StartTime;
         set EndTime = FetchedData.EndTime;
         set AircraftId = FetchedData.AircraftId;
         set WorkPackageStatus = FetchedData.WorkPackageStatus;
         set CurrentUserAirportTimeZone = FetchedData.CurrentUserAirportTimeZone;
         set CurrentUserAirportId = FetchedData.CurrentUserAirportId;
         set HandoverTaskLabel = FetchedData.HandoverTaskLabel;
         set BlockedTaskLabel = FetchedData.BlockedTaskLabel;

         if [(Source = "HMSLOBBY" or Source = "HMCLOBBY") and(WorkPackageStatus != "In Work")] {
            messagebox("Work Package Not In Work", warning, "This page can only display work packages that are **In Work**. To continue, select an **In Work** work package.") {
               when OK {
                  set WorkPackageId = null;
                  set AircraftId = null;
               }
            }
         }
      }
   }
   singlestep {
      group ShiftDetails;
      list HandoverNotesList(HandoverNotesArray) {
         collapsed = [true];
         visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
         copyoncruddefault(WorkPackageId) to(AircraftWorkPackageId);
      }
      list InMaintenanceAircraftList(InMaintenanceAircraftsArray) {
         label = "In-Maintenance Aircraft: Scheduled for Departure or Work Performed Within Time Range (${parent.InMaintAircraftCount})";
         collapsed = [true];
         visible = [Source != "HMSLOBBY" and Source != "HMCLOBBY"];
         details = "page/FlmAircraftTurnsDetails/AircraftTurnDetails?$filter=FlightId eq $[FlightId]";
      }
      list TasksWithinRangeList(TasksWithinRangeArray) {
         label = "Tasks and Faults Raised and Worked on Within the Time Range (${parent.InRangeTaskCount})";
         collapsed = [true];
         visible = [Source != "HMSLOBBY" and Source != "HMCLOBBY"];
         details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      }
      list HandoverTaskList(HandoverTaskArray) {
         label = "${parent.HandoverTaskLabel} (${parent.HandoverTaskCount})";
         collapsed = [true];
         details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      }
      list BlockedTaskList(BlockedTaskArray) {
         label = "${parent.BlockedTaskLabel} (${parent.BlockedTaskCount})";
         collapsed = [true];
         details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      }
      list DeferredFaultsList(DeferredFaultArray) {
         label = "Deferred Faults Within the Time Range (${parent.DeferredFaultCount})";
         collapsed = [true];
         visible = [Source != "HMSLOBBY" and Source != "HMCLOBBY"];
         details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
      }
      list CompletedTaskList(CompletedTaskArray) {
         label = "Tasks Completed Within the Time Range (${parent.CompletedTaskCount})";
         visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
         collapsed = [true];
         details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      }
      list NonRoutinesList(NonRoutineArray) {
         label = "Non-Routines Raised Within the Time Range (${parent.NonRoutineCount})";
         visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
         collapsed = [true];
         details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
      }
   }
   command PrintReport;
   command CancelBack;
}

assistant AddHandoverNoteAssistant for HandoverNoteStructure {
   label = "Handover Notes";
   input(WorkPackageId);
   init command {
      execute {
         call GetCurrentTime() into CreatedDate;
         call GetCurrentUser() into CreatedBy;

         set Priority = "Low";
      }
   }
   singlestep {
      group EditHandoverNoteGroup;
   }
   command SaveHandoverNote;
   command Cancel;
}

dialog EditHandoverNoteDialog for HandoverNoteStructure {
   label = "Handover Notes";
   input this;
   output(Priority, HandoverNote);

   group EditHandoverNoteGroup;
   command Ok {
      label = "Save";
      enabled = [Priority != null and HandoverNote != null];
   }
   command Cancel;
}

group EditHandoverNoteGroup for HandoverNoteStructure {

   field PersonInfoRef.Name {
      label = "Created By";
      size = Medium;
      editable = [false];
      contactwidget {
         enabled = [true];
         source = Person;
         key = CreatedBy;
      }
   }
   field CreatedDate {
      label = "Created On";
      size = Medium;
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field Priority;

   field HandoverNote {
      label = "Note";
      size = FullWidth;
      required = [true];
      multiline = true;
   }
}


group ShiftDetails for HandOverDetailsVirtual {
   label = "Shift Details";
   lov AircraftRef with ReferenceAircraftLovSelector {
      label = "Aircraft";
      visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
      size = Large;
      hidekey = [true];
      searchable = true;
      search = AircraftRef.Aircraft;
      description = AircraftRef.Aircraft;
      required = [true];
      validate command {
         variable DefWpId Number;
         variable ShiftStartEndStruct Structure(ShiftStartEndStructure);

         execute {
            if[AircraftRef.AircraftId != null] {
               call GetDefaultWorkPackageId(AircraftRef.AircraftId)into DefWpId;
               set WorkPackageId = DefWpId;
               if [WorkPackageId != null] {
                  call GetShiftStartEnd(WorkPackageId) into ShiftStartEndStruct;
                  set StartTime = ShiftStartEndStruct.StartTime;
                  set EndTime = ShiftStartEndStruct.EndTime;
               }
            }
            else {
               set WorkPackageId = null;
               call UpdateAirToNull(Objkey);
            }
         }
      }
   }

   lov AvAircraftWorkPackageRef with WorkPackageSelector using GetInWorkHeavyWpList(AircraftRef.AircraftId) {
      label = "Work Package";
      visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
      required = [true];
      size = Large;
      hidekey = [true];
      description = AvAircraftWorkPackageRef.Barcode;
      search = AvAircraftWorkPackageRef.Barcode, AvAircraftWorkPackageRef.WorkPackageName;
      validate command {
         variable ShiftStartEndStruct Structure(ShiftStartEndStructure);
         execute {
            if [WorkPackageId = null] {
               call UpdateWpToNull(Objkey);
            }
            else {
               call GetShiftStartEnd(WorkPackageId) into ShiftStartEndStruct;
               set StartTime = ShiftStartEndStruct.StartTime;
               set EndTime = ShiftStartEndStruct.EndTime;
            }
         }
      }
   }
   field AvAircraftWorkPackageRef.WorkPackageName {
      label = "Work Package Name";
      visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
      size = Large;
      editable = [false];
   }
   field AvAircraftWorkPackageRef.LocationCode {
      label = "Work Package Location";
      visible = [Source = "HMSLOBBY" or Source = "HMCLOBBY"];
      size = Large;
      editable = [false];
   }
   field StartTime {
      label = "Start";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      size = Large;
      required = [true];
      validate command {
         execute {
            if [(Source = "HMSLOBBY" or Source = "HMCLOBBY") and(StartTime < AvAircraftWorkPackageRef.ActualStartDateTime)] {
               error("Start cannot be earlier than the work package start date.");
               set StartTime = null;
            }
            if [StartTime > EndTime] {
               error("Start must be earlier than End.");
               set StartTime = null;
            }
            if [Source != "HMSLOBBY" and Source != "HMCLOBBY" and StartTime = null] {
               set InMaintAircraftCount = 0;
               set HandoverTaskCount = 0;
               set BlockedTaskCount = 0;
               set DeferredFaultCount = 0;
               set InRangeTaskCount = 0;
               call ClearLMLists();
            }
            if [(Source = "HMSLOBBY" or Source = "HMCLOBBY") and StartTime = null] {
               set CompletedTaskCount = 0;
               set NonRoutineCount = 0;
               call ClearHMLists();
            }
         }
      }
   }
   field EndTime {
      label = "End";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      size = Large;
      required = [true];
      validate command {
         variable CurrentTime Timestamp;
         execute {
            call GetCurrentTime() into CurrentTime;
            if[EndTime > CurrentTime] {
               error("End time cannot be a future value.");
               set EndTime = null;
            }
            if [EndTime <= StartTime] {
               error("End must be later than Start.");
               set EndTime = null;
            }
            if [Source != "HMSLOBBY" and Source != "HMCLOBBY" and EndTime = null] {
               set InMaintAircraftCount = 0;
               set HandoverTaskCount = 0;
               set BlockedTaskCount = 0;
               set DeferredFaultCount = 0;
               set InRangeTaskCount = 0;
               call ClearLMLists();
            }
            if [(Source = "HMSLOBBY" or Source = "HMCLOBBY") and EndTime = null] {
               set CompletedTaskCount = 0;
               set NonRoutineCount = 0;
               call ClearHMLists();
            }
         }
      }
   }
}
list InMaintenanceAircraftList for InMaintenanceAircraftsVirtual {
   orderby = AvFlightRef.DeptSchedDepDateTime asc;
   field FlightId {
      columnexclude = [true];
   }
   field AvFlightRef.Aircraft;
   badge AvFlightRef.FlightTurnStatus {
      label = "Aircraft Turn Status";
      size = Large;
      style = TextOnly;
      editable = [false];
      emphasis Danger = [AvFlightRef.FlightTurnStatus = "InMaintenance"];
   }
   field AvFlightRef.ShedArrivalDateTime {
      label = "Scheduled Arrival Time";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AvFlightRef.ActualArrivalDateTime {
      label = "Actual Arrival Time";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AvFlightRef.ArrivalGate {
      label = "Arrival Gate";
   }
   field AvFlightRef.DeptSchedDepDateTime {
      label = "Scheduled Departure Time";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AvFlightRef.DeptFlightDepartureGate {
      label = "Departure Gate";
   }
   field AvFlightRef.DeptLegNo {
      label = "Outbound Flight";
   }
   field AvFlightRef.OutboundStation {
      label = "Outbound Destination";
   }
}

list HandoverNotesList for AvHandoverNote {
   label = "Handover Notes";
   orderby = CreatedDate desc;

   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [parent.WorkPackageId != null and CreatedBy = CurrentUser and CreatedDate >= NoteEditableFromDate and CreatedDate <= CurrentDate];
      }
      duplicate {
         enabled = [false];
      }
   }
   field PersonInfoRef.Name {
      label = "Created By";
      size = Medium;
      editable = [false];
      contactwidget {
         enabled = [true];
         source = Person;
         key = CreatedBy;
      }
   }
   field CreatedDate {
      label = "Created On";
      size = Medium;
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field Priority;

   field HandoverNote {
      label = "Note";
      size = Large;
      multiline = true;
   }
   command AddHandoverNote;
   command EditHandoverNote;
}

list HandoverTaskList for HandoverTaskVirtual {
   orderby = LatestJobStopDate desc;

   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }
   field Aircraft {
      columnexclude = [parent.Source = "HMSLOBBY" or parent.Source = "HMCLOBBY"];

   }
   badge AircraftTurnStatus {
      label = "Latest Aircraft Turn Status";
      size = Large;
      style = TextOnly;
      editable = [false];
      emphasis Danger = [AircraftTurnStatus = "InMaintenance"];
      columnexclude = [parent.Source = "HMSLOBBY" or parent.Source = "HMCLOBBY"];
   }
   lov TaskRef with AvExeTaskSelector {
      label = "Barcode";
      details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
   }
   field Description {
      label = "Name";
      editable = [false];
   }
   badge TaskStatus {
      label = "Status";
      emphasis StatePreliminary = [TaskStatus = "Active"];
      emphasis StateInProgress = [TaskStatus = "In Work"];
      emphasis StateCompleted = [TaskStatus = "Completed"];
      emphasis Alert = [TaskStatus = "Removed"];
      emphasis Neutral = [TaskStatus = "Cancelled"];
      editable = [false];
   }
   badge AvDeferralRequestRef.DeferralRequestStatus {
      label = "Deferral Request Status";
      style = TextOnly;
      emphasis Complementary7 = [AvDeferralRequestRef.DeferralRequestStatus = "Pending"];
      emphasis True = [AvDeferralRequestRef.DeferralRequestStatus = "Approved"];
      emphasis Alert = [AvDeferralRequestRef.DeferralRequestStatus = "Rejected"];
      columnexclude = [parent.Source = "HMSLOBBY" or parent.Source = "HMCLOBBY"];
   }
   badge OverallAssignmentsProgress {
      emphasis Neutral = [OverallAssignmentsProgress = "NotStarted"];
      emphasis Complementary2 = [OverallAssignmentsProgress = "InProgress"];
      emphasis Complementary8 = [OverallAssignmentsProgress = "Paused"];
      emphasis Complementary3 = [OverallAssignmentsProgress = "Finished"];
      editable = [false];
   }
   field LatestJobStopReason {
      editable = [false];
      size = Medium;
   }
   field LatestJobStopSkill {
      editable = [false];
      size = Medium;
   }
   field LatestJobStopNote {
      editable = [false];
      size = Medium;
      multiline = true;
   }
   field MaterialAvailUserStatus {
      editable = [false];
   }
   field ScheduledHours {
      editable = [false];
      columnexclude = [parent.Source != "HMSLOBBY" and parent.Source != "HMCLOBBY"];

   }
   field PlannedStart {
      displaytimezone = AircraftWpRef.MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field PlannedFinish {
      displaytimezone = AircraftWpRef.MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   lov CrewRef with  HangarCrewLovSelector {
      editable = [false];
      label = "Crew";
   }
   lov AircraftRef with ReferenceAircraftLovSelector {
      label = "Aircraft";
      editable = [false];
      columnexclude = [parent.Source != "HMSLOBBY" and parent.Source != "HMCLOBBY"];
   }
   field ActualStart {
      displaytimezone = AircraftWpRef.MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field ActualFinish {
      displaytimezone = AircraftWpRef.MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   lov WorkPackageRef with ReferenceHangarWorkPackageLovSelector {
      label = "Work Package";
      editable = [false];
      hidekey = [true];
   }
   field AircraftWpRef.WorkPackageName {
      label = "Work Package Name";
      editable = [false];
      multiline = true;
   }
   badge WpStatus {
      emphasis StateCreated = [WpStatus = "Active"];
      emphasis StatePlanned = [WpStatus = "Committed"];
      emphasis StateInProgress = [WpStatus = "In Work"];
      emphasis StateCompleted = [WpStatus = "Completed"];
      emphasis StateClosed = [WpStatus = "Canceled"];
      editable = [false];
   }
   field ConfigPosition {
      editable = [false];
   }
   field ClassCode {
      label = "Class";
      editable = [false];
   }
   field SubclassCode {
      label = "Subclass";
      editable = [false];
   }
   field Location {
      editable = [false];
   }
   field AircraftWpRef.LocationCode {
      label = "Work Package Location";
      editable = [false];
   }
   field IsRoutine {
      label = "Routine";
      editable = [false];
   }
   field CrewName {
      editable = [false];
   }
   field PriorityId {
      editable = [false];
   }
   field LongDescription {
      label = "Description";
      editable = [false];
      multiline = true;
   }
}

