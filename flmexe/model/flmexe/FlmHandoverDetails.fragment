   field ConfigPosition {
      editable = [false];
   }
   field ClassCode {
      label = "Class";
      editable = [false];
   }
   field SubclassCode {
      label = "Subclass";
      editable = [false];
   }
   field Location {
      editable = [false];
   }
   field AircraftWpRef.LocationCode {
      label = "Work Package Location";
      editable = [false];
   }
   field IsRoutine {
      label = "Routine";
      editable = [false];
   }
   field CrewName {
      editable = [false];
   }
   field PriorityId {
      editable = [false];
   }
   field LongDescription {
      label = "Description";
      editable = [false];
      multiline = true;
   }
}


