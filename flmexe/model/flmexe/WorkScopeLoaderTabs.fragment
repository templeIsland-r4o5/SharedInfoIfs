fragment WorkScopeLoaderTabs;
component FLMEXE;
layer Core;
description "Handle WSL page's tabs content for Line/Hanger WSL  ";

--------------------------------- FRAGMENTS ---------------------------------


----------------------------- CLIENT FRAGMENTS ------------------------------
list PanelList for PAvPanel {
   orderby = RowNo;
   label = "Panels";

   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   field RowNo;
   badge ExecutionStatus {
      emphasis Complementary1 = [ExecutionStatus = "Failed"];
      emphasis Complementary9 = [ExecutionStatus = "Successful"];
   }
   field TaskExternalId {
      label = "Task/Fault ID";
   }
   field PanelCode {
      label = "Panel Code";
   }
   field PanelName {
      label = "Panel Name";
      multiline = true;
   }
   field ZoneCode {
      label = "Panel Zone Code";
   }
   field ZoneName {
      label = "Panel Zone Name";
      multiline = true;
   }
   field MpcOpenTaskId {
      label = "MPC OPEN Task ID";
   }
   field MpcCloseTaskId {
      label = "MPC CLOSE Task ID";
   }
   field FileLine {
      multiline = true;
   }
}

list PanelErrorList for PAvPanelErrors {
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   field ErrorDesc {
      label = "Message";
      multiline = true;
      size = FullWidth;
   }
}

