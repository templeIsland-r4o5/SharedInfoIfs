--------------------------- PROJECTION FRAGMENTS ----------------------------
@Override
entity PAvPanelRequirement {
   attribute ExecutionStatus Enumeration(LineStatus) {
      fetch = "P_Av_Panel_Requirement_API.Get_Execution_Status(load_file_id, row_no)";
   }

   array PAvPanelReqErrorsArray(LoadFileId, RowNo) to PAvPanelReqErrors(LoadFileId, RowNo);

}

@Override
entity PAvPanel {
   attribute ExecutionStatus Enumeration(LineStatus) {
      fetch = "P_Av_Panel_API.Get_Execution_Status(load_file_id, row_no)";
   }

   array PAvPanelErrorsArray(LoadFileId, RowNo) to PAvPanelErrors(LoadFileId, RowNo);
}

@Override
entity PAvPanelSkill {
   attribute ExecutionStatus Enumeration(LineStatus) {
      fetch = "P_Av_Panel_Skill_API.Get_Execution_Status(load_file_id, row_no)";
   }
   array PAvPanelSkillErrorsArray(LoadFileId, RowNo) to PAvPanelSkillErrors(LoadFileId, RowNo);
}

@Override
entity PAvWpHistory {
   attribute ExecutionStatus Enumeration(LineStatus) {
      fetch = "P_Av_Wp_History_API.Get_Execution_Status(load_file_id, row_no)";
   }
   array PAvWpHistoryErrorsArray(LoadFileId, RowNo) to PAvWpHistoryErrors(LoadFileId, RowNo);
}