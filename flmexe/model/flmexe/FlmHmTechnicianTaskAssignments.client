client FlmHmTechnicianTaskAssignments;
component FLMEXE;
layer Core;
projection FlmHmTechnicianTaskAssignmentsHandling;
description "This client is used for Task Assignments page for Hangar Maintenance Technician";
include fragment FlmTaskAssignments;
include fragment AircraftLovSelector;
include fragment HangarWorkPackageLovSelector;
include fragment HangarCrewLovSelector;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------

-------------------------------- MAIN PAGES ---------------------------------
page HangarTaskAssignmentsOverview using HmTaskAssignmentsSet {
   label = "Task Assignments";
   startupmode = search;
   searchcontext PageSearchContext {
      defaults = GetDefaultSearchContext();
   }
   initcontext PageInitContext;
   list TaskAssignmentsList {
      filter = [ShiftType = searchcontext.PageSearchContext.Shift];
   }
}

searchcontext PageSearchContext for PageSearchContextStructure {
   label = "";
   field Shift;
}
--------------------------------- COMMANDS ----------------------------------

command TaskDetailsCommand for TaskAssignmentEntity {
   label = "Task Details";
   enabled = [TaskSeq != null];
   mode = SelectedRecords;
   bulkexecute {
      bulknavigate "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
   }
}

--------------------------------- SELECTORS ---------------------------------



---------------------------------- GROUPS -----------------------------------


----------------------------------- LISTS -----------------------------------
list TaskAssignmentsList for TaskAssignmentEntity {
   label = "Task Assignments";
   crudactions {
      edit {
         enabled = [false];
      }
   }

   field Barcode {
      editable = [false];
   }
   field TaskName {
      editable = [false];
      multiline = true;
   }
   badge Sensitivities {
      emphasis Warning = [true];
      editable = [false];
   }
   field ResourceDemand {
      editable = [false];
   }
   field Remark {
      label = "Assignment Role";
      editable = [false];
   }
   field AssignedResourceId {
      contactwidget {
         enabled = [true];
         source = Person;
      }
   }
   field LaborScheduledHours {
      label = "Scheduled Hours";
      editable = [false];
   }
   badge ExecutionInstanceStatus {
      emphasis Complementary5 = [ExecutionInstanceStatus = "Assigned"];
      emphasis Complementary9 = [ExecutionInstanceStatus = "Completed"];
      emphasis Complementary6 = [ExecutionInstanceStatus = "Work Started"];
      editable = [false];
   }
   badge TaskStatus {
      emphasis StatePreliminary = [TaskStatus = "Active"];
      emphasis StateInProgress = [TaskStatus = "In Work"];
      emphasis StateCompleted = [TaskStatus = "Completed"];
      emphasis Alert = [TaskStatus = "Removed"];
      emphasis Neutral = [TaskStatus = "Cancelled"];
      editable = [false];
   }
   badge OverallAssignmentsProgress {
      emphasis Neutral = [OverallAssignmentsProgress = "NotStarted"];
      emphasis Complementary2 = [OverallAssignmentsProgress = "InProgress"];
      emphasis Complementary8 = [OverallAssignmentsProgress = "Paused"];
      emphasis Complementary3 = [OverallAssignmentsProgress = "Finished"];
      editable = [false];
   }
   field MaterialAvailability {
      editable = [false];
   }
   field SchedStart {
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field SchedEnd {
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   lov CrewRef with  HangarCrewLovSelector {
      editable = [false];
      label = "Crew";
   }
   field LatestJobStopReason {
      editable = [false];
      size = Medium;
   }
   field LatestJobStopSkill {
      editable = [false];
      size = Medium;
   }
   field LatestJobStopNote {
      editable = [false];
      size = Medium;
      multiline = true;
   }
   field ConfigPosition {
      editable = [false];
   }
   lov AircraftDescRef with ReferenceAircraftLovSelector {
      label = "Aircraft";
      editable = [false];
   }
   lov WorkPackageRef with ReferenceHangarWorkPackageLovSelector {
      label = "Work Package";
      editable = [false];
   }
   field WpName {
      editable = [false];
      multiline = true;
   }
   badge WpStatus {
      emphasis StateCreated = [WpStatus = "Active"];
      emphasis StatePlanned = [WpStatus = "Committed"];
      emphasis StateInProgress = [WpStatus = "In Work"];
      emphasis StateCompleted = [WpStatus = "Completed"];
      emphasis StateClosed = [WpStatus = "Canceled"];
      editable = [false];
   }
   field ClassCode {
      label = "Class";
      editable = [false];
   }
   field SubclassCode {
      label = "Subclass";
      editable = [false];
   }
   field TaskLocation {
      editable = [false];
   }
   field WpLocation {
      editable = [false];
   }
   field AssignmentStart {
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AssignmentFinish {
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field Routine {
      editable = [false];
   }
   field CrewName {
      editable = [false];
   }
   field Priority {
      editable = [false];
   }
   field TaskDescription {
      editable = [false];
      multiline = true;
   }
   @DynamicComponentDependency ADCON
   badge NrObjstate {
      label = "NR Approval Status";
      columnexclude = [initcontext.WpHmContractId = null];
      emphasis Primary = [NrObjstate = "NotStarted"];
      emphasis Complementary6 = [NrObjstate = "AwaitingApproval"];
      emphasis Success = [NrObjstate = "Approved"];
      emphasis False = [NrObjstate = "Rejected"];
      editable = [false];
   }
   @DynamicComponentDependency ADCON
   field ProceedAtRisk {
      columnexclude = [initcontext.WpHmContractId = null];
      editable = [false];
   }
   @DynamicComponentDependency ADCON
   field NeedCommercialApproval {
      label = "Commercial Approval Needed";
      columnexclude = [initcontext.WpHmContractId = null];
      editable = [false];
   }
   attachments {
      enabled = [false];
   }

   command HmAssignToMe;
   command HmUnassignMe;
   command TaskDetailsCommand;
}

initcontext PageInitContext {

   parameter WpBarcode Text;
   parameter WpHmContractId  Text;
   init command {
      execute {
         call GetHmContractIdByBarcode(WpBarcode) into WpHmContractId;
      }
   }
}
