projection FlmTaskWorkAssignmentHandling;
component FLMEXE;
layer Core;
description "This inludes the definition of Task Work Assignments";
category Users;

--------------------------------- FRAGMENTS ---------------------------------
include fragment FlmTaskAssignments;
include fragment FlmTasks;
include fragment HangarWorkPackageLovSelector;
include fragment HangarCrewLovSelector;
include fragment FlmHandoverDetails;
----------------------------- MAIN ENTRY POINTS -----------------------------
@Override
entityset AvExeTaskSet for AvTaskQuery {
   where = "aircraft_wp_id IS NOT NULL";
}
entityset ResourceSet for ResourceGanttQuery;

------------------------------ ENTITY DETAILS -------------------------------
@Override
entity ResourceConnection {
   where = "site = Av_Airport_API.Get_Site(Av_Airport_For_User_API.Get_Airport_Id (Fnd_Session_API.Get_Fnd_User)) and Resource_API.Get_Resource_Type(resource_seq)='Person'";

   attribute PersonId Text {
      label = "Person ID";
      format = uppercase;
      lovcolumn = [true];
      fetch = "Resource_API.Get_Resource_Id(resource_seq)";
   }
   attribute PersonName Text {
      label = "Person Name";
      lovcolumn = [true];
      fetch = "Pers_API.Get_Internal_Display_Name(Resource_API.Get_Resource_Id(resource_seq))";
   }
   attribute Company Text;
}

------------------------------- ENUMERATIONS --------------------------------

---------------------------------- QUERIES ----------------------------------

---------------------------------- ACTIONS ----------------------------------
action DeleteSkill {
   initialcheck none;
   parameter TaskSeq Number;
   parameter TaskResourceSeq Number;
   ludependencies = JtTaskResourceQuery, TaskCompetencyQuery, ResourceGanttQuery, AvExeTask, JtTaskResource, JtExecutionInstance, JtTaskResourceDemandQuery;
}

--------------------------------- FUNCTIONS ---------------------------------
function GetTimeRange Structure(TimeRangeStructure) {
   timestamptzref = "server";

   parameter TaskSeq Number;
}
function GetSkillCount Number {
   parameter TaskSeq Number;
}
function IsMxLabourDemand Boolean {
   parameter TaskSeq Number;
   parameter TaskResourceSeq Number;
}
-------------------------------- STRUCTURES ---------------------------------
structure TimeRangeStructure {
   timestamptzref = "server";

   attribute StartDate Timestamp;
   attribute EndDate Timestamp;
   attribute Duration Number;
}
structure TaskAssignmentsStructure {
   attribute TaskSeq Number;
   attribute Barcode Text;
   attribute AircraftId Number;
   attribute Aircraft Text;
}

--------------------------------- VIRTUALS ----------------------------------


--------------------------------- SUMMARIES ---------------------------------


-------------------------------- SINGLETONS ---------------------------------
