@Override
entity AvExeTaskPanel {

   attribute PanelCd Text {
      fetch = "Av_Aircraft_Panel_API.Get_Panel_Code_From_Seq(ac_panel_seq)";
   }
   attribute ZoneCd Text {
      fetch = "Av_Aircraft_Panel_API.Get_Zone_Code_From_Panel_Seq(ac_panel_seq)";
   }
   attribute IsPanelOpened Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_Panel_Req_Util_API.Is_Panel_Opened(open_task_seq, open_task_step_seq)";
   }
   attribute PanelStatus Enumeration(PanelStatuses) {
      fetch = "Av_Exe_Task_Panel_API.Get_Panel_Status(open_task_seq, open_task_step_seq)";
   }
   reference AvZoneCodeRef(ZoneCd) to TaskZoneLov(ZoneCode);
   reference AvPanelCodeRef(PanelCd) to TaskPanelLov(PanelCode) {
      copy AcPanelSeq to AcPanelSeq;
   }
   reference AvAircraftPanelRef(AcPanelSeq) to AircraftPanelLov(AcPanelSeq);

   array MpcTasksArray(TaskSeq, AcPanelSeq) to MpcTasksForMaintTaskQuery(MaintTaskSeq, AcPanelSeq);
   array JtTaskOpenPanelSignOffArray(OpenTaskSeq, OpenTaskStepSeq) to JtTaskStepSignOff(TaskSeq, TaskStepSeq);
   array JtTaskClosePanelSignOffArray(CloseTaskSeq, CloseTaskStepSeq) to JtTaskStepSignOff(TaskSeq, TaskStepSeq);
}

@Override
@DynamicComponentDependency ADCON
entity HmNonRoutineApproval {
   crud = Read;
   attribute ApprovalStatus Enumeration(HmNonRoutineApprovalState) {
      fetch = "objstate";
      editable = [false];
   }
}

@Override
entity AvInstalledParts using AvExeTaskPart {
   from = "Av_Exe_Task_Part";
   where = "installed_quantity IS NOT NULL";
   keys = TaskPartId;
   ludependencies = AvExeTask, MaintMaterialReqLine, AvExeTaskPart, AvPartNumber;
   attribute TaskSeq Number;
   attribute TaskPartId Number;
   attribute AssmblyConfigSlotPosId Number {
      fetch = "Av_Exe_Task_Part_API.Get_Assy_Config_Position(task_part_id,part_group_id)";
   }
   attribute InstalledPartNoId Number;
   attribute CreatedBy Text;
   attribute ConfigSlotPositionId Number;
   attribute InstalledQuantity Number;
   attribute InstalledDate Timestamp;
   attribute InstalledSerialNo Text;
   attribute InstalledBatchNo Text;
   attribute MaintMaterialOrderNo Number;
   attribute LineItemNo Number;
   attribute CancelledBy Text;
   attribute SchedulingAction Enumeration(SchedulingActionType);
   attribute PartGroupCode Text {
      fetch = "Av_Part_Group_API.Get_Part_Group_Code(part_group_id)";
   }
   attribute PartGroupName Text {
      fetch = "Av_Part_Number_API.Get_Part_Name(installed_part_no_id)";
   }
   attribute InstallStates Text {
      fetch = "Av_Exe_Task_Part_API.Get_Install_States(task_part_id)";
   }
   attribute InstalledPartNo Text {
      fetch = "Av_Part_Number_API.Get_Part_Number(installed_part_no_id)";
   }
   attribute InstalledUser Text {
      fetch = "Av_Exe_Task_Part_API.Get_Installed_User(task_part_id)";
   }
   attribute IsPartWarningsExist Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_Part_API.Is_Part_Warnings_Exist(task_part_id)";
   }
   attribute InstalledConfigSlot Text {
      fetch = "DECODE(Av_Config_Slot_API.Is_Mandatory_Config_Slot(part_group_id), 'Mandatory', 'Yes','No')";
   }
   attribute AssemblyTypeCode Text {
      fetch = "Av_Part_Group_API.Get_Asse_Type_Code_By_Part_Grp(part_group_id)";
   }
   attribute Quantity Text {
      fetch = "CONCAT(CONCAT(TO_CHAR(Installed_Quantity), ' '),INVENTORY_PART_API.Get_Unit_Meas(Work_Task_API.Get_Site(Task_Seq),Av_Part_Number_API.Get_Part_Number(installed_part_no_id)))";
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Part_Sens_API.Get_Task_Part_Sensitivities(task_seq,task_part_id)";
   }
   attribute OriginalInstalledSerialNo Text {
      fetch = "Av_Exe_Task_Part_API.Get_Installed_Serial_No(task_part_id)";
   }
   attribute OriginalInstalledBatchNo Text {
      fetch = "Av_Exe_Task_Part_API.Get_Installed_Batch_No(task_part_id)";
   }
   attribute TaskControlAuthorityEnabled Text {
      fetch = "Adcom_Util_API.Get_User_Task_Ctrl_Auth_Perm(Fnd_Session_API.Get_Fnd_User())";
   }

   reference PartNumberRef(InstalledPartNo) to SourceInterchangePart(PartNo);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   reference ConfigSlotPositionRef(ConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AssmblSlotPositionRef(AssmblyConfigSlotPosId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AvPartNumberRef(InstalledPartNoId) to AvPartNumber(PartNumberId);
   reference InstalledSerialRef(InstalledSerialNo) to PartSerialCatalog(SerialNo);
   reference InstalledBatchRef(InstalledBatchNo) to LotBatchMaster(LotBatchNo);
   reference MaintMaterialReqRef(MaintMaterialOrderNo, LineItemNo) to MaintMaterialReqLine(MaintMaterialOrderNo, LineItemNo);
   array TaskPartInstallationWarningArray(TaskPartId) to AvExeTaskPartWarning(TaskPartId);
}

@Override
entity AvRemovedParts using AvExeTaskPart {
   from = "Av_Exe_Task_Part";
   where = "Removed_quantity IS NOT NULL";
   keys = TaskPartId;
   ludependencies = AvExeTask;

   attribute TaskSeq Number;
   attribute TaskPartId Number;
   attribute AssmblyConfigSlotPosId Number {
      fetch = "Av_Exe_Task_Part_API.Get_Assy_Config_Position(task_part_id,part_group_id)";
   }
   attribute CreatedBy Text;
   attribute TaskReturnLineSeq Number;
   attribute ConfigSlotPositionId Number;
   attribute RemovedSerialNo Text;
   attribute RemovedBatchNo Text;
   attribute RemovedQuantity Number;
   attribute RemovedDate Timestamp;
   attribute RemovalReasonCode Text;
   attribute RemovedPartNoId Number;
   attribute CancelledBy Text;
   attribute PartGroupCode Text {
      fetch = "Av_Part_Group_API.Get_Part_Group_Code(part_group_id)";
   }
   attribute PartGroupName Text {
      fetch = "Av_Part_Group_API.Get_Part_Group_Name(part_group_id)";
   }
   attribute RemovalReason Text {
      fetch = "Av_Removal_Reason_API.Get_Removal_Reason_Desc(removal_reason_code)";
   }
   attribute RemovalStates Text {
      fetch = "Av_Exe_Task_Part_API.Get_Removal_States(Task_Part_Id)";
   }
   attribute RemovedPartNo Text {
      fetch = "Av_Part_Number_API.Get_Part_Number(removed_part_no_id)";
   }
   attribute RemovedUser Text {
      fetch = "Av_Exe_Task_Part_API.Get_Removed_User(task_part_id)";
   }
   attribute IsPartWarningsExist Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_Part_API.Is_Part_Warnings_Exist(task_part_id)";
   }
   attribute RemovedConfigSlot Text {
      fetch = "DECODE(Av_Config_Slot_API.Is_Mandatory_Config_Slot(part_group_id), 'Mandatory', 'Yes', 'No')";
   }
   attribute AssemblyTypeCode Text {
      fetch = "Av_Part_Group_API.Get_Asse_Type_Code_By_Part_Grp(part_group_id)";
   }
   attribute Quantity Text {
      fetch = "CONCAT(CONCAT(TO_CHAR(Removed_Quantity), ' '),INVENTORY_PART_API.Get_Unit_Meas(Work_Task_API.Get_Site(Task_Seq),Av_Part_Number_API.Get_Part_Number(removed_part_no_id)))";
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Part_Sens_API.Get_Task_Part_Sensitivities(task_seq,task_part_id)";
   }
   attribute TaskControlAuthorityEnabled Text {
      fetch = "Adcom_Util_API.Get_User_Task_Ctrl_Auth_Perm(Fnd_Session_API.Get_Fnd_User())";
   }

   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   reference ConfigSlotPositionRef(ConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AssmblSlotPositionRef(AssmblyConfigSlotPosId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference JtTaskReturnRef(TaskReturnLineSeq) to JtTaskReturn(TaskReturnLineSeq);
   reference AvPartNumberRef(RemovedPartNoId) to AvPartNumber(PartNumberId);
   reference PartSerialCatalogRef(RemovedPartNo, RemovedSerialNo) to PartSerialCatalog(PartNo, SerialNo);
   array TaskPartRemovalWarningArray(TaskPartId) to AvExeTaskPartWarning(TaskPartId);
   reference RemovalReasonRef(RemovalReasonCode) to AvRemovalReason(RemovalReasonCode);
}
