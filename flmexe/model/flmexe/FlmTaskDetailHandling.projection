-------------------------------- SINGLETONS ---------------------------------
action FaultProjectionService Structure(RaiseFaultResponse) {
   initialcheck none;
   implementation = "Java";
   timestamptzref = "server";

   parameter   AircraftId Number;
   parameter   SubSystemId Number;
   parameter   FaultCode Text;
   parameter   FaultSourceCode Text;
   parameter   LogbookTypeCode Text;
   parameter   FoundOnType Text;
   parameter   FoundOnId Number;
   parameter   Description Text;
   parameter   PhaseOfFlightCode Text;
   parameter   FailureTypeCode Text;
   parameter   LogbookReference Text;
   parameter   FaultSeverityCode Text;
   parameter   FoundSource Text;
   parameter   CurrentUser Text;
   parameter   FoundOnDate Timestamp;
   parameter   FlightSafetyImpact Boolean;
   parameter   EtopsSignificant Boolean;
   parameter   FlightId Number;
   parameter   TaskSeq Number;
   parameter   ConfigSlotAltId Text;
   parameter   AircraftAltId Text;
   parameter   FoundOnTaskId Text;
   parameter   AircraftWorkPackageId Number;
   parameter   IsRoutine Boolean;
   parameter   ResourceSeq Number;
   parameter   ScheduledHours Text;
   parameter   ResourceId Text;
   parameter   PriorityId Text;
   parameter   Objkey Text;
   parameter   DefaultResourceSeq Text;
   parameter   CertificationRequired Boolean;
   parameter   InspectionRequired Boolean;
   parameter   RaiseFaultOption Text;
   parameter   IsMobileClientRequest Boolean;
   parameter   LongDescription Text;
   parameter   RaiseFaultActionOption Text;
   parameter   StartTime Timestamp;
   parameter   EndTime Timestamp;
   parameter   Duration Number;
   parameter   LocationCode Text;
   parameter   AcZoneSeq Number;
   parameter   AcPanelSeq Number;

   ludependencies = AvFault, AvExeTask, AvAircraftWorkPackage, AvFlight;
}

action EvaluateNonRoutineService {
   initialcheck none;
   implementation = "Java";
   parameter FaultId Number;
   parameter AltId Text;
   ludependencies = AvFault, AvExeTask;
}
