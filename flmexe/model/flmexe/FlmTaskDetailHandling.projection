---------------------------------- ACTIONS ----------------------------------
action AddMeasurement {
   initialcheck none;
   timestamptzref = "site(TaskSite)";

   parameter TaskSeq               Number;
   parameter MeasurementDomainType Text;
   parameter MeasurementTypeCode   Text;
   parameter MeasTypeValueCode     Text;
   parameter MeasurementQty        Number;
   parameter MeasurementDateTime   Timestamp;
   parameter MeasurementText       Text;
   parameter MeasurementBoolean    Boolean;
   parameter TaskSite              Text;
   ludependencies = AvExeTaskMeasurement, AvExeTask;
}

action AddTaskTool {
   initialcheck none;
   parameter TaskSeq       Number;
   parameter ToolSpecificationCode  Text;
   parameter PartNoId Number;
   parameter SchedDuration Text;
   ludependencies = AvExeTaskTool, AvFaultTool, AvExeTask;
}
action AddActualDateTime Timestamp {
   initialcheck none;
   ludependencies = AvExeTask;
   timestamptzref = "server";

}

action ClearFaultDefMainVirtual {
   initialcheck none;
   ludependencies = AvExeTask, AvFault;
}

action Refresh {
   initialcheck none;
   ludependencies = AvExeTask;
}

action DeleteMeasurement {
   initialcheck none;
   parameter MeasurementId Number;
   ludependencies = AvExeTask, AvExeTaskMeasurement;
}


action DeleteTaskTool {
   initialcheck none;
   parameter TaskToolId       Number;
   ludependencies = AvExeTaskTool, AvFaultTool, AvExeTask;
}

action RemovePart {
   initialcheck none;
   parameter    TaskPartId    Number;
   ludependencies = AvFault, AvExeTaskPart, AvFaultPart, AvInstalledParts, AvRemovedParts, AvExeTask;
}

action RequestDeferral {
   initialcheck none;
   parameter FaultId Number;
   ludependencies = AvFault, AvExeTask;
}

action UpdateTaskStart {
   initialcheck none;
   ludependencies = AvExeTask, AvAircraftWorkPackage;
   timestamptzref = "site(Site)";

   parameter TaskSeq Number;
   parameter Site Text;
}

action UpdateTaskUnstart {
   initialcheck none;
   parameter TaskSeq Number;
   ludependencies = AvExeTask, AvAircraftWorkPackage, AvFlight;
}


action ResubmitDeferral {
   initialcheck none;
   parameter FaultId Number;
   parameter ReauthorizationReason Text;
   ludependencies = AvExeTask, AvFault, AvDeferralRequest;
}

action DeleteZone {
   initialcheck none;
   parameter ZoneId Number;
   parameter TaskSeq Number;
   parameter AcZoneSeq Number;
   ludependencies = AvExeTaskZone, AvExeTaskPanel;
}

action CompleteCriticalItem {
   initialcheck none;
   parameter CriticalItemId Number;
   ludependencies = AvExeTask, AvCriticalItem;
}

action UpdateRemovedSerialNumber {
   initialcheck none;
   parameter RemovedSerialNo Text;
   parameter TaskPartId Text;
}

--------------------------------- FUNCTIONS ---------------------------------
function GetSelectReferenceUrl Text {
   parameter ExternalPagePath Text;
   parameter ATaskId Text;
   parameter AType Text;
   parameter ASource Text;
}
function CheckDeferNr Boolean {
   parameter FaultId Number;
}
function GetFindInventoryUrl Text {
   parameter ExternalPagePath Text;
   parameter SearchType Text;
   parameter AircraftRegCode Text;
   parameter IataCode Text;
   parameter TaskNameRef Text;
}

function GetPartNumber List<Entity(AvPartNumber)> {
   parameter PartNumberId  Number;
   where = "part_number_id IN (SELECT part_number_id FROM av_tool_specification_part WHERE tool_Specification_code IN(SELECT tool_specification_code FROM av_Tool_Specification))";
}
function GetDefaultToolSpec Text {
   parameter PartNumberId  Number;
}
function GetToolSpec List<Entity(AvToolSpecification)> {
   parameter PartNoId Number;
   where = "tool_specification_code IN (SELECT tool_specification_code FROM av_tool_specification_part WHERE part_Number_id = :PartNoId)";
}
function GetMeasurementValue List<Entity(AvMeasurementValue)> {
   parameter MeasurementTypeCode Text;
   where = "measurement_type_code = :MeasurementTypeCode";
}
function GetMeasurementTypeCode List<Entity(AvMeasurementType)> {
   parameter TaskSeq Number;
   where = "measurement_type_code NOT IN (SELECT measurement_type_code FROM av_exe_task_measurement WHERE task_seq = :TaskSeq)";
   ludependencies = AvExeTaskMeasurement, AvExeTask;

}
function ShowWarning Text {
   parameter TaskSeq Number;
   parameter AircraftWpId Number;
}
function GetInterchangeablePart List<Entity(SourceInterchangePart)> {
   parameter TaskSeq Number;
   parameter MaintMaterialOrderNo Number;
   parameter LineItemNo Number;

   where = "part_no in (SELECT s.part_no FROM Source_Interchange_Part_tab s WHERE s.source_ref1 = :TaskSeq AND s.source_ref2 = :MaintMaterialOrderNo AND s.source_ref3= :LineItemNo)";

   ludependencies = AvExeTask, AvExeTaskPart, MaintMaterialReqLine, SourceInterchangePart, AvPartNumber;
}

-------------------------------- STRUCTURES ---------------------------------
structure RaiseNonRoutineFromTaskDetailsInfoStructure {
   attribute AircraftId Number;
   attribute AircraftWpId Number;
   attribute FoundOnId Number;
   attribute Source Text;
   attribute Title Text;
}

structure InstallPartsInfoStructure {

   attribute TaskSeq Number;
   attribute TaskPartId Number;
   attribute InstalledPartNoId Number;
   attribute InstalledPartNo Text;
   attribute InstalledQuantity Number;
   attribute InstalledSerialNo Text;
   attribute InstalledBatchNo Text;
   attribute PartName Text;
   attribute MaintMaterialOrderNo Number;
   attribute LineItemNo Number;

}
--------------------------------- VIRTUALS ----------------------------------
virtual AddMeasurementVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute TaskSeq Number;
   attribute MeasurementId Number;
   attribute MeasurementTypeCode Text;
   attribute MeasTypeValueCode Text;
   attribute MeasurementOrder Number;
   attribute MeasurementValue Text;
   attribute MeasurementType Text;
   attribute MeasurementQty Number;
   attribute MeasurementDateTime Timestamp;
   attribute MeasurementText Text;
   attribute MeasurementBoolean Boolean;

   reference MeasurementTypeCodeRef(MeasurementTypeCode) to AvMeasurementType(MeasurementTypeCode);
   reference MeasurementValueRef(MeasurementTypeCode, MeasTypeValueCode) to AvMeasurementValue(MeasurementTypeCode, MeasTypeValueCode);
}
virtual AddTaskToolVirtual {
   attribute TaskSeq Number;
   attribute ToolSpecificationCode Text {
      required = [true];
   }
   attribute PartNoId Number {
      required = [true];
   }
   attribute SerialNo Text;
   attribute AssignedUser Text;
   attribute SchedDuration Text;
   attribute AssignedDateTiime Date;
   attribute ActualDuration Number;
   attribute Type Text;

   reference AvToolSpecificationRef(ToolSpecificationCode) to AvToolSpecification(ToolSpecificationCode);
   reference AvPartNumberRef(PartNoId) to AvPartNumber(PartNumberId);
}


virtual ResubmitDeferralRequestVirtual {
   ludependencies = AvFault, AvDeferralRequest;
   attribute FaultId                    Number;
   attribute ReauthorizationReason      Text;
   reference AvFaultRef(FaultId)           to AvFault(FaultId);
   reference AvDeferralRequestRef(FaultId) to AvDeferralRequest(FaultId);
}

