}

@Override
entity AvExeTaskTool {
   crud = Create, Read, Update, Delete;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute TaskToolId Number {
      required = [false];
   }
   attribute ToolStatus Text {
      fetch = "Av_Exe_Task_Tool_api.Get_Tool_Status(task_tool_id)";
   }
   attribute PartGroupCode Text {
      fetch = "Av_Part_Group_api.get_Part_Group_Code(Av_Part_Group_Part_API.Get_Part_Group_Id(Part_No_Id))";
   }
   attribute PartGroupName Text {
      fetch = "Av_Part_Group_api.get_Part_Group_Name(Av_Part_Group_Part_API.Get_Part_Group_Id(Part_No_Id))";
   }
   attribute ConvertAccTime Text {
      fetch = "Adcom_Util_API.Get_Text_Time(actual_duration)";
   }
   attribute ConvertSchedTime Text {
      fetch = "Adcom_Util_API.Get_Text_Time(sched_duration)";
   }
   attribute AssignedUser Text {
      fetch = "Av_Exe_Task_Tool_API.Get_Assigned_User(task_tool_id)";
   }

   reference PartNumberRef(PartNoId) to AvPartNumber(PartNumberId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   reference AvToolSpecificationRef(ToolSpecificationCode) to AvToolSpecification(ToolSpecificationCode);
}

@Override
entity AvResourceToolEquipment {
   where = "source_ref_type_db = 'TASK'";
   timestamptzref = "site(Work_Task_API.Get_Site(Source_Ref))";


   @DynamicComponentDependency TOOLEQ
