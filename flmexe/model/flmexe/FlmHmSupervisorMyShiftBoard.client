client FlmHmSupervisorMyShiftBoard;
component FLMEXE;
layer Core;
projection FlmHmSupervisorMyShiftBoardHandling;
description "This client is used for My Shift Board for Hangar Maintenance Supervisor";
include fragment AircraftLovSelector;
include fragment HangarWorkPackageLovSelector;
include fragment HangarCrewLovSelector;
include fragment FlmTasks;
include fragment FlmTaskAssignments;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------

-------------------------------- MAIN PAGES ---------------------------------
page HangarMaintenanceSupervisorShiftBoard using AvExeTaskSet {
   label = "My Shift Board";
   kanbanboard MyShiftTasksKanbanBoard;

   list TasksList {
      label = "My Shift Tasks List";
      details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
   }


}
-------------------------------- MAIN PAGES ---------------------------------


--------------------------------- COMMANDS ----------------------------------
command TaskDetailsCommand for AvExeTask {
   label = "Details";
   execute {
      navigate "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
      refresh;
   }
}
--------------------------------- SELECTORS ---------------------------------


---------------------------------- GROUPS -----------------------------------


----------------------------------- LISTS -----------------------------------


---------------------------------- DIALOGS ----------------------------------


-------------------------------- SINGLETONS ---------------------------------


---------------------------------- CHARTS -----------------------------------


--------------------------------- CALENDERS ---------------------------------


---------------------------------- SHEETS -----------------------------------


----------------------------- STATE INDICATORS ------------------------------


----------------------------------- TREES -----------------------------------


---------------------------------- PLUGINS ----------------------------------


------------------------------- IMAGE VIEWERS -------------------------------


----------------------------- VISUAL COMPONENTS -----------------------------
kanbanboard MyShiftTasksKanbanBoard for AvExeTask {
   label = "My Shift Tasks";
   kanbancolumn TaskStatus;
   kanbancolumnname = GetShiftBoardTaskStatus();
   kanbancard MyAssignmentsKanbanCard;
   move command {
      execute {
         call RefreshData();
         messagebox("", information, "To change the status of the task, you will be redirected to the Task Details page. Do you want to continue?") {
            when YES {
               navigate "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
               refresh;
            }
            when NO {
               exit;
            }
         }
      }
   }
}

kanbancard MyAssignmentsKanbanCard for AvExeTask {
   emphasis Complementary2 = [TaskStatus = "Active"];
   emphasis Complementary7 = [TaskStatus = "In Work"];
   emphasis Complementary9 = [TaskStatus = "Completed"];
   field Description;
   field Barcode;
   badge TaskStatus {
      emphasis StatePreliminary = [TaskStatus = "Active"];
      emphasis StateInProgress = [TaskStatus = "In Work"];
      emphasis StateCompleted = [TaskStatus = "Completed"];
      emphasis Alert = [TaskStatus = "Removed"];
      emphasis Neutral = [TaskStatus = "Cancelled"];
      size = Small;
   }
   field Aircraft;
   badge Sensitivities {
      emphasis Warning = [true];
      visible = [Sensitivities != null];
   }
   command TaskDetailsCommand;
}