client FlmAircraftTurnsNavigatorEntry;
component FLMEXE;
layer Core;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------
entry MyAircraftTurnsCardEntry parent FlmexeNavigator.FlmNav at index 100 {
   label = "My Aircraft Turns";
   internal "page/FlmMyAircraftTurns/MyAircraftTurnsCardPage";
}

entry FlmRaiseFaultNav parent FlmexeNavigator.FlmNav at index 300 {
   label = "Raise Fault";
   internal "assistant/FlmAircraftTurnsDetails/RaiseFaultAssistant?$action=SetDefaultValues{DefSource:'LOBBY'}";
}

