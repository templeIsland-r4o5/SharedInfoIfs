function GetSkillDemand List < Entity(JtTaskResourceDemandQuery) >  {
   parameter TaskSeq Number;
   parameter Remark Text;
   parameter CurrentUser Text;
   where = "task_seq = :TaskSeq AND UPPER(remark) = UPPER(:Remark) AND assigned_resource_id = :CurrentUser AND rowstate IN ('ASSIGNED','WORKSTARTED')";
}
