--------------------------------- COMMANDS ----------------------------------
command RecordRemovePartCommand for RemovedPartLineVirtual {
   enabled = [RemovedUser = null and CancelledBy = null];
   mode = SingleRecord;
   variable NewRemovedSerialNo Text;
   variable NewRemovedQuantity Number;
   variable NewRemovalReasonCode Text;
   variable RemovalReasonCode Text;
   variable NewRemovedUser Text;
   variable NewRemovedBatchNo Text;
   variable NewRemovedPartNoId Number;
   variable RecordRemovedPartInfo Structure(RecordRemovedPartInfoStructure);


   execute {

      copy this into RecordRemovedPartInfo;
      call GetAircraftRegCode(AircraftId) into AircraftRegCode;
      set RecordRemovedPartInfo.AircraftRegCode = AircraftRegCode;
      set RemovalReasonCode = RemovalReasonRef.RemovalReasonCode;
      assistant RecordRemovedPartAssistant(RecordRemovedPartInfo) into(NewRemovedSerialNo, NewRemovedBatchNo, NewRemovedQuantity, NewRemovalReasonCode, NewRemovedUser, NewRemovedPartNoId) {
         when OK {
            call UpdateRmvPart(Objkey, NewRemovedSerialNo, NewRemovedBatchNo, NewRemovedQuantity, NewRemovalReasonCode, NewRemovedPartNoId);
            exit;
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command EditRemovePartCommand for RemovedPartLineVirtual {
   label = "";
   icon = "edit";
   mode = SingleRecord;
   visible = [SignedFlag = true or(RemovedUser != null and parent.IsEditTaskCardAccess = true)];

   variable NewRemovedSerialNo Text;
   variable NewRemovedQuantity Number;
   variable NewRemovalReasonCode Text;
   variable NewRemovedPartNoId Number;
   variable NewRemovalBatchNo Text;
   variable NewRemovalEditReason Text;
   variable NewConfigSlotPosId Text;
   variable RecordRemovedPartInfo Structure(RecordRemovedPartInfoStructure);

   execute {
      copy this into RecordRemovedPartInfo;
      call GetAircraftRegCode(AircraftId) into AircraftRegCode;
      set RecordRemovedPartInfo.AircraftRegCode = AircraftRegCode;
      set RecordRemovedPartInfo.ConfigSlotPositionId = ConfigSlotPositionId;
      set RecordRemovedPartInfo.AssemblyConfigSlotPositionId = AssemblyConfigSlotPositionId;
      assistant EditRemovedPartAssistant(RecordRemovedPartInfo) into(NewRemovedSerialNo, NewRemovedQuantity, NewRemovalReasonCode, NewRemovedPartNoId, NewRemovalBatchNo, NewRemovalEditReason, NewConfigSlotPosId) {
         when OK {
            call EditRemovedPart(Objkey, NewRemovedPartNoId, NewRemovedSerialNo, NewRemovalReasonCode, NewRemovedQuantity, NewRemovalBatchNo, NewRemovalEditReason, NewConfigSlotPosId) {
               when SUCCESS {
                  success("Removed part updated successfully");
                  exit OK;
               }
            }
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command RevokeRemovePartCommand for RemovedPartLineVirtual {
   icon = "user-absent";
   label = "Revoke Sign-Off";
   enabled = [(SignedFlag = true or(parent.IsEditTaskCardAccess = true and DbRemovedUser != null and RemovedUser != null)) and parent.TaskCertificationEnable = false];
   mode = SingleRecord;

   execute {
      if [SignedFlag = true and parent.IsEditTaskCardAccess = false] {
         confirm("Do you want to revoke the sign-off?") {
            when OK {
               call RevokeRemovedPart(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     success("Sign-off successfully revoked. Part removal is now pending sign-off.");
                     exit OK;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         assistant RevokeRemovePartSignOffAssistant(PartNumberRmvdRef, RemovalSerialNo, PartGroup, AssyPos, RemovedQuantity, RemovalReasonCode, RemovedDate, RemovedUser) into(RevokeSignOffReason) {
            when OK {
               call RevokeRemovedPart(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     success("Sign-off successfully revoked. Part removal is now pending sign-off.");
                     exit OK;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}

command RecordActionTakenCommand for RecordWorkVirtual {
   label = "Record Action";
   mode = Global;
   enabled = [Objstate != "Complete" and not IsActionRecorded and TaskCardOption != "RaiseAndClose"];
   variable ActionDesc Text;
   variable RecordActionTime Timestamp;
   variable ActualHours Text;
   variable StartTime Timestamp;
   variable IsCertifyWorkPerformed Boolean;
   variable SignOffCount Number;
   variable IsSignOffSigned Text;
   variable RecordActionTakenInfo Structure(RecordActionTakenInfoStructure);
   execute {
      if [IsHeavyMaintenance = true and IsNonRoutine = true and HmContractLineNo != null and NeedCommercialApproval = true and ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this. ") {
               when "OK" {
                  exit;
               }
            }
         }
      }
      copy this into RecordActionTakenInfo;
      call GetTimestamp(Site) into RecordActionTime;

      if [Source = "Finish" and AssignmentStatus = "ASSIGNED"] {
         set StartTime = RecordActionTime;
         set ActualHours = ScheduledHours;
      }
      else {
         if [Source = "Finish" and AssignmentStatus = "WORKSTARTED"] {
            set StartTime = AssignmentStart;
         }
         else {
            set StartTime = RecordWorkStartTime;
         }
         call CalculateAssignmntTotActualHrs(TaskSeq, ExecutionInstanceSeq, RecordActionTime, Site) into ActualHours;
      }
      call SignOffCountForSession(Objkey) into SignOffCount;

      set RecordActionTakenInfo.EndTime = RecordActionTime;
      set RecordActionTakenInfo.StartTime = StartTime;
      set RecordActionTakenInfo.ActualHours = ActualHours;
      set RecordActionTakenInfo.MainVtrObjkey = Objkey;
      set RecordActionTakenInfo.Source = Source;

      if [SignOffCount > 0 and CertifyWorkPerformed] {
         set IsSignOffSigned = "TRUE";
         set IsCertifyWorkPerformed = CertifyWorkPerformed;
      }
      else {
         set IsSignOffSigned = "FALSE";
         set IsCertifyWorkPerformed = false;
      }
      set RecordActionTakenInfo.IsSignOffSigned = IsSignOffSigned;
      set RecordActionTakenInfo.CertifyWorkPerformed = IsCertifyWorkPerformed;
      set RecordActionTakenInfo.IsEditTaskCardAccess = IsEditTaskCardAccess;
      assistant RecordActionTaken(RecordActionTakenInfo) into(ActionDesc, IsCertifyWorkPerformed) {
         when OK {
            if[ActionDesc = null] {
               exit;
            }
            call AddAction(Objkey, ActionDesc, TaskSeq, IsCertifyWorkPerformed);
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}
command JobStopCommand for RecordWorkVirtual {
   label = "Job Stop";
   mode = Global;
   enabled = [Objstate != "Complete" and not IsActionRecorded and not IsJobStopExecuted and Source = "RecordWork" and IsEditTaskCardAccess = false];
   variable ActionDesc Text;
   variable RecordActionTime Timestamp;
   variable ActualHours Text;
   variable StartTime Timestamp;
   variable RemainingHours Text;
   variable IsSignOffSigned Text;
   variable IsCertifyWorkPerformed Boolean;
   variable RecordActionTakenInfo Structure(RecordActionTakenInfoStructure);
   execute {
      copy this into RecordActionTakenInfo;
      call GetTimestamp(Site) into RecordActionTime;
      if [AssignmentStatus = "ASSIGNED"] {
         set StartTime = RecordWorkStartTime;
         set ActualHours = ScheduledHours;
      }
      else {
         set StartTime = AssignmentStart;
         call CalculateAssignmntTotActualHrs(TaskSeq, ExecutionInstanceSeq, RecordActionTime, Site) into ActualHours;
      }
      call SignOffCountForSession(Objkey) into SignOffCount;

      if [SignOffCount > 0 and CertifyWorkPerformed] {
         set IsSignOffSigned = "TRUE";
         set IsCertifyWorkPerformed = CertifyWorkPerformed;
      }
      else {
         set IsSignOffSigned = "FALSE";
         set IsCertifyWorkPerformed = false;
      }

      call CalculateRemainingHours(ActualHours, ScheduledHours) into RemainingHours;

      set RecordActionTakenInfo.IsSignOffSigned = IsSignOffSigned;
      set RecordActionTakenInfo.CertifyWorkPerformed = IsCertifyWorkPerformed;
      set RecordActionTakenInfo.EndTime = RecordActionTime;
      set RecordActionTakenInfo.StartTime = StartTime;
      set RecordActionTakenInfo.ActualHours = ActualHours;
      set RecordActionTakenInfo.ScheduledHours = ScheduledHours;
      set RecordActionTakenInfo.RemainingHours = RemainingHours;
      set RecordActionTakenInfo.MainVtrObjkey = Objkey;
      set RecordActionTakenInfo.Source = Source;
      set RecordActionTakenInfo.IsJobStopExecuted = true;
      assistant JobStop(RecordActionTakenInfo) into(ActionDesc, IsCertifyWorkPerformed) {
         when OK {
            if[ActionDesc = null] {
               exit;
            }
            call AddAction(Objkey, ActionDesc, TaskSeq, IsCertifyWorkPerformed);
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}
command RecordInstalledPartCommand for InstalledPartLineVirtual {
   enabled = [InstalledUser = null and CancelledBy = null];
   mode = SingleRecord;
   variable NewInstalledSerialNo Text;
   variable NewInstalledBatchNo Text;
   variable NewInstalledQuantity Number;
   variable NewInstalledUser Text;
   variable NewInstalledPartNoId Number;
   variable RemovalPartInfo {
      type = Structure(RemovedPartInfoStructure);
   }
   variable RemovalPartNoId Number;
   variable RecordInstallInfo Structure(RecordInstallInfoStructure);
   variable RecordRemovedPartInfo Structure(RecordRemovedPartInfoStructure);
   execute {
      copy this into RecordInstallInfo;
      call GetAircraftRegCode(AircraftId) into AircraftRegCode;
      set RecordInstallInfo.AircraftRegCode = AircraftRegCode;
      if [SchedulingAction = "REQ" and MaintMaterialReqRef.Qty = 0] {
         error("The part must be issued to the task before the installation can be recorded.");
      }
      else {
         assistant RecordInstallAssistant(RecordInstallInfo) into(NewInstalledSerialNo, NewInstalledBatchNo, NewInstalledQuantity, NewInstalledUser, NewInstalledPartNoId, InventoryClassCode, RemovalSerialNo, RemovalBatchNo, RemovalPartAltId) {
            when OK {
               call UpdateInstallPart(Objkey, NewInstalledSerialNo, NewInstalledBatchNo, NewInstalledQuantity, NewInstalledPartNoId);
               if [InventoryClassCode in("ASSY", "TRK")] {
                  call GetRemovedPartRecord(InventoryClassCode, ConfigSlotPositionId, AssyConfigSlotPositionId, ParentObjkey) into RemovalPartInfo;
                  set RemovedQuantity = RemovalPartInfo.RemovalQuantity;
                  set RemovalReasonCode = RemovalPartInfo.RemovalReasonCode;
                  set RemovedUser = RemovalPartInfo.RemovalUser;
                  set RemovedUserDesc = RemovalPartInfo.RemovalUserDesc;
                  set RemovalPartGroupId = RemovalPartInfo.RemovalPartGroupId;
                  set RemovalPartNoId = RemovalPartInfo.RemovalPartNoId;

                  if [RemovalPartInfo.IsSigned = false] {
                     confirm("Do you want to add removal serial number and sign?") {
                        when OK {
                           if [RemovalSerialNo = null] {
                              set RemovalSerialNo = RemovalPartInfo.RemovalSerialNo;
                           }
                           if [RemovalBatchNo = null] {
                              set RemovalBatchNo = RemovalPartInfo.RemovalBatchNo;
                           }
                           if[RemovalPartAltId != RemovalPartInfo.RemovalAltId] {
                              call GetPartIdByAltId(RemovalPartAltId) into RemovalPartNoId;
                              info("The removed part and serial number are updated according to the aircraft configuration.");
                           }

                           copy this into RecordRemovedPartInfo;
                           assistant RecordRemovedPartAssistant(RecordRemovedPartInfo) into(NewRemovedSerialNo, NewRemovedBatchNo, NewRemovedQuantity, NewRemovalReasonCode, NewRemovedUser, NewRemovedPartNoId) {
                              when OK {
                                 call UpdateRmvPart(RemovalPartInfo.RemovalObjkey, NewRemovedSerialNo, NewRemovedBatchNo, NewRemovedQuantity, NewRemovalReasonCode, NewRemovedPartNoId);
                                 refresh;
                                 exit;
                              }
                              when CANCEL {
                                 exit;
                              }
                           }
                        }
                        when CANCEL {
                           exit;
                        }
                     }
                  }
               }
               exit;
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}
