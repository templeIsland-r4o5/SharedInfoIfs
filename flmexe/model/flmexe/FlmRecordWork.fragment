command RevokeInstalledPartCommand for InstalledPartLineVirtual {
   icon = "user-absent";
   label = "Revoke Sign-Off";
   enabled = [(SignedFlag = true or(parent.IsEditTaskCardAccess = true and DbInstalledUser != null and InstalledUser != null)) and parent.TaskCertificationEnable = false];
   mode = SingleRecord;

   execute {
      if [SignedFlag = true and parent.IsEditTaskCardAccess = false] {
         confirm("Do you want to revoke the sign-off?") {
            when OK {
               call RevokeInstalledPart(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     success("Sign-off successfully revoked. Part installation is now pending sign-off.");
                     exit OK;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         assistant RevokeInstallPartSignOffAssistant(PartNumberInstRef, InstalledSerialNo, PartGroup, AssyPos, InstalledQuantity, InstalledDate, InstalledUser) into(RevokeSignOffReason) {
            when OK {
               call RevokeInstalledPart(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     success("Sign-off successfully revoked. Part installation is now pending sign-off.");
                     exit OK;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}

