            set AssmblConfSlotPosCode = CmsRequestInfo.AssemblyConfigSlotPosition;
            set ConfigSlot = CmsRequestInfo.ConfigSlotCode;
            set ConfSlotPosCode = CmsRequestInfo.ConfigSlotPosition;
            set IsSubAssy = CmsRequestInfo.IsSubAssy;
         }
         set PartValidationWarningInfo.InstallationPartNumber = PartNumberInstRef.PartNumber;
         set PartValidationWarningInfo.InstallationManufacturerCode = PartNumberInstRef.Manufacturer;
         set PartValidationWarningInfo.InventoryClassCode = PartNumberInstRef.InventoryClassCode;

         if[PartNumberInstRef.InventoryClassCode in("ASSY", "TRK", "SER", "BATCH")] {
            if [(InstalledSerialNo != null and InstalledSerialNo != "*") or(InstalledBatchNo != null and InstalledBatchNo != "*")] {
               if [InstalledSerialNo = null and InstalledBatchNo != null] {
               -- When InstalledSerialNo is null, sending the InstalledBatchNo to trigger CMS
                  set TempInstalledSerialNo = InstalledSerialNo;
                  set InstalledSerialNo = InstalledBatchNo;
               }
               call CmsDryRunResponseSeverityService(RemovalPartNumber, RemovalPartManufacturer, RemovalSerialNo, CmsRequestInfo.RemovalReasonCode, PartNumberInstRef.PartNumber, PartNumberInstRef.Manufacturer, InstalledSerialNo, AircraftRegCode, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.IsSubAssy, PartNumberInstRef.InventoryClassCode, PartChangeType) into CmsResponseSeverity;
            }
            -- CmsResponseSeverity values:
            -- -1 : No CMS errors or warnings
            --  0 : Only CMS warnings (no errors)
            --  1 : At least one CMS error
            if [CmsResponseSeverity != -1] {
               copy this into PartValidationWarningInfo;
               assistant PartValidationWarningAssistant(PartValidationWarningInfo) into(CmsResponseSeverity) {
                  when CANCEL {
                     set Barcode = null;
                     set InstalledSerialNo = null;
                     set InstalledBatchNo = null;
                     exit;
                  }
               }
            }
         }
         if [PartNumberInstRef.InventoryClassCode = "BATCH" and(InstalledBatchNo != null and InstalledBatchNo != "*")] {
            set InstalledSerialNo = TempInstalledSerialNo;
         }
         exit OK;
      }
   }
}

command SignCommand for RecordWorkVirtual {
   label = "Sign";
   variable HasExistingInWorkWP Boolean;
   variable SignResponse {
      type = Structure(EsigResponseStructure);
   }
   variable LatestActionInfo {
      type = Structure(LatestActionInfoStruct);
   }

   enabled = [SignEnable and(ESigPermission = "Yes" or ESigPermission = null)and(Source != "Finish" or IsActionRecorded)];
   execute {
      call CheckInworkWp(AircraftId, Location) into HasExistingInWorkWP;
      if[HasExistingInWorkWP = false] {
         signdocument into SignResponse {
            headerlogo = MediaObject;
            keyref = ParentKeyRef;
            luname = ParentLuName;
            filenameprefix = "${FileName}";
            documenttype = pdf;
         }
         if[TaskCardOption = "RaiseAndClose"] {
            set RecordWorkStartTime = CloseFaultAssignStartTime;
         }
         if [SignResponse.State = "SUCCESS"] {
            call Sign(Objkey, TaskSeq, SignResponse.Guid, RecordWorkStartTime, Site);
            if[TaskCardOption != "RaiseAndClose" or(TaskCardOption = "RaiseAndClose" and NavigatedFrom = "Task")] {
               exit OK;
            }
            else {
               if[NavigatedFrom = "Flight"] {
                  exit OK;
               }
               navigate "page/FlmTaskDetail/MyWorkPage;$filter=TaskSeq eq $[TaskSeq]";
            }
         }
         if [SignResponse.State = "FAIL"] {
            error("Failed to record electronic signature. Review changes and try again.");
         }
         exit;
      }
      else {
         alert("A work package is already in work for this aircraft at another location. Close it to start another one.");
      }
   }
}
command FinishCommand for RecordWorkVirtual {
   label = "Finish";
   variable HasExistingInWorkWP Boolean;
   enabled = [SignEnable and ESigPermission = "No"and(Source != "Finish" or IsActionRecorded)];
   execute {
      call CheckInworkWp(AircraftId, Location) into HasExistingInWorkWP;
      if[HasExistingInWorkWP = false] {
         if[TaskCardOption = "RaiseAndClose"] {
            set RecordWorkStartTime = CloseFaultAssignStartTime;
         }
         call Sign(Objkey, TaskSeq, Null, RecordWorkStartTime, Site);
         if[TaskCardOption != "RaiseAndClose" or(TaskCardOption = "RaiseAndClose" and NavigatedFrom = "Task")] {
            exit OK;
         }
         else {
            if[NavigatedFrom = "Flight"] {
               exit OK;
            }
            navigate "page/FlmTaskDetail/MyWorkPage;$filter=TaskSeq eq $[TaskSeq]";
         }
      }
      else {
         alert("A work package is already in work for this aircraft at another location. Close it to start another one.");
      }
   }
}
command CompleteTaskCommand for TaskCertifyVirtual {
   label = "Record Task Certification";
   mode = SingleRecord;
   enabled = [parent.CompleteTaskEnable and parent.IsActionRecorded and Role = "Inspector" and SignedBy = null];
   visible = [parent.Source != "RecordWork"];
   variable Warning Text;
   variable CurrentUser Text;
   variable StartedExecutionInstances Boolean;
   variable ExistingIndependent Boolean;

   execute {
      call GetCurrentUser() into CurrentUser;
      call GetTaskSignOffPermission(CurrentUser) into TaskSignOffPermission;
      call HasStartedExecutionInstances(TaskSeq, parent.ExecutionInstanceSeq) into StartedExecutionInstances;
      call CheckExistIndependent(TaskSeq) into ExistingIndependent;

      if[TaskSignOffPermission = "No"] {
         error("Missing task sign-off permission. Contact system administrator.");
      }
      else {
         if [ExistingIndependent = true] {
            assistant CompleteTaskAssitant(SignOffReqType) into(ApprovalNumber, CompletionNote) {
               when OK {
                  call ShowMissingComponentWarning(TaskSeq, AircraftWpId) into Warning;
                  if[parent.HasPendingNonRoutines = false] {
                     if[Warning != null] {
                        messagebox("Warning", warning, "This task removed a component with config slot ${Warning} and there is no matching installation in the work package. Do you want to complete this task?") {
                           when "OK" {
                              call CompleteTask(Objkey, ApprovalNumber, CompletionNote, TaskSeq);
                              set CompleteTaskEnable = false;
                              set TaskCertificationEnable = true;
                              refresh;

                           }
                           when "CANCEL" {
                              exit;
                           }
                        }
                     }
                     else {
                        call CompleteTask(Objkey, ApprovalNumber, CompletionNote, TaskSeq);
                        set CompleteTaskEnable = false;
                        set TaskCertificationEnable = true;
                        refresh;
                     }
                  }
                  else {
                     alert("Complete or defer all open Non-Routines found during this task to complete it.");
                  }
               }
               when CANCEL {
                  exit;
               }
            }
         }
         else {
            if[StartedExecutionInstances = true] {
               error("Cannot complete the task while assignments are in progress.");
            }
            else {
               assistant CompleteTaskAssitant(SignOffReqType) into(ApprovalNumber, CompletionNote) {
                  when OK {
                     call ShowMissingComponentWarning(TaskSeq, AircraftWpId) into Warning;
                     if[parent.HasPendingNonRoutines = false] {
                        if[Warning != null] {
                           messagebox("Warning", warning, "This task removed a component with config slot ${Warning} and there is no matching installation in the work package. Do you want to complete this task?") {
                              when "OK" {
                                 call CompleteTask(Objkey, ApprovalNumber, CompletionNote, TaskSeq);
                                 set CompleteTaskEnable = false;
                                 set TaskCertificationEnable = true;
                                 refresh;

                              }
                              when "CANCEL" {
                                 exit;
                              }
                           }
                        }
                        else {
                           call CompleteTask(Objkey, ApprovalNumber, CompletionNote, TaskSeq);
                           set CompleteTaskEnable = false;
                           set TaskCertificationEnable = true;
                           refresh;
                        }
                     }
                     else {
                        alert("Complete or defer all open Non-Routines found during this task to complete it.");
                     }
                  }
                  when CANCEL {
                     exit;
                  }
               }
            }
         }


      }
   }
}

command RevokeTaskCertificationCommand for TaskCertifyVirtual {
   icon = "user-absent";
   label = "Revoke Sign-Off";
   enabled = [SignedFlag = true];
   mode = SingleRecord;

   execute {
      confirm("Do you want to revoke the sign-off?") {
         when OK {
            call RevokeTaskCertification(Objkey) {
               when SUCCESS {
                  success("Sign-off successfully revoked. Task certification is now pending sign-off.");
                  set CompleteTaskEnable = true;
                  if [Role = "Inspector"] {
                     set TaskCertificationEnable = false;
                  }
                  refresh;
               }
            }
         }
         when CANCEL {
            exit;
         }
      }
   }

}

