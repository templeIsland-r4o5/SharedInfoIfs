command SaveAction for TaskActionLineVirtual {
   label = "Save";
   visible = [ActionDesc != null and ActionDesc != InitialActionDesc];
   variable ConfirmationMsg Text;
   execute {
      call IsActualHoursMandatory() into ActualHoursMandatory;
      call IsSkillMandatory(MainVtrObjkey, TaskResourceSeq);
      if [MainVrtUpdate = true] {
         call UpdateRecordWorkVirtual(MainVtrObjkey, TaskSeq, TaskResourceSeq, ExecutionInstanceSeq);
      }
      if [ActualHoursMandatory = "TRUE" and(Source = "Finish" or IsJobStopExecuted)] {
         call ValidateHours(ActualHours, "Actual Hours");
         call GetSaveActionConfirmMsg(ActualHours, RemainingHours, IsJobStopExecuted) into ConfirmationMsg;
         confirm("${ConfirmationMsg}") {
            when OK {
               call ValidateStartEndDates(StartTime, EndTime, Site, "Start Date", "End Date");
               call UpdateClockOut(MainVtrObjkey, StartTime, EndTime, ActualHours, Site);
               if [IsJobStopExecuted] {
                  call DoJobStopTemporary(MainVtrObjkey, ActualHours, IncompletionCause, JobstopNote, RemainingHours, AssignToMeNewTaskRes);
               }
               exit OK;
            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         if [Source = "Final Sign-Off"] {
            exit OK;
         }

         if [(Source = "RecordWork" and IsJobStopExecuted) or Source != "RecordWork"] {
            call ValidateHours(ActualHours, "Actual Hours");
            call ValidateStartEndDates(StartTime, EndTime, Site, "Start Date", "End Date");
            call UpdateClockOut(MainVtrObjkey, StartTime, EndTime, ActualHours, Site);
            if [IsJobStopExecuted] {
               call DoJobStopTemporary(MainVtrObjkey, ActualHours, IncompletionCause, JobstopNote, RemainingHours, AssignToMeNewTaskRes);
            }
         }
         exit OK;
      }
   }
}

command SignStepSignOffCommand for TaskStepSignOffVirtual {
   label = "${CommandLabel}";
   enabled = [SignOffStatus != "Signed" and not parent.parent.IsActionRecorded];
   execute {
      call ValidateSignOff(TaskSeq, Objkey);
      if [StepObjConnLuNameDb = "AircraftPanel"] {
         call UpdateStepSignOff(Objkey, SignOffNote);
      }
      else {
         assistant RecordSignOff(SignOffNote)into(SignOffNote) {
            when OK {
               call UpdateStepSignOff(Objkey, SignOffNote);
               refresh;
               exit;
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}

command RevokeStepSignOffCommand for TaskStepSignOffVirtual {
   icon = "user-absent";
   label = "Revoke Sign-Off";

   enabled = [((SignedFlag = true) or(RevokeEnable = true) or(parent.parent.IsEditTaskCardAccess = true and DbSignedUser != null and Identity != null and IsDbRevokeSignOffCapable)) and IsRevokeSignOffCapable and parent.parent.TaskCertificationEnable = false];
   mode = SingleRecord;

   execute {
      if [SignedFlag = true and IsRevokeSignOffCapable and parent.parent.IsEditTaskCardAccess = false] {
         confirm("Do you want to revoke the sign-off?") {
            when OK {
               call RevokeStepSignOff(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     if [StepObjConnLuNameDb = "AircraftPanel"] {
                        success("Sign-off successfully revoked. Panel ${PanelVirtualRef.PanelCode} is now pending sign-off.");
                     }
                     else {
                        success("Sign-off successfully revoked. Step ${OrderNo} is now pending sign-off.");
                     }
                     refresh;
                     exit;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         assistant RevokeStepSignOffAssistant(Role, LicenseId, SignOffDate, Identity, SignOffNote, OrderNo) into(RevokeSignOffReason) {
            when OK {
               call RevokeStepSignOff(Objkey, RevokeSignOffReason) {
                  when SUCCESS {
                     success("Sign-off successfully revoked. Step ${OrderNo} is now pending sign-off.");
                     refresh;
                     exit;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}

@Override
command RecordSignOffCommand for JtTaskStepSignOff {
   label = "Record Sign-off";
   enabled = [JtTaskStepRef.Objstate != "DONE" and Identity = null];
   mode = SelectedRecords;
   variable RecordWorkInfo Structure(RecordWorkInfoStructure);
   variable IsPanelValidated Text;
   variable CheckConnectedTasks Text;

   bulkexecute {

      call CanMaintenanceTaskStart(Selection) into IsPanelValidated;
      call CanMpcCloseTaskStart(Selection) into CheckConnectedTasks;

      if [IsPanelValidated = "FALSE"] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = "FALSE"] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }
      bulkcall ValidateBulkSignOff(TaskSeq, JtTaskSignOffReqRef.LicenseId, JtTaskSignOffReqRef.SignOffReqType);
      bulkcall CheckStepSigned(JtTaskSignOffReqRef.SignOffReqType, TaskSeq, JtTaskStepRef.TaskStepSeq, SignOffReqSeq, JtTaskSignOffReqRef.LicenseId, StepObjConnLuNameDb);
      bulkcall CheckInspectorSignOff(JtTaskSignOffReqRef.SignOffReqType, TaskSeq, JtTaskStepRef.TaskStepSeq, SignOffReqSeq, JtTaskSignOffReqRef.LicenseId, StepObjConnLuNameDb);

      copy this into RecordWorkInfo;
      ifall [StepObjConnLuNameDb = "AircraftPanel"] {
         call GetRecordWorkInfo(component.PanelSignOffList.Selection) into RecordWorkInfo;
      }
      else {
         call GetRecordWorkInfo(component.StepSignOffList.Selection) into RecordWorkInfo;
      }

      assistant RecordWorkAssistant(RecordWorkInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}

command RecordToolDemandCommand for ToolResourceDemandVirtual {
   label = "Record Tool";
   visible = [SignedUser = null];

   variable ToolDemandInfo Structure(ToolResourceDemandStructure);
   variable ActualStartDate Timestamp;
   variable ActualHours Text;
   variable ActualEndDate Timestamp;
   variable DateInSiteTimezone Timestamp;

   execute {
      copy this into ToolDemandInfo;
      call GetTimestamp(Site) into ToolDemandInfo.ActualEndDate;
      if [AssignmentStartDate < CheckedOutDate or CheckedOutDate = null] {
         set ToolDemandInfo.CheckedOutDate = AssignmentStartDate;
      }
      call GetSerialAvaliablity(SerialNo) into ToolDemandInfo.ToolEqpAssigned;
      call GetTimeDuration(ToolDemandInfo.CheckedOutDate, ToolDemandInfo.ActualEndDate) into ToolDemandInfo.ActualHours;
      assistant RecordToolAssistant(ToolDemandInfo) into(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq) {
         when OK {
            call RecordToolDemand(Objkey, CheckedOutDate, ActualEndDate, ActualHours, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq, ReasonToEdit) {
               when SUCCESS {
                  exit OK;
               }
            }
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command EditToolDemandCommand for ToolResourceDemandVirtual {
   label = "";
   icon = "edit";
   visible = [SignedFlag = true or(parent.IsEditTaskCardAccess = true and DbSignedUser != null and SignedUser != null)];
   mode = SingleRecord;

   variable ToolDemandInfo Structure(ToolResourceDemandStructure);
   variable ActualStartDate Timestamp;
   variable ActualHours Text;
   variable ActualEndDate Timestamp;
   variable DateInSiteTimezone Timestamp;

   execute {
      copy this into ToolDemandInfo;
      call GetCurrentDateInUtc() into ToolDemandInfo.ActualEndDate;
      call GetSerialAvaliablity(SerialNo) into ToolDemandInfo.ToolEqpAssigned;

      if [SignedFlag = true and parent.IsEditTaskCardAccess = false] {
         assistant EditToolAssistant(ToolDemandInfo) into(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq) {
            when OK {
               call RecordToolDemand(Objkey, CheckedOutDate, ActualEndDate, ActualHours, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq, ReasonToEdit) {
                  when SUCCESS {
                     success("Tool updated successfully.");
                     refresh;
                     exit;
                  }
               }

            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         assistant EditAuthorizedToolAssistant(ToolDemandInfo) into(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq, ReasonToEdit) {
            when OK {
               call RecordToolDemand(Objkey, CheckedOutDate, ActualEndDate, ActualHours, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq, ReasonToEdit) {
                  when SUCCESS {
                     success("Tool updated successfully.");
                     exit OK;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
   }
}

command SignedToolResource for ToolResourceDemandVirtual {
   label = "Save";
   visible = [CheckedOutDate != null and ActualHours != null and ActualEndDate != null and ToolPartId != null and SerialNo != null];

   execute {
      call VerifyActualHours(ActualHours);
      call ValidateToolStartEndDate(TaskSeq, ResourceSeq, CheckedOutDate, ActualEndDate);
      exit OK;
   }
}

