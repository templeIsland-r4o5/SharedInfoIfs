group RecordActionGroup for TaskActionLineVirtual {
   label = "Action Taken";
   field ActionDesc {
      label = "Action Taken";
      size = FullWidth;
      required = [true];
   }
   lov DemandLineRef with DemandLineSelector using GetSkillDemand(TaskSeq, Remark, CurrentUser) {
      label = "Skill";
      visible = [Source != "Final Sign-Off" and IsEditTaskCardAccess = false];
      hidekey = [true];
      editable = [TaskResourceSeq = null or MainVrtUpdate = true];
      searchable = true;
      search = DemandLineRef.ResourceDemand;
      description = DemandLineRef.ResourceDemand;
      required = [true];
      validate command {
         execute {
            set ExecutionInstanceSeq = DemandLineRef.ExecutionInstanceSeq;
            set MainVrtUpdate = true;
            if [TaskResourceSeq = null] {
               set TaskResourceSeq = DemandLineRef.TaskResourceSeq;
            }
         }
      }
   }

   field ActualHours {
      label = "Actual Hours (HH:MM)";
      visible = [Source = "Finish" or IsJobStopExecuted];
      format = decimal;
      validate command {
         execute {
            if [IsJobStopExecuted] {
               call ValidateHours(ActualHours, "Actual Hours") into ActualHours;
               call CalculateRemainingHours(ActualHours, ScheduledHours) into RemainingHours;
            }
         }
      }
   }
   field StartTime {
      label = "Start Time";
      visible = [Source = "Finish" or IsJobStopExecuted];
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      editable = [AssignmentStatus = "ASSIGNED"];
      validate command {
         execute {
            call ValidateStartEndDates(StartTime, EndTime, Site, "Start Date", "End Date") into ActualHours;
         }
      }
   }
   field EndTime {
      label = "End Time";
      visible = [Source = "Finish" or IsJobStopExecuted];
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      validate command {
         execute {
            call ValidateStartEndDates(StartTime, EndTime, Site, "Start Date", "End Date") into ActualHours;
         }
      }
   }
   field CertifyWorkPerformed {
      visible = [IsSignOffSigned = "TRUE" and IsEditTaskCardAccess = false];
   }
}
