virtual StepMeasurementVirtual {
   crud = Read;
   attribute Measurement Text;
   attribute Value Number;
   attribute SignedBy Text;
}
virtual TaskCertifyVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   ludependencies = RecordWorkVirtual;
   attribute TaskSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute TaskObjstate Enumeration(AvExeTaskState);
   attribute ActualEndDate Timestamp;
   attribute SignedBy Text;
   attribute SignedByName Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(signed_by))";
   }
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute ApprovalNumber Text;
   attribute CompletionNote Text;
   attribute TaskSignOffPermission Text;
   attribute Role Enumeration(SignOffReqTypeEnum) {
      fetch = "Sign_Off_Req_Type";
      label = "Role";
      maxlength = 20;
   }
   attribute SignOffReqSeq Number;
   attribute SignOffReqType Text;
   attribute GroupingNo Number;
   attribute SignOffStatus Text;
   attribute TaskCertificationEnable Boolean;
   attribute CompleteTaskEnable Boolean;
   attribute SignOffDate Date;
   attribute IdentityName Text;
   attribute IsFinalSignOff Boolean;
   attribute SignedFlag Boolean;
   attribute ExistingUser Boolean;
}

virtual ClockInVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   ludependencies = RecordWorkVirtual;
   attribute TaskSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute StartTime Timestamp;
   attribute StopTime Timestamp;
   attribute WorkHours Text;
   attribute Company Text;
   attribute ActualHours Number;
   attribute AssignmentStatus Text;
   attribute Source Text;
}

virtual TaskStepSignOffVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   ludependencies = RecordWorkVirtual, StepVirtual, PanelVirtual;
   attribute TaskSeq Number;
   attribute TaskStepSeq Number;
   attribute SignOffReqSeq Number;
   attribute Role Enumeration(SignOffReqType);
   attribute LicenseId Text;
   attribute Description Text;
   attribute SignOffStatus Text;
   attribute Identity Text;
   attribute SignOffDate Timestamp;
   attribute SignedFlag Boolean;
   attribute SignOffNote Text;
   attribute CommandLabel Text;
   attribute SignOffReqTypeDb Text;
   attribute GroupingNo Number;
   attribute OrderNo Number;
   attribute RevokeEnable Boolean;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute StepObjConnLuNameDb Text;
   attribute IsRevokeSignOffCapable Boolean;
   attribute IsDbRevokeSignOffCapable Boolean("TRUE", "FALSE") {
      fetch = "Mm_Step_Sign_off_Req_Util_API.Is_Db_Sign_Off_Revoke_Capable(sign_off_req_type_db, sign_off_status, task_seq, task_step_seq, grouping_no)";
   }
   attribute RevokeSignOffReason Text;
   attribute DbSignedUser Text {
      fetch = "Jt_Task_Step_Sign_Off_API.Get_Identity(task_seq, task_step_seq, sign_off_req_seq)";
   }

   reference JtTaskSignOffReqRef(TaskSeq, SignOffReqSeq) to JtTaskSignOffReq(TaskSeq, SignOffReqSeq);
   reference PanelVirtualRef(TaskSeq, TaskStepSeq, ParentObjkey) to PanelVirtual(TaskSeq, TaskStepId, Objkey);
}

virtual ToolResourceDemandVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   ludependencies = RecordWorkVirtual;
   attribute TaskSeq Number;
   attribute TaskResourceSeq Number;
   attribute ResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute ToolGroup Text;
   attribute SerialNo Text;
   attribute ResourceParentId Text;
   attribute CheckedOutDate Timestamp;
   attribute ToolPartId Text;
   attribute ToolPartDescription Text;
   attribute Site Text;
   attribute AllocatedStartDate Timestamp;
   attribute AllocatedFinishDate Timestamp;
   attribute PlannedHours Number;
   attribute ActualHours Text;
   attribute ActualEndDate Timestamp;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute SignedFlag Boolean;
   attribute SignedUser Text;
   attribute SignedDate Timestamp;
   attribute ToolEqpAssigned Text;
   attribute AssignmentStartDate Timestamp;
   attribute ResourceGroupDescription Text;
   attribute IsEditTool Boolean;
   attribute DbSignedUser Text {
      fetch = "Adcom_Util_API.Get_Latest_Transaction_User(task_seq, execution_instance_seq)";
   }
   attribute ToolGroupDescription Text {
      fetch = "Resource_API.Get_Description(resource_group_seq)";
   }
   attribute ReasonToEdit Text;
   attribute ResourceId Text;

   reference ResourceIdRef(Site, ResourceId) to MaintResources(Site, ResourceId) {
      copy SerialNo to SerialNo;
      copy ResourceSeq to ResourceSeq;
      copy ResourceId to ResourceId;
   }
   reference ToolResourceGroupLovRef(Site) to ResourceGroupSiteLov(Site) {
      copy ResourceSeq to ResourceGroupSeq;
      copy ResourceId to ResourceParentId;
      copy Description to ToolGroupDescription;
   }
}
-------------------------------- STRUCTURES ---------------------------------
structure RecordToolStructure {
   attribute PartNoId Number;
   attribute SerialNo Text {
      required = [true];
   }
   attribute ActualDuration Text {
      required = [true];
   }

   reference PartNumberRef(PartNoId) to AvPartNumber(PartNumberId);
}

structure RecordResourceToolStructure {
   attribute ResourceGroupId Text {
      editable = [false];
   }
   attribute ResourceId Text;
   attribute ResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute PartNo Text;
   attribute SerialNo Text;
   attribute ActualDuration Text {
      label = "Actual Hours (HH:MM)";
      required = [true];
   }

   reference ResourceGroupIdRef(ResourceGroupId) to ResourceGroupMaintLov(ResourceId) {
      label = "Tool/Equipment Group";
   }
   @DynamicComponentDependency TOOLEQ
   reference ResourceIdRef(ResourceId) to ResourceToolEquipJoinLov(ResourceId) {
      label = "Tool/Equipment";
      copy ResourceSeq to ResourceSeq;
   }
   reference PartCatalogRef(PartNo) to PartCatalogLov(PartNo) {
      label = "Part No";
   }
   reference PartSerialCatalogRef(PartNo, SerialNo) to PartSerialCatalog(PartNo, SerialNo) {
      label = "Serial No";
   }
}

