command RemovedSign for RemovedPartLineVirtual {
   enabled = [(PartType != "BATCH" and RemovalSerialNo != null and RemovedQuantity != null and RemovalReasonCode != null)or(PartType = "BATCH" and RemovedQuantity != null and RemovalReasonCode != null)];
   variable PartChangeType      Text;
   variable TempRemovalSerialNo Text;
   variable CmsRequestInfo {
      type = Structure(CmsDataStructure);
   }
   variable PartValidationWarningInfo Structure(PartValidationWarningInfoStructure);
   execute {
      set RemovalPartNumber = PartNumberRmvdRef.PartNumber;
      set RemovalPartManufacturer = PartNumberRmvdRef.Manufacture;
      set RemovalPartManufacturer = PartNumberRmvdRef.Manufacturer;
      set InventoryClassCode = PartNumberRmvdRef.InventoryClassCode;
      set InventoryClassCode = PartNumberRmvdRef.InventoryClassCode;
      if [RemovalSerialNo != null or PartType = "BATCH"] {
         if[PartNumberRmvdRef.InventoryClassCode in("ASSY", "TRK", "SER", "BATCH")] {
            call GetCmsRequestData(TaskPartId, ParentObjkey) into CmsRequestInfo;
            set PartChangeType = "REMOVE";
            set AssmblConfSlotCode = CmsRequestInfo.AssemblyConfigSlotCode;
            set AssmblConfSlotPosCode = CmsRequestInfo.AssemblyConfigSlotPosition;
            set ConfigSlot = CmsRequestInfo.ConfigSlotCode;
            set ConfSlotPosCode = CmsRequestInfo.ConfigSlotPosition;
            set IsSubAssy = CmsRequestInfo.IsSubAssy;
            if [RemovalSerialNo != null or RemovalBatchNo != null] {
               if [RemovalSerialNo = null and RemovalBatchNo != null] {
               -- When RemovalSerialNo is null, sending the RemovalBatchNo to trigger CMS
                  set TempRemovalSerialNo = RemovalSerialNo;
                  set RemovalSerialNo = RemovalBatchNo;
               }
               call CmsDryRunResponseSeverityService(PartNumberRmvdRef.PartNumber, PartNumberRmvdRef.Manufacturer, RemovalSerialNo, RemovalReasonCode, "", "", "", AircraftRegCode, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.IsSubAssy, PartNumberRmvdRef.InventoryClassCode, PartChangeType) into CmsResponseSeverity;
            }

            -- CmsResponseSeverity will be -1 if there are no CMS Errors/warnings
            -- CmsResponseSeverity will be 0 if there are only CMS warnings and no errors
            -- CmsResponseSeverity will be 1 if there are at least one CMS Error

            if [CmsResponseSeverity !=-1] {
               copy this into PartValidationWarningInfo;
               assistant PartValidationWarningAssistant(PartValidationWarningInfo) into(CmsResponseSeverity) {
                  when CANCEL {
                     set RemovalSerialNo = null;
                     set RemovalBatchNo = null;
                     exit;
                  }
               }
            }
         }
         if [PartType = "BATCH" and RemovalBatchNo != null] {
            set RemovalSerialNo = TempRemovalSerialNo;
         }

         call GetCurrentUser() into RemovedUser;
         call GetCurrentUserDesc() into RemovedUserDesc;
         exit OK;
      }
   }
}

command EditRemovedSign for RemovedPartLineVirtual {
   enabled = [RemovedQuantity != null and RemovalReasonCode != null and RemovalPartNoId != null and(PartType = "BATCH" or(RemovalSerialNo != null and ConfigSlotPositionRef.ConfigSlotPositionCode != null)) and(RemovalEditReason != null or DbRemovedUser = null)];

   variable PartChangeType Text;
   variable TempRemovalSerialNo Text;
   variable CmsRequestInfo {
      type = Structure(CmsDataStructure);
   }
   variable PartValidationWarningInfo Structure(PartValidationWarningInfoStructure);
   execute {
      set RemovalPartNumber = PartNumberRmvdRef.PartNumber;
      set RemovalPartManufacturer = PartNumberRmvdRef.Manufacturer;
      set InventoryClassCode = PartNumberRmvdRef.InventoryClassCode;

      if [RemovalSerialNo != null or PartType = "BATCH"] {
         if[PartNumberRmvdRef.InventoryClassCode in("ASSY", "TRK", "SER", "BATCH")] {
            call GetRemovalCmsRequestData(Objkey, ConfigSlotPositionId) into CmsRequestInfo;
            set PartChangeType = "REMOVE";
            set AssmblConfSlotCode = CmsRequestInfo.AssemblyConfigSlotCode;
            set AssmblConfSlotPosCode = CmsRequestInfo.AssemblyConfigSlotPosition;
            set ConfigSlot = CmsRequestInfo.ConfigSlotCode;
            set ConfSlotPosCode = CmsRequestInfo.ConfigSlotPosition;
            set IsSubAssy = CmsRequestInfo.IsSubAssy;
            if [RemovalSerialNo != null or RemovalBatchNo != null] {
               if [RemovalSerialNo = null and RemovalBatchNo != null] {
               -- When RemovalSerialNo is null, sending the RemovalBatchNo to trigger CMS
                  set TempRemovalSerialNo = RemovalSerialNo;
                  set RemovalSerialNo = RemovalBatchNo;
               }
               call CmsDryRunResponseSeverityService(PartNumberRmvdRef.PartNumber, PartNumberRmvdRef.Manufacturer, RemovalSerialNo, RemovalReasonCode, "", "", "", AircraftRegCode, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.IsSubAssy, PartNumberRmvdRef.InventoryClassCode, PartChangeType) into CmsResponseSeverity;
            }
            -- CmsResponseSeverity values:
            -- -1 : No CMS errors or warnings
            --  0 : Only CMS warnings (no errors)
            --  1 : At least one CMS error

            if [CmsResponseSeverity !=-1] {
               copy this into PartValidationWarningInfo;
               assistant PartValidationWarningAssistant(PartValidationWarningInfo) into(CmsResponseSeverity) {
                  when CANCEL {
                     set RemovalSerialNo = null;
                     set RemovalBatchNo = null;
                     exit;
                  }
               }
            }
         }
         if [PartType = "BATCH" and RemovalBatchNo != null] {
            set RemovalSerialNo = TempRemovalSerialNo;
         }
         exit OK;
      }
   }
}
command InstalledSign for InstalledPartLineVirtual {
   enabled = [((InstalledSerialNo != null or InstalledBatchNo != null) and InstalledQuantity != null and InstalledPartNoId != null)];
   variable PartChangeType        Text;
   variable TempInstalledSerialNo Text;
   variable InventorySearchResponse {
      type = Structure(InventorySearchResponseStructure);
   }
   variable CmsRequestInfo {
      type = Structure(CmsDataStructure);
   }
   variable PartValidationWarningInfo Structure(PartValidationWarningInfoStructure);
   execute {
      if [InstalledSerialNo != null or InstalledBatchNo != null] {
         if[PartNumberInstRef.InventoryClassCode in("ASSY", "TRK", "SER", "BATCH")] {
            call GetCmsRequestData(TaskPartId, InstVrtParentObjkey) into CmsRequestInfo;
            if [CmsRequestInfo.IsRemovedPartSigned = false] {
               if[PartNumberInstRef.InventoryClassCode in("ASSY", "TRK")] {
                  call GetRemovalInfoService(CmsRequestInfo.AircraftAltId, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition) into InventorySearchResponse;
                  if [InventorySearchResponse != null] {
                     set RemovalSerialNo = InventorySearchResponse.SerialNumber;
                     set RemovalPartNumber = InventorySearchResponse.PartNumber;
                     set RemovalPartManufacturer = InventorySearchResponse.ManufacturerCode;
                     set RemovalPartAltId = InventorySearchResponse.AltId;
                     if[RemovalSerialNo != null] {
                        set PartChangeType = "REPLACE";
                     }
                     else {
                        set PartChangeType = "INSTALL";
                     }
                  }
               }
               else {
                  set RemovalSerialNo = CmsRequestInfo.RemovalSerialNo;
                  set RemovalPartNumber = CmsRequestInfo.RemovalPartNumber;
                  set RemovalPartManufacturer = CmsRequestInfo.RemovalPartManufacturer;
                  set PartChangeType = CmsRequestInfo.PartChangeType;
               }
            }
            else {
               set RemovalSerialNo = CmsRequestInfo.RemovalSerialNo;
               set RemovalPartNumber = CmsRequestInfo.RemovalPartNumber;
               set RemovalPartManufacturer = CmsRequestInfo.RemovalPartManufacturer;
               set PartChangeType = CmsRequestInfo.PartChangeType;
            }
            set InventoryClassCode = PartNumberInstRef.InventoryClassCode;
            set RemovalReasonCode = CmsRequestInfo.RemovalReasonCode;
            set AssmblConfSlotCode = CmsRequestInfo.AssemblyConfigSlotCode;
            set AssmblConfSlotPosCode = CmsRequestInfo.AssemblyConfigSlotPosition;
            set ConfigSlot = CmsRequestInfo.ConfigSlotCode;
            set ConfSlotPosCode = CmsRequestInfo.ConfigSlotPosition;
            set IsSubAssy = CmsRequestInfo.IsSubAssy;
         }
         set PartValidationWarningInfo.InstallationPartNumber = PartNumberInstRef.PartNumber;
         set PartValidationWarningInfo.InstallationManufacturerCode = PartNumberInstRef.Manufacturer;
         set PartValidationWarningInfo.InventoryClassCode = PartNumberInstRef.InventoryClassCode;

         if[PartNumberInstRef.InventoryClassCode in("ASSY", "TRK", "SER", "BATCH")] {
            if [(InstalledSerialNo != null and InstalledSerialNo != "*") or(InstalledBatchNo != null and InstalledBatchNo != "*")] {
               if [InstalledSerialNo = null and InstalledBatchNo != null] {
               -- When InstalledSerialNo is null, sending the InstalledBatchNo to trigger CMS
                  set TempInstalledSerialNo = InstalledSerialNo;
                  set InstalledSerialNo = InstalledBatchNo;
               }
               call CmsDryRunResponseSeverityService(RemovalPartNumber, RemovalPartManufacturer, RemovalSerialNo, CmsRequestInfo.RemovalReasonCode, PartNumberInstRef.PartNumber, PartNumberInstRef.Manufacturer, InstalledSerialNo, AircraftRegCode, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.IsSubAssy, PartNumberInstRef.InventoryClassCode, PartChangeType) into CmsResponseSeverity;
            }
            -- CmsResponseSeverity will be -1 if there are no CMS Errors/warnings
            -- CmsResponseSeverity will be 0 if there are only CMS warnings and no errors
            -- CmsResponseSeverity will be 1 if there are at least one CMS Error
            if [CmsResponseSeverity !=-1] {
               copy this into PartValidationWarningInfo;
               assistant PartValidationWarningAssistant(PartValidationWarningInfo) into(CmsResponseSeverity) {
                  when CANCEL {
                     set Barcode = null;
                     set InstalledSerialNo = null;
                     set InstalledBatchNo = null;
                     exit;
                  }
               }
            }
         }
         if [PartNumberInstRef.InventoryClassCode = "BATCH" and(InstalledBatchNo != null and InstalledBatchNo != "*")] {
            set InstalledSerialNo = TempInstalledSerialNo;
         }

         call GetCurrentUser() into InstalledUser;
         exit OK;
      }
   }
}

