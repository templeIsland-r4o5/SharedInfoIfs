function GetCheckedOutSerial List < Entity(MaintResources) >  {
   parameter ResourceGroupSeq Number;
   parameter Site Text;
   where = "resource_type = 'EQUIPMENT'
            AND site = :Site
            AND resource_seq IN (SELECT resource_seq
                                 FROM resource_tool_equip_tab
                                 WHERE checked_out_to IS NOT NULL)
            AND resource_parent_seq IN (SELECT r.resource_seq
                                        FROM maint_resources_lov6 r
                                        WHERE used_in_maintenance = 'TRUE')
            AND resource_parent_seq IN (SELECT r.resource_seq
                                        FROM Resource_Pub r, Resource_Parent p
                                        WHERE r.resource_seq = p.resource_parent_seq
                                        AND r.resource_type_db = 'EQUIPMENT_GROUP'
                                        START WITH p.resource_parent_seq = :ResourceGroupSeq
                                        CONNECT BY PRIOR p.resource_seq = p.resource_parent_seq)";
}
function ResourceIdLovFunction List < Entity(MaintResources) >  {
   parameter ResourceGroupSeq Number;
   parameter Site Text;
   where = "resource_type = 'EQUIPMENT'
            AND site = :Site
            AND resource_parent_seq IN (SELECT r.resource_seq
                                        FROM maint_resources_lov6 r
                                        WHERE used_in_maintenance = 'TRUE')
            AND resource_parent_seq IN (SELECT r.resource_seq
                                        FROM Resource_Pub r, Resource_Parent p
                                        WHERE r.resource_seq = p.resource_parent_seq
                                        AND r.resource_type_db = 'EQUIPMENT_GROUP'
                                        START WITH p.resource_parent_seq = :ResourceGroupSeq
                                        CONNECT BY PRIOR p.resource_seq = p.resource_parent_seq)";
}
