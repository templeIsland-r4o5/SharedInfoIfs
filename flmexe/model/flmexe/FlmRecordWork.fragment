-----------------------------------------------------------------------------
fragment FlmRecordWork;
component FLMEXE;
layer Core;
description "This contains all the resources required for Record Work assistant";

--------------------------------- FRAGMENTS ---------------------------------
include fragment FlmResourceToolEquipCommonObjects;
include fragment ResourceGroupMaintLovSelector;
@DynamicComponentDependency TOOLEQ
include fragment ResourceToolEquipJoinLovSelector;
include fragment PartCatalogLovSelector;
include fragment FndEsignature;
include fragment InventoryServiceManager;
include fragment FlmTaskAssignments;
include fragment FlmFaultDeferral;
include fragment TaskServiceManager;
include fragment FlmTaskTool;

----------------------------- CLIENT FRAGMENTS ------------------------------

-------------------------------- ASSISTANTS ---------------------------------
assistant RecordWorkAssistant using RecordWorkVirtualSet {
   label = "Task Card";
   savemode = OnLostFocus;
   input this;

   setup SetDefaultValues {
      variable DefTaskCardOption Text;
      variable DefFaultId Number;
      variable DefAircraftId Number;
      variable DefAircraftWpId Number;
      variable DefAction Text;
      variable DefTaskSeq Number;
      variable DefActualHours Text;
      variable DefStartTime Timestamp;
      variable DefEndTime Timestamp;
      variable DefSource Text;
      variable DefAssignmentStatus Text;
      variable DefExecutionInstanceSeq Number;
      variable DefKeyRef Text;
      variable DefLuName Text;
      variable DefObjstate Text;
      variable DefClassCode Text;
      variable DefSubclassCode Text;

      execute {
         set TaskCardOption = DefTaskCardOption;
         set FaultId = DefFaultId;
         set AircraftId = DefAircraftId;
         set AircraftWpId = DefAircraftWpId;
         set LatestAction = DefAction;
         set TaskSeq = DefTaskSeq;
         set CloseFaultAssignActualHours = DefActualHours;
         set CloseFaultAssignStartTime = DefStartTime;
         set CloseFaultAssignStopTime = DefEndTime;
         set Source = DefSource;
         set AssignmentStatus = DefAssignmentStatus;
         set ExecutionInstanceSeq = DefExecutionInstanceSeq;
         set KeyRef = DefKeyRef;
         set LuName = DefLuName;
         set Objstate = DefObjstate;
         set ClassCode = DefClassCode;
         set SubclassCode = DefSubclassCode;
      }
   }

   init command {
      execute {
         call GetCurrentUser() into LoginUser;
         call GetESigPermission(LoginUser) into ESigPermission;
         call GetEsigFileName(AircraftId, TaskSeq, FaultId) into FileName;
         call GetSite(TaskSeq) into Site;
      }
   }
   singlestep {
      group TaskDetails;
      group FaultGroup;
      list TaskActionList(TaskActionsArray);
      list RemovePartList(RemovedPartsArray) {
         visible = [RemovedPartEnable];
      }
      list InstallPartList(InstalledPartsArray) {
         visible = [InstallededPartEnable];
      }
      list ToolDemandList(ToolDemandsArray) {
         visible = [ResourceToolEnable];
      }
      list MeasurmentList(MeasurementsArray) {
         visible = [MeasurementEnable];
      }
      repeatingsection StepSection(Steps);
      repeatingsection PanelSection(Panels);
      list TaskCertifyList(TaskCertifyArray);
   }
   command RecordActionTakenCommand;
   command JobStopCommand;
   command SignCommand;
   command FinishCommand;
}
assistant RecordActionTaken using TaskActionLineVirtualSet {
   label = "Record Action";
   savemode = OnLostFocus;
   input this;
   output(ActionDesc, CertifyWorkPerformed);
   singlestep {
      group RecordActionGroup;
   }
   command SaveAction;
   command Cancel;
}
assistant JobStop using TaskActionLineVirtualSet {
   label = "Job Stop";
   savemode = OnLostFocus;
   input this;
   output(ActionDesc, CertifyWorkPerformed);
   singlestep {

      group JobStop;
      group RecordActionGroup;
   }
   command SaveAction;
   command Cancel;
}
assistant RecordStepAction using TaskActionLineVirtualSet {
   label = "Record Step Note";
   savemode = OnLostFocus;
   output(ActionDesc);
   singlestep {
      group RecordStepActionGroup;
   }
   command SaveAction;
   command Cancel;
}
assistant RecordRemovedPartAssistant using RemovedPartLineVirtualSet {
   label = "Record Removed Part";
   savemode = OnLostFocus;
   input this;
   output(RemovalSerialNo, RemovalBatchNo, RemovedQuantity, RemovalReasonCode, RemovedUser, RemovalPartNoId);
   singlestep {
      group RecordRemovedPartGrup;
   }
   command RemovedSign {
      label = "Save";
   }
   command Cancel;
}

assistant EditRemovedPartAssistant using RemovedPartLineVirtualSet {
   label = "Edit Removed Part";
   savemode = OnLostFocus;
   input this;
   output(RemovalSerialNo, RemovedQuantity, RemovalReasonCode, RemovalPartNoId, RemovalBatchNo, RemovalEditReason, ConfigSlotPositionId);
   singlestep {
      group EditRemovedPartGroup;
   }
   command EditRemovedSign {
      label = "Save";
   }
   command Cancel;
}

assistant RevokeRemovePartSignOffAssistant using RemovedPartLineVirtualSet {
   label = "Revoke Sign-Off for Removed Part";
   savemode = OnLostFocus;
   input(PartNumberRmvdRef, RemovalSerialNo, PartGroup, AssyPos, RemovedQuantity, RemovalReasonCode, RemovedDate, RemovedUser);
   output(RevokeSignOffReason);

   singlestep {
      group RevokeRemovedPartGroup;
   }

   command Ok {
      label = "Save";
      enabled = [RevokeSignOffReason != null];
   }
   command Cancel;
}

assistant RevokeInstallPartSignOffAssistant using InstalledPartLineVirtualSet {
   label = "Revoke Sign-Off for Installed Part";
   savemode = OnLostFocus;
   input(PartNumberInstRef, InstalledSerialNo, PartGroup, AssyPos, InstalledQuantity, InstalledDate, InstalledUser);
   output(RevokeSignOffReason);

   singlestep {
      group RevokeInstallPartGroup;
   }

   command Ok {
      label = "Save";
      enabled = [RevokeSignOffReason != null];
   }
   command Cancel;
}

assistant RecordInstallAssistant using InstalledPartLineVirtualSet {
   label = "Record Installed Part";
   savemode = OnLostFocus;
   input this;
   output(InstalledSerialNo, InstalledBatchNo, InstalledQuantity, InstalledUser, InstalledPartNoId, InventoryClassCode, RemovalSerialNo, RemovalBatchNo, RemovalPartAltId);
   singlestep {
      group RecordInstallPartGroup;
   }
   command InstalledSign {
      label = "Save";
   }
   command Cancel;
}

assistant EditInstallPartAssistant using InstalledPartLineVirtualSet {
   label = "Edit Installed Part";
   savemode = OnLostFocus;
   input this;
   output(InstalledSerialNo, InstalledQuantity, InstalledPartNoId, InstalledBatchNo, InstalledEditReason, ConfigSlotPositionId);
   singlestep {
      group EditInstalledPartGroup;
   }
   command EditInstalledSign {
      label = "Save";
   }
   command Cancel;
}

assistant EditActionTaken using TaskActionLineVirtualSet {
   label = "Record Action Taken";
   savemode = OnLostFocus;
   input(ActionDesc);
   output(ActionDesc, ActionDate);
   init command {
      execute {
         set InitialActionDesc = ActionDesc;
      }
   }
   singlestep {
      group RecordEditActionGroup;
   }
   command SaveAction;
   command Cancel;
}
assistant CompleteTaskAssitant using TaskCertifyVirtualSet {
   label = "Final Sign-Off";
   savemode = OnLostFocus;
   input(SignOffReqType);
   output(ApprovalNumber, CompletionNote);
   singlestep {
      group RecordTaskCompletion;
   }
   command Ok {
      label = "Save";
   }
   command Cancel;
}
assistant RecordSignOff using TaskStepSignOffVirtualSet {
   label = "Step Action";
   savemode = OnLostFocus;
   input(SignOffNote);
   output(SignOffNote);
   singlestep {
      group RecordSignOffGroup;
   }
   command Ok {
      label = "Save";
   }
   command Cancel;
}


assistant RevokeStepSignOffAssistant using TaskStepSignOffVirtualSet {
   label = "Revoke Sign-Off for Step ${OrderNo}";
   savemode = OnLostFocus;
   input(Role, LicenseId, SignOffDate, Identity, SignOffNote, OrderNo);
   output(RevokeSignOffReason);
   singlestep {
      group RevokeStepSignOffGroup;
   }
   command Ok {
      label = "Save";
      enabled = [RevokeSignOffReason != null];
   }
   command Cancel;
}

assistant RecordToolAssistant using ToolResourceDemandVirtualSet {
   label = "Record Tool";
   savemode = OnLostFocus;
   input this;
   output(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq);
   singlestep {
      group RecordToolDemandGroup;
   }
   command SignedToolResource;
   command Cancel;
}

assistant EditToolAssistant using ToolResourceDemandVirtualSet {
   label = "Edit Tool";
   savemode = OnLostFocus;
   input this;
   output(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq);

   singlestep {
      group EditToolDemandGroup;
   }

   command Ok {
      label = "Save";
      visible = [ResourceParentId != null and ResourceSeq != null and CheckedOutDate != null and ActualHours != null and ActualEndDate != null and SerialNo != null];
      variable IsCheckedOutTool Boolean;
      execute {
         call IsToolCheckedOut(ResourceSeq) into IsCheckedOutTool;
         if [IsCheckedOutTool = false] {
            error("Assigned tool is not checked out.");
         }
         else {
            exit OK;
         }
      }
   }
   command Cancel;
}

assistant EditAuthorizedToolAssistant using ToolResourceDemandVirtualSet {
   label = "Edit Tool";
   savemode = OnLostFocus;
   input this;
   output(CheckedOutDate, ActualHours, ActualEndDate, ToolPartId, ToolPartDescription, ResourceSeq, SerialNo, ResourceParentId, ResourceGroupSeq, ReasonToEdit);

   singlestep {
      group EditAuthorizedToolDemandGroup;
   }
   command Ok {
      label = "Save";
      enabled = [ReasonToEdit != null and ActualHours != null and SerialNo != null and ResourceSeq != null];
   }
   command Cancel;
}
---------------------------------- GROUPS -----------------------------------
group TaskDetails for RecordWorkVirtual {
   visible = [FaultId = null];
   label = "Task Details";

   field AvExeTaskRef.TaskCode {
      label = "Task Code";
      visible = [AvExeTaskRef.TaskCode != null];
   }
   field AircraftRef.AircraftMob {
      label = "Aircraft";
   }
   field AvExeTaskRef.ConfigPosition {
      label = "Config Position";
   }
   field AvExeTaskRef.Description {
      label = "Name";
      size = FullWidth;
      multiline = true;
   }
   badge Sensitivities {
      label = "Sensitivities";
      emphasis Warning = [true];
      visible = [Sensitivities != null];
      editable = [false];
   }
   field AvExeTaskRef.ClassCode {
      label = "Class";
   }

   field AvExeTaskRef.SubclassCode {
      label = "Subclass";
   }
   field AvAircraftWpRef.WoNumber {
      label = "WO #";
   }
   field AvAircraftWpRef.LocationCode {
      label = "Maintenance Location";
   }
   field AvAircraftWpRef.SchedStartDateTimeUtc {
      label = "Scheduled Start Date";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
   }
}
group FaultGroup for RecordWorkVirtual {
   visible = [FaultId != null];
   label = "Fault Details";

   field AircraftRef.AircraftMob {
      label = "Aircraft";
   }
   field FaultQueryRef.SubSystemCode {
      label = "System";
   }
   field AvFaultRef.LogbookReference {
      label = "Logbook Reference";
   }
   field AvFaultRef.Description {
      label = "Name";
      size = FullWidth;
      multiline = true;
   }
   badge Sensitivities {
      label = "Sensitivities";
      emphasis Warning = [true];
      visible = [Sensitivities != null];
      editable = [false];
   }
   badge AvExeTaskRef.Objstate {
      label = "Status";
      editable = [false];

      emphasis Primary = [Objstate = "RELEASED"];
      emphasis Complementary7 = [Objstate = "WORKSTARTED"];
      emphasis True = [Objstate = "FINISHED"];
      emphasis Neutral = [Objstate = "REMOVED"];
      size = Medium;
      signaturemappingattribute = OBJSTATE;
   }
   field AvFaultRef.FoundOnDate {
      label = "Found on Date";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
   }
   field AvFaultRef.FoundOnDesc {
      label = "Found on Task";
      visible = [AvFaultRef.FoundOnType = "TASK"];
   }
   field AvFaultRef.FoundOnDesc {
      label = "Found on Flight";
      visible = [AvFaultRef.FoundOnType = "FLIGHT"];
   }
   field AvAircraftWpRef.WoNumber {
      label = "WO #";
   }
   field AvAircraftWpRef.LocationCode {
      label = "Maintenance Location";
   }
   field AvAircraftWpRef.ActualStartDateTime {
      label = "Work Package Start Date";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
   }
}
group RecordToolGroup for RecordToolStructure {
   field PartNumberRef.PartName;
   field PartNumberRef.PartNumber;
   field SerialNo;
   field ActualDuration {
      label = "Actual Hours (HH:MM)";
      format = decimal;
      required = [true];
   }
}

group RecordResourceToolGroup for RecordResourceToolStructure {
   lov ResourceGroupIdRef with ReferenceResourceGroupMaintLovSelector {
      description = ResourceGroupIdRef.Description;
      preview = ResourceGroupMaintLovCard;
   }
   @DynamicComponentDependency TOOLEQ
   lov ResourceIdRef with ReferenceResourceToolEquipJoinLovSelector using GetResources(ResourceGroupSeq) {
      description = ResourceIdRef.Description;
      search = ResourceId, Description;
      validate command {
         variable PartSerialVar Structure(PartSerialStructure);

         execute {
            if [ResourceId != null] {
               call GetPartSerial(ResourceSeq) into PartSerialVar;
               copy PartSerialVar into this;
            }
            else {
               set ResourceSeq = null;
               set PartNo = null;
               set SerialNo = null;
            }
         }
      }
   }
   @DynamicComponentDependency TOOLEQ
   lov PartCatalogRef with ReferencePartCatalogLovSelector using GetToolEquipGroupParts(ResourceGroupSeq) {
      description = PartCatalogRef.Description;
      search = PartNo, Description;
      validate command {
         execute {
            if [SerialNo != null] {
               set SerialNo = null;
            }
            if [ResourceId != null] {
               set ResourceId = null;
               set ResourceSeq = null;
            }
         }
      }
   }
   @DynamicComponentDependency TOOLEQ
   lov PartSerialCatalogRef with PartSerialCatalogSelector using GetToolEquipGroupSerials(ResourceGroupSeq) {
      editable = [ResourceSeq = null];
      validate command {
         execute {
            if [PartNo != null and SerialNo != null] {
               call GetResourceId(PartNo, SerialNo) into ResourceId;
            }
            else {
               set ResourceId = null;
               set ResourceSeq = null;
            }
         }
      }
   }
   field ActualDuration {
      format = decimal;
   }
}

group RecordMeasurementGroup for RecordMeasurementStructure {
   field MeasurementTypeCode {
      editable = [false];
   }
   lov MeasurementValueRef with ReferenceAvMeasurementValueSelector {
      label = "Value";
      visible = [MeasurementCategory = "CH"];
   }
   field MeasurementQty {
      label = "Value";
      visible = [MeasurementCategory = "ME"];
   }
   field MeasurementDateTime {
      label = "Value";
      visible = [MeasurementCategory = "CME"];
   }
   field MeasurementText {
      label = "Value";
      visible = [MeasurementCategory = "TEXT"];
   }
   field MeasurementBoolean {
      label = "Value";
      visible = [MeasurementCategory = "CHK"];
      required = [MeasurementCategory = "CHK"];
   }
   field ReasonToEdit {
      label = "Reason for Editing Measurement";
      visible = [DbMeasuredUser != null and TaskControlAuthorityEnabled = "Yes"];
      required = [true];
