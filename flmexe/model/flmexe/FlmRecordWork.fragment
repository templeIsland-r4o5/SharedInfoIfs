dialog RecordResourceToolDialog for RecordResourceToolStructure {
   label = "Record Tool Used";
   input(ResourceGroupId, ResourceId, ResourceGroupSeq, ResourceSeq, PartNo, SerialNo);
   output(ResourceId, ResourceSeq, PartNo, SerialNo, ActualDuration);

   group RecordResourceToolGroup;
   command Ok {
      label = "Save";
      enabled = [((ResourceId != null) or(PartNo != null and SerialNo != null)) and ActualDuration != null];
   }
   command Cancel;
}

dialog RecordMeasurementDialog for RecordMeasurementStructure {
   label = "Record Measurement";
   input(MeasurementId, MeasurementTypeCode, MeasTypeValueCode, MeasurementQty, MeasurementDateTime, MeasurementText, MeasurementBoolean, MeasurementCategory);
   output(MeasTypeValueCode, MeasurementQty, MeasurementDateTime, MeasurementText, MeasurementBoolean);

   group RecordMeasurementGroup;
   command Ok {
      label = "Save";
      enabled = [MeasTypeValueCode != null or MeasurementQty != null or MeasurementDateTime != null or MeasurementText != null or MeasurementBoolean != null];
   }
   command Cancel;
}

assistant RevokeMeasurementSignOffAssistant using MeasurementLineVirtualSet {
   label = "Revoke Sign-Off for Measurement";
   savemode = OnLostFocus;
   input(MeasurementId, MeasurementTypeCode, MeasurementValue, MeasTypeValueCode, MeasurementCategory, MeasuredUser, MeasuredDate, RevokeSignOffReason);
   output(RevokeSignOffReason);

   singlestep {
      group RevokeMeasurementSignOffGroup;
   }

   command Ok {
      label = "Save";
      enabled = [RevokeSignOffReason != null];
   }
   command Cancel;
}

dialog EditMeasurementDialog for RecordMeasurementStructure {
   label = "Edit Measurement";
   input(MeasurementId, MeasurementTypeCode, MeasTypeValueCode, MeasurementQty, MeasurementDateTime, MeasurementText, MeasurementBoolean, MeasurementCategory, DbMeasuredUser, TaskControlAuthorityEnabled);
   output(MeasTypeValueCode, MeasurementQty, MeasurementDateTime, MeasurementText, MeasurementBoolean, ReasonToEdit);
   group RecordMeasurementGroup;

   command Ok {
      label = "Save";
      enabled = [(DbMeasuredUser = null and(MeasTypeValueCode != null or MeasurementQty != null or MeasurementDateTime != null or MeasurementText != null or MeasurementBoolean != null)) or(DbMeasuredUser != null and TaskControlAuthorityEnabled = "Yes" and(MeasTypeValueCode != null or MeasurementQty != null or MeasurementDateTime != null or MeasurementText != null or MeasurementBoolean != null) and ReasonToEdit != null)];
   }
   command Cancel;
}

dialog EditActionDialog for RecordActionInfoStructure {
   label = "Edit Action";
   input(TaskActionId, ActionDesc, DbActionUser, TaskControlAuthorityEnabled);
   output(ActionDesc, ReasonToEdit);

   group EditActionGroup;

   command Ok {
      label = "Save";
      enabled = [(DbActionUser = null and ActionDesc != null) or(DbActionUser != null and TaskControlAuthorityEnabled = "Yes" and ActionDesc != null and ReasonToEdit != null)];
   }
   command Cancel;
}

dialog EditTaskCertificationDialog for TaskCertificationInfoStruct {
   label = "Edit Final Sign-Off";

   input(CompletionNote, ApprovalNumber, SignOffReqType);
   output(CompletionNote, ApprovalNumber);

   group RecordTaskCompletion;

   command Ok {
      label = "Save";
      enabled = [CompletionNote != null];
   }
   command Cancel;

}

dialog EditStepSignOffDialog for StepSignOffInfoStruct {
   label = "Edit Step${OrderNo}";

   input(TaskStepSeq, SignOffNote, OrderNo, Role, LicenseId);
   output(SignOffNote);

   group EditStepSignOffGroup;

   command Ok {
      label = "Save";
      enabled = [SignOffNote != null];
   }
   command Cancel;

}

dialog EditPanelSignOffDialog for StepSignOffInfoStruct {
   label = "Edit Panel ${PanelCd}";

   input(TaskStepSeq, SignOffNote, OrderNo, Role, LicenseId, PanelCd);
   output(SignOffNote);

   group EditStepSignOffGroup;

   command Ok {
      label = "Save";
      enabled = [SignOffNote != null];
   }
   command Cancel;

}

