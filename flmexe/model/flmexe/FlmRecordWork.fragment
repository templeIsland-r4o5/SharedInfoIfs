      editable = [false];
   }
   badge SignOffStatus {
      label = "SignOff Status";
      style = TextOnly;
      size = Small;
      editable = [false];

      emphasis Warning = [SignOffStatus = "Pending"];
      emphasis OK = [SignOffStatus = "Signed"];
   }
   field LicenseId {
      label = "Certificate ID";
      size = Small;
      editable = [false];
   }
   field SignOffNote {
      label = "Sign-Off Note";
      size = Large;
      editable = [SignOffStatus = "Signed" and SignedFlag = true and parent.IsActionRecorded != true];
      multiline = true;
   }
   field SignOffDate {
      label = "Date";
      type = Date;
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      size = Medium;
      editable = [false];
   }
   field Identity {
      label = "Signed-By";
      size = Small;
      editable = [false];
   }

   conditionalformat {
      when [Identity != null] {
         backgroundformat {
            emphasis Validityhidden = [true];
         }
      }
   }

   command SignStepSignOffCommand;
   command EditStepSignOffCommand;
   command RevokeStepSignOffCommand;
}

