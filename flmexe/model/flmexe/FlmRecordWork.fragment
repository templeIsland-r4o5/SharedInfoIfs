------------------------------- ENUMERATIONS --------------------------------
enumeration TaskStepEnum {
   value = "NOTDONE" {
      label = "Not Done";
   }
   value = "PENDING" {
      label = "Pending";
   }
   value = "DONE" {
      label = "Done";
   }
   value = "CANCELLED" {
      label = "Cancelled";
   }
}

enumeration SignOffReqTypeEnum {
   value = "Inspector" {
      identifier = "Inspector";
      label = "Certifying Staff";
   }
   value = "Independent" {
      identifier = "Independent";
      label = "Independent Inspector (RII)";
   }
}
---------------------------------- ACTIONS ----------------------------------
action RecordWorkClearAction {
   initialcheck none;
   --ludependencies = AvExeTask, AvFaultDeferralRequest, AvFault;
}
action RecordTool {
   initialcheck none;
   ludependencies = RecordWorkVirtual;
   parameter Objkey Text;
   parameter SerialNo Text;
   parameter ActualDuration Text;
}
action RecordMeasurement {
   initialcheck none;
   ludependencies = RecordWorkVirtual, MeasurementLineVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
   parameter MeasurementTypeCode Text;
   parameter MeasTypeValueCode Text;
   parameter MeasurementQty Number;
   parameter MeasurementDateTime Timestamp;
   parameter MeasurementText Text;
   parameter MeasurementBoolean Boolean;
   parameter MeasurementCategory Text;
   parameter ReasonToEdit Text;
}
action RevokeMeasurement {
   initialcheck none;
   ludependencies = RecordWorkVirtual, MeasurementLineVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
   parameter RevokeSignOffReason Text;
}

action RevokeToolDemand {
   initialcheck none;
   ludependencies = RecordWorkVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
}

action RevokeInstalledPart {
   initialcheck none;
   ludependencies = RecordWorkVirtual, InstalledPartLineVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
   parameter RevokeSignOffReason Text;
}

action RevokeRemovedPart {
   initialcheck none;
   ludependencies = RecordWorkVirtual, RemovedPartLineVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
   parameter RevokeSignOffReason Text;
}

action RevokeTaskCertification {
   initialcheck none;
   ludependencies = TaskCertifyVirtual, AvExeTask, AvFault, RecordWorkVirtual;
   timestamptzref = "server";
   parameter Objkey Text;
}

action UpdateInstallPart {
   initialcheck none;
   ludependencies = RecordWorkVirtual, InstalledPartLineVirtual;
   parameter Objkey Text;
   parameter InstalledSerialNo Text;
   parameter InstalledBatchNo Text;
   parameter InstalledQuantity Number;
   parameter InstalledPartNoId Number;
}
action UpdateRmvPart {
   initialcheck none;
   ludependencies = RecordWorkVirtual, RemovedPartLineVirtual;
   parameter Objkey            Text;
   parameter RemovedSerialNo   Text;
   parameter RemovedBatchNo    Text;
   parameter RemovedQuantity   Number;
   parameter RemovalReasonCode Text;
   parameter RemovedPartNoId   Number;
}
action AddAction {
   initialcheck none;
   ludependencies = RecordWorkVirtual, TaskActionLineVirtual, RemovedPartLineVirtual, InstalledPartLineVirtual, MeasurementLineVirtual, ResourceToolLineVirtual, ToolLineVirtual;

   parameter ParentObjkey Text;
   parameter ActionDesc Text;
   parameter TaskSeq Number;
   parameter CertifyWorkPerformed Boolean;
}
action DoJobStopTemporary {
   initialcheck none;
   ludependencies = RecordWorkVirtual;
   parameter ParentObjkey Text;
   parameter ActualHours Text;
   parameter IncompletionCause Text;
   parameter JobstopNote Text;
   parameter RemainingHours Text;
   parameter AssignToMeNewTaskRes Boolean;
}
action CompleteTask {
   initialcheck none;
   ludependencies = TaskCertifyVirtual, AvExeTask, AvFault, RecordWorkVirtual;

   parameter Objkey Text;
   parameter ApprovalNumber Text;
   parameter CompletionNote Text;
   parameter TaskSeq Number;
}
action Sign {
   initialcheck none;
   timestamptzref = "site(Site)";
   ludependencies = AvExeTask, AvExeTaskTool, AvExeTaskAction, AvResourceToolEquipment, AvExeTaskMeasurement, AvInstalledParts, AvRemovedParts, AvAircraftWorkPackage, JtTaskTransaction, JtTaskResource, JtExecutionInstance,
   JtTaskResourceDemandQuery, JtTaskLaborSummaryTotal, JtTaskLaborSummaryBreakdown, JtTaskSignOffReq, JtTaskStepSignOff, AvCriticalItem, JtTaskReturn, JtTaskStep, AvExeTaskPanel, MaintMaterialReqLine, ToolDemandQuery, AvExeTaskZone;

   parameter Objkey Text;
   parameter TaskSeq Number;
   parameter BindSignatureId Text;
   parameter RecordWorkStartTime Timestamp;
   parameter Site Text;
}

action CheckPartIsAllowed {
   initialcheck none;
   parameter TaskSeq Number;
   parameter InstalledPartNoId Number;
   parameter PartGroupId Number;
   parameter ConfigSlotPositionId Number;
}

action CheckPartIncompatibility {
   initialcheck none;
   parameter TaskSeq Number;
   parameter InstalledPartNoId Number;
   parameter PartGroupId Number;
}

action UpdateClockOut {
   initialcheck none;
   timestamptzref = "site(Site)";

   parameter ParentObjkey Text;
   parameter StartTime Timestamp;
   parameter EndTime Timestamp;
   parameter ActualHours Text;
   parameter Site Text;

}

action StartAssignment {
   initialcheck none;
   timestamptzref = "site(Site)";
   ludependencies = AvExeTask, JtTaskResource, JtExecutionInstance, JtTaskResourceDemandQuery;
   parameter TaskSeq Number;
   parameter ExecutionInstanceSeq Number;
   parameter StartTime Timestamp;
   parameter Site Text;
}

action ValidateSignOff {
   initialcheck none;
   ludependencies = RecordWorkVirtual, StepVirtual, TaskStepSignOffVirtual;

   parameter TaskSeq Number;
   parameter Objkey Text;
}

action UpdateStepSignOff {
   initialcheck none;
   ludependencies = RecordWorkVirtual, StepVirtual, TaskStepSignOffVirtual;

   parameter Objkey Text;
   parameter SignOffNote Text;
}

action RevokeStepSignOff {
   initialcheck none;
   ludependencies = RecordWorkVirtual, StepVirtual, TaskStepSignOffVirtual;
   parameter Objkey Text;
   parameter RevokeSignOffReason Text;
}

action ValidateBulkSignOff {
   initialcheck none;
   parameter TaskSeq Number;
   parameter LicenseId Text;
   parameter Role Text;
}

action CheckStepSigned {
   initialcheck none;
   parameter Role Text;
   parameter TaskSeq Number;
   parameter TaskStepSeq Number;
   parameter SignOffReqSeq Number;
   parameter LicenseId Text;
   parameter ObjConnLuNameDb Text;
}

action CheckInspectorSignOff {
   initialcheck none;
   parameter Role Text;
   parameter TaskSeq Number;
   parameter TaskStepSeq Number;
   parameter SignOffReqSeq Number;
   parameter LicenseId Text;
   parameter ObjConnLuNameDb Text;
}

action UpdateRecordWorkVirtual {
   initialcheck none;
   parameter Objkey Text;
   parameter TaskSeq Number;
   parameter TaskResourceSeq Number;
   parameter ExecutionInstanceSeq Number;
}

action IsSkillMandatory {
   initialcheck none;
   parameter Objkey Text;
   parameter TaskResourceSeq Number;
}

action UpdateRevokeStepSignOffCapability {
   initialcheck none;
   parameter Objkey Text;
   parameter UpdateType Text;
}
action EditActionSave {
   initialcheck none;
   ludependencies = RecordWorkVirtual, TaskActionLineVirtual;
   parameter Objkey Text;
   parameter ActionDesc Text;
   parameter ReasonToEdit Text;
}
action EditTaskCertification {
   initialcheck none;
