   attribute SchedulingAction Enumeration(SchedulingActionType);

   reference PartGroupRef(PartGroupId) to AvPartGroup(PartGroupId);
   reference PartNumberInstRef(InstalledPartNoId) to AvPartNumber(PartNumberId);
   reference ConfigSlotPositionRef(ConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AssemblyConfigSlotPositionRef(AssemblyConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference InstalledSerialRef(InstalledSerialNo) to PartSerialCatalog(SerialNo);
   reference InstalledBatchRef(InstalledBatchNo) to LotBatchMaster(LotBatchNo);
   reference MaintMaterialReqRef(MaintMaterialOrderNo, LineItemNo) to MaintMaterialReqLine(MaintMaterialOrderNo, LineItemNo);
}
virtual RemovedPartLineVirtual {
   ludependencies = RecordWorkVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute TaskPartId Number;
