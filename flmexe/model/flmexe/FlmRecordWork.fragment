------------------------------- ENUMERATIONS --------------------------------
@Override
enumeration SignOffReqType {
   value = "Executor" {
      identifier = "Executor";
      label = "Executor";
   }
   value = "Inspector" {
      identifier = "Inspector";
      label = "Certifier";
   }
   value = "Independent" {
      identifier = "Independent";
      label = "Inspector";
   }
}
