--------------------------- PROJECTION FRAGMENTS ----------------------------
------------------------------ ENTITY DETAILS -------------------------------
entityset RecordWorkVirtualSet for RecordWorkVirtual;
entityset StepSet for StepVirtual;
entityset RemovedPartLineVirtualSet for RemovedPartLineVirtual;
entityset InstalledPartLineVirtualSet for InstalledPartLineVirtual;
entityset TaskActionLineVirtualSet for TaskActionLineVirtual;
entityset TaskCertifyVirtualSet for TaskCertifyVirtual;
entityset TaskStepSignOffVirtualSet for TaskStepSignOffVirtual;
entityset MeasurementLineVirtualSet for MeasurementLineVirtual;
entityset PanelSet for PanelVirtual;
entityset ToolResourceDemandVirtualSet for ToolResourceDemandVirtual;

---------------------------------- QUERIES ----------------------------------

query MaintResources {
   from = "MAINT_RESOURCES_LOV6";
   keys = ResourceId, ResourceParentId, Company, Site;
   ludependencies = ToolResourceDemandVirtual;
   lu = none;
   attribute ResourceId Text {
      label = "Resource ID";
      format = uppercase;
      lovcolumn = [true];
   }
   attribute Description Text {
      lovcolumn = [true];
   }
   attribute ResourceParentId Text {
      label = "Resource Parent ID";
      lovcolumn = [true];
   }
   attribute ResourceParentDesc Text {
      label = "Description";
   }
   attribute ResourceType Enumeration(ResourceTypes);
   attribute Company Text;
   attribute Site Text;
   attribute ResourceSeq Number;
   attribute ResourceParentSeq Number;
   attribute SerialNo Text {
      fetch = "Resource_Tool_Equip_API.Get_Serial_No(resource_seq)";
      lovcolumn = [true];
   }
}

--------------------------------- VIRTUALS ----------------------------------
virtual RecordWorkVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute StepEnable Boolean;
   attribute RemovedPartEnable Boolean;
   attribute InstallededPartEnable Boolean;
   attribute ToolEnable Boolean;
   attribute ResourceToolEnable Boolean;
   attribute MeasurementEnable Boolean;
   attribute ActionTakenMandatory Boolean;
   attribute Objstate Text;
   attribute TaskSeq Number;
   attribute FaultId Number;
   attribute AircraftWpId Number;
   attribute FlightId Number;
   attribute TaskObjState Text;
   attribute SignedBy Text;
   attribute AircraftId Number;
   attribute ActEndDate Date;
   attribute TaskStepId Number;
   attribute StepOrd Number;
   attribute StepDescription LongText;
   attribute StepNote Text;
   attribute StepSet Text;
   attribute PanelSet Text;
   attribute LatestAction Text;
   attribute StateChangeFlag Boolean;
   attribute StateFlag Boolean;
   attribute StepStatus Enumeration(TaskStepEnum);
   attribute TaskPartId Number;
   attribute PartGroupId Number;
   attribute PartGroupCode Text;
   attribute PartGroupName Text;
   attribute Position Text;
   attribute RemovedPartNoId Number;
   attribute InstalledPartNoId Number;
   attribute RemovedPartNo Text;
   attribute InstalledPartNo Text;
   attribute RemovedSerialNo Text;
   attribute RemovedBatchNo Text;
   attribute RemovedQuantity Number;
   attribute InstalledSerialNo Text;
   attribute InstalledBatchNo Text;
   attribute InstalledQuantity Number;
   attribute RemovalReason Text;
   attribute RemovalStates Text;
   attribute InstallStates Text;
   attribute RemovedUser Text;
   attribute InstalledUser Text;
   attribute RemovalReasonCode Text;
   attribute RemovalReasonDesc Text;
   attribute ConfigSlotPositionCode Text;
   attribute ConfigSlotPositionId Number;
   attribute IpcReference Text;
   attribute RemovedDate Date;
   attribute InstalledDate Date;
   attribute PartRequestId Number;
   attribute SignedUser Text;
   attribute CurrentUser Text;
   attribute RemovedQuantityTemp Number;
   attribute InstalledQuantityTemp Number;
   attribute SignForRemoval Boolean("TRUE", "FALSE") {
      required = [true];
   }
   attribute SignForTool Boolean("TRUE", "FALSE") {
      required = [true];
   }
   attribute InstalledSerialNoTemp Text;
   attribute PartNoId Number;
   attribute SerialNo Text;
   attribute TaskToolId Number;
   attribute ToolSpecificationCode Text;
   attribute ToolStatus Text;
   attribute ActualDuration Number;
   attribute SignForInstall Boolean("TRUE", "FALSE") {
      required = [true];
   }
   attribute AssignedUser Text;
   attribute MeasurementTypeCode Text;
   attribute MeasurementQty Text;
   attribute MeasurementId Number;
   attribute Inventory Text;
   attribute MeasuredQty Number;
   attribute MeasurementStatus Text;
   attribute MeasuredUser Text;
   attribute SignForMeasurement Boolean("TRUE", "FALSE") {
      required = [true];
   }
   attribute UnitOfMeasurement Text;
   attribute SignEnable Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute CompleteTaskEnable Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute TaskCertificationEnable Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute LoginUser Text;
   attribute ESigPermission Text;
   attribute FileName Text;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute MediaObject Stream {
      implementation = "Java";
   }
   attribute IsActionRecorded Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute RecordWorkStartTime Timestamp;
   attribute TaskSignOffPermission Text;
   attribute HasPendingNonRoutines Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_API.Pending_NR_Exists(task_seq)";
   }
   attribute TaskResourceSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute AssignmentStatus Text;
   attribute AssignmentStart Timestamp;
   attribute ScheduledHours Text;
   attribute Source Text;
   attribute AssignedUserResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute Remark Text;
   attribute IsJobStopExecuted Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute IncompletionCause Text;
   attribute JobstopNote Text;
   attribute RemainingHours Text;
   attribute ActualHours Text;
   attribute AssignToMeNewTaskRes Boolean("TRUE", "FALSE") {
      default = "FALSE";
      required = [true];
   }
   attribute CertifyWorkPerformed Boolean("TRUE", "FALSE") {
      default = "TRUE";
      required = [true];
   }
   attribute Selection Text;
   attribute TaskCardOption Text;
   attribute CloseFaultAssignStartTime Timestamp;
   attribute CloseFaultAssignStopTime Timestamp;
   attribute CloseFaultAssignActualHours Text;
   attribute Location Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Location_Code(aircraft_wp_id)";
   }
   attribute Site Text;
   attribute ClassCode Text;
   attribute SubclassCode Text;
   attribute TaskReturnLineSeq Number;
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Sens_API.Get_Sensitivities_In_Task_Card(task_seq)";
   }
   attribute IsHeavyMaintenance Boolean;
   attribute HmContractLineNo Number;
   attribute NeedCommercialApproval Boolean;
   attribute ProceedAtRisk Boolean;
   attribute IsNonRoutine Boolean;
   attribute IsExecutionBlockedByCap Boolean;
   attribute ApprovalStatus Text;
   attribute IsEditTaskCardAccess Boolean {
      default = "false";
   }

   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   reference AvFlightRef(FlightId) to AvFlight(FlightId);
   reference AircraftRef(AircraftId) to AircraftLov(AircraftId);
   reference AvAircraftWpRef(AircraftWpId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvFaultRef(FaultId) to AvFault(FaultId);
   reference FaultQueryRef(FaultId) to FaultQuery(FaultId);
   array Steps() to StepVirtual();
   array ToolsArray() to ToolLineVirtual();
   array ResourceToolsArray() to ResourceToolLineVirtual();
   array TaskActionsArray() to TaskActionLineVirtual();
   array RemovedPartsArray() to RemovedPartLineVirtual();
   array InstalledPartsArray() to InstalledPartLineVirtual();
   array MeasurementsArray() to MeasurementLineVirtual();
   array TaskCertifyArray(KeyList) to TaskCertifyVirtual();
   array Panels() to PanelVirtual();
   array ToolDemandsArray() to ToolResourceDemandVirtual();
}

virtual StepVirtual {
   ludependencies = RecordWorkVirtual, TaskActionLineVirtual;
   attribute TaskSeq Number;
   attribute TaskStepId Number;
   attribute StepOrd Number;
   attribute Objstate Text;
   attribute StepNote Text;
   attribute StepSet Text;
   attribute LatestAction Text;
   attribute SignedBy Text;
   attribute StateChangeFlag Boolean;
   attribute StateFlag Boolean;
   attribute StepStatus Enumeration(TaskStepEnum);
   attribute MeasurementVisible Boolean;
   attribute SkillsVisible Boolean;
   attribute IsRejected Text;
   attribute LatestSignedBy Text;
   attribute TaskResourceSeq Number;
   attribute Selection Text;
   attribute Instructions LongText;

   array StepSignOff() to TaskStepSignOffVirtual();
}

virtual PanelVirtual {
   ludependencies = RecordWorkVirtual;
   attribute PanelCode Text;
   attribute PanelDescription Text;
   attribute PanelInstruction Text;
   attribute PanelSet Text;
   attribute TaskSeq Number;
   attribute TaskStepId Number;
   attribute TaskResourceSeq Number;
   attribute Selection Text;
   attribute StepStatus Enumeration(TaskStepEnum);

   array PanelSignOff() to TaskStepSignOffVirtual();
}

virtual TaskActionLineVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   ludependencies = RecordWorkVirtual, StepVirtual;
   attribute TaskSeq Number;
   attribute TaskActionId Number;
   attribute TaskStepId Number;
   attribute ActionOrd Number;
   attribute ActionUser Text;
   attribute ActionUserName Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(action_user))";
   }
   attribute ActionDesc Text;
   attribute InitialActionDesc Text;
   attribute ActionDate Timestamp;
   attribute ActionType Text;
   attribute StepCurrStatus Text;
   attribute SignedFlag Boolean;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute ActualHours Text;
   attribute StartTime Timestamp;
   attribute EndTime Timestamp;
   attribute MainVtrObjkey Text;
   attribute AssignmentStatus Text;
   attribute Source Text;

   --attributes specific to job stop
   attribute IsRemHoursEditable Boolean("TRUE", "FALSE") {
      fetch = "Adcom_Util_API.Is_Remaining_Hours_Editable()";
   }
   attribute IsJobStopExecuted Boolean;
   attribute IncompletionCause Text;
   attribute JobstopNote Text;
   attribute RemainingHours Text;
   attribute AssignToMeNewTaskRes Boolean {
      default = "false";
      required = [true];
   }
   attribute CertifyWorkPerformed Boolean("TRUE", "FALSE") {
      default = "TRUE";
      required = [true];
   }
   attribute TaskResourceSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute SkillDemand Text;
   attribute CurrentUser Text {
      fetch = "Fnd_Session_API.Get_Fnd_User()";
   }
   attribute MainVrtUpdate Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute Site Text;
   attribute TaskControlAuthorityEnabled Text {
      fetch = "Adcom_Util_API.Get_User_Task_Ctrl_Auth_Perm(Fnd_Session_API.Get_Fnd_User())";
   }
   attribute ReasonToEdit Text;
   attribute DbActionUser Text {
      fetch = "Av_Exe_Task_Action_API.Get_Action_User(task_action_id)";
   }
   attribute IsEditTaskCardAccess Boolean;

   reference IncompletionCauseRef(IncompletionCause) to JtIncompletionCause(IncompletionCause);
   reference DemandLineRef(TaskSeq, TaskResourceSeq) to TaskAssignmentEntity(TaskSeq, TaskResourceSeq);
}
virtual MeasurementLineVirtual {
   ludependencies = RecordWorkVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute TaskSeq Number;
   attribute MeasurementId Number;
   attribute MeasurementTypeCode Text;
   attribute MeasTypeValueCode Text;
   attribute MeasurementOrder Number;
   attribute MeasurementValue Text;
   attribute MeasurementCategory Text;
   attribute MeasurementQty Number;
   attribute MeasurementDateTime Timestamp;
   attribute MeasurementText Text;
   attribute MeasurementBoolean Boolean;
   attribute MeasuredUser Text;
   attribute MeasuredUserName Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(measured_user))";
   }

   attribute MeasuredDate Timestamp;
   attribute IsTaskDef Boolean;
   attribute SignedFlag Boolean;
   attribute RevokeSignOffReason Text;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute DbMeasuredUser Text {
      fetch = "Av_Exe_Task_Measurement_API.Get_Measured_User(measurement_id)";
   }
   attribute TaskControlAuthorityEnabled Text {
      fetch = "Adcom_Util_API.Get_User_Task_Ctrl_Auth_Perm(Fnd_Session_API.Get_Fnd_User())";
   }
   attribute ReasonToEdit Text;

   reference MeasurementTypeCodeRef(MeasurementTypeCode) to AvMeasurementType(MeasurementTypeCode);
   reference MeasurementValueRef(MeasurementTypeCode, MeasTypeValueCode) to AvMeasurementValue(MeasurementTypeCode, MeasTypeValueCode);
}
virtual ToolLineVirtual {
   crud = Read;
   ludependencies = RecordWorkVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute TaskSeq Number;
   attribute TaskToolId Number;
   attribute ToolSpecificationCode Text;
   attribute PartNoId Number;
   attribute SerialNo Text;
   attribute AssignedUser Text;
   attribute AssignedUserName Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(assigned_user))";
   }
   attribute AssignedDateTiime Timestamp;
   attribute SchedDuration Number;
   attribute ActualDuration Text;
   attribute IsSigned Boolean;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }

   reference ToolSpecificationCodeRef(ToolSpecificationCode) to AvToolSpecification(ToolSpecificationCode);
   reference PartNumberIdRef(PartNoId) to AvPartNumber(PartNumberId);
}
virtual ResourceToolLineVirtual {
   crud = Read;
   ludependencies = RecordWorkVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute TaskSeq Number;
   attribute ToolId Number;
   attribute ResourceId Text;
   attribute ResourceGroupId Text;
   attribute ResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute PartNo Text;
   attribute SerialNo Text;
   attribute AssignedUser Text {
      label = "Signed By";
   }
   attribute IsSigned Boolean;
   attribute AssignedDateTime Timestamp {
      label = "Date";
   }
   attribute SchedDuration Text {
      label = "Scheduled Hours (HH:MM)";
   }
   attribute ActualDuration Text {
      label = "Actual Hours (HH:MM)";
   }
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }

   reference ResourceGroupIdRef(ResourceGroupId) to ResourceGroupMaintLov(ResourceId) {
      label = "Tool/Equipment Group";
   }
   @DynamicComponentDependency TOOLEQ
   reference ResourceIdRef(ResourceId) to ResourceToolEquipJoinLov(ResourceId) {
      label = "Tool/Equipment";
   }
   reference PartCatalogRef(PartNo) to PartCatalogLov(PartNo) {
      label = "Part No";
   }

   action RecordResourceTool {
      ludependencies = RecordWorkVirtual;
      parameter ResourceId Text;
      parameter ResourceSeq Number;
      parameter PartNo Text;
      parameter SerialNo Text;
      parameter ActualDuration Text;
   }
}
virtual InstalledPartLineVirtual {
   ludependencies = RecordWorkVirtual;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute TaskPartId Number;
   attribute TaskSeq Number;
   attribute ConfigSlotPositionCode Text;
   attribute PartGroupId Number;
   attribute InstalledPartNoId Number;
   attribute IpcReference Text;
   attribute InstalledSerialNo Text;
   attribute InstalledBatchNo Text;
   attribute InstalledQuantity Number;
   attribute InstalledUser Text;
   attribute InstalledUserName Text {
      fetch = "Fnd_User_API.Get_Description(UPPER(installed_user))";
   }
   attribute InstalledDate Timestamp;
   attribute PartRequestId Number;
   attribute ConfigSlotCode Text;
   attribute AircraftTypeCode Text;
   attribute PartType Text;
   attribute SignedFlag Boolean;
   attribute ConfigSlotPositionId Number;
   attribute AssemblyConfigSlotPositionId Number {
      fetch = "Av_Exe_Task_Part_API.Get_Assy_Config_Position(task_part_id,part_group_id)";
   }
   attribute PartGroup Text;
   attribute AssyPos Text;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute IsSubAssy Text;
   attribute RemovalSerialNo Text;
   attribute RemovalBatchNo Text;
   attribute RemovalPartManufacturer Text;
   attribute RemovalPartNumber Text;
   attribute RemovalPartAltId Text;
   attribute RemovalReasonCode Text;
   attribute AircraftRegCode Text;
   attribute CmsResponseSeverity Number;
   attribute AircraftId Number;
   attribute InventoryClassCode Text;
   attribute PartGroupAltId Text;
   attribute AssmblConfSlotCode Text;
   attribute AssmblConfSlotPosCode Text;
   attribute ConfigSlot Text;
   attribute ConfSlotPosCode Text;
   attribute RemovedQuantity Number;
   attribute RemovedUserDesc Text;
   attribute CancelledBy Text;
   attribute RemovedUser Text;
   attribute RemovalPartGroupId Number;
   attribute SerialBatchNo Text {
      fetch = "Av_Exe_Task_Part_Util_API.Concat_Serial_Batch_No(installed_serial_no, installed_batch_no)";
   }
   attribute OriginalInstalledSerialNo Text;
   attribute OriginalInstalledBatchNo Text;
   attribute DbInstalledUser Text {
      fetch = "Av_Exe_Task_Part_API.Get_Installed_User(task_part_id)";
   }
