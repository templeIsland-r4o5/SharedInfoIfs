group EditRemovedPartGroup for RemovedPartLineVirtual {
   label = "Edit Removed Part";

   lov PartNumberRmvdRef with ReferenceAvPartNumberNewSelector using GetPartNumberLov(RemovalPartGroupId) {
      label = "Part Number";
      hidekey = [true];
      required = [true];
      description = PartNumberRmvdRef.PartNumber;
      size = Medium;
      validate command {
         execute {
            set PartType = PartNumberRmvdRef.InventoryClassCode;
            if [PartType != "BATCH"] {
               set RemovedQuantity = 1;
            }
         }
      }
   }
   field PartGroupRef.PartGroupCode {
      label = "Part Group";
      visible = [PartNumberRmvdRef.PartNumber != null];
      editable = [false];
   }
   field RemovalSerialNo {
      label = "Serial Number";
      required = [PartType != "BATCH"];
      visible = [PartType != "BATCH"];
   }

   field RemovalBatchNo {
      label = "Batch Number";
      required = [PartType = "BATCH" and PartNumberRmvdRef.IsRepairable];
   }

   lov ConfigSlotPositionRef with ReferenceAvConfigSlotPosNewSelector using GetConfigSlotPosLov(PartGroupRef.ConfigSlotCode, PartGroupRef.AssemblyTypeCode) {
      label = "Position";
      required = [true];
      visible = [PartType = "TRK" or PartType = "ASSY"];
      hidekey = [true];
      description = ConfigSlotPositionRef.ConfigSlotPositionCode;
      size = Medium;

      validate command {
         variable InventorySearchResponse {
            type = Structure(InventorySearchResponseStructure);
         }
         variable CmsRequestInfo {
            type = Structure(CmsDataStructure);
         }
         variable NewRemovalPartNoId Number;

         execute {
            set ConfigSlotPositionId = ConfigSlotPositionRef.ConfigSlotPositionId;
            call GetRemovalCmsRequestData(Objkey, ConfigSlotPositionId) into CmsRequestInfo;
            call GetRemovalInfoService(CmsRequestInfo.AircraftAltId, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition) into InventorySearchResponse;
            if [InventorySearchResponse != null] {
               set RemovalSerialNo = InventorySearchResponse.SerialNumber;
               set RemovalPartNumber = InventorySearchResponse.PartNumber;
               call GetPartIdByAltId(InventorySearchResponse.AltId) into NewRemovalPartNoId;
               set RemovalPartNoId = NewRemovalPartNoId;
            }
         }
      }
   }
   field RemovedQuantity {
      label = "Quantity";
      editable = [PartType = "BATCH"];
      required = [true];
   }
   lov RemovalReasonRef with ReferenceAvRemovalReasonSelector {
      label = "Removal Reason";
      description = RemovalReasonCode;
      editable = [true];
      required = [true];
   }
   field RemovalEditReason {
      label = "Reason for Editing Removed Part";
      visible = [DbRemovedUser != null];
      size = FullWidth;
      required = [true];
   }
}

group RecordToolDemandGroup for ToolResourceDemandVirtual {

   field ToolGroup {
      editable = [false];
   }

   lov ResourceIdRef with MaintResourcesSelector using GetCheckedOutSerial(ResourceGroupSeq, Site) {
      label = "Serial No";
      visible = [ToolEqpAssigned = "FALSE"];
      required = [ToolEqpAssigned = "FALSE"];
      hidekey = [true];
      searchable = true;
