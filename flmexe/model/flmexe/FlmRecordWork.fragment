            set PartType = PartNumberInstRef.InventoryClassCode;
            if [PartType != "BATCH"] {
               set InstalledQuantity = 1;
            }
         }
      }
   }
   lov InstalledSerialRef with PartSerialCatalogSelector using GetSerialNo(PartNumberInstRef.PartNumber, OriginalInstalledSerialNo, TaskSeq) {
      label = "Serial Number";
      hidekey = [true];
      required = [PartType != "BATCH"];
   }
   lov InstalledBatchRef with LotBatchMasterSelector using GetBatchNo(PartNumberInstRef.PartNumber, TaskSeq) {
      label = "Batch Number";
      hidekey = [true];
      required = [PartType = "BATCH"];
      validate command {
         variable IsQuantityUnavailable Boolean;
         execute {
            call CheckQuantiyForBatch(PartNumberInstRef.PartNumber, TaskSeq, InstalledQuantity, InstalledBatchNo) into IsQuantityUnavailable;
            if[IsQuantityUnavailable] {
               set InstalledBatchNo = OriginalInstalledBatchNo;
               error("The available quantity in the selected batch is less than the requested quantity.");
            }
         }
      }
   }
   field InstalledQuantity {
      label = "Quantity";
      editable = [PartType = "BATCH"];
      required = [true];
   }
}

