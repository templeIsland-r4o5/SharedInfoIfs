   attribute PartRequestId Number;
   attribute ConfigSlotCode Text;
   attribute AircraftTypeCode Text;
   attribute PartType Text;
   attribute RemovedUserDesc Text;
   attribute SignedFlag Boolean;
   attribute ConfigSlotPositionId Number;
   attribute AssemblyConfigSlotPositionId Number {
      fetch = "Av_Exe_Task_Part_API.Get_Assy_Config_Position(task_part_id, removal_part_group_id)";
   }
   attribute PartGroup Text;
   attribute AssyPos Text;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
