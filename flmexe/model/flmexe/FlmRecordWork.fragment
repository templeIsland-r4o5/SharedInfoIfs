         }
      }
   }
   field CheckedOutDate {
      label = "Actual Start Date";
      validate command {
         execute {
            call ValidateToolStartEndDate(TaskSeq, ResourceSeq, CheckedOutDate, ActualEndDate) into ActualHours;
         }
      }
   }
   field ActualEndDate {
      label = "Actual End Date";
      validate command {
         execute {
            call ValidateToolStartEndDate(TaskSeq, ResourceSeq, CheckedOutDate, ActualEndDate) into ActualHours;
         }
      }
   }
}

