group RecordInstallPartGroup for InstalledPartLineVirtual {
   label = "Install Details";
   lov PartNumberInstRef with ReferenceAvPartNumberNewSelector using GetPartNumberLov(PartGroupId) {
      label = "Part Number";
      hidekey = [true];
