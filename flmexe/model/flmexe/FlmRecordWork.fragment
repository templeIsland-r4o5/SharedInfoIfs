list TaskActionList for TaskActionLineVirtual {
   label = "Actions";
   multiselect = [false];
   digitalsignature for AvExeTaskAction {
      hashcontent = [SignedFlag = true];
   }
   orderby = ActionOrd desc;
   toolbar {
      enabled = [false];
   }
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   field ActionDesc {
      label = "Action Taken";
      size = Large;
      multiline = true;
   }
   field ActionDate {
      label = "Date";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      excludefromsignaturemapping = true;
   }
   field ActionUser {
      label = "Signed By";
   }
   conditionalformat {
      when [SignedFlag = true] {
         backgroundformat {
            emphasis Validityhidden = [true];
         }
      }
   }

   command EditActionCommand;
}

list TaskStepSignOffList for TaskStepSignOffVirtual {
   label = "Step Action";
   multiselect = [false];
   orderby = GroupingNo, OrderNo;

   toolbar {
      enabled = [false];
   }
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
