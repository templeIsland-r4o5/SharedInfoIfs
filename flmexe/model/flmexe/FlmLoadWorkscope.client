-------------------------------- ASSISTANTS ---------------------------------
assistant FileLoadAssistant using WorkscopeFileLoadVirtualSet {
   label = "Load Work Package";
   savemode = OnLostFocus;
   output(LoadFileId);

   steps {
      step {
         markdowntext {
            text = "Accepted file type .CSV only and maximum file size should be 800 KB";
         }
         fileselector {
            multifile = [false];
            init command {
               execute {
                  set component.UploadQueue.AcceptedExtensions = ".csv";
               }
            }
            onfileselect {
               execute {
                  set FileName = component.UploadQueue.FileList;
               }
            }
            label = "Browse";
         }
      }
      final step {
      }
   }
   finish command {
      label = "Upload";
      enabled = [component.UploadQueue.InvalidFileList = "" and not component.UploadQueue.IsEmpty];
      variable ImportFileInfoVar Structure(ImportFileInfoStructure);

      execute {
         if[FileName != null] {
            upload "WorkscopeFileLoadVirtualSet(Objkey=$[Objkey])/FileData";
            call ImportFile() into ImportFileInfoVar;
            set LoadFileId = ImportFileInfoVar.LoadFileId;
            set ReturnInfo = ImportFileInfoVar.Info;
            exit OK;
         }
      }
   }
   cancel command {
      execute {
         if [not component.UploadQueue.IsEmpty] {
            confirm("Do you want to exit ?") {
               when CANCEL {
                  exit;
               }
               when OK {
                  exit NO;
               }
            }
         }
         else {
            exit NO;
         }
      }
   }
}

----------------------------- STATE INDICATORS ------------------------------

@Override
stateindicator AvFileUploadStateIndicator for AvFileUpload {
   state "Uploaded" {
      completed = 17%;
      emphasis Complementary2 = [Objstate = "Uploaded"];
   }
   state "Processing" {
      completed = 33%;
      emphasis Complementary6 = [Objstate = "Processing"];
   }
   state "Completed" {
      completed = 100%;
      emphasis Complementary9 = [Objstate = "Completed"];
   }
   state "Error" {
      completed = 100%;
      emphasis Complementary4 = [Objstate = "Error"];
   }
   state "Failed" {
      completed = 100%;
      emphasis Complementary1 = [Objstate = "Failed"];
   }
}
