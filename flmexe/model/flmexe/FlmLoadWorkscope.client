client FlmLoadWorkscope;
component FLMEXE;
layer Core;
projection FlmLoadWorkscopeHandling;

--------------------------------- FRAGMENTS ---------------------------------
include fragment WorkScopeLoaderTabs;

----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator {
   entry WorkscopeLoaderNavEntry parent FlmexeNavigator.StationPlanningNav at index 2200 {
      label = "Line Maintenance Work Package Loader";
      page ForwardLineMaintenanceWorkPackageLoaderPage;
   }
}

-------------------------------- MAIN PAGES ---------------------------------
page ForwardLineMaintenanceWorkPackageLoaderPage using AvFileUploadSet {
   label = "Line Maintenance Work Package Loader";
   stateindicator AvFileUploadStateIndicator;
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   selector AvFileUploadCustomSelector;
   group ExecutionDetailsGroup;
   tabs {
      tab {
         label = "Work Packages";
         list WorkPackageList(PAvAircraftWPArray);
         list WorkPackageErrorList(PAvAircraftWPErrorsArray) bind WorkPackageList {
            display = Nested;
         }
      }
      tab {
         label = "Tasks";
         list WorkTaskList(PAvExeTaskArray);
         list WorkTaskErrorList(PAvExeTaskErrorsArray) bind WorkTaskList {
            display = Nested;
         }
      }
      tab {
         label = "Faults";
         list FaultList(PAvFaultArray);
         list FaultErrorList(PAvFaultErrorArray) bind FaultList {
            display = Nested;
         }
      }
      tab {
         label = "Tools";
         list ToolList(PAvToolArray);
         list ToolErrorList(PAvToolErrorsArray) bind ToolList {
            display = Nested;
         }
      }
      tab {
         label = "Skills";
         list LabourSkillList(PAvLabourArray);
         list LabourErrorList(PAvLabourErrorsArray) bind LabourSkillList {
            display = Nested;
         }
      }
      tab {
         label = "Parts";
         list PartList(PAvPartArray);
         list PartErrorList(PAvPartErrorsArray) bind PartList {
            display = Nested;
         }
      }
      tab {
         label = "Measurements";
         list MeasurementList(PAvMeasurementArray);
         list MeasurementErrorList(PAvMeasurementErrorsArray) bind MeasurementList {
            display = Nested;
         }
      }
      tab {
         label = "Actions";
         list ActionList(PAvActionArray);
         list ActionErrorList(PAvActionErrorsArray) bind ActionList {
            display = Nested;
         }
      }
      tab {
         label = "Work Types";
         list WorkTypeList(PAvWPWorkTypeArray);
         list WorkTypeErrorList(PAvWPWorkTypeErrorsArray) bind WorkTypeList {
            display = Nested;
         }
      }
      tab {
         label = "Task Step";
         list TaskStepList(PAvTaskStepArray);
         list TaskStepErrorList(PAvTaskStepErrorsArray) bind TaskStepList {
            display = Nested;
         }
      }
      tab {
         label = "Step Skills";
         list StepSkillList(PAvStepSkillArray);
         list StepSkillErrorList(PAvStepSkillErrorsArray) bind StepSkillList {
            display = Nested;
         }
      }
      tab {
         label = "Unassigned";
         list UnassignedTaskList(PAvUnassignedTaskArray);
         list UnassignedTaskErrorList(PAvUnassignedErrorsArray) bind UnassignedTaskList {
            display = Nested;
         }
      }
      tab {
         label = "Panels";
         list PanelList(PAvPanelArray);
         list PanelErrorList(PAvPanelErrorsArray) bind PanelList {
            display = Nested;
         }
      }
      tab {
         label = "Zones";
         list ZoneList(PAvZoneArray);
         list ZoneErrorList(PAvZoneErrorsArray) bind ZoneList {
            display = Nested;
         }
      }
      tab {
         label = "Panel Requirement";
         list PanelRequirementList(PAvPanelRequirementArray);
         list PanelReqErrorList(PAvPanelReqErrorsArray) bind PanelRequirementList {
            label = "Panel Requirement Error List";
            display = Nested;
         }
      }
      tab {
         label = "Panel Skills";
         list PanelSkillList(PAvPanelSkillArray);
         list PanelSkillErrorList(PAvPanelSkillErrorsArray) bind PanelSkillList {
            label = "Panel Skill Error List";
            display = Nested;
         }
      }
      tab {
         label = "Workscope History";
         list WpHistoryList(PAvWpHistoryArray);
         list WpHistoryErrorList(PAvWpHistoryErrorsArray) bind WpHistoryList {
            label = "Workscope History Error List";
            display = Nested;
         }
      }
   }
   command LoadWorkscopeCommand;
   command ViewTransTabErrorsCommand;
}

--------------------------------- SELECTORS ---------------------------------
selector AvFileUploadCustomSelector for AvFileUpload {
   label = "${LoadFileId} -${FileName}";
   static LoadFileId;
   static LoadDateTime {
      label = "Load Date (UTC)";
   }

   static FileName;
   badge Objstate {
      label = "Status";
      showlabel = false;
      emphasis Complementary2 = [Objstate = "Uploaded"];
      emphasis Complementary6 = [Objstate = "Processing"];
      emphasis Complementary1 = [Objstate = "Failed"];
      emphasis Complementary4 = [Objstate = "Error"];
      emphasis Complementary9 = [Objstate = "Completed"];
   }
}

--------------------------------- COMMANDS ----------------------------------
command LoadWorkscopeCommand for AvFileUpload {
   label = "Load Work Package";
   mode = Global;
   variable NewFileLoadIdVar Number;

   execute {
      assistant FileLoadAssistant into(NewFileLoadIdVar) {
         when OK {
            navigate {
               page ForwardLineMaintenanceWorkPackageLoaderPage {
                  filter(NewFileLoadIdVar, LoadFileId);
               }
            }
         }
         when NO {
            exit;
         }
      }
   }
}
command ViewTransTabErrorsCommand for AvFileUpload {
   label = "External File Transactions Logs";
   mode = SingleRecord;
   enabled = [LoadFileId != null];
   execute {
      navigate "page/ExternalFileTransactions/Form?$filter=LoadFileId eq ${LoadFileId}";
   }
}

---------------------------------- GROUPS -----------------------------------
group ExecutionDetailsGroup for AvFileUpload {
   label = "Execution Summary";
   field LoadFileId;
   badge Objstate {
      label = "Status";
      emphasis Complementary2 = [Objstate = "Uploaded"];
      emphasis Complementary6 = [Objstate = "Processing"];
      emphasis Complementary1 = [Objstate = "Failed"];
      emphasis Complementary4 = [Objstate = "Error"];
      emphasis Complementary9 = [Objstate = "Completed"];
   }
   field FailedRows;
   field FileName;
   field LoadDateTime {
      label = "Load Date (UTC)";
   }
   field UserId {
      contactwidget {
         enabled = [true];
         source = User;
      }
   }
}

