group FaultToolGroup for AddFaultToolVirtual {
   lov AvPartNumberRef with AvPartNumberSelector using GetPartNumber(PartNoId) {
      label = "Part Number";
      size = Medium;
      searchable = true;
      search = AvPartNumberRef.PartNumber, AvPartNumberRef.PartName;
      description = AvPartNumberRef.PartNumber;
      hidekey = [true];
      validate command {
         execute {
            call GetDefaultToolSpec(PartNoId) into ToolSpecificationCode;
         }
      }
   }
   field AvPartNumberRef.PartName {
      label = "Part Name";
   }

   lov AvToolSpecificationRef with AvToolSpecificationNewSelector  using GetToolSpec(PartNoId) {
      label = "Specification";
   }
   field AvToolSpecificationRef.ToolSpecificationName {
      label = "Specification Name";
   }
   field SchedDuration {
      label = "Scheduled Hours (HH:MM)";
      format = decimal;
      required = [true];
   }
}

@DynamicComponentDependency TOOLEQ
group AddResourceToolGroup for AddResourceToolVirtual {
   lov ResourceGroupIdRef with ReferenceResourceGroupMaintLovSelector using GetResourceEquipmentGroups {
      search = ResourceId, Description;
      preview = ResourceGroupMaintLovCard;
      validate command {
         execute {
            if [ResourceId != null] {
               set ResourceId = null;
            }
            if [PartNo != null] {
               set PartNo = null;
            }
            if [SerialNo != null] {
               set SerialNo = null;
            }
         }
      }
   }

   lov ResourceIdRef with ReferenceResourceToolEquipJoinLovSelector using GetResources(ResourceGroupSeq) {
      description = ResourceIdRef.Description;
      search = ResourceId, Description;
      editable = [ResourceGroupSeq != null];
      validate command {
         variable PartSerialVar Structure(PartSerialStructure);

         execute {
            if [ResourceId != null] {
               call GetPartSerial(ResourceSeq) into PartSerialVar;
               copy PartSerialVar into this;
            }
            else {
               set ResourceSeq = null;
               set PartNo = null;
               set SerialNo = null;
            }
         }
      }
   }
   field PartNo {
      lovswitch {
         when [ResourceGroupSeq != null] {
            lov PartCatalogRef with ReferencePartCatalogLovSelector using GetToolEquipGroupParts(ResourceGroupSeq) {
               search = PartNo, Description;
               description = PartCatalogRef.Description;
               validate command {
                  execute {
                     if [SerialNo != null] {
                        set SerialNo = null;
                     }
                     if [ResourceId != null] {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
         when [ResourceGroupSeq = null] {
            lov PartCatalogRef with ReferencePartCatalogLovSelector using GetToolEquipParts {
               search = PartNo, Description;
               description = PartCatalogRef.Description;
               validate command {
                  execute {
                     if [SerialNo != null] {
                        set SerialNo = null;
                     }
                     if [ResourceId != null] {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
      }
   }
   field SerialNo {
      lovswitch {
         when [ResourceGroupSeq != null] {
            lov PartSerialCatalogRef with PartSerialCatalogSelector using GetToolEquipGroupSerials(ResourceGroupSeq) {
               editable = [ResourceSeq = null];
               validate command {
                  execute {
                     if [PartNo != null and SerialNo != null] {
                        call GetResourceId(PartNo, SerialNo) into ResourceId;
                     }
                     else {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
         when [ResourceGroupSeq = null] {
            lov PartSerialCatalogRef with PartSerialCatalogSelector using GetToolEquipSerials {
               editable = [ResourceSeq = null];
               validate command {
                  execute {
                     if [PartNo != null and SerialNo != null] {
                        call GetResourceId(PartNo, SerialNo) into ResourceId;
                     }
                     else {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
      }
   }
   field SchedDuration;
}

@DynamicComponentDependency TOOLEQ
group ModifyResourceToolGroup for ModifyResourceToolVirtual {
   field ResourceGroupId;
   lov ResourceIdRef with ReferenceResourceToolEquipJoinLovSelector using GetResources(ResourceGroupSeq) {
      description = ResourceIdRef.Description;
