               search = PartNo, Description;
               description = PartCatalogRef.Description;
               validate command {
                  execute {
                     if [SerialNo != null] {
                        set SerialNo = null;
                     }
                     if [ResourceId != null] {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
      }
   }
   field SerialNo {
      lovswitch {
         when [ResourceGroupSeq != null] {
            lov PartSerialCatalogRef with PartSerialCatalogSelector using GetToolEquipGroupSerials(ResourceGroupSeq) {
               editable = [ResourceSeq = null];
               validate command {
                  execute {
                     if [PartNo != null and SerialNo != null] {
                        call GetResourceId(PartNo, SerialNo) into ResourceId;
                     }
                     else {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
         when [ResourceGroupSeq = null] {
            lov PartSerialCatalogRef with PartSerialCatalogSelector using GetToolEquipSerials {
               editable = [ResourceSeq = null];
               validate command {
                  execute {
                     if [PartNo != null and SerialNo != null] {
                        call GetResourceId(PartNo, SerialNo) into ResourceId;
                     }
                     else {
                        set ResourceId = null;
                        set ResourceSeq = null;
                     }
                  }
               }
            }
         }
      }
   }
   field SchedDuration;
}

group ModifyFaultGroup for AvFault {
   label = "Fault Registration";
   static Aircraft {
      label = "Aircraft";
      size = FullWidth;
   }
   field Description {
      label = "Name";
      editable = [true];
      multiline = true;
      size = FullWidth;
      required = [true];
      maxlength = 200;
   }
   lov AvAircraftSubSystemRef with AircraftSubSystemNewSelector using GetAircraftSubSystemList(AssemblyTypeCode) {
      hidekey = [true];
      label = "Failed System";
      description = AvAircraftSubSystemRef.SubSystemCode;
      required = [true];
      size = Large;
      searchable = true;
      search = AvAircraftSubSystemRef.SubSystemCode, AvAircraftSubSystemRef.SubSystemName;
      validate command {
         variable SensitivityResponse Structure(SensitivityResponseStructure);
         execute {
            if [AvAircraftSubSystemRef != null and AircraftRef.AltId != null] {
               call GetFailedSystemSensitivity(AvAircraftSubSystemRef.AltId, AircraftRef.AltId) into SensitivityResponse;
               if [SensitivityResponse.UIFormattedSensitivities != null] {
                  set SensitivityForFailedSys = SensitivityResponse.UIFormattedSensitivities;
               }
               else {
                  set SensitivityForFailedSys = null;
               }
            }
            else {
               set SensitivityForFailedSys = null;
            }

         }
      }
   }

   lov AvFaultSeverityCodeRef with AvFaultSeverityNewSelector {
      label = "Fault Severity";
      required = [true];
      editable = [AvDeferralRequestRef = null];
      size = Large;
   }
   field LogbookReference {
      label = "Logbook Reference";
      size = Large;
      maxlength = 80;
      required = [not IsNonRoutine];
   }
   lov AvLogbookTypeCodeRef with AvLogbookTypeNewSelector {
      label = "Logbook Type";
      size = Large;
      required = [not IsNonRoutine];
   }
   lov AvFaultSourceCodeRef with AvFaultSourceNewSelector {
      label = "Fault Source";
      size = Large;
      required = [true];
   }
   field FoundOnDate {
      label = "Found on";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      size = Large;
      required = [true];
   }
   lov AvAirportForUserRef with ReferenceAvAirportForUserSelector using GetAirportUserList {
      label = "Found By";
      hidekey = [true];
      searchable = true;
      required = [true];
      search = AvAirportForUserRef.Identity;
      size = Large;
   }
   lov AvPhaseOfFlightCodeRef with AvPhaseOfFlightNewSelector {
      label = "Phase of Flight";
      visible = [not IsNonRoutine];
      size = Large;
   }
   field FaultCode {
      label = "Fault Code";
      maxlength = 80;
      size = Large;
   }
   field LongDescription {
      label = "Description";
      multiline = true;
      size = FullWidth;
      maxlength = 500;
   }
}

