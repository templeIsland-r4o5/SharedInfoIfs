group DeferralInfoGroup for AvFault {
   label = "Deferral Information";
   visible = [AvDeferralRequestRef.DeferralReferenceName != null];
   badge AvDeferralRequestRef.DeferralRequestStatus {
      label = "Deferral Request Status";
      visible = [AvDeferralRequestRef.MocRequired != false];
      style = TextOnly;
      emphasis Complementary7 = [AvDeferralRequestRef.DeferralRequestStatus = "Pending"];
      emphasis True = [AvDeferralRequestRef.DeferralRequestStatus = "Approved"];
      emphasis Alert = [AvDeferralRequestRef.DeferralRequestStatus = "Rejected"];
   }
   badge AvDeferralRequestRef.MocRequired {
      label = "Requires MOC Authorization";
      style = TextOnly;
      emphasis True = [AvDeferralRequestRef.MocRequired = false];
