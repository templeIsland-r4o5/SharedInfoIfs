-----------------------------------------------------------------------------
client FlmFaultDetail;
component FLMEXE;
layer Core;
projection FlmFaultDetailHandling;
description "Fault Details Client";

--------------------------------- FRAGMENTS ---------------------------------
include fragment FlmParts;
include fragment FlmResourceToolEquipmentTab;
include fragment FlmTaskAssignments;
include fragment FlmJtTaskStep;
include fragment AvTaskReturns;
include fragment AvTaskMaterial;
include fragment AvCriticalItem;
@DynamicComponentDependency ADCON
include fragment HeavyMaintenanceInfo;
include fragment FlmTaskTool;
----------------------------- NAVIGATOR ENTRIES -----------------------------


-------------------------------- MAIN PAGES ---------------------------------
page FaultDetails using AvFaultDetailSet {
   label = "Fault Details";
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
   }

   initcontext FetchFlightInfo;

   selector TaskSelector;

   markdowntext {
      visible = [RequestStateCd = "Failed"];

      text = "Raise fault synchronization error: ${RequestErrorMessage}";

      emphasis Danger = [RequestStateCd = "Failed"];
   }

   markdowntext {
      visible = [RequestStateCd = "Sent"];

      text = "Raise fault synchronization is currently in progress";

      emphasis Complementary7 = [RequestStateCd = "Sent"];
   }

   markdowntext {
      visible = [AvExeTaskRef.RequestStateCd = "Sent"];
      text = "Part changes have not been validated.";
      emphasis Complementary7 = [true];
   }

   markdowntext {
      visible = [AvExeTaskRef.RequestStateCd = "Failed"];
      text = "Configuration warnings have been identified for some part changes in this fault.";
      emphasis Alert = [true];
   }

   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval and not(HmNonRoutineApprovalRef.ProceedAtRisk) and HmNonRoutineApprovalRef.ApprovalStatus != "Approved" and IsExecutionBlockedByCap];
      text = "Free CAP limit exceeded. Commercial approval is required before proceeding.";
      emphasis Complementary6 = [true];
   }

   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and HmNonRoutineApprovalRef.NeedCommercialApproval and not(HmNonRoutineApprovalRef.ProceedAtRisk) and HmNonRoutineApprovalRef.ApprovalStatus != "Approved" and not IsExecutionBlockedByCap];
      text = "Free CAP limit is exceeded. Commercial approval is required. However, you are allowed to proceed based on the current system configurations.";
      emphasis Complementary6 = [true];
   }

   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.ProceedAtRisk and HmNonRoutineApprovalRef.ApprovalStatus != "Approved"];
      text = "Free CAP limit is exceeded. Commercial approval is required. However, you are allowed to proceed as 'proceed at risk' is authorized.";
      emphasis Complementary6 = [true];
   }

   group FaultDetailsGroup;
   group AvFaulttWorkGroup;
   @DynamicComponentDependency ADCON
   group AvTaskContractGroup;
   group DeferralInfoGroup;
   group ActionGroup;
   @DynamicComponentDependency ADCON
   group NonRoutinesAprrovalGroup;

   tabs {
      tab {
         label = "Assignments";
         list AssignmentsList(JtTaskResourceArray) bind TaskSelector;
      }
      tab {
         label = "Material";
         list AvMatReqDetailList(MaintMaterialRequisitionArray);
      }
      tab {
         label = "Part Removals";
         list AggMmFaultPartRemovalList(AggFaultRemovePartArray);
         list FaultPartWarningsList(FaultPartRemovalWarningArray) bind AggMmFaultPartRemovalList {
            display = Nested;
         }
      }
      tab {
         label = "Part Installations";
         list AggMmFaultPartInstallationList(AggFaultInstPartArray);
         list FaultPartWarningsList(FaultPartInstallWarningArray) bind AggMmFaultPartInstallationList {
            display = Nested;
         }
      }
      tab {
         label = "Returns";
         list AvTaskReturnList(AvTaskReturnArray);
      }
      tab {
         label = "Tools";
         list ToolDemandsList(TaskToolDemandQueryArray);
      }
      tab {
         label = "Actions Taken";
         list FaultActionsList(FaultActionsArray);
      }
      tab {
         label = "Measurements";
         list MeasurementsList(MeasurementArray);
      }
      tab {
         label = "Steps";
         list JtTaskStepList(JtTaskStepArray) {
            label = "";
         }
         list JtTaskStepSignOffList(JtTaskStepSignOffArray) bind JtTaskStepList {
            label = "STEP SIGN-OFF";
            display = Nested;
         }
      }
      tab {
         label = "Critical Items";
         list CriticalItemsList(CriticalItemsArray) bind TaskSelector;
      }
   }

   command ModifyFault;
   command RequestDeferral;
   command AddPartsCommand;
   command AddToolsCommand;
   commandgroup PartSearch {
      commandgroup PartsSearch {
         label = "Part Search";
         command AviationParts;
         command AviationInventories;
      }
   }
   command EvaluateNonRoutineCommand;
   command InitiateDeferral;
   command RejectDeferralCommand;
   command ApproveDeferralCommand;
   command FaultSearchCommand;
   command CorrectiveTaskCommand;
}


initcontext FetchFlightInfo {
   parameter IataCode Text;
}

--------------------------------- COMMANDS ----------------------------------
command ModifyFault for AvFault {
   label = "Edit Fault";
   enabled = [Objstate != "Closed" and UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and TaskControlAuthorityEnabled = "Yes"];
   mode = Global;
   variable ModifyFaultInfo Structure(ModifyFaultInfoStructure);
   execute {
      copy this into ModifyFaultInfo;
      set ModifyFaultInfo.AircraftAltId = AircraftRef.AltId;
      assistant ModifyFaultAssistant(ModifyFaultInfo) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command SaveModifiedFault for ModifyFaultVirtual {
   label = "OK";
   enabled = [AircraftId != null and SubSystemId != null and FaultSourceCode != null and Description != null and(LogbookTypeCode != null or IsNonRoutine = true) and(LogbookReference != null or IsNonRoutine = true) and FaultSeverityCode != null and FoundOnDate != null and FoundByUser != null];
   execute {
      call ValidateFoundOnDate(FoundOnDate, WorkPackageId);
      call ModifyFaultService(FaultId, SubSystemId, LogbookReference, Description, LogbookTypeCode, FailureTypeCode, FaultSeverityCode, FaultSourceCode, FaultCode, PhaseOfFlightCode, AircraftAltId, AvAircraftSubSystemRef.AltId, FaultAltId, ExternalId, FoundOnDate, FoundByUser, LongDescription, PriorityId, EtopsSignificant, FlightSafetyImpact);
   }
}

command InitiateDeferral for AvFault {
   label = "Initiate Deferral";
   visible = [IsFlmStandalone = false and Objstate = "Open" and IsMocRoleExist = true and AvDeferralRequestRef.DeferralRequestStatus = "Pending"];

   variable InitiateDeferralUrl Text;
   variable ExternalPageUrl Text;

   execute {
      set ExternalPageUrl = "/lmocweb/phone-up-deferral/index.html";
      call GetInitiateDeferralUrl(ExternalPageUrl, AircraftRef.RegCode, Description, LogbookReference, FoundByUser, FaultSourceCode, FoundOnFlightRef.LegNo, PhaseOfFlightCode, RecordId) into InitiateDeferralUrl;
      navigate "${InitiateDeferralUrl}";
      call ClickInitiateDeferral(FaultId);
   }
}

command FindInventory for AvFault {
   label = "Find Inventory";
   visible = [IsFlmStandalone = false and Objstate != "Closed" and IsCertified = "PENDING"];

   variable FindInventoryURL Text;
   variable ExternalPagePath Text;
   variable SearchType Text;
   variable FaultNameRef Text;
   variable IataCode Text;

   execute {
      set ExternalPagePath = "/maintenix/web/inventory/InventorySearchByType.jsp";
      set SearchType = "INSTALLABLEINVENTORY";
      set FaultNameRef = "Mobile Maintenance Fault Record ID ${RecordId}";
      set IataCode = initcontext.IataCode;
      call GetFindInventoryUrl(ExternalPagePath, SearchType, AircraftRegCode, IataCode, FaultNameRef) into FindInventoryURL;
      navigate "${FindInventoryURL}";
   }

}

command  SaveFaultTool for AddFaultToolVirtual {
   label = "OK";
   execute {
      call AddFaultTool(FaultId, ToolSpecificationCode, PartNoId, SchedDuration);
   }
}

command RemoveAggToolCommand for AggFaultToolQuery {
   label = "Remove";
   mode = SingleRecord;
   enabled = [Status = "Pending" and AvFaultRef.UserRole != "MM_MAINT_OPERATIONS_CONTROLLER"];
   execute {

      confirm("Do you want to remove the tool requirement?") {
         when OK {
            call DeleteFaultTool(AggregateId);
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command SaveResourceTool for AddResourceToolVirtual {
   label = "OK";
   execute {
      call AddResourceTool(FaultId);
   }
}

command SaveModifiedResourceTool for ModifyResourceToolVirtual {
   label = "OK";

   execute {
      call ModifyResourceTool();
   }
}

command RequestDeferral for AvFault {
   visible = [IsCertified = "PENDING" and TaskObjstate != "WORKSTARTED" and(AvDeferralRequestRef = null or AvDeferralRequestRef.DeferralRequestStatus = "Rejected" or AvDeferralRequestRef.DeferralRequestStatus = "Pending" or AvDeferralRequestRef.MocRequired = false)];
   label = "Request Deferral";
   enabled = [UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and Objstate = "Open"];
   variable SelectReferenceURL Text;
   variable ExternalPagePath Text;
   variable AType Text;
   variable ASource Text;
   variable ATaskSeq Text;
   variable IsDeferAllowed Boolean;
   execute {
      if[IsNonRoutine = true] {
         call CheckDeferNonRoutine(FaultId) into IsDeferAllowed;
         if[IsDeferAllowed = true] {
            set ExternalPagePath = "/lmocweb/select-reference/index.html";
            set AType = "DEFERRAL";
            set ASource = "MM";
            set ATaskSeq = ExternalId;
            call GetSelectReferenceUrl(ExternalPagePath, ATaskSeq, AType, ASource) into SelectReferenceURL;
            navigate "${SelectReferenceURL}";
         }
         else {
            alert("Add the Logbook Reference to defer the Non-Routine");
         }
      }
      else {
         set ExternalPagePath = "/lmocweb/select-reference/index.html";
         set AType = "DEFERRAL";
         set ASource = "MM";
         set ATaskSeq = ExternalId;
         call GetSelectReferenceUrl(ExternalPagePath, ATaskSeq, AType, ASource) into SelectReferenceURL;
         navigate "${SelectReferenceURL}";
      }
   }
}

command ApproveDeferralCommand for AvFault {
   label = "Approve";
   enabled = [AvDeferralRequestRef.DeferralRequestStatus = "Pending"  and IsMocRoleExist = true and AvDeferralRequestRef.IsDefInitiated = true];
   mode = SingleRecord;
   execute {
      assistant ApproveDeferralAssistant(FaultId) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command SaveAuthNo for ApproveDeferralVirtual {
   label = "OK";
   enabled = [DeferralAuthorization != null];

   execute {
      call ApproveDeferral(FaultId, DeferralAuthorization);
   }
}

command RejectDeferralCommand for AvFault {
   label = "Reject";
   enabled = [AvDeferralRequestRef.DeferralRequestStatus = "Pending"  and IsMocRoleExist = true];
   mode = SingleRecord;
   execute {
      assistant RejectDeferralAssistant(FaultId) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command SaveRejectionReason for RejectDeferralVirtual {
   label = "OK";
   enabled = [RejectionReason != null];

   execute {
      call RejectDeferral(FaultId, RejectionReason);
   }
}

command FaultSearchCommand {
   label = "Fault Search";

   execute {
      if[UserRole = "MM_MAINT_OPERATIONS_CONTROLLER"] {
         navigate "page/FlmMaintenanceOperationControl/FlmFaultSearch?$filter=(AircraftTypeCode eq $[AircraftRef.AircraftTypeCode]) and (RegCode eq $[AircraftRef.RegCode])";
      }
      else {
         navigate "page/FlmFaultSearch/FlmFaultSearch?$filter=(AircraftTypeCode eq $[AircraftRef.AircraftTypeCode]) and (RegCode eq $[AircraftRef.RegCode])";
      }
   }
}

command CorrectiveTaskCommand {
   label = "Corrective Task";
   visible = [IsNonRoutine = true and Objstate != "Deferred"];
   execute {
      navigate "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[AvExeTaskRef.TaskSeq]";
   }
}

command EvaluateNonRoutineCommand for AvFault {
   label = "Evaluate";
   visible = [not IsRoutine and not Evaluated and Objstate != "Closed"];
   execute {
      confirm("Mark this as evaluated?") {
         when OK {
            call EvaluateNonRoutineService(FaultId, AltId);
            exit OK;
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command CompleteCriticalItem for AvCriticalItem {
   label = "Complete";
   emphasis Complementary9 = [true];
   mode = SingleRecord;
   enabled = [(parent.IsHangarSupervisor or parent.IsHangarCrewLead) and Objstate != "Completed"];
   execute {
      confirm("Do you want to complete the Critical Item [${CriticalItem}]?") {
         when OK {
            call CompleteCriticalItem(CriticalItemId);
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command RefreshCriticalItem for AvCriticalItem {
   execute {
      call Refresh();
   }
}
command AviationParts {
   execute {
      navigate "/page/MxPartDefinitionSearch/PartDefinition";
   }
}
command AviationInventories {
   label = "Rotable Inventories";
   execute {
      navigate "page/MxInventorySearch/AviationInventorySearch";
   }
}
command AddPartsCommand for AvFault {
   label = "Add/Remove Part";
   enabled = [Objstate != "Closed" and UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and IsCertified = "PENDING"];
   visible = [Objstate != "Closed" and IsCertified = "PENDING"];
   variable PartsInfo Structure(PartsInfoAssistantStructure);
   execute {
      copy this into PartsInfo;
      set PartsInfo.FaultId = null;
      set PartsInfo.TaskSeq = TaskSeq;
      set PartsInfo.RequiredQuantity = 1;
      set PartsInfo.AircraftAltId = AircraftRef.AltId;
      set PartsInfo.AircraftRegCode = AircraftRef.RegCode;
      set PartsInfo.WpId = WorkPackageId;
      assistant AddRemovePartAssistant(PartsInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}
command OldAddPartsCommand for AvFault {
   label = "Add Part(Old)";
   enabled = [Objstate != "Closed" and UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and IsCertified = "PENDING"];
   visible = [Objstate != "Closed" and IsCertified = "PENDING"];
   variable PartsInfo Structure(PartsInfoAssistantStructure);
   execute {
      copy this into PartsInfo;
      set PartsInfo.TaskSeq = null;
      set PartsInfo.RequiredQuantity = 1;
      set PartsInfo.AircraftAltId = AircraftRef.AltId;
      set PartsInfo.AircraftRegCode = AircraftRef.RegCode;
      assistant PartsAssistant(PartsInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}

command AddToolsCommand for AvFault {
   label = "Add Tools/Equipment";
   enabled = [Objstate != "Closed" and UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and IsCertified = "PENDING" and TaskSeq != null];
   mode = Global;
   variable AddToolInfo Structure(AddToolInfo);

   execute {
      copy this into AddToolInfo;
      set AddToolInfo.Site = TaskSite;
      set AddToolInfo.Source = "ADD";
      assistant AddToolAssistant(AddToolInfo) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

--------------------------------- SELECTORS ---------------------------------

selector TaskSelector for AvFault {
   label = "${Barcode}";
   static Barcode {
      label = "Barcode";
   }
}

selector AircraftSubSystemNewSelector for AvAircraftSubSystem {
   label = "${SubSystemCode} - ${SubSystemName}";
   static SubSystemCode;
   static SubSystemName;
}
selector AvLogbookTypeNewSelector for AvLogbookType {
   label = "${LogbookTypeCode} - ${LogbookTypeDesc}";
   static LogbookTypeCode;
   static LogbookTypeDesc;
}
selector AvPhaseOfFlightNewSelector for AvPhaseOfFlight {
   label = "${PhaseOfFlightCode} - ${PhaseOfFlightDesc}";
   static PhaseOfFlightCode;
   static PhaseOfFlightDesc;
}
selector AvFailureTypeNewSelector for AvFailureType {
   label = "${FailureTypeCode} - ${FailureTypeDesc}";
   static FailureTypeCode;
   static FailureTypeDesc;
}
selector AvFaultSeverityNewSelector for AvFaultSeverity {
   label = "${FaultSeverityCode} - ${FaultSeverityDesc}";
   static FaultSeverityCode;
   static FaultSeverityDesc;
}
selector AvFaultSourceNewSelector for AvFaultSource {
   label = "${FaultSourceCode} - ${FaultSourceDesc}";
   static FaultSourceCode;
   static FaultSourceDesc;
}

@Override
selector AvPartNumberSelector for AvPartNumber {
   orderby = PartNumber;
   label = "";
   static PartNumber;
   static Manufacturer;
   static PartName;
   exclude PartNumberId;
}

selector AvToolSpecificationNewSelector for AvToolSpecification {
   label = "";
   orderby = ToolSpecificationCode;
   static ToolSpecificationCode;
   static ToolSpecificationName;
   static InventoryClassCode;
}

selector FoundOnTaskSelector for AvExeTask {
   label = "";
   static Barcode;
   static Description {
      label = "Name";
   }
}

selector FoundOnWorkPackageSelector for AvAircraftWorkPackage {
   label = "";
   static Barcode {
      label = "Work Package Barcode";
   }
   static WorkPackageName;
}

selector ReferenceAvAirportForUserSelector for FndUser {
   label = "";
   orderby = Description;
   static Description;
   static Identity;
}
---------------------------------- GROUPS -----------------------------------

group FaultDetailsGroup for AvFault {
   label = "Details";
   field Description {
      size = Large;
      label = "Name";
      multiline = true;
      editable = [Objstate != "Closed"];
      required = [true];
      maxlength = 200;
   }
   badge Sensitivities {
      label = "Sensitivities";
      emphasis Warning = [true];
      visible = [Sensitivities != null];
      editable = [false];
   }
   badge Objstate {
      label = "Status";
      style = TextOnly;
      size = Medium;
      emphasis Complementary7 = [Objstate = "Open"];
      emphasis Ok = [Objstate = "Closed"];
      emphasis Info = [Objstate = "Deferred"];
   }
   field Aircraft {
      size = Medium;
   }
   field Barcode {
      label = "Barcode";
      size = Medium;
   }
   lov AvAircraftSubSystemRef with AircraftSubSystemNewSelector using GetAircraftSubSystemList(AssemblyTypeCode) {
      hidekey = [true];
      label = "Failed System";
      description = AvAircraftSubSystemRef.SubSystemCode;
      editable = [Objstate != "Closed"];
      required = [true];
      size = Medium;
   }
      // navigation will change once the work package details page is implemented
   field TaskSeq {
      label = "Found During";
      visible = [IsNonRoutine and SourceConnectionLuName = "AvExeTask"];
      size = Medium;
      lovswitch {
         when [FoundDuringTaskStatus != "Removed"] {
            lov AvExeTaskRef with FoundOnTaskSelector {
               hidekey = [true];
               description = "${FoundOnTaskRef.Barcode} - ${FoundOnTaskRef.Description}";
               details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[FoundOnId]";
            }
         }
         when [FoundDuringTaskStatus = "Removed"] {
            lov AvExeTaskRef with FoundOnTaskSelector {
               hidekey = [true];
               description = "${FoundOnTaskRef.Barcode} - ${FoundOnTaskRef.Description}";
               details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FoundDuringFaultId]";
            }
         }
      }
   }
   // navigation will add once the work package details page for base maintenance is implemented
   field WorkPackageId {
      label = "Found During";
      visible = [IsNonRoutine and SourceConnectionLuName = "WorkPackage"];
      size = Medium;
      lovswitch {
         when [AvAircraftWorkPackageRef.IsHeavyMaintenance = 1] {
            lov AvAircraftWorkPackageRef with FoundOnWorkPackageSelector {
               hidekey = [true];
               description = "${FoundOnWorkPackageRef.Barcode} - ${FoundOnWorkPackageRef.WorkPackageName}";
               details = "page/FlmHmWorkPackage/FlmHmWorkPackagePage?$filter=Barcode eq $[FoundOnWorkPackageRef.Barcode]";
            }
         }
         when [AvAircraftWorkPackageRef.IsHeavyMaintenance = 0] {
            lov AvAircraftWorkPackageRef with FoundOnWorkPackageSelector {
               hidekey = [true];
               description = "${FoundOnWorkPackageRef.Barcode} - ${FoundOnWorkPackageRef.WorkPackageName}";
               details = "page/FlmAircraftTurnsDetails/AircraftTurnDetails?$filter=WorkPackageId eq $[AvExeTaskRef.AircraftWpId]";
            }
         }
      }
   }
   field LogbookReference {
      label = "Logbook Reference";
      size = Medium;
      editable = [Objstate != "Closed"];
      required = [true];
   }
   lov AvLogbookTypeCodeRef with AvLogbookTypeNewSelector {
      label = "Logbook Type";
      size = Medium;
      editable = [Objstate != "Closed"];
   }
   lov AvFaultSourceCodeRef with AvFaultSourceNewSelector {
      label = "Fault Source";
      size = Medium;
      editable = [Objstate != "Closed"];
   }
   lov AvFailureTypeCodeRef with AvFailureTypeNewSelector {
      label = "Failure Type";
      size = Medium;
      editable = [Objstate != "Closed"];
   }
   field Evaluated {
      size = Medium;
   }
   field EvaluatedBy {
      size = Medium;
   }
   lov AvFaultSeverityCodeRef with AvFaultSeverityNewSelector {
      label = "Fault Severity";
      size = Medium;
      editable = [Objstate != "Closed"];
   }
   badge FlightSafetyImpact {
      label = "Flight Safety Impact";
      style = TextOnly;
      emphasis Info = [HasFlightSafetyImpact = true];
      emphasis Neutral = [HasFlightSafetyImpact = false];
      size = Medium;
   }
   field FoundByUserContactWidget {
      label = "Found By";
      visible = [true];
      contactwidget {
         enabled = [true];
         source = User;
      }
   }
   field FoundOnDate {
      label = "Found On";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      editable = [false];
      size = Medium;
   }
   field FaultCode {
      label = "Fault Code";
      editable = [Objstate != "Closed"];
      size = Medium;
   }
   badge OverallAssignmentsProgress {
      emphasis Neutral = [OverallAssignmentsProgress = "NotStarted"];
      emphasis Complementary2 = [OverallAssignmentsProgress = "InProgress"];
      emphasis Complementary8 = [OverallAssignmentsProgress = "Paused"];
      emphasis Complementary3 = [OverallAssignmentsProgress = "Finished"];
      editable = [false];
   }
   badge IsAssignToWP {
      label = "Assigned To WP";
      style = TextOnly;
      emphasis Info = [IsAssignToWP = true];
      emphasis Neutral = [IsAssignToWP = false];
      size = Medium;
   }
   field LatestJobStopReason {
      visible = [Objstate != "Closed" or(Objstate = "Closed" and IsJobstopDetailsVisible = true)];
      editable = [false];
      size = Medium;
   }
   field LatestJobStopNote {
      visible = [Objstate != "Closed" or(Objstate = "Closed" and IsJobstopDetailsVisible = true)];
      editable = [false];
      size = Medium;
      multiline = true;
   }
   field FoundOnDesc {
      label = "Found During Flight";
      editable = [false];
      visible = [(FoundOnType = "FLIGHT" or FoundOnType = "LOBBY" or FoundOnType = "WSL") and not IsNonRoutine];
      size = Medium;
   }
   lov AvPhaseOfFlightCodeRef with AvPhaseOfFlightNewSelector {
      label = "Phase of Flight";
      size = Medium;
      editable = [Objstate != "Closed"];
      visible = [IsNonRoutine = false];
   }
   badge HasPreviousMaintenance {
      label = "Previous Maintenance";
      style = TextOnly;
      size = Medium;
      emphasis Complementary7 = [HasPreviousMaintenance = true];
   }
   badge RequestStateCd {
      label = "Synchronization Status";
      visible = [false];
      style = TextOnly;
      size = Small;
      editable = [false];
      emphasis Ok = [RequestStateCd = "Succeeded"];
      emphasis Complementary7 = [RequestStateCd = "Sent"];
      emphasis Alert = [RequestStateCd = "Failed"];
   }
   field RequestCorrelationId {
      label = "Correlation ID";
      visible = [false];
      editable = [false];
   }
   field LongDescription {
      label = "Description";
      editable = [Objstate != "Closed"];
      size = Large;
      multiline = true;
   }

   static CriticalItemCount {
      label = "Active Critical Items";
   }
}
