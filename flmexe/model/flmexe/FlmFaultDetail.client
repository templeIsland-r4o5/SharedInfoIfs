---------------------------------- DIALOGS ----------------------------------
assistant ModifyFaultAssistant using ModifyFaultVirtualSet {
   label = "Edit Fault";
   savemode = OnLostFocus;
   input this;
   singlestep {
      markdowntext {
         visible = [SensitivityForFailedSys != null and AvAircraftSubSystemRef != null];
         text = "${SensitivityForFailedSys} Sensitive - Refer to MPM for Details.";
         emphasis Warning = [true];
      }
      group ModifyFaultGroup;
      group FaultDetailGroup;
   }
   command SaveModifiedFault;
   command Cancel;
}

assistant AddFaultToolAssistant using AddFaultToolVirtualSet {
   label = "Add Tool";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group FaultToolGroup;
   }
   command SaveFaultTool;
   command Cancel;
}

@DynamicComponentDependency TOOLEQ
assistant AddResourceToolAssistant using AddResourceToolVirtualSet {
   label = "Add Tool";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group AddResourceToolGroup;
   }
   command SaveResourceTool;
   command Cancel;
}

@DynamicComponentDependency TOOLEQ
assistant ModifyResourceToolAssistant using ModifyResourceToolVirtualSet {
   label = "Modify Tool";
   savemode = OnLostFocus;
   input this;
   singlestep {
      group ModifyResourceToolGroup;
   }
   command SaveModifiedResourceTool;
   command Cancel;
}

assistant ApproveDeferralAssistant using ApproveDeferralVirtualSet {
   label = "Enter Authorization Number";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group ApproveDetailsGroup;
   }
   command SaveAuthNo;
   command Cancel;
}

assistant RejectDeferralAssistant using RejectDeferralVirtualSet {
   label = "Enter Rejection Reason";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group RejectionReasonGroup;
   }
   command SaveRejectionReason;
   command Cancel;
}

assistant ResubmissionDeferralAssistant using ResubmitDeferralRequestVirtualSet {
   label = "Resubmission Reason";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group ResubmitDeferralGroup;
   }
   command SaveResubmitReason;
   command Cancel;
}

-------------------------------- SINGLETONS ---------------------------------
command RemoveRemovalPartCommand for FaultRemovedParts {
   label = "Remove";
   mode = SingleRecord;
   enabled = [true];
   execute {
      confirm("Do you want to remove the part removal requirement?") {
         when OK {
            call RemovePart(FaultPartId);
         }
         when CANCEL {
            exit;
         }
      }

   }

}

command RemoveInstallPartCommand for FaultInstalledParts {
   label = "Remove";
   mode = SingleRecord;
   enabled = [true];
   execute {
      confirm("Do you want to remove the part installation requirement?") {
         when OK {
            call RemovePart(FaultPartId);
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command RemoveAggInstPartCommand for AggFaultInstPartQuery {
   label = "Remove";
   mode = SingleRecord;
   enabled = [Status = "Pending" and AvFaultRef.UserRole != "MM_MAINT_OPERATIONS_CONTROLLER"];
   execute {
      confirm("Do you want to remove the part installation requirement?") {
         when OK {
            call RemovePart(AggregateId);
         }
         when CANCEL {
            exit;
         }
      }
   }
}

command SaveResubmitReason for ResubmitDeferralRequestVirtual {
   label = "OK";
   enabled = [ReauthorizationReason != null];
   execute {
      call ResubmitDeferral(FaultId, ReauthorizationReason);
      success("Deferral request resubmitted.");
      exit OK;
   }
}

command RemoveAggRemovalPartCommand for AggFaultRemovePartQuery {
   label = "Remove";
   mode = SingleRecord;
   enabled = [Status = "Pending" and AvFaultRef.UserRole != "MM_MAINT_OPERATIONS_CONTROLLER"];
   execute {
      confirm("Do you want to remove the part removal requirement?") {
         when OK {
            call RemovePart(AggregateId);
         }
         when CANCEL {
            exit;
         }
      }

   }

}

command CreateAggRemReturnLineCommand for AggFaultRemovePartQuery {
   enabled = [TaskReturnLineSeq = null and parent.Objstate = "Open" and RemovedReasonCode != "ACCESS" and Status != "Cancelled"];
   label = "Create Return Line";
   mode = SingleRecord;
   execute {
      call CreateReturnLine(TaskPartId, TaskSeq, AvPartNumberRef.PartNumber, Quantity, RemovedSerialNo, RemovedBatchNo);
   }
}

command CancelPartCommand for AggFaultInstPartQuery {
   label = "";
   mode = SingleRecord;
   variable InstallPartsInfo Structure(InstallPartsInfoStructure);

   execute {
      if [MaintMaterialReqRef.Qty > 0] {

         copy this into InstallPartsInfo;
         set InstallPartsInfo.InstalledPartNo = AvPartNumberRef.PartNumber;
         set InstallPartsInfo.PartName = AvPartNumberRef.PartName;

         assistant CancelPartAssistant(InstallPartsInfo) {
            when CANCEL {
               exit;
            }
         }
      }
      else {
         call CancelParts(TaskPartId);

      }
      if[AvFaultRef.ClassCode = "CORR" and Sensitivities != null] {
         call SaveOverallTaskSensitivity(parent.AircraftRef.AltId, parent.FaultId, parent.EtopsSignificant, parent.AvAircraftSubSystemRef.AltId, TaskPartId);
      }
   }
}

command CancelRemovelCommand for AggFaultRemovePartQuery {
   enabled = [Status = "Pending" and AvFaultRef.TaskObjstate in("RELEASED", "WORKSTARTED") and TaskControlAuthorityEnabled = "Yes" and TaskSeq != null];
   label = "Cancel";
   mode = SingleRecord;
   execute {
      call CancelPart(TaskPartId);
      if[AvFaultRef.ClassCode = "CORR" and Sensitivities != null] {
         call SaveOverallTaskSensitivity(parent.AircraftRef.AltId, parent.FaultId, parent.EtopsSignificant, parent.AvAircraftSubSystemRef.AltId, TaskPartId);
      }
   }
}
