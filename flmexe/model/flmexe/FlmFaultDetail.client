   }
   field AvDeferralRequestRef.DeferralReferenceName {
      label = "Selected Reference";
      visible = [AvDeferralRequestRef.DeferralRequestStatus in("Pending", "Approved") or(AvDeferralRequestRef.MocRequired = false)];
      editable = [false];
   }
   field AvDeferralRequestRef.DeferralClassCode {
      label = "Deferral Type";
      visible = [AvDeferralRequestRef.DeferralRequestStatus in("Pending", "Approved") or(AvDeferralRequestRef.MocRequired = false)];
      editable = [false];
   }
   field AvDeferralRequestRef.DeferralAuthorization {
      label = "Deferral Authorization No";
      visible = [(Objstate = "Deferred") or(AvDeferralRequestRef.MocRequired != false) and(AvDeferralRequestRef.DeferralRequestStatus = "Approved")];
      editable = [false];
   }
   field AvDeferralRequestRef.DeferralReqReasonCode {
      label = "Deferral Reason";
      visible = [(Objstate = "Deferred") or(AvDeferralRequestRef.DeferralRequestStatus in("Pending", "Approved")) or(AvDeferralRequestRef.MocRequired = false)];
      editable = [false];
   }
   field AvDeferralRequestRef.Note {
      label = "Deferral Note";
      visible = [(Objstate = "Deferred") or(AvDeferralRequestRef.DeferralRequestStatus in("Pending", "Approved")) or(AvDeferralRequestRef.MocRequired = false)];
      editable = [false];
      multiline = true;
   }
}
group ActionGroup for AvFault {
