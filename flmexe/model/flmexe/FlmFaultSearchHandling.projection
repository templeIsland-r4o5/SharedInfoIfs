projection FlmFaultSearchHandling;
component FLMEXE;
layer Core;
description "Fault Search Projection";
category Users;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- MAIN ENTRY POINTS -----------------------------
entityset AvFaultSearchSet for GetFaultList;

------------------------------ ENTITY DETAILS -------------------------------


------------------------------- ENUMERATIONS --------------------------------
enumeration FaultStatus {
   value = "Open";
   value = "Deferred";
   value = "Closed";
   value = "NoFaultFound";
}

enumeration OwnerType {
   value = "MM";
   value = "MX";
}


---------------------------------- QUERIES ----------------------------------
query GetFaultList {
   from = "Aggregate_Fault_View";
   where = "aggregate_id IS NOT NULL";
   lu = none;
   timestamptzref = "server";

   attribute AggregateId Text;
   attribute MmId Number;
   attribute MxId Text;
   attribute LogbookReference Text;
   attribute Owner Enumeration(OwnerType);
   attribute Description Text;
   attribute DeferralReqReasonDesc Text;
   attribute DeferralAuthorization Text;
   attribute DueDate Timestamp;
   attribute Status Enumeration(FaultStatus);
   attribute ClosedDate Timestamp;
   attribute Aircraft Text;
   attribute RegCode Text;
   attribute AircraftTypeCode Text;
   attribute SubSystem Text;
   attribute FoundOnDate Timestamp;
   attribute LogbookTypeCode Text;
   attribute LastActionDesc Text;
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute FaultSeverity Text {
      label = "Fault Severity";
   }

}

---------------------------------- ACTIONS ----------------------------------

--------------------------------- FUNCTIONS ---------------------------------

-------------------------------- STRUCTURES ---------------------------------

--------------------------------- VIRTUALS ----------------------------------


--------------------------------- SUMMARIES ---------------------------------


-------------------------------- SINGLETONS ---------------------------------
