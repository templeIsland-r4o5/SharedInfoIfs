---------------------------------- DIALOGS ----------------------------------
assistant FluidServicingAssistant using FluidServiceVrtSet {
   label = "Record Fluid Servicing";
   savemode = OnLostFocus;
   input this;
   init command {
      variable InitStructRec Structure(FluidInitStruct);
      execute {
         set AircraftId = AircraftId;
         set FlightId = FlightId;
         call GetInitData(AircraftId, FlightId) into InitStructRec;
         set AircraftType = InitStructRec.AircraftType;
         set RegCode = InitStructRec.RegCode;
         set ArrivalTime = InitStructRec.ArrivalTime;
         set DepartureTime = InitStructRec.DepartureTime;
         set UptakeLocation = InitStructRec.UptakeLocation;
         set AircraftLabel = "${RegCode}(${AircraftType}) ";
         set FlightLegNo = InitStructRec.FlightLegNo;
         set FluidServiceDefId = InitStructRec.DefFluidServiceDef;
      }
   }
   steps {
      step {
         group ServiceDefinitionHeaderGroup;
         list AssemblyServiceDefinitionList(FluidServiceDetVirtualArr);
         group SignatureDetailsGroup;
         command Sign;
      }
      final step {
      }
   }
   finish command {
      label = "Finish";
      execute {
         call SaveAndFinish();
         success("Fluid Uptake Recorded.");
         exit OK;
      }
   }
   cancel command {
      execute {
         exit CANCEL;
      }
   }
}

