--------------------------------- COMMANDS ----------------------------------
command NavigateFaultDetail for ClosedFaultsQuery {
   label = "Details";
   variable Ownership Text;
   icon = "popup";

   execute {
      call CheckClosedFaultOwnership(FaultId) into Ownership;

      if [Ownership = "MX"] {
         navigate "page/MxFaultDetail/FaultDetails?$filter=Barcode eq $[Barcode]";
      }
      else {
         navigate "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
      }

   }
}
