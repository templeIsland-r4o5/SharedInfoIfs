list CriticalItemList for AvCriticalItem {
   orderby = Objstate, UpdatedDateTime;
   crudactions {
      new {
         enabled = [(parent.Objstate in("Active", "Committed", "InWork")) and(parent.IsHangarCrewLead or parent.IsHangarSupervisor)];
      }
      edit {
         enabled = [(parent.Objstate in("Active", "Committed", "InWork")) and Objstate != "Completed" and(parent.IsHangarCrewLead or parent.IsHangarSupervisor)];
      }
      delete {
         enabled = [(parent.Objstate in("Active", "Committed", "InWork")) and(Objstate = "Active") and(parent.IsHangarCrewLead or parent.IsHangarSupervisor)];
      }
      duplicate {
         enabled = [(parent.Objstate in("Active", "Committed", "InWork")) and(parent.IsHangarCrewLead or parent.IsHangarSupervisor)];
      }
      after command RefreshCriticalItem;
   }

   field CriticalItem {
      label = "Critical Item";
      editable = [Objstate != "Completed"];
      required = [true];
      size = Large;
      multiline = true;
   }

   lov AvCriticalItemTypeRef with AvCriticalItemTypeSelector using GetCriticalItemTypeCode {
      label = "Critical Item Type";
      editable = [Objstate != "Completed"];
      size = Medium;
      description = AvCriticalItemTypeRef.Description;
   }

   lov AvCriticalItemSeverityRef with AvCriticalItemSeveritySelector using GetCriticalItemSeverityCode {
      label = "Critical Item Severity";
      editable = [Objstate != "Completed"];
      size = Medium;
      description = AvCriticalItemSeverityRef.Description;
   }

   lov AvExeTaskRef with TaskNameBarcodeSelector using GetAvExeTask(parent.AircraftWorkPackageId) {
      label = "Task Name";
      editable = [Objstate != "Completed"];
      description = AvExeTaskRef.Description;
      search = AvExeTaskRef.Description, AvExeTaskRef.Barcode;
      hidekey = [true];
      validate command {
         execute {
            set TaskBarcode = AvExeTaskRef.Barcode;
            set TaskName = AvExeTaskRef.Description;
            set TaskSeq = AvExeTaskRef.TaskSeq;
            set AircraftWpId = parent.AircraftWorkPackageId;
         }
      }
   }

   static TaskBarcode {
      label = "Task Barcode";
   }

   field UpdatedUser {
      label = "Updated User";
      editable = [false];
   }

   field UpdatedDateTime {
      label = "Updated Date";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      editable = [false];
   }

   badge Objstate {
      label = "Status";
      emphasis StatePreliminary = [Objstate = "Active"];
      emphasis Complementary9 = [Objstate = "Completed"];
      size = Small;
   }

   command CompleteCriticalItem {
      mode = SingleRecord;
      visible = [parent.IsHangarCrewLead or parent.IsHangarSupervisor];
   }
}

list SignOffReqList for AvWpSignOffReq {
   label = "";

   crudactions {
      new {
         enabled = [parent.Objstate in("Active", "Committed", "InWork")];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }

   lov WpSignOffSkillLovRef with ResourceGroupLovSelector using GetWpSignOffSkills(parent.AircraftWorkPackageId) {
      label = "Required Skill";
      required = [true];
   }

   badge SignOffStatus {
      label = "Sign Status";
      editable = [false];
      emphasis Ok = [SignOffStatus = "Signed"];
      emphasis Warning = [SignOffStatus = "Pending"];
   }
   field SignedUser {
      label = "Signed By";
   }
   field SignedDate;

   command RemoveWpSignOffSkill {
      enabled = [parent.Objstate in("Active", "Committed", "InWork")];
      mode = SingleRecord;
      icon = "delete";
   }
}

---------------------------------- DIALOGS ----------------------------------

@DynamicComponentDependency ADCON
assistant ConnectContractLineAssistant using ContractLinesVirtualSet {
   label = "Connect Contract Line";
   savemode = OnFinish;
   input this;
   singlestep {
      group ConnectContractLineGroup;
   }
   command AddContractCommand {
      label = "Save";
      visible = [ContractGroupVirtualRef != null and HmContractLineVirtualRef != null];
   }
   command Cancel;
}

command CompleteCriticalItem for AvCriticalItem {
   label = "Complete";
   emphasis Complementary9 = [true];
   mode = SingleRecord;
   enabled = [Objstate = "Active"];
   execute {
      confirm("Do you want to complete the Critical Item [${CriticalItem}]?") {
         when OK {
            call CompleteWorkPackageCriticalItem(CriticalItemId);
            refresh;
         }
         when CANCEL {
            exit;
         }
      }
   }
}
command RefreshCriticalItem for AvCriticalItem {
   execute {
      call Refresh();
   }
}

command RemoveWpSignOffSkill for AvWpSignOffReq {
   label = "";
   mode = SingleRecord;
   execute {
      if[IsMtxOriginated = 0] {
         confirm("Do you want to remove the sign off skill requirement?") {
            when OK {
               call DeleteWpSignOffSkill(AircraftWpId, WpSignOffReqSeq);
            }
            when CANCEL {
               exit;
            }
         }
      }
      if[IsMtxOriginated = 1] {
         messagebox("", warning, "Skill requirements published from CAMO cannot be removed.") {
            when "OK" {
               exit;
            }
         }
      }
   }
}

