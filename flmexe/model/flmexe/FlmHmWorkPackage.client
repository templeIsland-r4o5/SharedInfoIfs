client FlmHmWorkPackage;
component FLMEXE;
layer Core;
projection FlmHmWorkPackageHandling;
description "This client is used to develop Hangar Maintenance Work Package Page";

--------------------------------- FRAGMENTS ---------------------------------
include fragment LaborSummary;
include fragment AircraftLovSelector;
include fragment CustomerInfoCustcategoryPubSelector;
include fragment FlmPanelTasks;
include fragment AvCriticalItem;
include fragment AvTurnMaterial;
include fragment AvTurnReturn;
@DynamicComponentDependency ADCON
include fragment ConnectContractInfo;
include fragment FlmHmPreviewRelease;
include fragment FlmTaskToolList;
----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator {
   entry HmWorkPackageNavEntry parent FlmexeNavigator.HangarMaintenanceExecution at index 2200 {
      label = "Hangar Maintenance Work Package";
      page FlmHmWorkPackagePage;
   }
}
-------------------------------- MAIN PAGES ---------------------------------
page FlmHmWorkPackagePage using AvAircraftHMWorkPackageSet {
   label = "Hangar Maintenance Work Package";
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [Objstate in("Active", "Committed")];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   editmode = MultiField;
   selector WorkPackageSelector;
   markdowntext {
      visible = [SensitiveTaskCount = 1];
      text = "1 task may need attention due to sensitivities.";
      emphasis Warning = [true];
   }
   markdowntext {
      visible = [SensitiveTaskCount > 1];
      text = "${SensitiveTaskCount} tasks may need attention due to sensitivities.";
      emphasis Warning = [true];
   }
   markdowntext {
      visible = [OngoingTaskCount = 0 and Objstate = "InWork"];
      text = "WORK PACKAGE IS READY TO CLOSE";
      emphasis Warning = [true];
   }
   markdowntext {
      visible = [Objstate = "Completed"];
      text = "WORK PACKAGE CLOSED";
      emphasis Ok = [true];
   }
   group HmWorkPackage;
   group HmWorkPackageTimeSummary;
   tabs {
      tab {
         label = "Workscope";
         list TaskList(AvExeTaskArray) {
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
      }
      tab {
         label = "Faults";
         list FaultsList(FaultArray) {
            details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
         }
      }
      tab {
         label = "MPC Open Tasks";
         list MpcOpenList(AvExeTaskArray) {
            filter = [ClassCode = "MPC" and SubclassCode = "MPCOPEN"];
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list MaintTaskList(MaintTasksForOpenTaskArray) bind MpcOpenList {
            label = "Maintenance Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list MpcCloseForOpenPanelsList(CloseTaskForOpenTaskArray) bind MpcOpenList {
            label = "MPC Close Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
      }
      tab {
         label = "MPC Close Tasks";
         list MpcCloseList(AvExeTaskArray) {
            filter = [ClassCode = "MPC" and SubclassCode = "MPCCLOSE"];
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list MaintTaskForClosePanelsList(MaintTasksForCloseTaskArray) bind MpcCloseList {
            label = "Maintenance Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list MpcOpenForClosePanelsList(OpenTaskForCloseTaskArray) bind MpcCloseList {
            label = "MPC Open Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
      }
      tab {
         label = "Materials";
         list AvMatReqList(MaintMaterialReqArray) {
            searchcontext RepairablePartSearchContext {
               defaults = GetRepairableSearchContextDefaults();
            }
            filter = [IsRepairable = true or IsRepairable = searchcontext.RepairablePartSearchContext.IsRepairable];
         }
      }
      tab {
         label = "Part Removals";
         list PartRemoveList(PartRemovalViewArray) {
            searchcontext RepairablePartSearchContext {
               defaults = GetRepairableSearchContextDefaults();
            }
            filter = [IsRepairable = true or IsRepairable = searchcontext.RepairablePartSearchContext.IsRepairable];
         }
         list TaskPartWarningsList(TaskPartRemovalWarningArray) bind PartRemoveList {
            display = Nested;
         }
      }
      tab {
         label = "Part Installations";
         list PartInstallationList(PartInstallationViewArray) {
            searchcontext RepairablePartSearchContext {
               defaults = GetRepairableSearchContextDefaults();
            }
            filter = [IsRepairable = true or IsRepairable = searchcontext.RepairablePartSearchContext.IsRepairable];
         }
         list TaskPartWarningsList(TaskPartInstallationWarningArray) bind PartInstallationList {
            display = Nested;
         }
      }
      tab {
         label = "Returns";
         list ReturnLineList(JtTaskReturnArray);
      }
      tab {
         label = "Unassigned Faults";
         list UnassignedFaultList(DeferredFaultArray) {
            filter = [FaultState = "Deferred"];
            details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
         }
      }
      tab {
         label = "Labor Summary";
         list LaborSummaryTotalsList(LaborSummaryTotalsArray);
         list LaborSummaryBreakdownList(LaborSummaryBreakdownArray);
      }
      tab {
         label = "Critical Items";
         list CriticalItemList(CriticalItemArray);
      }
      tab {
         label = "Tools";
         list ToolDemandsList(HmToolDemandQueryArray);
      }
      tab {
         label = "Sign-off Skills";
         list SignOffReqList(AvWpSignOffReqArray);
      }
   }
   command StartWorkPackageCommand;
   command PreviewReleaseCommand;
   command CompleteWorkPackageCommand;
   command WpCommercialsCommand;
   attachments {
      enabled = [true];
   }
}

searchcontext RepairablePartSearchContext for ShowOnlyRepairableStructure {
   label = "";
   field IsRepairable {
      label = "Repairable Only";
   }
}
--------------------------------- COMMANDS ----------------------------------
command StartWorkPackageCommand for AvAircraftWorkPackage {
   label = "Start Work Package";
   mode = Global;
   enabled = [Objstate = "Committed"];
   execute {
      call StartHangarWorkPackage(AircraftWorkPackageId);
   }
}

command ConnectContractLines for AvExeTask {
   label = "Connect Contract Line(s)";
   visible = [not(Objstate = "FINISHED" or Objstate = "WORKSTARTED" or Objstate = "CANCELLED") and AircraftWorkPackageRef.HmContractId != null];
   mode = SelectedRecords;
   variable ConnectContractLinesInfo Structure(ContractLineInfoStructure);
   bulkexecute {
      ifany [HmNonRoutineApprovalRef.NeedCommercialApproval
      and HmNonRoutineApprovalRef.Objstate in("AwaitingApproval", "Approved", "Rejected")] {
         error("You cannot change the contract line connected to a corrective task(s) if its non-routine needs commercial approval and the approval request status is Approved, Awaiting Approval, or Rejected.");
         exit;
      }

      ifany [HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.Objstate in("NotStarted")] {
         confirm("Changing the contract line of a corrective task(s) also removes its non-routine approval request if the status of it is Not Started. Do you want to proceed?") {
            when OK {
               call GetConnectContractLinesInfo(component.TaskList.Selection) into ConnectContractLinesInfo;
               @DynamicComponentDependency ADCON
               assistant ConnectContractLineAssistant(ConnectContractLinesInfo) {
                  when OK {
                     exit;
                  }
               }
            }
            when CANCEL {
               exit;
            }
         }
      }
      else {
         ifany [not HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.Objstate in("Approved")] {
            confirm("Are you sure you want to change the connected contract line of the selected task(s)?") {
               when OK {
                  call GetConnectContractLinesInfo(component.TaskList.Selection) into ConnectContractLinesInfo;
                  @DynamicComponentDependency ADCON
                  assistant ConnectContractLineAssistant(ConnectContractLinesInfo) {
                     when OK {
                        exit;
                     }
                  }
               }
               when CANCEL {
                  exit;
               }
            }
         }
         else {
            call GetConnectContractLinesInfo(component.TaskList.Selection) into ConnectContractLinesInfo;
            @DynamicComponentDependency ADCON
            assistant ConnectContractLineAssistant(ConnectContractLinesInfo) {
               when OK {
                  exit;
               }
            }
         }
      }
   }
}

@DynamicComponentDependency ADCON
command AddContractCommand for ContractLinesVirtual {
   execute {
      call UpdateSelectedTaskContract(Selection, HmContractLineNo, HmContractId);
   }
}

command DisconnectContractLines for AvExeTask {
   label = "Disconnect Contract Line(s)";
   visible = [not(Objstate = "FINISHED" or Objstate = "WORKSTARTED" or Objstate = "CANCELLED") and AircraftWorkPackageRef.HmContractId != null and count(*, HmContractLineRef != null) > 0];
   mode = SelectedRecords;
   variable HmContractLineNo Number;
   variable HmContractId Text;
   bulkexecute {
      ifany [HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.Objstate in("AwaitingApproval", "Approved", "Rejected")] {
         error("You cannot disconnect the contract line connected to a corrective task(s) if its non-routine needs commercial approval and the approval request is Approved, Awaiting Approval, or Rejected.");
      }
      else {
         ifany [HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.Objstate = "NotStarted"] {
            confirm("Disconnecting the contract line from a corrective task(s) also removes its non-routine approval request if the status of it is Not Started. Do you want to proceed?") {
               when OK {
                  call UpdateSelectedTaskContract(Selection, HmContractLineNo, HmContractId);
                  exit OK;
               }
               when CANCEL {
                  exit;
               }
            }
         }
         else {
            confirm("Are you sure you want to disconnect the connected contract line from the selected task(s)?") {
               when OK {
                  call UpdateSelectedTaskContract(Selection, HmContractLineNo, HmContractId);
                  exit OK;
               }
               when CANCEL {
                  exit;
               }
            }

         }
      }
   }
}
command WpCommercialsCommand {
   label = "Work Package Commercials";
   execute {
      navigate "page/FlmHmWorkPackageCommercials/FlmHmWorkPackageCommercialsPage?$filter=Barcode eq $[Barcode]";
   }
}

--------------------------------- SELECTORS ---------------------------------
selector WorkPackageSelector for AvAircraftWorkPackage {
   label = "${Barcode}";
   static Barcode {
      label = "Barcode";
   }
   static WorkPackageName {
      label = "WP Name";
   }
   static Aircraft {
      label = "Aircraft";
   }
   static LocationCode {
      label = "Location";
   }
   badge Objstate {
      label = "Status";
      showlabel = false;
      emphasis StateCreated = [Objstate = "Active"];
      emphasis StatePlanned = [Objstate = "Committed"];
      emphasis StateInProgress = [Objstate = "InWork"];
      emphasis StateCompleted = [Objstate = "Completed"];
      emphasis StateClosed = [Objstate = "Canceled"];
      size = Small;

   }
}

selector BarcodeSelector for AvExeTask {
   static Barcode;
   static TaskSeq;
}

selector TaskNameBarcodeSelector for AvExeTask {
   static Description;
   static Barcode;
   static TaskSeq;
}
@Override
@DynamicComponentDependency ADCON
selector ReferenceHmContractGroupSelector for HmContractGroup {
   static ContractId;
   static ContractGroup;
   static ContractGroupDescription;
}

@Override
@DynamicComponentDependency ADCON
selector ReferenceHmContractLineLovSelector for HmContractLineLov {
   static LineNo;
   static Description;
   static ValidFrom;
   static ExpiryDate;
   static ContractGroup;
   static CommercialRule;
   static PrimaryLine;
}

selector ResourceGroupLovSelector for WpSignOffSkillLov {
   label = "";
   static ResourceId;
   static Description;
}

---------------------------------- GROUPS -----------------------------------
group HmWorkPackage for AvAircraftWorkPackage {
   label = "Work Package Details";
   field Barcode {
      label = "Work Package Barcode";
      editable = [false];
   }
   field WorkPackageName {
      editable = [false];

   }
   field WorkType {
      editable = [false];
   }
   badge Objstate {
      label = "Work Package Status";
      editable = [false];
      emphasis StateCreated = [Objstate = "Active"];
      emphasis StatePlanned = [Objstate = "Committed"];
      emphasis StateInProgress = [Objstate = "InWork"];
      emphasis StateCompleted = [Objstate = "Completed"];
      emphasis StateClosed = [Objstate = "Canceled"];
   }
   lov AircraftRef with ReferenceAircraftLovSelector {
      label = "Aircraft";
      editable = [false];
   }
   field LocationCode {
      label = "Work Location";
      editable = [false];
   }
   field DurationInHours {
      label = "Duration (HH:MM)";
      editable = [false];
   }
   lov CustomerNoRef with ReferenceCustomerInfoCustcategoryPubSelector {
      label = "Customer";
      search = CustomerId, Name;
      description = CustomerNoRef.Name;
      required = [HmContractRef != null];

      validate command {
         variable IsContractValidForCustomer Boolean;
         execute {
            @DynamicComponentDependency ADCON
            call IsContractValidForCustomer(CustomerNoRef.CustomerId, HmContractId) into IsContractValidForCustomer;
            if [HmContractRef != null and CustomerNoRef = null] {
               info("Customer must be selected to keep the Contract ID linked");
               set HmContractId = null;
            }
            if [not IsContractValidForCustomer] {
               set HmContractId = null;
            }
         }
      }

      contactwidget {
         enabled = [CustomerNoRef != null];
         source = Customer;
      }
   }
   @DynamicComponentDependency ADCON
   lov HmContractRef with ReferenceHeavyMaintenanceContractSelector using GetContractIdsByCustomer(CustomerNoRef.CustomerId, LocationCode) {
      search = ContractId, ContractName;
      description = HmContractRef.ContractName;
      required = [CustomerNoRef != null];

      validate command {
         variable IsTasksConnectedWithContract Boolean;
         execute {
            call IsTasksConnectedWithContract(AircraftWorkPackageId) into IsTasksConnectedWithContract;
            call GetPrimaryCustomer(CustomerNoRef.CustomerId, HmContractId) into CustomerNo;
            if [HmContractRef = null and IsTasksConnectedWithContract = true] {
               confirm("This removes the connected contract lines as well from the tasks. Do you want to proceed?") {
                  when OK {
                     exit OK;
                  }
                  when CANCEL {
                     call Refresh();
                     exit CANCEL;
                  }
               }
            }
         }
      }
   }
   static AOSDayCount {
      label = "AOS Days";
   }
   static TotalTaskCount {
      label = "Total Open Tasks";
   }
   static CompletedTaskCount {
      label = "Completed Tasks";
   }
   static CriticalItemCount {
      label = "Active Critical Items";
   }
}

group HmWorkPackageTimeSummary for AvAircraftWorkPackage {
   label = "Time Summary";
   field SchedStartDateTime {
      label = "Scheduled Start";
      editable = [false];
      size = Medium;
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
   }
   field SchedEndDateTime {
      label = "Scheduled End";
      editable = [false];
      size = Medium;
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
   }
   field ActualStartDateTime {
      label = "Actual Start";
      editable = [false];
      size = Medium;
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
   }
   field ActualEndDateTime {
      label = "Actual End";
      editable = [false];
      size = Medium;
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
   }
   field SchedRoutineHours {
      label = "Scheduled Routine Hours";
      editable = [false];
      size = Medium;
   }
   field ActualRoutineHours {
      editable = [false];
      size = Medium;
   }
   field SchedNonRoutineHours {
      label = "Scheduled Non-Routine Hours";
      editable = [false];
      size = Medium;
   }
   field ActualNonRoutineHours {
      label = "Actual Non-Routine Hours";
      editable = [false];
      size = Medium;
   }
}
@DynamicComponentDependency ADCON
group ConnectContractLineGroup for ContractLinesVirtual {
   lov ContractGroupVirtualRef with ReferenceHmContractGroupSelector using GetContractGroupsByWp(AircraftWpId) {
      search = ContractGroup, ContractGroupDescription;
      description = HmContractGroupDescription;
      validate command {
         execute {
            call GetPrimaryContractLine(HmContractId, ContractGroupVirtualRef.ContractGroup) into HmContractLineNo;
            set ContractGroup = ContractGroupVirtualRef.ContractGroup;
         }
      }
   }


   lov HmContractLineVirtualRef with ReferenceHmContractLineLovSelector using GetContractLines(AircraftWpId, ContractGroup) {
      search = LineNo, Description;
      description = HmContractLineDescription;
      validate command {
         execute {
            call GetContractGroupForContractLine(HmContractId, HmContractLineVirtualRef.LineNo) into ContractGroup;
            set LineNo = HmContractLineVirtualRef.LineNo;
         }
      }
   }
}
----------------------------------- LISTS -----------------------------------
list TaskList for AvExeTask {
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [true];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   lov AvBarcodeRef with BarcodeSelector {
      label = "Barcode";
      details = "page/FlmTaskDetail/MyWorkPage?$filter=Barcode eq $[Barcode]";
      editable = [false];

   }
   field Description {
      label = "Name";
      editable = [false];
      size = Large;
      multiline = true;
   }
   badge Sensitivities {
      emphasis Warning = [true];
      columnvisible = [parent.SensitiveTaskCount != 0];
      editable = [false];
   }
   badge Objstate {
      label = "Task Status";
      emphasis StatePreliminary = [Objstate = "RELEASED"];
      emphasis StateInProgress = [Objstate = "WORKSTARTED"];
      emphasis StateCompleted = [Objstate = "FINISHED"];
      emphasis Alert = [Objstate = "REMOVED"];
      emphasis Neutral = [Objstate = "CANCELLED"];
      editable = [false];
   }
   field PriorityId {
      label = "Task Priority";
   }
   field MaterialAvailUserStatus {
      label = "Old Material Availability";
      columnvisible = [false];
   }
   badge MaterialAvailabilityStatus {
      label = "Material Availability";
      editable = [false];
      emphasis Neutral = [MaterialAvailabilityStatus = "N/A"];
      emphasis Warning = [MaterialAvailabilityStatus = "Open"];
      emphasis Complementary7 = [MaterialAvailabilityStatus = "On Order"];
      emphasis Complementary7 = [MaterialAvailabilityStatus = "Remote"];
      emphasis Ok = [MaterialAvailabilityStatus = "Available"];
      emphasis Ok = [MaterialAvailabilityStatus = "Issued"];
      emphasis Complementary7 = [MaterialAvailabilityStatus = "Processing"];
   }
   field TaskDuration {
      label = "Scheduled Hours";
      editable = [false];
   }
   field PlannedStart {
      label = "Scheduled Start";
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field PlannedFinish {
      label = "Scheduled End";
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field CrewCode {
      label = "Crew";
      editable = [false];
   }
   field ActualStart {
      label = "Actual Start";
      editable = [false];
   }
   field ActualFinish {
      label = "Actual End";
      editable = [false];
   }
   field ConfigPosition {
      editable = [false];
   }
   field ClassCode {
      label = "Class";
      editable = [false];
   }
   field SubclassCode {
      label = "Subclass";
      editable = [false];
   }
   field Location {
      label = "Task Location";
      editable = [false];
   }
   field IsRoutine {
      label = "Routine";
      editable = [false];
   }
   field CrewName {
      editable = [false];
   }
   field LongDescription {
      label = "Task Description";
      editable = [false];
   }
   @DynamicComponentDependency ADCON
   lov ContractGroupRef with ReferenceHmContractGroupSelector using GetContractGroupsByWp(AircraftWpId) {
      editable = [false];
      search = ContractGroup, ContractGroupDescription;
      description = ContractGroupRef.ContractGroupDescription;

      validate command {
         execute {
            call GetPrimaryContractLine(HmContractId, ContractGroupRef.ContractGroup) into HmContractLineNo;
            set ContractGroup = ContractGroupRef.ContractGroup;
            set HmContractId = ContractGroupRef.ContractId;
         }
      }
   }
   @DynamicComponentDependency ADCON
   lov HmContractLineRef with ReferenceHmContractLineLovSelector using GetContractLines(AircraftWpId, ContractGroup) {
      editable = [false];
      search = LineNo, Description;
      description = HmContractLineRef.Description;

      validate command {
         execute {
            call GetContractGroupForContractLine(HmContractId, HmContractLineRef.LineNo) into ContractGroup;
            set LineNo = HmContractLineRef.LineNo;
            set HmContractId = HmContractLineRef.ContractId;
         }
      }
   }
   @DynamicComponentDependency ADCON
   badge HmNonRoutineApprovalRef.ApprovalStatus {
      label = "NR Approval Status";
      emphasis Primary = [HmNonRoutineApprovalRef.ApprovalStatus = "NotStarted"];
      emphasis Complementary6 = [HmNonRoutineApprovalRef.ApprovalStatus = "AwaitingApproval"];
      emphasis Success = [HmNonRoutineApprovalRef.ApprovalStatus = "Approved"];
      emphasis False = [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"];
   }
   @DynamicComponentDependency ADCON
   field HmNonRoutineApprovalRef.ProceedAtRisk;
   @DynamicComponentDependency ADCON
   field HmNonRoutineApprovalRef.NeedCommercialApproval;

   command ConnectContractLines;
   command DisconnectContractLines;
}

list MpcOpenList for AvExeTask clone TaskList {
   label = "";
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }
   badge Sensitivities {
      emphasis Warning = [true];
      columnvisible = [parent.SensitiveMPCOpenTaskCount != 0];
   }
   exclude ConnectContractLines, DisconnectContractLines;
}

list MpcCloseList for AvExeTask clone TaskList {
   label = "";
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }
   badge Sensitivities {
      emphasis Warning = [true];
      columnvisible = [parent.SensitiveMPCCloseTaskCount != 0];
   }
   exclude ConnectContractLines, DisconnectContractLines;
}

list FaultsList for AvFault {
   label = "Faults";

   orderby = FoundOnDate desc;
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
   }
   field Barcode;
   field Description {
      label = "Name";
      multiline = true;
   }
   badge Sensitivities {
      emphasis Warning = [true];
      columnvisible = [parent.SensitiveFaultCount != 0];
   }
   field AvAircraftSubSystemRef.SubSystemCode {
      label = "Failed System";
   }
   field FoundSource {
      label = "Found During";
   }
   field FoundOnDate {
      label = "Found On";
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
   }
   field FaultSeverityCode {
      label = "Fault Severity";
   }
   badge Objstate {
      label = "Status";
      style = TextOnly;
      emphasis Complementary7 = [Objstate = "Open"];
      emphasis Info = [Objstate = "Deferred"];
      emphasis Ok = [Objstate = "Closed"];
   }
   badge IsCmsWarningsExist {
      label = "Configuration Warning";
      size = Small;
      style = TextOnly;
      emphasis Alert = [IsCmsWarningsExist = true];
      emphasis Ok = [IsCmsWarningsExist = false];
   }
   field LongDescription {
      label = "Description";
      multiline = true;
   }
   field Priority {
