projection FlmToolEquipmentCheckOutHistoryHandling;
component FLMEXE;
layer Core;
description "Tool/Equipment Check Out History in flm";
category Users;

--------------------------------- FRAGMENTS ---------------------------------
include fragment ToolEquipmentCheckOutHist;
include fragment WorkTaskAllSelector;
----------------------------- MAIN ENTRY POINTS -----------------------------


------------------------------ ENTITY DETAILS -------------------------------


------------------------------- ENUMERATIONS --------------------------------


---------------------------------- QUERIES ----------------------------------

@Override
query ToolEquipmentCheckOutHistory {
   where = "(flm_task_id IS NOT NULL OR order_ref1 IS NULL)";

   attribute WoNumber Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Wo_Number(order_ref2)";
   }
   attribute TaskSite Text {
      label = "Demand Site";
      fetch = "Work_Task_API.Get_Site(order_ref1)";
   }
   reference TaskSeqRef(Barcode) to AvExeTask(Barcode);
}
