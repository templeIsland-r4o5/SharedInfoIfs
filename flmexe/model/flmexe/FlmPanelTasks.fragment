--  Date    Sign    History
--  ------  ------  ---------------------------------------------------------
--  250604  SABOLK  AD-18384, Added MpcTasksForMaintenanceTaskList, MpcBarcodeSelector, and MpcTasksForMaintTaskQuery to accommodate to display mpc tasks for a maint task panel.
-----------------------------------------------------------------------------

fragment FlmPanelTasks;
component FLMEXE;
layer Core;
description "This contains all the maintenance and open or close panel tasks for a specific panel task";

--------------------------------- FRAGMENTS ---------------------------------
include fragment PanelLovSelector;
include fragment ZoneLovSelector;
----------------------------- CLIENT FRAGMENTS ------------------------------

--------------------------------- SELECTORS ---------------------------------
selector MaintBarcodeSelector for MaintTasksForPanelsQuery {
   static Barcode;
   static TaskSeq;
}

selector CloseBarcodeSelector for CloseTaskForOpenPanelsQuery {
   static Barcode;
   static TaskSeq;
}

selector OpenBarcodeSelector for OpenTaskForClosePanelsQuery {
   static Barcode;
   static TaskSeq;
}

selector MpcBarcodeSelector for MpcTasksForMaintTaskQuery {
   static Barcode;
   static TaskSeq;
}

selector MpcMaintBarcodeSelector for MaintTasksForPanelTasksQuery {
   static Barcode;
   static TaskSeq;
}


----------------------------------- LISTS -----------------------------------
list MaintTaskList for MaintTasksForPanelsQuery {
   crudactions {
      new {
         enabled = [false];
      }
      edit {
         enabled = [true];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   lov AvBarcodeRef with MaintBarcodeSelector {
      label = "Barcode";
      details = "page/FlmTaskDetail/MyWorkPage?$filter=Barcode eq $[Barcode]";
      editable = [false];
   }
   field Description {
      label = "Name";
      editable = [false];
      size = Large;
      multiline = true;
   }
   badge Objstate {
      label = "Task Status";
      emphasis StatePreliminary = [Objstate = "RELEASED"];
      emphasis StateInProgress = [Objstate = "WORKSTARTED"];
      emphasis StateCompleted = [Objstate = "FINISHED"];
      emphasis Alert = [Objstate = "REMOVED"];
      emphasis Neutral = [Objstate = "CANCELLED"];
      editable = [false];
   }
   field PlannedStart {
      label = "Scheduled Start";
      displaytimezone = MaintenanceLocationTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
}


