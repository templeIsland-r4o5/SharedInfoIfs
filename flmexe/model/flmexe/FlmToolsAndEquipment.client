client FlmToolsAndEquipment;
component FLMEXE;
layer Core;
projection FlmToolsAndEquipmentHandling;
description "View Tool Inventories";

--------------------------------- FRAGMENTS ---------------------------------
include fragment ToolsAndEquipmentBase;
----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator {
   entry AviationToolsAndEquipmentNavEntry parent MxCoreNavigator.AviationToolsAndEquipment at index 20 {
      label = "Tool Inventories";
      page ToolInventoriesPage;
   }
}
-------------------------------- MAIN PAGES ---------------------------------
page ToolInventoriesPage using ResourceToolEquipSet {
   label = "Tool Inventories";
   list ToolEquipmentList;
}

