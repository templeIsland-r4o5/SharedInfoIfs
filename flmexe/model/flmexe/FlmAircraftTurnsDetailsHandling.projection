action LoadServiceDetails {
   initialcheck none;
   parameter AssemblyTypeCode Text;
   parameter FluidServiceDefId Number;
   parameter AircraftId Number;
   parameter Objkey Text;
}

action AddActualDateTime Timestamp {
   initialcheck none;
   ludependencies = AvExeTask;
   timestamptzref = "server";

}
action PackageOpenFault {
   initialcheck none;
   parameter FaultId Number;
   parameter FlightId Number;
   parameter AircraftWorkPackageId Number;
   ludependencies = AvFault, AvFlight, AvExeTask;
}
action ClearReleaseAircraftVirtual {
   initialcheck none;
}

action UpdateTaskStart {
   initialcheck none;
   parameter TaskSeq Number;
   ludependencies = AvExeTask, AvAircraftWorkPackage, AvFlight;
}

action UpdateTaskUnstart {
   initialcheck none;
   parameter TaskSeq Number;
   ludependencies = AvExeTask, AvAircraftWorkPackage, AvFlight;
}

action CheckClosedFaultOwnership Text {
   initialcheck none;
   parameter FaultId Number;
   ludependencies = AvExeTask, AvAircraftWorkPackage, AvFlight;
}

--------------------------------- FUNCTIONS ---------------------------------
function GetInitData Structure(FluidInitStruct) {
   timestamptzref = "server";

   parameter AircraftId Number;
   parameter FlightId Number;
}

structure FluidInitStruct {
   timestamptzref = "server";

   attribute AircraftType        Text;
   attribute RegCode             Text;
   attribute ArrivalTime         Timestamp;
   attribute DepartureTime       Timestamp;
   attribute UptakeLocation      Text;
   attribute FlightLegNo         Text;
   attribute DefFluidServiceDef  Text;
}


function GetFluidDefinitionsForAircraftType List<Entity(AvFluidServiceDef)> {
   parameter AssemblyTypeCode Text;
}

function GetFindInventoryUrl Text {
   parameter ExternalPagePath Text;
   parameter SearchType Text;
   parameter AircraftRegCode Text;
   parameter IataCode Text;
   parameter TaskNameRef Text;
}

function CheckInworkWp Boolean {
   parameter AircraftId Number;
   parameter Location Text;
}

function GetRepairableSearchContextDefaults Structure(ShowOnlyRepairableStructure);
-------------------------------- STRUCTURES ---------------------------------
structure ReleaseAircraftInfoStructure {
   attribute AircraftWpId Number;
   attribute AircraftId Number;
   attribute FlightId Number;
   attribute CmsFailedWarnings Boolean;
   attribute CmsPendingWarnings Boolean;
   attribute KeyRef Text;
   attribute LuName Text;
}

structure RaiseFaultInfoStructure {
   attribute AircraftId Number;
   attribute AircraftWpId Number;
   attribute FoundOnId Number;
   attribute Source Text;
   attribute Title Text;
}

structure FluidServicingInfoStructure {
   attribute AircraftId Number;
   attribute FlightId Number;
}

structure ShowOnlyRepairableStructure {
   attribute IsRepairable Boolean("TRUE", "FALSE") {
      required = [true];
   }
}
--------------------------------- VIRTUALS ----------------------------------
virtual FluidServiceVirtual {
   timestamptzref = "server";
   ludependencies = FluidServiceDetVirtual;

   action SaveAndFinish {
      ludependencies = AvHistFluidService, FluidServiceDetVirtual, FluidServiceVirtual, AvFlight;
   }

   attribute AircraftId       Number;
   attribute RecordedDate     Timestamp;
   attribute RecordedBy       Text;
   attribute RecordComment    Text;
   attribute AircraftType     Text;
   attribute FlightId          Number;
   attribute FluidServiceDefId Number;
   attribute ServiceName      Text;
   attribute RegCode          Text;
   attribute InboundFlight    Number;
   attribute ArrivalTime      Timestamp;
   attribute DepartureTime    Timestamp;
   attribute UptakeLocation   Text;
   attribute AircraftLabel    Text;
   attribute FlightLegNo      Text;
   attribute ActionUserName   Text;

   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   reference FluidServiceDefRef(FluidServiceDefId) to AvFluidServiceDef(FluidServiceDefId);
   reference AircraftRef(AircraftId) to Aircraft(AircraftId);
   array FluidServiceDetVirtualArr() to FluidServiceDetVirtual();
}

virtual FluidServiceDetVirtual {
   ludependencies = FluidServiceVirtual;
   attribute   AssemblyTypeCode     Text;
   attribute   FluidDefinitionId    Number;
   attribute   FldServiceDetId      Number;
   attribute   ConfigSlotPositionId Number;
   attribute   UptakeAmount         Number;
   attribute   Rate                 Number;
   attribute   OilStatusCode        Text;
   attribute   RecordOrder          Number;
   attribute   InventoryId          Number;
   attribute   InventoryDesc        Text;

   reference AvFluidDefinitionRef(FluidDefinitionId, AssemblyTypeCode) to AvFluidDefinition(FluidDefinitionId, AssemblyTypeCode);
   reference ConfigSlotPositionRef(ConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
}

