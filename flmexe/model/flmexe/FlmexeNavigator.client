client FlmexeNavigator;
component FLMEXE;
layer Core;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator {
   entry FlmNav parent AdcomNavigator.LineMaintenanceExecution at index 1200 {
      label = "Mobile Maintenance";
      lobby "32800a3e-6d9a-40a6-8ed5-d71f510ada05";
   }
   entry FlmBasicDataNav parent FlmexeNavigator.FlmNav at index 2000 {
      label = "Basic Data";
   }

   entry FluidNav parent MxCoreNavigator.MaintenanceOperationsControlNavEntry at index 3300 {
      label = "Fluid Consumption Control";
      lobby "f36ae1f2-7f6a-4b74-86d1-1adbd7087216";
   }

}

navigator {
   entry StationPlanningNav parent AdcomNavigator.LineMaintenance at index 3000 {
      label = "Station Planning";
   }
}

navigator {

   entry InternalVisitExecutionNav parent MxCoreNavigator.BaseMaintenance at index 5000 {
      label = "Internal Visit Execution";
   }
   entry HangarMaintenanceExecution parent MxCoreNavigator.HangarMaintenance at index 1000 {
      label = "Hangar Maintenance Execution";
   }
   entry HangarMaintenanceTechNav parent FlmexeNavigator.HangarMaintenanceExecution at index 1030 {
      label = "Hangar Maintenance Technician";
      lobby "8b4f9361-2f22-40bf-a48f-49b0e4b381d1";
   }
   entry HangarMaintenanceCrewLeadNav parent FlmexeNavigator.HangarMaintenanceExecution at index 1010 {
      label = "Hangar Maintenance Crew Lead";
      lobby "0a9a3fdf-b5e3-4325-ab78-09f1c6ff00e5";
   }
   entry HangarMainSupervisorMainLobbyNav parent FlmexeNavigator.HangarMaintenanceExecution at index 1020 {
      label = "Hangar Maintenance Supervisor";
      lobby "c34b39a9-2a38-4466-9ba5-62f97e013836";
   }
   entry HangarMainCrewLeadWPOverviewNav parent FlmexeNavigator.HangarMaintenanceCrewLeadNav at index 1000 {
      label = "Crew Lead Work Package Overview";
   }
   @DynamicComponentDependency MXCORE
   entry HangarMainSupervisorWPOverviewNav parent FlmexeNavigator.HangarMainSupervisorMainLobbyNav at index 1430 {
      label = "Supervisor Work Package Overview";
   }
   entry NonRoutineCommercialsNav parent FlmexeNavigator.HangarMaintenanceExecution at index 2300 {
      label = "Non-Routine Commercials";
   }
}

