--------------------------- PROJECTION FRAGMENTS ----------------------------
entityset AddPartsVirtualSet for AddPartsVirtual;
entityset AvConfigSlotPositionSet for AvConfigSlotPosition;
entityset InstalledPartsVirtualSet for InstalledPartsVirtual;

query PartNumbers {
   from = "Part_List";
   keys = Objkey;
   lu = none;

   attribute PartNumberId Number;
   attribute Manufacturer Text;
   attribute PartName Text;
   attribute PartNumber Text;
   attribute InventoryClassCode Text;
   attribute PartUse Enumeration(PartUseType);
   attribute MxUniqueKey Text;
   attribute AltId Text;
   attribute IsRepairable Enumeration(FndBoolean);
   attribute PartStatus Enumeration(PartStatus);
   attribute PartAssemblyTypeCode Text;
   attribute GroupApplicabilityRange Text;
   attribute PartApplicabilityRange Text;
   attribute PartGroupId Number;
   attribute PartGroupCode Text;
   attribute ConfigSlotCode Text;
   attribute ConfigSlotPosId Number;
   attribute ConfigSlotPosCode Text;
   attribute IsSos Boolean;
   attribute Objkey Text;
}

action AddFaultParts {
   initialcheck none;
   syncpolicy Online;
   parameter FaultId Number;
   parameter PartNumberId Number;
   parameter RequiredQuantity Number;
   parameter PartGroupId Number;
   parameter AssmblConfigSlotPosId Number;
   parameter ConfigSlotPositionId Number;
   parameter IncludeInstallation Boolean;
   parameter IncludeRemoval Boolean;
   parameter RemovalReasonCode Text;
   parameter InstalledSerialNo Text;
   parameter RemovalSerialNo Text;
   parameter RemovalPartNumberId Number;
   parameter RemovalPartGroupId Number;
   parameter IsRemovalReasonFilled Boolean;
   parameter Sensitivities Text;

   ludependencies = AggFaultInstPartQuery, AggFaultRemovePartQuery, AvFault;
}


action AddTaskParts {
   initialcheck none;
   syncpolicy Online;
   parameter TaskSeq Number;
   parameter PartNumberId Number;
   parameter RequiredQuantity Number;
   parameter PartGroupId Number;
   parameter AssmblConfigSlotPosId Number;
   parameter ConfigSlotPositionId Number;
   parameter IncludeInstallation Boolean;
   parameter IncludeRemoval Boolean;
   parameter RemovalReasonCode Text;
   parameter InstalledSerialNo Text;
   parameter RemovalSerialNo Text;
   parameter RemovalPartNumberId Number;
   parameter RemovalPartGroupId Number;
   parameter IsRemovalReasonFilled Boolean;
   parameter SchedulingAction Text;
   parameter RequiredDate Timestamp;
   parameter PartNumber Text;
   parameter ParentKey Text;
   parameter Sensitivities Text;
   parameter Note Text;

   ludependencies = AvInstalledParts, AvRemovedParts, AvExeTask, AddPartsVirtual, MaintMaterialReqLine, AvFault, AggFaultInstPartQuery, AggFaultRemovePartQuery;
}

action FetchAddPartDefaults Structure(AddPartDefaultsStructure) {
   initialcheck none;
   syncpolicy Online;
   supportwarnings = [true];
   parameter SourceId Number;
   parameter InventoryClassCode Text;
   parameter AssemblyPositionId Number;
   parameter ConfigSlotPositionId Number;
   parameter IsRepairable Boolean;
   parameter IsSubAssy Boolean;
   parameter SourceOfAddPart Text;
   parameter AssemblyType Text;
   parameter AircraftId Number;
}

action GetInterchangeableParts {
   initialcheck none;
   implementation = "Java";
   parameter RegCode Text;
   parameter PartNumber Text;
   parameter ManufacturerCode Text;
   parameter ConfSlotCode Text;
   parameter ConfSlotPosCode Text;
   parameter TaskSeq Number;
   parameter TaskAltId Text;
   parameter ParentKey Text;
   parameter ProjectionName Text;
   parameter IfsUser Text;
   parameter PartGroupCode Text;
   parameter InventoryClassCode Text;
   parameter AssemblyConfigSlotCode Text;
   parameter AssemblyConfigSlotPosCode Text;
   ludependencies = AlternatePartVirtual;
}

action ClearInterchangeableParts {
   initialcheck none;
   parameter ParentKey Text;
   ludependencies = AlternatePartVirtual;
}

action CancelParts {
   initialcheck none;
   parameter TaskPartId Number;

   ludependencies = AvExeTaskPart, AvFaultPart;
}

action SelectInterchangeablePart {
   initialcheck none;
   parameter PartNumber Text;
   parameter ManufacturerCode Text;
   parameter ConfSlotCode Text;
   parameter ConfSlotPosCode Text;
   parameter PartGroupCode Text;
   parameter InventoryClassCode Text;
   parameter ParentKey Text;
   ludependencies = AddPartsVirtual, AlternatePartVirtual, PartNumbers;
}

action Finish {
   initialcheck none;
   ludependencies = MaintMaterialReqLine, AvExeTaskPart, AvFaultPart;
   enabled = [QtyUnissued != null];
   supportwarnings = [true];
   parameter TaskSeq Number;
   parameter MaintMaterialOrderNo Number;
   parameter LineItemNo Number;
   parameter QtyUnissued Number;
   parameter TaskPartId Number;

}

action SaveOverallTaskSensitivity {
   initialcheck none;
   implementation = "Java";
   parameter   AircraftAltId Text;
   parameter   FaultId Number;
   parameter   EtopsSignificant Boolean;
   parameter   ConfigSlotAltId Text;
   parameter   TaskPartId Number;

   ludependencies = AvExeTask, AvFault;
}

function GetTaskAltId Text {
   syncpolicy Online;
   parameter TaskSeq Number;
}

function GetRequestPartNumber List < Entity(PartNumbers) > {
   parameter AircraftId Number;
   parameter AssemblyTypeCode Text;
   parameter AircraftAppCode Text;

   where = "Adcom_Util_API.Get_Applicability(part_applicability_range,:AircraftAppCode) = 1 AND
   Adcom_Util_API.Get_Applicability(group_applicability_range,:AircraftAppCode) = 1 AND (is_common_hardware IN('TRUE')
   OR part_assembly_type_code IN(:AssemblyTypeCode) OR part_assembly_type_code IN (SELECT s.assembly_type_code
   FROM av_sub_assy_inventory s WHERE s.aircraft_id IN (:AircraftId)))";
}

function GetPartGroupLov List < Entity(AvPartGroup) > {
   syncpolicy Online;
   parameter PartNumberId Number;
   parameter AssemblyTypeCode Text;
   parameter AircraftAppCode Text;

   where = "part_group_id IN(SELECT part_group_id
   FROM Av_Part_Group_Part
   WHERE part_no_id = :PartNumberId) AND (assembly_type_code IN(:AssemblyTypeCode) OR is_common_hardware IN('True'))
   AND Adcom_Util_API.Get_Applicability(applicability_range,:AircraftAppCode) = 1";
}
function GetConfigSlotPositionLov List < Entity(AvConfigSlotPosition) > {
   syncpolicy Online;
   parameter ConfigSlotCode Text;
   parameter AssemblyType Text;
   where = "config_slot_code IN (:ConfigSlotCode) AND assembly_type_code IN (:AssemblyType)";
}
function GetSpecificPartNumberLov List < Entity(AvPartNumber) > {
   syncpolicy Online;
   parameter PartGroupId Number;
   where = "part_number_id IN(SELECT part_no_id FROM Av_Part_Group_Part WHERE part_group_id = :PartGroupId) ";
}

function GetAssemblConfigSlotPosLov List < Entity(AvConfigSlotPosition) > {
   syncpolicy Online;
   parameter AssemblyType Text;
   parameter AircraftId Number;
   where = "config_slot_position_id IN (SELECT config_slot_position_id FROM Av_Sub_Assy_Inventory WHERE assembly_type_code = (:AssemblyType) AND aircraft_id = (:AircraftId))";
}

function GetPartGroupInfo Structure(PartGroupInfoStructure) {
   syncpolicy Online;
   parameter Part Number;
   parameter AssemblyTypeCode Text;
   parameter AircraftId Number;
   parameter InventoryClassCode Text;
}

function GetAssemblyConfigSlotInfo Structure(AssemblyConfigSlotStructure) {
   syncpolicy Online;
   parameter AssmblConfigSlotPosId Number;
}

function GetAircraftAssemblyInfo Structure(AircraftAssemblyInfo) {
   syncpolicy Online;
   parameter AircraftId Number;
}

function GetAircraftInfo Structure(PartsInfoAssistantStructure) {
   parameter AircraftId Number;
}

function GetParentPartInfo Structure(ParentPartInfo) {
   syncpolicy Online;
   parameter ParentObjkey Text;
}

function GetAssemblyInfo Structure(PartGroupInfoStructure) {
   parameter AssemblyTypeCode Text;
   parameter AircraftId Number;
   parameter InventoryClassCode Text;
   parameter PartGroupId Number;
}
function GetAssemblyType Text {
   syncpolicy Online;
   parameter PartGroupId Number;
}
function GetAssyPosition Number {
   syncpolicy Online;
   parameter AircraftId Number;
   parameter AssemblyTypeCode Text;
   parameter AssmblConfigSlotPosId Number;
}

function GetConfigSlotStatus Text {
   syncpolicy Online;
   parameter PartGroupId Number;
}

function GetPartNumberInfo Structure(AvPartInfoStructure) {
   syncpolicy Online;
   parameter PartNumberAltId Text;
   parameter AircraftId Number;
   parameter AssemblyType Text;
}

function GetConfigSlotInfo Structure(ConfigSlotInfoStructure) {
   syncpolicy Online;
   parameter ConfigSlotCode Text;
   parameter AssemblyTypeCode Text;
   parameter AircraftId Number;
   parameter InventoryClassCode Text;
}

function GetRemovalPartInfo Structure(RemovalPartInfoStruct) {
   syncpolicy Online;
   parameter RemovalPartNumberAltId Text;
   parameter RemovalPartGroupAltId Text;
}
function GetSchedulingReqDate Timestamp {
   parameter AircraftWpId Number;
}
function ValidateRequiredDate Structure(ValidateMessageInfoStructure) {
   parameter AircraftWpId Number;
   parameter RequiredDate Timestamp;
   parameter CurrentDate Timestamp;
}

function GetRemovalReasonsForPart List < Entity(AvRemovalReason) > {
   parameter IsSos Boolean;
}

function GetPartGroupSensitivity Structure(PartGroupSensStruct) {
   initialcheck none;
   implementation = "Java";
   parameter PartGroupAltId Text;
   parameter AircraftAltId Text;

}

function GetWorkPackagesByAircraftId List < Entity(AvAircraftWorkPackage) > {
   parameter AircraftId Number;
   where = "(:AircraftId IS NULL OR aircraft_id = :AircraftId) AND objstate in ('InWork', 'Active', 'Committed')";
}

function GetAvExeTasksByWpIdAndAcId List < Entity(AvExeTask) > {
   parameter AircraftWorkPackageId  Number;
   parameter AircraftId  Number;
   where = "objstate in ('WORKSTARTED', 'RELEASED')
            AND (
                  (:AircraftWorkPackageId IS NOT NULL AND aircraft_wp_id = :AircraftWorkPackageId)
                  OR (:AircraftWorkPackageId IS NULL AND :AircraftId IS NOT NULL AND aircraft_id = :AircraftId)
                  OR (:AircraftWorkPackageId IS NULL AND :AircraftId IS NULL)
                )";
}

function GetAircraftId List < Entity(AircraftLov) > {
}

structure RefreshStructure {
   attribute Entity Text {
      required = [true];
   }
   attribute Criteria Text;
   attribute Refresh Text;
}

virtual AddPartsVirtual {
   attribute TaskSeq Number;
   attribute FaultId Number;
   attribute WpId Number;
   attribute Part Number;
   attribute PartNumber Number;
   attribute PartNumberId Number;
   attribute InventoryClassCode Text;
   attribute RequiredQuantity Number;
   attribute IsCommonHardware Boolean;
   attribute PartGroupId Number;
   attribute AssemblyType Text;
   attribute AssemblyTypeCode Text;
   attribute ConditionsDesc Text;
   attribute ConfigSlotCode Text;
   attribute ConfigSlotPositionCode Text;
   attribute ConfigSlotPositionId Number;
   attribute AssmblConfigSlotPosId Number;
   attribute AssmblVisibility Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute AssmblEditable Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute AircraftAppCode Text;
   attribute AircraftId Number;
   attribute Objkey Text;
   attribute PartNoUnqId Text;
   attribute ConfigSlotStatus Text;
   attribute InstallationExists Boolean;
   attribute RemovalExists Boolean;
   attribute InstallationVisible Boolean;
   attribute RemovalVisible Boolean;
   attribute IncludeInstallation Boolean {
      default = "true";
      required = [true];
   }
   attribute IncludeRemoval Boolean {
      default = "true";
      required = [true];
   }
   attribute RemovalReasonCode Text;
   attribute Barcode Text;
   attribute PartAssemblyTypeCode Text;
   attribute InstalledSerialNo Text;
   attribute IsResponseReceived Boolean;
   attribute IsCancelled Boolean;
   attribute RemovedSerialNo Text;
   attribute AircraftAltId Text;
   attribute RemovalPartNumberId Number;
   attribute RemovalPartGroupId Number;
   attribute IsSubAssy Text;
   attribute ConfigSlot Text;
   attribute CmsResponseSeverity Number;
   attribute RemovalPartNumber Text;
   attribute RemovalPartGroupAltId Text;
   attribute RemovalSerialNo Text;
   attribute RemovalPartManufacturer Text;
   attribute RequiredDate Timestamp;
   attribute DefaultRequiredDate Timestamp;
   attribute AssistantOpenedAt Timestamp {
      default = "SYSDATE";
   }
   attribute Note Text;
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute IsRemovalReasonFilled Boolean("TRUE", "FALSE") {
      default = "FALSE";
   }
   attribute SchedulingAction Enumeration(SchedulingActionType) {
      default = "'REQ'";
   }
   attribute IpcPartNumber Text;
   attribute PartGroupCode Text;
   attribute Manufacturer Text;
   attribute ConfSlotCode Text;
   attribute ConfSlotPosCode Text;
   attribute UIFormattedPGSensitivity Text;
   attribute DBFormattedPGSensitivity Text;
   attribute ClassCode Text;
   attribute AssemblyConfigSlotPosCode Text;
   attribute AssemblyConfigSlotCode Text;
   attribute InvClassCode Text;
   attribute IfsUser Text;
   attribute TaskAltId Text;
   attribute PartNo Text;
   attribute RegCode Text;

   //attributes specific for Edit part
   attribute OperationType Text;
   attribute MaintMaterialOrderNo Number;
   attribute LineItemNo Number;
   attribute InstalledTaskPartId Number;
   attribute RemovedTaskPartId Number;
   attribute OrgnlPart Number;
   attribute OrgnlPartGroupId Number;
   attribute OrgnlRequiredQuantity Number;
   attribute OrgnlConfigSlotPositionId Number;
   attribute OrgnlAssmblConfigSlotPosId Number;
   attribute OrgnlRemovalReasonCode Text;
   attribute IsModified Boolean;
   attribute ProjectionName Text;
   attribute CreatedUser Text;
   attribute OrgnlNote Text;

   reference RemovalReasonRef(RemovalReasonCode) to AvRemovalReason(RemovalReasonCode);
   reference PartNumberRef(PartNoUnqId) to PartNumbers(Objkey);
   reference PartGroupRef(PartGroupId) to AvPartGroup(PartGroupId);
   reference ConfigSlotPositionRef(ConfigSlotPositionId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AssemblyConfigSlotPosRef(AssmblConfigSlotPosId) to AvConfigSlotPosition(ConfigSlotPositionId);
   reference AircraftTypeRef(AssemblyType) to AvAssembly(AssemblyTypeCode);
   reference ConfigSlotRef(ConfigSlotCode, AssemblyType) to AvConfigSlot(ConfigSlotCode, AssemblyTypeCode);
   reference AircraftRef(AircraftId) to AircraftLov(AircraftId);
   reference AcftRef(AircraftId) to Aircraft(AircraftId);
   reference AvAircraftWorkPackageRef(WpId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   array AlternatePartVirtualArray() to AlternatePartVirtual();
   function IsModified Boolean {
   }
   action ModifyPart {
      ludependencies = MaintMaterialReqLine, AvExeTask, AvFault, AggFaultInstPartQuery, AggFaultRemovePartQuery, AvInstalledParts, AvRemovedParts;
      parameter PartNumber Text;
      parameter RemovalSerialNo Text;
      parameter Sensitivities Text;
   }
}

virtual AlternatePartVirtual {
   attribute PartNumber Text;
   attribute ManufacturerCode Text;
   attribute PartName Text;
   attribute InventoryClassCode Text;
   attribute IsSelectedPart Text;
   attribute Conditions Text;
   attribute AvaillableQty Number;
   attribute ConfSlotCode Text;
   attribute ConfSlotPosCode Text;
   attribute PartGroupCode Text;
   attribute AssemblyConfigSlotPosCode Text;
   attribute AssemblyConfigSlotCode Text;

   reference PartCatalogRef(PartNumber) to PartCatalog(PartNo);
}

virtual InstalledPartsVirtual {

   attribute TaskSeq Number;
   attribute AggregateId Text;
   attribute TaskPartId Number;
   attribute InstalledPartNoId Number;
   attribute InstalledPartNo Text;
   attribute InstalledQuantity Number;
   attribute InstalledSerialNo Text;
   attribute InstalledBatchNo Text;
   attribute MaintMaterialOrderNo Number;
   attribute LineItemNo Number;
   attribute PartName Text;
}

structure ParentPartInfo {
   attribute TaskSeq Number;
   attribute TaskAltId Text;
   attribute AircraftRegCode Text;
   attribute ProjectionName Text;
   attribute IfsUser Text;
}

structure InterchangeableParts {
   attribute PartNumber Text;
   attribute Manufacturer Text;
   attribute PartName Text;
   attribute InventoryClassCode Text;
   attribute IsSelectedPart Text;
   attribute Conditions Text;
   attribute AvaillableQty Number;
   reference PartCatalogRef(PartNumber) to PartCatalog(PartNo);

}

structure AddPartDefaultsStructure {
   attribute RemovalExists Boolean;
   attribute InstallationExists Boolean;
   attribute RemovalVisible Boolean;
   attribute InstallationVisible Boolean;
   attribute IncludeInstallation Boolean;
   attribute IncludeRemoval Boolean;
   attribute ConfigSlotCode Text;
   attribute ConfigSlotPositionCode Text;
   attribute RegCode Text;
   attribute IfsUser Text;
   attribute AircraftAssemblyType Text;
}

structure AssemblyConfigSlotStructure {
   attribute AssemblyConfigSlotCode Text;
   attribute AssemblyConfigSlotPosCode Text;
}

structure AddPartStructure {
    //FauldId or TaskSeq as SourceId
   attribute SourceId Number;
   attribute PartNumberId Number;
   attribute RequiredQuantity Number;
   attribute PartGroupId Number;
   attribute AssmblConfigSlotPosId Number;
   attribute ConfigSlotPositionId Number;
   attribute IsAddingInstallation Boolean;
   attribute IsAddingRemoval Boolean;
   attribute RemovalReasonCode Text;
   attribute InstalledSerialNo Text;
   attribute RemovalSerialNo Text;
   attribute RemovalPartNumberId Number;
}

structure AvPartInfoStructure {
   attribute PartNumberId Number;
   attribute InventoryClassCode Text;
   attribute PartAssemblyTypeCode Text;
   attribute IsSubAssy Boolean;
   attribute IsRepairable Boolean;
   attribute VrtObjkey Text;
}

structure ValidateMessageInfoStructure {
   attribute MessageType Text;
   attribute Message     Text;
