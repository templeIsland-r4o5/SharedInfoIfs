projection FlmMyAircraftTurnsHandling;
component FLMEXE;
layer Core;
description "This API shows the information related to My Aircraft Turns Card View";
category Users;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- MAIN ENTRY POINTS -----------------------------
entityset MyAircraftTurnQuerySet for MyAircraftTurnQuery;
entityset AvFlightSet for AvFlight;
entityset AvAirportSet for AvAirport;
entityset AircraftSet for Aircraft;
entityset AvAircraftWorkPackageSet for AvAircraftWorkPackage;

------------------------------ ENTITY DETAILS -------------------------------


------------------------------- ENUMERATIONS --------------------------------
enumeration TurnStatusEnum {
   value = "Inbound" {
      identifier = "Inbound";
      label = "Inbound";
   }
   value = "Arrived" {
      identifier = "Arrived";
      label = "Arrived";
   }
   value = "Departed" {
      identifier = "Departed";
      label = "Departed";
   }
   value = "InMaintenance" {
      identifier = "InMaintenance";
      label = "In Maintenance";
   }
   value = "Released" {
      identifier = "Released";
      label = "Released";
   }
   value = "NotApplicable" {
      identifier = "NotApplicable";
      label = "Not Applicable";
   }
}

---------------------------------- QUERIES ----------------------------------
query MyAircraftTurnQuery {
   timestamptzref = "server";

   from = "My_Aircraft_Turns_Status_View";
   lu = none;
   keys = FlightId;
   attribute FlightId Number;
   attribute ArrivalAirportId Number;
   attribute AircraftId Number;
   attribute ActualArrivalDateTime Timestamp;
   attribute ShedArrivalDateTime Timestamp;
   attribute DepartureTimestamp Timestamp;
   attribute LegNo Text;
   attribute ArrivalGate Text;
   attribute FlightTurnStatus Text;
   attribute ArrivalOffsetTime Timestamp;
   attribute DepartureOffsetTime Timestamp;
   attribute WorkPackageId Number;
   attribute ActualEndDateTime Timestamp;
   attribute DeptFlightId Text;
   attribute NoOfOpenedFaults Number;
   attribute GroundTime Text;
   attribute AssemblyTypeCode Text;
   attribute ArrivalTimestamp Timestamp;
   attribute ActualOutboundDeptDateTime Timestamp {
      fetch = "NVL(Av_Flight_API.Get_Actual_Departure_Date_Time(dept_flight_id), departure_timestamp)";
   }
   attribute HasTurnAssignedToMe Boolean("TRUE", "FALSE") {
      fetch = "DECODE(Av_Turn_Labour_Assignment_API.Has_Turn_Assigned_To_User(flight_id,work_package_id), 1, 'TRUE','FALSE')";
   }

   attribute OpenFaultCountForFlight Number;
   attribute TurnStatus Enumeration(TurnStatusEnum) {
      fetch = "Flight_Turn_Status";
   }

   reference AvAirportRef(ArrivalAirportId) to AvAirport(AirportId);
   reference AvFlightDepartureRef(DeptFlightId) to AvFlight(FlightId);
   reference AvAircraftWorkPackageRef(WorkPackageId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AircraftRef(AircraftId) to Aircraft(AircraftId);
   reference AvAircraftTypeRef(AssemblyTypeCode) to AvAssembly(AssemblyTypeCode);

   where = "(locked_bool = 'FALSE' or locked_bool is null) and (condition != 'SCRAP' and condition != 'ARCHIVE')";
}

---------------------------------- ACTIONS ----------------------------------


--------------------------------- FUNCTIONS ---------------------------------
function GetDefaultValue Structure(SearchContextStructure);


-------------------------------- STRUCTURES ---------------------------------
structure SearchContextStructure {
   attribute HasTurnAssignedToMe Boolean("TRUE", "FALSE") {
      required = [true];
   }
}
--------------------------------- VIRTUALS ----------------------------------


--------------------------------- SUMMARIES ---------------------------------


-------------------------------- SINGLETONS ---------------------------------
