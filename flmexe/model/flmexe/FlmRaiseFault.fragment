function GetHangarMainLocList List < Entity(AvMaintenanceLocation) > {
   parameter CurrentUser Text;
   where = "location_type_code IN ('TRACK','HGR') AND airport_id = (select airport_id from Av_Airport_For_User where identity = :CurrentUser)";
}
function GetLineMainLocList List < Entity(AvMaintenanceLocation) > {
   parameter CurrentUser Text;
   where = "location_type_code = 'LINE' AND airport_id = (select airport_id from Av_Airport_For_User where identity = :CurrentUser)";
}
