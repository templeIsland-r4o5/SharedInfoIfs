structure RaiseFaultResponse {
   attribute FaultId Number;
   attribute AircraftWorkPackageId Number;
   attribute TaskSeq Number;
   attribute TaskAltId Text;
   attribute ExecTaskResSeq Number;
   attribute CertTaskResSeq Number;
   attribute InspTaskResSeq Number;
   attribute TaskResGroupId Text;
}

structure RaiseFaultAssistantDataStructure {
   attribute SubSystemId Number;
   attribute FaultSeverityCode Text;
}
structure FetchDefaultStruct {
   timestamptzref = "server";

   attribute CurrentUser Text;
   attribute CurrentUserAirportTimeZone Text;
   attribute FoundSource Text;
   attribute FaultSourceCode Text;
   attribute SubSystemId Number;
   attribute SchedHours Text;
   attribute RaiseFaultOption Enumeration(RaiseFaultOptions);
   attribute FaultSeverityCode Text;
   attribute FoundOnDate Timestamp;
   attribute ResourceSeq Number;
   attribute AircraftId Number;
   attribute RaiseFaultActionOption Enumeration(RaiseFaultActionOptions);
   attribute LocationCode Text;
}
structure FaultMtxRequestData {
   timestamptzref = "server";

   attribute AircraftAltId Text;
   attribute ConfigSlotAltId Text;
   attribute UtcFoundOnDate Timestamp;
}
structure FinishTaskInfoStructure {
   timestamptzref = "server";

   attribute FaultId Number;
   attribute AircraftWpId Number;
   attribute AircraftId Number;
   attribute AssignmentStatus Text;
   attribute TaskSeq Number;
   attribute TaskCardOption Text;
   attribute LatestAction Text;
   attribute CloseFaultAssignActualHours Text;
   attribute CloseFaultAssignStartTime Timestamp;
   attribute CloseFaultAssignStopTime Timestamp;
   attribute Source Text;
   attribute KeyRef Text;
   attribute LuName Text;
   attribute ExecutionInstanceSeq Number;
   attribute Remark Text;
   attribute CertifyWorkPerformed Boolean;
   attribute NavigatedFrom Text;
   attribute Objstate Text;
}
structure SensitivityResponseStructure {
   attribute UIFormattedSensitivities Text;
}

------------------------------- ENUMERATIONS --------------------------------
enumeration RaiseFaultOptions {
   value = "LogbookFault" {
      identifier = "LogbookFault";
      label = "Raise Logbook Fault";
   }
   value = "NonRoutine" {
      identifier = "NonRoutine";
      label = "Raise Non Routine";
   }
}
enumeration RaiseFaultActionOptions {
   value = "RaiseAndOpen" {
      identifier = "RaiseAndOpen";
      label = "Raise and leave open";
   }
   value = "RaiseAndClose" {
      identifier = "RaiseAndClose";
      label = "Raise and close";
   }
}

enumeration FoundSourceOptions {
   value = "WorkPackage" {
      identifier = "WorkPackage";
      label = "Work Package";
   }
   value = "Task" {
      identifier = "Task";
      label = "Task";
   }
}

enumeration FlightStatusEnum {
   value = "Planned" {
      identifier = "Planned";
      label = "Planned";
   }
   value = "Out" {
      identifier = "Out";
      label = "Out";
   }
   value = "Off" {
      identifier = "Off";
      label = "Off";
   }
   value = "On" {
      identifier = "On";
      label = "On";
   }
   value = "Canceled" {
      identifier = "Canceled";
      label = "Canceled";
   }
   value = "Diverted" {
      identifier = "Diverted";
      label = "Diverted";
   }
   value = "Returned" {
      identifier = "Returned";
      label = "Returned";
   }
   value = "In" {
      identifier = "In";
      label = "In";
   }
   value = "Completed" {
      identifier = "Completed";
      label = "Completed";
   }
}

enumeration TurnStatusEnum {
   value = "Inbound" {
      identifier = "Inbound";
      label = "Inbound";
   }
   value = "Arrived" {
      identifier = "Arrived";
      label = "Arrived";
   }
   value = "Departed" {
      identifier = "Departed";
      label = "Departed";
   }
   value = "InMaintenance" {
      identifier = "InMaintenance";
      label = "In Maintenance";
   }
   value = "Released" {
      identifier = "Released";
      label = "Released";
   }
   value = "NotApplicable" {
      identifier = "NotApplicable";
      label = "Not Applicable";
   }
}

---------------------------------- QUERIES ----------------------------------
query ClosedFaultsQuery {
   from = "Av_Fault";
   keys = FaultId;
   where = "objstate IN ('Closed')";
   lu = AvFault;
   timestamptzref = "server";

   attribute FaultId Number {
      required = [false];
   }
   attribute Barcode Text;
   attribute Description Text;
   attribute SubSystemId Number;
   attribute AircraftId Number;
   attribute FoundOnDate Timestamp {
      fetch = "found_on_date";
      label = "Found On";
   }
   attribute ClosedDate Timestamp {
      fetch = "closed_date";
      label = "Closed Date";
   }
   attribute LogbookTypeCode Text {
      fetch = "logbook_type_code";
      label = "Logbook Type";
   }
   attribute Action Text {
      fetch = "Av_Fault_Action_API.Get_Latest_Correct_Fault_Act(fault_id)";
   }
   attribute Objstate Enumeration(FaultStatus) {
      fetch = "objstate";
      label = "State";
      maxlength = 50;
      editable = [false];
      insertable = [false];
      updatable = [false];
   }
   attribute RecordId Text {
      fetch = "Adcom_Util_API.Record_Id_For_Fault_And_Task(fault_id ,NULL)";
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Sens_API.Get_Sensitivities_By_Task_Seq(Av_Exe_Task_API.Get_Task_Seq(fault_id))";
   }
   reference AvAircraftSubSystemRef(SubSystemId) to AvAircraftSubSystem(SubSystemId);
   reference CloseFaultRef(Barcode) to AvFault(Barcode);
}
