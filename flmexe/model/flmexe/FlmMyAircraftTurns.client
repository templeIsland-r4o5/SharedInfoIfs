-----------------------------------------------------------------------------
client FlmMyAircraftTurns;
component FLMEXE;
layer Core;
projection FlmMyAircraftTurnsHandling;

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------

-------------------------------- MAIN PAGES ---------------------------------
page MyAircraftTurnsCardPage using MyAircraftTurnQuerySet {
   label = "My Aircraft Turns";

   list FlightsList using MyAircraftTurnQuerySet
      {
      searchcontext TurnsAssignedToMeSearchContext {
         defaults = GetDefaultValue();
      }
      filter = [HasTurnAssignedToMe = true or HasTurnAssignedToMe = searchcontext.TurnsAssignedToMeSearchContext.HasTurnAssignedToMe];
      details = "page/FlmAircraftTurnsDetails/AircraftTurnDetails?$filter=FlightId eq $[FlightId]";
   }
}

searchcontext TurnsAssignedToMeSearchContext for SearchContextStructure {
   label = "";
   field HasTurnAssignedToMe {
      label = "Turns Assigned to Me";
   }
}

--------------------------------- COMMANDS ----------------------------------


--------------------------------- SELECTORS ---------------------------------


---------------------------------- GROUPS -----------------------------------


----------------------------------- LISTS -----------------------------------
list FlightsList for MyAircraftTurnQuery {
   label = "";
   orderby = ShedArrivalDateTime asc;
   card FlightsListCard;
   initialview = CardView;

   field AvAirportRef.IataCode;
   field AircraftRef.RegCode {
      label = "Aircraft Registration Code";
   }
   field AvAircraftTypeRef.AssemblyTypeName;

   badge TurnStatus {
      label = "Flight Turn Status";
      style = TextOnly;
      size = Medium;
      emphasis Complementary7 = [FlightTurnStatus = "Arrived"];
      emphasis Complementary2 = [FlightTurnStatus = "Inbound"];
      emphasis Danger = [FlightTurnStatus = "InMaintenance"];
      emphasis True = [FlightTurnStatus = "Released"];
      emphasis Neutral = [FlightTurnStatus = "Departed"];
   }
   field GroundTime {
      label = "Time on Ground";
      size = Small;
   }
   field NoOfOpenedFaults {
      label = "Open Faults";
      size = Small;
   }
   field AvAircraftWorkPackageRef.WoNumber {
      label = "Planned Work Package";
      editable = [false];
      size = Medium;
   }
   field LegNo {
      label = "Arrival Flight";
      size = Small;
   }
   field ArrivalGate {
      label = "Arrival Gate";
      size = Small;
   }
   field ActualArrivalDateTime {
      label = "Arrival Time";
      displaytimezone = AvAirportRef.AirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   field AvFlightDepartureRef.LegNo {
      label = "Departure Flight";
      size = Small;
   }
   field AvFlightDepartureRef.DepartureGate {
      label = "Departure Gate";
      size = Small;
   }
   field ActualOutboundDeptDateTime {
      label = "Departure Time";
      displaytimezone = AvAirportRef.AirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   field AvAircraftWorkPackageRef.ExternalId {
      label = "External ID";
      editable = [false];
      size = Medium;
   }
}
card FlightsListCard for MyAircraftTurnQuery {
   label = "${AvAirportRef.IataCode} - ${AircraftRef.RegCode} - (${AvAircraftTypeRef.AssemblyTypeName})";

   badge TurnStatus {
      label = "";
      style = TextOnly;
      size = FullWidth;
      emphasis Complementary7 = [FlightTurnStatus = "Arrived"];
      emphasis Complementary2 = [FlightTurnStatus = "Inbound"];
      emphasis Danger = [FlightTurnStatus = "InMaintenance"];
      emphasis True = [FlightTurnStatus = "Released"];
      emphasis Neutral = [FlightTurnStatus = "Departed"];
   }
   field GroundTime {
      label = "Time on Ground";
      size = Small;
   }
   field NoOfOpenedFaults {
      label = "Open Faults";
      size = Small;
   }
   field AvAircraftWorkPackageRef.WoNumber {
      label = "Planned Work Package";
      editable = [false];
      size = FullWidth;
   }
   markdowntext {
      text = "**Inbound Flight**";
   }
   field LegNo {
      label = "Arrival Flight";
      size = Small;
   }
   field ArrivalGate {
      label = "Arrival Gate";
      size = Small;
   }
   field ActualArrivalDateTime {
      label = "Arrival Time";
      displaytimezone = AvAirportRef.AirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   markdowntext {
      text = "**Outbound Flight**";
   }
   field AvFlightDepartureRef.LegNo {
      label = "Departure Flight";
      size = Small;
   }
   field AvFlightDepartureRef.DepartureGate {
      label = "Departure Gate";
      size = Small;
   }
   field ActualOutboundDeptDateTime {
      label = "Departure Time";
      displaytimezone = AvAirportRef.AirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   field AvAircraftWorkPackageRef.ExternalId {
      label = "External ID";
      editable = [false];
      size = Medium;
      visible = [false];

   }

}
