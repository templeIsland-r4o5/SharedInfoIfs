fragment FlmTaskAssignments;
component FLMEXE;
layer Core;
description "This contains all the resources required for Assignment assistant";

--------------------------------- FRAGMENTS ---------------------------------
include fragment ZoneLovSelector;
include fragment PanelLovSelector;
include fragment AircraftPanel;

----------------------------- CLIENT FRAGMENTS ------------------------------

-------------------------------- ASSISTANTS ---------------------------------
assistant AddAssignmentAssistant using AddAssignmentVirtualSet {
   label = "Assignment";
   savemode = OnLostFocus;

   input(TaskSeq);

   init command {
      execute {
         set PreExecutorScheduledHours = "00:00";
         set PreCertifierScheduledHours = "00:00";
         set PreInspectorScheduledHours = "00:00";
      }
   }
   singlestep {
      group AddExecutorGroup;
      group AddCertifierGroup {
         visible = [CertificationRequired = true];
      }
      group AddInspectorGroup {
         visible = [InspectionRequired = true];
      }
   }
   command SaveAssignment;
   command Cancel;
}
assistant TaskAssignmentAssistant using TaskAssignmentsVirtualSet {
   label = "Assignments";
   input this;
   singlestep {
      group TaskDetailsGroup;
      list ResourceDemandsList(ResourceDemandsArray);
      list ResourcesList(ResourceArray) bind ResourceDemandsList;
   }
   command Ok {
      enabled = [component.ResourceDemandsList.SelectionCount = 0];
   }
   command Cancel;
}
assistant ModifyAssignmentAssistant using ModifyAssignmentVirtualSet {
   label = "Task Supervision";
   savemode = OnLostFocus;

   input this;
   singlestep {
      group ModifyTaskAssignmentGroup;
   }
   command ModifyTaskAssignment;
   command Cancel;
}
----------------------------------- LISTS -----------------------------------
list AssignmentsList for JtTaskResourceDemandQuery {
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }
   field ResourceDemand;
   field Remark;
   field AssignedResourceId;
   field UserResourceUsername {
      label = "Assigned To";
      contactwidget {
         enabled = [true];
         source = Person;
         key = AssignedResourceId;
      }
   }
   badge Rowstate {
      emphasis Complementary2 = [Rowstate = "ASSIGNED"];
      emphasis Warning = [Rowstate = "WORKSTARTED"];
      emphasis Success = [Rowstate = "COMPLETED"];
      emphasis Neutral = [Rowstate = "CANCELLED"];
   }
   field PlannedHours;
   field PlannedHoursFormat;
   field SchedStart {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field SchedEnd {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AssignmentStart {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AssignmentFinish {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AllocatedHours;
   field AllocatedStart;
   field AllocatedFinish;
   field FixedStart;
   field WorkStart;
   field JobStopReason {
      editable = [false];
   }
   field ActionTaken;

   command AddAssignmentCommand {
      label = "";
      icon = "new";
   }
   command AssignToMeCommand;
   command UnassignMeCommand;
}

list JtTaskResourceLicenseList for JtTaskResourceLicense {
   editmode = MultiRowEdit;
   @DynamicComponentDependency STRACO
   lov LicenseGroupIdRef with ReferenceLicenseGroupLovSelector {
      search = LicenseGroupId, LicenseGroupName;
      size = Medium;
      editable = [true];
   }
   field LicenseGroupName {
      size = Medium;
   }
   @DynamicComponentDependency STRACO
   lov LicenseIdRef with ReferenceLicenseCompanyLovSelector {
      search = LicenseId, LicenseName;
      size = Medium;
   }
   field LicenseName {
      size = Medium;
   }
   field LicenseDescription {
      size = Medium;
   }
}
list ResourceDemandsList for ResourceDemandsVirtual {
   label = "Resource Demands";
   multiselect = [false];
   crudactions {
      edit {
         enabled = [false];
      }
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
   }
   field SkillDemand {
      label = "Required Skill";
   }
   field Remark {
      label = "Assignment Role";
   }
   field PlannedHours {
      label = "Scheduled Hours";
   }
   field SchedStart {
      label = "Scheduled Start";
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field SchedEnd {
      label = "Scheduled End";
      displaytimezone = CurrentUserAirportTimeZone;
   }
}
list ResourcesList for ResourceVirtual {
   label = "Resources";
   multiselect = [false];
   orderby = ShiftStart asc;
   crudactions {
      edit {
         enabled = [false];
      }
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
   }
   field Description {
      label = "Name";
      contactwidget {
         enabled = [true];
         source = Person;
      }
   }
   field LicenseId {
      label = "Certificate";
   }
   field TotalAssignments {
      label = "Total Assigned Assignments";
   }
   field TotalHours {
      label = "Total Scheduled Hours";
   }
   field ShiftStart {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   field ShiftEnd {
      displaytimezone = CurrentUserAirportTimeZone;
   }
   command AssignToResource;
}

list JtTaskSignOffReqList for JtTaskSignOffReq {
   label = "";
   defaultfilter = [not(SignOffReqType = "Executor" and SignOffConnectionDb = "TASK")];
   orderby = SignOffConnection;
   crudactions {
      edit {
         enabled = [false];
      }
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   field SignOffReqType {
      label = "Role";
      size = Medium;
   }
   field LicenseId {
      label = "Certificate ID";
      size = Medium;
   }
   field SignOffConnection {
      label = "Connection Type";
      size = Medium;
   }
   badge OverallSignOffStatus {
      label = "Overall sign-off status";
      style = TextOnly;
      size = Medium;

      emphasis Warning = [OverallSignOffStatus = "Pending"];
      emphasis OK = [OverallSignOffStatus = "Signed"];
   }
   field LastSignOffDate {
      label = "Last Signed-off Date";
      type = Date;
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   field SignOffConnectionDb {
      columnexclude = [true];
   }
}

list StepSignOffList for JtTaskStepSignOff {
   label = "Steps";
   crudactions {
      edit {
         enabled = [false];
      }
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }
   field Step {
      label = "Step";
      size = Small;
      editable = [false];
   }
   field JtTaskStepRef.OrderNo {
      label = "Order Number";
      size = Small;
   }
   field JtTaskStepRef.Description {
      label = "Step Description";
      size = Large;
      editable = [false];
      multiline = true;
   }
   field Identity {
      label = "Signed By";
      size = Small;
   }
   field SignOffDate {
      label = "Signed-off Date";
      type = Date;
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      size = Medium;
   }
   badge JtTaskStepRef.Objstate {
      label = "Step Status";
      style = TextOnly;
      size = Small;

      emphasis Neutral = [JtTaskStepRef.Objstate = "NOTDONE"];
      emphasis Warning = [JtTaskStepRef.Objstate = "PENDING"];
      emphasis OK = [JtTaskStepRef.Objstate = "DONE"];
   }

   command RecordSignOffCommand;
}

list PanelSignOffList clone StepSignOffList {
   label = "Panels";
   crudactions {
      edit {
         enabled = [false];
      }
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      duplicate {
         enabled = [false];
      }
   }

   lov AvPanelCodeRef with PanelCodeSelector {
      label = "Panel Code";
      details = "page/MxPanelDetails/PanelDetails?$filter=AdBrPanelId eq $[AvAircraftPanelRef.PanelAltId]";
   }
   field AvAircraftPanelRef.PanelDescription {
      label = "Panel Name";
      multiline = true;
      size = FullWidth;
   }
   badge PanelStatus {
      label = "Panel Status";
      style = TextOnly;
      size = Small;

      emphasis Neutral = [PanelStatus = "ToBeOpened"];
      emphasis OK = [PanelStatus = "Opened"];
      emphasis OK = [PanelStatus = "ReadyToClose"];
      emphasis OK = [PanelStatus = "Closed"];
   }
   lov AvZoneCodeRef with ZoneCodeSelector {
      label = "Panel Zone Code";
      details = "page/MxZoneDetails/ZoneDetails?$filter=AdBrZoneId eq $[AvAircraftPanelRef.ZoneAltId]";
   }
   field AvAircraftPanelRef.ZoneDescription {
      label = "Panel Zone Name";
      multiline = true;
      size = FullWidth;
   }

   fieldorder = AvPanelCodeRef, AvAircraftPanelRef.PanelDescription, PanelStatus, AvZoneCodeRef, AvAircraftPanelRef.ZoneDescription, Identity, SignOffDate;
   exclude Step, JtTaskStepRef.OrderNo, JtTaskStepRef.Description, JtTaskStepRef.Objstate;
}

---------------------------------- GROUPS -----------------------------------

group AddExecutorGroup for AddAssignmentVirtual {
   label = "Add Executor";
   lov SkillDemandLovRef with ReferenceResourceGroupLovSelector {
      label = "Required Skill";
      hidekey = [true];
      searchable = true;
      search = SkillDemandLovRef.ResourceId;
      description = SkillDemandLovRef.ResourceId;
      required = [true];
      validate command {
         execute {
            set ExecutorResourceSeq = null;
            set CertifierResourceSeq = null;
            set InspectorResourceSeq = null;
            set ExecutorScheduledStart = null;
            set ExecutorScheduledEnd = null;
            set CertifierScheduledStart = null;
            set CertifierScheduledEnd = null;
            set InspectorScheduledStart = null;
            set InspectorScheduledEnd = null;
         }
      }
   }
   lov ExecutorAssignedLovRef with ReferenceNewLaborResourceLovSelector using GetPersonResources(SkillDemandLovRef.ResourceId, "-EXECUTOR") {
      label = "Assigned to";
      hidekey = [true];
      searchable = true;
      search = ExecutorAssignedLovRef.ResourceId;
      description = ExecutorAssignedLovRef.Description;
      contactwidget {
         enabled = [true];
         source = Person;
         key = ExecutorAssignedLovRef.ResourceId;
      }
      validate command {
         execute {
            if [ExecutorResourceSeq = InspectorResourceSeq and ExecutorResourceSeq != null] {
               set ExecutorResourceSeq = null;
               error("Inspector cannot be the same user assigned as the executor or certifier.");
            }
            call CheckActiveAssgmtForSkillRole(TaskSeq, SkillDemandResSeq, "Executor", ExecutorResourceSeq) into ExecActiveAssignments;
            if [ExecActiveAssignments = true] {
               set ExecutorResourceSeq = null;
               error("Selected technician is already assigned to this task for the specified skill and role.");
            }
            if [ExecutorResourceSeq = null] {
               set ExecutorScheduledStart = null;
               set ExecutorScheduledEnd = null;
            }
            else {
               call GetScheduleDateAndInterval(TaskSeq, PreExecutorScheduledHours, "Executor") into ExecTimeRangeIfAssigned;
               set ExecutorScheduledStart = ExecTimeRangeIfAssigned.StartDate;
               set ExecutorScheduledEnd = ExecTimeRangeIfAssigned.EndDate;
               if [PreExecutorScheduledHours != ExecTimeRange.PreScheduleHours] {
                  set PreExecutorScheduledHours = ExecTimeRange.PreScheduleHours;
               }
            }
         }
      }
   }
   field PreExecutorScheduledHours {
      label = "Scheduled Hours (HH:MM)";
      required = [true];
      format = decimal;
      validate command {
         execute {
            if [ExecutorResourceSeq != null] {
               call GetScheduleDateAndInterval(TaskSeq, PreExecutorScheduledHours, "Executor") into ExecTimeRange;
               set ExecutorScheduledStart = ExecTimeRange.StartDate;
               set ExecutorScheduledEnd = ExecTimeRange.EndDate;
               if [PreExecutorScheduledHours != ExecTimeRange.PreScheduleHours] {
                  set PreExecutorScheduledHours = ExecTimeRange.PreScheduleHours;
               }
            }
         }
      }
   }
   field ExecutorScheduledStart {
      label = "Scheduled Start";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [ExecutorResourceSeq != null];
      required = [ExecutorResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, ExecutorScheduledStart, ExecutorScheduledEnd, "Executor") into ValExecutorScheduledHours;
            set PreExecutorScheduledHours = ValExecutorScheduledHours.PreScheduleHours;
         }
      }
   }
   field ExecutorScheduledEnd {
      label = "Scheduled End";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [ExecutorResourceSeq != null];
      required = [ExecutorResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, ExecutorScheduledStart, ExecutorScheduledEnd, "Executor") into ValExecutorScheduledHours;
            set PreExecutorScheduledHours = ValExecutorScheduledHours.PreScheduleHours;
         }
      }
   }
   field CertificationRequired {
      validate command {
         execute {
            if [CertificationRequired = false] {
               set InspectionRequired = false;
            }
         }
      }
   }
   field InspectionRequired {
      editable = [CertificationRequired = true];
   }
}

group AddCertifierGroup for AddAssignmentVirtual {
   label = "Add Certifier";
   lov CertifierAssignedLovRef with ReferenceNewLaborResourceLovSelector using GetPersonResources(SkillDemandLovRef.ResourceId, "-CERTIFIER") {
      label = "Assigned to";
      hidekey = [true];
      searchable = true;
      search = CertifierAssignedLovRef.ResourceId;
      description = CertifierAssignedLovRef.Description;
      contactwidget {
         enabled = [true];
         source = Person;
         key = CertifierAssignedLovRef.ResourceId;
      }
      validate command {
         execute {
            if [CertifierResourceSeq = InspectorResourceSeq and CertifierResourceSeq != null] {
               set CertifierResourceSeq = null;
               error("Inspector cannot be the same user assigned as the executor or certifier.");
            }
            call CheckActiveAssgmtForSkillRole(TaskSeq, SkillDemandResSeq, "Certifier", CertifierResourceSeq) into CertActiveAssignments;
            if [CertActiveAssignments = true] {
               set CertifierResourceSeq = null;
               error("Selected technician is already assigned to this task for the specified skill and role.");
            }
            if [CertifierResourceSeq = null] {
               set CertifierScheduledStart = null;
               set CertifierScheduledStart = null;
            }
            else {
               call GetScheduleDateAndInterval(TaskSeq, PreCertifierScheduledHours, "Certifier") into CertTimeRange;
               set CertifierScheduledStart = CertTimeRange.StartDate;
               set CertifierScheduledEnd = CertTimeRange.EndDate;
               if [PreCertifierScheduledHours != CertTimeRange.PreScheduleHours] {
                  set PreCertifierScheduledHours = CertTimeRange.PreScheduleHours;
               }
            }
         }
      }
   }
   field PreCertifierScheduledHours {
      label = "Scheduled Hours (HH:MM)";
      required = [CertificationRequired = true];
      format = decimal;
      validate command {
         execute {
            if [CertifierResourceSeq != null] {
               call GetScheduleDateAndInterval(TaskSeq, PreCertifierScheduledHours, "Certifier") into CertTimeRange;
               set CertifierScheduledStart = CertTimeRange.StartDate;
               set CertifierScheduledEnd = CertTimeRange.EndDate;
               if [PreCertifierScheduledHours != CertTimeRange.PreScheduleHours] {
                  set PreCertifierScheduledHours = CertTimeRange.PreScheduleHours;
               }
            }
         }
      }
   }
   field CertifierScheduledStart {
      label = "Scheduled Start";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [CertifierResourceSeq != null];
      required = [CertifierResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, CertifierScheduledStart, CertifierScheduledEnd, "Certifier") into ValCertifierScheduledHours;
            set PreCertifierScheduledHours = ValCertifierScheduledHours.PreScheduleHours;
         }
      }
   }
   field CertifierScheduledEnd {
      label = "Scheduled End";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [CertifierResourceSeq != null];
      required = [CertifierResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, CertifierScheduledStart, CertifierScheduledEnd, "Certifier") into ValCertifierScheduledHours;
            set PreCertifierScheduledHours = ValCertifierScheduledHours.PreScheduleHours;
         }
      }
   }
}

group AddInspectorGroup for AddAssignmentVirtual {
   label = "Add Inspector";
   lov InspectorAssignedLovRef with ReferenceNewLaborResourceLovSelector using GetPersonResources(SkillDemandLovRef.ResourceId, "-INSPECTOR") {
      label = "Assigned to";
      hidekey = [true];
      searchable = true;
      search = InspectorAssignedLovRef.ResourceId;
      description = InspectorAssignedLovRef.Description;
      contactwidget {
         enabled = [true];
         source = Person;
         key = InspectorAssignedLovRef.ResourceId;
      }
      validate command {
         execute {
            if [InspectorResourceSeq != null and((InspectorResourceSeq = ExecutorResourceSeq) or(InspectorResourceSeq = CertifierResourceSeq))] {
               set InspectorResourceSeq = null;
               error("Inspector cannot be the same user assigned as the executor or certifier.");
            }
            call CheckActiveAssgmtForSkillRole(TaskSeq, SkillDemandResSeq, "Inspector", InspectorResourceSeq) into InspActiveAssignments;
            if [InspActiveAssignments = true] {
               set InspectorResourceSeq = null;
               error("Selected technician is already assigned to this task for the specified skill and role.");
            }
            if [InspectorResourceSeq = null] {
               set InspectorScheduledStart = null;
               set InspectorScheduledEnd = null;
            }
            else {
               call GetScheduleDateAndInterval(TaskSeq, PreInspectorScheduledHours, "Inspector") into InspTimeRange;
               set InspectorScheduledStart = InspTimeRange.StartDate;
               set InspectorScheduledEnd = InspTimeRange.EndDate;
               if [PreInspectorScheduledHours != InspTimeRange.PreScheduleHours] {
                  set PreInspectorScheduledHours = InspTimeRange.PreScheduleHours;
               }
            }
         }
      }
   }
   field PreInspectorScheduledHours {
      label = "Scheduled Hours (HH:MM)";
      required = [InspectionRequired = true];
      format = decimal;
      validate command {
         execute {
            if [InspectorResourceSeq != null] {
               call GetScheduleDateAndInterval(TaskSeq, PreInspectorScheduledHours, "Inspector") into InspTimeRange;
               set InspectorScheduledStart = InspTimeRange.StartDate;
               set InspectorScheduledEnd = InspTimeRange.EndDate;
               if [PreInspectorScheduledHours != InspTimeRange.PreScheduleHours] {
                  set PreInspectorScheduledHours = InspTimeRange.PreScheduleHours;
               }

            }
         }
      }
   }
   field InspectorScheduledStart {
      label = "Scheduled Start";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [InspectorResourceSeq != null];
      required = [InspectorResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, InspectorScheduledStart, InspectorScheduledEnd, "Inspector") into ValInspectorScheduledHours;
            set PreInspectorScheduledHours = ValInspectorScheduledHours.PreScheduleHours;
         }
      }
   }
   field InspectorScheduledEnd {
      label = "Scheduled End";
      displaytimezone = UtcTimeZoneCode;
      showtimezonebadge = true;
      visible = [InspectorResourceSeq != null];
      required = [InspectorResourceSeq != null];
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, InspectorScheduledStart, InspectorScheduledEnd, "Inspector") into ValInspectorScheduledHours;
            set PreInspectorScheduledHours = ValInspectorScheduledHours.PreScheduleHours;
         }
      }
   }
}
group TaskDetailsGroup for TaskAssignmentsVirtual {
   label = "Task Details";
   field AvExeTaskRef.Description {
      label = "Task Name";
      editable = [false];
      size = Large;
      multiline = true;
   }
   badge Sensitivities {
      emphasis Warning = [true];
      visible = [Sensitivities != null];
      editable = [false];
   }
   badge AvExeTaskRef.Objstate {
      label = "Task Status";
      emphasis StatePreliminary = [AvExeTaskRef.Objstate = "RELEASED"];
      emphasis StateInProgress = [AvExeTaskRef.Objstate = "WORKSTARTED"];
      emphasis StateCompleted = [AvExeTaskRef.Objstate = "FINISHED"];
      emphasis Alert = [AvExeTaskRef.Objstate = "REMOVED"];
      emphasis Neutral = [AvExeTaskRef.Objstate = "CANCELLED"];
      editable = [false];
      size = Medium;
   }
   field Barcode {
      editable = [false];
   }
   field Aircraft {
      editable = [false];
   }
   field AvExeTaskRef.ClassCode {
      label = "Class";
      editable = [false];
   }

   field AvExeTaskRef.SubclassCode {
      label = "Subclass";
      editable = [false];
   }
   field WoNumber {
      label = "Work Package";
      editable = [false];
   }
}
group ModifyTaskAssignmentGroup for ModifyAssignmentVirtual {

   field SkillDemand {
      label = "Required Skill";
      required = [true];
      editable = [false];
   }
   field Remark {
      label = "Assignment Role";
      editable = [false];
   }
   field UserResource {
      label = "Assigned to";
      contactwidget {
         enabled = [true];
         source = Person;
      }
      editable = [false];
   }
   badge ExecutionInstanceStatus {
      emphasis Complementary5 = [ExecutionInstanceStatus = "Assigned"];
      emphasis Complementary9 = [ExecutionInstanceStatus = "Completed"];
      emphasis Complementary6 = [ExecutionInstanceStatus = "Work Started"];
      editable = [false];
   }
   field SchedStart {
      label = "Schedule Start";
      editable = [not ExecutionInstanceStatus in("Completed", "Work Started")];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, SchedStart, SchedEnd, Remark) into ValScheduledHours;
            set LaborScheduledHours = ValScheduledHours.PreScheduleHours;
         }
      }
   }
   field SchedEnd {
      label = "Schedule End";
      editable = [not ExecutionInstanceStatus in("Completed", "Work Started")];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      validate command {
         execute {
            call ValidateScheduleDates(TaskSeq, SchedStart, SchedEnd, Remark) into ValScheduledHours;
            set LaborScheduledHours = ValScheduledHours.PreScheduleHours;
         }
      }
   }
   field LaborScheduledHours {
      label = "Schedule Hours";
      format = decimal;
      editable = [not ExecutionInstanceStatus in("Completed", "Work Started")];
      validate command {
         execute {
            call GetScheduleDateAndInterval(TaskSeq, LaborScheduledHours, Remark) into ScheduleTimeRange;
            set SchedStart = ScheduleTimeRange.StartDate;
            set SchedEnd = ScheduleTimeRange.EndDate;
            if [LaborScheduledHours != ScheduleTimeRange.PreScheduleHours] {
               set LaborScheduledHours = ScheduleTimeRange.PreScheduleHours;
            }
         }
      }
   }
   field AssignmentStart {
      label = "Actual Start";
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field AssignmentFinish {
      label = "Actual End";
      editable = [false];
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field ActualHours {
      label = "Actual Hours";
      editable = [ExecutionInstanceStatus = "Completed"];
      format = decimal;
   }
   field IncompletionCauseRef.Description {
      editable = [false];
      label = "Job Stop Reason";
   }
   field ActionTaken {
      editable = [false];
      label = "Job Stop Note";
   }
}

--------------------------------- COMMANDS ----------------------------------
command  SaveAssignment for AddAssignmentVirtual {
   label = "Save";
   visible = [SkillDemandResSeq != null and PreExecutorScheduledHours != null and(PreCertifierScheduledHours != null or CertificationRequired = false) and(PreInspectorScheduledHours != null or InspectionRequired = false)];
   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and AvExeTaskRef.IsNonRoutine = true and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and ExecutorResourceSeq != null and HmNonRoutineApprovalRef.Objstate != "Approved"] {
         messagebox("", warning, "Free cap limit is exceeded. Do you still want to assign this?") {
            when "Yes" {
               call AddNewAssignment(TaskSeq, Site, SkillDemandResSeq, ExecutorResourceSeq, PreExecutorScheduledHours, ExecutorScheduledStart, ExecutorScheduledEnd, CertificationRequired, CertifierResourceSeq, PreCertifierScheduledHours, CertifierScheduledStart, CertifierScheduledEnd, InspectionRequired, InspectorResourceSeq, PreInspectorScheduledHours, InspectorScheduledStart, InspectorScheduledEnd);
            }
            when "No" {
               set ExecutorResourceSeq = null;
               call AddNewAssignment(TaskSeq, Site, SkillDemandResSeq, ExecutorResourceSeq, PreExecutorScheduledHours, ExecutorScheduledStart, ExecutorScheduledEnd, CertificationRequired, CertifierResourceSeq, PreCertifierScheduledHours, CertifierScheduledStart, CertifierScheduledEnd, InspectionRequired, InspectorResourceSeq, PreInspectorScheduledHours, InspectorScheduledStart, InspectorScheduledEnd);
            }
         }
      }
      else {
         call AddNewAssignment(TaskSeq, Site, SkillDemandResSeq, ExecutorResourceSeq, PreExecutorScheduledHours, ExecutorScheduledStart, ExecutorScheduledEnd, CertificationRequired, CertifierResourceSeq, PreCertifierScheduledHours, CertifierScheduledStart, CertifierScheduledEnd, InspectionRequired, InspectorResourceSeq, PreInspectorScheduledHours, InspectorScheduledStart, InspectorScheduledEnd);
      }
   }
}

command AddAssignmentCommand for AvExeTask {
   label = "Assignment";
   enabled = [IsCertified = "PENDING"];
   mode = Global;
   variable AddAssignmentInfo Structure(AddAssignmentInfoStructure);
   variable Site Text;

   execute {
      copy this into AddAssignmentInfo;
      call GetSite(TaskSeq) into Site;
      set AddAssignmentInfo.Site = Site;
      assistant AddAssignmentAssistant(AddAssignmentInfo) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command AssignToMeCommand for JtTaskResourceDemandQuery {
   label = "Assign To Me";
   mode = SingleRecord;
   visible = [AssignedResourceId = null and not(parent.Objstate in("FINISHED", "CANCELLED"))];
   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.Objstate != "Approved"] {
         messagebox("", warning, " Free cap limit is exceeded. Do you still want to assign this?") {
            when "Yes" {
               call AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
            }
            when "No" {
               exit;
            }
         }
      }
      else {
         call AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
      }
   }
}

command UnassignMeCommand for JtTaskResourceDemandQuery {
   label = "Unassign Me";
   mode = SingleRecord;

   visible = [AssignedResourceId = parent.CurrentUser and Rowstate = "ASSIGNED"];

   execute {
      call Unassign(TaskSeq, ExecutionInstanceSeq);
   }
}

command HmAssignToMe {
   label = "Assign To Me";
   enabled = [AssignedResourceId = null or AssignedResourceId = ""];
   mode = SelectedRecords;
   variable BarcodeOfOutOfShiftTasks Text;
   variable AssignTaskConfirmed Number;

   bulkexecute {
      call ValidateTasksInMyShift(component.TaskAssignmentsList.Selection) into BarcodeOfOutOfShiftTasks;
      set AssignTaskConfirmed = 1;
      if[BarcodeOfOutOfShiftTasks != "0"] {
         messagebox("Scheduled start of task(s) outside shift", warning, "Selected task(s) are scheduled to start outside the assignee's shift. Do you want to assign anyway?") {
            when YES {
               set AssignTaskConfirmed = 1;
            }
            when "No" {
               set AssignTaskConfirmed = 0;
            }
         }
      }
      if[AssignTaskConfirmed = 1] {
         call ValidateSessUserResourceSkills(component.TaskAssignmentsList.Selection) {
            when SUCCESS {
               ifany [WorkPackageRef.IsHeavy = true and AvExeTaskRef.IsNonRoutine = true and WorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.Objstate != "Approved"] {
                  messagebox("", warning, "Free cap limit is exceeded. Do you still want to assign this?") {
                     when "Yes" {
                        bulkcall AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
                        messagebox("", information, "Do you want to view your assigned work?") {
                           when YES {
                              bulknavigate "page/FlmHmTechnicianTaskAssignments/HangarTaskAssignmentsOverview?$filter=AssignedResourceId eq $[CurrentUser]";
                              refresh;
                           }
                           when NO {
                              exit;
                           }
                        }
                     }
                     when "No" {
                        exit;
                     }
                  }
               }
               else {
                  bulkcall AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
                  messagebox("", information, "Do you want to view your assigned work?") {
                     when YES {
                        bulknavigate "page/FlmHmTechnicianTaskAssignments/HangarTaskAssignmentsOverview?$filter=AssignedResourceId eq $[CurrentUser]";
                        refresh;
                     }
                     when NO {
                        exit;
                     }
                  }
               }
            }
         }
      }
   }
}

command HmCrwLdAssignToMe {
   label = "Assign To Me";
   enabled = [AssignedResourceId = null or AssignedResourceId = ""];
   mode = SelectedRecords;
   variable BarcodeOfOutOfShiftTasks Text;
   variable AssignTaskConfirmed Number;

   bulkexecute {
      call ValidateTasksInMyShift(component.TaskAssignmentsList.Selection) into BarcodeOfOutOfShiftTasks;
      set AssignTaskConfirmed = 1;
      if[BarcodeOfOutOfShiftTasks != "0"] {
         messagebox("Scheduled start of task(s) outside shift", warning, "Selected task(s) are scheduled to start outside the assignee's shift. Do you want to assign anyway?") {
            when YES {
               set AssignTaskConfirmed = 1;
            }
            when "No" {
               set AssignTaskConfirmed = 0;
            }
         }
      }
      if[AssignTaskConfirmed = 1] {
         call ValidateSessUserResourceSkills(component.TaskAssignmentsList.Selection) {
            when SUCCESS {
               ifany [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and AvExeTaskRef.IsNonRoutine = true and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.Objstate != "Approved"] {
                  messagebox("", warning, "Free cap limit is exceeded. Do you still want to assign this?") {
                     when "Yes" {
                        bulkcall AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
                     }
                     when "No" {
                        exit;
                     }
                  }
               }
               else {
                  bulkcall AssignToMe(TaskSeq, TaskResourceSeq, PlannedHours, ResourceGroupSeq);
               }
            }
         }
      }
   }
}

command AssignToResource for ResourceVirtual {
   label = "Assign";
   mode = SingleRecord;
   variable OutOfShiftFound Number;
   variable AssignTaskConfirmed Number;

   execute {
      set AssignTaskConfirmed = 1;
      set OutOfShiftFound = 0;
      if[ShiftStart != null and ShiftEnd != null] {
         call ValidateShiftWhenAssignTaskToUser(TaskSeq, ResourceSeq) into OutOfShiftFound;
      }
      if[OutOfShiftFound != 0] {
         messagebox("Selected task scheduled to start outside assignee's shift", warning, "The assignee's shift schedule differs from the scheduled start selected task. Do you want to assign this task anyway?") {
            when "YES" {
               set AssignTaskConfirmed = 1;
            }
            when "NO" {
               set AssignTaskConfirmed = 0;
            }
         }
      }
      if[AssignTaskConfirmed = 1] {
         if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and AvExeTaskRef.IsNonRoutine = true and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.Objstate != "Approved"] {
            messagebox("", warning, "Free cap limit is exceeded. Do you still want to assign this?") {
               when "Yes" {
                  call AllocateResourceToLaborDemand(TaskSeq, TaskResourceSeq, ResourceSeq, ResourceGroupSeq, LbDemandSchedHours, component.ResourceDemandsList.Selection) {
                     when SUCCESS {
                        success("The resource demand was assigned.");
                     }
                  }
               }
               when "No" {
                  exit;
               }
            }
         }
         else {
            call AllocateResourceToLaborDemand(TaskSeq, TaskResourceSeq, ResourceSeq, ResourceGroupSeq, LbDemandSchedHours, component.ResourceDemandsList.Selection) {
               when SUCCESS {
                  success("The resource demand was assigned.");
               }
            }
         }
      }
   }
}
command UnassignLaborResource {
   label = "Unassign";
   enabled = [AssignedResourceId != null and ExecutionInstanceStatus = "Assigned"];
   mode = SelectedRecords;

   bulkexecute {
      bulkcall Unassign(TaskSeq, ExecutionInstanceSeq);
   }
}

command HmUnassignMe {
   label = "Unassign";
   enabled = [AssignedResourceId != null and AssignedResourceId = CurrentUser and ExecutionInstanceStatus = "Assigned"];
   mode = SelectedRecords;

   bulkexecute {
      bulkcall Unassign(TaskSeq, ExecutionInstanceSeq);
   }
}

command  ModifyTaskAssignment for ModifyAssignmentVirtual {
   label = "OK";
   execute {
      if[ExecutionInstanceStatus != "Completed"] {
         call ModifyTaskAssignmentScheduleHour(TaskSeq, TaskResourceSeq, LaborScheduledHours, SchedStart, SchedEnd, Remark, Site);
      }
      else {
         call ModifyTaskAssignmentActualHour(TaskSeq, TaskResourceSeq, ActualHours, ExecutionInstanceSeq, ResourceGroupSeq, Remark);
      }
   }
}

command RecordSignOffCommand for JtTaskStepSignOff {
   bulkexecute {
   }
}

