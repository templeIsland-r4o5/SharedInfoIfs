------------------------------ ENTITY DETAILS -------------------------------
entityset AddAssignmentVirtualSet for AddAssignmentVirtual;
entityset TaskAssignmentsVirtualSet for TaskAssignmentsVirtual;
entityset JtTaskSignOffReqSet for JtTaskSignOffReq;
entityset ModifyAssignmentVirtualSet for ModifyAssignmentVirtual;

@Override
entity JtTaskResourceLicense {
   from = "jt_task_res_license_av_uiv";
   use attributes = LicenseGroupId, LicenseId, LicenseName, LicenseLevelName;
   attribute TaskSeq Number {
      editable = [false];
   }
   attribute TaskResourceSeq Number {
      editable = [false];
   }
   attribute TaskResourceLicenseSeq Number {
      label = "Task Resource Certificate Seq";
   }
   attribute LicenseGroupName Text {
      fetch = "license_group_name";
      label = "Certificate Group Name";
      maxlength = 100;
      editable = [false];
   }
   attribute LicenseDescription Text {
      fetch = "license_description";
      label = "Certificate Description";
      maxlength = 100;
      editable = [false];
   }
   attribute LicenseLevelName Text {
      fetch = "license_level_name";
      editable = [true];
      insertable = [true];
      updatable = [true];
   }
   attribute CompanyId Text {
      fetch = "company_id";
      label = "Company ID";
      maxlength = 100;
      editable = [false];
   }
   reference TaskResourceSeqRef(TaskSeq, TaskResourceSeq) to JtTaskResource(TaskSeq, TaskResourceSeq) {
      label = "Demand Line No";
   }
   @DynamicComponentDependency STRACO
   reference LicenseGroupIdRef(CompanyId, LicenseGroupId) to LicenseGroupLov(CompanyId, LicenseGroupId) {
      label = "Certificate Group ID";
      copy LicenseGroupName to LicenseGroupName;
   }
   @DynamicComponentDependency STRACO
   reference LicenseIdRef(CompanyId, LicenseGroupId, LicenseId) to LicenseCompanyLov(CompanyId, LicenseGroupId, LicenseId) {
      label = "Certificate ID";
      copy LicenseGroupName to LicenseGroupName;
      copy LicenseName to LicenseName;
   }
}
@Override
entity TaskAssignmentEntity using JtTaskResource {
   from = "jt_task_resource_demand_av_uiv";
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";
   ludependencies = AvAircraftWorkPackage, JtExecutionInstance;
   crud = Read, Update;
   keys = TaskSeq, TaskResourceSeq;
   attribute TaskSeq Number;
   attribute Barcode Text;
   attribute TaskResourceSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute Rowstate Enumeration(TaskAssignmentStatus);
   attribute ResourceDemand Text {
      label = "Required Skill";
   }
   attribute TaskName Text;
   attribute TaskStatus Text {
      label = "Task Status";
   }
   attribute TaskDescription Text {
      label = "Task Description";
   }
   attribute ClassCode Text {
      label = "Class";
   }
   attribute SubclassCode Text {
      label = "Subclass";
   }
   attribute TaskLocation Text;
   attribute Crew Text;
   attribute CrewName Text;
   attribute Routine Boolean("TRUE", "FALSE");
   attribute Priority Text {
      label = "Priority";
   }
   attribute AssignedResourceId Text {
      label = "Assigned To";
   }
   attribute UserResourceUsername Text {
      fetch = "Pers_API.Get_Internal_Display_Name(assigned_resource_id)";
   }
   attribute ExecutionInstanceStatus Text {
      label = "Assignment Status";
   }
   attribute SchedStart Timestamp {
      label = "Scheduled Start";
   }
   attribute SchedEnd Timestamp {
      label = "Scheduled End";
   }
   attribute AssignmentStart Timestamp {
      label = "Actual Start";
   }
   attribute AssignmentFinish Timestamp {
      label = "Actual End";
   }
   attribute ConfigPosition Text {
      label = "Config Position";
   }
   attribute AircraftId Number {
      label = "Aircraft ID";
   }
   attribute WorkPackageId Number;
   attribute Aircraft Text {
      label = "Aircraft";
      fetch = "CONCAT(CONCAT(av_assembly_type_code, ' - '), TO_CHAR(av_reg_code))";
      lovcolumn = [true];
   }
   attribute WpBarcode Text {
      label = "Work Package";
   }
   attribute WpName Text {
      label = "Work Package Name";
   }
   attribute WpStatus Text {
      label = "Work Package Status";
   }
   attribute WpLocation Text {
      label = "Work Package Location";
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute ShiftType Enumeration(ShiftType) {
      fetch = "Flmexe_Util_API.Get_Shift_By_Sched_Start(sched_start, execution_instance_status)";
   }
   attribute ResourceGroupSeq Number;
   attribute PlannedHours Number;
   attribute LaborScheduledHours Text {
      label = "Scheduled Hours";
      fetch = "Adcom_Util_API.Get_Text_Time(planned_hours)";
   }
   attribute ActualHours Text {
      fetch = "Adcom_Util_API.Get_Text_Time(Jt_Task_Transaction_API.Get_Tot_Personel_Reported_Hrs(task_seq,execution_instance_seq))";
   }
   attribute Remark Text;
   attribute MaterialAvailability Text {
      label = "Material Availability";
   }
   attribute CurrentUser Text {
      fetch = "Fnd_Session_API.Get_Fnd_User()";
   }
   attribute OverallAssignmentsProgress Enumeration(OverallAssignmentStatuses) {
      fetch = "Av_Exe_Task_API.Get_Overall_Assign_Progress(task_seq)";
   }
   attribute LatestJobStopReason Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Reason(task_seq)";
   }
   attribute LatestJobStopSkill Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Skill(task_seq)";
   }
   attribute LatestJobStopNote Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Note(task_seq)";
   }
   attribute Site Text {
      fetch = "Work_Task_API.Get_Site(Task_Seq)";
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Sens_API.Get_Sensitivities_By_Task_Seq(Task_Seq)";
   }

   attribute IncompletionCause Text;
   attribute ActionTaken Text;
   @DynamicComponentDependency ADCON
   attribute NrApprovalSeq Number {
      fetch = "Hm_Non_Routine_Approval_API.Get_Approval_Seq_By_Fault_Id(Av_Exe_Task_API.Get_Fault_Id(task_seq))";
   }

   reference IncompletionCauseRef(IncompletionCause) to JtIncompletionCause(IncompletionCause);
   reference AvAircraftWorkPackageRef(WorkPackageId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   @DynamicComponentDependency ADCON
   reference HmNonRoutineApprovalRef(NrApprovalSeq) to HmNonRoutineApproval(NrApprovalSeq);
}

@Override
entity JtTaskSignOffReq {
   crud = Create, Read, Update, Delete;
   ludependencies = JtTask;
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";

   attribute SignOffReqType Enumeration(SignOffReqType) {
      fetch = "Jt_Task_Sign_Off_Req_API.Get_Sign_Off_Req_Type(task_seq, sign_off_req_seq)";
      required = [true];
   }
   attribute LicenseId Text {
      fetch = "LICENSE_ID";
      maxlength = 20;
      format = uppercase;
   }
   attribute OverallSignOffStatus Text {
      fetch = "Mm_Step_Sign_Off_Req_Util_API.Get_Overall_Sign_Off_Status(task_seq, sign_off_req_seq, sign_off_connection, identity)";
      editable = [false];
   }
   attribute LastSignOffDate Timestamp {
      fetch = "Mm_Step_Sign_Off_Req_Util_API.Get_Last_Sign_Off_Date(task_seq, sign_off_req_seq, sign_off_connection, identity)";
      editable = [false];
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute SignOffConnectionDb Text {
      fetch = "sign_off_connection_db";
   }
   attribute SignOffConnection Enumeration(SignOffConnection) {
      fetch = "sign_off_connection";
   }

   array JtTaskStepSignOffArray(TaskSeq, SignOffReqSeq) to JtTaskStepSignOff(TaskSeq, SignOffReqSeq) {
      where = "NVL(:child.StepObjConnLuNameDb, 'NULL') != 'AircraftPanel'";
   }
   array PanelSignOffArray(TaskSeq, SignOffReqSeq) to JtTaskStepSignOff(TaskSeq, SignOffReqSeq) {
      where = ":child.StepObjConnLuNameDb = 'AircraftPanel'";
   }
}

@Override
entity JtTaskStepSignOff {
   crud = Read;
   ludependencies = JtTask, JtTaskStep;
   attribute Role Enumeration(SignOffReqType) {
      fetch = "Jt_Task_Sign_Off_Req_API.Get_Sign_Off_Req_Type(task_seq, sign_off_req_seq)";
   }
   attribute Step Text {
      fetch = "Av_Exe_Task_Step_Util_API.Get_Order_No(Jt_Task_Step_API.Get_Order_No(task_seq, task_step_seq))";
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute Site Text {
      fetch = "Work_Task_API.Get_Site(Task_Seq)";
   }
   attribute StepObjConnLuNameDb Enumeration(JtConnectedObject.EqObject) {
      fetch = "Jt_Task_Step_API.Get_Object_Connection_Lu_Na_Db(task_seq, task_step_seq)";
   }
   attribute PanelCd Text {
      fetch = "Av_Aircraft_Panel_API.Get_Panel_Cd_By_Rowkey(Jt_Task_Step_API.Get_Object_Connection_Rowkey(task_seq, task_step_seq))";
   }
   attribute AcPanelSeq Number {
      fetch = "Av_Aircraft_Panel_API.Get_Ac_Panel_Seq_By_Rowkey(Jt_Task_Step_API.Get_Object_Connection_Rowkey(task_seq, task_step_seq))";
   }
   attribute ZoneCd Text {
      fetch = "Av_Aircraft_Panel_API.Get_Zone_Cd_By_Panel_Rowkey(Jt_Task_Step_API.Get_Object_Connection_Rowkey(task_seq, task_step_seq))";
   }
   attribute PanelStatus Enumeration(PanelStatuses) {
      fetch = "Av_Exe_Task_Panel_API.Get_Panel_Status(task_seq, task_step_seq)";
   }

   reference JtTaskStepRef(TaskSeq, TaskStepSeq) to JtTaskStep(TaskSeq, TaskStepSeq) {
      label = "Task Step";
   }
   reference JtTaskSignOffReqRef(TaskSeq, SignOffReqSeq) to JtTaskSignOffReq(TaskSeq, SignOffReqSeq);
   reference AvZoneCodeRef(ZoneCd) to TaskZoneLov(ZoneCode);
   reference AvPanelCodeRef(PanelCd) to TaskPanelLov(PanelCode);
   reference AvAircraftPanelRef(AcPanelSeq) to AircraftPanelLov(AcPanelSeq);
}
---------------------------------- QUERIES ----------------------------------
query JtTaskResourceDemandQuery {
   from = "jt_task_resource_demand_av_uiv";
   where = "demand_type = 'Person'";
   keys = TaskSeq, TaskResourceSeq;
   lu = none;
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";

   attribute TaskSeq Number;
   attribute TaskResourceSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute ResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute PlannedHours Number;
   attribute ExecutionInstanceStatus Text;
   attribute PlannedHoursFormat Text {
      fetch = "Adcom_Util_API.Get_Text_Time(planned_hours)";
      label = "Scheduled Hours";
   }
   attribute AllocatedHours Number;
   attribute ResourceDemand Text {
      label = "Required Skills";
   }
   attribute AssignedResourceId Text;
   attribute AssignedResourceSeq Number;
   attribute UserResourceUsername Text {
      fetch = "Pers_API.Get_Internal_Display_Name(assigned_resource_id)";
      label = "Assign To";

   }
   attribute AssignmentStart Timestamp {
      label = "Actual Start";
   }
   attribute AssignmentFinish Timestamp {
      label = "Actual End";
   }
   attribute AllocatedStart Timestamp {
      label = "Start";
      displaytimezone = UtcTimeZoneCode;
   }
   attribute AllocatedFinish Timestamp {
      label = "End";
      displaytimezone = UtcTimeZoneCode;
   }
   attribute FixedStart Timestamp;
   attribute WorkStart Timestamp;
   attribute Rowstate Enumeration(TaskAssignmentStatus) {
      label = "Assignment Status";
   }
   attribute Remark Text {
      label = "Assignment Role";
   }
   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute AircraftId Number;
   attribute WorkPackageId Number;
   attribute IncompletionCause Text {
      label = "Job Stop Reason Code";
   }
   attribute ActionTaken Text {
      label = "Job Stop Note";
   }
   attribute Barcode Text;

   attribute Aircraft Text {
      label = "Aircraft";
      fetch = "CONCAT(CONCAT(av_assembly_type_code, ' - '), TO_CHAR(av_reg_code))";
      lovcolumn = [true];
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute CurrentUser Text {
      fetch = "Fnd_Session_API.Get_Fnd_User()";
   }
   attribute JobStopReason Text {
      fetch = "Labour_Assignment_Util_API.Get_Assignment_Job_Stop_Reason(incompletion_cause)";
   }
   attribute IsClockedIn Boolean("TRUE", "FALSE") {
      fetch = "Jt_Task_Clocking_API.Is_Clocked_In(task_seq, execution_instance_seq)";
   }
   attribute SchedStart Timestamp {
      label = "Scheduled Start";
   }
   attribute SchedEnd Timestamp {
      label = "Scheduled End";
   }
   attribute Location Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Location_Code(Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq))";
   }
   attribute Site Text {
      fetch = "Work_Task_API.Get_Site(task_seq)";
   }
   attribute IsNonRoutine Boolean("TRUE", "FALSE") {
      fetch = "Av_Exe_Task_API.Is_Non_Routine(task_seq)";
   }
   @DynamicComponentDependency ADCON
   attribute NrApprovalSeq Number {
      fetch = "Hm_Non_Routine_Approval_API.Get_Approval_Seq_By_Fault_Id(Av_Exe_Task_API.Get_Fault_Id(task_seq))";
   }
   @DynamicComponentDependency ADCON
   attribute IsExecutionBlockedByCap Boolean("TRUE", "FALSE") {
      fetch = "Adcon_Util_API.Is_Execution_Blocked_By_Cap()";
   }

   array ResourceLicenceArray(TaskSeq, TaskResourceSeq) to JtTaskResourceLicense(TaskSeq, TaskResourceSeq);

   reference AvAircraftWorkPackageRef(WorkPackageId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   @DynamicComponentDependency ADCON
   reference HmNonRoutineApprovalRef(NrApprovalSeq) to HmNonRoutineApproval(NrApprovalSeq);
}

query TaskResourceLov {
   from = "resource_lov";
   keys = ResourceSeq;
   ludependencies = Resource;
   lu = none;
   attribute ResourceSeq Number {
      lovcolumn = [true];
      fetch = "Resource_Seq";
      label = "ResourceSeq";
   }
   attribute ResourceId Text {
      lovcolumn = [true];
      fetch = "Resource_Id";
      label = "ResourceId";
   }
   attribute Description Text {
      lovcolumn = [true];
      fetch = "Description";
      label = "Description";
   }
   where = "resource_type = 'Person Group' and used_in_maintenance ='True'";
   reference SkillDemandLovRef(ResourceSeq) to TaskResourceLov(ResourceSeq);
}

query LaborResourceLov {
   from = "resource_join_parent";
   keys = ResourceParentSeq, ResourceSeq;
   ludependencies = Resource, ResourceParent;
   lu = none;
   attribute ResourceParentSeq Number {
      lovcolumn = [true];
      fetch = "Resource_Parent_Seq";
      label = "ResourceSeq";
   }
   attribute ResourceSeq Number {
      lovcolumn = [true];
      fetch = "Resource_Seq";
      label = "ResourceSeq";
   }
   attribute ResourceId Text {
      lovcolumn = [true];
      fetch = "Resource_Id";
      label = "ResourceId";
   }
   attribute Description Text {
      lovcolumn = [true];
      fetch = "Description";
      label = "Description";
   }
   where = "resource_type = 'Person'";
   reference ExecutorAssignedLovRef(ResourceParentSeq, ResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
   reference CertifierAssignedLovRef(ResourceParentSeq, ResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
   reference InspectorAssignedLovRef(ResourceParentSeq, ResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
}

query AvTaskQuery {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   from = "Task_For_Airport_Offset_View";
   lu = AvExeTask;
   luname = "luname";
   keyref = "keyref_value";
   keys = TaskSeq, LegNo;
   ludependencies = AvTaskQuery, TaskCompetencyQuery, ResourceGanttQuery;
   attribute LegNo Text;
   attribute TaskSeq Number {
      label = "Task ID";
   }
   attribute AircraftId Number {
      label = "Aircraft ID";
   }
   attribute AircraftWpId Number {
      label = "Aircraft Workpackage ID";
   }
   attribute TaskCode Text {
      label = "Task Code";
   }
   attribute ArrivalAirportId Number {
      label = "Arrival Airport ID";
   }
   attribute Barcode Text;
   attribute TaskName Text;
   attribute Priority Text;
   attribute Objstate Enumeration(AvExeTaskState) {
      label = "State";
   }
   attribute Aircraft Text {
      fetch = "Av_Exe_Task_API.Get_Aircraft(aircraft_id)";
   }
   attribute AircraftTypeName Text {
      fetch = "Av_Assembly_API.Get_Assembly_Type_Name(Aircraft_API.Get_Assembly_Type_Code(aircraft_id))";
   }
   attribute AirportSite Text {
      fetch = "Av_Airport_API.Get_Site(arrival_airport_id)";
   }
   attribute ShedArrivalDateTime Timestamp {
      label = "Arrival Time";
      fetch = "Av_Exe_Task_API.Get_Arrival_Time(task_seq)";
   }
   attribute ShedDepartureDateTime Timestamp {
      label = "Departure Time";
      fetch = "Av_Exe_Task_API.Get_Departure_Time(task_seq)";
   }
   attribute ResourceAssignmentStatus Number {
      fetch = "Av_Exe_Task_API.Get_Resource_Assignment_Status(task_seq)";
   }
   attribute ResAssignDisplayStatus Enumeration(AssignmentStatus) {
      label = "Assignment Status";
      fetch = "DECODE(Av_Exe_Task_API.Get_Resource_Assignment_Status(task_seq),1,'NoReqSkill',2,'Unassigned',3,'ResourceConflict',4,'PartiallyAssigned','Assigned')";
   }
   attribute RecordId Text {
      fetch = "Adcom_Util_API.Record_Id_For_Fault_And_Task(fault_id , task_seq)";
   }
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute ClassCode Text;
   attribute SubclassCode Text;
   attribute WorkType Text {
      fetch = "Av_Work_Package_Work_Type_API.Get_Work_Types_For_Workpackage(aircraft_wp_id)";
   }

   attribute ConvertedDuration Text {
      fetch = "Adcom_Util_API.Get_Text_Time(duration)";
   }
   attribute OverallAssignmentsProgress Enumeration(OverallAssignmentStatuses) {
      fetch = "Av_Exe_Task_API.Get_Overall_Assign_Progress(task_seq)";
   }
   attribute LatestJobStopReason Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Reason(task_seq)";
   }
   attribute LatestJobStopSkill Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Skill(task_seq)";
   }
   attribute LatestJobStopNote Text {
      fetch = "Av_Exe_Task_API.Get_Latest_Jobstop_Note(task_seq)";
   }
   attribute IsCompleted Text {
      fetch = "DECODE(Av_Exe_Task_API.Get_Approval_Number(task_seq), NULL, 'PENDING','SIGNED')";
      editable = [false];
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Sens_API.Get_Sensitivities_By_Task_Seq(task_seq)";
   }
   reference AvAircraftWorkPackageRef(AircraftWpId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvAirportRef(ArrivalAirportId) to AvAirport(AirportId);
   reference AvAircraftRef(AircraftId) to Aircraft(AircraftId);
   array ResourcesArray(AirportSite) to ResourceGanttQuery(Site) {
      where = "((:parent.TaskSeq = :child.TaskSeq))";
   }
   array JtTaskResourceDemandArray(TaskSeq) to JtTaskResourceDemandQuery(TaskSeq);
}

query ResourceGanttQuery {
   from = "Ad_Task_Resource_view";
   where = "resource_type ='PERSON'";
   keys = ResourceSeq;
   lu = none;
   ludependencies = ResourceGanttQuery, AvTaskQuery, JtTaskResourceQuery;

   attribute ResourceSeq Number;
   attribute ResourceId Text {
      label = "Resource ID";
   }
   attribute ResourceType Enumeration(ResourceTypes) {
      fetch = "resource_type_db";
   }
   attribute Description Text {
      label = "Name";
   }
   attribute TaskSeq Number;
   attribute Site Text;
   attribute Assignment Text;
   attribute SkillDemand Text {
      label = "Skill Demand";
   }
   attribute IsAvailable Boolean("TRUE", "FALSE") {
      fetch = "DECODE(avaiability,1,'TRUE','FALSE')";
   }
   attribute RowRank Number;
   attribute GanttRow Text;
   attribute ResType Text;
   array ResourceShiftArray(GanttRow, ResType) to TaskCompetencyQuery(GanttRow, ResType);
}

query TaskCompetencyQuery {
   from = "Ad_Task_Competency_View";
   lu = none;
   keys = TaskSeq, TaskResourceSeq, ExecutionInstanceSeq;
   ludependencies = TaskCompetencyQuery, AvTaskQuery, JtTaskResourceQuery;
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   attribute TaskSeq Number {
      label = "Task ID";
   }
   attribute AssignmentId Text;
   attribute TaskResourceSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute AssignedUser Text;
   attribute AssignedUserResSeq Number;
   attribute StartStamp Timestamp;
   attribute EndStamp Timestamp;
   attribute ResType Text;
   attribute SkillDemand Text {
      label = "Skill Demand";
   }
   attribute GanttItemLabel Text {
      fetch = " Aircraft_API.Get_Reg_Code(Av_Flight_API.Get_Aircraft_Id(Av_Aircraft_Work_Package_API.Get_Flight_Id(Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq)))) || '-' || skill_demand";
   }


   attribute GanttRow Text;
   action AssignUserToCompetency Text {
      parameter AssignedUser Text;
      parameter StartStamp Timestamp;
      parameter EndStamp Timestamp;
      ludependencies = TaskCompetencyQuery, ResourceGanttQuery;
   }
}


query LicenseGroupLov {
   from = "license_group_lov";
   lu = LicenseGroup;
   keys = CompanyId, LicenseGroupId;
   ludependencies = LicenseGroup;
   attribute CompanyId Text {
      lovcolumn = [false];
   }
   attribute LicenseGroupId Text {
      label = "Certificate Group ID";
      format = uppercase;
      lovcolumn = [true];
   }
   attribute LicenseGroupName Text {
      label = "Certificate Group Name";
      lovcolumn = [true];
   }
}

query LicenseCompanyLov {
   from = "license_company_lov";
   lu = LicenseCompany;
   keys = CompanyId, LicenseGroupId, LicenseId;
   ludependencies = LicenseCompany;
   attribute CompanyId Text {
      lovcolumn = [false];
   }
   attribute LicenseGroupId Text {
      label = "Certificate Group ID";
      lovcolumn = [false];
   }
   attribute LicenseId Text {
      label = "Certificate ID";
      lovcolumn = [true];
   }
   attribute LicenseName Text {
      label = "Certificate Name";
      lovcolumn = [true];
   }
   attribute LicenseGroupName Text {
      label = "Certificate Group Name";
      lovcolumn = [true];
   }
   attribute State Text {
      lovcolumn = [true];
   }
}

@Override
query JtTaskLaborSummaryTotal {
   from = "jt_task_trans_res_total_av_uiv";
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   keys = TaskSeq, ResourceSeq {
      where = "TASK_SEQ = :TaskSeq";
   }
   lu = none;
   attribute TaskSeq Number;
   attribute ResourceSeq Number;
   attribute Skill Text {
      fetch = "Resource_API.Get_Resource_Id(resource_seq)";
   }
   attribute ActualHours Number {
      fetch = "Adcom_Util_API.Hours_To_Milliseconds(actual_hours)";
      label = "Actual Hours";
   }
   attribute ScheduledHours Number {
      fetch = "Adcom_Util_API.Hours_To_Milliseconds(scheduled_hours)";
      label = "Scheduled Hours";
   }
}

@Override
query JtTaskLaborSummaryBreakdown {
   from = "jt_task_trans_res_bdown_av_uiv";
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";
   keys = TaskSeq, ResourceSeq, ResourceRemark {
      where = "TASK_SEQ = :TaskSeq";
   }
   lu = none;
   attribute TaskSeq Number;
   attribute ResourceSeq Number;
   attribute Skill Text {
      fetch = "Resource_API.Get_Resource_Id(resource_seq)";
   }
   attribute ResourceRemark Text {
      label = "Assignment Role";
   }
   attribute ResourceRemarkRank Number;
   attribute ActualHours Number {
      fetch = "Adcom_Util_API.Hours_To_Milliseconds(actual_hours)";
      label = "Actual Hours";
   }
   attribute ScheduledHours Number {
      fetch = "Adcom_Util_API.Hours_To_Milliseconds(scheduled_hours)";
      label = "Scheduled Hours";
   }
}
--------------------------------- VIRTUALS ----------------------------------
virtual AddAssignmentVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(Task_Seq))";

   attribute TaskSeq Number;
   attribute SkillDemandResSeq  Number;
   attribute ExecutorResourceSeq Number;
   attribute CertifierResourceSeq Number;
   attribute InspectorResourceSeq Number;
   attribute PreExecutorScheduledHours Text;
   attribute PreCertifierScheduledHours Text;
   attribute PreInspectorScheduledHours Text;
   attribute ExecutorScheduledHours Number;
   attribute CertifierScheduledHours Number;
   attribute InspectorScheduledHours Number;
   attribute AssignedTo Text;
   attribute ExecutorScheduledStart  Timestamp;
   attribute ExecutorScheduledEnd  Timestamp;
   attribute CertifierScheduledStart Timestamp;
   attribute CertifierScheduledEnd Timestamp;
   attribute InspectorScheduledStart Timestamp;
   attribute InspectorScheduledEnd Timestamp;
   attribute CertificationRequired Boolean {
      default = "false";
      required = [true];
   }
   attribute InspectionRequired Boolean {
      default = "false";
      required = [true];
   }
   attribute AssignedCertifier Text;
   attribute AssignedInspector Text;

   attribute UtcTimeZoneCode Text {
      fetch = "'UTC'";
   }
   attribute Site Text;
   attribute AircraftWpId Number {
      fetch = "Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq)";
   }
   @DynamicComponentDependency ADCON
   attribute NrApprovalSeq Number {
      fetch = "Hm_Non_Routine_Approval_API.Get_Approval_Seq_By_Fault_Id(Av_Exe_Task_API.Get_Fault_Id(task_seq))";
   }
   reference SkillDemandLovRef(SkillDemandResSeq) to TaskResourceLov(ResourceSeq);
   reference ExecutorAssignedLovRef(SkillDemandResSeq, ExecutorResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
   reference CertifierAssignedLovRef(SkillDemandResSeq, CertifierResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
   reference InspectorAssignedLovRef(SkillDemandResSeq, InspectorResourceSeq) to LaborResourceLov(ResourceParentSeq, ResourceSeq);
   reference AvAircraftWorkPackageRef(AircraftWpId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   @DynamicComponentDependency ADCON
   reference HmNonRoutineApprovalRef(NrApprovalSeq) to HmNonRoutineApproval(NrApprovalSeq);
}
virtual TaskAssignmentsVirtual {
   ludependencies = ResourceDemandsVirtual, ResourceVirtual;
   attribute TaskSeq Number;
   attribute Barcode Text;
   attribute AircraftId Number;
   attribute Aircraft Text;
   attribute WoNumber Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Wo_Number(Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq))";
   }
   attribute Sensitivities Text {
      fetch = "Av_Exe_Task_Sens_API.Get_Sensitivities_By_Task_Seq(task_seq)";
   }

   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   array ResourceDemandsArray() to ResourceDemandsVirtual();
}

virtual ResourceDemandsVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";
   attribute TaskSeq Number;
   attribute TaskResourceSeq Number;
   attribute SkillDemand Text;
   attribute Remark Text;
   attribute PlannedHours Text;
   attribute SchedStart Timestamp;
   attribute SchedEnd Timestamp;
   attribute LicenseId Text;
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute ResourceGroupSeq Number;
   attribute LbDemandSchedHours Number;
   array ResourceArray(TaskSeq, TaskResourceSeq, LicenseId) to ResourceVirtual(TaskSeq, TaskResourceSeq, LicenseId);
}

virtual ResourceVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";
   attribute TaskSeq Number;
   attribute TaskResourceSeq Number;
   attribute ResourceSeq Number;
   attribute Description Text;
   attribute LicenseId Text;
   attribute TotalAssignments Number;
   attribute TotalHours Number;
   attribute ShiftStart Timestamp;
   attribute ShiftEnd Timestamp;
   attribute ResourceGroupSeq Number;
   attribute LbDemandSchedHours Number;
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute AircraftWpId Number {
      fetch = "Av_Exe_Task_API.Get_Aircraft_Wp_Id(task_seq)";
   }
   @DynamicComponentDependency ADCON
   attribute NrApprovalSeq Number {
      fetch = "Hm_Non_Routine_Approval_API.Get_Approval_Seq_By_Fault_Id(Av_Exe_Task_API.Get_Fault_Id(task_seq))";
   }
   reference AvAircraftWorkPackageRef(AircraftWpId) to AvAircraftWorkPackage(AircraftWorkPackageId);
   reference AvExeTaskRef(TaskSeq) to AvExeTask(TaskSeq);
   @DynamicComponentDependency ADCON
   reference HmNonRoutineApprovalRef(NrApprovalSeq) to HmNonRoutineApproval(NrApprovalSeq);
}

virtual ModifyAssignmentVirtual {
   timestamptzref = "site(Work_Task_API.Get_Site(task_seq))";
   attribute TaskSeq Number;
   attribute TaskResourceSeq Number;
   attribute ResourceGroupSeq Number;
   attribute ExecutionInstanceSeq Number;
   attribute SkillDemand Text;
   attribute UserResource Text;
   attribute UserResourceUsername Text;
   attribute ExecutionInstanceStatus Text;
   attribute SchedStart Timestamp;
   attribute SchedEnd Timestamp;
   attribute AssignmentStart Timestamp;
   attribute AssignmentFinish Timestamp;
   attribute ActualHours Text;
   attribute PlannedHours Number;
   attribute LaborScheduledHours Text;
   attribute Remark Text;
   attribute IncompletionCause Text;
   attribute ActionTaken Text;
   attribute CurrentUserAirportTimeZone Text {
      fetch = "Av_Airport_For_User_API.Get_User_Time_Zone()";
   }
   attribute Site Text {
      fetch = "Work_Task_API.Get_Site(Task_Seq)";
   }

   reference IncompletionCauseRef(IncompletionCause) to JtIncompletionCause(IncompletionCause);
   reference JTTransactionRef(TaskSeq, TaskResourceSeq) to JtTaskTransaction(TaskSeq, TaskResourceSeq);
}

-------------------------------- STRUCTURES ---------------------------------
structure ScheduleRangeStructure {
   timestamptzref = "server";
   attribute StartDate Timestamp;
   attribute EndDate Timestamp;
}

structure ScheduleHoursStructure {
   attribute PreScheduleHours Text;
   attribute ScheduleHours Number;
}

structure ScheduleIntervalStructure {
   timestamptzref = "server";
   attribute StartDate Timestamp;
   attribute EndDate Timestamp;
   attribute PreScheduleHours Text;
}

structure AddAssignmentInfoStructure {
   attribute TaskSeq Number;
   attribute Site Text;
}

---------------------------------- ACTIONS ----------------------------------
action AddNewAssignment {
   initialcheck none;
   timestamptzref = "site(Site)";

   parameter TaskSeq Number;
   parameter Site Text;
   parameter SkillDemandResSeq Number;
   parameter ExecutorResSeq Number;
   parameter PreExecutorScheduledHours Text;
   parameter ExecutorScheduledStart Timestamp;
   parameter ExecutorScheduledEnd Timestamp;

   parameter CertificationRequired Boolean;
   parameter CertifierResSeq Number;
   parameter PreCertifierScheduledHours Text;
   parameter CertifierScheduledStart Timestamp;
   parameter CertifierScheduledEnd Timestamp;

   parameter InspectionRequired Boolean;
   parameter InspectorResSeq Number;
   parameter PreInspectorScheduledHours Text;
   parameter InspectorScheduledStart Timestamp;
   parameter InspectorScheduledEnd Timestamp;
   ludependencies = AvExeTask, JtTaskResource, JtExecutionInstance, JtTaskResourceDemandQuery, JtTaskLaborSummaryTotal, JtTaskLaborSummaryBreakdown, AvTaskQuery, JtTaskStep;
}
action AssignToMe {
   initialcheck none;
   parameter TaskSeq Number;
   parameter TaskResourceSeq   Number;
   parameter PlannedHours Number;
   parameter ResourceGroupSeq Number;
   ludependencies = JtTaskResourceDemandQuery, AvTaskQuery, JtExecutionInstance, TaskAssignmentEntity;
}

action Unassign {
   initialcheck none;
   parameter TaskSeq               Number;
   parameter ExecutionInstanceSeq  Number;

   ludependencies = JtTaskResourceDemandQuery, AvExeTask, JtExecutionInstance, TaskAssignmentEntity, AvTaskQuery, TaskCompetencyQuery, ResourceGanttQuery;
}

action ValidateSessUserResourceSkills {
   initialcheck none;
   parameter Selection Text;
}

action ProxyJobStop {
   initialcheck none;
   timestamptzref = "site(Site)";

   parameter TaskSeq              Number;
   parameter TaskResourceSeq      Number;
   parameter ExecutionInstanceSeq Number;
   parameter ResourceGroupSeq     Number;
   parameter AssignmentRole       Text;
   parameter CurrAssignmentStatus Text;
   parameter StartTime            Timestamp;
   parameter ScheduledHours       Number;
   parameter Site                 Text;

   ludependencies = TaskAssignmentEntity, AvExeTask, JtTaskResource, JtExecutionInstance, JtTaskResourceDemandQuery;

}
action AllocateResourceToLaborDemand {
   initialcheck none;
   ludependencies = JtExecutionInstance, ResourceVirtual, ResourceDemandsVirtual, AvTaskQuery, JtTaskResourceDemandQuery, TaskAssignmentEntity, ResourceGanttQuery, TaskCompetencyQuery;
   parameter TaskSeq Number;
   parameter TaskResourceSeq Number;
   parameter ResourceSeq Number;
   parameter ResourceGroupSeq Number;
   parameter LbDemandSchedHours Number;
   parameter Selection Text;
}

action PauseAssignment {
   initialcheck none;
   parameter TaskSeq Number;
   parameter ExecutionInstanceSeq Number;
   ludependencies = JtTaskResourceDemandQuery, TaskAssignmentEntity, JtExecutionInstance, JtTaskTransaction, JtTaskLaborSummaryTotal, JtTaskLaborSummaryBreakdown;
}

action ContinueAssignment {
   initialcheck none;
   parameter TaskSeq Number;
   parameter ExecutionInstanceSeq Number;
   ludependencies = JtTaskResourceDemandQuery, TaskAssignmentEntity, JtExecutionInstance;
}

action ModifyTaskAssignmentScheduleHour {
   initialcheck none;
   timestamptzref = "site(Site)";

   parameter TaskSeq             Number;
   parameter TaskResourceSeq     Number;
   parameter LaborScheduledHours Text;
   parameter SchedStart          Timestamp;
   parameter SchedEnd            Timestamp;
   parameter Remark              Text;
   parameter Site                Text;

   ludependencies = TaskAssignmentEntity, JtTaskResource, JtTaskResourceDemandQuery, AvExeTask, ModifyAssignmentVirtual;
}

action ModifyTaskAssignmentActualHour {
   initialcheck none;
   parameter TaskSeq                Number;
   parameter TaskResourceSeq        Number;
   parameter ActualHours            Text;
   parameter ExecutionInstanceSeq   Number;
   parameter ResourceGroupSeq       Number;
   parameter Remark                 Text;

   ludependencies = TaskAssignmentEntity, JtTaskResource, JtTaskResourceDemandQuery, JTTaskTransaction, AvExeTask, ModifyAssignmentVirtual;
}

--------------------------------- FUNCTIONS ---------------------------------
function GetScheduleTimeRange Structure(ScheduleRangeStructure) {
   timestamptzref = "server";

   parameter TaskSeq Number;
   parameter DurationHours Number;
}

function GetScheduleDateAndInterval Structure(ScheduleIntervalStructure) {
   timestamptzref = "server";

   parameter TaskSeq Number;
   parameter DurationHhmm Text;
   parameter Field Text;
}

function ValidateScheduleDates Structure(ScheduleHoursStructure) {
   timestamptzref = "server";

   parameter TaskSeq Number;
   parameter StartDate Timestamp;
   parameter EndDate Timestamp;
   parameter Field Text;
}

function ValidateTasksInMyShift Text {
   initialcheck none;
   parameter Selection Text;
}

function ValidateShiftWhenAssignTaskToUser Number {
   initialcheck none;
   parameter TaskSeq Number;
   parameter ResourceSeq Number;
}

function GetPersonResources List < Entity(LaborResourceLov) > {
   parameter SkillDemandResourceId Text;
   parameter LicenseSuffix Text;
   where = "Pers_License_Profile_API.Check_Exist(resource_id, CONCAT(:SkillDemandResourceId,:LicenseSuffix))='TRUE'";
}

function CheckActiveAssgmtForSkillRole Boolean {
   initialcheck none;
   parameter TaskSeq Number;
   parameter SkillResSeq Number;
   parameter AssignmentRole Text;
   parameter UserResSeq Number;
}

function ValidateAssignments Boolean {
   initialcheck none;
   parameter Selection Text;
   parameter TaskSeqNo Number;
}

function GetSite Text {
   parameter TaskSeq Number;
}
------------------------------- ENUMERATIONS --------------------------------
enumeration AssignmentStatus {
   value = "NoReqSkill" {
      label = "No Required Skills";
   }
   value = "Unassigned" {
      label = "Unassigned";
   }
   value = "Assigned" {
      label = "Assigned";
   }
   value = "PartiallyAssigned" {
      label = "Partially Assigned";
   }
   value = "ResourceConflict" {
      label = "Resource Conflict";
   }
}

enumeration TaskAssignmentStatus {
   value = "ASSIGNED" {
      label = "Assigned";
   }
   value = "WORKSTARTED" {
      label = "Work Started";
   }
   value = "COMPLETED" {
      label = "Completed";
   }
   value = "CANCELLED" {
      label = "Cancelled";
   }
}

enumeration OverallAssignmentStatuses {
   value = "NotStarted" {
      label = "Not Started";
   }
   value = "InProgress" {
      label = "In Progress";
   }
   value = "Paused" {
      label = "Paused";
   }
   value = "Finished" {
      label = "Finished";
   }
}
