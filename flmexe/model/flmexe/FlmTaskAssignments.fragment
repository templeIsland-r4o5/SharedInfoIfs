selector ReferenceResourceGroupLovSelector for TaskResourceLov {
   label = "";
   static ResourceId;
   static Description;
}

selector ReferenceNewLaborResourceLovSelector for LaborResourceLov {
   label = "";
   static ResourceId;
   static Description;
}

@Overtake
selector ReferenceLicenseGroupLovSelector for LicenseGroupLov {
   static LicenseGroupId;
   static LicenseGroupName;
}

@Overtake
selector ReferenceLicenseCompanyLovSelector for LicenseCompanyLov {
   orderby = LicenseName;
