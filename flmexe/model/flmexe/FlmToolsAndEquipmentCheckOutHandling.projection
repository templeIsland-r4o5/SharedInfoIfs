projection FlmToolsAndEquipmentCheckOutHandling;
component FLMEXE;
layer Core;
description "Check Out Tool/Equipment for Demands in flm";
category Users;

--------------------------------- FRAGMENTS ---------------------------------
include fragment ToolEquipmentCheckOutList;
include fragment WorkTaskAllSelector;
----------------------------- MAIN ENTRY POINTS -----------------------------


------------------------------ ENTITY DETAILS -------------------------------


------------------------------- ENUMERATIONS --------------------------------


---------------------------------- QUERIES ----------------------------------
@Override
query ToolDemandsCheckout {
   where = "Resource_Tool_Equip_Group_API.Get_Tool_Tracking_Db(resource_group_seq) = 'TRACK_CHECKOUT'
   AND (resource_act_alloc_seq IS NULL OR Tool_Eq_Chck_Out_Aloc_Conn_API.Is_Tool_Checked_Out_For_Alloc(resource_seq, resource_act_alloc_seq) = 'FALSE')
   AND Work_Task_API.Get_Rowtype(order_ref1) = 'AvExeTask'";

   attribute RegCode Text {
      fetch = "Aircraft_API.Get_Reg_Code(Av_Aircraft_Work_Package_API.Get_Aircraft_Id(order_ref2))";
   }
   attribute LocationCode Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Location_Code(order_ref2)";
   }
   attribute TaskDesc Text {
      label = "Task Description";
   }
   attribute TaskSite Text {
      label = "Demand Site";
      fetch = "Work_Task_API.Get_Site(order_ref1)";
   }
   attribute Barcode Text {
      fetch = "Av_Exe_Task_API.Get_Barcode(order_ref1)";
   }
   attribute WoNumber Text {
      fetch = "Av_Aircraft_Work_Package_API.Get_Wo_Number(order_ref2)";
   }
   attribute SerialNo Text {
      fetch = "Resource_Tool_Equip_API.Get_Serial_No(Resource_seq)";
   }
   attribute PartNo Text {
      fetch = "Resource_API.Get_Resource_Id(Resource_Parent_API.Get_Parent_Seq(Resource_seq))";
   }

   reference TaskSeqRef(Barcode) to AvExeTask(Barcode);
}

---------------------------------- ACTIONS ----------------------------------


--------------------------------- FUNCTIONS ---------------------------------
function GetDemandList List<Entity(ToolDemandsCheckout)> {
   timestamptzref = "server";

   parameter Assignee Text;
   parameter TodayDemands Boolean;

   basedon ToolDemandsCheckoutSet;
   where = "(:Assignee IS NULL OR (:Assignee IS NOT NULL AND order_ref1
   IN (select DISTINCT order_ref1 from jt_execution_instance_uiv c where c.resource_id = :Assignee and c.resource_type_db = 'PERSON')))
   AND (:TodayDemands = 'FALSE' OR (:TodayDemands = 'TRUE' AND trunc(sysdate) = nvl(trunc(allocated_start), trunc(planned_start))))";

   alterattribute SearchContextAssignee {
      fetch = ":Assignee";
   }
}

