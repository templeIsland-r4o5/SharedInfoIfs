client FlmFaultSearch;
component FLMEXE;
layer Core;
projection FlmFaultSearchHandling;

description "Fault Search Client";

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------

-------------------------------- MAIN PAGES ---------------------------------

page FlmFaultSearch using AvFaultSearchSet {
   label = "Aviation Faults";
   list FaultSearchList;
}
--------------------------------- COMMANDS ----------------------------------
command NavigateFaultDetail for GetFaultList {
   label = "Details";
   icon = "popup";
   execute {
      if [Owner = "MM"] {
         navigate "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[MmId]";
      }
      else {
         navigate "page/MxFaultDetail/FaultDetails?$filter=Barcode eq $[AggregateId]";
      }
   }
}
--------------------------------- SELECTORS ---------------------------------


---------------------------------- GROUPS -----------------------------------


----------------------------------- LISTS -----------------------------------
list FaultSearchList for GetFaultList {

   label = "Fault List";

   field AggregateId {
      label = "Record ID";
   }
   field AircraftTypeCode {
      label = "Aircraft Type";
      size = Small;
   }
   field RegCode {
      label = "Registration Code";
   }
   field Description {
      label = "Name";
      multiline = true;
      size = Large;
   }
   field SubSystem {
      label = "Failed System";
      size = Small;
   }
   badge Status {
      label = "Fault Status ";
      size = Small;
      style = TextOnly;
      emphasis Warning = [Status = "Open"];
      emphasis Info = [Status = "Deferred"];
      emphasis Ok = [Status = "Closed"];
      emphasis Neutral = [Status = "NoFaultFound"];
   }
   field FoundOnDate {
      label = "Found on Date";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field DueDate {
      label = "Due Date";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field ClosedDate {
      label = "Closed Date";
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field LastActionDesc {
      label = "Last Action Taken";
      multiline = true;
      size = Large;
   }
   field DeferralAuthorization {
      label = "Deferral Authorization No";
      size = Small;
   }
   field DeferralReqReasonDesc {
      label = "Deferral Reason";
   }
   field LogbookTypeCode {
      label = "Log Type";
      size = Small;
   }
   field FaultSeverity;

   command NavigateFaultDetail;

}

