command RequestDeferral for AvExeTask {
   visible = [IsCertified = "PENDING" and Objstate != "WORKSTARTED" and(AvDeferralRequestRef = null or AvDeferralRequestRef.DeferralRequestStatus = "Rejected" or AvDeferralRequestRef.DeferralRequestStatus = "Pending" or AvDeferralRequestRef.MocRequired = false)];
   label = "Request Deferral";
   enabled = [AvFaultRef.UserRole != "MM_MAINT_OPERATIONS_CONTROLLER" and AvFaultRef.Objstate = "Open"];
   variable SelectReferenceURL Text;
   variable ExternalPagePath Text;
   variable AType Text;
   variable ASource Text;
   variable ATaskId Text;
   variable IsDeferAllowed Boolean;
   execute {
      if[IsNonRoutine = true] {
         call CheckDeferNr(FaultId) into IsDeferAllowed;
         if[IsDeferAllowed = true] {
            set ExternalPagePath = "/lmocweb/select-reference/index.html";
            set AType = "DEFERRAL";
            set ASource = "MM";
            set ATaskId = ExternalId;
            call GetSelectReferenceUrl(ExternalPagePath, ATaskId, AType, ASource) into SelectReferenceURL;
            navigate "${SelectReferenceURL}";
         }
         else {
            confirm("Add the Logbook Reference to defer the Non-Routine") {
               when OK {
                  navigate "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
               }
               when CANCEL {
                  refresh;
               }
            }
         }
      }
      else {
         set ExternalPagePath = "/lmocweb/select-reference/index.html";
         set AType = "DEFERRAL";
         set ASource = "MM";
         set ATaskId = ExternalId;
         call GetSelectReferenceUrl(ExternalPagePath, ATaskId, AType, ASource) into SelectReferenceURL;
         navigate "${SelectReferenceURL}";
      }
   }
}

