assistant AddMeasurementAssistant using AddMeasurementVirtualSet {
   label = "Add Measurement";
   savemode = OnLostFocus;

   input(TaskSeq, TaskSite);
   singlestep {
      group AddMeasurementGroup;
   }
   command SaveMeasurement;
   command Cancel;
}

assistant AddTaskToolAssistant using AddTaskToolVirtualSet {
   label = "Add Tool";
   savemode = OnLostFocus;

   input(TaskSeq);
   singlestep {
      group TaskToolGroup;
   }
   command SaveTaskTool;
   command Cancel;
}

assistant ResubmissionDeferralAssistant using ResubmitDeferralRequestVirtualSet {
   label = "Resubmission Reason";
   savemode = OnLostFocus;

   input(FaultId);
   singlestep {
      group ResubmitDeferralGroup;
   }
   command SaveResubmitReason;
   command Cancel;
}
