command StartCommand for JtTaskResourceDemandQuery {
   label = "Start";
   mode = SingleRecord;
   variable HasExistingInWorkWP Boolean;
   variable IsPanelValidated Boolean;
   variable CheckConnectedTasks Boolean;

   visible = [Rowstate in("ASSIGNED") and AssignedResourceId = parent.CurrentUser and(not AvAircraftWorkPackageRef.IsHeavyMaintenance or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId = null) or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null))];
   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [HmNonRoutineApprovalRef.ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this. ") {
               when "OK" {
                  exit;
               }
            }
         }
      }
      call ValidatePanelsForTask(TaskSeq) into IsPanelValidated;
      call CheckInworkWp(AircraftId, Location) into HasExistingInWorkWP;
      call CanMpcCloseStart(TaskSeq) into CheckConnectedTasks;

      if [IsPanelValidated = false] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = false] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }

      if[HasExistingInWorkWP = false and IsPanelValidated = true] {
         call GetTimestamp(Site) into StartTime;
         if [parent.Objstate in("RELEASED")] {
            call UpdateTaskStart(TaskSeq, Site);
            call StartAssignment(TaskSeq, ExecutionInstanceSeq, StartTime, Site);
         }
         else {
            call StartAssignment(TaskSeq, ExecutionInstanceSeq, StartTime, Site);
         }
      }
      else {
         alert("A work package is already in work for this aircraft at another location. Close it to start another one.");
      }
   }
}

command FinishCommand for JtTaskResourceDemandQuery {
   label = "Finish";
   mode = SingleRecord;
   visible = [AssignedResourceId = parent.CurrentUser and parent.Objstate != "FINISHED" and(Rowstate = "ASSIGNED" or(Rowstate = "WORKSTARTED" and IsClockedIn = true)) and(not AvAircraftWorkPackageRef.IsHeavyMaintenance or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId = null) or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null))];
   variable RecordWorkStartTime Timestamp;
   variable RecordWorkInfo Structure(RecordWorkInfoStructure);
   variable IsPanelValidated Boolean;
   variable CheckConnectedTasks Boolean;

   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and AvExeTaskRef.HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [HmNonRoutineApprovalRef.ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this.") {
               when "OK" {
                  exit;
               }
            }
         }
      }
      call ValidatePanelsForTask(TaskSeq) into IsPanelValidated;
      call CanMpcCloseStart(TaskSeq) into CheckConnectedTasks;

      if [IsPanelValidated = false] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = false] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }

      copy this into RecordWorkInfo;
      call GetTimestamp(Site) into RecordWorkStartTime;

      set RecordWorkInfo.RecordWorkStartTime = RecordWorkStartTime;
      set RecordWorkInfo.FaultId = parent.FaultId;
      set RecordWorkInfo.SignedBy = parent.SignedBy;
      set RecordWorkInfo.AircraftWpId = parent.AircraftWpId;
      set RecordWorkInfo.AircraftId = parent.AircraftId;
      set RecordWorkInfo.FlightId = parent.FlightId;
      set RecordWorkInfo.Objstate = parent.Objstate;
      set RecordWorkInfo.KeyRef = parent.keyref;
      set RecordWorkInfo.LuName = luname;
      set RecordWorkInfo.AssignmentStatus = Rowstate;
      set RecordWorkInfo.ScheduledHours = PlannedHoursFormat;
      set RecordWorkInfo.AssignmentStart = AssignmentStart;
      set RecordWorkInfo.AssignedUserResourceSeq = AssignedResourceSeq;
      set RecordWorkInfo.Source = "Finish" {
         translatable = false;
      }
      set RecordWorkInfo.ClassCode = parent.ClassCode;
      set RecordWorkInfo.SubclassCode = parent.SubclassCode;
      if [Remark != "Certifier"] {
         set RecordWorkInfo.CertifyWorkPerformed = false;
      }
      set RecordWorkInfo.IsEditTaskCardAccess = false;
      assistant RecordWorkAssistant(RecordWorkInfo) {
         when CANCEL {
            exit;
         }
      }

   }
}
command RecordWorkAssignmentCommand for JtTaskResourceDemandQuery {
   label = "Record Work";
   mode = SingleRecord;
   visible = [AssignedResourceId = parent.CurrentUser and parent.Objstate != "FINISHED" and(Rowstate = "ASSIGNED" or(Rowstate = "WORKSTARTED" and IsClockedIn = true)) and(not AvAircraftWorkPackageRef.IsHeavyMaintenance or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId = null) or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null))];
   variable RecordWorkStartTime Timestamp;
   variable RecordWorkInfo Structure(RecordWorkInfoStructure);
   variable IsPanelValidated Boolean;
   variable CheckConnectedTasks Boolean;

   execute {
      call ValidatePanelsForTask(TaskSeq) into IsPanelValidated;
      call CanMpcCloseStart(TaskSeq) into CheckConnectedTasks;

      if [IsPanelValidated = false] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = false] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }

      copy this into RecordWorkInfo;
      call GetTimestamp(Site) into RecordWorkStartTime;
      set RecordWorkInfo.RecordWorkStartTime = RecordWorkStartTime;
      set RecordWorkInfo.FaultId = parent.FaultId;
      set RecordWorkInfo.SignedBy = parent.SignedBy;
      set RecordWorkInfo.AircraftWpId = parent.AircraftWpId;
