list TimeReportsList for JtTaskTransaction {
   label = "Time Reports";
   defaultfilter = [(ParentTransactionId = null or(ParentTransactionId != null and TransactionTypeDb = "COLLECTIVE") or(ParentTransactionId != null and TaskConnectedToBundle = "TRUE" and ParentDemandType != "CREW")) and(DemandType = "EQUIPMENT" or DemandType = "PERSON" or DemandType = "CREW")];
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }
   field Skill {
      label = "Resource";
   }
   field JtTaskResourceRef.Remark {
      label = "Assignment Role";
   }
   field SignedBy;
   field ScheduledHours;
   field ActualHours;
   field ActualStart {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field ActualEnd {
      displaytimezone = CurrentUserAirportTimeZone;
      showtimezonebadge = true;
   }
   field CreatedBy;
}

list LaborSummaryTotalList for JtTaskLaborSummaryTotal {
   label = "Summary Total";

   field Skill;
   field ScheduledHours {
      format = duration;
      formatmask = HHMM;
   }
