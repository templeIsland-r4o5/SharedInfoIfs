      set RecordWorkInfo.FlightId = parent.FlightId;
      set RecordWorkInfo.Objstate = parent.Objstate;
      set RecordWorkInfo.KeyRef = parent.keyref;
      set RecordWorkInfo.LuName = luname;
      set RecordWorkInfo.AssignmentStatus = Rowstate;
      set RecordWorkInfo.ScheduledHours = PlannedHoursFormat;
      set RecordWorkInfo.AssignmentStart = AssignmentStart;
      set RecordWorkInfo.AssignedUserResourceSeq = AssignedResourceSeq;
      set RecordWorkInfo.Source = "RecordWork" {
         translatable = false;
      }
      set RecordWorkInfo.ClassCode = parent.ClassCode;
      set RecordWorkInfo.SubclassCode = parent.SubclassCode;
      if [Remark != "Certifier"] {
         set RecordWorkInfo.CertifyWorkPerformed = false;
      }
      set RecordWorkInfo.IsEditTaskCardAccess = false;
      set RecordWorkInfo.IsHeavyMaintenance = AvAircraftWorkPackageRef.IsHeavyMaintenance;
      set RecordWorkInfo.HmContractLineNo = AvExeTaskRef.HmContractLineNo;
      set RecordWorkInfo.NeedCommercialApproval = HmNonRoutineApprovalRef.NeedCommercialApproval;
      set RecordWorkInfo.ProceedAtRisk = HmNonRoutineApprovalRef.ProceedAtRisk;
      set RecordWorkInfo.IsExecutionBlockedByCap = AvExeTaskRef.IsExecutionBlockedByCap;
      set RecordWorkInfo.ApprovalStatus = HmNonRoutineApprovalRef.ApprovalStatus;
      assistant RecordWorkAssistant(RecordWorkInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}

