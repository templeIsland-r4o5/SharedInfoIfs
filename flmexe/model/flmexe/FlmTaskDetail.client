      size = Medium;
   }
   field Barcode {
      label = "Barcode";
      size = Medium;
   }
   field ConfigPosition {
      label = "Config Position";
      editable = [false];
      size = Medium;
   }
   field ClassCode {
      label = "Class";
      editable = [false];
      size = Medium;
   }
   field SubclassCode {
      label = "Subclass";
      editable = [false];
      size = Medium;
   }
   field PriorityId {
      label = "Task Priority";
      size = Medium;
   }
