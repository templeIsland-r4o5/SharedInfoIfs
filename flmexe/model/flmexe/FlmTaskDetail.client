command FinalSignOff for AvExeTask {
   label = "Final Sign-Off";
   visible = [Objstate = "WORKSTARTED" and HasSignedTaskChildRecords = "SIGNED" and(CertifierUser != CurrentUser or CertifierUser = null) and(not AvAircraftWorkPackageRef.IsHeavyMaintenance or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId = null) or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null))];

   variable RecordWorkInfo Structure(RecordWorkInfoStructure);
   variable TaskSignOffPermission Text;
   variable StartedExecutionInstances Boolean;

   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [HmNonRoutineApprovalRef.ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this.") {
               when "OK" {
                  exit;
               }
            }
         }
      }

      call GetCurrentUser() into CurrentUser;
      call GetTaskSignOffPermission(CurrentUser) into TaskSignOffPermission;
      call HasStartedExecutionInstances(TaskSeq, ExecutionInstanceSeq) into StartedExecutionInstances;
      if[TaskSignOffPermission = "Yes" and StartedExecutionInstances = false] {
         copy this into RecordWorkInfo;
         set RecordWorkInfo.Source = "Final Sign-Off" {
            translatable = false;
         }
         set RecordWorkInfo.IsEditTaskCardAccess = false;
         assistant RecordWorkAssistant(RecordWorkInfo) {
            when CANCEL {
               exit;
            }
         }
      }
      else {
         if[TaskSignOffPermission = "No"] {
            error("Missing task sign-off permission. Contact system administrator.");
         }
         else {
            error("Cannot complete the task while assignments are in progress.");
         }
      }
   }
}

