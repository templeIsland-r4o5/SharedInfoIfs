   label = "Add/Remove Part";
   enabled = [IsCertified = "PENDING"];
   visible = [IsCertified = "PENDING"];
   variable PartsInfo Structure(PartsInfoAssistantStructure);
   execute {
      copy this into PartsInfo;
      set PartsInfo.FaultId = null;
      set PartsInfo.RequiredQuantity = 1;
      set PartsInfo.AircraftAltId = AircraftRef.AltId;
      set PartsInfo.AircraftRegCode = AircraftRef.RegCode;
      set PartsInfo.WpId = AircraftWpId;
      assistant AddRemovePartAssistant(PartsInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}

command EditTaskCardCommand for AvExeTask {
   label = "Edit Task Card";
   enabled = [Objstate = "WORKSTARTED" and IsTaskHasSignedRecords = true and TaskControlAuthorityEnabled = "Yes"];
   visible = [Objstate = "WORKSTARTED" and IsTaskHasSignedRecords = true and TaskControlAuthorityEnabled = "Yes"];

   variable RecordWorkInfo Structure(RecordWorkInfoStructure);

   execute {
      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [HmNonRoutineApprovalRef.ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this.") {
               when "OK" {
                  exit;
               }
            }
         }
      }

      call ValidatePanelsForTask(TaskSeq) into IsPanelValidated;
      call CanMpcCloseStart(TaskSeq) into CheckConnectedTasks;

      if [IsPanelValidated = false] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = false] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }

      copy this into RecordWorkInfo;
      set RecordWorkInfo.Source = "RecordWork" {
         translatable = false;
      }
      set RecordWorkInfo.IsEditTaskCardAccess = true;
      assistant RecordWorkAssistant(RecordWorkInfo) {
         when CANCEL {
            exit;
         }
      }
   }
}

command CancelPartCommand for AvInstalledParts {
   label = "";
   mode = SingleRecord;
   variable InstallPartsInfo Structure(InstallPartsInfoStructure);

   execute {
      if [MaintMaterialReqRef.Qty > 0] {

         copy this into InstallPartsInfo;
         set InstallPartsInfo.PartName = AvPartNumberRef.PartName;
         assistant CancelPartAssistant(InstallPartsInfo) {
            when CANCEL {
               exit;
            }
         }
      }
      else {
         call CancelParts(TaskPartId);
      }

      if[AvExeTaskRef.ClassCode = "CORR" and Sensitivities != null] {
         call SaveOverallTaskSensitivity(parent.AircraftRef.AltId, parent.FaultId, parent.EtopsSignificant, parent.FailedSystemAltId, TaskPartId);
      }
   }
}

