      emphasis Warning = [OverallPanelStatus = "ToBeOpened"];
      emphasis OK = [OverallPanelStatus = "Opened"];
      emphasis OK = [OverallPanelStatus = "ReadyToClose"];
      emphasis OK = [OverallPanelStatus = "Closed"];
      editable = [false];
   }

