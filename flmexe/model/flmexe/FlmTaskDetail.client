      multiline = true;
      size = FullWidth;
   }

}

@Override
list AssignmentsList for JtTaskResourceDemandQuery {
   exclude PlannedHours, AllocatedHours, AllocatedStart, AllocatedFinish, FixedStart, WorkStart, AssignedResourceId;
   command StartCommand;
   command RecordWorkAssignmentCommand;
   command FinishCommand;
   command PauseAssignmentCommand;
