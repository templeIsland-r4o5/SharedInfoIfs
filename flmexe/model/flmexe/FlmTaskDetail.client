-----------------------------------------------------------------------------
client FlmTaskDetail;
component FLMEXE;
layer Core;
projection FlmTaskDetailHandling;
description "Task Details Client";


--------------------------------- FRAGMENTS ---------------------------------
include fragment FlmFaultDeferral;
include fragment FlmRecordWork;
include fragment FlmResourceToolEquipmentTab;
include fragment FlmParts;
include fragment FlmRaiseFault;
include fragment FlmTaskAssignments;
include fragment FlmJtTaskStep;
include fragment AvTaskMaterial;
include fragment AvTaskReturns;
include fragment FlmPanelTasks;
include fragment AvCriticalItem;
@DynamicComponentDependency ADCON
include fragment HeavyMaintenanceInfo;
include fragment FlmTaskTool;
----------------------------- NAVIGATOR ENTRIES -----------------------------

-------------------------------- MAIN PAGES ---------------------------------

page MyWorkPage using AvExeTaskSet {
   label = "Task Details";
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [false];
      }
   }

   selector AvExeTaskDetailsSelector;
   markdowntext {
      visible = [RequestStateCd = "Sent"];
      text = "Part changes have not been validated.";
      emphasis Complementary7 = [true];
   }

   markdowntext {
      visible = [RequestStateCd = "Failed"];
      text = "Configuration warnings have been identified for some part changes in this task.";
      emphasis Alert = [true];
   }

   markdowntext {
      visible = [MissingComponentWarning != null];
      text = "This task removed a mandatory component with config slot ${MissingComponentWarning} and there is no matching installation in the work package.";
      emphasis Warning = [true];
   }

   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval and not(HmNonRoutineApprovalRef.ProceedAtRisk) and HmNonRoutineApprovalRef.ApprovalStatus != "Approved" and IsExecutionBlockedByCap];
      text = "Free CAP limit exceeded. Commercial approval is required before proceeding.";
      emphasis Complementary6 = [true];
   }
   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and HmNonRoutineApprovalRef.NeedCommercialApproval and not(HmNonRoutineApprovalRef.ProceedAtRisk) and HmNonRoutineApprovalRef.ApprovalStatus != "Approved" and not IsExecutionBlockedByCap];
      text = "Free CAP limit is exceeded. Commercial approval is required. However, you are allowed to proceed based on the current system configurations.";
      emphasis Complementary6 = [true];
   }
   markdowntext {
      visible = [IsNonRoutine and AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and HmNonRoutineApprovalRef.NeedCommercialApproval and HmNonRoutineApprovalRef.ProceedAtRisk and HmNonRoutineApprovalRef.ApprovalStatus != "Approved"];
      text = "Free CAP limit is exceeded. Commercial approval is required. However, you are allowed to proceed as 'proceed at risk' is authorized.";
      emphasis Complementary6 = [true];
   }
   markdowntext {
      visible = [Sensitivities != null];
      text = "This task is marked as sensitive. Ensure all required regulatory and safety checks are completed before execution.";
      emphasis Warning = [true];
   }
   markdowntext {
      visible = [AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and HmContractLineNo = null];
      text = "Task must be connected to a contract line to proceed.";
      emphasis Complementary6 = [true];
   }

   group AvExeTaskGroup bind AvExeTaskDetailsSelector;
   group TimeSummaryGroup bind AvExeTaskDetailsSelector;
   group AvFaultGroup bind AvExeTaskDetailsSelector;
   group DeferralRequestDetailGroup;
   group AvTaskActionGroup bind AvExeTaskDetailsSelector;
   @DynamicComponentDependency ADCON
   group HmContractInfoGroup;
   @DynamicComponentDependency ADCON
   group NonRoutinesAprrovalGroup;

   tabs {
      tab {
         label = "Assignments";
         list AssignmentsList(JtTaskResourceDemandArray) bind AvExeTaskDetailsSelector;
         list JtTaskResourceLicenseList(ResourceLicenceArray) bind AssignmentsList {
            label = "Certificate";
            display = Nested;
         }
      }
      tab {
         label = "Material";
         list AvMatReqDetailList(MaintMaterialRequisitionArray);
      }
      tab {
         label = "Part Removals";
         list AvExeTaskPartRemoveList(PartRemoveArray);
         list TaskPartWarningsList(TaskPartRemovalWarningArray) bind AvExeTaskPartRemoveList {
            display = Nested;
         }
      }
      tab {
         label = "Part Installations";
         list AvExeTaskPartInstallationList(PartInstallArray);
         list TaskPartWarningsList(TaskPartInstallationWarningArray) bind AvExeTaskPartInstallationList {
            display = Nested;
         }
      }
      tab {
         label = "Returns";
         list AvTaskReturnList(AvTaskReturnArray);
      }
      tab {
         label = "Tools";
         list ToolDemandsList(TaskToolDemandQueryArray);
      }
      tab {
         label = "Measurements";
         list TaskMeasurementsList(MeasurementArray) bind AvExeTaskDetailsSelector;
      }
      tab {
         label = "Actions Taken";
         list AvExeTaskActionOnlineList(TaskArray) bind AvExeTaskDetailsSelector;
      }
      tab {
         label = "Zones";
         list AvExeTaskZoneList(TaskZoneArray) bind AvExeTaskDetailsSelector;
      }
      tab {
         label = "Panels";
         visible = [not ClassCode in("MPC")];
         list AvExeTaskPanelList(TaskPanelArray) bind AvExeTaskDetailsSelector;
         list MpcTasksForMaintenanceTaskList(MpcTasksArray) bind AvExeTaskPanelList {
            label = "MPC Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list JtTaskOpenPanelSignOffList(JtTaskOpenPanelSignOffArray) bind AvExeTaskPanelList {
            label = "OPEN PANEL SIGN-OFF";
            display = Nested;
         }
         list JtTaskClosePanelSignOffList(JtTaskClosePanelSignOffArray) bind AvExeTaskPanelList {
            label = "CLOSE PANEL SIGN-OFF";
            display = Nested;
         }
      }
      tab {
         label = "Panels";
         visible = [ClassCode in("MPC")];
         list JtTaskPanelList(JtTaskPanelArray) bind AvExeTaskDetailsSelector;

         list JtTaskStepSignOffList(JtTaskStepSignOffArray) bind JtTaskPanelList {
            label = "PANEL SIGN-OFF";
            display = Nested;
         }
         list MaintTaskForPanelTasksList(MaintTasksForOpenTaskArray) bind JtTaskPanelList {
            visible = [ClassCode = "MPC" and SubclassCode = "MPCOPEN"];
            label = "Maintenance Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
         list MaintTaskForPanelTasksList(MaintTasksForCloseTaskArray) bind JtTaskPanelList {
            visible = [ClassCode = "MPC" and SubclassCode = "MPCCLOSE"];
            label = "Maintenance Tasks";
            display = Nested;
            details = "page/FlmTaskDetail/MyWorkPage?$filter=TaskSeq eq $[TaskSeq]";
         }
      }
      tab {
         label = "Steps";
         list JtTaskStepList(JtTaskStepArray) bind AvExeTaskDetailsSelector {
            label = "";
         }
         list JtTaskStepSignOffList(JtTaskStepSignOffArray) bind JtTaskStepList {
            label = "STEP SIGN-OFF";
            display = Nested;
         }
      }
      tab {
         label = "Non Routines";
         list NonRoutinesList(NonRoutinesArray) bind AvExeTaskDetailsSelector {
            details = "page/FlmFaultDetail/FaultDetails?$filter=FaultId eq $[FaultId]";
         }
      }
      tab {
         label = "Sign-Off";
         list JtTaskSignOffReqList(JtTaskSignOffReqArray) {
            label = "";
         }
         list StepSignOffList(JtTaskStepSignOffArray) bind JtTaskSignOffReqList {
            label = "Steps";
            visible = [selection.JtTaskSignOffReqList.SignOffConnectionDb = "TASK_STEP"];
            display = Nested;
         }
         list PanelSignOffList(PanelSignOffArray) bind JtTaskSignOffReqList {
            label = "Panels";
            visible = [selection.JtTaskSignOffReqList.SignOffConnectionDb = "TASK_STEP"];
            display = Nested;
         }
      }
      tab {
         label = "Time Reports";
         list TimeReportsList(JtTaskTransactionArray) bind AvExeTaskDetailsSelector;
      }
      tab {
         label = "Labor Summary";
         list LaborSummaryTotalList(JtTaskLaborSummaryTotalArray) bind AvExeTaskDetailsSelector;
         list LaborSummaryBreakdownList(JtTaskLaborSummaryBreakdownArray) bind AvExeTaskDetailsSelector;
      }
      tab {
         label = "Critical Items";
         list CriticalItemsList(CriticalItemsArray) bind AvExeTaskDetailsSelector;
      }
   }
   command FinalSignOff;
   command RequestDeferral;
   command StartTask {
      visible = [(Objstate = "RELEASED" and(not AvAircraftWorkPackageRef.IsHeavyMaintenance or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId = null) or(AvAircraftWorkPackageRef.IsHeavyMaintenance and AvAircraftWorkPackageRef.HmContractId != null and AvExeTaskRef.HmContractLineNo != null)))];
   }
   command UnstartTask {
      visible = [Objstate = "WORKSTARTED" and CurrentUser = StartedUser and OverallAssignmentsProgress = "NotStarted"];
   }
   command DeferCommand;
   command TaskAssignmentCommand;
   command AddTaskPartsCommand;
   command AddTaskToolCommand;
   command EditTaskCardCommand;
   command EvaluateNonRoutineCommand;
   command FaultSearchCommand;
   command RaiseNonRoutineFromTaskDetailsCommand;
   command IpcPartSearch;
   commandgroup PartSearch {
      commandgroup PartsSearch {
         label = "Part Search";
         command AviationParts;
         command AviationInventories;
      }
   }
}

--------------------------------- COMMANDS ----------------------------------
command FindInventory {

   label = "Find Inventory";

   visible = [IsFlmStandalone = false and IsCertified = "PENDING" and Objstate != "FINISHED"];

   variable FindInventoryURL Text;
   variable ExternalPagePath Text;
   variable SearchType Text;
   variable TaskNameRef Text;

   execute {
      set ExternalPagePath = "/maintenix/web/inventory/InventorySearchByType.jsp";
      set SearchType = "INSTALLABLEINVENTORY";
      set TaskNameRef = "Mobile Maintenance Task Record ID ${RecordId}";
      call GetFindInventoryUrl(ExternalPagePath, SearchType, AircraftRegCode, IataCode, TaskNameRef) into FindInventoryURL;
      navigate "${FindInventoryURL}";
   }

}

command TaskAssignmentCommand {
   label = "Task Assignment";
   visible = [AvFaultRef.UserRole = "MM_SUPERVISOR"  and Objstate != "Completed"];
   execute {
      navigate "/page/FlmTaskWorkAssignment/WorkTaskAssignmentPage?$filter=TaskSeq eq $[TaskSeq]";
   }
}

command AddMeasurementCommand for AvExeTask {
   label = "Add Measurement";
   enabled = [IsCertified = "PENDING"];
   mode = Global;
   execute {
      assistant AddMeasurementAssistant(TaskSeq, TaskSite) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}

command SaveMeasurement for AddMeasurementVirtual {
   label = "OK";
   enabled = [MeasurementTypeCodeRef.MeasurementCategoryCode != null];
   execute {
      call AddMeasurement(TaskSeq, MeasurementTypeCodeRef.MeasurementCategoryCode, MeasurementTypeCode, MeasTypeValueCode, MeasurementQty, MeasurementDateTime, MeasurementText, MeasurementBoolean, TaskSite);
   }
}

command OldAddTaskToolCommand for AvExeTask {
   label = "Add Tool";
   enabled = [IsCertified = "PENDING"];
   mode = Global;
   execute {
      assistant AddTaskToolAssistant(TaskSeq) {
         when OK {
            exit;
         }
         when CANCEL
            {
            exit;
         }
      }
   }
}
command  SaveTaskTool for AddTaskToolVirtual {
   label = "OK";
   execute {
      call AddTaskTool(TaskSeq, ToolSpecificationCode, PartNoId, SchedDuration);
   }
}
command StartTask for AvExeTask {
   label = "Start";
   variable HasExistingInWorkWP Boolean;
   variable IsPanelValidationOk Boolean;
   variable CheckConnectedTasks Boolean;

   execute {
      call ValidatePanelsForTask(TaskSeq) into IsPanelValidationOk;
      call CanMpcCloseStart(TaskSeq) into CheckConnectedTasks;
      if [IsPanelValidationOk = false] {
         messagebox("", warning, "Open all required panels before starting or finishing this task.") {
            when "OK" {
               exit;
            }
         }
      }

      if [CheckConnectedTasks = false] {
         messagebox("", warning, "You cannot work on the MPC Close task until you have completed the MPC Open task and maintenance tasks for the same panel.") {
            when "OK" {
               exit;
            }
         }
      }

      if [AvAircraftWorkPackageRef.IsHeavyMaintenance = true and IsNonRoutine = true and HmContractLineNo != null and HmNonRoutineApprovalRef.NeedCommercialApproval = true and HmNonRoutineApprovalRef.ProceedAtRisk = false and IsExecutionBlockedByCap] {
         if [HmNonRoutineApprovalRef.ApprovalStatus in("NotStarted", "AwaitingApproval")] {
            messagebox("Cannot Proceed", warning, "You need approval for this non routine, or Proceed at Risk must be enabled to continue.") {
               when "OK" {
                  exit;
               }
            }
         }
         if [HmNonRoutineApprovalRef.ApprovalStatus = "Rejected"] {
            messagebox("Cannot Proceed", warning, "The approval request of this non routine is rejected. You cannot work on this.") {
               when "OK" {
                  exit;
               }
            }
         }
      }

      call CheckInworkWp(AircraftId, Location) into HasExistingInWorkWP;
      if[HasExistingInWorkWP = false] {
         call UpdateTaskStart(TaskSeq, TaskSite);
      }
      else {
         alert("A work package is already in work for this aircraft at another location. Close it to start another one.");
      }
   }
}

command UnstartTask for AvExeTask {
   label = "Unstart";
   execute {
      call UpdateTaskUnstart(TaskSeq);
   }
}

command DeferCommand for AvExeTask {
   label = "Defer";
   visible = [FaultId != null and Objstate in("RELEASED") and AvFaultRef.Objstate != "Deferred" and(AvDeferralRequestRef.DeferralRequestStatus = "Approved" or AvDeferralRequestRef = null or AvDeferralRequestRef.MocRequired = false) and AvDeferralRequestRef.DeferralReferenceName != null];

   variable Warning Text;
   variable FaultDeferralMainPageInfo Structure(FaultDeferralMainPageInfoTaskDetailStructure);
   variable HasExistingInWorkWP Boolean;

   execute {
      call CheckInworkWp(AircraftId, Location) into HasExistingInWorkWP;
      if[HasExistingInWorkWP = false] {
         call ClearFaultDefMainVirtual();
         call ShowWarning(TaskSeq, AircraftWpId) into Warning;
         copy this into FaultDeferralMainPageInfo;
         set FaultDeferralMainPageInfo.ParentKeyRef = keyref;
         set FaultDeferralMainPageInfo.ParentLuName = luname;
         set FaultDeferralMainPageInfo.DeferralAuthorization = AvDeferralRequestRef.DeferralAuthorization;
         set FaultDeferralMainPageInfo.DeferralReferenceName = AvDeferralRequestRef.DeferralReferenceName;
         set FaultDeferralMainPageInfo.DeferralReqReasonCode = AvDeferralRequestRef.DeferralReqReasonCode;
         set FaultDeferralMainPageInfo.DeferralClassCode = AvDeferralRequestRef.DeferralClassCode;
         set FaultDeferralMainPageInfo.Note = AvDeferralRequestRef.Note;
         set FaultDeferralMainPageInfo.WorkPackageAltId = AvAircraftWorkPackageRef.ExternalId;
         set FaultDeferralMainPageInfo.IsMocRequired = AvDeferralRequestRef.MocRequired;
         set FaultDeferralMainPageInfo.FaultAltId = AvFaultRef.AltId;
         if [Warning != null] {

            messagebox("Warning", warning, "This fault removed a mandatory component with config slot ${Warning} and there is no matching installation in the work package. Do you want to defer the fault?") {
               when "OK" {
                  assistant FaultDeferralMainPage(FaultDeferralMainPageInfo) {
                     when CANCEL
                        {
                        exit;
                     }
                  }
               }
               when "Cancel" {
                  exit;
               }
            }
         }
         else {
            assistant FaultDeferralMainPage(FaultDeferralMainPageInfo) {
               when CANCEL
                  {
                  exit;
               }
            }
         }
      }
      else {
         alert("A work package is already in work for this aircraft at another location. Close it to defer the fault.");
      }
   }
}
