list AvExeTaskPartInstallationList for AvInstalledParts {
   label = "";
   orderby = PartGroupCode;
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [true];
      }
   }
   badge InstallStates {
      label = "Status";
      size = Small;
      style = TextOnly;
      emphasis Warning = [InstallStates = "Pending"];
      emphasis Ok = [InstallStates = "Signed"];
      emphasis Neutral = [InstallStates = "Cancelled"];
      editable = [false];

   }
   badge Sensitivities {
      label = "Sensitivities";
      emphasis Warning = [true];
      columnexclude = [parent.SensitiveInsPartsCount = 0];
      editable = [false];
   }
   badge IsPartWarningsExist {
      label = "Configuration Warning";
      style = TextOnly;
      emphasis Alert = [IsPartWarningsExist = true];
      emphasis Ok = [IsPartWarningsExist = false];
      editable = [false];
   }
   field SchedulingAction {
      label = "Scheduling Action";
      editable = [false];
   }
   field PartGroupCode {
      editable = [false];
   }
   field AvPartNumberRef.PartName {
      label = "Part Name";
      size = Large;
      editable = [false];
   }
   lov PartNumberRef with SourceInterchangePartSelector using GetInterchangeablePart(TaskSeq, MaintMaterialOrderNo, LineItemNo) {
      label = "Part Number";
      hidekey = [true];
      required = [true];
      editable = [SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0 and InstalledUser = null];
   }
   lov InstalledSerialRef with PartSerialCatalogSelector using GetSerialNo(InstalledPartNo, OriginalInstalledSerialNo, TaskSeq) {
      label = "Serial Number";
      hidekey = [true];
      editable = [((SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0) or(SchedulingAction = "NOREQ"))and(InstalledUser = null)];
      description = InstalledSerialNo;
   }
   lov InstalledBatchRef with LotBatchMasterSelector using GetBatchNo(InstalledPartNo, TaskSeq) {
      label = "Batch Number";
      hidekey = [true];
      description = InstalledBatchNo;
      editable = [((SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0) or(SchedulingAction = "NOREQ")) and(InstalledUser = null)];
      validate command {
         variable IsQuantityUnavailable Boolean;
         execute {
            call CheckQuantiyForBatch(InstalledPartNo, TaskSeq, InstalledQuantity, InstalledBatchNo) into IsQuantityUnavailable;
            if[IsQuantityUnavailable] {
               set InstalledBatchNo = OriginalInstalledBatchNo;
               error("The available quantity in the selected batch is less than the requested quantity.");
            }
         }
      }
   }
   field ConfigSlotPositionRef.ConfigSlotCode {
      label = "Config Slot";
      editable = [false];
   }
   lov AssmblSlotPositionRef with ReferenceAvConfigSlotPositionNewSelector using GetAssemblConfigSlotPosLov(AssemblyTypeCode, parent.AircraftId) {
      label = "Assembly Position";
      size = Small;
      hidekey = [true];
      description = AssmblSlotPositionRef.ConfigSlotPositionCode;
      editable = [((SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0) or(SchedulingAction = "NOREQ"))and(InstalledUser = null)];

   }
   lov ConfigSlotPositionRef with ReferenceAvConfigSlotPositionNewSelector using GetConfigSlotPositionLov(ConfigSlotPositionRef.ConfigSlotCode, AssemblyTypeCode) {
      label = "Position";
      hidekey = [true];
      description = ConfigSlotPositionRef.ConfigSlotPositionCode;
      editable = [((SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0) or(SchedulingAction = "NOREQ"))and(InstalledUser = null)];
      validate command {
         variable InventorySearchResponse {
            type = Structure(InventorySearchResponseStructure);
         }
         variable CmsRequestInfo {
            type = Structure(CmsDataStructure);
         }
         variable RemovalSerialNo Text;

         execute {
            set ConfigSlotPositionId = ConfigSlotPositionRef.ConfigSlotPositionId;
            call GetRemovalCmsRequestData(Objkey, ConfigSlotPositionId) into CmsRequestInfo;
            call GetRemovalInfoService(CmsRequestInfo.AircraftAltId, CmsRequestInfo.ConfigSlotCode, CmsRequestInfo.ConfigSlotPosition, CmsRequestInfo.AssemblyConfigSlotCode, CmsRequestInfo.AssemblyConfigSlotPosition) into InventorySearchResponse;
            if [InventorySearchResponse != null] {
               set RemovalSerialNo = InventorySearchResponse.SerialNumber;
               call UpdateRemovedSerialNumber(RemovalSerialNo, TaskPartId);
            }
         }
      }
   }
   field AssemblyTypeCode {
      label = "Assembly";
      visible = [AvPartGroupRef.IsCommonHardware = "FALSE"];
      size = Medium;
      editable = [false];
   }
   field Quantity {
      label = "Quantity";
      size = Small;
      editable = [(AvPartNumberRef.InventoryClassCode = "BATCH" and InstalledUser = null) and((SchedulingAction = "REQ" and MaintMaterialReqRef.Qty > 0) or(SchedulingAction = "NOREQ"))];
   }
   badge InstalledConfigSlot {
      visible = [(InstalledPartNo != null or InstalledQuantity != null) and InstalledConfigSlot = "Yes"];
      label = "Mandatory Slot";
      size = Small;
      style = TextOnly;
      emphasis Info = [InstalledConfigSlot = "Yes"];
      editable = [false];
   }
   field InstalledDate {
      size = Medium;
      label = "Date";
      displaytimezone = AvExeTaskRef.CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field InstalledUser {
      label = "Signed By";
      editable = [false];
   }
   field CreatedBy {
      label = "Created By";
      editable = [false];
   }
   field CancelledBy {
      label = "Cancelled By";
      editable = [false];
   }
   command CancelPartCommand {
      enabled = [InstallStates = "Pending" and TaskControlAuthorityEnabled = "Yes"];
      label = "Cancel";
   }
}

list AvExeTaskPartRemoveList for AvRemovedParts {
   label = "";
   orderby = PartGroupCode;
   crudactions {
      new {
         enabled = [false];
      }
      delete {
         enabled = [false];
      }
      edit {
         enabled = [true];
      }
   }
   badge RemovalStates {
      label = "Status";
      size = Small;
      style = TextOnly;
      emphasis Warning = [RemovalStates = "Pending"];
      emphasis Ok = [RemovalStates = "Signed"];
      emphasis Neutral = [RemovalStates = "Cancelled"];
      editable = [false];
   }
   badge Sensitivities {
      label = "Sensitivities";
      emphasis Warning = [true];
      columnexclude = [parent.SensitiveRePartsCount = 0];
      editable = [false];
   }
   badge IsPartWarningsExist {
      label = "Configuration Warning";
      style = TextOnly;
      emphasis Alert = [IsPartWarningsExist = true];
      emphasis Ok = [IsPartWarningsExist = false];
      editable = [false];
   }
   lov RemovalReasonRef with ReferenceAvRemovalReasonSelector using GetRemovalReasonsForPart(AvPartNumberRef.IsSos) {
      label = "Removal Reason";
      editable = [RemovedUser = null];
      description = RemovalReasonRef.RemovalReasonDesc;
   }
   field PartGroupCode {
      editable = [false];
   }
   field AvPartNumberRef.PartName {
      label = "Part Name";
      size = Large;
      editable = [false];
   }
   lov AvPartNumberRef with AvPartNumberSelector using GetSpecificPartNumberLov(PartGroupId) {
      label = "Part Number";
      hidekey = [true];
      description = AvPartNumberRef.PartNumber;
      editable = [RemovedUser = null];
   }
   field RemovedSerialNo {
      label = "Serial Number";
      editable = [RemovedUser = null];
   }
   field RemovedBatchNo {
      label = "Batch Number";
      editable = [RemovedUser = null];
   }
   field ConfigSlotPositionRef.ConfigSlotCode {
      label = "Config Slot";
      editable = [false];
   }
   field AssmblSlotPositionRef.ConfigSlotPositionCode {
      label = "Assembly Position";
      size = Medium;
      editable = [false];
   }
   field ConfigSlotPositionRef.ConfigSlotPositionCode {
      label = "Position";
      editable = [false];
   }
   field AssemblyTypeCode {
      label = "Assembly";
      visible = [AvPartGroupRef.IsCommonHardware = "FALSE"];
      size = Medium;
      editable = [false];
   }
   field Quantity {
      label = "Quantity";
      size = Small;
      editable = [false];
   }
   field PartSerialCatalogRef.OperationalCondition {
      label = "Operational Condition";
      size = Medium;
      columnvisible = [RemovedUser != null];
   }
   badge RemovedConfigSlot {
      visible = [(RemovedPartNo != null or RemovedQuantity != null) and RemovedConfigSlot = "Yes"];
      label = "Mandatory Slot";
      size = Medium;
      style = TextOnly;
      emphasis Info = [RemovedConfigSlot = "Yes"];
      editable = [false];
   }
   field RemovedDate {
      size = Medium;
      label = "Date";
      displaytimezone = AvExeTaskRef.CurrentUserAirportTimeZone;
      showtimezonebadge = true;
      editable = [false];
   }
   field RemovedUser {
      label = "Signed By";
      editable = [false];
   }
   field CreatedBy {
      label = "Created By";
      editable = [false];
   }
   field CancelledBy {
      editable = [false];
   }

   command CreateReturnLineCommand;
   command CancelRemovelCommand;
}

