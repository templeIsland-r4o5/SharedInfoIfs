<?xml version="1.0" encoding="UTF-8"?>
<shared_info>
  <acp_name>sharedInfo</acp_name>
  <description>Shared Info 後継機能 カスタム画面およびプロセス自動化構成</description>
  <version>1.0.0</version>
  <target_ifs_version>IFS Cloud 25R2</target_ifs_version>
  <configurations>
    <custom_entities>
      <custom_entity>
        <entity_name>CustomTurnNote</entity_name>
        <prompt>Custom Turn Note</prompt>
        <module>CONFIG</module>
        <create_projection>false</create_projection>
        <time_zone_setting>Server</time_zone_setting>
        <attributes>
          <attribute>
            <attribute_name>TurnNoteId</attribute_name>
            <prompt>Turn Note ID</prompt>
            <type>Number</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <is_primary_key>true</is_primary_key>
          </attribute>
          <attribute>
            <attribute_name>TurnId</attribute_name>
            <prompt>Turn ID</prompt>
            <type>Number</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <is_foreign_key>true</is_foreign_key>
            <reference_entity>AircraftTurn</reference_entity>
          </attribute>
          <attribute>
            <attribute_name>NoteText</attribute_name>
            <prompt>申し送り内容</prompt>
            <type>String</type>
            <length>2000</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>ReportedBy</attribute_name>
            <prompt>登録者</prompt>
            <type>String</type>
            <length>30</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>ReportedAt</attribute_name>
            <prompt>登録日時</prompt>
            <type>Date &amp; Time</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>Role</attribute_name>
            <prompt>登録者ロール</prompt>
            <type>String</type>
            <length>50</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
        </attributes>
      </custom_entity>
      <custom_entity>
        <entity_name>CustomShipMonitoring</entity_name>
        <prompt>Custom Ship Monitoring</prompt>
        <module>CONFIG</module>
        <create_projection>false</create_projection>
        <time_zone_setting>Server</time_zone_setting>
        <attributes>
          <attribute>
            <attribute_name>MonitoringId</attribute_name>
            <prompt>モニタリングID</prompt>
            <type>Number</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <is_primary_key>true</is_primary_key>
            <default_value_logic>Sequenceで自動採番</default_value_logic>
          </attribute>
          <attribute>
            <attribute_name>ShipNo</attribute_name>
            <prompt>機番</prompt>
            <type>String</type>
            <length>10</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>Title</attribute_name>
            <prompt>件名</prompt>
            <type>String</type>
            <length>200</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>Description</attribute_name>
            <prompt>詳細</prompt>
            <type>String</type>
            <length>4000</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>Status</attribute_name>
            <prompt>状態</prompt>
            <type>String</type>
            <length>30</length>
            <attribute_type>Persistent Field</attribute_type>
            <default_value_logic>'OPEN'</default_value_logic>
          </attribute>
          <attribute>
            <attribute_name>ReportedBy</attribute_name>
            <prompt>起票者</prompt>
            <type>String</type>
            <length>30</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>CreatedAt</attribute_name>
            <prompt>起票日時</prompt>
            <type>Date &amp; Time</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <default_value_logic>SYSTIMESTAMP</default_value_logic>
          </attribute>
          <attribute>
            <attribute_name>ClosedBy</attribute_name>
            <prompt>クローズ者</prompt>
            <type>String</type>
            <length>30</length>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
          <attribute>
            <attribute_name>ClosedAt</attribute_name>
            <prompt>クローズ日時</prompt>
            <type>Date &amp; Time</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
          </attribute>
        </attributes>
      </custom_entity>
      <custom_entity>
        <entity_name>MonitoringTaskLink</entity_name>
        <prompt>Monitoring Task Link</prompt>
        <module>CONFIG</module>
        <create_projection>false</create_projection>
        <time_zone_setting>Server</time_zone_setting>
        <attributes>
          <attribute>
            <attribute_name>LinkSeq</attribute_name>
            <prompt>Link Seq</prompt>
            <type>Number</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <is_primary_key>true</is_primary_key>
            <remarks>自動採番</remarks>
          </attribute>
          <attribute>
            <attribute_name>MonitoringId</attribute_name>
            <prompt>モニタリングID</prompt>
            <type>Number</type>
            <length/>
            <attribute_type>Persistent Field</attribute_type>
            <is_foreign_key>true</is_foreign_key>
            <reference_entity>CustomShipMonitoring</reference_entity>
            <remarks>CustomShipMonitoringへのFK</remarks>
          </attribute>
          <attribute>
            <attribute_name>TaskObjkey</attribute_name>
            <prompt>Task Objkey</prompt>
            <type>String</type>
            <length>50</length>
            <attribute_type>Persistent Field</attribute_type>
            <is_foreign_key>true</is_foreign_key>
            <reference_entity>JtTask</reference_entity>
            <remarks>JtTask.Objkey へのFK</remarks>
          </attribute>
        </attributes>
      </custom_entity>
    </custom_entities>
    <custom_projections>
      <custom_projection>
        <projection_name>CustomShipMonitoringHandling</projection_name>
        <file_name>CustomShipMonitoringHandling.projection</file_name>
        <based_on_list>
          <based_on>CustomShipMonitoring</based_on>
          <based_on>CustomTurnNote</based_on>
          <based_on>MonitoringTaskLink</based_on>
        </based_on_list>
        <associations>
          <association>
            <source_entity>CustomTurnNote</source_entity>
            <target_entity>AircraftTurn</target_entity>
            <join_keys>
              <join_key>
                <source_key>TurnId</source_key>
                <target_key>TurnId</target_key>
              </join_key>
            </join_keys>
          </association>
          <association>
            <source_entity>CustomShipMonitoring</source_entity>
            <target_entity>MonitoringTaskLink</target_entity>
            <join_keys>
              <join_key>
                <source_key>MonitoringId</source_key>
                <target_key>MonitoringId</target_key>
              </join_key>
            </join_keys>
          </association>
          <association>
            <source_entity>MonitoringTaskLink</source_entity>
            <target_entity>JtTask</target_entity>
            <join_keys>
              <join_key>
                <source_key>TaskObjkey</source_key>
                <target_key>Objkey</target_key>
              </join_key>
            </join_keys>
          </association>
        </associations>
        <actions>
          <action>
            <action_name>UpdateStatus</action_name>
            <parameters>
              <parameter>
                <name>MonitoringId</name>
                <type>Number</type>
              </parameter>
              <parameter>
                <name>NewStatus</name>
                <type>String</type>
              </parameter>
            </parameters>
          </action>
        </actions>
      </custom_projection>
    </custom_projections>
    <page_configurations>
      <page_configuration>
        <target_page_id>AircraftTurnDetails</target_page_id>
        <client_file>FlmAircraftTurnsDetails.client</client_file>
        <description>Aircraft Turn Details 画面への申し送り機能追加</description>
        <elements_definition>
          <lists>
            <list>
              <name>TurnNoteList</name>
              <label>申し送り事項 (Turn Notes)</label>
              <entity>CustomTurnNote</entity>
              <content>
                <item>
                  <field>NoteText</field>
                </item>
                <item>
                  <field>ReportedBy</field>
                </item>
                <item>
                  <field>ReportedAt</field>
                </item>
              </content>
              <crud_actions>
                <create>true</create>
                <read>true</read>
                <update>true</update>
                <delete>true</delete>
              </crud_actions>
            </list>
          </lists>
        </elements_definition>
        <layout_modifications>
          <active_page_path>Active Page &gt; Content</active_page_path>
          <actions>
            <action>
              <operation>add_last</operation>
              <element_type>List</element_type>
              <reference>TurnNoteList</reference>
              <binding>
                <bindname>AircraftTurnSelector</bindname>
                <property>CustomTurnNoteArray</property>
              </binding>
            </action>
          </actions>
        </layout_modifications>
      </page_configuration>
      <page_configuration>
        <target_page_id>CustomShipMonitoring</target_page_id>
        <client_file>CustomShipMonitoringHandling.client</client_file>
        <page_title>Ship Monitoring</page_title>
        <projection>CustomShipMonitoringHandling</projection>
        <description>Ship Monitoring 新規カスタムページ</description>
        <elements_definition>
          <selectors>
            <selector>
              <name>ShipMonitoringSelector</name>
              <entity>CustomShipMonitoring</entity>
              <content>
                <item>
                  <field>MonitoringId</field>
                </item>
                <item>
                  <field>Title</field>
                </item>
              </content>
            </selector>
          </selectors>
          <lists>
            <list>
              <name>ShipMonitoringList</name>
              <entity>CustomShipMonitoring</entity>
              <content>
                <item>
                  <field>MonitoringId</field>
                </item>
                <item>
                  <field>ShipNo</field>
                </item>
                <item>
                  <field>Title</field>
                </item>
                <item>
                  <field>Status</field>
                </item>
                <item>
                  <field>CreatedAt</field>
                </item>
              </content>
              <commands>
                <command>
                  <name>CreateNewMonitoring</name>
                  <type>Crud.Create</type>
                  <label>注視事象の新規作成</label>
                </command>
              </commands>
            </list>
            <list>
              <name>MonitoringTaskLinkList</name>
              <entity>JtTask</entity>
              <content>
                <item>
                  <field>Barcode</field>
                </item>
                <item>
                  <field>Description</field>
                </item>
                <item>
                  <field>Objstate</field>
                </item>
              </content>
              <commands>
                <command>
                  <name>AddRelatedTask</name>
                  <type>Navigate.assistant</type>
                  <label>関連タスクの追加</label>
                  <assistant_name>JtTaskSelector</assistant_name>
                </command>
              </commands>
            </list>
          </lists>
          <groups>
            <group>
              <name>ShipMonitoringDetailGroup</name>
              <entity>CustomShipMonitoring</entity>
              <content>
                <item>
                  <field>Description</field>
                </item>
              </content>
            </group>
          </groups>
        </elements_definition>
        <layout_definition>
          <content>
            <item>
              <element_type>Selector</element_type>
              <reference>ShipMonitoringSelector</reference>
            </item>
            <item>
              <element_type>List</element_type>
              <reference>ShipMonitoringList</reference>
              <binding>
                <bindname>ShipMonitoringSelector</bindname>
              </binding>
            </item>
            <item>
              <element_type>Tabs</element_type>
              <tabs>
                <tab>
                  <tab_label>詳細情報</tab_label>
                  <content>
                    <item>
                      <element_type>Group</element_type>
                      <reference>ShipMonitoringDetailGroup</reference>
                      <binding>
                        <bindname>ShipMonitoringSelector</bindname>
                      </binding>
                    </item>
                  </content>
                </tab>
                <tab>
                  <tab_label>関連タスク</tab_label>
                  <content>
                    <item>
                      <element_type>List</element_type>
                      <reference>MonitoringTaskLinkList</reference>
                      <binding>
                        <bindname>ShipMonitoringSelector</bindname>
                        <property>MonitoringTaskLinkArray</property>
                      </binding>
                    </item>
                  </content>
                </tab>
              </tabs>
            </item>
          </content>
        </layout_definition>
      </page_configuration>
    </page_configurations>
    <custom_events>
      <custom_event>
        <event_id>EV_JT_TASK_COMPLETED</event_id>
        <description>タスク完了時に注視事象のステータスを更新するためのイベント</description>
        <logical_unit>JtTask</logical_unit>
        <event_type>Model Event</event_type>
        <table_name>JT_TASK_TAB</table_name>
        <fires_on>
          <insert>false</insert>
          <update>true</update>
          <delete>false</delete>
        </fires_on>
        <condition>NEW:Objstate = 'Finished' AND OLD:Objstate != 'Finished'</condition>
        <actions>
          <action>
            <action_id>ACT_EV_JT_TASK_COMPLETED_BPA</action_id>
            <action_type>Execute Workflow</action_type>
            <workflow_id>wf_UpdateMonitoringStatus</workflow_id>
            <enabled>true</enabled>
          </action>
        </actions>
      </custom_event>
    </custom_events>
    <bpa_workflows>
      <bpa_workflow>
        <workflow_id>wf_UpdateMonitoringStatus</workflow_id>
        <title>注視事象ステータス自動更新</title>
        <trigger>
          <trigger_type>Event Invoked</trigger_type>
          <event_id>EV_JT_TASK_COMPLETED</event_id>
          <input_variables>
            <input_variable>
              <variable_name>task_objkey</variable_name>
              <description>イベントから渡されたJtTaskのObjkey</description>
            </input_variable>
          </input_variables>
        </trigger>
        <bpmn_structure>
          <start_event>
            <id>StartEvent_TaskCompleted</id>
            <name>Task Completed Trigger</name>
          </start_event>
          <tasks>
            <task>
              <id>ServiceTask_GetMonitoringId</id>
              <name>関連モニタリングIDの取得</name>
              <task_type>Call Projection</task_type>
              <projection_name>CustomShipMonitoringHandling</projection_name>
              <operation_type>Query</operation_type>
              <operation>MonitoringTaskLinks</operation>
              <filter_condition>$filter=TaskObjkey eq '${task_objkey}'</filter_condition>
              <output_mapping>
                <variable_name>monitoring_id</variable_name>
                <source_property>MonitoringId</source_property>
              </output_mapping>
            </task>
            <task>
              <id>ExclusiveGateway_CheckMonitoringId</id>
              <name>モニタリングIDが存在するか</name>
              <task_type>Exclusive Gateway</task_type>
              <sequence_flows>
                <sequence_flow>
                  <condition>${monitoring_id != null}</condition>
                  <target_id>ServiceTask_UpdateStatus</target_id>
                </sequence_flow>
                <sequence_flow>
                  <condition>Default</condition>
                  <target_id>EndEvent_Finished</target_id>
                </sequence_flow>
              </sequence_flows>
            </task>
            <task>
              <id>ServiceTask_UpdateStatus</id>
              <name>ステータスをIN_PROGRESSに更新</name>
              <task_type>Call Projection</task_type>
              <projection_name>CustomShipMonitoringHandling</projection_name>
              <operation_type>Action</operation_type>
              <action_name>UpdateStatus</action_name>
              <input_mapping>
                <parameter>
                  <parameter_name>MonitoringId</parameter_name>
                  <value_formula>${monitoring_id}</value_formula>
                </parameter>
                <parameter>
                  <parameter_name>NewStatus</parameter_name>
                  <value_formula>'IN_PROGRESS'</value_formula>
                </parameter>
              </input_mapping>
            </task>
          </tasks>
          <end_event>
            <id>EndEvent_Finished</id>
            <name>Process Completed</name>
          </end_event>
        </bpmn_structure>
      </bpa_workflow>
    </bpa_workflows>
    <navigation_menu>
      <menu_item>
        <label>Ship Monitoring</label>
        <entry_type>Page</entry_type>
        <parent_folder>Hangar Maintenance</parent_folder>
        <client>CustomShipMonitoringHandling</client>
        <page_url_path>page/CustomShipMonitoring/Form</page_url_path>
      </menu_item>
    </navigation_menu>
    <security_permissions>
      <security_permission>
        <permission_set>FLM_TECHNICIAN</permission_set>
        <granted_projections>
          <granted_projection>
            <projection_name>CustomShipMonitoringHandling</projection_name>
            <granted_actions>
              <granted_action>
                <action_name>UpdateStatus</action_name>
                <allowed>true</allowed>
              </granted_action>
            </granted_projections>
            <entity_actions>
              <entity_action>
                <entity_name>CustomTurnNote</entity_name>
                <allowed_operations>
                  <create>true</create>
                  <read>true</read>
                  <update>true</update>
                  <delete>true</delete>
                </allowed_operations>
              </entity_action>
              <entity_action>
                <entity_name>CustomShipMonitoring</entity_name>
                <allowed_operations>
                  <create>false</create>
                  <read>true</read>
                  <update>false</update>
                  <delete>false</delete>
                </allowed_operations>
              </entity_action>
            </entity_actions>
          </granted_projection>
        </granted_projections>
        <granted_pages>
          <granted_page>
            <page_path>page/CustomShipMonitoring/Form</page_path>
            <allowed>true</allowed>
          </granted_page>
        </granted_pages>
      </security_permission>
    </security_permissions>
  </configurations>
</shared_info>