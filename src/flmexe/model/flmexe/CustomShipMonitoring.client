client CustomShipMonitoring;
component FLMEXE;
layer Core;

-------------------------------- MAIN PAGES ---------------------------------
page Form using CustomShipMonitoringSet {
   label = "Ship Monitoring";
   list CustomShipMonitoringList;

   group CustomShipMonitoringGroup;
   list CustomTurnNoteList(TurnNotes);
   list LinkedTasksList(LinkedTasks);
}

--------------------------------- COMMANDS ----------------------------------
command LinkTaskCommand for CustomShipMonitoring {
   label = "Link Task";
   execute {
      assistant LinkTaskAssistant(MonitoringId) {
         when OK {
            exit;
         }
      }
   }
}

---------------------------------- GROUPS -----------------------------------
group CustomShipMonitoringGroup for CustomShipMonitoring {
   label = "Details";
   field MonitoringId;
   field ShipNo;
   field Title;
   field Description;
   field Status;
   field ReportedBy;
   field CreatedAt;
   field ClosedBy;
   field ClosedAt;
}

----------------------------------- LISTS -----------------------------------
list CustomShipMonitoringList for CustomShipMonitoring {
   label = "Monitoring Items";
   field MonitoringId;
   field ShipNo;
   field Title;
   field Status;
   field CreatedAt;

   commandgroup {
      command LinkTaskCommand;
   }
}

list LinkedTasksList for MonitoringTaskLink {
   label = "Linked Tasks";
   field TaskAssoc.Barcode;
   field TaskAssoc.Description;
   badge TaskAssoc.Objstate {
      label = "Status";
   }
}

list AvailableTasksList for AvExeTask {
   label = "Available Tasks";
   field Barcode;
   field Description;
   badge Objstate {
      label = "Status";
   }
}

list CustomTurnNoteList for CustomTurnNote {
   label = "Turn Notes";
   field NoteText;
   field ReportedBy;
   field ReportedAt;
}

---------------------------------- DIALOGS ----------------------------------
assistant LinkTaskAssistant using CustomShipMonitoringSet {
   label = "Link Task";
   input(MonitoringId);
   
   steps {
      step {
         list AvailableTasksList(AvExeTaskArray);
      }
      final step {
      }
   }
   finish command {
      enabled = [component.AvailableTasksList.SelectionCount > 0];
      execute {
         call LinkTask(MonitoringId, component.AvailableTasksList.Selected.TaskSeq);
         exit OK;
      }
   }
   cancel command {
      execute {
         exit CANCEL;
      }
   }
}
