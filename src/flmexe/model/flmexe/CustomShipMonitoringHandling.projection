--
--  File:         CustomShipMonitoringHandling.projection
--
--  Date    By      Notes
--  ------  ------  -----------------------------------------------------------------
--  260908  Gemini  Created.
--------------------------------------------------------------------------------

layer Core;

----------------------------- MAIN ENTRY POINTS -----------------------------
entityset CustomShipMonitoringSet for CustomShipMonitoring;
entityset AvExeTaskSet for AvExeTask;

----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator {
   entry CustomShipMonitoringNavEntry parent FlmWorkManagementNavigator.FlmWorkManagement at index 1000 {
      label = "Ship Monitoring";
      page CustomShipMonitoring;
   }
}

-------------------------------- MAIN PAGES ---------------------------------
page CustomShipMonitoring using CustomShipMonitoringSet {
   label = "Ship Monitoring";
   list CustomShipMonitoringList;
}

--------------------------------- COMMANDS ----------------------------------
command CreateMonitoringItemCommand for AircraftTurn {
   label = "Create Monitoring Item";
   execute {
      navigate "page/CustomShipMonitoring/CustomShipMonitoring?$action=new&shipNo=${ShipNo}";
   }
}

--------------------------------- FRAGMENTS ---------------------------------
include fragment CustomTurnNote;

--------------------------------- ENTITIES ----------------------------------
@Override
entity CustomShipMonitoring {
   crud = Create, Read, Update, Delete;

   attribute MonitoringId Number {
      label = "Monitoring ID";
      required = [true];
      editable = [false];
   }
   attribute ShipNo Text {
      label = "Ship No";
      required = [true];
      maxlength = 10;
   }
   attribute Title Text {
      label = "Title";
      required = [true];
      maxlength = 200;
   }
   attribute Description Text {
      label = "Description";
      maxlength = 4000;
   }
   attribute Status Text {
      label = "Status";
      required = [true];
      maxlength = 30;
      default = "'OPEN'";
   }
   attribute ReportedBy Text {
      label = "Reported By";
      required = [true];
      editable = [false];
      maxlength = 30;
   }
   attribute CreatedAt Timestamp {
      label = "Created At";
      required = [true];
      editable = [false];
   }
   attribute ClosedBy Text {
      label = "Closed By";
      editable = [false];
      maxlength = 30;
   }
   attribute ClosedAt Timestamp {
      label = "Closed At";
      editable = [false];
   }

   array LinkedTasks(MonitoringId) to MonitoringTaskLink(MonitoringId);
}

@Override
entity MonitoringTaskLink {
   crud = Create, Read, Update, Delete;

   attribute MonitoringId Number {
      label = "Monitoring ID";
      required = [true];
   }
   attribute TaskSeq Number {
      label = "Task Seq";
      required = [true];
   }
   attribute LinkType Text {
      label = "Link Type";
      maxlength = 20;
   }

   association MonitoringAssoc with CustomShipMonitoring(MonitoringId) to CustomShipMonitoring(MonitoringId);
   association TaskAssoc with AvExeTask(TaskSeq) to AvExeTask(TaskSeq);
}

@Override
entity AvExeTask {
   crud = Read;

   attribute TaskSeq Number;
   attribute Barcode Text;
   attribute Description Text;
   attribute Objstate Enumeration(AvExeTaskState);
}

---------------------------------- ACTIONS ----------------------------------
action LinkTask {
   initialcheck none;
   parameter MonitoringId Number;
   parameter TaskSeq Number;
}
--------------------------- PROJECTION FRAGMENTS ----------------------------
