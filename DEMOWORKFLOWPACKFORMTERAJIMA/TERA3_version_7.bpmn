<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="TERA3" isExecutable="true">
    <bpmn:documentation>Validate AvFlight.FlightTurnStatus when the TestTERA button is pressed on MY_AIRCRAFT_TURNS. If the aircraft turn status is Inbound, show a validation warning and stop subsequent processing.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="TestTERA Button Pressed">
      <bpmn:outgoing>Flow_ReadAvFlight</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_CheckStatus" name="Is Aircraft Turn Status Inbound?" default="Flow_Is_Not_Inbound">
      <bpmn:incoming>Flow_ReadAvFlight</bpmn:incoming>
      <bpmn:outgoing>Flow_Is_Inbound</bpmn:outgoing>
      <bpmn:outgoing>Flow_Is_Not_Inbound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ReadAvFlight" sourceRef="StartEvent_1" targetRef="Gateway_CheckStatus">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property />
        </camunda:properties>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Is_Inbound" name="Inbound" sourceRef="Gateway_CheckStatus" targetRef="Event_Terminate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FlightId == "Inbound"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_Terminate" name="Show Warning and Stop">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ifsBpaValidationErrorMessages">
            <camunda:map>
              <camunda:entry key="en">This Fligh Status[${fFlightId}] is Inbound !!</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener class="com.ifsworld.fnd.bpa.process.validation.IfsBpaFailureEndEventListener" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Is_Inbound</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_InboundFlight" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Is_Not_Inbound" name="Not Inbound" sourceRef="Gateway_CheckStatus" targetRef="Event_Complete" />
    <bpmn:endEvent id="Event_Complete" name="Process Completion">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ifsBpaValidationErrorMessages">
            <camunda:map>
              <camunda:entry key="en">This Fligh Status [${fFlightId}] is  NOT Inbound !!</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener class="com.ifsworld.fnd.bpa.process.validation.IfsBpaFailureEndEventListener" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Is_Not_Inbound</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_0og4byf" />
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_Context">
      <bpmn:text>Trigger context: Entity AvFlight / Projection FlmAircraftTurnsDetailsHandling / EntitySet AvFlightSet. Read AvFlight through Projection API, then validate FlightTurnStatus.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Context" sourceRef="StartEvent_1" targetRef="TextAnnotation_Context" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="TERA3">
      <bpmndi:BPMNEdge id="Flow_Is_Not_Inbound_di" bpmnElement="Flow_Is_Not_Inbound">
        <di:waypoint x="475" y="117" />
        <di:waypoint x="642" y="117" />
        <bpmndi:BPMNLabel xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
          <dc:Bounds x="513" y="99" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Is_Inbound_di" bpmnElement="Flow_Is_Inbound">
        <di:waypoint x="450" y="142" />
        <di:waypoint x="450" y="200" />
        <di:waypoint x="642" y="200" />
        <bpmndi:BPMNLabel xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
          <dc:Bounds x="497" y="182" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Flow_ReadAvFlight_di" bpmnElement="Flow_ReadAvFlight">
        <di:waypoint x="215" y="117" />
        <di:waypoint x="425" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="154" y="142" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CheckStatus_di" bpmnElement="Gateway_CheckStatus" isMarkerVisible="true">
        <dc:Bounds x="425" y="92" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410" y="57" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Terminate_di" bpmnElement="Event_Terminate">
        <dc:Bounds x="642" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="225" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1sote2v_di" bpmnElement="Event_Complete">
        <dc:Bounds x="642" y="99" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="632" y="142" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_Context_di" bpmnElement="TextAnnotation_Context">
        <dc:Bounds x="160" y="220" width="330" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Context_di" bpmnElement="Association_Context">
        <di:waypoint x="197" y="135" />
        <di:waypoint x="245" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
